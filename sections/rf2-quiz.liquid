  "tag": "div",
  "class": "rf2-quiz-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Section background",
      "default": "#DCCFFF"
    },
    {
      "type": "color",
      "id": "c_card",
      "label": "Quiz card",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_ink",
      "label": "Ink (buttons, reveal card)",
      "default": "#1E0F4A"
    },
    {
      "type": "color",
      "id": "c_lime",
      "label": "Lime (accents on ink only)",
