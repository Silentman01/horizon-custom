{%- comment -%}
  Refrain v2 funnel quiz (template product.refrain-v2). Started from sections/refrain-quiz.liquid (local branch refrain).
  Flow: first screen (H1 + promise + S1) -> 7 short screens -> POST /api/preview (source.template product.refrain-v2)
  -> wait screen (their words, real stages, song title and first lines) -> reveal (tap to play the ~15 s hook, karaoke,
  cliff, blurred next lines) -> one buy button: empty the cart, add the song like Horizon's product form, open the cart drawer.
  Copy: every visible string is a block setting (defaults = funnel-v2/COPY_DECK.md). The copy JSON and the schema are
  regenerated by funnel-v2/harness/build_schema.py (edit the mapping there, not by hand).
  Storage: localStorage rf2_quiz (answers, 7 days) and rf2_preview ({id, token, createdAt, readyAt}, TTL = retention_days).
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product | default: product
  assign v_std = p.variants.first
  assign v_prem = nil
  for v in p.variants
    assign vt = v.title | downcase
    if vt contains 'premium'
      assign v_prem = v
    endif
  endfor
  if v_prem == nil and p.variants.size > 1
    assign v_prem = p.variants[1]
  endif
  if v_prem and v_std.id == v_prem.id
    assign v_std = p.variants.last
  endif
  assign std_cents = 1900
  assign prem_cents = 3500
  if v_std
    assign std_cents = v_std.price
  endif
  if v_prem
    assign prem_cents = v_prem.price
  endif

  assign b_landing = section.blocks | where: 'type', 'landing' | first
  assign b_quiz = section.blocks | where: 'type', 'quiz' | first
  assign b_s1 = section.blocks | where: 'type', 's1' | first
  assign b_s2 = section.blocks | where: 'type', 's2' | first
  assign b_s3 = section.blocks | where: 'type', 's3' | first
  assign b_s4 = section.blocks | where: 'type', 's4' | first
  assign b_s5 = section.blocks | where: 'type', 's5' | first
  assign b_s6 = section.blocks | where: 'type', 's6' | first
  assign b_s7 = section.blocks | where: 'type', 's7' | first
  assign b_recap = section.blocks | where: 'type', 'recap' | first
  assign b_errors = section.blocks | where: 'type', 'errors' | first
  assign b_wait = section.blocks | where: 'type', 'wait' | first
  assign b_reveal = section.blocks | where: 'type', 'reveal' | first
  assign b_offer = section.blocks | where: 'type', 'offer' | first
  assign b_photo = section.blocks | where: 'type', 'photo' | first
  assign b_resume = section.blocks | where: 'type', 'resume' | first
  assign ex_blocks = section.blocks | where: 'type', 'examples'

  assign ss = section.settings
  assign uid = 'rf2q-' | append: section.id
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign demo_src = ''
  if ss.demo_audio_asset != blank
    assign demo_src = ss.demo_audio_asset | asset_url
  endif
  assign prop_label = ''
  if ss.show_property_label and b_offer.settings.property_label != blank
    assign prop_label = b_offer.settings.property_label
  endif
  assign h1_parts = b_landing.settings.h1 | escape | split: '*'
  assign s1_lines = b_s1.settings.chips | newline_to_br | split: '<br />'
  assign s3_lines = b_s3.settings.chips | newline_to_br | split: '<br />'
  assign s4_styles = b_s4.settings.styles | newline_to_br | split: '<br />'
  assign s4_voices = b_s4.settings.voice_chips | newline_to_br | split: '<br />'
  assign vis_styles = b_s4.settings.visible_styles | default: 3
-%}
{%- if ss.font_heading == 'brand' or ss.font_body == 'brand' -%}{% render 'refrain-fonts' %}{%- endif -%}
<section
  id="quiz"
  class="rf2-q rf2-q--{{ section.id }}"
  style="--rf2-q-bg: {{ ss.c_bg }}; --rf2-q-card: {{ ss.c_card }}; --rf2-q-ink: {{ ss.c_ink }}; --rf2-q-lime: {{ ss.c_lime }}; --rf2-q-violet: {{ ss.c_violet }}; --rf2-q-text: {{ ss.c_text }}; --rf2-q-soft: {{ ss.c_soft }}; --rf2-q-radius: {{ ss.radius }}px; --rf2-q-w: {{ ss.card_width }}px; --rf2-q-h1: {{ ss.h1_size }}px; --rf2-q-h1-d: {{ ss.h1_size_d }}px; --rf2-q-fs: {{ ss.body_size }}px; --rf2-q-pt: {{ ss.pad_top }}px; --rf2-q-pb: {{ ss.pad_bottom }}px; --rf2-q-pt-d: {{ ss.pad_top_d }}px; --rf2-q-pb-d: {{ ss.pad_bottom_d }}px; --rf2-q-sans: {% if ss.font_body == 'brand' %}'Plus Jakarta Sans', {% endif %}var(--font-body--family, system-ui), system-ui, sans-serif; --rf2-q-head: {% if ss.font_heading == 'brand' %}'Plus Jakarta Sans', var(--font-body--family, system-ui){% else %}var(--font-heading--family, system-ui){% endif %}, system-ui, sans-serif; --rf2-q-serif: {% if ss.font_heading == 'brand' %}'Fraunces', {% endif %}var(--font-heading--family, Georgia), Georgia, serif;"
>
  <rf2-quiz
    class="rf2-q__inner"
    data-api="{{ ss.api_base | escape }}"
    data-std="{{ v_std.id | default: 67641337708934 }}"
    data-prem="{{ v_prem.id | default: 67641337741702 }}"
    data-std-price="{{ std_cents }}"
    data-prem-price="{{ prem_cents }}"
    data-default-tier="{{ ss.default_tier }}"
    data-tier-ui="{{ ss.tier_ui }}"
    data-xmas-until="{{ ss.xmas_until | escape }}"
    data-prop-label="{{ prop_label | escape }}"
    data-source="product.refrain-v2"
    data-demo-audio="{{ demo_src }}"
    data-demo-lyrics="{{ ss.demo_lyrics | escape }}"
    data-force-demo="{{ ss.force_demo }}"
    data-editor-view="{{ ss.editor_view }}"
    data-karaoke="{{ ss.karaoke }}"
    data-blur="{{ ss.blur }}"
    data-locked="{{ ss.locked_strip }}"
    data-recap="{{ ss.answers_recap }}"
    data-eta="{{ ss.eta }}"
    data-recip="{{ ss.reciprocity }}"
    data-focus="{{ ss.hide_other_sections }}"
    data-sticky="{{ ss.sticky_cta }}"
    data-visible-styles="{{ vis_styles }}"
  >
    {%- comment -%}@copy-json-start{%- endcomment -%}
    <script type="application/json" data-rf2-copy>{"landing":{"identification":{{ b_landing.settings.identification | json }},"h1":{{ b_landing.settings.h1 | json }},"sub":{{ b_landing.settings.sub | json }},"promise_card":{{ b_landing.settings.promise_card | json }},"trust_line":{{ b_landing.settings.trust_line | json }}},"quiz":{"progress_label":{{ b_quiz.settings.progress_label | json }},"next":{{ b_quiz.settings.next | json }},"back":{{ b_quiz.settings.back | json }},"near_end":{{ b_quiz.settings.near_end | json }},"cta_final":{{ b_quiz.settings.cta_final | json }}},"s1":{"title":{{ b_s1.settings.title | json }},"chips":{{ b_s1.settings.chips | json }},"other_label":{{ b_s1.settings.other_label | json }},"other_help":{{ b_s1.settings.other_help | json }}},"s2":{"title":{{ b_s2.settings.title | json }},"help":{{ b_s2.settings.help | json }},"nickname_label":{{ b_s2.settings.nickname_label | json }},"nickname_help":{{ b_s2.settings.nickname_help | json }},"pron_link":{{ b_s2.settings.pron_link | json }},"pron_help":{{ b_s2.settings.pron_help | json }}},"s3":{"title":{{ b_s3.settings.title | json }},"chips":{{ b_s3.settings.chips | json }},"other_label":{{ b_s3.settings.other_label | json }},"other_help":{{ b_s3.settings.other_help | json }}},"s4":{"tone_title":{{ b_s4.settings.tone_title | json }},"tone_emouvant_title":{{ b_s4.settings.tone_emouvant_title | json }},"tone_emouvant_sub":{{ b_s4.settings.tone_emouvant_sub | json }},"tone_drole_title":{{ b_s4.settings.tone_drole_title | json }},"tone_drole_sub":{{ b_s4.settings.tone_drole_sub | json }},"tone_les_deux_title":{{ b_s4.settings.tone_les_deux_title | json }},"tone_les_deux_sub":{{ b_s4.settings.tone_les_deux_sub | json }},"style_title":{{ b_s4.settings.style_title | json }},"styles":{{ b_s4.settings.styles | json }},"more_styles":{{ b_s4.settings.more_styles | json }},"voice_title":{{ b_s4.settings.voice_title | json }},"voice_chips":{{ b_s4.settings.voice_chips | json }},"lang_link":{{ b_s4.settings.lang_link | json }},"lang_on":{{ b_s4.settings.lang_on | json }}},"s5":{"emotional_title":{{ b_s5.settings.emotional_title | json }},"emotional_help":{{ b_s5.settings.emotional_help | json }},"funny_title":{{ b_s5.settings.funny_title | json }},"funny_help":{{ b_s5.settings.funny_help | json }},"starters":{{ b_s5.settings.starters | json }}},"s6":{"emotional_title":{{ b_s6.settings.emotional_title | json }},"emotional_help":{{ b_s6.settings.emotional_help | json }},"funny_title":{{ b_s6.settings.funny_title | json }},"funny_help":{{ b_s6.settings.funny_help | json }},"mic_tip":{{ b_s6.settings.mic_tip | json }},"nudge_text":{{ b_s6.settings.nudge_text | json }},"nudge_add":{{ b_s6.settings.nudge_add | json }},"nudge_skip":{{ b_s6.settings.nudge_skip | json }}},"s7":{"emotional_title":{{ b_s7.settings.emotional_title | json }},"emotional_help":{{ b_s7.settings.emotional_help | json }},"funny_title":{{ b_s7.settings.funny_title | json }},"funny_help":{{ b_s7.settings.funny_help | json }}},"recap":{"title":{{ b_recap.settings.title | json }},"edit":{{ b_recap.settings.edit | json }}},"errors":{"required":{{ b_errors.settings.required | json }},"too_short":{{ b_errors.settings.too_short | json }},"too_long":{{ b_errors.settings.too_long | json }},"name":{{ b_errors.settings.name | json }},"content":{{ b_errors.settings.content | json }},"rate_limited":{{ b_errors.settings.rate_limited | json }},"network":{{ b_errors.settings.network | json }}},"wait":{"recap_title":{{ b_wait.settings.recap_title | json }},"stages":{{ b_wait.settings.stages | json }},"eta_gt90":{{ b_wait.settings.eta_gt90 | json }},"eta_60":{{ b_wait.settings.eta_60 | json }},"eta_30":{{ b_wait.settings.eta_30 | json }},"eta_few":{{ b_wait.settings.eta_few | json }},"eta_almost":{{ b_wait.settings.eta_almost | json }},"title_label":{{ b_wait.settings.title_label | json }},"lyrics_label":{{ b_wait.settings.lyrics_label | json }},"hook_mask":{{ b_wait.settings.hook_mask | json }},"sound_up":{{ b_wait.settings.sound_up | json }},"offer_recap":{{ b_wait.settings.offer_recap | json }},"slow":{{ b_wait.settings.slow | json }},"retry":{{ b_wait.settings.retry | json }},"failed":{{ b_wait.settings.failed | json }},"failed_cta":{{ b_wait.settings.failed_cta | json }}},"reveal":{"ready_title":{{ b_reveal.settings.ready_title | json }},"play_label":{{ b_reveal.settings.play_label | json }},"play_label_static":{{ b_reveal.settings.play_label_static | json }},"sound_up":{{ b_reveal.settings.sound_up | json }},"locked_strip":{{ b_reveal.settings.locked_strip | json }},"tease":{{ b_reveal.settings.tease | json }},"replay":{{ b_reveal.settings.replay | json }},"ownership_line":{{ b_reveal.settings.ownership_line | json }},"reciprocity":{{ b_reveal.settings.reciprocity | json }},"pause_label":{{ b_reveal.settings.pause_label | json }},"versions_2":{{ b_reveal.settings.versions_2 | json }},"versions_1":{{ b_reveal.settings.versions_1 | json }}},"offer":{"cta":{{ b_offer.settings.cta | json }},"cta_premium":{{ b_offer.settings.cta_premium | json }},"premium_line":{{ b_offer.settings.premium_line | json }},"photo_link":{{ b_offer.settings.photo_link | json }},"risk_line":{{ b_offer.settings.risk_line | json }},"xmas_line":{{ b_offer.settings.xmas_line | json }},"secure":{{ b_offer.settings.secure | json }},"sticky":{{ b_offer.settings.sticky | json }},"property_label":{{ b_offer.settings.property_label | json }},"adding":{{ b_offer.settings.adding | json }},"added":{{ b_offer.settings.added | json }},"cart_error":{{ b_offer.settings.cart_error | json }}},"photo":{"title":{{ b_photo.settings.title | json }},"help":{{ b_photo.settings.help | json }},"pick":{{ b_photo.settings.pick | json }},"pick_again":{{ b_photo.settings.pick_again | json }},"formats":{{ b_photo.settings.formats | json }},"remove":{{ b_photo.settings.remove | json }},"send":{{ b_photo.settings.send | json }},"chosen":{{ b_photo.settings.chosen | json }},"sending":{{ b_photo.settings.sending | json }},"checking":{{ b_photo.settings.checking | json }},"active":{{ b_photo.settings.active | json }},"slow":{{ b_photo.settings.slow | json }},"refused":{{ b_photo.settings.refused | json }},"refused_short":{{ b_photo.settings.refused_short | json }},"removed":{{ b_photo.settings.removed | json }},"consent":{{ b_photo.settings.consent | json }},"consent_more":{{ b_photo.settings.consent_more | json }},"err_large":{{ b_photo.settings.err_large | json }},"err_type":{{ b_photo.settings.err_type | json }},"err_unreadable":{{ b_photo.settings.err_unreadable | json }},"err_limit":{{ b_photo.settings.err_limit | json }},"err_locked":{{ b_photo.settings.err_locked | json }},"err_rate":{{ b_photo.settings.err_rate | json }},"err_consent":{{ b_photo.settings.err_consent | json }},"err_generic":{{ b_photo.settings.err_generic | json }}},"resume":{"title":{{ b_resume.settings.title | json }},"cta":{{ b_resume.settings.cta | json }},"doc_title_ready":{{ b_resume.settings.doc_title_ready | json }}},"examples":[{%- for b in ex_blocks -%}{"field":{{ b.settings.field | json }},"tone":{{ b.settings.tone | json }},"lines":{{ b.settings.lines | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
    {%- comment -%}@copy-json-end{%- endcomment -%}

    {%- comment -%} FIRST SCREEN: the ad's promise + the first tap {%- endcomment -%}
    <header class="rf2-q__hero" data-rf2-hero {{ b_landing.shopify_attributes }}>
      {%- if b_landing.settings.show_identification and b_landing.settings.identification != blank -%}
        <p class="rf2-q__kicker">{{ b_landing.settings.identification | escape }}</p>
      {%- endif -%}
      <h1 class="rf2-q__h1">
        {%- for part in h1_parts -%}
          {%- assign odd = forloop.index0 | modulo: 2 -%}
          {%- if odd == 1 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}
        {%- endfor -%}
      </h1>
      {%- if b_landing.settings.show_sub and b_landing.settings.sub != blank -%}
        <p class="rf2-q__sub">{{ b_landing.settings.sub | escape }}</p>
      {%- endif -%}
      {%- if b_landing.settings.show_promise and b_landing.settings.promise_card != blank -%}
        <p class="rf2-q__promise">{{ b_landing.settings.promise_card | escape }}</p>
      {%- endif -%}
    </header>

    <div class="rf2-q__card" data-rf2-card>
      <p class="rf2-q__sr" aria-live="polite" data-rf2-live></p>

      <form class="rf2-q__form" data-rf2-form novalidate {{ b_quiz.shopify_attributes }}>
        <div class="rf2-q__progress" aria-hidden="true">
          <span class="rf2-q__plabel" data-rf2-t="quiz.progress_label">{{ b_quiz.settings.progress_label | escape }}</span>
          <span class="rf2-q__bar"><i data-rf2-bar style="width: 15%"></i></span>
        </div>

        {%- comment -%} S1 who {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="1" {{ b_s1.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" data-rf2-t="s1.title">{{ b_s1.settings.title | escape }}</legend>
          <div class="rf2-q__chips" data-rf2-group="recipient">
            {%- for l in s1_lines -%}
              {%- assign l = l | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- assign f = l | split: '|' -%}
              {%- assign f0 = f[0] | strip -%}
              {%- assign f1 = f[1] | strip | downcase -%}
              {%- assign f2 = f[2] | strip | downcase -%}
              <label class="rf2-q__chip" data-rf2-auto><input type="radio" name="rf2_recipient" value="{{ f0 | escape }}" data-recipient="{{ f1 | escape }}" data-gender="{{ f2 | escape }}"><span>{{ f0 | escape }}</span></label>
            {%- endfor -%}
          </div>
          <div class="rf2-q__field" data-rf2-other="recipient" hidden>
            <label for="{{ uid }}-rother" data-rf2-t="s1.other_label">{{ b_s1.settings.other_label | escape }}</label>
            <input id="{{ uid }}-rother" type="text" name="recipient_other" maxlength="60" autocomplete="off" aria-describedby="{{ uid }}-rother-h">
            <small class="rf2-q__help" id="{{ uid }}-rother-h" data-rf2-t="s1.other_help">{{ b_s1.settings.other_help | escape }}</small>
          </div>
          {%- if b_landing.settings.show_trust and b_landing.settings.trust_line != blank -%}
            <p class="rf2-q__trust">{{ b_landing.settings.trust_line | escape }}</p>
          {%- endif -%}
        </fieldset>

        {%- comment -%} S2 name {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="2" hidden {{ b_s2.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" id="{{ uid }}-s2t" data-rf2-t="s2.title">{{ b_s2.settings.title | escape }}</legend>
          <p class="rf2-q__lead" id="{{ uid }}-s2h" data-rf2-t="s2.help">{{ b_s2.settings.help | escape }}</p>
          <div class="rf2-q__field">
            <input type="text" name="name" maxlength="40" autocomplete="off" autocapitalize="words" spellcheck="false" aria-labelledby="{{ uid }}-s2t" aria-describedby="{{ uid }}-s2h">
          </div>
          <div class="rf2-q__field">
            <label for="{{ uid }}-nick" data-rf2-t="s2.nickname_label">{{ b_s2.settings.nickname_label | escape }}</label>
            <input id="{{ uid }}-nick" type="text" name="nickname" maxlength="30" autocomplete="off" aria-describedby="{{ uid }}-nick-h">
            <small class="rf2-q__help" id="{{ uid }}-nick-h" data-rf2-t="s2.nickname_help">{{ b_s2.settings.nickname_help | escape }}</small>
          </div>
          <button type="button" class="rf2-q__link" data-rf2-pron-toggle aria-expanded="false" aria-controls="{{ uid }}-pronbox" id="{{ uid }}-pronl" data-rf2-t="s2.pron_link">{{ b_s2.settings.pron_link | escape }}</button>
          <div class="rf2-q__field" id="{{ uid }}-pronbox" data-rf2-pron hidden>
            <input type="text" name="pronunciation" maxlength="60" autocomplete="off" aria-labelledby="{{ uid }}-pronl" aria-describedby="{{ uid }}-pron-h">
            <small class="rf2-q__help" id="{{ uid }}-pron-h" data-rf2-t="s2.pron_help">{{ b_s2.settings.pron_help | escape }}</small>
          </div>
        </fieldset>

        {%- comment -%} S3 occasion {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="3" hidden {{ b_s3.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" data-rf2-t="s3.title">{{ b_s3.settings.title | escape }}</legend>
          <div class="rf2-q__chips" data-rf2-group="occasion">
            {%- for l in s3_lines -%}
              {%- assign l = l | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- assign f = l | split: '|' -%}
              {%- assign f0 = f[0] | strip -%}
              {%- assign f1 = f[1] | strip | downcase -%}
              <label class="rf2-q__chip" data-rf2-auto><input type="radio" name="rf2_occasion" value="{{ f0 | escape }}" data-occasion="{{ f1 | escape }}"><span>{{ f0 | escape }}</span></label>
            {%- endfor -%}
          </div>
          <div class="rf2-q__field" data-rf2-other="occasion" hidden>
            <label for="{{ uid }}-oother" data-rf2-t="s3.other_label">{{ b_s3.settings.other_label | escape }}</label>
            <input id="{{ uid }}-oother" type="text" name="occasion_other" maxlength="60" autocomplete="off" aria-describedby="{{ uid }}-oother-h">
            <small class="rf2-q__help" id="{{ uid }}-oother-h" data-rf2-t="s3.other_help">{{ b_s3.settings.other_help | escape }}</small>
          </div>
        </fieldset>

        {%- comment -%} S4 tone, style, voice {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="4" hidden {{ b_s4.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" data-rf2-t="s4.tone_title">{{ b_s4.settings.tone_title | escape }}</legend>
          <div class="rf2-q__tones" data-rf2-group="tone">
            <label class="rf2-q__tone"><input type="radio" name="rf2_tone" value="emouvant"><span><b data-rf2-t="s4.tone_emouvant_title">{{ b_s4.settings.tone_emouvant_title | escape }}</b><small data-rf2-t="s4.tone_emouvant_sub">{{ b_s4.settings.tone_emouvant_sub | escape }}</small></span></label>
            <label class="rf2-q__tone"><input type="radio" name="rf2_tone" value="drole"><span><b data-rf2-t="s4.tone_drole_title">{{ b_s4.settings.tone_drole_title | escape }}</b><small data-rf2-t="s4.tone_drole_sub">{{ b_s4.settings.tone_drole_sub | escape }}</small></span></label>
            <label class="rf2-q__tone"><input type="radio" name="rf2_tone" value="les-deux"><span><b data-rf2-t="s4.tone_les_deux_title">{{ b_s4.settings.tone_les_deux_title | escape }}</b><small data-rf2-t="s4.tone_les_deux_sub">{{ b_s4.settings.tone_les_deux_sub | escape }}</small></span></label>
          </div>
          <p class="rf2-q__group" id="{{ uid }}-st">{{ b_s4.settings.style_title | escape }}</p>
          <div class="rf2-q__chips" data-rf2-group="style" role="radiogroup" aria-labelledby="{{ uid }}-st">
            {%- assign si = 0 -%}
            {%- for l in s4_styles -%}
              {%- assign l = l | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- assign f = l | split: '|' -%}
              {%- assign f0 = f[0] | strip -%}
              {%- assign f1 = f[1] | strip | downcase -%}
              {%- assign f2 = f[2] | strip | downcase -%}
              {%- assign si = si | plus: 1 -%}
              <label class="rf2-q__chip"{% if si > vis_styles %} data-rf2-more hidden{% endif %}><input type="radio" name="rf2_style" value="{{ f1 | escape }}" data-tone-pre="{{ f2 | escape }}"><span>{{ f0 | escape }}</span></label>
            {%- endfor -%}
            {%- if si > vis_styles -%}
              <button type="button" class="rf2-q__link rf2-q__more" data-rf2-more-toggle aria-expanded="false">{{ b_s4.settings.more_styles | escape }}</button>
            {%- endif -%}
          </div>
          <p class="rf2-q__group" id="{{ uid }}-vt">{{ b_s4.settings.voice_title | escape }}</p>
          <div class="rf2-q__chips" data-rf2-group="voice" role="radiogroup" aria-labelledby="{{ uid }}-vt">
            {%- for l in s4_voices -%}
              {%- assign l = l | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- assign f = l | split: '|' -%}
              {%- assign f0 = f[0] | strip -%}
              {%- assign f1 = f[1] | strip | downcase -%}
              <label class="rf2-q__chip"><input type="radio" name="rf2_voice" value="{{ f1 | escape }}"><span>{{ f0 | escape }}</span></label>
            {%- endfor -%}
          </div>
          {%- if ss.show_english_link -%}
            <button type="button" class="rf2-q__link" data-rf2-lang aria-pressed="false" data-off="{{ b_s4.settings.lang_link | escape }}" data-on="{{ b_s4.settings.lang_on | escape }}">{{ b_s4.settings.lang_link | escape }}</button>
          {%- endif -%}
        </fieldset>

        {%- comment -%} S5 signature (required, 8-160) {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="5" hidden {{ b_s5.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" id="{{ uid }}-s5t" data-rf2-t="s5.{mode}_title">{{ b_s5.settings.emotional_title | escape }}</legend>
          <p class="rf2-q__lead" id="{{ uid }}-s5h" data-rf2-t="s5.{mode}_help">{{ b_s5.settings.emotional_help | escape }}</p>
          <ul class="rf2-q__ex" data-rf2-ex="s5" aria-hidden="true"></ul>
          <div class="rf2-q__field">
            <textarea name="signature" rows="2" maxlength="160" autocomplete="off" aria-labelledby="{{ uid }}-s5t" aria-describedby="{{ uid }}-s5h {{ uid }}-s5c"></textarea>
            <small class="rf2-q__count" id="{{ uid }}-s5c" data-rf2-count="signature">0 / 160</small>
          </div>
          <div class="rf2-q__starters" data-rf2-starters></div>
        </fieldset>

        {%- comment -%} S6 the scene (required, 20-600) {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="6" hidden {{ b_s6.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" id="{{ uid }}-s6t" data-rf2-t="s6.{mode}_title">{{ b_s6.settings.emotional_title | escape }}</legend>
          <p class="rf2-q__lead" id="{{ uid }}-s6h" data-rf2-t="s6.{mode}_help">{{ b_s6.settings.emotional_help | escape }}</p>
          <ul class="rf2-q__ex" data-rf2-ex="s6" aria-hidden="true"></ul>
          <div class="rf2-q__field">
            <textarea name="memory" rows="5" maxlength="600" autocomplete="off" aria-labelledby="{{ uid }}-s6t" aria-describedby="{{ uid }}-s6h {{ uid }}-s6c"></textarea>
            <small class="rf2-q__count" id="{{ uid }}-s6c" data-rf2-count="memory">0 / 600</small>
          </div>
          {%- if b_s6.settings.mic_tip != blank -%}<p class="rf2-q__tip" data-rf2-t="s6.mic_tip">{{ b_s6.settings.mic_tip | escape }}</p>{%- endif -%}
          <div class="rf2-q__nudge" data-rf2-nudge role="status" hidden>
            <p data-rf2-t="s6.nudge_text">{{ b_s6.settings.nudge_text | escape }}</p>
            <div class="rf2-q__nudge-actions">
              <button type="button" class="rf2-q__btn rf2-q__btn--ghost" data-rf2-nudge-add data-rf2-t="s6.nudge_add">{{ b_s6.settings.nudge_add | escape }}</button>
              <button type="button" class="rf2-q__link" data-rf2-nudge-skip data-rf2-t="s6.nudge_skip">{{ b_s6.settings.nudge_skip | escape }}</button>
            </div>
          </div>
        </fieldset>

        {%- comment -%} S7 the unsaid (optional) + recap {%- endcomment -%}
        <fieldset class="rf2-q__step" data-rf2-step="7" hidden {{ b_s7.shopify_attributes }}>
          <legend class="rf2-q__t" tabindex="-1" id="{{ uid }}-s7t" data-rf2-t="s7.{mode}_title">{{ b_s7.settings.emotional_title | escape }}</legend>
          <p class="rf2-q__lead" id="{{ uid }}-s7h" data-rf2-t="s7.{mode}_help">{{ b_s7.settings.emotional_help | escape }}</p>
          <div class="rf2-q__field">
            <textarea name="message" rows="3" maxlength="400" autocomplete="off" aria-labelledby="{{ uid }}-s7t" aria-describedby="{{ uid }}-s7h {{ uid }}-s7c"></textarea>
            <small class="rf2-q__count" id="{{ uid }}-s7c" data-rf2-count="message">0 / 400</small>
          </div>
          {%- if ss.answers_recap -%}
            <div class="rf2-q__recap" data-rf2-recap-card {{ b_recap.shopify_attributes }}>
              <div class="rf2-q__recap-top">
                <p class="rf2-q__recap-t" data-rf2-t="recap.title">{{ b_recap.settings.title | escape }}</p>
                <button type="button" class="rf2-q__link" data-rf2-recap-edit data-rf2-t="recap.edit">{{ b_recap.settings.edit | escape }}</button>
              </div>
              <p class="rf2-q__recap-name" data-rf2-rc="name"></p>
              <p class="rf2-q__recap-q" data-rf2-rc="signature"></p>
              <p class="rf2-q__recap-q rf2-q__recap-q--m" data-rf2-rc="memory"></p>
              <p class="rf2-q__recap-meta" data-rf2-rc="meta"></p>
            </div>
          {%- endif -%}
          <div class="rf2-q__trap" aria-hidden="true"><input type="text" name="hp" tabindex="-1" autocomplete="off" value=""></div>
        </fieldset>

        <p class="rf2-q__err" id="{{ uid }}-err" data-rf2-err role="alert" hidden></p>
        <p class="rf2-q__near" data-rf2-near hidden data-rf2-t="quiz.near_end">{{ b_quiz.settings.near_end | escape }}</p>
        <div class="rf2-q__nav" data-rf2-nav>
          <button type="button" class="rf2-q__btn rf2-q__btn--ghost" data-rf2-back hidden data-rf2-t="quiz.back">{{ b_quiz.settings.back | escape }}</button>
          <button type="submit" class="rf2-q__btn rf2-q__btn--next" data-rf2-next>{{ b_quiz.settings.next | escape }}</button>
        </div>
      </form>

      {%- comment -%} WAIT {%- endcomment -%}
      <div class="rf2-q__wait" data-rf2-wait hidden {{ b_wait.shopify_attributes }}>
        <div class="rf2-q__wbar" aria-hidden="true"><i data-rf2-wbar></i></div>
        <p class="rf2-q__eta" data-rf2-eta {% unless ss.eta %}hidden{% endunless %}></p>
        <h2 class="rf2-q__wt" tabindex="-1" data-rf2-wait-h data-rf2-t="wait.recap_title">{{ b_wait.settings.recap_title | escape }}</h2>
        <ul class="rf2-q__wrecap" data-rf2-wrecap></ul>
        <ol class="rf2-q__stages" data-rf2-stages aria-live="polite"></ol>
        <div class="rf2-q__song" data-rf2-song hidden>
          <p class="rf2-q__song-l" data-rf2-t="wait.title_label">{{ b_wait.settings.title_label | escape }}</p>
          <p class="rf2-q__song-t" data-rf2-song-title></p>
          <p class="rf2-q__song-l" data-rf2-t="wait.lyrics_label">{{ b_wait.settings.lyrics_label | escape }}</p>
          <div class="rf2-q__song-lines" data-rf2-song-lines></div>
          <p class="rf2-q__song-mask" data-rf2-mask hidden data-rf2-t="wait.hook_mask">{{ b_wait.settings.hook_mask | escape }}</p>
        </div>
        <p class="rf2-q__wsound" data-rf2-wsound hidden data-rf2-t="wait.sound_up">{{ b_wait.settings.sound_up | escape }}</p>
        <p class="rf2-q__wnote" data-rf2-slow role="status" hidden data-rf2-t="wait.slow">{{ b_wait.settings.slow | escape }}</p>
        <p class="rf2-q__wnote" data-rf2-retry role="status" hidden data-rf2-t="wait.retry">{{ b_wait.settings.retry | escape }}</p>
        <div class="rf2-q__wfail" data-rf2-fail role="alert" hidden>
          <p data-rf2-fail-msg></p>
          <button type="button" class="rf2-q__btn" data-rf2-repost data-rf2-t="wait.failed_cta">{{ b_wait.settings.failed_cta | escape }}</button>
        </div>
        <div class="rf2-q__woffer">
          <p data-rf2-t="wait.offer_recap">{{ b_wait.settings.offer_recap | escape }}</p>
          {%- if b_offer.settings.xmas_line != blank -%}<p data-rf2-xmas>{{ b_offer.settings.xmas_line | escape }}</p>{%- endif -%}
        </div>
      </div>

      {%- comment -%} REVEAL + OFFER {%- endcomment -%}
      <div class="rf2-q__rv" data-rf2-rv hidden {{ b_reveal.shopify_attributes }}>
        <div class="rf2-q__player" data-rf2-player>
          <div class="rf2-q__rv-head">
            <p class="rf2-q__rv-k" data-rf2-rv-k></p>
            <p class="rf2-q__rv-name" data-rf2-rv-name></p>
            <h2 class="rf2-q__rv-title" tabindex="-1" data-rf2-rv-title></h2>
          </div>
          <div class="rf2-q__pre" data-rf2-pre>
            <button type="button" class="rf2-q__big" data-rf2-play-big>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
            </button>
            <p class="rf2-q__pre-l" data-rf2-pre-label></p>
            <p class="rf2-q__pre-s" data-rf2-t="reveal.sound_up">{{ b_reveal.settings.sound_up | escape }}</p>
          </div>
          <div class="rf2-q__k" data-rf2-k></div>
          <div class="rf2-q__after" data-rf2-after hidden></div>
          <div class="rf2-q__ctrl" data-rf2-ctrl hidden>
            <button type="button" class="rf2-q__pbtn" data-rf2-play>
              <svg data-rf2-ico-play viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
              <svg data-rf2-ico-pause viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg>
              <span class="rf2-q__pbtn-l" data-rf2-replay-l hidden></span>
            </button>
            <div class="rf2-q__ptrack">
              <span class="rf2-q__pbar" aria-hidden="true"><i data-rf2-prog></i></span>
              <span class="rf2-q__ptime" aria-hidden="true"><span data-rf2-cur>0:00</span> / <span data-rf2-dur>0:15</span></span>
            </div>
          </div>
          <div class="rf2-q__end" data-rf2-endbox hidden>
            {%- if ss.locked_strip -%}<p class="rf2-q__strip" data-rf2-strip></p>{%- endif -%}
            <p class="rf2-q__tease" data-rf2-tease hidden></p>
            <p class="rf2-q__own" data-rf2-own></p>
            {%- if ss.reciprocity -%}<p class="rf2-q__recip" data-rf2-recip></p>{%- endif -%}
          </div>
        </div>

        <div class="rf2-q__offer" data-rf2-offer hidden {{ b_offer.shopify_attributes }}>
          <button type="button" class="rf2-q__cta" data-rf2-buy></button>
          <p class="rf2-q__added" data-rf2-added role="status" hidden></p>
          <p class="rf2-q__cerr" data-rf2-cart-err role="alert" hidden data-rf2-t="offer.cart_error">{{ b_offer.settings.cart_error | escape }}</p>
          {%- if ss.tier_ui == 'cards' -%}
            <fieldset class="rf2-q__tiers">
              <legend class="rf2-q__sr">{{ b_offer.settings.premium_line | escape }}</legend>
              <label class="rf2-q__tier"><input type="radio" name="rf2_tier" value="standard"{% if ss.default_tier != 'premium' %} checked{% endif %}><span><b>{{ v_std.title | escape }}</b><b data-rf2-price="std"></b></span></label>
              <label class="rf2-q__tier"><input type="radio" name="rf2_tier" value="premium"{% if ss.default_tier == 'premium' %} checked{% endif %}><span><b>{{ v_prem.title | escape }}</b><b data-rf2-price="prem"></b><small>{{ b_offer.settings.premium_line | escape }}</small></span></label>
            </fieldset>
          {%- else -%}
            <label class="rf2-q__prem"><input type="checkbox" data-rf2-prem{% if ss.default_tier == 'premium' %} checked{% endif %}><span>{{ b_offer.settings.premium_line | escape }}</span></label>
          {%- endif -%}
          <button type="button" class="rf2-q__link rf2-q__photo-link" data-rf2-photo-link aria-expanded="false" hidden data-rf2-t="offer.photo_link">{{ b_offer.settings.photo_link | escape }}</button>

          {%- comment -%} Optional Premium photo (API contract v2): chosen before payment, never blocks the purchase. {%- endcomment -%}
          <div class="rf2-q__photo" data-rf2-photo role="group" aria-labelledby="{{ uid }}-pht" hidden {{ b_photo.shopify_attributes }}>
            <p class="rf2-q__photo-t" id="{{ uid }}-pht" data-rf2-t="photo.title">{{ b_photo.settings.title | escape }}</p>
            <p class="rf2-q__photo-h" id="{{ uid }}-phh" data-rf2-t="photo.help">{{ b_photo.settings.help | escape }}</p>
            <div class="rf2-q__photo-pick" data-rf2-photo-pick>
              <input class="rf2-q__photo-file" id="{{ uid }}-photo" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" aria-describedby="{{ uid }}-phh {{ uid }}-phf" data-rf2-photo-input>
              <label class="rf2-q__btn rf2-q__btn--ghost rf2-q__photo-btn" for="{{ uid }}-photo"><span data-rf2-photo-pick-label>{{ b_photo.settings.pick | escape }}</span></label>
              <span class="rf2-q__photo-f" id="{{ uid }}-phf" data-rf2-t="photo.formats">{{ b_photo.settings.formats | escape }}</span>
            </div>
            <div class="rf2-q__photo-card" data-rf2-photo-card hidden>
              <img class="rf2-q__photo-img" data-rf2-photo-img alt="" width="72" height="72" hidden>
              <div>
                <p class="rf2-q__photo-s" data-rf2-photo-status role="status" aria-live="polite"></p>
                <button type="button" class="rf2-q__link" data-rf2-photo-remove data-rf2-t="photo.remove">{{ b_photo.settings.remove | escape }}</button>
              </div>
            </div>
            <div data-rf2-photo-confirm hidden>
              <label class="rf2-q__check" for="{{ uid }}-phc">
                <input id="{{ uid }}-phc" type="checkbox" data-rf2-photo-consent>
                <span>{{ b_photo.settings.consent | escape }} <a href="{{ privacy_url }}" target="_blank" rel="noopener">{{ b_photo.settings.consent_more | escape }}</a></span>
              </label>
              <button type="button" class="rf2-q__btn" data-rf2-photo-send disabled data-rf2-t="photo.send">{{ b_photo.settings.send | escape }}</button>
            </div>
            <p class="rf2-q__cerr" data-rf2-photo-err role="alert" hidden></p>
          </div>

          <p class="rf2-q__risk" data-rf2-t="offer.risk_line">{{ b_offer.settings.risk_line | escape }}</p>
          {%- if b_offer.settings.xmas_line != blank -%}<p class="rf2-q__xmas" data-rf2-xmas>{{ b_offer.settings.xmas_line | escape }}</p>{%- endif -%}
          <p class="rf2-q__secure"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 10V8a5 5 0 0 1 10 0v2h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zm2 0h6V8a3 3 0 0 0-6 0z" fill="currentColor"/></svg><span data-rf2-t="offer.secure">{{ b_offer.settings.secure | escape }}</span></p>
        </div>
      </div>
    </div>

    {%- if ss.sticky_cta -%}
      <div class="rf2-q__sticky" data-rf2-sticky hidden>
        <button type="button" class="rf2-q__cta rf2-q__cta--sticky" data-rf2-buy-sticky></button>
      </div>
    {%- endif -%}
    <audio class="rf2-q__audio" data-rf2-audio playsinline preload="none"></audio>
  </rf2-quiz>
</section>

{% stylesheet %}
  .rf2-q { background: var(--rf2-q-bg); color: var(--rf2-q-text); font-family: var(--rf2-q-sans); font-size: var(--rf2-q-fs); padding: var(--rf2-q-pt) 16px var(--rf2-q-pb); scroll-margin-top: 8px; }
  .rf2-q [hidden] { display: none !important; }
  .rf2-q__inner { display: block; max-width: var(--rf2-q-w); margin: 0 auto; }
  .rf2-q__sr { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); border: 0; white-space: nowrap; }
  .rf2-q :focus:not(:focus-visible) { outline: none; }
  .rf2-q :is(a, button, input, textarea, [tabindex]):focus-visible { outline: 3px solid var(--rf2-q-violet); outline-offset: 2px; }

  /* first screen */
  .rf2-q__hero { text-align: center; margin: 0 auto 12px; }
  .rf2-q__kicker { margin: 0 0 6px; font-size: 13.5px; font-weight: 700; line-height: 1.35; color: var(--rf2-q-soft); }
  .rf2-q__h1 { margin: 0; font-family: var(--rf2-q-head); font-weight: 800; font-size: var(--rf2-q-h1); line-height: 1.06; letter-spacing: -0.035em; color: var(--rf2-q-ink); text-wrap: balance; overflow-wrap: break-word; }
  .rf2-q__h1 em { font-family: var(--rf2-q-serif); font-style: italic; font-weight: 500; letter-spacing: -0.02em; color: var(--rf2-q-violet); }
  .rf2-q__sub { margin: 6px 0 0; font-size: 15px; line-height: 1.4; color: var(--rf2-q-soft); }
  .rf2-q__promise { margin: 10px auto 0; padding: 9px 14px; max-width: 30em; border-radius: calc(var(--rf2-q-radius) * .6); background: var(--rf2-q-ink); color: #fff; font-size: 13.5px; font-weight: 600; line-height: 1.4; text-wrap: balance; }

  /* quiz card */
  .rf2-q__card { position: relative; background: var(--rf2-q-card); border-radius: var(--rf2-q-radius); padding: 14px 14px 12px; box-shadow: 0 18px 50px -24px rgb(30 15 74 / .35); scroll-margin-top: 12px; }
  .rf2-q__progress { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 12.5px; font-weight: 700; color: var(--rf2-q-soft); }
  .rf2-q__plabel { flex: none; }
  .rf2-q__bar { flex: 1; height: 7px; border-radius: 99px; background: color-mix(in srgb, var(--rf2-q-violet) 16%, transparent); overflow: hidden; }
  .rf2-q__bar i { display: block; height: 100%; background: var(--rf2-q-violet); border-radius: inherit; transition: width .35s ease; }
  .rf2-q__step { border: 0; margin: 0; padding: 0; min-width: 0; }
  .rf2-q__t { display: block; padding: 0; margin: 0 0 10px; font-family: var(--rf2-q-head); font-size: 21px; font-weight: 800; line-height: 1.18; letter-spacing: -0.025em; color: var(--rf2-q-ink); }
  .rf2-q__lead { margin: -4px 0 10px; font-size: 14.5px; line-height: 1.45; color: var(--rf2-q-soft); }
  .rf2-q__lead:empty { display: none; }
  .rf2-q__group { margin: 14px 0 8px; font-size: 13px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--rf2-q-soft); }
  .rf2-q__chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .rf2-q__chip, .rf2-q__tone, .rf2-q__tier, .rf2-q__prem { position: relative; cursor: pointer; max-width: 100%; }
  .rf2-q__chip input, .rf2-q__tone input, .rf2-q__tier input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; margin: 0; }
  .rf2-q__chip span { display: inline-flex; align-items: center; min-height: 42px; padding: 7px 14px; border-radius: 999px; background: color-mix(in srgb, var(--rf2-q-bg) 45%, #fff); border: 1.5px solid color-mix(in srgb, var(--rf2-q-violet) 22%, transparent); font-size: 15px; font-weight: 650; line-height: 1.2; color: var(--rf2-q-ink); transition: background-color .15s, border-color .15s, color .15s; }
  .rf2-q__chip:hover span { border-color: var(--rf2-q-violet); }
  .rf2-q__chip input:checked + span { background: var(--rf2-q-ink); border-color: var(--rf2-q-ink); color: #fff; }
  .rf2-q__chip input:focus-visible + span, .rf2-q__tone input:focus-visible + span, .rf2-q__tier input:focus-visible + span { outline: 3px solid var(--rf2-q-violet); outline-offset: 2px; }
  .rf2-q__chips:has([aria-invalid]) .rf2-q__chip span, .rf2-q__tones:has([aria-invalid]) .rf2-q__tone span { border-color: #9b1235; }
  .rf2-q__tones { display: grid; gap: 8px; }
  .rf2-q__tone span { display: grid; gap: 2px; padding: 11px 14px; border-radius: 16px; border: 1.5px solid color-mix(in srgb, var(--rf2-q-violet) 22%, transparent); background: color-mix(in srgb, var(--rf2-q-bg) 45%, #fff); }
  .rf2-q__tone b { font-size: 16px; color: var(--rf2-q-ink); }
  .rf2-q__tone small { font-size: 13.5px; color: var(--rf2-q-soft); }
  .rf2-q__tone input:checked + span { background: var(--rf2-q-ink); border-color: var(--rf2-q-ink); }
  .rf2-q__tone input:checked + span b { color: var(--rf2-q-lime); }
  .rf2-q__tone input:checked + span small { color: #fff; }
  .rf2-q__more { min-height: 42px; }
  .rf2-q__field { display: grid; gap: 5px; margin-top: 10px; font-size: 14px; font-weight: 650; color: var(--rf2-q-ink); }
  .rf2-q__field input, .rf2-q__field textarea { width: 100%; box-sizing: border-box; min-height: 48px; padding: 11px 14px; border: 1.5px solid color-mix(in srgb, var(--rf2-q-violet) 35%, transparent); border-radius: 14px; background: #fff; font: 500 16px/1.45 var(--rf2-q-sans); color: var(--rf2-q-ink); resize: vertical; }
  .rf2-q__field input:focus, .rf2-q__field textarea:focus { outline: none; border-color: var(--rf2-q-violet); box-shadow: 0 0 0 3px color-mix(in srgb, var(--rf2-q-violet) 40%, transparent); }
  .rf2-q__field [aria-invalid='true'] { border-color: #9b1235; }
  .rf2-q__help { font-size: 13px; font-weight: 500; line-height: 1.45; color: var(--rf2-q-soft); }
  .rf2-q__count { justify-self: end; font-size: 12.5px; font-weight: 500; color: var(--rf2-q-soft); font-variant-numeric: tabular-nums; }
  .rf2-q__ex { list-style: none; margin: 0 0 4px; padding: 0; display: grid; gap: 4px; min-height: 2.6em; }
  .rf2-q__ex li { position: relative; padding-left: 14px; font-size: 13.5px; line-height: 1.4; font-style: italic; color: var(--rf2-q-soft); animation: rf2-q-fade .5s ease both; }
