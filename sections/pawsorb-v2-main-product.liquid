{%- liquid
  assign ss = section.settings
  assign p = product
  if p == blank
    assign p = closest.product
  endif
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant
  assign images = p.media | where: 'media_type', 'image'
  assign title = ss.title_override | default: p.title | default: 'PawSorb™ Activated Charcoal First Aid Gel'
  assign title_html = title | escape
  assign fallback_list = ss.fallback_assets | split: ','
  assign start_qty = 1
  assign has_pre = false
  for b in section.blocks
    if b.type == 'tier' and b.settings.preselect
      assign start_qty = b.settings.quantity
      assign has_pre = true
      break
    endif
  endfor
  unless has_pre
    for b in section.blocks
      if b.type == 'tier'
        assign start_qty = b.settings.quantity
        break
      endif
    endfor
  endunless
  assign award = section.blocks | where: 'type', 'award' | first
  assign notice = section.blocks | where: 'type', 'notice' | first
  assign calc = section.blocks | where: 'type', 'calculator' | first
  assign comment = section.blocks | where: 'type', 'comment' | first
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign faqs = section.blocks | where: 'type', 'faq'
-%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
{%- if ss.chrome_enabled -%}
  {%- comment -%} Page chrome for this template only (header line, footer colour, cart drawer canvas). Never affects other templates. {%- endcomment -%}
  <style>
    #header-group .header-section { border-bottom: 1px solid {{ ss.line_color }}; }
    .shopify-section-group-footer-group .section-background { background-color: {{ ss.footer_bg }} !important; }
    .shopify-section-group-footer-group { color: {{ ss.footer_text }}; }
    .pawsorb-cd__panel, .pawsorb-cd__foot, .pawsorb-cd__ship { background: {{ ss.bg_color }}; }
    .pawsorb-cd__head, .pawsorb-cd__ship, .pawsorb-cd__item, .pawsorb-cd__foot { border-color: rgba(18, 22, 20, .1); }
    .pawsorb-cd__checkout, .pawsorb-cd__emptylink { border-radius: 32px; }
    .pawsorb-cd__x, .pawsorb-cd__thumb, .pawsorb-cd__emptyic { background: #FFFFFF; }
  </style>
{%- endif -%}
<pawsorb-v2-buy-box
  class="pawsorb-v2-pdp"
  style="--pawsorb-v2-pdp-bg: {{ ss.bg_color }}; --pawsorb-v2-pdp-ink: {{ ss.text_color }}; --pawsorb-v2-pdp-muted: {{ ss.muted_color }}; --pawsorb-v2-pdp-acc: {{ ss.accent_color }}; --pawsorb-v2-pdp-acc-h: {{ ss.accent_hover }}; --pawsorb-v2-pdp-deep: {{ ss.deep_color }}; --pawsorb-v2-pdp-line: {{ ss.line_color }}; --pawsorb-v2-pdp-tierline: {{ ss.tier_border }}; --pawsorb-v2-pdp-h1: {{ ss.title_size }}px; --pawsorb-v2-pdp-h1m: {{ ss.title_size_mobile }}px; --pawsorb-v2-pdp-hw: {{ ss.heading_weight }}; --pawsorb-v2-pdp-pt: {{ ss.padding_top }}px; --pawsorb-v2-pdp-pb: {{ ss.padding_bottom }}px; --pawsorb-v2-pdp-pbm: {{ ss.padding_bottom_mobile }}px;"
  data-section="{{ section.id }}"
>
  <div class="pawsorb-v2-pdp__grid">
    <div class="pawsorb-v2-pdp__gallery">
      <div class="pawsorb-v2-pdp__stage">
        <div class="pawsorb-v2-pdp__track" data-pawsorb-rail data-v2-track>
          {%- if images.size > 0 -%}
            {%- for m in images -%}
              <div class="pawsorb-v2-pdp__slide">
                {%- assign ld = 'lazy' -%}{%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- endif -%}
                {%- assign m_alt = m.alt | default: ss.gallery_alt -%}
                {{ m.preview_image | image_url: width: 1200 | image_tag: loading: ld, sizes: '(min-width: 990px) 520px, 100vw', widths: '400, 600, 800, 1000, 1200', alt: m_alt, class: 'pawsorb-v2-pdp__img' }}
              </div>
            {%- endfor -%}
          {%- elsif ss.fallback_image != blank -%}
            <div class="pawsorb-v2-pdp__slide">{{ ss.fallback_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: ss.gallery_alt, class: 'pawsorb-v2-pdp__img' }}</div>
          {%- else -%}
            {%- for f in fallback_list -%}
              {%- assign fn = f | strip -%}
              {%- if fn == blank -%}{%- continue -%}{%- endif -%}
              <div class="pawsorb-v2-pdp__slide">
                <img class="pawsorb-v2-pdp__img" src="{{ fn | asset_url }}" alt="{{ ss.gallery_alt | escape }}" width="1200" height="1200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async" onerror="this.parentNode.classList.add('is-missing')">
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="pawsorb-v2-pdp__fb" aria-hidden="true">{% render 'pawsorb-pack-art' %}</div>
      </div>
      {%- liquid
        assign n_slides = images.size
        if n_slides == 0 and ss.fallback_image == blank
          assign n_slides = fallback_list.size
        endif
      -%}
      {%- if n_slides > 1 -%}
        <div class="pawsorb-v2-pdp__dots" aria-hidden="true">
          {%- for i in (1..n_slides) -%}<span class="pawsorb-v2-pdp__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
        </div>
        <div class="pawsorb-v2-pdp__thumbs" data-pawsorb-rail>
          {%- if images.size > 0 -%}
            {%- for m in images -%}
              <button type="button" class="pawsorb-v2-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ forloop.index }} / {{ images.size }}">
                {{ m.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 56, height: 56 }}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- for f in fallback_list -%}
              {%- assign fn = f | strip -%}
              <button type="button" class="pawsorb-v2-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ forloop.index }} / {{ fallback_list.size }}">
                <img src="{{ fn | asset_url }}" alt="" width="56" height="56" loading="lazy" onerror="this.parentNode.hidden=true">
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pawsorb-v2-pdp__info">
      {%- if ss.rating_text != blank -%}
        <p class="pawsorb-v2-pdp__rating">
          <span class="pawsorb-v2-pdp__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'pawsorb-icon', name: 'star', size: 16 %}{%- endfor -%}</span>
          <span>{{ ss.rating_text }}</span>
        </p>
      {%- endif -%}
      <h1 class="pawsorb-v2-pdp__title">{{ title_html }}</h1>

      {%- if award -%}
        <p class="pawsorb-v2-pdp__award" {{ award.shopify_attributes }}>
          <span class="pawsorb-v2-pdp__award-no">{{ award.settings.number }}</span>
          <span class="pawsorb-v2-pdp__award-txt"><strong>{{ award.settings.line_1 }}</strong>{%- if award.settings.line_2 != blank -%}<em>{{ award.settings.line_2 }}</em>{%- endif -%}</span>
        </p>
      {%- endif -%}

      {%- if ss.paragraph != blank -%}<div class="pawsorb-v2-pdp__desc">{{ ss.paragraph }}</div>{%- endif -%}

      {%- if benefits.size > 0 -%}
        <ul class="pawsorb-v2-pdp__benefits">
          {%- for b in benefits -%}
            <li {{ b.shopify_attributes }}><span class="pawsorb-v2-pdp__bic" aria-hidden="true"><span>{% render 'pawsorb-icon', name: 'check', size: 18 %}</span></span><span>{{ b.settings.label }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if calc -%}
        <button type="button" class="pawsorb-v2-pdp__calcbtn" data-v2-calc-open {{ calc.shopify_attributes }}>{% render 'pawsorb-icon', name: 'paw', size: 18 %}<span>{{ calc.settings.button_label }}</span></button>
      {%- endif -%}

      {%- if notice -%}
        <div class="pawsorb-v2-pdp__notice" {{ notice.shopify_attributes }}>
          <svg class="pawsorb-v2-pdp__notice-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11v6M12 7.5v.5" stroke-linecap="round"/></svg>
          <div>
            {%- if notice.settings.title != blank -%}<p class="pawsorb-v2-pdp__notice-t">{{ notice.settings.title }}</p>{%- endif -%}
            {%- if notice.settings.body != blank -%}<p class="pawsorb-v2-pdp__notice-b">{{ notice.settings.body }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {% render 'pawsorb-v2-offer', section: section, start_qty: start_qty %}

      {%- if p != blank -%}
        {%- form 'product', p, class: 'pawsorb-v2-pdp__form', data-v2-form: '' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="{{ start_qty }}" data-v2-qty>
          <button type="submit" name="add" class="pawsorb-v2-pdp__atc" data-pawsorb-atc data-v2-atc {% unless v.available %}disabled{% endunless %}>
            <span>{% if v.available %}{{ ss.button_label }}{% else %}{{ ss.soldout_label }}{% endif %}</span>
            <span class="pawsorb-v2-pdp__spin" aria-hidden="true"></span>
          </button>
          <p class="pawsorb-v2-pdp__err" data-v2-err role="alert" hidden></p>
        {%- endform -%}
      {%- endif -%}

      {%- if ss.trust_1 != blank or ss.trust_2 != blank -%}
        <ul class="pawsorb-v2-pdp__trust">
          {%- if ss.trust_1 != blank -%}<li>{% render 'pawsorb-icon', name: 'check', size: 14 %}<span>{{ ss.trust_1 }}</span></li>{%- endif -%}
          {%- if ss.trust_2 != blank -%}<li>{% render 'pawsorb-icon', name: 'check', size: 14 %}<span>{{ ss.trust_2 }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}
      {%- if ss.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="pawsorb-v2-pdp__pay" aria-label="{{ ss.payment_label | escape }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if comment -%}
        {%- assign cs = comment.settings -%}
        <div class="pawsorb-v2-pdp__cmt" {{ comment.shopify_attributes }}>
          <span class="pawsorb-v2-pdp__avatar">
            <span class="pawsorb-v2-pdp__avatar-fb" aria-hidden="true">{{ cs.name | slice: 0 }}</span>
            {%- if cs.avatar != blank -%}
              {{ cs.avatar | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 36, height: 36 }}
            {%- elsif cs.avatar_asset != blank -%}
              <img src="{{ cs.avatar_asset | asset_url }}" alt="" width="36" height="36" loading="lazy" onerror="this.remove()">
            {%- endif -%}
          </span>
          <div class="pawsorb-v2-pdp__cmt-main">
            <div class="pawsorb-v2-pdp__bubble">
              <p class="pawsorb-v2-pdp__cmt-name">{{ cs.name }}</p>
              <div class="pawsorb-v2-pdp__cmt-text">{{ cs.text }}</div>
              {%- if cs.reactions != blank -%}
                <span class="pawsorb-v2-pdp__react"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="{{ cs.heart_color }}"/><path fill="#fff" d="M12 17.3l-.8-.7C8.4 14.1 6.6 12.5 6.6 10.5c0-1.6 1.2-2.8 2.8-2.8.9 0 1.8.4 2.4 1.1.6-.7 1.5-1.1 2.4-1.1 1.6 0 2.8 1.2 2.8 2.8 0 2-1.8 3.6-4.6 6.1z"/></svg>{{ cs.reactions }}</span>
              {%- endif -%}
            </div>
            <p class="pawsorb-v2-pdp__cmt-meta">{{ cs.meta }}</p>
          </div>
        </div>
      {%- endif -%}

      {%- if faqs.size > 0 -%}
        <div class="pawsorb-v2-pdp__faq">
          {%- for f in faqs -%}
            <details class="pawsorb-v2-pdp__q" name="pawsorb-v2-q-{{ section.id }}" {{ f.shopify_attributes }}>
              <summary><span>{{ f.settings.question }}</span><span class="pawsorb-v2-pdp__plus" aria-hidden="true">+</span></summary>
              <div class="pawsorb-v2-pdp__a">{{ f.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if calc -%}{% render 'pawsorb-v2-calculator', block: calc, section: section %}{%- endif -%}
</pawsorb-v2-buy-box>

{% stylesheet %}
  .pawsorb-v2-pdp { display: block; padding: var(--pawsorb-v2-pdp-pt, 24px) 16px var(--pawsorb-v2-pdp-pb, 56px); background: var(--pawsorb-v2-pdp-bg, #F8F5EF); color: var(--pawsorb-v2-pdp-ink, #121614); font-family: var(--font-body--family); }
  .pawsorb-v2-pdp__grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 576px) minmax(0, 560px); gap: 44px; align-items: start; justify-content: center; }
  .pawsorb-v2-pdp__gallery { position: sticky; top: 16px; display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 0 14px; min-width: 0; }
  .pawsorb-v2-pdp__stage { position: relative; grid-column: 2; grid-row: 1; border-radius: 8px; overflow: hidden; aspect-ratio: 1; background: #F0ECE6; }
  .pawsorb-v2-pdp__fb { position: absolute; inset: 0; display: grid; place-items: center; z-index: 0; }
  .pawsorb-v2-pdp__fb .pawsorb-pack-art { width: 80%; height: auto; }
  .pawsorb-v2-pdp__track { position: relative; z-index: 1; display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; cursor: grab; overscroll-behavior-x: contain; }
  .pawsorb-v2-pdp__track::-webkit-scrollbar { display: none; }
  .pawsorb-v2-pdp__track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .pawsorb-v2-pdp__slide { flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 1; background: #F0ECE6; }
  .pawsorb-v2-pdp__slide.is-missing { display: none; }
  .pawsorb-v2-pdp__img { width: 100%; height: 100%; object-fit: cover; display: block; -webkit-user-drag: none; }
  .pawsorb-v2-pdp__thumbs { position: relative; grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: 8px; height: 0; min-height: 100%; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #CFCAC2 transparent; padding-right: 2px; }
  .pawsorb-v2-pdp__thumbs::-webkit-scrollbar { width: 4px; height: 4px; }
  .pawsorb-v2-pdp__thumbs::-webkit-scrollbar-thumb { background: #CFCAC2; border-radius: 4px; }
  .pawsorb-v2-pdp__thumb { flex: 0 0 56px; width: 56px; height: 56px; padding: 0; border: 1px solid var(--pawsorb-v2-pdp-line, #E5E3DE); border-radius: 6px; overflow: hidden; background: #F0ECE6; cursor: pointer; }
  .pawsorb-v2-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; -webkit-user-drag: none; }
  .pawsorb-v2-pdp__thumb.is-active { border: 2px solid var(--pawsorb-v2-pdp-acc, #12855A); }
  .pawsorb-v2-pdp__dots { display: none; justify-content: center; gap: 6px; margin-top: 12px; grid-column: 1 / -1; }
  .pawsorb-v2-pdp__dot { width: 7px; height: 7px; border-radius: 50%; background: #D9D6CF; transition: background-color .2s; }
  .pawsorb-v2-pdp__dot.is-active { background: var(--pawsorb-v2-pdp-ink, #121614); }
  .pawsorb-v2-pdp__info { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .pawsorb-v2-pdp__rating { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 14px; line-height: 1.3; }
  .pawsorb-v2-pdp__stars { display: inline-flex; gap: 1px; color: var(--pawsorb-v2-pdp-acc, #12855A); }
  .pawsorb-v2-pdp__title { margin: -6px 0 0; font-family: var(--font-body--family); font-weight: var(--pawsorb-v2-pdp-hw, 400); font-size: var(--pawsorb-v2-pdp-h1, 39px); line-height: 1.15; letter-spacing: -.02em; color: var(--pawsorb-v2-pdp-ink, #121614); }
  .pawsorb-v2-pdp__award { display: inline-flex; align-self: flex-start; align-items: stretch; margin: 0; border: 1px solid var(--pawsorb-v2-pdp-acc, #12855A); border-radius: 4px; background: #fff; }
  .pawsorb-v2-pdp__award-no { display: grid; place-items: center; padding: 0 10px; background: var(--pawsorb-v2-pdp-acc, #12855A); color: var(--pawsorb-v2-pdp-bg, #F8F5EF); font-weight: 700; font-size: 20px; border-radius: 3px 0 0 3px; }
  .pawsorb-v2-pdp__award-txt { display: flex; flex-direction: column; justify-content: center; padding: 4px 12px 5px 10px; }
  .pawsorb-v2-pdp__award-txt strong { font-weight: 500; font-size: 13px; line-height: 1.25; text-transform: uppercase; letter-spacing: .01em; }
  .pawsorb-v2-pdp__award-txt em { font-style: italic; font-size: 10px; line-height: 1.3; color: var(--pawsorb-v2-pdp-muted, #5B625E); }
  .pawsorb-v2-pdp__desc { font-size: 15px; line-height: 1.55; letter-spacing: -.2px; color: #2E3431; }
  .pawsorb-v2-pdp__desc p { margin: 0; }
  .pawsorb-v2-pdp__desc p + p { margin-top: 8px; }
  .pawsorb-v2-pdp__benefits { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, max-content); gap: 14px 28px; }
  .pawsorb-v2-pdp__benefits li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; line-height: 1.25; }
  .pawsorb-v2-pdp__bic { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--pawsorb-v2-pdp-acc, #12855A) 12%, transparent); }
  .pawsorb-v2-pdp__bic > span { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--pawsorb-v2-pdp-acc, #12855A); color: #fff; }
  .pawsorb-v2-pdp__bic .pawsorb-icon { stroke-width: 2.6; }
  .pawsorb-v2-pdp__calcbtn { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; margin-top: 6px; min-height: 48px; padding: 0 22px; border: 2px solid var(--pawsorb-v2-pdp-deep, #0B5E3F); border-radius: 8px; background: #fff; color: var(--pawsorb-v2-pdp-deep, #0B5E3F); font: 600 15px/1 var(--font-body--family); cursor: pointer; }
  .pawsorb-v2-pdp__calcbtn:hover { background: color-mix(in srgb, var(--pawsorb-v2-pdp-deep, #0B5E3F) 6%, #fff); }
  .pawsorb-v2-pdp__calcbtn .pawsorb-icon { fill: currentColor; stroke: none; }
  .pawsorb-v2-pdp__notice { display: flex; gap: 10px; align-items: flex-start; margin-top: 8px; padding: 14px 16px; border: 1px dashed var(--pawsorb-v2-pdp-ink, #121614); border-radius: 8px; background: #F1ECE3; }
  .pawsorb-v2-pdp__notice-ic { flex: 0 0 18px; margin-top: 1px; color: var(--pawsorb-v2-pdp-deep, #0B5E3F); }
  .pawsorb-v2-pdp__notice-t { margin: 0 0 3px; font-size: 13px; font-weight: 700; line-height: 1.3; text-transform: uppercase; color: var(--pawsorb-v2-pdp-deep, #0B5E3F); }
  .pawsorb-v2-pdp__notice-b { margin: 0; font-size: 12px; line-height: 1.45; color: #2E3431; }
  .pawsorb-v2-pdp__form { margin: 2px 0 0; }
  .pawsorb-v2-pdp__atc { position: relative; width: 100%; min-height: 62px; border: 0; border-radius: 32px; background: var(--pawsorb-v2-pdp-acc, #12855A); color: #fff; font: 700 19px/1 var(--font-body--family); cursor: pointer; transition: background-color .15s; }
  .pawsorb-v2-pdp__atc:hover { background: var(--pawsorb-v2-pdp-acc-h, #0E6B48); }
  .pawsorb-v2-pdp__atc:focus-visible { outline: 2px solid var(--pawsorb-v2-pdp-ink, #121614); outline-offset: 3px; }
  .pawsorb-v2-pdp__atc[disabled] { opacity: .55; cursor: not-allowed; }
  .pawsorb-v2-pdp__spin { display: none; position: absolute; right: 24px; top: 50%; width: 18px; height: 18px; margin-top: -9px; border: 2px solid rgba(255, 255, 255, .4); border-top-color: #fff; border-radius: 50%; animation: pawsorb-v2-pdp-spin .7s linear infinite; }
  .pawsorb-v2-pdp__atc.is-loading .pawsorb-v2-pdp__spin { display: block; }
  @keyframes pawsorb-v2-pdp-spin { to { transform: rotate(360deg); } }
  .pawsorb-v2-pdp__err { margin: 8px 0 0; font-size: 14px; color: #B42318; }
  .pawsorb-v2-pdp__trust { list-style: none; margin: -6px 0 0; padding: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 4px 16px; }
  .pawsorb-v2-pdp__trust li { display: flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 500; }
  .pawsorb-v2-pdp__trust .pawsorb-icon { color: var(--pawsorb-v2-pdp-acc, #12855A); stroke-width: 2.4; }
  .pawsorb-v2-pdp__pay { list-style: none; margin: -4px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
