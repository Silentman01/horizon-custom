{% javascript %}
  if (!customElements.get('pawsorb-v2-buy-box')) {
    customElements.define('pawsorb-v2-buy-box', class extends HTMLElement {
      connectedCallback() {
        this.qty = this.querySelector('[data-v2-qty]');
        this.form = this.querySelector('[data-v2-form]');
        this.addEventListener('change', this.onChange);
        if (this.form) this.form.addEventListener('submit', this.onSubmit);
        this.initGallery();
        this.initCountdown();
        this.initCalc();
        const cur = this.querySelector('.pawsorb-v2-tier__input:checked');
        if (cur) this.apply(cur);
      }
      onChange = (e) => {
        const i = e.target;
        if (i instanceof HTMLInputElement && i.classList.contains('pawsorb-v2-tier__input')) this.apply(i);
      };
      apply(i) {
        this.querySelectorAll('.pawsorb-v2-tier').forEach((t) => t.classList.toggle('is-selected', t.contains(i)));
        const q = Number(i.dataset.qty) || 1;
        if (this.qty) this.qty.value = q;
        this.querySelectorAll('[data-v2-gift]').forEach((g) => g.classList.toggle('is-unlocked', q >= (Number(g.dataset.unlock) || 1)));
        const detail = { title: i.dataset.title, weight: i.dataset.weight, price: i.dataset.price, each: i.dataset.each, eachCompare: i.dataset.eachCompare, qty: q };
        window.pawsorbTier = detail;
        document.dispatchEvent(new CustomEvent('pawsorb:tier', { detail }));
      }
      selectQty(n) {
        const inputs = [...this.querySelectorAll('.pawsorb-v2-tier__input')];
        if (!inputs.length) return;
        const sorted = inputs.slice().sort((a, b) => Number(a.dataset.qty) - Number(b.dataset.qty));
        const pick = sorted.find((x) => Number(x.dataset.qty) >= n) || sorted[sorted.length - 1];
        pick.checked = true;
        this.apply(pick);
      }
      onSubmit = async (e) => {
        e.preventDefault();
        const btn = this.querySelector('[data-v2-atc]');
        const err = this.querySelector('[data-v2-err]');
        const fd = new FormData(this.form);
        const sel = this.querySelector('.pawsorb-v2-tier__input:checked');
        const item = { id: Number(fd.get('id')), quantity: Number(fd.get('quantity')) || 1 };
        if (sel && sel.dataset.title) item.properties = { _Bundle: sel.dataset.title };
        if (btn) { btn.classList.add('is-loading'); btn.disabled = true; }
        if (err) err.hidden = true;
        try {
          const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
          const res = await fetch(root + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [item] }) });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.description || data.message || 'Could not add to cart');
          document.dispatchEvent(new CustomEvent('pawsorb:cart-open', { detail: { added: true } }));
        } catch (ex) {
          if (location.protocol === 'file:') document.dispatchEvent(new CustomEvent('pawsorb:cart-open', { detail: { added: true, mock: item } }));
          else if (err) { err.textContent = ex.message; err.hidden = false; }
        } finally {
          if (btn) { btn.classList.remove('is-loading'); btn.disabled = false; }
        }
      };
      initGallery() {
        const track = this.querySelector('[data-v2-track]');
        if (!track) return;
        const thumbs = [...this.querySelectorAll('.pawsorb-v2-pdp__thumb')];
        const dots = [...this.querySelectorAll('.pawsorb-v2-pdp__dot')];
        const slides = () => [...track.children].filter((s) => !s.classList.contains('is-missing'));
        const box = this.querySelector('.pawsorb-v2-pdp__thumbs');
        const setActive = (idx) => {
          thumbs.forEach((t, n) => t.classList.toggle('is-active', n === idx));
          const t = thumbs[idx];
          if (box && t) {
            if (box.scrollWidth > box.clientWidth + 1) box.scrollTo({ left: t.offsetLeft - (box.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
            else if (box.scrollHeight > box.clientHeight + 1) box.scrollTo({ top: t.offsetTop - (box.clientHeight - t.offsetHeight) / 2, behavior: 'smooth' });
          }
          dots.forEach((d, n) => d.classList.toggle('is-active', n === idx));
        };
        thumbs.forEach((t) => t.addEventListener('click', () => {
          const s = track.children[Number(t.dataset.index) || 0];
          if (s) track.scrollTo({ left: s.offsetLeft, behavior: 'smooth' });
        }));
        let raf = 0;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const vis = slides();
            const n = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
            setActive([...track.children].indexOf(vis[n]));
          });
        }, { passive: true });
      }
      initCountdown() {
        const el = this.querySelector('[data-v2-cd]');
        if (!el) return;
        const end = Date.parse(el.dataset.end);
        const out = el.querySelector('[data-v2-cd-out]');
        if (isNaN(end) || !out) return;
        const pad = (n) => (n < 10 ? '0' : '') + n;
        const tick = () => {
          const s = Math.floor((end - Date.now()) / 1000);
          if (s <= 0) { el.hidden = true; clearInterval(this.cdT); return; }
          el.hidden = false;
          const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60), x = s % 60;
          out.textContent = (d ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(x);
        };
        tick();
        this.cdT = setInterval(tick, 1000);
      }
      disconnectedCallback() { clearInterval(this.cdT); }
      initCalc() {
        const dlg = this.querySelector('[data-v2-calc]');
        const open = this.querySelector('[data-v2-calc-open]');
        if (!dlg || !open) return;
        const slider = dlg.querySelector('[data-v2-calc-weight]');
        const wOut = dlg.querySelector('[data-v2-calc-wout]');
        const dogsOut = dlg.querySelector('[data-v2-calc-dogs]');
        const rows = [...dlg.querySelectorAll('[data-v2-calc-row]')];
        const multi = dlg.querySelector('[data-v2-calc-multi]');
        const perOut = dlg.querySelector('[data-v2-calc-per]');
        const totOut = dlg.querySelector('[data-v2-calc-total]');
        const totWord = dlg.querySelector('[data-v2-calc-word]');
        const tpl = perOut ? perOut.dataset.template || '' : '';
        const w = (n, one, many) => n + ' ' + (n === 1 ? one : many);
        const ds = dlg.dataset;
        let dogs = 1, unit = 'lb';
        const max = Number(slider.max) || 150;
        const update = () => {
          const lbs = Number(slider.value) || 0;
          const pct = ((lbs - Number(slider.min)) / (max - Number(slider.min))) * 100;
          slider.style.setProperty('--pawsorb-v2-calc-fill', pct + '%');
          const kg = unit === 'kg';
          const shown = kg ? Math.round(lbs * 0.4536) : lbs;
          wOut.textContent = shown + (lbs >= max ? '+' : '') + ' ' + (kg ? ds.unitKg : ds.unitLb);
          dlg.querySelectorAll('[data-lb]').forEach((el) => { el.textContent = kg ? el.dataset.kg : el.dataset.lb; });
          let per = 1, hit = null;
          for (const r of rows) { if (lbs <= Number(r.dataset.max)) { hit = r; break; } }
          if (!hit) hit = rows[rows.length - 1];
          if (hit) per = Number(hit.dataset.tubes) || 1;
          rows.forEach((r) => r.classList.toggle('is-active', r === hit));
          if (multi) multi.classList.toggle('is-active', dogs > 1);
          dogsOut.textContent = dogs;
          const total = per * dogs;
          if (perOut) perOut.textContent = tpl.replace('[tubes]', w(per, ds.tubeOne, ds.tubeMany)).replace('[dogs]', w(dogs, ds.dogOne, ds.dogMany));
          if (totOut) totOut.textContent = total;
          if (totWord) totWord.textContent = total === 1 ? ds.tubeOne : ds.tubeMany;
          this.calcTotal = total;
        };
        slider.addEventListener('input', update);
        dlg.querySelectorAll('[data-v2-calc-step]').forEach((b) => b.addEventListener('click', () => {
          dogs = Math.min(10, Math.max(1, dogs + Number(b.dataset.v2CalcStep)));
          update();
        }));
        dlg.querySelectorAll('[data-v2-calc-unit]').forEach((b) => b.addEventListener('click', () => {
          unit = b.dataset.v2CalcUnit;
          dlg.querySelectorAll('[data-v2-calc-unit]').forEach((x) => x.classList.toggle('is-active', x === b));
          update();
        }));
        open.addEventListener('click', () => { update(); if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', ''); });
        dlg.querySelectorAll('[data-v2-calc-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        const go = dlg.querySelector('[data-v2-calc-go]');
        if (go) go.addEventListener('click', () => {
          this.selectQty(this.calcTotal || 1);
          dlg.close();
          if (window.pawsorbScrollToPicker) window.pawsorbScrollToPicker();
        });
        update();
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PawSorb v2 buy box",
  "tag": "section",
  "class": "pawsorb-v2-section-main",
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "title", "label": "Tier title", "default": "Buy 3" },
        { "type": "range", "id": "quantity", "label": "Tubes added to cart", "min": 1, "max": 20, "step": 1, "default": 3, "info": "Checkout price = variant price x this quantity minus the matching automatic discount (Discounts > Amount off products, minimum quantity = this number)." },
        { "type": "text", "id": "weight_label", "label": "Subtitle (weight band)", "default": "Dogs 61–80 lbs" },
        { "type": "text", "id": "price", "label": "Tier total price (text)", "default": "$74.97", "info": "Must equal the cart total after the automatic discount for this quantity. The price per tube is this total divided by the quantity." },
        { "type": "text", "id": "compare_price", "label": "Tier compare-at total (text)", "default": "$179.97", "info": "SAVE % = 1 - price / compare-at. The struck price per tube is this total divided by the quantity." },
        { "type": "text", "id": "each_override", "label": "Price per tube (blank = computed)", "info": "Optional text, e.g. $24.99. Leave blank to compute it." },
        { "type": "text", "id": "save_override", "label": "SAVE pill (blank = computed %)", "info": "Optional text. Leave blank for SAVE xx%." },
        { "type": "text", "id": "badge", "label": "Ribbon", "default": "Most Popular" },
        { "type": "checkbox", "id": "preselect", "label": "Selected on page load", "default": false }
