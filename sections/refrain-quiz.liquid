{%- comment -%}
  Refrain quiz: 9-step questionnaire -> free preview (POST/poll backend) -> player + offer -> AJAX cart -> checkout.
  API contract (v2): G:\Ecom\Products\Refrain\08_backend\API_CONTRACT.md
  Security: the read_token lives in memory/sessionStorage only; the resume link (#p=<id>.<token>) is stripped from the
  address bar before any tracker loads; the Meta Pixel only loads with marketing consent (Shopify Customer Privacy API).
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product | default: product
  assign v_std = p.variants.first
  assign v_prem = nil
  for v in p.variants
    assign t = v.title | downcase
    if t contains 'premium'
      assign v_prem = v
    endif
  endfor
  if v_prem == nil and p.variants.size > 1
    assign v_prem = p.variants[1]
  endif
  if v_prem and v_std.id == v_prem.id
    assign v_std = p.variants.last
  endif
  assign demo_src = section.settings.demo_audio_url
  if demo_src == blank and section.settings.demo_audio_asset != blank
    assign demo_src = section.settings.demo_audio_asset | asset_url
  endif
  assign sbs = section.blocks | where: 'type', 'step'
  assign st1 = sbs[0]
  assign st2 = sbs[1]
  assign st3 = sbs[2]
  assign st4 = sbs[3]
  assign st5 = sbs[4]
  assign st6 = sbs[5]
  assign st7 = sbs[6]
  assign st8 = sbs[7]
  assign st9 = sbs[8]
  assign uid = 'rfq-' | append: section.id
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign price_std = 19
  assign price_prem = 35
  if v_std
    assign price_std = v_std.price | divided_by: 100.0
  endif
  if v_prem
    assign price_prem = v_prem.price | divided_by: 100.0
  endif
  assign std_pts = section.settings.std_points | newline_to_br | split: '<br />'
  assign prem_pts = section.settings.prem_points | newline_to_br | split: '<br />'
-%}
{% render 'refrain-fonts' %}
<section
  id="quiz"
  class="rf-quiz"
  style="{% render 'refrain-vars' %}"
  {{ section.shopify_attributes }}
>
  <refrain-quiz
    class="rf-quiz__inner"
    data-api="{{ section.settings.api_base | escape }}"
    data-std="{{ v_std.id }}"
    data-prem="{{ v_prem.id | default: v_std.id }}"
    data-std-price="{{ price_std }}"
    data-prem-price="{{ price_prem }}"
    data-demo-audio="{{ demo_src }}"
    data-demo-lyrics="{{ section.settings.demo_lyrics | escape }}"
    data-force-demo="{{ section.settings.force_demo }}"
    data-pixel="{{ section.settings.pixel_id | escape }}"
    data-fail-text="{{ section.settings.fail_text | escape }}"
  >
    <header class="rf-quiz__head">
      {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {% render 'refrain-title', text: section.settings.heading, tag: 'h1', class: 'rf-quiz__h1' %}
      {%- if section.settings.sub != blank -%}<p class="rf-sub">{{ section.settings.sub }}</p>{%- endif -%}
      <ul class="rf-quiz__badges">
        {%- for i in (1..3) -%}
          {%- assign key = 'badge_' | append: i -%}
          {%- if section.settings[key] != blank -%}
            <li>{% render 'refrain-icon', name: 'check' %}{{ section.settings[key] }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </header>

    <div class="rf-quiz__card" data-card>
      <p class="rf-sr" aria-live="polite" data-live></p>

      <div class="rf-quiz__resume" data-resume hidden>
        <p>{{ section.settings.resume_text }}</p>
        <div class="rf-quiz__resume-actions">
          <button type="button" class="rf-btn" data-resume-yes>Continuer</button>
          <button type="button" class="rf-link" data-resume-no>Recommencer</button>
        </div>
      </div>

      <form class="rf-quiz__form" data-form novalidate>
        <div class="rf-quiz__progress">
          <span class="rf-quiz__count" data-step-label>Étape 1 sur 9</span>
          <span class="rf-quiz__bar" aria-hidden="true"><i data-bar></i></span>
        </div>

        {%- comment -%} STEP 1 recipient {%- endcomment -%}
        <fieldset class="rf-step" data-step="1" aria-describedby="{{ uid }}-h1">
          <legend class="rf-step__t">{{ st1.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h1">{{ st1.settings.help }}</p>
          <div class="rf-chips" data-group="recipient" data-required>
            {%- assign opts = st1.settings.options | split: ',' -%}
            {%- for o in opts -%}{%- assign o = o | strip -%}
              <label class="rf-chip"><input type="radio" name="recipient" value="{{ o | handleize }}"><span>{{ o }}</span></label>
            {%- endfor -%}
          </div>
          <div class="rf-field" data-other="recipient" hidden>
            <label for="{{ uid }}-recipient-other">Précisez pour qui</label>
            <input id="{{ uid }}-recipient-other" type="text" name="recipient_other" maxlength="80" autocomplete="off" placeholder="{{ st1.settings.placeholder | escape }}">
          </div>
        </fieldset>

        {%- comment -%} STEP 2 occasion {%- endcomment -%}
        <fieldset class="rf-step" data-step="2" aria-describedby="{{ uid }}-h2" hidden>
          <legend class="rf-step__t">{{ st2.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h2">{{ st2.settings.help }}</p>
          <div class="rf-chips" data-group="occasion" data-required>
            {%- assign opts = st2.settings.options | split: ',' -%}
            {%- for o in opts -%}{%- assign o = o | strip -%}
              <label class="rf-chip"><input type="radio" name="occasion" value="{{ o | handleize }}"><span>{{ o }}</span></label>
            {%- endfor -%}
          </div>
          <div class="rf-field" data-other="occasion" hidden>
            <label for="{{ uid }}-occasion-other">Précisez l’occasion</label>
            <input id="{{ uid }}-occasion-other" type="text" name="occasion_other" maxlength="80" autocomplete="off">
          </div>
        </fieldset>

        {%- comment -%} STEP 3 name {%- endcomment -%}
        <fieldset class="rf-step" data-step="3" aria-describedby="{{ uid }}-h3" hidden>
          <legend class="rf-step__t">{{ st3.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h3">{{ st3.settings.help }}</p>
          <div class="rf-field">
            <label for="{{ uid }}-name">Prénom ou surnom</label>
            <input id="{{ uid }}-name" type="text" name="name" maxlength="60" required autocomplete="off" autocapitalize="words" placeholder="{{ st3.settings.placeholder | escape }}">
          </div>
          <div class="rf-field">
            <label for="{{ uid }}-pron">Prononciation <span class="rf-opt">(facultatif)</span></label>
            <input id="{{ uid }}-pron" type="text" name="pronunciation" maxlength="60" autocomplete="off" placeholder="{{ st3.settings.placeholder_2 | escape }}" aria-describedby="{{ uid }}-pron-help">
            <small class="rf-field__help" id="{{ uid }}-pron-help">Écrivez le prénom comme il se dit, en séparant les syllabes (par exemple « Ma-é-lisse »). C’est ce que la voix chantera.</small>
          </div>
        </fieldset>

        {%- comment -%} STEP 4 style + voice {%- endcomment -%}
        <fieldset class="rf-step" data-step="4" aria-describedby="{{ uid }}-h4" hidden>
          <legend class="rf-step__t">{{ st4.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h4">{{ st4.settings.help }}</p>
          <fieldset class="rf-sub-group">
            <legend class="rf-step__group">Style musical</legend>
            <div class="rf-chips" data-group="style" data-required>
              {%- assign opts = st4.settings.options | split: ',' -%}
              {%- for o in opts -%}{%- assign o = o | strip -%}
                <label class="rf-chip"><input type="radio" name="style" value="{{ o | handleize }}"><span>{{ o }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <fieldset class="rf-sub-group">
            <legend class="rf-step__group">Voix</legend>
            <div class="rf-chips" data-group="voice" data-required>
              {%- assign opts = st4.settings.options_2 | split: ',' -%}
              {%- for o in opts -%}{%- assign o = o | strip -%}
                <label class="rf-chip"><input type="radio" name="voice" value="{{ o | handleize }}"><span>{{ o }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
        </fieldset>

        {%- comment -%} STEP 5 qualities {%- endcomment -%}
        <fieldset class="rf-step" data-step="5" aria-describedby="{{ uid }}-h5" hidden>
          <legend class="rf-step__t">{{ st5.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h5">{{ st5.settings.help }}</p>
          <div class="rf-chips" data-group="qualities" data-required data-max="3">
            {%- assign opts = st5.settings.options | split: ',' -%}
            {%- for o in opts -%}{%- assign o = o | strip -%}
              <label class="rf-chip"><input type="checkbox" name="qualities" value="{{ o | handleize }}"><span>{{ o }}</span></label>
            {%- endfor -%}
          </div>
          <div class="rf-field">
            <label for="{{ uid }}-qtext">Un détail en plus <span class="rf-opt">(facultatif)</span></label>
            <input id="{{ uid }}-qtext" type="text" name="qualities_text" maxlength="300" autocomplete="off" placeholder="{{ st5.settings.placeholder | escape }}">
          </div>
        </fieldset>

        {%- comment -%} STEP 6 memory {%- endcomment -%}
        <fieldset class="rf-step" data-step="6" aria-describedby="{{ uid }}-h6" hidden>
          <legend class="rf-step__t">{{ st6.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h6">{{ st6.settings.help }}</p>
          <div class="rf-field">
            <label for="{{ uid }}-memory">Votre souvenir</label>
            <textarea id="{{ uid }}-memory" name="memory" rows="5" minlength="20" maxlength="600" required placeholder="{{ st6.settings.placeholder | escape }}" aria-describedby="{{ uid }}-memory-count"></textarea>
            <small class="rf-count" id="{{ uid }}-memory-count" data-count-for="memory" data-min="20">0 / 600 · 20 caractères minimum</small>
          </div>
        </fieldset>

        {%- comment -%} STEP 7 message {%- endcomment -%}
        <fieldset class="rf-step" data-step="7" aria-describedby="{{ uid }}-h7" hidden>
          <legend class="rf-step__t">{{ st7.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h7">{{ st7.settings.help }}</p>
          <div class="rf-field">
            <label for="{{ uid }}-message">Votre message <span class="rf-opt">(facultatif)</span></label>
            <textarea id="{{ uid }}-message" name="message" rows="4" maxlength="400" placeholder="{{ st7.settings.placeholder | escape }}" aria-describedby="{{ uid }}-message-count"></textarea>
            <small class="rf-count" id="{{ uid }}-message-count" data-count-for="message">0 / 400</small>
          </div>
        </fieldset>

        {%- comment -%} STEP 8 language {%- endcomment -%}
        <fieldset class="rf-step" data-step="8" aria-describedby="{{ uid }}-h8" hidden>
          <legend class="rf-step__t">{{ st8.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h8">{{ st8.settings.help }}</p>
          <div class="rf-chips" data-group="language" data-required>
            <label class="rf-chip"><input type="radio" name="language" value="fr" checked><span>Français</span></label>
            <label class="rf-chip"><input type="radio" name="language" value="en"><span>Anglais</span></label>
          </div>
        </fieldset>

        {%- comment -%} STEP 9 email {%- endcomment -%}
        <fieldset class="rf-step" data-step="9" aria-describedby="{{ uid }}-h9" hidden>
          <legend class="rf-step__t">{{ st9.settings.title }}</legend>
          <p class="rf-step__help" id="{{ uid }}-h9">{{ st9.settings.help }}</p>
          <div class="rf-field">
            <label for="{{ uid }}-email">Votre e-mail</label>
            <input id="{{ uid }}-email" type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" placeholder="vous@exemple.fr">
          </div>
          <label class="rf-check" for="{{ uid }}-consent">
            <input id="{{ uid }}-consent" type="checkbox" name="consent" required>
            <span>{{ st9.settings.placeholder_2 }}</span>
          </label>
          <label class="rf-check" for="{{ uid }}-reminders">
            <input id="{{ uid }}-reminders" type="checkbox" name="reminders_opt_in">
            <span>Je souhaite recevoir un rappel par e-mail si je n’ai pas encore commandé. <span class="rf-opt">(facultatif)</span></span>
          </label>
          <p class="rf-privacy">{% render 'refrain-icon', name: 'lock' %}<span>Vos réponses et votre e-mail servent à créer votre extrait. Pour en savoir plus, consultez notre <a href="{{ privacy_url }}" target="_blank" rel="noopener">politique de confidentialité<span class="rf-sr"> (nouvel onglet)</span></a>.</span></p>
          <div class="rf-hp" aria-hidden="true"><input type="text" name="hp" tabindex="-1" autocomplete="off" value=""></div>
        </fieldset>

        <p class="rf-quiz__err" id="{{ uid }}-err" data-err role="alert" hidden></p>

        <div class="rf-quiz__nav">
          <button type="button" class="rf-btn rf-btn--ghost" data-back hidden>Retour</button>
          <button type="submit" class="rf-btn" data-next>
            <span data-next-label>Continuer</span>{% render 'refrain-icon', name: 'arrow' %}
          </button>
        </div>
        {%- if section.settings.fine_print != blank -%}<p class="rf-quiz__fine">{{ section.settings.fine_print }}</p>{%- endif -%}
      </form>

      {%- comment -%} LOADING {%- endcomment -%}
      <div class="rf-load" data-loading hidden>
        <p class="rf-eyebrow">{{ section.settings.load_kicker }}</p>
        <h2 class="rf-load__t" tabindex="-1" data-load-title>{{ section.settings.load_title }}</h2>
        <ol class="rf-load__steps" aria-hidden="true">
          <li data-stage="1"><span></span>Histoire</li>
          <li data-stage="2"><span></span>Paroles</li>
          <li data-stage="3"><span></span>Musique</li>
          <li data-stage="4"><span></span>Extrait</li>
        </ol>
        <span class="rf-load__bar" aria-hidden="true"><i data-load-bar></i></span>
        <p class="rf-sr" role="status" data-load-live></p>
        <p class="rf-load__note" data-load-note>{{ section.settings.load_note }}</p>
        <div class="rf-load__slow" data-slow role="status" hidden>
          {% render 'refrain-icon', name: 'mail' %}
          <p>{{ section.settings.load_slow }}</p>
          <p class="rf-load__addr" data-slow-addr hidden>Adresse indiquée : <b data-slow-email></b></p>
          <div class="rf-load__actions">
            <button type="button" class="rf-btn rf-btn--ghost" data-check>Vérifier si l’extrait est prêt</button>
          </div>
        </div>
        <div class="rf-load__fail" data-fail role="alert" hidden>
          <p data-fail-msg></p>
          <div class="rf-load__actions">
            <button type="button" class="rf-btn" data-retry>Réessayer</button>
            <button type="button" class="rf-link" data-edit>Modifier mes réponses</button>
            <button type="button" class="rf-link" data-new hidden>Créer un nouvel extrait</button>
          </div>
        </div>
      </div>

      {%- comment -%} PLAYER + OFFER {%- endcomment -%}
      <div class="rf-result" data-result hidden>
        <div class="rf-player">
          <p class="rf-player__k">{{ section.settings.player_kicker }} <b data-r-name></b></p>
          <h2 class="rf-player__t" tabindex="-1" data-r-title></h2>
          <div class="rf-player__ctrl">
            <button type="button" class="rf-player__btn" data-play aria-label="Écouter l’extrait">
              <span data-ico-play>{% render 'refrain-icon', name: 'play' %}</span>
              <span data-ico-pause hidden>{% render 'refrain-icon', name: 'pause' %}</span>
            </button>
            <div class="rf-player__track">
              <div class="rf-player__seek" data-seek role="slider" tabindex="0" aria-label="Position dans l’extrait" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-valuetext="0:00">
                <span class="rf-player__prog"><i data-prog></i></span>
              </div>
              <span class="rf-player__time" aria-hidden="true"><span data-cur>0:00</span><span data-dur>0:00</span></span>
            </div>
          </div>
          <p class="rf-player__hint" data-play-hint role="status" hidden></p>
          <audio data-audio preload="none" playsinline></audio>
          <pre class="rf-player__lyrics" data-lyrics></pre>
          <p class="rf-player__ended" data-ended role="status" hidden>{{ section.settings.player_ended }}</p>
          {%- if section.settings.player_note != blank -%}<p class="rf-player__note">{{ section.settings.player_note }}</p>{%- endif -%}
        </div>

        <div class="rf-offer">
          {% render 'refrain-title', text: section.settings.offer_heading, tag: 'h2', class: 'rf-offer__h' %}
          <fieldset class="rf-tiers">
            <legend class="rf-sr">Choisissez votre formule</legend>
            <label class="rf-tier">
              <input type="radio" name="tier" value="standard" checked>
              <span class="rf-tier__top"><b>{{ section.settings.std_name }}</b><b class="rf-tier__price">{% if v_std %}{{ v_std.price | money_without_trailing_zeros }}{% else %}19 €{% endif %}</b></span>
              <ul class="rf-tier__list">
                {%- for pt in std_pts -%}{%- assign pt = pt | strip -%}{%- if pt != blank -%}<li>{% render 'refrain-icon', name: 'check' %}<span>{{ pt }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            </label>
            <label class="rf-tier rf-tier--prem">
              <input type="radio" name="tier" value="premium">
              {%- if section.settings.prem_badge != blank -%}<span class="rf-tier__badge">{{ section.settings.prem_badge }}</span>{%- endif -%}
              <span class="rf-tier__top"><b>{{ section.settings.prem_name }}</b><b class="rf-tier__price">{% if v_prem %}{{ v_prem.price | money_without_trailing_zeros }}{% else %}35 €{% endif %}</b></span>
              {%- if v_prem and v_std and v_prem.price > v_std.price -%}
                {%- assign diff = v_prem.price | minus: v_std.price -%}
                <span class="rf-tier__delta">+{{ diff | money_without_trailing_zeros }} par rapport au {{ section.settings.std_name }}</span>
              {%- elsif v_prem == nil and v_std == nil -%}
                <span class="rf-tier__delta">+16 € par rapport au {{ section.settings.std_name }}</span>
              {%- endif -%}
              <ul class="rf-tier__list rf-tier__list--prem">
                {%- for pt in prem_pts -%}{%- assign pt = pt | strip -%}{%- if pt != blank -%}<li>{% render 'refrain-icon', name: 'check' %}<span>{{ pt }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            </label>
          </fieldset>
          {%- comment -%} Optional Premium photo (API contract v2, "Premium photo before payment"). Never blocks the purchase. {%- endcomment -%}
          <div class="rf-photo" data-photo role="group" aria-labelledby="{{ uid }}-photo-t" hidden>
            <p class="rf-photo__t" id="{{ uid }}-photo-t">Une photo pour l’illustration <span class="rf-opt">(facultatif)</span></p>
            <p class="rf-photo__help" id="{{ uid }}-photo-help">Une photo nette et habillée, sans nom, adresse ni école visibles. L’illustration est une interprétation artistique, pas une copie de la photo. Pas de photo ? Nous créerons l’illustration à partir de vos réponses.</p>
            <div class="rf-photo__pick" data-photo-pick>
              <input class="rf-photo__file" id="{{ uid }}-photo" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" aria-describedby="{{ uid }}-photo-help {{ uid }}-photo-fmt" data-photo-input>
              <label class="rf-btn rf-btn--ghost rf-photo__btn" for="{{ uid }}-photo"><span data-photo-pick-label>Choisir une photo</span></label>
              <span class="rf-photo__fmt" id="{{ uid }}-photo-fmt">JPG, PNG, HEIC ou WebP, 10 Mo au maximum</span>
            </div>
            <div class="rf-photo__card" data-photo-card hidden>
              <img class="rf-photo__thumb" data-photo-img alt="Aperçu de la photo choisie" width="72" height="72" hidden>
              <div class="rf-photo__state">
                <p class="rf-photo__status" data-photo-status role="status" aria-live="polite"></p>
                <button type="button" class="rf-link rf-photo__remove" data-photo-remove>Retirer la photo</button>
              </div>
            </div>
            <div data-photo-confirm hidden>
              <label class="rf-check" for="{{ uid }}-photo-consent">
                <input id="{{ uid }}-photo-consent" type="checkbox" data-photo-consent>
                <span>J’ai le droit de partager cette photo, et les personnes qui y figurent sont d’accord (pour un enfant : je suis son parent ou j’ai l’accord de ses parents). J’accepte qu’elle soit utilisée pour créer, par intelligence artificielle, l’illustration et le clip de ma commande, puis supprimée 30 jours après leur livraison. <a href="{{ privacy_url }}" target="_blank" rel="noopener">En savoir plus<span class="rf-sr"> (nouvel onglet)</span></a></span>
              </label>
              <button type="button" class="rf-btn rf-photo__send" data-photo-send disabled>Envoyer ma photo</button>
            </div>
            <p class="rf-photo__err" data-photo-err role="alert" hidden></p>
          </div>
          <button type="button" class="rf-btn rf-offer__cta" data-buy aria-describedby="{{ uid }}-buyhint" data-label="{{ section.settings.cta_label | escape }}" data-demo-label="{{ section.settings.demo_cta | escape }}">{{ section.settings.cta_label }}</button>
          <p class="rf-offer__hint" id="{{ uid }}-buyhint" data-buy-hint>Utilisez la même adresse e-mail que pour l’extrait.</p>
          <p class="rf-offer__err" data-buy-err role="alert" hidden>{{ section.settings.cart_error }}</p>
          <p class="rf-offer__fine">{% render 'refrain-icon', name: 'lock' %}<span>{{ section.settings.cta_fine }}</span></p>
          {%- if section.settings.after_steps != blank -%}
            <div class="rf-after">
              <p class="rf-after__t">Après votre commande</p>
              <ol>
                {%- assign steps = section.settings.after_steps | newline_to_br | split: '<br />' -%}
                {%- for s in steps -%}{%- if s != blank -%}<li>{{ s | strip }}</li>{%- endif -%}{%- endfor -%}
              </ol>
            </div>
          {%- endif -%}
          <button type="button" class="rf-link" data-restart>Créer un autre extrait</button>
        </div>
      </div>
    </div>
  </refrain-quiz>
</section>

{% stylesheet %}
  .rf-quiz { background: var(--rf-lilac); padding: 36px 16px 48px; font-family: var(--rf-sans); color: var(--rf-ink); }
  .rf-quiz [hidden] { display: none !important; }
  .rf-quiz__inner { display: block; max-width: 1160px; margin: 0 auto; }
  .rf-quiz__head { text-align: center; max-width: 720px; margin: 0 auto 24px; }
  .rf-quiz__h1 { font-size: clamp(34px, 7vw, 68px); overflow-wrap: break-word; }
  .rf-quiz__head .rf-sub { color: var(--rf-ink); }
  .rf-quiz__badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; margin: 18px 0 0; padding: 0; list-style: none; font-size: 14px; font-weight: 600; }
  .rf-quiz__badges li { display: inline-flex; align-items: center; gap: 6px; }
  .rf-quiz__badges .rf-icon { width: 18px; height: 18px; padding: 3px; border-radius: 50%; background: var(--rf-ink); color: var(--rf-lime); flex: none; }
