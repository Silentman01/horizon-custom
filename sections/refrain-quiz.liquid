        const msg = { rate: MSG.rate(extra), network: MSG.network, poll: MSG.network, expired: MSG.expired }[kind] || this.dataset.failText || '';
        this.q('[data-fail-msg]').textContent = msg;
        this.q('[data-load-note]').hidden = true;
        this.q('[data-retry]').hidden = kind === 'rate' || kind === 'expired';
        this.q('[data-edit]').hidden = kind === 'poll' || kind === 'expired';
        this.q('[data-new]').hidden = kind !== 'expired';
        this.q('[data-fail]').hidden = false;
      }

      result(r) {
        clearTimeout(this._timer);
        const name = r.name || this.answers().name || '';
        this.isDemo = !!r.demo;
        this.q('[data-loading]').hidden = true; this.q('[data-resume]').hidden = true; this.form.hidden = true;
        this.q('[data-result]').hidden = false;
        this.q('[data-r-name]').textContent = name;
        this.q('[data-r-title]').textContent = (r.title || ('La chanson de ' + name)).replace(/\{name\}/g, name);
        let lyr = r.lyrics || '';
        if (name) lyr = lyr.replace(/\{name\}/g, name);
        this.q('[data-lyrics]').textContent = lyr;
        this.limit = r.seconds || (r.demo ? 0 : 75);
        this.start = Math.max(0, r.start || 0);
        this.q('[data-ended]').hidden = true; this.q('[data-play-hint]').hidden = true;
        this.audio.pause();
        if (r.url) { this.audio.src = r.url; this.q('[data-play]').disabled = false; } else { this.audio.removeAttribute('src'); this.q('[data-play]').disabled = true; }
        this.q('[data-prog]').style.width = '0%'; this.q('[data-cur]').textContent = '0:00';
        this.q('[data-dur]').textContent = this.limit ? fmt(this.limit) : '0:00';
        this.photoReset(r.photo);
        this.buyState();
        this.scrollTop();
        this.q('[data-r-title]').focus({ preventScroll: true });
      }

      /* ---- Optional Premium photo: chosen before payment, used by Premium only, never blocks the purchase ---- */
      photoVisible() {
        const prem = ((this.q('input[name="tier"]:checked') || {}).value) === 'premium';
        const live = !this.isDemo && this.session && /^[0-9a-f-]{36}$/i.test(this.session.id) && this.api && !/REFRAIN-DOMAIN/.test(this.api);
        this.q('[data-photo]').hidden = !(prem && live);
      }
      photoReset(state) {
        clearTimeout(this._photoTimer);
        if (this._photoUrl) { try { URL.revokeObjectURL(this._photoUrl); } catch (e) {} this._photoUrl = null; }
        this._photoFile = null; this._photoBusy = false;
        this._photoSent = !!(state && (state.status === 'active' || state.status === 'pending'));
        const input = this.q('[data-photo-input]'); input.value = '';
        this.q('[data-photo-consent]').checked = false; this.q('[data-photo-send]').disabled = true;
        this.q('[data-photo-confirm]').hidden = true; this.q('[data-photo-err]').hidden = true;
        const img = this.q('[data-photo-img]'); img.hidden = true; img.removeAttribute('src');
        const st = state && state.status;
        if (st === 'active' || st === 'pending') this.photoShow(st === 'active' ? PHOTO.active : PHOTO.checking, false);
        else { this.q('[data-photo-card]').hidden = true; this.q('[data-photo-pick]').hidden = false; this.q('[data-photo-pick-label]').textContent = 'Choisir une photo'; }
        if (st === 'pending') this.photoPoll(0);
        if (st === 'refused') this.photoError(PHOTO.refused);
        this.photoVisible();
      }
      photoShow(text, pickAgain) {
        this.q('[data-photo-card]').hidden = false;
        this.q('[data-photo-status]').textContent = text;
        this.q('[data-photo-pick]').hidden = !pickAgain;
        this.q('[data-photo-pick-label]').textContent = 'Choisir une autre photo';
      }
      photoError(text) { const e = this.q('[data-photo-err]'); e.textContent = text; e.hidden = false; }
      photoPick(file) {
        this.q('[data-photo-err]').hidden = true;
        if (!file) return;
        if (file.size > PHOTO.maxBytes) { this.q('[data-photo-input]').value = ''; return this.photoError(PHOTO.errors.too_large); }
        if (file.type && !/^image\/(jpeg|png|webp|heic|heif)$/i.test(file.type)) { this.q('[data-photo-input]').value = ''; return this.photoError(PHOTO.errors.unsupported_type); }
        this._photoFile = file;
        if (this._photoUrl) { try { URL.revokeObjectURL(this._photoUrl); } catch (e) {} }
        const img = this.q('[data-photo-img]');
        try { this._photoUrl = URL.createObjectURL(file); img.src = this._photoUrl; img.hidden = false; img.onerror = () => { img.hidden = true; }; } catch (e) { img.hidden = true; }
        this.photoShow(PHOTO.chosen, false);
        this.q('[data-photo-confirm]').hidden = false;
        this.q('[data-photo-send]').disabled = !this.q('[data-photo-consent]').checked;
        this.q('[data-photo-consent]').focus();
      }
      async photoSend() {
        if (this._photoBusy || !this._photoFile || !this.session) return;
        if (!this.q('[data-photo-consent]').checked) return;
        this._photoBusy = true;
        const btn = this.q('[data-photo-send]'); btn.disabled = true; btn.setAttribute('aria-busy', 'true');
        this.q('[data-photo-err]').hidden = true;
        this.q('[data-photo-status]').textContent = PHOTO.sending;
        const fd = new FormData();
        fd.append('photo', this._photoFile, this._photoFile.name || 'photo.jpg');
        fd.append('consent', '1');
        fd.append('consent_version', PHOTO.consentVersion);
        let r = null, j = {};
        try {
          r = await fetch(this.api + '/api/preview/' + encodeURIComponent(this.session.id) + '/photo', { method: 'POST', headers: { 'X-Refrain-Token': this.session.token }, body: fd });
          j = await r.json().catch(() => ({}));
        } catch (e) { r = null; }
        btn.removeAttribute('aria-busy'); this._photoBusy = false;
        if (!r || !r.ok) {
          btn.disabled = !this.q('[data-photo-consent]').checked;
          this.q('[data-photo-status]').textContent = PHOTO.chosen;
          return this.photoError(PHOTO.errors[j.error] || PHOTO.errors.generic);
        }
        this._photoSent = true; this._photoFile = null;
        this.q('[data-photo-confirm]').hidden = true;
        this.photoShow(PHOTO.checking, false);
        this.photoPoll(0);
      }
      async photoPoll(n) {
        clearTimeout(this._photoTimer);
        if (!this.session) return;
        let d = null;
        try {
          const r = await fetch(this.api + '/api/preview/' + encodeURIComponent(this.session.id), { headers: { 'X-Refrain-Token': this.session.token }, cache: 'no-store' });
          if (r.ok) d = await r.json();
        } catch (e) {}
        const st = d && d.photo && d.photo.status;
        if (st === 'active') return this.photoShow(PHOTO.active, false);
        if (st === 'refused') { this._photoSent = false; this.photoShow(PHOTO.refusedShort, true); this.q('[data-photo-img]').hidden = true; return this.photoError(PHOTO.refused); }
        if (!d || st === 'pending') {
          if (n < 10) { this._photoTimer = setTimeout(() => this.photoPoll(n + 1), 3000); return; }
          return this.photoShow(PHOTO.slow, false); /* still checked server side; never blocks the purchase */
        }
        this.photoReset(null);
      }
      async photoRemove() {
        clearTimeout(this._photoTimer);
        if (this._photoSent && this.session) {
          try {
            await fetch(this.api + '/api/preview/' + encodeURIComponent(this.session.id) + '/photo/remove', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Refrain-Token': this.session.token }, body: '{}' });
          } catch (e) {}
        }
        this.photoReset(null);
        this.announce(PHOTO.removed);
        this.q('[data-photo-input]').focus();
      }

      buyState() {
        const btn = this.q('[data-buy]');
        btn.textContent = this.isDemo ? btn.dataset.demoLabel : btn.dataset.label;
        btn.disabled = !!this.isDemo;
        this.q('[data-buy-hint]').hidden = !!this.isDemo;
        this.q('[data-buy-hint]').textContent = 'Utilisez la même adresse e-mail que pour l’extrait.';
      }

      async buy() {
        const btn = this.q('[data-buy]'); const err = this.q('[data-buy-err]');
        if (this._buying) return;
        if (this.isDemo || !this.session || !/^[0-9a-f-]{36}$/i.test(this.session.id)) { err.hidden = false; return; }
        this._buying = true; err.hidden = true; btn.setAttribute('aria-busy', 'true');
        const a = this.answers();
        const tier = (this.q('input[name="tier"]:checked') || {}).value || 'standard';
        const id = Number(tier === 'premium' ? this.dataset.prem : this.dataset.std);
        const mkt = privacy.marketing();
        const properties = {
          _preview_id: this.session.id,
          _recipient_name: a.name
        };
        const root = window.Shopify && Shopify.routes ? Shopify.routes.root : '/';
        try {
          await fetch(root + 'cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ attributes: { _marketing_consent: mkt ? '1' : '0' } }) }).catch(() => {});
          const r = await fetch(root + 'cart/add.js', {
            method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id, quantity: 1, properties }] })
          });
          if (!r.ok) throw new Error('cart');
          this.track('InitiateCheckout', { value: Number(tier === 'premium' ? this.dataset.premPrice : this.dataset.stdPrice) || 0, currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR' });
          location.href = root + 'checkout';
        } catch (e) { err.hidden = false; btn.removeAttribute('aria-busy'); this._buying = false; }
      }
    }
    customElements.define('refrain-quiz', RefrainQuiz);
  }
{% endjavascript %}

