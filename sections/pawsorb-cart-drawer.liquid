{%- assign ss = section.settings -%}
<pawsorb-cart-drawer
  class="pawsorb-cd"
  style="--pawsorb-cd-accent: {{ ss.accent_color }}; --pawsorb-cd-navy: {{ ss.navy_color }}; --pawsorb-cd-green: {{ ss.savings_color }};"
  data-cart-url="{{ routes.cart_url }}"
  data-root="{{ routes.root_url }}"
  data-threshold="{{ ss.free_ship_qty }}"
  data-compare-unit="{{ ss.compare_unit | escape }}"
  data-t-away="{{ ss.free_ship_away | escape }}"
  data-t-unlocked="{{ ss.free_ship_done | escape }}"
  data-t-saving="{{ ss.saving_text | escape }}"
  data-on-cart="{% if template.name == 'cart' %}1{% endif %}"
  hidden
>
  <div class="pawsorb-cd__overlay" data-pawsorb-cd-close></div>
  <aside class="pawsorb-cd__panel" role="dialog" aria-modal="true" aria-labelledby="pawsorb-cd-title" tabindex="-1">
    <header class="pawsorb-cd__head">
      <h2 class="pawsorb-cd__title" id="pawsorb-cd-title">{{ ss.title }} <span class="pawsorb-cd__count" data-pawsorb-cd-count></span></h2>
      <button type="button" class="pawsorb-cd__x" data-pawsorb-cd-close aria-label="{{ ss.close_label | escape }}">{% render 'pawsorb-icon', name: 'close', size: 22 %}</button>
    </header>
    <div class="pawsorb-cd__ship" data-pawsorb-cd-ship hidden>
      <p class="pawsorb-cd__shiptext" data-pawsorb-cd-shiptext></p>
      <div class="pawsorb-cd__shipbar"><span data-pawsorb-cd-shipbar></span></div>
    </div>
    <div class="pawsorb-cd__body" data-pawsorb-cd-body>
      <div class="pawsorb-cd__loading" aria-hidden="true"><span></span></div>
    </div>
    <div class="pawsorb-cd__empty" data-pawsorb-cd-empty hidden>
      <span class="pawsorb-cd__emptyic">{% render 'pawsorb-icon', name: 'cart', size: 30 %}</span>
      <p>{{ ss.empty_text }}</p>
      <a class="pawsorb-cd__emptylink" href="{{ ss.empty_link | default: '/products/pawsorb' }}">{{ ss.empty_link_label }}</a>
    </div>
    <footer class="pawsorb-cd__foot" data-pawsorb-cd-foot hidden>
      <p class="pawsorb-cd__saving" data-pawsorb-cd-saving hidden></p>
      <div class="pawsorb-cd__row"><span>{{ ss.subtotal_label }}</span><strong data-pawsorb-cd-subtotal></strong></div>
      <form action="{{ routes.cart_url }}" method="post" class="pawsorb-cd__form">
        <button type="submit" name="checkout" class="pawsorb-cd__checkout">{% render 'pawsorb-icon', name: 'lock', size: 18 %}<span>{{ ss.checkout_label }}</span></button>
      </form>
      <ul class="pawsorb-cd__trust">
        {%- if ss.trust_1 != blank -%}<li>{% render 'pawsorb-icon', name: 'shield', size: 16 %}<span>{{ ss.trust_1 }}</span></li>{%- endif -%}
        {%- if ss.trust_2 != blank -%}<li>{% render 'pawsorb-icon', name: 'truck', size: 16 %}<span>{{ ss.trust_2 }}</span></li>{%- endif -%}
      </ul>
    </footer>
  </aside>
  <template data-pawsorb-cd-thumb>{% render 'pawsorb-pack-art' %}</template>
  <template data-pawsorb-cd-icons><span data-i="minus">{% render 'pawsorb-icon', name: 'minus', size: 16 %}</span><span data-i="plus">{% render 'pawsorb-icon', name: 'plus', size: 16 %}</span></template>
</pawsorb-cart-drawer>

{% stylesheet %}
  .pawsorb-cd[hidden], .pawsorb-cd [hidden] { display: none !important; }
  .pawsorb-cd { position: fixed; inset: 0; z-index: 1000; display: block; }
  .pawsorb-cd__overlay { position: absolute; inset: 0; background: rgba(18, 22, 20, .45); opacity: 0; transition: opacity .25s ease; }
  .pawsorb-cd__panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(420px, 100%); display: flex; flex-direction: column; background: #fff; color: #141816; transform: translateX(100%); transition: transform .3s ease; box-shadow: -8px 0 30px rgba(18, 22, 20, .18); font-family: var(--font-body--family); outline: 0; }
  .pawsorb-cd.is-open .pawsorb-cd__overlay { opacity: 1; }
  .pawsorb-cd.is-open .pawsorb-cd__panel { transform: translateX(0); }
  .pawsorb-cd__head { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; border-bottom: 1px solid #DCE6E0; }
  .pawsorb-cd__title { margin: 0; font: 700 20px/1.2 var(--font-heading--family); color: #141816; }
  .pawsorb-cd__count { font-size: 15px; color: #5D6A63; font-weight: 600; }
  .pawsorb-cd__x { width: 40px; height: 40px; display: grid; place-items: center; border: 0; border-radius: 50%; background: #F1F6F3; color: #141816; cursor: pointer; }
  .pawsorb-cd__ship { padding: 12px 18px; background: #F1F6F3; border-bottom: 1px solid #DCE6E0; }
  .pawsorb-cd__shiptext { margin: 0 0 8px; font-size: 14px; font-weight: 600; text-align: center; color: var(--pawsorb-cd-navy, #121614); }
  .pawsorb-cd__shiptext strong { color: var(--pawsorb-cd-green, #12855A); }
  .pawsorb-cd__shipbar { height: 6px; border-radius: 999px; background: #DCE6E0; overflow: hidden; }
  .pawsorb-cd__shipbar span { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--pawsorb-cd-green, #12855A); transition: width .4s ease; }
  .pawsorb-cd__body { flex: 1; overflow-y: auto; padding: 6px 18px; }
  .pawsorb-cd__loading { display: grid; place-items: center; padding: 48px 0; }
  .pawsorb-cd__loading span { width: 26px; height: 26px; border: 3px solid #DCE6E0; border-top-color: var(--pawsorb-cd-accent, #12855A); border-radius: 50%; animation: pawsorb-cd-spin .7s linear infinite; }
  @keyframes pawsorb-cd-spin { to { transform: rotate(360deg); } }
  .pawsorb-cd__item { display: grid; grid-template-columns: 76px 1fr auto; gap: 12px; padding: 14px 0; border-bottom: 1px solid #DCE6E0; align-items: start; }
  .pawsorb-cd__item:last-child { border-bottom: 0; }
  .pawsorb-cd__thumb { width: 76px; height: 76px; border-radius: 10px; overflow: hidden; background: #F1F6F3; display: grid; place-items: center; }
  .pawsorb-cd__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pawsorb-cd__thumb svg { width: 92%; height: auto; }
  .pawsorb-cd__name { display: block; margin: 0; font: 700 15px/1.3 var(--font-heading--family); color: #141816; text-decoration: none; }
  .pawsorb-cd__variant { margin: 2px 0 0; font-size: 13px; color: #5D6A63; }
  .pawsorb-cd__qty { display: inline-flex; align-items: center; margin-top: 10px; border: 1px solid #DCE6E0; border-radius: 10px; overflow: hidden; }
  .pawsorb-cd__qty button { width: 36px; height: 36px; display: grid; place-items: center; border: 0; background: #fff; color: #141816; cursor: pointer; }
  .pawsorb-cd__qty button:disabled { opacity: .4; cursor: default; }
  .pawsorb-cd__qty span { min-width: 30px; text-align: center; font-weight: 700; font-size: 15px; }
  .pawsorb-cd__prices { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .pawsorb-cd__price { font: 700 16px/1.2 var(--font-heading--family); }
  .pawsorb-cd__was { font-size: 13px; color: #5D6A63; }
  .pawsorb-cd__rm { margin-top: 8px; padding: 0; border: 0; background: none; color: #5D6A63; font-size: 12.5px; text-decoration: underline; cursor: pointer; }
  .pawsorb-cd__empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 32px; text-align: center; }
  .pawsorb-cd__empty p { margin: 0; font: 700 18px/1.3 var(--font-heading--family); }
  .pawsorb-cd__emptyic { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: #F1F6F3; color: var(--pawsorb-cd-navy, #121614); }
  .pawsorb-cd__emptylink { display: inline-flex; align-items: center; min-height: 48px; padding: 0 26px; border-radius: 10px; background: var(--pawsorb-cd-accent, #12855A); color: #fff; font: 700 15px/1 var(--font-heading--family); text-decoration: none; }
  .pawsorb-cd__foot { padding: 14px 18px calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid #DCE6E0; background: #fff; }
  .pawsorb-cd__saving { margin: 0 0 10px; padding: 8px 12px; border-radius: 10px; background: rgba(18, 133, 90, .1); color: var(--pawsorb-cd-green, #12855A); font-weight: 700; font-size: 14px; text-align: center; }
  .pawsorb-cd__row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; font-size: 16px; }
  .pawsorb-cd__row strong { font: 700 20px/1 var(--font-heading--family); }
  .pawsorb-cd__form { margin: 0; }
  .pawsorb-cd__checkout { width: 100%; min-height: 56px; display: flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-radius: 10px; background: var(--pawsorb-cd-accent, #12855A); color: #fff; font: 700 17px/1 var(--font-heading--family); letter-spacing: .03em; cursor: pointer; }
  .pawsorb-cd__checkout:hover { background: #0C5E40; }
  .pawsorb-cd__trust { list-style: none; display: flex; justify-content: center; flex-wrap: wrap; gap: 6px 16px; margin: 12px 0 0; padding: 0; }
  .pawsorb-cd__trust li { display: flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--pawsorb-cd-navy, #121614); }
  .pawsorb-cd__trust .pawsorb-icon { color: var(--pawsorb-cd-green, #12855A); }
  html.pawsorb-cd-lock { overflow: hidden; }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('pawsorb-cart-drawer')) {
    customElements.define('pawsorb-cart-drawer', class extends HTMLElement {
      connectedCallback() {
        this.panel = this.querySelector('.pawsorb-cd__panel');
        this.root = this.dataset.root || '/';
        if (!this.root.endsWith('/')) this.root += '/';
        this.addEventListener('click', (e) => {
          if (e.target.closest('[data-pawsorb-cd-close]')) this.close();
          const b = e.target.closest('[data-line]');
          if (b) this.change(b.dataset.key, Number(b.dataset.line));
        });
        this.onKey = (e) => { if (e.key === 'Escape' && !this.hidden) this.close(); };
        document.addEventListener('keydown', this.onKey);
        this.onOpen = (e) => this.open(e.detail || {});
        document.addEventListener('pawsorb:cart-open', this.onOpen);
        if (!this.dataset.onCart) {
          this.onHeader = (e) => {
            const a = e.target.closest && e.target.closest('a[href$="/cart"], a.action__cart, [data-pawsorb-cart-open]');
            if (!a || a.closest('.pawsorb-cd') || e.metaKey || e.ctrlKey || e.shiftKey) return;
            e.preventDefault();
            e.stopPropagation();
            this.open({});
          };
          document.addEventListener('click', this.onHeader, true);
        }
      }
      disconnectedCallback() {
        document.removeEventListener('keydown', this.onKey);
        document.removeEventListener('pawsorb:cart-open', this.onOpen);
        if (this.onHeader) document.removeEventListener('click', this.onHeader, true);
      }
      cents(txt) { return Math.round(parseFloat(String(txt || '').replace(/[^0-9.]/g, '')) * 100) || 0; }
      money(c) { return '$' + ((Number(c) || 0) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
      async open(detail) {
        this.lastFocus = document.activeElement;
        this.hidden = false;
        document.documentElement.classList.add('pawsorb-cd-lock');
        requestAnimationFrame(() => requestAnimationFrame(() => this.classList.add('is-open')));
        this.panel.focus({ preventScroll: true });
        let cart = null;
        try {
          const r = await fetch(this.root + 'cart.js', { headers: { Accept: 'application/json' } });
          if (!r.ok) throw new Error('cart');
          cart = await r.json();
        } catch (e) {
          cart = detail.mock ? this.mockCart(detail.mock) : (window.__pawsorbMockCart || { items: [], item_count: 0, total_price: 0 });
        }
        this.render(cart);
      }
      mockCart(item) {
        const t = window.pawsorbTier || {};
        const total = this.cents(t.price) || 3999 * item.quantity;
        return { item_count: item.quantity, total_price: total, items: [{ key: 'qa', title: document.querySelector('.pawsorb-pdp__title')?.textContent || 'PawSorb', variant_title: null, quantity: item.quantity, final_line_price: total, original_line_price: 3999 * item.quantity, image: null, url: '#' }] };
      }
      close() {
        this.classList.remove('is-open');
        document.documentElement.classList.remove('pawsorb-cd-lock');
        setTimeout(() => { this.hidden = true; }, 300);
        if (this.lastFocus && this.lastFocus.focus) this.lastFocus.focus({ preventScroll: true });
      }
      async change(key, quantity) {
        this.querySelectorAll('[data-line]').forEach((b) => { b.disabled = true; });
        try {
          const r = await fetch(this.root + 'cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ id: key, quantity }) });
          this.render(await r.json());
        } catch (e) { this.open({}); }
      }
      bubble(count) {
        document.querySelectorAll('[ref="cartBubbleCount"]').forEach((n) => { n.textContent = count < 100 ? String(count) : ''; n.classList.toggle('hidden', count === 0); });
        document.querySelectorAll('[ref="cartBubble"]').forEach((n) => n.classList.toggle('visually-hidden', count === 0));
      }
      render(cart) {
        const items = cart.items || [];
        const count = cart.item_count || 0;
        this.bubble(count);
        const body = this.querySelector('[data-pawsorb-cd-body]');
        const empty = this.querySelector('[data-pawsorb-cd-empty]');
        const foot = this.querySelector('[data-pawsorb-cd-foot]');
        const ship = this.querySelector('[data-pawsorb-cd-ship]');
        this.querySelector('[data-pawsorb-cd-count]').textContent = count ? '(' + count + ')' : '';
        const isEmpty = items.length === 0;
        body.hidden = isEmpty; empty.hidden = !isEmpty; foot.hidden = isEmpty; ship.hidden = isEmpty;
        if (isEmpty) return;
        const thumbTpl = this.querySelector('[data-pawsorb-cd-thumb]').innerHTML;
        const icons = this.querySelector('[data-pawsorb-cd-icons]').content;
        const ic = (n) => icons.querySelector('[data-i="' + n + '"]').innerHTML;
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        body.innerHTML = items.map((it) => {
          const img = it.image ? '<img src="' + esc(it.image) + (String(it.image).includes('?') ? '&' : '?') + 'width=160" alt="" width="76" height="76" loading="lazy">' : thumbTpl;
          const vt = it.variant_title && !/default/i.test(it.variant_title) ? '<p class="pawsorb-cd__variant">' + esc(it.variant_title) + '</p>' : '';
          const was = it.original_line_price > it.final_line_price ? '<s class="pawsorb-cd__was">' + this.money(it.original_line_price) + '</s>' : '';
          return '<div class="pawsorb-cd__item"><div class="pawsorb-cd__thumb">' + img + '</div><div><a class="pawsorb-cd__name" href="' + esc(it.url) + '">' + esc(it.product_title || it.title) + '</a>' + vt +
            '<div class="pawsorb-cd__qty"><button type="button" data-line="' + (it.quantity - 1) + '" data-key="' + esc(it.key) + '" aria-label="-">' + ic('minus') + '</button><span>' + it.quantity + '</span><button type="button" data-line="' + (it.quantity + 1) + '" data-key="' + esc(it.key) + '" aria-label="+">' + ic('plus') + '</button></div></div>' +
            '<div class="pawsorb-cd__prices"><span class="pawsorb-cd__price">' + this.money(it.final_line_price) + '</span>' + was + '</div></div>';
        }).join('');
        const th = Number(this.dataset.threshold) || 0;
        if (th > 0) {
          const left = Math.max(0, th - count);
          const txt = left > 0 ? (this.dataset.tAway || '').replace('[N]', '<strong>' + left + '</strong>') : '<strong>' + esc(this.dataset.tUnlocked || '') + '</strong>';
          this.querySelector('[data-pawsorb-cd-shiptext]').innerHTML = txt;
          this.querySelector('[data-pawsorb-cd-shipbar]').style.width = Math.min(100, (count / th) * 100) + '%';
        } else ship.hidden = true;
        this.querySelector('[data-pawsorb-cd-subtotal]').textContent = this.money(cart.total_price);
        const unit = this.cents(this.dataset.compareUnit);
        const saved = unit ? unit * count - cart.total_price : (cart.total_discount || 0);
        const sv = this.querySelector('[data-pawsorb-cd-saving]');
        sv.hidden = !(saved > 0);
        if (saved > 0) sv.textContent = (this.dataset.tSaving || '').replace('[x]', this.money(saved));
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PawSorb cart drawer",
  "tag": "div",
  "class": "pawsorb-section-cart-drawer",
  "settings": [
    { "type": "paragraph", "content": "Opens after add to cart and from the header cart icon. Only a Checkout button: no express checkout, no add-ons." },
    { "type": "text", "id": "title", "label": "Title", "default": "Your cart" },
    { "type": "text", "id": "close_label", "label": "Close button label (screen readers)", "default": "Close cart" },
    { "type": "range", "id": "free_ship_qty", "label": "Free shipping from (tubes)", "min": 0, "max": 10, "step": 1, "default": 3, "info": "0 hides the bar. Must match your shipping rates." },
    { "type": "text", "id": "free_ship_away", "label": "Free shipping: not yet", "default": "Add [N] more tube(s) for FREE shipping", "info": "[N] = tubes missing" },
    { "type": "text", "id": "free_ship_done", "label": "Free shipping: unlocked", "default": "You've unlocked FREE shipping" },
    { "type": "text", "id": "compare_unit", "label": "Compare-at price per tube (text)", "default": "$59.99", "info": "Savings = this x tubes minus the cart total." },
    { "type": "text", "id": "saving_text", "label": "Savings line", "default": "You're saving [x]", "info": "[x] = amount saved" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "trust_1", "label": "Trust 1", "default": "90-day money-back guarantee" },
    { "type": "text", "id": "trust_2", "label": "Trust 2", "default": "Fast US shipping" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_link_label", "label": "Empty cart link", "default": "Shop PawSorb" },
    { "type": "url", "id": "empty_link", "label": "Empty cart link URL", "info": "Blank = /products/pawsorb" },
    { "type": "color", "id": "accent_color", "label": "Button", "default": "#12855A" },
    { "type": "color", "id": "navy_color", "label": "Navy", "default": "#121614" },
    { "type": "color", "id": "savings_color", "label": "Savings green", "default": "#12855A" }
  ],
  "presets": [ { "name": "PawSorb cart drawer" } ]
}
{% endschema %}
