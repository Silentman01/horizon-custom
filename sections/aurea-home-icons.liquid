{%- assign href = section.settings.link | default: section.settings.product.url | default: routes.all_products_collection_url -%}
<section class="au-h au-h--pine" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-h-wrap">
    <div class="au-h-head ">
  {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {% render 'aurea-title', text: section.settings.heading, class: 'au-h-h2' %}
  {%- if section.settings.sub != blank -%}<p class="au-h-sub au-h-sub--l">{{ section.settings.sub }}</p>{%- endif -%}
</div>
    <div class="au-h-ic">
      {%- for block in section.blocks -%}
        <div class="au-h-ic__card" {{ block.shopify_attributes }}>
          <span class="au-h-ic__ico">{%- if block.settings.icon == 'clover' -%}<svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="9" r="3.6"/><circle cx="15" cy="9" r="3.6"/><circle cx="9" cy="15" r="3.6"/><circle cx="15" cy="15" r="3.6"/><path d="M12 12l5 9"/></svg>{%- else -%}{% render 'aurea-icon', name: block.settings.icon %}{%- endif -%}</span>
          <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        </div>
      {%- endfor -%}
    </div>
    <div class="au-h-ic__cta"><a class="au-h-btn au-h-btn--gold" href="{{ href }}">{{ section.settings.cta_label }}</a></div>
  </div>
</section>
{% stylesheet %}
  .au-h { padding: 60px 0; font-family: var(--au-body); color: #2A2E29; background: #fff; }
  .au-h *, .au-h *::before, .au-h *::after { box-sizing: border-box; }
  .au-h--parch { background: var(--au-parchment); }
  .au-h--pine { background: var(--au-pine); }
  .au-h--dark { background: var(--au-espresso); }
  .au-h.au-h--dark, .au-h.au-h--pine, .au-h.au-h-hero { color: #fff; }
  .au-h-wrap { width: calc(100% - 32px); max-width: 1200px; margin-inline: auto; }
  .au-h-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .au-h-h2 { font-size: 31px; line-height: 1.08; }
  .au-h-sub { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.6; color: #4A5249; }
  .au-h-i { width: 1em; height: 1em; flex: none; }
  .au-h .au-icon { width: 1em; height: 1em; flex: none; }
  .au-h-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 0 32px; border-radius: 999px; background: var(--au-pine); color: var(--au-parchment); font-family: var(--au-body); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .au-h-btn:hover { filter: brightness(1.12); }
  .au-h-btn:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 3px; }
  .au-h-btn .au-h-i { font-size: 18px; }
  .au-h-btn--gold { background: var(--au-gold); color: #1E1A10; }
  .au-h-btn--ghost { background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.55); }
  .au-h-dark .au-title, .au-h--dark .au-title, .au-h--pine .au-title { color: #fff; }
  .au-h-dark .au-title em, .au-h--dark .au-title em, .au-h--pine .au-title em { color: #DDB866; }
  .au-h--dark .au-eyebrow, .au-h--pine .au-eyebrow { color: #DDB866; }
  .au-h-tp { display: inline-flex; gap: 2px; }
  .au-h-tp svg { width: 20px; height: 20px; padding: 3px; background: #00B67A; }
  .au-h-ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #f1f1f1, #dcdcdc); color: #6b6b6b; font-size: 12px; text-align: center; }
  @media (min-width: 750px) { .au-h { padding: 72px 0; } .au-h-wrap { width: calc(100% - 48px); } .au-h-head { margin-bottom: 56px; } .au-h-h2 { font-size: 36px; } .au-h-btn { width: auto; } }
  @media (min-width: 990px) { .au-h { padding: 96px 0; } .au-h-h2 { font-size: 44px; } }

  .au-h.au-h--pine { background: radial-gradient(circle at 50% 0%, #2a4636, var(--au-pine) 70%); }
  .au-h .au-h-sub.au-h-sub--l { color: rgb(255 255 255 / 0.78); }
  .au-h-ic { display: grid; gap: 12px; }
  .au-h-ic__card { display: flex; gap: 12px; align-items: flex-start; padding: 18px; border: 1px solid rgb(221 184 102 / 0.22); border-radius: 6px; background: rgb(255 255 255 / 0.05); transition: background 0.25s, border-color 0.25s; }
  .au-h-ic__card:hover { background: rgb(255 255 255 / 0.09); border-color: rgb(221 184 102 / 0.45); }
  .au-h-ic__ico { display: grid; place-items: center; flex: none; width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg, rgb(221 184 102 / 0.28), rgb(221 184 102 / 0.1)); color: #DDB866; font-size: 24px; }
  .au-h-ic__card h3 { margin: 0 0 6px; font-family: var(--au-heading); font-size: 21px; font-weight: 600; color: #fff; }
  .au-h-ic__card p { margin: 0; font-size: 15px; line-height: 1.6; color: rgb(255 255 255 / 0.72); }
  .au-h-ic__cta { display: flex; justify-content: center; margin-top: 36px; }
  @media (min-width: 750px) {
    .au-h-ic { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .au-h-ic__card { display: block; padding: 30px 28px; }
    .au-h-ic__ico { width: 52px; height: 52px; margin-bottom: 18px; font-size: 26px; }
    .au-h-ic__cta { margin-top: 48px; }
  }
  @media (min-width: 990px) { .au-h-ic { grid-template-columns: repeat(3, 1fr); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea home icons band",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why they wear it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (*word* = gold italic)",
      "default": "Less worry. *More flow.*"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Sub-line",
      "default": "What our wearers tell us they notice once the bracelet is part of their day."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get my bracelet"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link (empty = selected product, then all products)"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product for the button link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "wind",
          "options": [
            {
              "value": "wind",
              "label": "wind"
            },
            {
              "value": "magnet",
              "label": "magnet"
            },
            {
              "value": "coins",
              "label": "coins"
            },
            {
              "value": "clover",
              "label": "clover"
            },
            {
              "value": "wave",
              "label": "wave"
            },
            {
              "value": "moonstar",
              "label": "moonstar"
            },
            {
              "value": "moon",
              "label": "moon"
            },
            {
              "value": "sparkle",
              "label": "sparkle"
            },
            {
              "value": "gem",
              "label": "gem"
            },
            {
              "value": "infinity",
              "label": "infinity"
            },
            {
              "value": "shield",
              "label": "shield"
            },
            {
              "value": "clock",
              "label": "clock"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lets go of heavy energy"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea home icons band",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "wind",
            "title": "Lets go of heavy energy",
            "text": "A daily reminder to release the stress and scarcity you have been carrying."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "magnet",
            "title": "Keeps abundance close",
            "text": "Your intention sits right at your pulse, all day long."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "coins",
            "title": "Money feels lighter",
            "text": "Less 2AM math, more calm about what comes in and what goes out."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "clover",
            "title": "Luck finds you",
            "text": "Stay open to the call, the raise, the lucky break."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "wave",
            "title": "Clears your vibration",
            "text": "Start each morning from a calmer, clearer place."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "moonstar",
            "title": "Peace at night",
            "text": "Fall asleep lighter, with fewer worries on repeat."
          }
        }
      ]
    }
  ]
}
{% endschema %}
