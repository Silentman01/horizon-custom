<section class="au-tl" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-tl__inner">
    <div class="au-tl__img">
      {% render 'aurea-media', image: section.settings.image, asset: section.settings.image_asset, ratio: '1 / 1', label: 'Image: bracelet ring with scattered raw stones (transparent)', radius: 20, sizes: '(min-width: 750px) 40vw, 100vw' %}
    </div>
    <aurea-timeline class="au-tl__col">
      {% render 'aurea-title', text: section.settings.heading, class: 'au-tl__h' %}
      <ol class="au-tl__steps">
        <span class="au-tl__track" aria-hidden="true"><i class="au-tl__fill"></i></span>
        {%- for block in section.blocks -%}
          <li class="au-tl__step" {{ block.shopify_attributes }}>
            <span class="au-tl__dot" aria-hidden="true"></span>
            <p class="au-tl__label">{{ block.settings.label }}</p>
            <p class="au-tl__text">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.button_label != blank -%}
        <a class="au-btn" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </aurea-timeline>
  </div>
</section>
{% stylesheet %}
  .au-tl { padding: 44px 16px; background: var(--au-bg); }
  .au-tl__inner { max-width: 1100px; margin: 0 auto; display: grid; gap: 28px; }
  .au-tl__img .au-media { background: var(--au-parchment); }
  .au-tl__img .au-media > img { object-fit: contain; }
  .au-tl__h { font-weight: 400; font-size: 27px; }
  .au-tl__steps { position: relative; margin: 28px 0; padding: 0 0 0 44px; list-style: none; display: grid; gap: 30px; }
  .au-tl__track { position: absolute; left: 12px; top: 8px; bottom: 8px; width: 2px; background: #e7ddc7; }
  .au-tl__fill { display: block; width: 100%; height: 0; background: var(--au-gold); transition: height 0.2s linear; }
  .au-tl__step { position: relative; opacity: 0.4; transition: opacity 0.3s; }
  .au-tl__step.is-active { opacity: 1; }
  .au-tl__dot { position: absolute; left: -44px; top: 0; width: 26px; height: 26px; border-radius: 50%; background: #fff; border: 2px solid #e7ddc7; transition: all 0.3s; }
  .au-tl__step.is-active .au-tl__dot { background: var(--au-gold); border-color: var(--au-gold); box-shadow: 0 0 0 5px rgb(from var(--au-gold) r g b / 0.2); }
  .au-tl__label { margin: 0 0 4px; font-size: 17px; font-weight: 700; color: var(--au-pine); }
  .au-tl__text { margin: 0; font-size: 15px; line-height: 1.5; color: #4a443a; }
  @media (min-width: 750px) {
    .au-tl { padding: 72px 24px; }
    .au-tl__inner { grid-template-columns: 40% 1fr; gap: 64px; align-items: start; }
    .au-tl__img { position: sticky; top: 90px; }
    .au-tl__h { font-size: 34px; }
  }
  @media (prefers-reduced-motion: reduce) { .au-tl__step, .au-tl__dot, .au-tl__fill { transition: none; } }
{% endstylesheet %}
{% javascript %}
  if (!customElements.get('aurea-timeline')) {
    class AureaTimeline extends HTMLElement {
      connectedCallback() {
        this.steps = [...this.querySelectorAll('.au-tl__step')];
        this.fill = this.querySelector('.au-tl__fill');
        this.list = this.querySelector('.au-tl__steps');
        this.onScroll = () => this.update();
        window.addEventListener('scroll', this.onScroll, { passive: true });
        this.update();
      }
      disconnectedCallback() { window.removeEventListener('scroll', this.onScroll); }
      update() {
        const vh = window.innerHeight;
        const line = vh * 0.6;
        const r = this.list.getBoundingClientRect();
        let progress = (line - r.top) / r.height;
        progress = Math.max(0, Math.min(1, progress));
        this.fill.style.height = progress * 100 + '%';
        this.steps.forEach((s) => s.classList.toggle('is-active', s.getBoundingClientRect().top < line));
      }
    }
    customElements.define('aurea-timeline', AureaTimeline);
  }
{% endjavascript %}
{% schema %}
{
  "name": "Aurea timeline",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (1:1)" },
    { "type": "text", "id": "image_asset", "label": "Image theme asset (fallback filename)" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "What to expect as your body starts to *vibrate*" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Raise My Frequency" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#MainContent" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "First 72 hours" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A soft warmth or tingle at your pulse point." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea timeline",
      "blocks": [
        { "type": "step", "settings": { "label": "First 72 hours", "text": "A soft warmth or tingle at your pulse point. Your field is starting to retune." } },
        { "type": "step", "settings": { "label": "Week 1", "text": "The money-worry loop fades first. You feel calmer, lighter, less trapped by the numbers." } },
        { "type": "step", "settings": { "label": "Week 2+", "text": "A new baseline. You handle money like someone it flows to. Aligned, magnetic, unblocked." } }
      ]
    }
  ]
}
{% endschema %}
