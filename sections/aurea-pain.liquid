<section class="au-pain" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-pain__inner">
    {% render 'aurea-title', text: section.settings.heading, class: 'au-pain__h' %}
    {%- if section.settings.sub != blank -%}<p class="au-pain__sub">{{ section.settings.sub }}</p>{%- endif -%}
    <ul class="au-pain__grid">
      {%- for block in section.blocks -%}
        <li class="au-pain__card" {{ block.shopify_attributes }}>
          {%- assign has_img = false -%}
          {%- if block.settings.image or block.settings.image_asset != blank -%}{%- assign has_img = true -%}{%- endif -%}
          <span class="au-pain__icon{% if has_img %} au-pain__icon--img{% endif %}">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '', width: 128, height: 128 }}
            {%- elsif block.settings.image_asset != blank -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="lazy" decoding="async" width="128" height="128">
            {%- else -%}
              {% render 'aurea-icon', name: block.settings.icon %}
            {%- endif -%}
          </span>
          <div class="au-pain__text">
            <p class="au-pain__cap">{{ block.settings.title }}</p>
            <p class="au-pain__desc">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% stylesheet %}
  .au-pain { padding: 44px 16px; background: var(--au-parchment); }
  .au-pain__inner { max-width: 1100px; margin: 0 auto; text-align: center; }
  .au-pain__h { font-weight: 500; font-size: clamp(26px, 4vw, 40px); }
  .au-pain__sub { max-width: 60ch; margin: 14px auto 36px; font-size: 16px; color: var(--au-ink); }
  .au-pain__grid { display: grid; grid-template-columns: 1fr; margin: 0; padding: 0; list-style: none; text-align: left; }
  .au-pain__card { display: flex; align-items: center; gap: 16px; padding: 18px 0; border-top: 0.5px solid var(--au-gold); }
  .au-pain__card:last-child { border-bottom: 0.5px solid var(--au-gold); }
  .au-pain__icon { flex: none; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 2px var(--au-gold); color: var(--au-gold); background: #fff; }
  .au-pain__icon img { width: 100%; height: 100%; object-fit: cover; }
  .au-pain__icon--img { width: 76px; height: 76px; background: var(--au-pine); box-shadow: 0 0 0 2px var(--au-gold), 0 0 0 5px var(--au-parchment), 0 0 0 6px rgb(from var(--au-gold) r g b / 0.45); }
  .au-pain__icon--img img { transform: scale(1.06); }
  .au-pain__cap { margin: 0 0 4px; font-size: 15px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--au-gold); }
  .au-pain__desc { margin: 0; font-size: 16px; line-height: 1.4; color: rgb(from var(--au-ink) r g b / 0.85); }
  @media (min-width: 750px) {
    .au-pain { padding: 44px; }
    .au-pain__grid { grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .au-pain__card { flex-direction: column; padding: 26px 18px; border: 1px solid var(--au-gold); border-radius: 12px; text-align: center; }
    .au-pain__card:last-child { border-bottom: 1px solid var(--au-gold); }
    .au-pain__icon { width: 84px; height: 84px; }
    .au-pain__icon--img { width: 132px; height: 132px; margin-bottom: 4px; }
  }
  @media (min-width: 750px) and (max-width: 1099px) {
    .au-pain__icon--img { width: 100px; height: 100px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea pain cards",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "You're Not Unlucky. Your flow is just *blocked.*" },
    { "type": "textarea", "id": "sub", "label": "Subtitle", "default": "People call it \"bad luck.\" The real cause goes deeper." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Round image (replaces icon)" },
        { "type": "text", "id": "image_asset", "label": "Image theme asset (fallback filename)" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "pouch", "options": [ { "value": "pouch", "label": "Pouch" }, { "value": "stuck", "label": "House" }, { "value": "sign", "label": "Signpost" }, { "value": "clock", "label": "Clock" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Money slips away" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "It comes in, then disappears just as fast, so you never get ahead." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea pain cards",
      "blocks": [
        { "type": "card", "settings": { "icon": "pouch", "title": "Money slips away", "text": "It comes in, then disappears just as fast, so you never get ahead." } },
        { "type": "card", "settings": { "icon": "stuck", "title": "Always stuck", "text": "You work hard, do all the right things, and still feel like you're going nowhere." } },
        { "type": "card", "settings": { "icon": "sign", "title": "Nothing lands", "text": "The raise, the client, the lucky break… they all pass you by." } },
        { "type": "card", "settings": { "icon": "clock", "title": "2AM money dread", "text": "Awake at night running numbers, with worry that won't let go." } }
      ]
    }
  ]
}
{% endschema %}
