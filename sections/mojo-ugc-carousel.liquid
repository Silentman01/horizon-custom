{%- assign s = section.settings -%}
<section class="mojo-ugc{% if s.polaroid %} mojo-ugc--polaroid{% endif %}" style="{% render 'mojo-vars' %}--mojo-pt:{{ s.padding_top }}px;--mojo-pb:{{ s.padding_bottom }}px;--mojo-ugc-n:{{ s.per_row | default: 5 }};">
  <div class="mojo-ugc__head">
    {%- if s.heading != blank -%}<h2 class="mojo-ugc__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="mojo-ugc__sub">{{ s.subheading }}</p>{%- endif -%}
  </div>
  <div class="mojo-ugc__wrap" data-mojo-rail-wrap data-mojo-overflow="0">
    <div class="mojo-ugc__rail" data-mojo-rail>
      {%- for block in section.blocks -%}
        <div class="mojo-ugc__card" {{ block.shopify_attributes }}>
          {% render 'mojo-media', image: block.settings.image, asset: block.settings.image_asset, ratio: s.ratio, placeholder: 'lifestyle-1', alt: block.settings.alt, sizes: '(min-width: 750px) 20vw, 70vw' %}
        </div>
      {%- endfor -%}
    </div>
    <div class="mojo-ugc__dots" data-mojo-dots></div>
  </div>
</section>

{% stylesheet %}
.mojo-ugc { background: var(--mojo-bg); color: var(--mojo-fg); font-family: var(--mojo-font); padding: var(--mojo-pt) 0 var(--mojo-pb); overflow: hidden; }
.mojo-ugc__head { text-align: center; padding-inline: 20px; margin-bottom: 24px; }
.mojo-ugc__heading { font-family: var(--mojo-font-heading); font-weight: 600; font-size: 26px; line-height: 1.2; margin: 0; }
.mojo-ugc__sub { font-weight: 500; font-size: 15px; margin: 8px 0 0; }
.mojo-ugc__rail { padding-inline: 20px; scroll-padding-inline: 20px; gap: 10px; }
.mojo-ugc--polaroid .mojo-ugc__rail { padding-block: 16px; }
.mojo-ugc--polaroid .mojo-ugc__card { flex-basis: 46vw; box-sizing: border-box; background: #fff; padding: 8px 8px 24px; box-shadow: 0 2px 10px rgb(0 0 0 / 16%); transform: rotate(-2deg); }
.mojo-ugc--polaroid .mojo-ugc__card:nth-child(even) { transform: rotate(2deg); }
.mojo-ugc__card { flex: 0 0 68vw; max-width: 300px; scroll-snap-align: start; }
@media screen and (min-width: 750px) {
  .mojo-ugc__heading { font-size: 20px; }
  .mojo-ugc__sub { font-size: 12px; }
  .mojo-ugc__card { flex: 0 0 calc((100% - (var(--mojo-ugc-n) - 1) * 12px) / var(--mojo-ugc-n)); max-width: none; }
  .mojo-ugc__rail { padding-inline: 0; scroll-padding-inline: 0; }
  .mojo-ugc--polaroid .mojo-ugc__card { flex-basis: calc((100% - (var(--mojo-ugc-n) - 1) * 12px) / var(--mojo-ugc-n)); }
}

.mojo-ugc__rail { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; -webkit-overflow-scrolling: touch; }
.mojo-ugc__rail::-webkit-scrollbar { display: none; }
.mojo-ugc__rail[data-mojo-dragging] { scroll-snap-type: none; cursor: grabbing; user-select: none; }
.mojo-ugc__dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
.mojo-ugc__dots button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: #d9d9d9; cursor: pointer; }
.mojo-ugc__dots button[aria-current='true'] { background: #000; }
[data-mojo-overflow='0'] > .mojo-ugc__dots { display: none; }
{% endstylesheet %}

{% javascript %}
if (!window.mojoRails) {
  window.mojoRails = true;
  const setup = (rail) => {
    if (rail.dataset.mojoReady) return;
    rail.dataset.mojoReady = '1';
    const wrap = rail.closest('[data-mojo-rail-wrap]') || rail.parentElement;
    const dots = wrap.querySelector('[data-mojo-dots]');
    const prev = wrap.querySelector('[data-mojo-prev]');
    const next = wrap.querySelector('[data-mojo-next]');
    const cards = () => [...rail.children];
    const step = () => {
      const c = cards();
      if (c.length > 1) return c[1].getBoundingClientRect().left - c[0].getBoundingClientRect().left;
      return c[0] ? c[0].getBoundingClientRect().width : 0;
    };
    const index = () => { const s = step(); return s ? Math.round(rail.scrollLeft / s) : 0; };
    const sync = () => {
      const over = rail.scrollWidth > rail.clientWidth + 2;
      wrap.dataset.mojoOverflow = over ? '1' : '0';
      if (dots) {
        if (dots.children.length !== cards().length) {
          dots.textContent = '';
          cards().forEach((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', 'Go to item ' + (i + 1));
            b.addEventListener('click', () => rail.scrollTo({ left: i * step(), behavior: 'smooth' }));
            dots.appendChild(b);
          });
        }
        const at = index();
        [...dots.children].forEach((b, i) => b.setAttribute('aria-current', i === at ? 'true' : 'false'));
      }
      if (prev) prev.disabled = rail.scrollLeft <= 2;
      if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    if (prev) prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.setAttribute('data-mojo-dragging', ''); rail.setPointerCapture(id); }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.removeAttribute('data-mojo-dragging');
      rail.scrollLeft = left;
      const s = step();
      if (s) rail.scrollTo({ left: Math.round(left / s) * s, behavior: 'smooth' });
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    sync();
    setTimeout(sync, 400);
  };
  const init = () => document.querySelectorAll('[data-mojo-rail]').forEach(setup);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('shopify:section:load', init);
}
{% endjavascript %}

{% schema %}
{
  "name": "Mojo photo carousel",
  "tag": "section",
  "class": "mojo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mojo is trusted by 175k+ men"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join the comfort revolution."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Photo ratio",
      "default": "2 / 3",
      "options": [
        {
          "value": "2 / 3",
          "label": "Portrait 2:3"
        },
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 30,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Style (optional)"
    },
    {
      "type": "checkbox",
      "id": "polaroid",
      "label": "Polaroid frames (white border, slight tilt)",
      "default": false
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Photos visible on desktop",
      "default": 5,
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": ""
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image: theme file name (optional, e.g. mojo-hero.webp)",
          "info": "Used when no image is uploaded above."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Mojo customer photo"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Mojo photo carousel",
      "blocks": [
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        }
      ]
    }
  ]
}
{% endschema %}
