{%- liquid
  assign s = section.settings
  assign stages = section.blocks | where: 'type', 'stage'
-%}
<div class="ot-timeline" data-ot-tl style="{% render 'oldtoms-vars' %}--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  {%- if s.heading != blank -%}<h2 class="ot-timeline__heading">{{ s.heading }}</h2>{%- endif -%}
  <div class="ot-timeline__grid">
    <div class="ot-timeline__image">{% render 'oldtoms-media', image: s.image, asset: s.asset, ratio: '0.87', alt: s.image_alt, sizes: '(min-width: 750px) 46vw, 92vw' %}</div>
    <div class="ot-timeline__panel">
      <div class="ot-timeline__tabs" role="tablist">
        {%- for stage in stages -%}
          <button type="button" class="ot-timeline__tab" role="tab" id="ot-tl-tab-{{ section.id }}-{{ forloop.index }}" aria-controls="ot-tl-panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-ot-tab="{{ forloop.index }}" {{ stage.shopify_attributes }}>{{ stage.settings.tab }}</button>
        {%- endfor -%}
      </div>
      {%- if s.hint != blank -%}
        <p class="ot-timeline__hint">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 013 0V11m0-1.5a1.5 1.5 0 013 0V11m0-.5a1.5 1.5 0 013 0V15a6 6 0 01-6 6h-1.5a6 6 0 01-4.8-2.4L4 15.5a1.5 1.5 0 012.3-1.9L9 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{{ s.hint }}</span>
        </p>
      {%- endif -%}
      {%- for stage in stages -%}
        {%- assign st = stage.settings -%}
        <div class="ot-timeline__stage" role="tabpanel" id="ot-tl-panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="ot-tl-tab-{{ section.id }}-{{ forloop.index }}" data-ot-panel="{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
          <div class="ot-timeline__line">
            <span class="ot-timeline__dot" aria-hidden="true"></span>
            <span class="ot-timeline__chip">{{ st.chip }}</span>
            <h3 class="ot-timeline__title">{{ st.title }}</h3>
            <ul class="ot-timeline__list">
              {%- for n in (1..3) -%}
                {%- liquid
                  assign t_key = 'point_' | append: n
                  assign n_key = 'note_' | append: n
                  assign t_val = st[t_key]
                  assign n_val = st[n_key]
                -%}
                {%- if t_val != blank -%}
                  <li class="ot-timeline__item">
                    <p class="ot-timeline__point"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#9b4600"/><path d="M7.5 12.3l3 3 6-6.3" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ t_val }}</span></p>
                    {%- if n_val != blank -%}<p class="ot-timeline__note">({{ n_val }})</p>{%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.show_cta -%}
    <div class="ot-timeline__cta">{% render 'oldtoms-cta', label: s.cta_label, guarantee: s.cta_guarantee %}</div>
  {%- endif -%}
</div>

{% stylesheet %}
.ot-timeline { background: #f0f0e8; color: #23372b; font-family: var(--ot-font); padding: var(--ot-pt, 48px) 16px var(--ot-pb, 48px); }
.ot-timeline__heading { margin: 0 auto 24px; max-width: 760px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 32px; line-height: 1.15; }
.ot-timeline__grid { display: grid; gap: 20px; max-width: 1320px; margin: 0 auto; }
.ot-timeline__image { border-radius: 16px; overflow: hidden; }
.ot-timeline__tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.ot-timeline__tab { min-height: 44px; border: 1px solid #24433d; border-radius: 999px; background: #fff; color: #24433d; font: 700 14px/1 var(--ot-font); text-transform: uppercase; cursor: pointer; }
.ot-timeline__tab[aria-selected='true'] { background: #23372b; color: #fff; }
.ot-timeline__tab:focus-visible { outline: 2px solid #24433d; outline-offset: 2px; }
.ot-timeline__hint { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 14px 0 20px; font-size: 12px; color: #4d4d4d; }
.ot-timeline__stage[hidden] { display: none; }
.ot-timeline__line { position: relative; padding-left: 30px; }
.ot-timeline__line::before { content: ''; position: absolute; left: 9px; top: 12px; bottom: 0; width: 2px; background: #24433d; }
.ot-timeline__dot { position: absolute; left: 0; top: 2px; width: 20px; height: 20px; border-radius: 50%; background: #23372b; box-shadow: 0 0 0 4px #ccf46f; transform: scale(0.8); }
.ot-timeline__chip { display: inline-block; padding: 3px 8px; border-radius: 4px; background: #23372b; color: #ccf46f; font: 700 13px/1.3 var(--ot-font); text-transform: uppercase; }
.ot-timeline__title { margin: 12px 0 14px; font: 700 15px/1.3 var(--ot-font); text-transform: uppercase; color: #23372b; }
.ot-timeline__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
.ot-timeline__point { display: flex; align-items: flex-start; gap: 8px; margin: 0; font-size: 13px; font-weight: 700; line-height: 1.4; color: #9b4600; }
.ot-timeline__point svg { flex: none; margin-top: 1px; }
.ot-timeline__note { margin: 6px 0 0 24px; padding: 10px 14px; border-radius: 10px; background: #fff; font-size: 12px; font-style: italic; line-height: 1.4; color: #4d4d4d; }
.ot-timeline__cta { max-width: 700px; margin: 28px auto 0; }
@media screen and (min-width: 750px) {
  .ot-timeline { padding-inline: 46px; }
  .ot-timeline__heading { font-size: 52px; margin-bottom: 40px; }
  .ot-timeline__grid { grid-template-columns: 1.05fr 0.95fr; gap: 44px; align-items: start; }
  .ot-timeline__tabs { gap: 14px; }
  .ot-timeline__tab { min-height: 44px; }
  .ot-timeline__hint { justify-content: flex-start; margin-left: 6px; }
  .ot-timeline__cta { margin-top: 40px; }
}
{% endstylesheet %}

{% javascript %}
(() => {
  const init = () => document.querySelectorAll('[data-ot-tl]:not([data-ot-tl-ready])').forEach((root) => {
    root.setAttribute('data-ot-tl-ready', '');
    const tabs = [...root.querySelectorAll('[data-ot-tab]')];
    const panels = [...root.querySelectorAll('[data-ot-panel]')];
    const show = (n) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.otTab === n ? 'true' : 'false'));
      panels.forEach((p) => { p.hidden = p.dataset.otPanel !== n; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.otTab));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        next.focus(); show(next.dataset.otTab);
      });
    });
  });
  init(); document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Old Tom's timeline",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Here's Exactly What Happens Once You Place A Pouch" },
    { "type": "text", "id": "hint", "label": "Tab hint", "default": "Tap each box to see progress week by week" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset", "label": "Theme asset filename (used when no image is picked)", "default": "oldtoms-how-it-works.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Old Tom's pouch bag with a sachet, cinnamon, oil bottles and leaves" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show add to cart button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "cta_guarantee", "label": "Guarantee line", "default": "30-Day Money Back Guarantee" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        { "type": "text", "id": "tab", "label": "Tab label", "default": "HOURS 1–72" },
        { "type": "text", "id": "chip", "label": "Chip", "default": "HOUR 1-72" },
        { "type": "text", "id": "title", "label": "Title", "default": "Mice Back Off Straight Away" },
