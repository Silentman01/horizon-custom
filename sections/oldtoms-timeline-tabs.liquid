        { "type": "stage", "settings": { "tab": "HOURS 1–72", "chip": "HOUR 1-72", "title": "Mice Back Off Straight Away", "point_1": "Peppermint oil fires the trigeminal nerve on contact", "note_1": "A hardwired survival instinct kicks in — the brain screams \"predator\"", "point_2": "Pheromone trails completely scrambled", "note_2": "Mice can no longer find safe routes or talk to each other", "point_3": "Every entry point blocked", "note_3": "Each pouch makes a 65 sq ft invisible barrier — unlike traps that cover one spot" } },
