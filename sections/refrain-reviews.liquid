{% render 'refrain-fonts' %}
{%- assign dark = false -%}
{%- if section.settings.background == 'ink' -%}{%- assign dark = true -%}{%- endif -%}
<section class="rf-reviews rf-reviews--{{ section.settings.background }}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-reviews__inner">
    <div class="rf-reviews__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow{% if dark %} rf-reviews__eyebrow-dark{% endif %}">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {% render 'refrain-title', text: section.settings.heading, tag: 'h2', dark: dark %}
        {%- if section.settings.subheading != blank -%}<p class="rf-sub{% if dark %} rf-reviews__sub-dark{% endif %}">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      <div class="rf-reviews__nav">
        <button type="button" class="rf-reviews__arrow" data-rf-step="-1" aria-label="Précédent">{% render 'refrain-icon', name: 'chevron' %}</button>
        <button type="button" class="rf-reviews__arrow" data-rf-step="1" aria-label="Suivant">{% render 'refrain-icon', name: 'chevron' %}</button>
      </div>
    </div>
    {% render 'refrain-drag' %}
    <refrain-rail class="rf-reviews__rail">
      {%- for block in section.blocks -%}
        <article class="rf-review" {{ block.shopify_attributes }}>
          {% render 'refrain-media', image: block.settings.image, asset: block.settings.image_asset, ratio: '1 / 1', label: block.settings.alt, sizes: '(min-width: 750px) 340px, 78vw' %}
          <div class="rf-review__body">
            <div class="rf-review__stars" role="img" aria-label="{{ block.settings.stars }} sur 5">
              {%- for i in (1..5) -%}<span class="{% if i > block.settings.stars %}is-off{% endif %}">{% render 'refrain-icon', name: 'star' %}</span>{%- endfor -%}
            </div>
            <blockquote class="rf-review__quote">{{ block.settings.quote | escape }}</blockquote>
            <p class="rf-review__name">{{ block.settings.name | escape }}</p>
            {%- if block.settings.meta != blank -%}<p class="rf-review__meta">{{ block.settings.meta | escape }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </refrain-rail>
  </div>
</section>
{% stylesheet %}
  .rf-reviews { font-family: var(--rf-sans); padding: 56px 0; background: var(--rf-page); scroll-margin-top: 24px; }
  .rf-reviews--lilac { background: var(--rf-lilac); }
  .rf-reviews--ink { background: var(--rf-ink); }
  .rf-reviews__inner { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .rf-reviews__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .rf-reviews__eyebrow-dark, .rf-reviews__sub-dark { color: var(--rf-lilac); }
  .rf-reviews__nav { display: none; gap: 10px; }
  .rf-reviews__arrow { width: 48px; height: 48px; border-radius: 50%; border: 0; display: grid; place-items: center; cursor: pointer; background: var(--rf-ink); color: var(--rf-lime); transition: transform .15s; }
  .rf-reviews--ink .rf-reviews__arrow { background: var(--rf-lime); color: var(--rf-ink); }
  .rf-reviews__arrow:hover { transform: translateY(-1px); }
  .rf-reviews__arrow:focus-visible { outline: 3px solid var(--rf-violet); outline-offset: 3px; }
  .rf-reviews__arrow[data-rf-step="-1"] svg { transform: rotate(90deg); }
  .rf-reviews__arrow[data-rf-step="1"] svg { transform: rotate(-90deg); }
  .rf-reviews__rail { gap: 14px; margin: 0 -16px; padding: 4px 16px 24px; scroll-padding-left: 16px; }
  .rf-review { flex: 0 0 78%; max-width: 340px; background: var(--rf-card); border-radius: 22px; overflow: hidden; box-shadow: 0 10px 30px rgb(30 15 74 / .09); display: flex; flex-direction: column; }
  .rf-review__body { padding: 20px 20px 24px; display: flex; flex-direction: column; flex: 1; }
  .rf-review__stars { display: flex; gap: 2px; color: var(--rf-ink); }
  .rf-review__stars svg { width: 18px; height: 18px; display: block; }
  .rf-review__stars .is-off { opacity: .2; }
  .rf-review__quote { margin: 14px 0 18px; font-size: 16px; line-height: 1.55; color: var(--rf-ink); font-weight: 500; }
  .rf-review__name { margin: auto 0 0; font-weight: 800; color: var(--rf-ink); letter-spacing: -0.02em; }
  .rf-review__meta { margin: 2px 0 0; font-size: 14px; color: var(--rf-ink-soft); }
  @media (min-width: 750px) {
    .rf-reviews { padding: 96px 0; }
    .rf-reviews__inner { padding: 0 24px; }
    .rf-reviews__nav { display: flex; }
    .rf-reviews__rail { margin: 0 -24px; padding: 4px 24px 28px; scroll-padding-left: 24px; gap: 20px; }
    .rf-review { flex-basis: 340px; }
  }
{% endstylesheet %}
{% javascript %}
  document.addEventListener('click', (e) => {
    const b = e.target.closest('[data-rf-step]');
    if (!b) return;
    const rail = b.closest('.rf-reviews__inner')?.querySelector('refrain-rail');
    if (rail && rail.step) rail.step(Number(b.dataset.rfStep));
  });
{% endjavascript %}
{% schema %}
{
  "name": "Refrain · Reviews",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "page", "label": "Page" }, { "value": "lilac", "label": "Lilac" }, { "value": "ink", "label": "Ink" }], "default": "page" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ils ont offert une chanson" },
    { "type": "text", "id": "heading", "label": "Heading (wrap one word in *asterisks*)", "default": "Des *émotions* qu'on n'oublie pas" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Ce que disent celles et ceux qui ont offert leur chanson." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID (link target, e.g. #avis)", "default": "avis" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Camille" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Pour sa mère · Anniversaire" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Ma mère a pleuré dès les premières notes. Elle l'écoute encore chaque jour." },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme asset file name", "default": "refrain-review-1.jpg" },
        { "type": "text", "id": "alt", "label": "Image alt text", "default": "Un proche ému écoute sa chanson personnalisée" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refrain · Reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Sophie", "meta": "Pour son mari · 22 ans de mariage", "quote": "Éric dit toujours qu'il ne veut rien. Quand il a entendu son prénom dans le refrain, il a posé sa fourchette et m'a regardée sans rien dire.", "image_asset": "refrain-review-1.jpg" } },
        { "type": "review", "settings": { "name": "Julien", "meta": "Pour sa femme · 25 ans de mariage", "quote": "J'avais peur que ça fasse kitsch. Pas du tout. Son prénom dans le refrain, elle n'en revenait pas.", "image_asset": "refrain-review-2.jpg" } },
        { "type": "review", "settings": { "name": "Camille", "meta": "Pour sa mère · Anniversaire", "quote": "Ma mère a reconnu notre maison de Bretagne dès le deuxième couplet. Elle l'a réécoutée trois fois de suite.", "image_asset": "refrain-review-3.jpg" } },
        { "type": "review", "settings": { "name": "Martine", "meta": "Pour son mari · Noël", "quote": "Il n'est pas du genre à pleurer. J'ai écouté l'extrait avant de payer, pour être sûre. Le soir de Noël, il a dû sortir prendre l'air.", "image_asset": "refrain-review-4.jpg" } }
      ]
    }
  ]
}
{% endschema %}
