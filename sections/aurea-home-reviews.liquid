<section class="au-h au-h--parch" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-h-wrap">
    <div class="au-h-head ">
  {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {% render 'aurea-title', text: section.settings.heading, class: 'au-h-h2' %}
  {%- if section.settings.score_text != blank -%}<p class="au-h-rv__score"><span class="au-h-tp" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg></span><span>{{ section.settings.score_text }}</span></p>{%- endif -%}
</div>
    <div class="au-h-rv">
      {%- for block in section.blocks -%}
        <article class="au-h-rv__card" {{ block.shopify_attributes }}>
          <p class="au-h-rv__stars" aria-label="5 out of 5 stars"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="currentColor"/></svg></p>
          <h3>{{ block.settings.title }}</h3>
          <p class="au-h-rv__text">{{ block.settings.text }}</p>
          <footer>
            <div class="au-h-rv__av">{% render 'aurea-media', image: block.settings.avatar, ratio: '1 / 1', radius: 999, sizes: '46px', label: ' ' %}</div>
            <div><strong>{{ block.settings.name }}</strong><span><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 1.8 3-.2 1 2.8 2.5 1.7-.9 2.9.9 2.9-2.5 1.7-1 2.8-3-.2L12 22l-2.4-1.8-3 .2-1-2.8-2.5-1.7.9-2.9-.9-2.9 2.5-1.7 1-2.8 3 .2z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ block.settings.verified }}</span></div>
          </footer>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}
  .au-h { padding: 60px 0; font-family: var(--au-body); color: #2A2E29; background: #fff; }
  .au-h *, .au-h *::before, .au-h *::after { box-sizing: border-box; }
  .au-h--parch { background: var(--au-parchment); }
  .au-h--pine { background: var(--au-pine); }
  .au-h--dark { background: var(--au-espresso); }
  .au-h.au-h--dark, .au-h.au-h--pine, .au-h.au-h-hero { color: #fff; }
  .au-h-wrap { width: calc(100% - 32px); max-width: 1200px; margin-inline: auto; }
  .au-h-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .au-h-h2 { font-size: 31px; line-height: 1.08; }
  .au-h-sub { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.6; color: #4A5249; }
  .au-h-i { width: 1em; height: 1em; flex: none; }
  .au-h .au-icon { width: 1em; height: 1em; flex: none; }
  .au-h-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 0 32px; border-radius: 999px; background: var(--au-pine); color: var(--au-parchment); font-family: var(--au-body); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .au-h-btn:hover { filter: brightness(1.12); }
  .au-h-btn:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 3px; }
  .au-h-btn .au-h-i { font-size: 18px; }
  .au-h-btn--gold { background: var(--au-gold); color: #1E1A10; }
  .au-h-btn--ghost { background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.55); }
  .au-h-dark .au-title, .au-h--dark .au-title, .au-h--pine .au-title { color: #fff; }
  .au-h-dark .au-title em, .au-h--dark .au-title em, .au-h--pine .au-title em { color: #DDB866; }
  .au-h--dark .au-eyebrow, .au-h--pine .au-eyebrow { color: #DDB866; }
  .au-h-tp { display: inline-flex; gap: 2px; }
  .au-h-tp svg { width: 20px; height: 20px; padding: 3px; background: #00B67A; }
  .au-h-ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #f1f1f1, #dcdcdc); color: #6b6b6b; font-size: 12px; text-align: center; }
  @media (min-width: 750px) { .au-h { padding: 72px 0; } .au-h-wrap { width: calc(100% - 48px); } .au-h-head { margin-bottom: 56px; } .au-h-h2 { font-size: 36px; } .au-h-btn { width: auto; } }
  @media (min-width: 990px) { .au-h { padding: 96px 0; } .au-h-h2 { font-size: 44px; } }

  .au-h-rv__score { display: inline-flex; align-items: center; gap: 10px; margin: 20px 0 0; padding: 8px 18px; border: 1px solid var(--au-line); border-radius: 999px; background: #fff; font-size: 14px; }
  .au-h-rv { display: grid; gap: 16px; align-items: start; }
  .au-h-rv__card { display: flex; flex-direction: column; padding: 22px; border: 1px solid var(--au-line); border-radius: 6px; background: #fff; }
  .au-h-rv__stars { display: flex; gap: 2px; margin: 0 0 12px; color: var(--au-gold); }
  .au-h-rv__stars svg { width: 18px; height: 18px; }
  .au-h-rv__card h3 { margin: 0 0 10px; font-family: var(--au-heading); font-size: 19px; font-weight: 600; color: var(--au-pine); }
  .au-h-rv__text { margin: 0 0 22px; font-size: 15px; line-height: 1.65; color: #4A5249; }
  .au-h-rv__card footer { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--au-line); }
  .au-h-rv__av { flex: none; width: 46px; }
  .au-h-rv__card footer strong { display: block; font-size: 15px; font-weight: 700; }
  .au-h-rv__card footer span { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--au-pine); }
  .au-h-rv__card footer .au-h-i { font-size: 14px; }
  @media (min-width: 750px) { .au-h-rv { grid-template-columns: repeat(2, 1fr); gap: 24px; } .au-h-rv__card { padding: 28px; } }
  @media (min-width: 990px) { .au-h-rv { grid-template-columns: repeat(3, 1fr); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea home reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (*word* = gold italic)",
      "default": "Loved by *our wearers*"
    },
    {
      "type": "text",
      "id": "score_text",
      "label": "Score pill text",
      "default": "Excellent 4.8 out of 5"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar",
          "info": "Square 1:1 (120px+), shown at 46px round"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": ""
        },
        {
          "type": "text",
          "id": "verified",
          "label": "Verified label",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea home reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "The check I had written off",
            "text": "I retired early after a back injury ended my work, and I was living on Social Security, about $500 short every month. By day 16 of wearing the bracelet I had the energy to take on part-time consulting. Five days later a payment came in from an old business deal I had completely forgotten. $4,200!!",
            "name": "Richard T.",
            "verified": "Verified buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Everything started moving",
            "text": "Wow, so many results since I started wearing this! An unexpected refund check for $8K, a $12K tax return, new clients reaching out, less fear about my current job being my only option, and the freedom to travel. I just took a trip to Italy and Greece with no idea how the money and the time would work out, and it did!!",
            "name": "Marianne K.",
            "verified": "Verified buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "I never leave the house without it",
            "text": "A raise I had given up on came through the same week it arrived. I don't go anywhere without it now.",
            "name": "Dana L.",
            "verified": "Verified buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
