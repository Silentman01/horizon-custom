{%- render 'pawsorb-home-base' -%}
<section class="pawsorb-h pawsorb-ht" aria-label="{{ section.settings.heading | escape }}">
  <div class="pawsorb-h__wrap">
    <h2 class="pawsorb-h__h2 pawsorb-h__center">{{ section.settings.heading }}</h2>
    <div class="pawsorb-h__rail pawsorb-ht__grid">
      {%- for block in section.blocks -%}
        {%- capture ps_img -%}{%- render 'pawsorb-home-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, sizes: '(min-width: 750px) 25vw, 45vw' -%}{%- endcapture -%}
        <div class="pawsorb-ht__tile{% if forloop.first %} pawsorb-ht__tile--lead{% endif %}{% if ps_img != blank %} has-img{% endif %}" {{ block.shopify_attributes }}>
          {%- if ps_img != blank -%}
            <div class="pawsorb-h__media pawsorb-ht__media">{{ ps_img }}</div>
          {%- else -%}
            <div class="pawsorb-ht__icon">{%- render 'pawsorb-home-icon', name: block.settings.icon -%}</div>
          {%- endif -%}
          <p class="pawsorb-ht__name">{{ block.settings.title }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footer_line != blank -%}<p class="pawsorb-ht__line">{{ section.settings.footer_line }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
.pawsorb-ht__grid{margin-top:20px}
.pawsorb-ht__tile{width:42%;min-width:150px;background:#F1F6F3;border:1px solid #DCE6E0;border-radius:12px;padding:16px 12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;aspect-ratio:1/1}
.pawsorb-ht__tile.has-img{padding:0;overflow:hidden;justify-content:flex-start;background:#fff}
.pawsorb-ht__media{border-radius:0;width:100%;flex:1}
.pawsorb-ht__tile.has-img .pawsorb-ht__name{padding:10px}
.pawsorb-ht__icon{width:64px;height:64px;border-radius:50%;background:#fff;color:#12855A;display:grid;place-items:center;box-shadow:0 0 0 1px #DCE6E0}
.pawsorb-ht__icon svg{width:36px;height:36px}
.pawsorb-ht__tile--lead{background:#121614;border-color:#121614;color:#fff}
.pawsorb-ht__tile--lead .pawsorb-ht__icon{background:#12855A;color:#fff;box-shadow:none}
.pawsorb-ht__name{margin:0;font-weight:700;font-size:16px;line-height:1.25}
.pawsorb-ht__line{margin:20px auto 0;text-align:center;color:#5D6A63;font-size:15px;max-width:40em}
@media (min-width:750px){
  .pawsorb-h__rail.pawsorb-ht__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .pawsorb-ht__tile{width:auto;min-width:0;aspect-ratio:16/9}
  .pawsorb-ht__tile--lead{grid-row:span 2;aspect-ratio:auto}
  .pawsorb-ht__tile--lead .pawsorb-ht__icon{width:96px;height:96px}
  .pawsorb-ht__tile--lead .pawsorb-ht__icon svg{width:54px;height:54px}
  .pawsorb-ht__tile--lead .pawsorb-ht__name{font-size:22px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb home toxins",
  "tag": "div",
  "class": "pawsorb-home-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What your dog finds, PawSorb binds." },
    { "type": "textarea", "id": "footer_line", "label": "Line under the grid", "default": "Plus caffeine, THC, nicotine, onions and moldy food." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Toxin tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cane toads" },
        { "type": "select", "id": "icon", "label": "Icon (used without image)", "default": "toad", "options": [
          { "value": "toad", "label": "Toad" }, { "value": "chocolate", "label": "Chocolate" }, { "value": "grapes", "label": "Grapes" },
          { "value": "pills", "label": "Pills" }, { "value": "plant", "label": "Plant" }, { "value": "bait", "label": "Bait" }, { "value": "mushroom", "label": "Mushroom" } ] },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Fallback theme asset", "info": "e.g. pawsorb-toxin-chocolate.jpg. Empty = icon." }
      ]
    }
  ],
  "presets": [{ "name": "PawSorb home toxins", "blocks": [{ "type": "tile" }] }]
}
{% endschema %}
