{%- comment -%} Krino image banner ("Muy pronto en tu barbería"): full-bleed photo, dark overlay, centred heading + text. Prefix krino-barber. {%- endcomment -%}
{%- assign ss = section.settings -%}
<div
  class="krino-barber"
  style="--krino-barber-h: {{ ss.height }}vh; --krino-barber-h-m: {{ ss.height_mobile }}vh; --krino-barber-overlay: {{ ss.overlay_color }}; --krino-barber-opacity: {{ ss.overlay_opacity | divided_by: 100.0 }}; --krino-barber-text: {{ ss.text_color }}; --krino-barber-h-font: {{ ss.heading_font }}; --krino-barber-h-size: {{ ss.heading_size }}px; --krino-barber-h-size-m: {{ ss.heading_size_mobile }}px; --krino-barber-h-weight: {{ ss.heading_weight }}; --krino-barber-body: {{ ss.body_size }}px; --krino-barber-pos: {{ ss.image_position }}; --krino-barber-pt: {{ ss.padding_top }}px; --krino-barber-pb: {{ ss.padding_bottom }}px;"
>
  <div class="krino-barber__bg">
    {%- if ss.image != blank -%}
      {{ ss.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', alt: ss.heading }}
    {%- elsif ss.image_asset != blank -%}
      <img src="{{ ss.image_asset | asset_url }}" alt="{{ ss.heading | escape }}" loading="lazy" width="2752" height="1536" onerror="this.remove()">
    {%- endif -%}
  </div>
  <div class="krino-barber__content">
    {%- if ss.heading != blank -%}<h2 class="krino-barber__heading">{{ ss.heading }}</h2>{%- endif -%}
    {%- if ss.text != blank -%}<p class="krino-barber__text">{{ ss.text }}</p>{%- endif -%}
  </div>
</div>
{% stylesheet %}
  .krino-barber { position: relative; display: flex; align-items: center; justify-content: center; min-height: var(--krino-barber-h, 50vh); padding: var(--krino-barber-pt, 40px) 20px var(--krino-barber-pb, 40px); overflow: hidden; background: #111; color: var(--krino-barber-text, #fff); text-align: center; }
  .krino-barber__bg { position: absolute; inset: 0; }
  .krino-barber__bg img { width: 100%; height: 100%; object-fit: cover; object-position: var(--krino-barber-pos, center); }
  .krino-barber__bg::after { content: ''; position: absolute; inset: 0; background: var(--krino-barber-overlay, #000); opacity: var(--krino-barber-opacity, 0.5); }
  .krino-barber__content { position: relative; max-width: 760px; }
  .krino-barber__heading { margin: 0; font-family: var(--krino-barber-h-font, var(--font-heading--family)); font-size: var(--krino-barber-h-size, 32px); font-weight: var(--krino-barber-h-weight, 600); line-height: 1.25; color: inherit; }
  .krino-barber__text { margin: 10px 0 0; font-size: var(--krino-barber-body, 14px); line-height: 1.4; }
  @media screen and (max-width: 749px) {
    .krino-barber { min-height: var(--krino-barber-h-m, 50vh); }
    .krino-barber__heading { font-size: var(--krino-barber-h-size-m, 24px); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino image banner",
  "tag": "section",
  "class": "krino-barber-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_asset", "label": "Background theme asset (fallback file name)", "default": "krino-barberia.jpg" },
    { "type": "select", "id": "image_position", "label": "Image focus", "default": "center", "options": [
      { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Muy pronto en tu barbería" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Krino ya está en más de 100 barberías profesionales en todo México." },
    { "type": "header", "content": "Overlay and colors" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "var(--font-heading--family)", "options": [
      { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-accent--family)", "label": "Accent" }
    ] },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "600", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 16, "max": 64, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Size and spacing" },
    { "type": "range", "id": "height", "label": "Height (desktop, % of screen)", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile, % of screen)", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Krino image banner" }]
}
{% endschema %}
