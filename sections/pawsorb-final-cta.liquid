{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-fc" style="--pawsorb-fc-pt: {{ ss.padding_top }}px; --pawsorb-fc-pb: {{ ss.padding_bottom }}px; --pawsorb-fc-bg: {{ ss.bg_color }}; --pawsorb-fc-fg: {{ ss.text_color }}; --pawsorb-fc-accent: {{ ss.accent_color }};">
  <div class="pawsorb-fc__inner">
    <div class="pawsorb-fc__media">
      {% render 'pawsorb-media', image: ss.image, asset: ss.image_asset, alt: ss.image_alt, ratio: '4 / 3', icon: 'pack', tone: 'tint', sizes: '(min-width: 750px) 50vw, 100vw', anim_image: ss.anim_image, anim_asset: ss.anim_asset, anim_fit: 'contain' %}
    </div>
    <div class="pawsorb-fc__text">
      {%- if ss.heading != blank -%}<h2 class="pawsorb-fc__h">{{ ss.heading }}</h2>{%- endif -%}
      {%- if ss.line != blank -%}<p class="pawsorb-fc__l">{{ ss.line }}</p>{%- endif -%}
      {%- if ss.button_label != blank -%}
        <a class="pawsorb-fc__btn" href="{{ ss.button_link | default: '/products/pawsorb' }}" data-pawsorb-cta>{{ ss.button_label }}</a>
      {%- endif -%}
      {%- if ss.micro != blank -%}<p class="pawsorb-fc__m">{% render 'pawsorb-icon', name: 'shield', size: 16 %}<span>{{ ss.micro }}</span></p>{%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pawsorb-fc { padding: var(--pawsorb-fc-pt, 64px) 0 var(--pawsorb-fc-pb, 64px); background: var(--pawsorb-fc-bg, #121614); color: var(--pawsorb-fc-fg, #fff); }
  .pawsorb-fc__inner { max-width: 1100px; margin: 0 auto; padding: 0 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .pawsorb-fc__h { margin: 0 0 12px; font: 700 36px/1.12 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-fc__l { margin: 0 0 22px; font-size: 18px; line-height: 1.5; opacity: .88; }
  .pawsorb-fc__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 56px; padding: 0 36px; border-radius: 10px; background: var(--pawsorb-fc-accent, #12855A); color: #fff; font: 700 17px/1 var(--font-heading--family); text-decoration: none; letter-spacing: .02em; box-shadow: 0 8px 22px rgba(18, 133, 90, .35); }
  .pawsorb-fc__btn:hover { background: #0C5E40; }
  .pawsorb-fc__m { display: flex; align-items: center; gap: 8px; margin: 14px 0 0; font-size: 14px; opacity: .85; }
  @media screen and (max-width: 749px) {
    .pawsorb-fc { padding: calc(var(--pawsorb-fc-pt, 64px) * .75) 0 calc(var(--pawsorb-fc-pb, 64px) * .75); }
    .pawsorb-fc__inner { grid-template-columns: 1fr; gap: 20px; text-align: center; }
    .pawsorb-fc__h { font-size: 28px; }
    .pawsorb-fc__l { font-size: 16px; margin-bottom: 18px; }
    .pawsorb-fc__btn { width: 100%; }
    .pawsorb-fc__m { justify-content: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb final CTA",
  "tag": "section",
  "class": "pawsorb-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tonight, the plan is in the drawer." },
    { "type": "textarea", "id": "line", "label": "Line", "default": "Whoever left it out, whatever got swallowed, you get the first minute." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Protect my dog" },
    { "type": "url", "id": "button_link", "label": "Button link (pages without the picker)", "info": "On the product page the button scrolls to the bundle picker. Blank = /products/pawsorb" },
    { "type": "text", "id": "micro", "label": "Line under the button", "default": "90-day money-back guarantee" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Theme file", "default": "pawsorb-final-cta.jpg", "info": "File in assets/. Until it exists, a drawn PawSorb tube is shown." },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "PawSorb tube on a kitchen shelf with a dog resting behind it" },
    { "type": "image_picker", "id": "anim_image", "label": "Animation (looping WebP)" },
    { "type": "text", "id": "anim_asset", "label": "Animation theme file", "default": "pawsorb-anim-spin.webp", "info": "Shown over the image. Hidden for reduced motion or if the file is missing." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#121614" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Button", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "PawSorb final CTA" } ]
}
{% endschema %}
