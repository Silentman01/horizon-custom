{% render 'refrain-fonts' %}
<section class="rf-promise" data-bg="{{ section.settings.background }}" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-promise__inner">
    <div class="rf-promise__head">
      {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {% render 'refrain-title', text: section.settings.heading, dark: false %}
      {%- if section.settings.sub != blank -%}<p class="rf-sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <ul class="rf-promise__grid">
      {%- for block in section.blocks -%}
        <li class="rf-promise__card" {{ block.shopify_attributes }}>
          <span class="rf-promise__ic">{% render 'refrain-icon', name: block.settings.icon %}</span>
          <h3 class="rf-promise__t">{{ block.settings.title }}</h3>
          <p class="rf-promise__p">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% stylesheet %}
  .rf-promise { padding: 48px 16px; background: var(--rf-page); font-family: var(--rf-sans); }
  .rf-promise[data-bg='lilac'] { background: var(--rf-lilac); }
  .rf-promise[data-bg='ink'] { background: var(--rf-ink); }
  .rf-promise__inner { max-width: 1160px; margin: 0 auto; }
  .rf-promise__head { max-width: 640px; margin: 0 auto 32px; text-align: center; }
  .rf-promise[data-bg='ink'] .rf-promise__head .rf-title { color: #fff; }
  .rf-promise[data-bg='ink'] .rf-promise__head .rf-title em { color: var(--rf-lilac); }
  .rf-promise[data-bg='ink'] .rf-sub, .rf-promise[data-bg='ink'] .rf-eyebrow { color: #fff; }
  .rf-promise__grid { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; grid-template-columns: 1fr; }
  .rf-promise__card { padding: 26px 24px; border-radius: 22px; background: var(--rf-card); box-shadow: 0 8px 28px rgb(30 15 74 / .08); transition: transform .2s, box-shadow .2s; }
  .rf-promise__card:hover { transform: translateY(-3px); box-shadow: 0 16px 36px rgb(30 15 74 / .14); }
  .rf-promise__ic { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--rf-lilac); color: var(--rf-ink); }
  .rf-promise__ic .rf-icon { width: 26px; height: 26px; }
  .rf-promise__t { margin: 18px 0 6px; font-size: 18px; font-weight: 800; letter-spacing: -0.04em; color: var(--rf-ink); }
  .rf-promise__p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--rf-ink-soft); }
  @media (min-width: 600px) { .rf-promise__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 990px) { .rf-promise { padding: 88px 24px; } .rf-promise__head { margin-bottom: 48px; } .rf-promise__grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Refrain · Promise",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "page", "options": [ { "value": "page", "label": "Page" }, { "value": "lilac", "label": "Lilac" }, { "value": "ink", "label": "Ink" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Notre promesse" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = italic emphasis)", "default": "Ce que nous vous *promettons*" },
    { "type": "textarea", "id": "sub", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "item", "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "heart", "options": [
          { "value": "play", "label": "Play" }, { "value": "pause", "label": "Pause" }, { "value": "ear", "label": "Ear" }, { "value": "music", "label": "Music" }, { "value": "heart", "label": "Heart" }, { "value": "pen", "label": "Pen" }, { "value": "gift", "label": "Gift" }, { "value": "clock", "label": "Clock" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }, { "value": "shield", "label": "Shield" }, { "value": "check", "label": "Check" }, { "value": "x", "label": "X" }, { "value": "mail", "label": "Mail" }, { "value": "star", "label": "Star" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "arrow", "label": "Arrow" }, { "value": "chevron", "label": "Chevron" }, { "value": "mic", "label": "Microphone" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Unique" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Chaque chanson est écrite à partir de votre histoire." }
      ]
    }
  ],
  "presets": [
    { "name": "Refrain · Promise", "blocks": [
      { "type": "item", "settings": { "icon": "music", "title": "100% unique", "text": "Chaque chanson est composée à partir de votre histoire, jamais d'un modèle." } },
      { "type": "item", "settings": { "icon": "clock", "title": "Livrée rapidement", "text": "Vous recevez votre chanson par e-mail en quelques minutes." } },
      { "type": "item", "settings": { "icon": "refresh", "title": "Satisfait ou refait", "text": "Un détail à changer ? Nous la refaisons, simplement." } },
      { "type": "item", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "Vos informations sont protégées à chaque étape." } }
    ] }
  ]
}
{% endschema %}
