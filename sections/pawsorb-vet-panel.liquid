{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-vp" style="--pawsorb-vp-pt: {{ ss.padding_top }}px; --pawsorb-vp-pb: {{ ss.padding_bottom }}px; --pawsorb-vp-bg: {{ ss.bg_color }}; --pawsorb-vp-fg: {{ ss.text_color }};">
  <div class="pawsorb-vp__inner">
    {%- if ss.heading != blank -%}<h2 class="pawsorb-vp__h">{{ ss.heading }}</h2>{%- endif -%}
    <div class="pawsorb-vp__rail" data-pawsorb-rail>
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <figure class="pawsorb-vp__card" {{ block.shopify_attributes }}>
          <div class="pawsorb-vp__avatar">
            {% render 'pawsorb-media', image: bs.image, asset: bs.image_asset, alt: ss.icon_alt, ratio: '1 / 1', icon: 'vet', tone: 'navy', sizes: '72px' %}
          </div>
          <figcaption class="pawsorb-vp__who">
            <strong>{{ bs.role }}</strong>
            {%- if bs.years != blank -%}<span>{{ bs.years }}</span>{%- endif -%}
            <span class="pawsorb-vp__stars" aria-label="5 out of 5 stars">{%- for i in (1..5) -%}{% render 'pawsorb-icon', name: 'star', size: 13 %}{%- endfor -%}</span>
          </figcaption>
          <blockquote class="pawsorb-vp__q">{{ bs.quote }}</blockquote>
        </figure>
      {%- endfor -%}
    </div>
    {%- if ss.credential_row != blank -%}
      <ul class="pawsorb-vp__creds">
        {%- assign creds = ss.credential_row | split: '·' -%}
        {%- for c in creds -%}
          {%- assign ct = c | strip -%}
          {%- case forloop.index -%}{%- when 1 -%}{%- assign ic = 'flask' -%}{%- when 2 -%}{%- assign ic = 'flag' -%}{%- else -%}{%- assign ic = 'shield' -%}{%- endcase -%}
          {%- if ct != blank -%}<li>{% render 'pawsorb-icon', name: ic, size: 18 %}<span>{{ ct }}</span></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-vp { padding: var(--pawsorb-vp-pt, 64px) 0 var(--pawsorb-vp-pb, 64px); background: var(--pawsorb-vp-bg, #F1F6F3); color: var(--pawsorb-vp-fg, #141816); }
  .pawsorb-vp__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-vp__h { margin: 0 0 26px; text-align: center; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-vp__rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pawsorb-vp__card { margin: 0; padding: 22px; border-radius: 12px; background: #fff; border: 1px solid #DCE6E0; display: grid; grid-template-columns: 64px 1fr; grid-template-rows: auto 1fr; gap: 14px; align-items: center; }
  .pawsorb-vp__avatar { width: 64px; }
  .pawsorb-vp__avatar .pawsorb-media { --pawsorb-media-radius: 50%; }
  .pawsorb-vp__avatar .pawsorb-media__badge { width: 70%; max-width: none; background: transparent; box-shadow: none; }
  .pawsorb-vp__avatar .pawsorb-media__badge .pawsorb-icon { width: 60%; }
  .pawsorb-vp__who { display: flex; flex-direction: column; gap: 2px; font-size: 13px; color: #5D6A63; }
  .pawsorb-vp__who strong { font: 700 15px/1.3 var(--font-heading--family); color: #121614; }
  .pawsorb-vp__stars { display: inline-flex; gap: 1px; color: #F5B400; margin-top: 2px; }
  .pawsorb-vp__q { grid-column: 1 / -1; align-self: start; margin: 0; font-size: 15px; line-height: 1.55; color: #141816; }
  .pawsorb-vp__q::before { content: "\201C"; color: #12855A; font: 700 28px/0 var(--font-heading--family); vertical-align: -10px; margin-right: 2px; }
  .pawsorb-vp__creds { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin: 24px 0 0; padding: 0; }
  .pawsorb-vp__creds li { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: #121614; }
  .pawsorb-vp__creds .pawsorb-icon { color: #12855A; flex: 0 0 auto; }
  @media screen and (max-width: 749px) {
    .pawsorb-vp { padding: calc(var(--pawsorb-vp-pt, 64px) * .75) 0 calc(var(--pawsorb-vp-pb, 64px) * .75); }
    .pawsorb-vp__h { font-size: 26px; margin-bottom: 18px; }
    .pawsorb-vp__rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; gap: 12px; margin: 0 -16px; padding: 0 16px; cursor: grab; overscroll-behavior-x: contain; }
    .pawsorb-vp__rail::-webkit-scrollbar { display: none; }
    .pawsorb-vp__rail.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
    .pawsorb-vp__card { flex: 0 0 82%; scroll-snap-align: start; padding: 18px; }
    .pawsorb-vp__creds { flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 18px; }
    .pawsorb-vp__creds li { font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb vet panel",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "vet",
      "name": "Vet card",
      "settings": [
        { "type": "text", "id": "role", "label": "Role", "default": "Emergency & critical care vet" },
        { "type": "text", "id": "years", "label": "Experience", "default": "14 yrs" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Most poisonings I see started at home an hour earlier. A binder given in that first hour is the best head start a dog can get." },
        { "type": "image_picker", "id": "image", "label": "Portrait", "info": "Real advisors only. Without a portrait a vet icon is shown." },
        { "type": "text", "id": "image_asset", "label": "Portrait theme file", "info": "File in assets/, e.g. pawsorb-vet-1.jpg. Leave blank until you have a real portrait." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Checked by the vets who see these nights" },
    { "type": "text", "id": "credential_row", "label": "Credential row", "default": "3rd-party lab tested · Made in the USA · FDA-registered, cGMP facility", "info": "Separate items with ·" },
    { "type": "text", "id": "icon_alt", "label": "Icon alt text", "default": "Veterinarian icon" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F1F6F3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb vet panel",
      "blocks": [
        { "type": "vet", "settings": { "role": "Emergency & critical care vet", "years": "14 yrs" } },
        { "type": "vet", "settings": { "role": "General practice vet, small animals", "years": "11 yrs", "quote": "Owners panic and reach for peroxide. A premixed, pre-dosed gel is the calmer, safer first move." } },
        { "type": "vet", "settings": { "role": "Shelter medicine vet, Gulf Coast", "years": "9 yrs", "quote": "Down here, toads are a weekly case. Every dog home in Florida should have this by the back door." } }
      ]
    }
  ]
}
{% endschema %}
