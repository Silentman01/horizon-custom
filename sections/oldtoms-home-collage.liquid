{%- assign s = section.settings -%}
<section class="ot-home-collage" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <h2 class="ot-home-collage__heading">{{ s.heading }}</h2>
  <div class="ot-home-collage__grid">
    <div class="ot-home-collage__photos">
      {%- for block in section.blocks -%}
        <div class="ot-home-collage__photo" {{ block.shopify_attributes }}>
          {% render 'oldtoms-media', image: block.settings.image, asset: block.settings.asset, ratio: '4 / 5', alt: block.settings.alt %}
        </div>
      {%- endfor -%}
    </div>
    <div class="ot-home-collage__cards" data-ot-drag>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="ot-home-collage__card">
          <div class="ot-home-collage__top"><h3 class="ot-home-collage__title">{{ b.title }}</h3><span class="ot-home-collage__stars" aria-label="5 out of 5 stars">★★★★★</span></div>
          <p class="ot-home-collage__text">{{ b.text }}</p>
          <p class="ot-home-collage__who"><strong>- {{ b.name }}{% if b.location != blank %}, {{ b.location }}{% endif %}</strong> <span class="ot-home-collage__verified">&#10003; {{ s.verified_label }}</span></p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% render 'oldtoms-home-drag' %}

{% stylesheet %}
.ot-home-collage { background: var(--ot-bg); padding: var(--ot-pt) 0 var(--ot-pb); font-family: var(--ot-font); color: #121212; }
.ot-home-collage__heading { margin: 0 0 24px; padding-inline: 16px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 32px; line-height: 1.15; color: var(--ot-green); }
.ot-home-collage__grid { display: flex; flex-direction: column; gap: 14px; max-width: 1384px; margin: 0 auto; }
.ot-home-collage__photos { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding-inline: 16px; }
.ot-home-collage__photo { border-radius: 6px; overflow: hidden; }
.ot-home-collage__cards { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; padding: 2px 16px 6px; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
.ot-home-collage__cards::-webkit-scrollbar { display: none; }
.ot-home-collage__cards.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
.ot-home-collage__card { flex: 0 0 clamp(250px, 82vw, 340px); scroll-snap-align: start; display: flex; flex-direction: column; gap: 10px; background: #F9FAFB; border: 1px solid #9CA3AF; border-radius: 6px; box-shadow: 1px 2px 3px rgba(0, 0, 0, 0.15); padding: 16px; }
.ot-home-collage__top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.ot-home-collage__title { margin: 0; font-family: var(--ot-font); font-weight: 700; font-size: 13px; }
.ot-home-collage__stars { color: #F5A623; font-size: 13px; letter-spacing: 1px; white-space: nowrap; }
.ot-home-collage__text { margin: 0; flex: 1; font-size: 12px; line-height: 1.5; }
.ot-home-collage__who { margin: 0; display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12px; }
.ot-home-collage__verified { color: #3A9B5C; font-size: 11px; white-space: nowrap; }
@media screen and (min-width: 990px) {
  .ot-home-collage__heading { font-size: 42px; }
  .ot-home-collage__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 30px; padding-inline: 28px; align-items: start; }
  .ot-home-collage__photos { padding-inline: 0; gap: 10px; }
  .ot-home-collage__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; overflow: visible; padding: 0; cursor: auto; }
  .ot-home-collage__card { flex: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's review collage",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "verified_label", "label": "Verified badge", "default": "Verified Buyer" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "asset", "label": "Photo: theme file", "info": "Used when no image is uploaded." },
        { "type": "text", "id": "alt", "label": "Photo alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Works instantly!" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "I used the Critter Control Spray round the patio and kitchen. It works so fast and there's no harsh chemical smell left behind. Highly recommend!" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ryan S." },
        { "type": "text", "id": "location", "label": "Location", "default": "Swindon" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Old Tom's review collage",
      "blocks": [
        { "type": "review", "settings": { "asset": "oldtoms-testimonial-photo-01.jpg", "alt": "Man on a patio with the spray bottle" } },
        { "type": "review", "settings": { "asset": "oldtoms-testimonial-photo-02.jpg", "alt": "Pouches along a garage skirting board", "title": "Finally, peace of mind!", "text": "We had a bit of a mouse problem in the garage. Dropped a few pouches by the skirting and the problem vanished completely. So glad it's natural and safe.", "name": "James D.", "location": "Chester" } }
      ]
    }
  ]
}
{% endschema %}
