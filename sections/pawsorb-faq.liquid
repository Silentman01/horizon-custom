{%- assign ss = section.settings -%}
<div class="pawsorb-faq" style="--pawsorb-faq-pt: {{ ss.padding_top }}px; --pawsorb-faq-pb: {{ ss.padding_bottom }}px; --pawsorb-faq-bg: {{ ss.bg_color }}; --pawsorb-faq-fg: {{ ss.text_color }}; --pawsorb-faq-accent: {{ ss.accent_color }};">
  <div class="pawsorb-faq__inner">
    {%- if ss.heading != blank -%}<h2 class="pawsorb-faq__h">{{ ss.heading }}</h2>{%- endif -%}
    <div class="pawsorb-faq__list">
      {%- for block in section.blocks -%}
        <details class="pawsorb-faq__item" name="pawsorb-faq-{{ section.id }}" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="pawsorb-faq__q"><span>{{ block.settings.question }}</span><span class="pawsorb-faq__ic" aria-hidden="true">{% render 'pawsorb-icon', name: 'plus', size: 18 %}</span></summary>
          <div class="pawsorb-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pawsorb-faq { padding: var(--pawsorb-faq-pt, 64px) 0 var(--pawsorb-faq-pb, 64px); background: var(--pawsorb-faq-bg, #fff); color: var(--pawsorb-faq-fg, #141816); }
  .pawsorb-faq__inner { max-width: 800px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-faq__h { margin: 0 0 24px; text-align: center; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-faq__list { display: grid; gap: 10px; }
  .pawsorb-faq__item { border: 1px solid #DCE6E0; border-radius: 12px; background: #fff; overflow: hidden; }
  .pawsorb-faq__item[open] { border-color: #C6D4CB; }
  .pawsorb-faq__q { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 18px 20px; cursor: pointer; list-style: none; font: 700 17px/1.35 var(--font-heading--family); }
  .pawsorb-faq__q::-webkit-details-marker { display: none; }
  .pawsorb-faq__q:focus-visible { outline: 2px solid #121614; outline-offset: -2px; }
  .pawsorb-faq__ic { flex: 0 0 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #F1F6F3; color: var(--pawsorb-faq-accent, #12855A); transition: transform .2s; }
  .pawsorb-faq__item[open] .pawsorb-faq__ic { transform: rotate(45deg); }
  .pawsorb-faq__a { padding: 0 20px 18px; font-size: 16px; line-height: 1.6; color: #3A443F; }
  .pawsorb-faq__a p { margin: 0 0 8px; }
  .pawsorb-faq__a p:last-child { margin: 0; }
  @media screen and (max-width: 749px) {
    .pawsorb-faq { padding: calc(var(--pawsorb-faq-pt, 64px) * .75) 0 calc(var(--pawsorb-faq-pb, 64px) * .75); }
    .pawsorb-faq__h { font-size: 26px; margin-bottom: 18px; }
    .pawsorb-faq__q { padding: 16px; font-size: 16px; }
    .pawsorb-faq__a { padding: 0 16px 16px; font-size: 15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb FAQ",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 16,
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What if I never use it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>That's the best outcome. It's good for 2 years, and you have 90 days to return it for a full refund.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you add it to your cart" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Icon color", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Will it get here before I need it?", "answer": "<p>We ship fast from the US with tracking on every order. Order now and it's in the drawer before the next scare.</p>" } },
        { "type": "question", "settings": { "question": "What if I never use it?" } },
        { "type": "question", "settings": { "question": "Should I still call the vet?", "answer": "<p>Always. Give PawSorb first so you're not losing the window on hold, then phone your vet or a poison line.</p>" } }
      ]
    }
  ]
}
{% endschema %}
