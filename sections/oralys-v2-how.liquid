{%- render 'oralys-v2-base' -%}
{%- assign s = section.settings -%}
<section class="ov2 ov2-sec ov2-how" style="--ov2-bg:{{ s.c_bg }}">
  <div class="ov2-in">
    <h2 class="ov2-h2 ov2-center">{{ s.heading }}</h2>
    <ol class="ov2-how__steps" role="list">
      {%- for n in (1..3) -%}
        {%- liquid
          assign ki = 'image_' | append: n
          assign ka = 'asset_' | append: n
          assign kt = 'title_' | append: n
          assign kb = 'body_' | append: n
          if s[kt] == blank
            continue
          endif
        -%}
        <li class="ov2-how__step">
          <div class="ov2-how__media">{% render 'oralys-pdp-media', image: s[ki], asset: s[ka], alt: s[kt], class: 'ov2-how__img', width: 800, height: 600 %}<span class="ov2-how__n" aria-hidden="true">{{ n }}</span></div>
          <h3>{{ s[kt] }}</h3>
          <p>{{ s[kb] }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.remove_title != blank -%}
    <div class="ov2-how__rm">
      <span class="ov2-how__rmimg">{% render 'oralys-pdp-media', image: s.remove_image, asset: s.remove_asset, alt: s.remove_title, class: 'ov2-how__img', width: 200, height: 200 %}</span>
      <div><h3>{{ s.remove_title }}</h3><p>{{ s.remove_body }}</p></div>
    </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.ov2-how__steps{list-style:none;margin:0;padding:0;display:grid;gap:26px}
.ov2-how__media{position:relative;aspect-ratio:4/3;border-radius:14px;overflow:visible;margin-bottom:28px}
.ov2-how__media .ov2-how__img{border-radius:14px}
.ov2-how__img{width:100%;height:100%;object-fit:cover;display:block;background:#EEF6F1}
.ov2-how__n{position:absolute;left:14px;bottom:-20px;width:40px;height:40px;border-radius:50%;background:#0E6B50;color:#fff;border:3px solid #fff;font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center}
.ov2-how__step h3,.ov2-how__rm h3{margin:0 0 4px;font-size:19px;font-weight:700;line-height:1.3}
.ov2-how__step p,.ov2-how__rm p{font-size:16px;line-height:1.5}
.ov2-how__rm{display:flex;align-items:center;gap:16px;margin-top:26px;padding:14px;border:1px solid #DCE5E0;border-radius:12px;background:#F7FAF8}
.ov2-how__rmimg{flex:0 0 96px;width:96px;height:96px;border-radius:12px;overflow:hidden}
@media (min-width:750px){.ov2-how__steps{grid-template-columns:repeat(3,1fr);gap:24px}.ov2-how__rm{max-width:820px;margin:32px auto 0}}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : mode d'emploi",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "3 gestes le matin, tranquille 2 à 3 jours" },
    { "type": "image_picker", "id": "image_1", "label": "Étape 1 : image" },
    { "type": "text", "id": "asset_1", "label": "Étape 1 : fichier du thème", "default": "oralys-pdp-step-1.webp" },
    { "type": "text", "id": "title_1", "label": "Étape 1 : titre", "default": "Chauffer" },
    { "type": "textarea", "id": "body_1", "label": "Étape 1 : texte", "default": "Plongez le tube une minute dans un bol d'eau chaude, 60 °C maximum. Le gel devient souple comme une pâte à modeler." },
    { "type": "image_picker", "id": "image_2", "label": "Étape 2 : image" },
    { "type": "text", "id": "asset_2", "label": "Étape 2 : fichier du thème", "default": "oralys-pdp-step-2.webp" },
    { "type": "text", "id": "title_2", "label": "Étape 2 : titre", "default": "Étaler" },
    { "type": "textarea", "id": "body_2", "label": "Étape 2 : texte", "default": "Déposez dans le creux du dentier propre et sec une boule de gel de la taille d'une cerise." },
    { "type": "image_picker", "id": "image_3", "label": "Étape 3 : image" },
    { "type": "text", "id": "asset_3", "label": "Étape 3 : fichier du thème", "default": "oralys-pdp-step-3.webp" },
    { "type": "text", "id": "title_3", "label": "Étape 3 : titre", "default": "Mordre" },
    { "type": "textarea", "id": "body_3", "label": "Étape 3 : texte", "default": "Remettez le dentier et serrez doucement pendant une minute. Le gel prend l'empreinte de votre gencive et se raffermit." },
    { "type": "header", "content": "Retrait" },
    { "type": "image_picker", "id": "remove_image", "label": "Image" },
    { "type": "text", "id": "remove_asset", "label": "Fichier du thème", "default": "oralys-pdp-peel-out.webp" },
    { "type": "text", "id": "remove_title", "label": "Titre", "default": "Pour le retirer" },
    { "type": "textarea", "id": "remove_body", "label": "Texte", "default": "Glissez l'ongle sous le bord : le gel se décolle d'un seul morceau. Un coup de brosse, et votre dentier est propre." },
    { "type": "color", "id": "c_bg", "label": "Fond", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Oralys v2 : mode d'emploi" }]
}
{% endschema %}
