{%- liquid
  assign s = section.settings
  assign sets = '1,2,3,4' | split: ','
-%}
<div class="ot-proof" style="{% render 'oldtoms-vars' %}--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <div class="ot-proof__head">
    <div class="ot-proof__stars" role="img" aria-label="5 out of 5 stars">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 2.8l2.7 5.7 6.2.8-4.6 4.3 1.2 6.2L12 16.7 6.5 19.8l1.2-6.2L3.1 9.3l6.2-.8z" fill="#CCF46F" stroke="#24433D" stroke-width="1.4" stroke-linejoin="round"/></svg>
      {%- endfor -%}
    </div>
    <h2 class="ot-proof__title"><span class="ot-proof__num">{{ s.number }}</span> <span class="ot-proof__label">{{ s.label }}</span></h2>
  </div>

  <div class="ot-proof__rail" data-ot-drag data-ot-marquee data-ot-speed="0.45">
    {%- for n in sets -%}
      <ul class="ot-proof__set" data-ot-set{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- for block in section.blocks -%}
          <li class="ot-proof__card" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
            {% render 'oldtoms-media', image: block.settings.image, asset: block.settings.asset, ratio: '4 / 5', alt: block.settings.alt, sizes: '170px' %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
  <div class="ot-proof__rail ot-proof__rail--b" data-ot-drag data-ot-marquee data-ot-dir="rev" data-ot-speed="0.45" aria-hidden="true">
    {%- for n in sets -%}
      <ul class="ot-proof__set" data-ot-set>
        {%- for block in section.blocks reversed -%}
          <li class="ot-proof__card">
            {% render 'oldtoms-media', image: block.settings.image, asset: block.settings.asset, ratio: '4 / 5', alt: '', sizes: '110px' %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.ot-proof { background: #f4f4f0; color: #23372b; font-family: var(--ot-font); padding: var(--ot-pt, 40px) 0 var(--ot-pb, 40px); overflow: hidden; }
.ot-proof__head { text-align: center; padding-inline: 16px; margin-bottom: 24px; }
.ot-proof__stars { display: flex; justify-content: center; gap: 2px; margin-bottom: 10px; }
.ot-proof__title { margin: 0; font-weight: 400; display: flex; flex-direction: column; align-items: center; }
.ot-proof__num { font-family: var(--ot-font-heading); font-size: 64px; line-height: 1; color: #23372b; }
.ot-proof__label { font-family: var(--ot-font); font-size: 24px; line-height: 1.2; color: #121212; margin-top: 6px; }
.ot-proof__rail { display: flex; overflow-x: auto; scrollbar-width: none; cursor: grab; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
.ot-proof__rail::-webkit-scrollbar { display: none; }
.ot-proof__rail.is-dragging { cursor: grabbing; user-select: none; }
.ot-proof__rail--b { margin-top: 8px; }
.ot-proof__set { display: flex; flex: none; gap: 8px; margin: 0; padding: 0 8px 0 0; list-style: none; }
.ot-proof__card { flex: none; width: 104px; border: 1px solid #7fa93f; border-radius: 6px; overflow: hidden; user-select: none; }
.ot-proof__card img { -webkit-user-drag: none; pointer-events: none; }
@media screen and (min-width: 750px) {
  .ot-proof__head { margin-bottom: 40px; }
  .ot-proof__title { flex-direction: row; justify-content: center; gap: 0.3em; font-family: var(--ot-font-heading); font-size: 40px; line-height: 1.1; }
  .ot-proof__num, .ot-proof__label { font-family: var(--ot-font-heading); font-size: 40px; line-height: 1.1; color: #23372b; margin: 0; }
  .ot-proof__rail--b { display: none; }
  .ot-proof__card { width: 166px; }
}
{% endstylesheet %}

{% javascript %}
(() => {
  /* mouse/pen drag for horizontal rails; touch keeps native swipe */
  const init = () => document.querySelectorAll('[data-ot-drag]:not([data-ot-drag-ready])').forEach((rail) => {
    rail.setAttribute('data-ot-drag-ready', '');
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.classList.add('is-dragging'); try { rail.setPointerCapture(id); } catch (err) { /* ignore */ } }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.classList.remove('is-dragging');
      rail.scrollLeft = left;
      if (rail.hasAttribute('data-ot-snap')) {
        const card = rail.firstElementChild;
        const step = card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(rail).columnGap || 0) : 0;
        if (step) rail.scrollTo({ left: Math.round(left / step) * step, behavior: 'smooth' });
      }
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  });
  init();
  document.addEventListener('shopify:section:load', init);
})();
(() => {
  /* auto-scrolling rails: pause on hover, touch, drag and wheel; draggable and swipeable; loops over repeated sets */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wide = window.matchMedia('(min-width: 750px)');
  const start = (rail) => {
    const dir = rail.dataset.otDir === 'rev' ? -1 : 1;
    const speed = parseFloat(rail.dataset.otSpeed || '0.5');
    const mobileOnly = rail.hasAttribute('data-ot-mobile-only');
    let hover = false, last = 0, running = false, pos = 0, primed = false;
    const span = () => {
      const sets = rail.querySelectorAll('[data-ot-set]');
      return sets.length > 1 ? sets[1].offsetLeft - sets[0].offsetLeft : 0;
    };
    const touch = () => { last = performance.now(); };
    rail.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    rail.addEventListener('pointerleave', () => { hover = false; });
    ['pointerdown', 'touchstart', 'touchmove', 'wheel', 'keydown', 'focusin'].forEach((ev) => rail.addEventListener(ev, touch, { passive: true }));
    const tick = () => {
      requestAnimationFrame(tick);
      if (reduce.matches || (mobileOnly && wide.matches)) { running = false; return; }
      const s = span();
      if (!s || rail.scrollWidth <= rail.clientWidth) return;
      if (!primed) { primed = true; if (dir < 0) rail.scrollLeft = s; }
      const idle = !hover && !rail.classList.contains('is-dragging') && performance.now() - last > 2200;
      if (!idle) { running = false; return; }
      if (!running) { running = true; pos = rail.scrollLeft; }
      pos += dir * speed;
      if (pos >= s) pos -= s;
      if (pos <= 0 && dir < 0) pos += s;
      rail.scrollLeft = pos;
    };
    requestAnimationFrame(tick);
  };
  const init = () => document.querySelectorAll('[data-ot-marquee]:not([data-ot-marquee-ready])').forEach((rail) => {
    rail.setAttribute('data-ot-marquee-ready', '');
    start(rail);
  });
  init();
  document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Old Tom's proof marquee",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "number", "label": "Big number", "default": "35,129+" },
    { "type": "text", "id": "label", "label": "Label", "default": "Properties Protected" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Photo tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "asset", "label": "Theme asset filename (used when no image is picked)", "default": "oldtoms-proof-video-01.jpg" },
        { "type": "text", "id": "alt", "label": "Image description", "default": "Customer holding the Old Tom's pouch bag" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Old Tom's proof marquee",
      "blocks": [
        { "type": "tile", "settings": { "asset": "oldtoms-proof-video-01.jpg", "alt": "Customer with the pouch under the kitchen sink" } },
        { "type": "tile", "settings": { "asset": "oldtoms-proof-video-02.jpg", "alt": "Customer with the pouch in the shed" } },
        { "type": "tile", "settings": { "asset": "oldtoms-proof-video-03.jpg", "alt": "Customer with the pouch on the caravan step" } },
        { "type": "tile", "settings": { "asset": "oldtoms-proof-video-04.jpg", "alt": "Customer with the pouch behind the fridge" } }
      ]
    }
  ]
}
{% endschema %}
