{%- assign s = section.settings -%}
<section class="ot-home-support" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-card:{{ s.card_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <div class="ot-home-support__card">
    <div class="ot-home-support__head">
      <div class="ot-home-support__avatar">{% render 'oldtoms-media', image: s.avatar, asset: s.avatar_asset, ratio: '1 / 1', alt: s.heading %}</div>
      <h2 class="ot-home-support__heading">{{ s.heading }}</h2>
    </div>
    <p class="ot-home-support__body">{{ s.body }}</p>
    <a class="ot-home-support__button" href="{{ s.button_link | default: '/pages/contact' }}">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
      <span>{{ s.button_label }}</span>
    </a>
    {%- if s.hours != blank -%}<p class="ot-home-support__hours">{{ s.hours }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
.ot-home-support { background: var(--ot-bg); padding: var(--ot-pt) 16px var(--ot-pb); font-family: var(--ot-font); }
.ot-home-support__card { max-width: 650px; margin: 0 auto; background: var(--ot-card); border-radius: 20px; padding: 24px 22px; display: flex; flex-direction: column; gap: 14px; text-align: center; align-items: center; }
.ot-home-support__head { display: flex; align-items: center; gap: 14px; text-align: left; }
.ot-home-support__avatar { flex: none; width: 60px; height: 60px; border-radius: 50%; overflow: hidden; }
.ot-home-support__heading { margin: 0; font-family: var(--ot-font-heading); font-weight: 400; font-size: 26px; line-height: 1.15; color: var(--ot-green); }
.ot-home-support__body { margin: 0; font-size: 13px; line-height: 1.5; }
.ot-home-support__button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; max-width: 416px; height: 42px; border-radius: 20px; background: var(--ot-green); color: #fff; font-size: 13px; text-decoration: underline; }
.ot-home-support__hours { margin: 0; font-size: 11px; color: #707070; }
@media screen and (min-width: 750px) {
  .ot-home-support__card { padding: 30px 40px; }
  .ot-home-support__heading { font-size: 34px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's support card",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still Need Help? Contact Us" },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Our experts are here to help — from placement tips to picking the right pack size." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Us" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Blank = /pages/contact." },
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Our customer support is open Monday to Friday, 8am–8pm." },
    { "type": "image_picker", "id": "avatar", "label": "Avatar" },
    { "type": "text", "id": "avatar_asset", "label": "Avatar: theme file", "default": "oldtoms-support-agent.jpg", "info": "Used when no image is uploaded." },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card colour", "default": "#F0F0E6" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 24, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "presets": [ { "name": "Old Tom's support card" } ]
}
{% endschema %}
