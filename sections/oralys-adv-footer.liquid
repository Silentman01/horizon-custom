{%- liquid
  assign s = section.settings
-%}
{%- style -%}
  .oralys-adv-ft-{{ section.id }} {
    background: {{ s.color_bg }};
    color: {{ s.color_text }};
    padding-top: {{ s.pad_top_mobile }}px;
    padding-bottom: {{ s.pad_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    .oralys-adv-ft-{{ section.id }} { padding-top: {{ s.pad_top }}px; padding-bottom: {{ s.pad_bottom }}px; }
  }
{%- endstyle -%}
<footer class="oralys-adv-ft oralys-adv-ft-{{ section.id }}">
  <div class="oralys-adv-ft__in">
    {%- if s.publication_name != blank -%}<p class="oralys-adv-ft__pub">{{ s.publication_name }}</p>{%- endif -%}
    {%- if s.text != blank -%}<div class="oralys-adv-ft__txt">{{ s.text }}</div>{%- endif -%}
    {%- if s.links != blank -%}<div class="oralys-adv-ft__links">{{ s.links }}</div>{%- endif -%}
    {%- if s.copyright != blank -%}<p class="oralys-adv-ft__copy">{{ s.copyright }}</p>{%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .oralys-adv-ft__in { max-width: var(--oralys-adv-measure, 700px); margin: 0 auto; padding: 0 16px; font-size: 13px; line-height: 1.55; }
  .oralys-adv-ft__pub { margin: 0 0 10px; font-family: var(--oralys-adv-font-head); font-weight: var(--oralys-adv-font-head-weight, 700); font-size: 20px; }
  .oralys-adv-ft__txt p { margin: 0 0 0.8em; opacity: 0.85; }
  .oralys-adv-ft__links p { margin: 8px 0; }
  .oralys-adv-ft__links a { color: inherit; text-decoration: underline; margin-right: 12px; }
  .oralys-adv-ft__copy { margin: 12px 0 0; opacity: 0.65; }
{% endstylesheet %}

{% schema %}
{
  "name": "Adv · Article footer",
  "tag": "section",
  "class": "oralys-adv-ft-section",
  "settings": [
    { "type": "text", "id": "publication_name", "label": "Publication name" },
    { "type": "richtext", "id": "text", "label": "Disclaimer", "default": "<p>Cet article est une publicité.</p>" },
    { "type": "richtext", "id": "links", "label": "Links" },
    { "type": "text", "id": "copyright", "label": "Copyright line" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#F3F6F4" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#5C6863" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 }
  ],
  "presets": [ { "name": "Adv · Article footer" } ]
}
{% endschema %}
