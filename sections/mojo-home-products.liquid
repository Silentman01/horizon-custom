{%- liquid
  assign s = section.settings
  assign default_handle = 'mojo-silk-boxers-sustainable-comfort'
  assign view_all = s.view_all_link | default: all_products[default_handle].url | default: routes.all_products_collection_url
-%}
<section class="mojo-hp mojo-hp--{{ s.layout }}" id="mojo-hp-{{ section.id }}" style="{% render 'mojo-vars' %}--mojo-hp-cols:{{ s.columns }};--mojo-hp-gap:{{ s.gap }}px;--mojo-hp-bg:{{ s.bg_color }};--mojo-pt:{{ s.padding_top }}px;--mojo-pb:{{ s.padding_bottom }}px;--mojo-hp-badge:{{ s.badge_bg }};--mojo-hp-badge-fg:{{ s.badge_fg }};--mojo-hp-ratio:{{ s.image_ratio }};--mojo-hp-card-bg:{{ s.card_bg }};">
  <div class="mojo-hp__inner">
    {%- if s.heading != blank -%}<h2 class="mojo-hp__heading">{{ s.heading }}</h2>{%- endif -%}
    <div class="mojo-hp__track" data-mojo-hp-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign handle = b.handle | default: default_handle
          assign product = b.product | default: all_products[handle]
          assign has_product = false
          if product != blank and product.title != blank
            assign has_product = true
          endif
          assign title = b.title
          if title == blank and has_product
            assign title = product.title
          endif
          assign price = b.price
          assign compare = b.compare_at
          assign badge = b.badge
          if b.live_data and has_product
            assign price = product.price | money
            assign compare = ''
            if product.compare_at_price > product.price
              assign compare = product.compare_at_price | money
              if badge == blank
                assign save_cents = product.compare_at_price | minus: product.price
                assign badge = 'SAVE ' | append: save_cents | money
              endif
            endif
          endif
          assign link = b.link
          if link == blank
            if has_product
              assign link = product.url
            else
              assign link = routes.all_products_collection_url
            endif
          endif
        -%}
        <article class="mojo-hp__card" {{ block.shopify_attributes }}>
          <a class="mojo-hp__link" href="{{ link }}">
            <div class="mojo-hp__img">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', widths: '360, 540, 800', alt: title }}
              {%- elsif b.asset != blank -%}
                <img src="{{ b.asset | asset_url }}" alt="{{ title | escape }}" loading="lazy" decoding="async" width="800" height="800">
              {%- elsif has_product and product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', widths: '360, 540, 800', alt: title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'mojo-hp__ph' }}
              {%- endif -%}
              {%- if badge != blank -%}<span class="mojo-hp__badge">{{ badge }}</span>{%- endif -%}
              {%- if b.corner_label != blank -%}<span class="mojo-hp__corner mojo-hp__corner--{{ b.corner_style }}">{{ b.corner_label }}</span>{%- endif -%}
              <span class="mojo-hp__plus" aria-hidden="true">+</span>
            </div>
            <h3 class="mojo-hp__title">{{ title }}</h3>
            {%- if b.subtitle != blank -%}<p class="mojo-hp__subtitle">{{ b.subtitle }}</p>{%- endif -%}
            <p class="mojo-hp__price"><span class="mojo-hp__now">{{ price }}</span>{%- if compare != blank -%} <s class="mojo-hp__was">{{ compare }}</s>{%- endif -%}</p>
          </a>
          {%- if b.swatches != blank -%}
            <div class="mojo-hp__swatches" aria-hidden="true">
              {%- assign sw = b.swatches | split: ',' -%}
              {%- for c in sw -%}<span class="mojo-hp__sw" style="background:{{ c | strip }};"></span>{%- endfor -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if s.view_all_label != blank -%}
      <div class="mojo-hp__more"><a class="mojo-hp__btn" href="{{ view_all }}">{{ s.view_all_label }}</a></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('mojo-hp-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-mojo-hp-track]');
    if (!track || !root.classList.contains('mojo-hp--carousel')) return;
    var down = false, sx = 0, sl = 0, moved = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch') return;
      down = true; moved = false; sx = e.clientX; sl = track.scrollLeft;
    });
    window.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - sx;
      if (Math.abs(dx) > 4) { moved = true; track.classList.add('is-dragging'); }
      track.scrollLeft = sl - dx;
    });
    window.addEventListener('pointerup', function () {
      if (!down) return;
      down = false; track.classList.remove('is-dragging');
    });
    track.addEventListener('click', function (e) { if (moved) { e.preventDefault(); moved = false; } }, true);
    track.addEventListener('dragstart', function (e) { e.preventDefault(); });
  })();
</script>

{% stylesheet %}
.mojo-hp { background: var(--mojo-hp-bg, #fff); color: var(--mojo-fg); font-family: var(--mojo-font); padding: var(--mojo-pt) 0 var(--mojo-pb); }
.mojo-hp__inner { max-width: 1400px; margin: 0 auto; padding: 0 16px; }
.mojo-hp__heading { margin: 0 0 24px; text-align: center; font-family: var(--mojo-font-heading); font-size: 28px; font-weight: 600; line-height: 1.2; }
.mojo-hp__track { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px var(--mojo-hp-gap, 12px); }
.mojo-hp--carousel .mojo-hp__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; cursor: grab; margin-right: -16px; padding-right: 16px; }
.mojo-hp--carousel .mojo-hp__track::-webkit-scrollbar { display: none; }
.mojo-hp--carousel .mojo-hp__track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
.mojo-hp--carousel .mojo-hp__card { flex: 0 0 62%; scroll-snap-align: start; }
.mojo-hp__card { min-width: 0; text-align: center; }
.mojo-hp__link { display: block; color: inherit; text-decoration: none; }
.mojo-hp__img { position: relative; aspect-ratio: var(--mojo-hp-ratio, 1 / 1); background: var(--mojo-hp-card-bg, #f3f4f6); overflow: hidden; }
.mojo-hp__img img, .mojo-hp__ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; mix-blend-mode: multiply; }
.mojo-hp__badge { position: absolute; top: 6px; left: 6px; z-index: 1; padding: 4px 6px; background: var(--mojo-hp-badge, #000); color: var(--mojo-hp-badge-fg, #fff); font-size: 10px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.2; }
.mojo-hp__corner { position: absolute; z-index: 1; top: 8px; right: 8px; font-size: 11px; font-weight: 600; }
.mojo-hp__corner--round { top: 6px; right: 6px; display: flex; align-items: center; justify-content: center; width: 58px; height: 58px; padding: 6px; border-radius: 50%; background: #000; color: #fff; font-size: 9px; line-height: 1.15; text-align: center; text-transform: uppercase; box-sizing: border-box; }
.mojo-hp__plus { position: absolute; right: 8px; bottom: 8px; z-index: 1; display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; background: #fff; color: #000; font-size: 20px; line-height: 1; box-shadow: 0 0 0 1px #d9d9d9; }
.mojo-hp__title { margin: 12px 0 0; font-size: 14px; font-weight: 500; line-height: 1.35; }
.mojo-hp__subtitle { margin: 2px 0 0; font-size: 12px; color: var(--mojo-muted); }
.mojo-hp__price { margin: 6px 0 0; font-size: 14px; }
.mojo-hp__now { font-weight: 600; }
.mojo-hp__was { color: #8a8a8a; margin-left: 4px; font-weight: 400; }
.mojo-hp__swatches { display: flex; justify-content: center; gap: 8px; margin-top: 8px; }
.mojo-hp__sw { width: 16px; height: 16px; border: 1px solid #000; box-sizing: border-box; }
.mojo-hp__more { text-align: center; margin-top: 28px; }
.mojo-hp__btn { display: inline-block; padding: 14px 44px; background: #000; color: #fff; font-size: 13px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; border-radius: 0; }
@media screen and (min-width: 750px) {
  .mojo-hp__inner { padding: 0 24px; }
  .mojo-hp__heading { font-size: 32px; margin-bottom: 32px; }
  .mojo-hp--grid .mojo-hp__track { grid-template-columns: repeat(var(--mojo-hp-cols, 4), minmax(0, 1fr)); }
  .mojo-hp--carousel .mojo-hp__card { flex: 0 0 calc((100% - (var(--mojo-hp-cols, 4) - 1) * var(--mojo-hp-gap, 12px)) / var(--mojo-hp-cols, 4)); }
  .mojo-hp--carousel .mojo-hp__track { margin-right: 0; padding-right: 0; }
  .mojo-hp__plus { display: none; }
  .mojo-hp__title { font-size: 15px; }
  .mojo-hp__badge { font-size: 11px; padding: 5px 8px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo home products",
  "tag": "section",
  "class": "mojo-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Bestsellers" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel (swipe and drag)" }
      ]
    },
    { "type": "range", "id": "columns", "label": "Cards per row on desktop", "default": 4, "min": 2, "max": 5, "step": 1 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "default": 14, "min": 4, "max": 40, "step": 2, "unit": "px" },
    {
      "type": "select", "id": "image_ratio", "label": "Card image ratio", "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" }
      ]
    },
    { "type": "header", "content": "View all button" },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "VIEW ALL" },
    { "type": "url", "id": "view_all_link", "label": "Button link", "info": "Blank = the Mojo product page." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card image background", "default": "#F3F4F6" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#000000" },
    { "type": "color", "id": "badge_fg", "label": "Badge text", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "text", "id": "handle", "label": "Fallback product handle", "default": "mojo-silk-boxers-sustainable-comfort", "info": "Used when no product is picked above." },
        { "type": "checkbox", "id": "live_data", "label": "Use the live product price and compare-at price", "default": false },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Image: theme file name", "info": "Used when no image is uploaded above." },
        { "type": "text", "id": "title", "label": "Title", "default": "Mojo Silk Boxers | 1 Pair" },
        { "type": "text", "id": "subtitle", "label": "Sub line (optional)" },
        { "type": "text", "id": "price", "label": "Price", "default": "£29.95" },
        { "type": "text", "id": "compare_at", "label": "Compare-at price", "default": "£50.00" },
        { "type": "text", "id": "badge", "label": "Badge (top left)", "default": "SAVE £20.05" },
        { "type": "text", "id": "corner_label", "label": "Corner label (top right)" },
        {
          "type": "select", "id": "corner_style", "label": "Corner label style", "default": "text",
          "options": [
            { "value": "text", "label": "Plain text" },
            { "value": "round", "label": "Round black badge" }
          ]
        },
        { "type": "text", "id": "swatches", "label": "Swatch colours (comma separated)", "info": "e.g. #E8D9B5, #000000, #FFFFFF, #1F2A5C" },
        { "type": "url", "id": "link", "label": "Link", "info": "Blank = the product page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mojo home products",
      "blocks": [
        { "type": "card", "settings": { "asset": "mojo-home-card-black.jpg", "title": "Mojo Silk Boxers | Black" } },
        { "type": "card", "settings": { "asset": "mojo-home-card-beige.jpg", "title": "Mojo Silk Boxers | Beige" } }
      ]
    }
  ]
}
{% endschema %}
