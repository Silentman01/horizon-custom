{%- liquid
  assign s = section.settings
  assign tabs = section.blocks | where: 'type', 'tab'
-%}
<div class="ot-reviews" data-ot-rv style="{% render 'oldtoms-vars' %}--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <div class="ot-reviews__head">
    {%- if s.rating_line != blank -%}
      <p class="ot-reviews__rating">
        <span class="ot-reviews__stars" role="img" aria-label="5 out of 5 stars">
          {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M12 2.8l2.7 5.7 6.2.8-4.6 4.3 1.2 6.2L12 16.7 6.5 19.8l1.2-6.2L3.1 9.3l6.2-.8z" fill="#CCF46F" stroke="#24433D" stroke-width="1.6" stroke-linejoin="round"/></svg>{%- endfor -%}
        </span>
        <span>{{ s.rating_line }}</span>
      </p>
    {%- endif -%}
    {%- if s.heading != blank -%}<h2 class="ot-reviews__heading">{{ s.heading }}</h2>{%- endif -%}

    <div class="ot-reviews__tabs" role="tablist" aria-label="{{ s.heading | escape }}">
      {%- for tab in tabs -%}
        <button type="button" class="ot-reviews__tab" role="tab" id="ot-rv-tab-{{ section.id }}-{{ forloop.index }}" aria-controls="ot-rv-panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-ot-tab="{{ forloop.index }}" {{ tab.shopify_attributes }}>
          {%- if tab.settings.emoji != blank -%}<span aria-hidden="true">{{ tab.settings.emoji }}</span>{%- endif -%}
          <span>{{ tab.settings.label }}</span>
        </button>
      {%- endfor -%}
    </div>
    {%- if s.hint != blank -%}
      <p class="ot-reviews__hint">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 013 0V11m0-1.5a1.5 1.5 0 013 0V11m0-.5a1.5 1.5 0 013 0V15a6 6 0 01-6 6h-1.5a6 6 0 01-4.8-2.4L4 15.5a1.5 1.5 0 012.3-1.9L9 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{{ s.hint }}</span>
      </p>
    {%- endif -%}
  </div>

  {%- for tab in tabs -%}
    {%- assign tab_index = forloop.index | append: '' -%}
    <div class="ot-reviews__panel" role="tabpanel" id="ot-rv-panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="ot-rv-tab-{{ section.id }}-{{ forloop.index }}" data-ot-panel="{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
      <div class="ot-reviews__rail" data-ot-drag data-ot-snap>
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' and block.settings.tab == tab_index -%}
            <article class="ot-reviews__card" {{ block.shopify_attributes }}>
              <div class="ot-reviews__top">
                <span class="ot-reviews__cstars" role="img" aria-label="5 out of 5 stars">
                  {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M12 2.8l2.7 5.7 6.2.8-4.6 4.3 1.2 6.2L12 16.7 6.5 19.8l1.2-6.2L3.1 9.3l6.2-.8z" fill="#CCF46F" stroke="#24433D" stroke-width="1.8" stroke-linejoin="round"/></svg>{%- endfor -%}
                </span>
                {%- if s.badge != blank -%}
                  <span class="ot-reviews__badge"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#24433D"/><path d="M7.5 12.3l3 3 6-6.3" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ s.badge }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.before != blank -%}<blockquote class="ot-reviews__before">{{ block.settings.before }}</blockquote>{%- endif -%}
              {%- if block.settings.headline != blank -%}<h3 class="ot-reviews__title">{{ block.settings.headline }}</h3>{%- endif -%}
              <div class="ot-reviews__body">{{ block.settings.body }}</div>
              <div class="ot-reviews__foot">
                <div class="ot-reviews__avatar">{% render 'oldtoms-media', image: block.settings.avatar, asset: block.settings.avatar_asset, ratio: '1 / 1', alt: block.settings.name, sizes: '64px' %}</div>
                <div class="ot-reviews__who">
                  <p class="ot-reviews__name">{{ block.settings.name }}</p>
                  <p class="ot-reviews__loc">{{ block.settings.location }}</p>
                  {%- if block.settings.purchased != blank -%}<p class="ot-reviews__chip"><strong>Purchased:</strong> {{ block.settings.purchased }}</p>{%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="ot-reviews__arrows">
        <button type="button" class="ot-reviews__arrow" data-ot-prev aria-label="Previous review"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="ot-reviews__arrow" data-ot-next aria-label="Next review"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
  {%- endfor -%}

  {%- if s.show_cta -%}
    <div class="ot-reviews__cta">{% render 'oldtoms-cta', label: s.cta_label, guarantee: s.cta_guarantee %}</div>
  {%- endif -%}
</div>

{% stylesheet %}
.ot-reviews { background: #fff; color: #121212; font-family: var(--ot-font); padding: var(--ot-pt, 40px) 0 var(--ot-pb, 40px); }
.ot-reviews__head { text-align: center; padding-inline: 16px; }
.ot-reviews__rating { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 12px; }
.ot-reviews__stars { display: inline-flex; gap: 1px; }
.ot-reviews__heading { margin: 0 auto 20px; max-width: 560px; font-family: var(--ot-font-heading); font-weight: 400; font-size: 34px; line-height: 1.15; color: #23372b; }
.ot-reviews__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.ot-reviews__tab { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 18px; border: 1px solid #24433d; border-radius: 999px; background: #fff; color: #24433d; font: 600 14px/1 var(--ot-font); cursor: pointer; }
.ot-reviews__tab[aria-selected='true'] { background: #23372b; color: #fff; }
.ot-reviews__tab:focus-visible, .ot-reviews__arrow:focus-visible { outline: 2px solid #24433d; outline-offset: 2px; }
.ot-reviews__hint { display: inline-flex; align-items: center; gap: 6px; margin: 14px 0 18px; font-size: 12px; color: #4d4d4d; }
.ot-reviews__panel[hidden] { display: none; }
.ot-reviews__rail { display: flex; gap: 12px; overflow-x: auto; padding: 0 16px 4px; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; cursor: grab; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
.ot-reviews__rail::-webkit-scrollbar { display: none; }
.ot-reviews__rail.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
.ot-reviews__card { flex: 0 0 clamp(262px, 82vw, 340px); scroll-snap-align: start; display: flex; flex-direction: column; background: #f4f4f0; border-radius: 16px; padding: 16px; text-align: left; }
.ot-reviews__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
.ot-reviews__cstars { display: inline-flex; gap: 1px; }
.ot-reviews__badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 999px; background: #fff; font-size: 11px; line-height: 1.2; }
.ot-reviews__before { margin: 0 0 12px; padding: 0 0 0 10px; border-left: 3px solid #9b4600; font-size: 12px; font-style: italic; line-height: 1.4; color: #9b4600; }
.ot-reviews__title { margin: 0 0 8px; font: 700 14px/1.3 var(--ot-font); text-transform: uppercase; color: #24433d; }
.ot-reviews__body { flex: 1; font-size: 13px; line-height: 1.45; }
.ot-reviews__body p { margin: 0; }
.ot-reviews__foot { display: flex; align-items: center; gap: 10px; margin-top: 14px; padding-top: 14px; border-top: 1px solid #5b7265; }
.ot-reviews__avatar { flex: none; width: 36px; border-radius: 50%; overflow: hidden; }
.ot-reviews__avatar .ot-media { background: #d5dccb; }
.ot-reviews__who { min-width: 0; }
.ot-reviews__who p { margin: 0; }
.ot-reviews__name { font-size: 12px; line-height: 1.3; }
.ot-reviews__loc { font-size: 11px; line-height: 1.3; color: #4d4d4d; }
.ot-reviews__chip { display: inline-block; margin-top: 4px !important; padding: 2px 9px; border: 1px solid #24433d; border-radius: 999px; font-size: 11px; line-height: 1.3; }
.ot-reviews__arrows { display: flex; justify-content: center; gap: 10px; margin-top: 14px; }
.ot-reviews__arrow { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 4px; background: #23372b; color: #fff; cursor: pointer; }
.ot-reviews__cta { padding: 28px 16px 0; }
@media screen and (min-width: 750px) {
  .ot-reviews__heading { font-size: 52px; margin-bottom: 28px; }
  .ot-reviews__rail { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; max-width: 1368px; margin: 0 auto; padding-inline: 36px; overflow: visible; scroll-snap-type: none; cursor: default; }
  .ot-reviews__card { flex: none; }
  .ot-reviews__arrows { display: none; }
  .ot-reviews__cta { padding-top: 40px; }
}
{% endstylesheet %}

{% javascript %}
(() => {
  /* mouse/pen drag for horizontal rails; touch keeps native swipe */
  const init = () => document.querySelectorAll('[data-ot-drag]:not([data-ot-drag-ready])').forEach((rail) => {
    rail.setAttribute('data-ot-drag-ready', '');
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.classList.add('is-dragging'); try { rail.setPointerCapture(id); } catch (err) { /* ignore */ } }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.classList.remove('is-dragging');
      rail.scrollLeft = left;
      if (rail.hasAttribute('data-ot-snap')) {
        const card = rail.firstElementChild;
        const step = card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(rail).columnGap || 0) : 0;
        if (step) rail.scrollTo({ left: Math.round(left / step) * step, behavior: 'smooth' });
      }
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  });
  init();
  document.addEventListener('shopify:section:load', init);
})();
(() => {
  const init = () => document.querySelectorAll('[data-ot-rv]:not([data-ot-rv-ready])').forEach((root) => {
    root.setAttribute('data-ot-rv-ready', '');
    const tabs = [...root.querySelectorAll('[data-ot-tab]')];
    const panels = [...root.querySelectorAll('[data-ot-panel]')];
    const show = (n) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.otTab === n ? 'true' : 'false'));
      panels.forEach((p) => {
        const on = p.dataset.otPanel === n;
        p.hidden = !on;
        const rail = p.querySelector('[data-ot-drag]');
        if (on && rail) rail.scrollLeft = 0;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.otTab));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        next.focus(); show(next.dataset.otTab);
      });
    });
    panels.forEach((p) => {
      const rail = p.querySelector('[data-ot-drag]');
      const step = () => { const c = rail.firstElementChild; return c ? c.getBoundingClientRect().width + parseFloat(getComputedStyle(rail).columnGap || 0) : 0; };
      p.querySelector('[data-ot-prev]').addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
      p.querySelector('[data-ot-next]').addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    });
  });
  init(); document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Old Tom's testimonials",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "rating_line", "label": "Rating line", "default": "4.8 | 1668 Verified reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results From People Like You" },
    { "type": "text", "id": "hint", "label": "Tab hint", "default": "Tap each box to read more success stories" },
    { "type": "text", "id": "badge", "label": "Card badge (leave empty to hide)", "default": "Verified Buyer" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show add to basket button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to basket" },
    { "type": "text", "id": "cta_guarantee", "label": "Guarantee line", "default": "30-Day Money Back Guarantee" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🏠" },
        { "type": "text", "id": "label", "label": "Label", "default": "Homeowners" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "select",
          "id": "tab",
          "label": "Shown in tab number",
          "options": [
            { "value": "1", "label": "Tab 1" },
            { "value": "2", "label": "Tab 2" },
            { "value": "3", "label": "Tab 3" },
            { "value": "4", "label": "Tab 4" }
          ],
          "default": "1"
        },
        { "type": "text", "id": "before", "label": "Quote (before)", "default": "Tried every trap and poison for 3 years solid. Nothing lasted more than a week." },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Finally, something that keeps them gone — for good." },
        { "type": "richtext", "id": "body", "label": "Review", "default": "<p>Put pouches under the kitchen sink and along the cellar wall.</p>" },
        { "type": "text", "id": "name", "label": "Name", "default": "Robert L." },
        { "type": "text", "id": "location", "label": "Role and place", "default": "🏠 Homeowner · Shropshire" },
        { "type": "text", "id": "purchased", "label": "Purchased chip (leave empty to hide)", "default": "2 Pack" },
        { "type": "image_picker", "id": "avatar", "label": "Photo" },
        { "type": "text", "id": "avatar_asset", "label": "Theme asset filename (used when no photo is picked)", "default": "oldtoms-testimonial-01.jpg" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Old Tom's testimonials",
      "blocks": [
        { "type": "tab", "settings": { "emoji": "🏠", "label": "Homeowners" } },
        { "type": "tab", "settings": { "emoji": "🚐", "label": "Caravan Owners" } },
        { "type": "tab", "settings": { "emoji": "🌾", "label": "Farmers" } },
        { "type": "review", "settings": { "tab": "1", "name": "Robert L.", "location": "🏠 Homeowner · Shropshire", "purchased": "2 Pack", "before": "Tried every trap and poison for 3 years solid. Nothing lasted more than a week.", "headline": "Finally, something that keeps them gone — for good.", "body": "<p>Put pouches under the kitchen sink and along the cellar wall. Eleven days later, not one mouse. Six weeks on — still nothing. My wife actually feels at ease in her own kitchen again. I honestly wish I'd found this years ago.</p>", "avatar_asset": "oldtoms-testimonial-01.jpg" } },
        { "type": "review", "settings": { "tab": "1", "name": "Tom W.", "location": "🏠 Homeowner · Leeds, West Yorkshire", "purchased": "3 Pack", "before": "Spent nearly £150 on traps, poison and one of those plug-in ultrasonic things. Nothing worked more than a few days.", "headline": "I wasted £150+ on traps, then I found Old Tom's...", "body": "<p>Pouches behind the fridge, along the garage wall, under the floorboards. By week two — total silence. I was ready to ring pest control and spend £300. Glad I didn't.</p>", "avatar_asset": "oldtoms-testimonial-02.jpg" } },
        { "type": "review", "settings": { "tab": "1", "name": "Amelia R.", "location": "🏠 Homeowner · Harrogate, North Yorkshire", "purchased": "3 Pack", "before": "Old house, loads of gaps. Had mice every single winter for six years. First October in six years I haven't had to deal with them.", "headline": "This just works, that's all I want to say!!!", "body": "<p>Lined every cellar corner and both garage door edges before the cold set in. Usually by mid-October I'm setting traps every other day. Not this year. Not one.</p>", "avatar_asset": "oldtoms-testimonial-03.jpg" } },
        { "type": "review", "settings": { "tab": "2", "name": "Dave B.", "location": "🚐 Full-Time Motorhomer · Keswick, Cumbria", "purchased": "3 Pack", "before": "We live in our motorhome full time. Tried every spray and trap going — mice kept coming back whenever we parked up somewhere rural.", "headline": "Three months on a farm site in Devon. Not one mouse the whole time.", "body": "<p>Put pouches under every seat, in both lockers and the garage compartment. Didn't think something this simple would work. Haven't touched a trap since. For full-timers it's the only thing that's actually worked for us.</p>", "avatar_asset": "oldtoms-testimonial-04.jpg" } },
        { "type": "review", "settings": { "tab": "2", "name": "Gary M.", "location": "🚐 Caravan Owner · Skegness, Lincolnshire", "purchased": "2 Pack", "before": "Mice had wrecked my caravan two winters running. Chewed wiring, shredded insulation — thousands in damage.", "headline": "Opened her up in spring and not a single mouse. First time in three years.", "body": "<p>Tucked pouches in the front locker, by the wheel arches and in every storage space before laying her up for winter. Took her out four months later, completely untouched. First time in three years. Already ordered a second lot for next season.</p>", "avatar_asset": "oldtoms-testimonial-05.jpg" } },
        { "type": "review", "settings": { "tab": "2", "name": "Russell O.", "location": "🚐 Caravan Owner · Whitby, North Yorkshire", "purchased": "3 Pack", "before": "Got my caravan out of storage last April and the damage was shocking. Chewed seat cushions, droppings everywhere.", "headline": "This season — spotless. Not a dropping, not a chew mark. Nothing.", "body": "<p>Put pouches in all four lockers and two under the dinette before shutting her up. Six months later, opened it up spotless. Saved myself a £500 repair bill at least.</p>", "avatar_asset": "oldtoms-testimonial-06.jpg" } },
        { "type": "review", "settings": { "tab": "3", "name": "Dale T.", "location": "🌾 Farmer · Hereford, Herefordshire", "purchased": "5 Pack", "before": "Lost so much feed to mice every single year. Tried poison but was always worried about my dogs and cattle getting at it.", "headline": "Six weeks in — feed room's clean. Dogs are fine. Haven't touched a trap since.", "body": "<p>Put pouches round the whole feed store, every 2.5 metres like the instructions said. Within two weeks the droppings stopped completely. What got me is there's nothing to clear up — no dead mice, no poison, no mess. Just gone.</p>", "avatar_asset": "oldtoms-testimonial-07.jpg" } },
        { "type": "review", "settings": { "tab": "3", "name": "Thomas E.", "location": "🌾 Farmer · Malton, North Yorkshire", "purchased": "5 Pack", "before": "Every autumn without fail — mice moved into the machinery shed and feed room the second it turned cold.", "headline": "Set them out in September this year. October came and went. Nothing.", "body": "<p>Covered the feed room perimeter and tucked pouches inside three bits of kit that always got hit. Didn't have to set a single trap all season. First clean winter in eight years.</p>", "avatar_asset": "oldtoms-testimonial-08.jpg" } },
        { "type": "review", "settings": { "tab": "3", "name": "Earl H.", "location": "🌾 Farmer · Bury St Edmunds, Suffolk", "purchased": "3 Pack", "before": "Mice got into my grain store two years running. Lost hundreds of pounds of feed before I even noticed.", "headline": "The store's been clean for four months. Not one dropping.", "body": "<p>Put pouches round every grain store entrance and along the floor edge. Two weeks later the activity stopped completely. No poison near my feed, no dead mice to find. Just gone.</p>", "avatar_asset": "oldtoms-testimonial-09.jpg" } }
      ]
    }
  ]
}
{% endschema %}
