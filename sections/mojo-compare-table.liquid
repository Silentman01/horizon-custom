{%- assign s = section.settings -%}
<section class="mojo-cm" style="{% render 'mojo-vars' %}--mojo-pt:{{ s.padding_top }}px;--mojo-pb:{{ s.padding_bottom }}px;--mojo-ptm:{{ s.padding_top_m }}px;--mojo-pbm:{{ s.padding_bottom_m }}px;--mojo-tc:{{ s.text_color }};--mojo-hs:{{ s.heading_size }}px;--mojo-hsm:{{ s.heading_size_m }}px;--mojo-cm-bg:{{ s.bg_color }};--mojo-cm-mw:{{ s.table_max_width }}px;--mojo-cm-bad:{{ s.bad_color }};--mojo-cm-good:{{ s.good_color }};">
  <div class="mojo-cm__wrap" data-mojo-rail-wrap data-mojo-overflow="0">
    <div class="mojo-cm__head">
      {%- if s.heading != blank -%}<h2 class="mojo-cm__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subtitle != blank -%}<p class="mojo-cm__sub">{{ s.subtitle }}</p>{%- endif -%}
    </div>
    <table class="mojo-cm__table">
      <thead>
        <tr>
          <th class="mojo-cm__corner"></th>
          <th class="mojo-cm__th mojo-cm__th--hl">{{ s.col_1 }}</th>
          {%- for i in (2..4) -%}
            {%- assign full = 'col_' | append: i -%}
            {%- assign short = 'col_' | append: i | append: '_short' -%}
            <th class="mojo-cm__th"><span class="mojo-cm__full">{{ s[full] }}</span><span class="mojo-cm__short">{{ s[short] | default: s[full] }}</span></th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <tr class="mojo-cm__tr" {{ block.shopify_attributes }}>
            <th class="mojo-cm__label" scope="row">{{ b.label }}</th>
            <td class="mojo-cm__td mojo-cm__td--hl">
              <span class="mojo-cm__mark mojo-cm__mark--{% if b.good_1 %}good{% else %}bad{% endif %}">{% if b.good_1 %}{% render 'mojo-icon', name: 'check', size: 18 %}{% else %}{% render 'mojo-icon', name: 'close', size: 14 %}{% endif %}</span>
              <span class="mojo-cm__val mojo-cm__val--strong">{{ b.cell_1 }}</span>
            </td>
            {%- for i in (2..4) -%}
              {%- assign cell = 'cell_' | append: i -%}
              {%- assign good = 'good_' | append: i -%}
              <td class="mojo-cm__td">
                <span class="mojo-cm__mark mojo-cm__mark--{% if b[good] %}good{% else %}bad{% endif %}">{% if b[good] %}{% render 'mojo-icon', name: 'check', size: 18 %}{% else %}{% render 'mojo-icon', name: 'close', size: 14 %}{% endif %}</span>
                <span class="mojo-cm__val mojo-cm__val--other">{{ b[cell] }}</span>
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% stylesheet %}
.mojo-cm { padding: var(--mojo-ptm) 0 var(--mojo-pbm); font-family: var(--mojo-font); color: var(--mojo-tc); }
@media screen and (min-width: 750px) { .mojo-cm { padding: var(--mojo-pt) 0 var(--mojo-pb); } }

.mojo-cm { background: var(--mojo-cm-bg); }
.mojo-cm__wrap { max-width: var(--mojo-cm-mw); margin: 0 auto; padding-inline: 20px; position: relative; }
.mojo-cm__head { text-align: center; margin-bottom: 20px; }
.mojo-cm__heading { margin: 0 0 8px; font-family: var(--mojo-font-heading); font-weight: 600; font-size: var(--mojo-hsm); line-height: 1.2; }
.mojo-cm__sub { margin: 0; font-size: 14px; font-weight: 700; }
/* Fits the screen at every width: mobile = icon-only competitor columns + short headers; desktop = full values. */
.mojo-cm__table { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; font-size: 11px; text-align: center; }
.mojo-cm__corner { width: 34%; }
.mojo-cm__th--hl { width: 26%; }
.mojo-cm__th { padding: 12px 2px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; overflow-wrap: anywhere; }
.mojo-cm__th--hl { background: var(--mojo-primary); color: var(--mojo-cream, #F7F3EC); border-radius: 10px 10px 0 0; font-size: 14px; letter-spacing: 0.02em; text-transform: none; }
.mojo-cm__full { display: none; }
.mojo-cm__label { padding: 12px 6px 12px 0; text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.3; border-top: 1px solid var(--mojo-line); overflow-wrap: anywhere; }
.mojo-cm__td { padding: 10px 2px; border-top: 1px solid var(--mojo-line); vertical-align: middle; }
.mojo-cm__td--hl { background: #fff; border-left: 2px solid var(--mojo-primary); border-right: 2px solid var(--mojo-primary); font-weight: 700; }
.mojo-cm__tr:last-child .mojo-cm__td--hl { border-bottom: 2px solid var(--mojo-primary); border-radius: 0 0 10px 10px; }
.mojo-cm__mark { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; vertical-align: middle; }
.mojo-cm__mark--good { color: var(--mojo-cm-good); }
.mojo-cm__mark--bad { color: var(--mojo-cm-bad); background: color-mix(in srgb, var(--mojo-cm-bad) 10%, transparent); }
.mojo-cm__val { display: block; margin-top: 4px; line-height: 1.3; overflow-wrap: anywhere; }
.mojo-cm__val--strong { font-size: 10.5px; font-weight: 700; color: var(--mojo-primary); }
.mojo-cm__val--other { display: none; }
@media screen and (min-width: 750px) {
  .mojo-cm__heading { font-size: var(--mojo-hs); }
  .mojo-cm__table { font-size: 12.5px; }
  .mojo-cm__corner { width: 22%; }
  .mojo-cm__th--hl { width: 24%; font-size: 16px; }
  .mojo-cm__th { padding: 16px 8px; font-size: 11.5px; }
  .mojo-cm__full { display: inline; }
  .mojo-cm__short { display: none; }
  .mojo-cm__label { padding: 16px 8px 16px 0; font-size: 11px; }
  .mojo-cm__td { padding: 14px 8px; }
  .mojo-cm__val--strong { font-size: 12.5px; }
  .mojo-cm__val--other { display: block; color: var(--mojo-muted, #5E6470); font-size: 12px; }
}

{% endstylesheet %}

{% javascript %}
if (!window.mojoRails) {
  window.mojoRails = true;
  const setup = (rail) => {
    if (rail.dataset.mojoReady) return;
    rail.dataset.mojoReady = '1';
    const wrap = rail.closest('[data-mojo-rail-wrap]') || rail.parentElement;
    const dots = wrap.querySelector('[data-mojo-dots]');
    const prev = wrap.querySelector('[data-mojo-prev]');
    const next = wrap.querySelector('[data-mojo-next]');
    const cards = () => [...rail.children];
    const step = () => {
      const c = cards();
      if (c.length > 1) return c[1].getBoundingClientRect().left - c[0].getBoundingClientRect().left;
      return c[0] ? c[0].getBoundingClientRect().width : 0;
    };
    const index = () => { const s = step(); return s ? Math.round(rail.scrollLeft / s) : 0; };
    const sync = () => {
      const over = rail.scrollWidth > rail.clientWidth + 2;
      wrap.dataset.mojoOverflow = over ? '1' : '0';
      if (dots) {
        if (dots.children.length !== cards().length) {
          dots.textContent = '';
          cards().forEach((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', 'Go to item ' + (i + 1));
            b.addEventListener('click', () => rail.scrollTo({ left: i * step(), behavior: 'smooth' }));
            dots.appendChild(b);
          });
        }
        const at = index();
        [...dots.children].forEach((b, i) => b.setAttribute('aria-current', i === at ? 'true' : 'false'));
      }
      if (prev) prev.disabled = rail.scrollLeft <= 2;
      if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    if (prev) prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.setAttribute('data-mojo-dragging', ''); rail.setPointerCapture(id); }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.removeAttribute('data-mojo-dragging');
      rail.scrollLeft = left;
      const s = step();
      if (s) rail.scrollTo({ left: Math.round(left / s) * s, behavior: 'smooth' });
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    sync();
    setTimeout(sync, 400);
  };
  const init = () => document.querySelectorAll('[data-mojo-rail]').forEach(setup);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('shopify:section:load', init);
}
{% endjavascript %}

{% schema %}
{
  "name": "Mojo comparison table",
  "tag": "section",
  "class": "mojo-section",
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "PRICE"
        },
        {
          "type": "text",
          "id": "cell_1",
          "label": "Column 1 value"
        },
        {
          "type": "checkbox",
          "id": "good_1",
          "label": "Column 1: green/good (black dot)",
          "default": true
        },
        {
          "type": "text",
          "id": "cell_2",
          "label": "Column 2 value"
        },
        {
          "type": "checkbox",
          "id": "good_2",
          "label": "Column 2: green/good (black dot)",
          "default": false
        },
        {
          "type": "text",
          "id": "cell_3",
          "label": "Column 3 value"
        },
        {
          "type": "checkbox",
          "id": "good_3",
          "label": "Column 3: green/good (black dot)",
          "default": false
        },
        {
          "type": "text",
          "id": "cell_4",
          "label": "Column 4 value"
        },
        {
          "type": "checkbox",
          "id": "good_4",
          "label": "Column 4: green/good (black dot)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
