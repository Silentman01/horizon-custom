{% render 'refrain-fonts' %}
{%- assign dark = false -%}
{%- if section.settings.background == 'ink' -%}{%- assign dark = true -%}{%- endif -%}
<section class="rf-occ" data-bg="{{ section.settings.background }}" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-occ__inner">
    <div class="rf-occ__head">
      {% render 'refrain-title', text: section.settings.heading, dark: dark %}
      {%- if section.settings.sub != blank -%}<p class="rf-sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <ul class="rf-occ__grid">
      {%- for block in section.blocks -%}
        {%- capture ph -%}Photo: {{ block.settings.title }} moment, warm candid emotion between people{%- endcapture -%}
        <li class="rf-occ__card" {{ block.shopify_attributes }}>
          {% render 'refrain-media', image: block.settings.image, asset: block.settings.image_asset, ratio: '4 / 5', label: ph, radius: 22, sizes: '(min-width: 990px) 360px, 50vw' %}
          <div class="rf-occ__ov">
            <h3 class="rf-occ__t">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.title }}</a>{%- else -%}{{ block.settings.title }}{%- endif -%}</h3>
            {%- if block.settings.text != blank -%}<p class="rf-occ__p">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button_label != blank -%}
      <div class="rf-occ__cta"><a class="rf-btn{% if dark %} rf-btn--on-dark{% endif %}" href="{{ section.settings.button_link | default: '/products/chanson-personnalisee' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
  .rf-occ { padding: 48px 16px; background: var(--rf-page); font-family: var(--rf-sans); }
  .rf-occ[data-bg='lilac'] { background: var(--rf-lilac); }
  .rf-occ[data-bg='ink'] { background: var(--rf-ink); }
  .rf-occ[data-bg='ink'] .rf-sub { color: #fff; }
  .rf-occ__inner { max-width: 1160px; margin: 0 auto; }
  .rf-occ__head { max-width: 640px; margin: 0 auto 28px; text-align: center; }
  .rf-occ__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .rf-occ__card { position: relative; overflow: hidden; border-radius: 22px; box-shadow: 0 8px 28px rgb(30 15 74 / .1); }
  .rf-occ__card .rf-media { transition: transform .5s; }
  .rf-occ__card:hover .rf-media { transform: scale(1.04); }
  .rf-occ__ov { position: absolute; inset: auto 0 0 0; padding: 72px 14px 14px; background: linear-gradient(to top, rgb(30 15 74 / .95) 0%, rgb(30 15 74 / .75) 55%, rgb(30 15 74 / 0)); color: #fff; }
  .rf-occ__t { margin: 0; font-size: 16px; font-weight: 800; letter-spacing: -0.04em; line-height: 1.15; }
  .rf-occ__t a { color: inherit; text-decoration: none; }
  .rf-occ__t a::after { content: ''; position: absolute; inset: 0; }
  .rf-occ__p { margin: 4px 0 0; font-size: 13px; line-height: 1.35; opacity: .9; }
  .rf-occ__cta { display: flex; justify-content: center; margin-top: 32px; }
  @media (min-width: 750px) { .rf-occ__grid { grid-template-columns: repeat(3, 1fr); gap: 20px; } .rf-occ__t { font-size: 20px; } .rf-occ__p { font-size: 14px; } .rf-occ__ov { padding: 72px 20px 20px; } }
  @media (min-width: 990px) { .rf-occ { padding: 88px 24px; } .rf-occ__head { margin-bottom: 44px; } }
  @media (prefers-reduced-motion: reduce) { .rf-occ__card .rf-media { transition: none; } .rf-occ__card:hover .rf-media { transform: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Refrain · Occasions",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "page", "options": [ { "value": "page", "label": "Page" }, { "value": "lilac", "label": "Lilac" }, { "value": "ink", "label": "Ink" } ] },
    { "type": "text", "id": "heading", "label": "Heading (*word* = italic emphasis)", "default": "Pour chaque *occasion*" },
    { "type": "textarea", "id": "sub", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Créer ma chanson" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "occasion", "name": "Occasion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Anniversaire" },
        { "type": "text", "id": "text", "label": "Line", "default": "Un cadeau dont on se souvient." },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "image_asset", "label": "Image theme asset file name" }
      ]
    }
  ],
  "presets": [
    { "name": "Refrain · Occasions", "blocks": [
      { "type": "occasion", "settings": { "title": "Anniversaire", "text": "Un cadeau dont on se souvient." } },
      { "type": "occasion", "settings": { "title": "Fête des mères", "text": "Les mots que vous n'osez pas dire." } },
      { "type": "occasion", "settings": { "title": "Mariage", "text": "Leur histoire, en musique." } },
      { "type": "occasion", "settings": { "title": "Saint-Valentin", "text": "Une déclaration sur mesure." } },
      { "type": "occasion", "settings": { "title": "Naissance", "text": "Une berceuse rien que pour lui ou elle." } },
      { "type": "occasion", "settings": { "title": "Remerciements", "text": "Pour dire merci autrement." } }
    ] }
  ]
}
{% endschema %}
