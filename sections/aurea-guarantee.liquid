<section class="au-gua" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-gua__inner">
    <span class="au-gua__icon">{% render 'aurea-icon', name: 'shield' %}</span>
    {% render 'aurea-title', text: section.settings.heading, class: 'au-gua__h' %}
    <p class="au-gua__text">{{ section.settings.text }}</p>
  </div>
</section>
{% stylesheet %}
  .au-gua { padding: 40px 16px; background: var(--au-parchment); }
  .au-gua__inner { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .au-gua__icon .au-icon { width: 84px; height: 84px; stroke-width: 1; color: var(--au-gold); }
  .au-gua__h { font-size: clamp(24px, 4vw, 34px); }
  .au-gua__text { margin: 0; font-size: 16px; line-height: 1.6; color: rgb(from var(--au-ink) r g b / 0.8); }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea guarantee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "30-Day *Money-Back* Guarantee" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wear it for 30 days. If it doesn't feel right, send it back and get a full refund — no questions asked. That's how sure we are." }
  ],
  "presets": [ { "name": "Aurea guarantee" } ]
}
{% endschema %}
