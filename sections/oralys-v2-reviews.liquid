{%- render 'oralys-v2-base' -%}
{%- assign s = section.settings -%}
<section class="ov2 ov2-sec ov2-rev" style="--ov2-bg:{{ s.c_bg }}">
  <div class="ov2-in">
    <h2 class="ov2-h2 ov2-center">{{ s.heading }}</h2>
    {%- if s.summary != blank %}<p class="ov2-rev__sum">{% render 'oralys-v2-stars', size: 20 %}<span>{{ s.summary }}</span></p>{% endif -%}
    <div class="ov2-rev__grid">
      <div class="ov2-rev__left">
        <ul class="ov2-rev__mosaic" role="list">
          {%- assign tiles = s.mosaic | newline_to_br | split: '<br />' -%}
          {%- for t in tiles limit: 6 -%}
            {%- assign tt = t | strip -%}
            {%- if tt == blank %}{% continue %}{% endif -%}
            <li>{% render 'oralys-pdp-media', asset: tt, alt: 'Photo envoyée par une cliente', class: 'ov2-rev__tile', width: 400, height: 400 %}</li>
          {%- endfor -%}
        </ul>
        {%- if s.featured != blank -%}
        <figure class="ov2-rev__feat">
          <blockquote>{{ s.featured }}</blockquote>
          <figcaption><b>{{ s.featured_who }}</b>{% if s.featured_tag != blank %}<span class="ov2-rev__tag">{{ s.featured_tag }}</span>{% endif %}</figcaption>
        </figure>
        {%- endif -%}
      </div>
      <div class="ov2-rev__right">
        <ul class="ov2-rev__cards" role="list" data-ov2-more-list>
          {%- assign rows = s.cards | newline_to_br | split: '<br />' -%}
          {%- assign i = 0 -%}
          {%- for r in rows -%}
            {%- assign p = r | split: '|' -%}
            {%- assign title = p[0] | strip -%}
            {%- if title == blank %}{% continue %}{% endif -%}
            {%- assign i = i | plus: 1 -%}
            <li class="ov2-rev__card{% if i > s.visible %} is-more{% endif %}">
              <div class="ov2-rev__top">{% render 'oralys-v2-stars', size: 16 %}{% assign tag = p[1] | strip %}{% if tag != blank %}<span class="ov2-rev__tag">{{ tag }}</span>{% endif %}</div>
              <h3>{{ title }}</h3>
              <p class="ov2-rev__q">{% assign q = p[2] | strip %}{% render 'oralys-v2-hl', text: q %}</p>
              <p class="ov2-rev__who"><span>{{ p[3] | strip }}</span>{% if s.verified != blank %}<span class="ov2-rev__ver"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#0E6B50"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ s.verified }}</span>{% endif %}</p>
            </li>
          {%- endfor -%}
        </ul>
        {%- if i > s.visible and s.more != blank -%}
          <button type="button" class="ov2-rev__more" onclick="this.closest('.ov2-rev').classList.add('is-open');this.remove();">{{ s.more }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.ov2-rev__sum{display:flex;align-items:center;justify-content:center;gap:8px;margin:-8px 0 22px!important;font-size:16px;font-weight:700}
.ov2-rev__grid{display:flex;flex-direction:column;gap:20px}
.ov2-rev__left{display:flex;flex-direction:column;gap:20px}
.ov2-rev__mosaic{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.ov2-rev__mosaic li{aspect-ratio:1;border-radius:10px;overflow:hidden;background:#EEF6F1}
.ov2-rev__tile{width:100%;height:100%;object-fit:cover;display:block}
.ov2-rev__feat{margin:0;padding:4px 0 4px 16px;border-left:4px solid #0E6B50}
.ov2-rev__feat blockquote{margin:0 0 10px;font-size:18px;line-height:1.5;font-style:normal}
.ov2-rev__feat figcaption{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;font-size:15px;color:#5C6863}
.ov2-rev__feat b{color:#17221E}
.ov2-rev__cards{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.ov2-rev__card{padding:16px;border:1px solid #DCE5E0;border-radius:12px;background:#fff}
.ov2-rev__card.is-more{display:none}
.ov2-rev.is-open .ov2-rev__card.is-more{display:block}
.ov2-rev__top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.ov2-rev__tag{display:inline-block;padding:3px 10px;border-radius:20px;background:#EEF6F1;color:#0E6B50;font-size:15px;font-weight:700;line-height:1.4;white-space:nowrap}
.ov2-rev__card h3{margin:0 0 6px;font-size:17px;font-weight:700;line-height:1.3}
.ov2-rev__q{font-size:16px;line-height:1.5}
.ov2-rev__who{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:10px!important;font-size:15px;font-weight:700;color:#5C6863}
.ov2-rev__ver{display:inline-flex;align-items:center;gap:4px;color:#0E6B50}
.ov2-rev__more{display:flex;align-items:center;justify-content:center;width:100%;max-width:360px;min-height:52px;margin:18px auto 0;border:2px solid #17221E;border-radius:40px;background:#fff;color:#17221E;font:inherit;font-size:17px;font-weight:700;cursor:pointer}
@media (min-width:750px){
  .ov2-rev__grid{display:grid;grid-template-columns:5fr 7fr;gap:32px;align-items:start}
  .ov2-rev__left{position:sticky;top:90px}
  .ov2-rev__cards{grid-template-columns:1fr 1fr}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : avis",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils ont retrouvé leur place à table" },
    { "type": "text", "id": "summary", "label": "Note", "default": "4,8/5 · Plus de 5 400 avis" },
    { "type": "textarea", "id": "mosaic", "label": "Photos (fichiers du thème)", "info": "Un fichier par ligne, 6 maximum.", "default": "oralys-pdp-rev-t03.webp\noralys-pdp-rev-t04.webp\noralys-pdp-rev-t05.webp\noralys-pdp-rev-t07.webp\noralys-pdp-rev-t08.webp\noralys-pdp-rev-t09.webp" },
    { "type": "header", "content": "Avis mis en avant" },
    { "type": "textarea", "id": "featured", "label": "Texte", "default": "« Pendant deux ans, j'ai refusé les invitations à dîner. Le bas se décollait à chaque bouchée et je passais le repas à le retenir avec la langue. À Noël, j'ai mangé la dinde et les marrons, j'ai ri avec mes petits-enfants, et j'ai oublié que je portais un dentier. »" },
    { "type": "text", "id": "featured_who", "label": "Signature", "default": "Jacqueline, 72 ans · Tours · Achat vérifié" },
    { "type": "text", "id": "featured_tag", "label": "Étiquette", "default": "Bas · 3 mois d'utilisation" },
    { "type": "header", "content": "Avis" },
    { "type": "textarea", "id": "cards", "label": "Avis", "info": "Une ligne par avis : titre | étiquette | texte (phrase clé entre **) | signature.", "default": "Il ne se soulève plus quand je parle | Bas | « Au conseil municipal, je mangeais mes mots et je sentais le bas bouger à chaque phrase. **Maintenant je parle une heure sans y penser.** » | Bernard, 70 ans · Annecy" },
    { "type": "range", "id": "visible", "label": "Avis visibles avant le bouton", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "verified", "label": "Mention vérifiée", "default": "Achat vérifié" },
    { "type": "text", "id": "more", "label": "Bouton", "default": "Voir plus d'avis" },
    { "type": "color", "id": "c_bg", "label": "Fond", "default": "#F7FAF8" }
  ],
  "presets": [{ "name": "Oralys v2 : avis" }]
}
{% endschema %}
