{% render 'refrain-fonts' %}
{%- assign dark = false -%}
{%- if section.settings.background == 'ink' -%}{%- assign dark = true -%}{%- endif -%}
<section class="rf-faq rf-faq--{{ section.settings.background }}" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-faq__inner">
    <div class="rf-faq__side">
      {% render 'refrain-title', text: section.settings.heading, tag: 'h2', dark: dark %}
      {%- if section.settings.subheading != blank -%}<p class="rf-sub{% if dark %} rf-faq__sub-dark{% endif %}">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      {%- if section.settings.contact != blank -%}<div class="rf-faq__contact">{{ section.settings.contact }}</div>{%- endif -%}
    </div>
    <div class="rf-faq__list">
      {%- for block in section.blocks -%}
        <details class="rf-faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="rf-faq__chev">{% render 'refrain-icon', name: 'chevron' %}</span>
          </summary>
          <div class="rf-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>
{% stylesheet %}
  .rf-faq { font-family: var(--rf-sans); padding: 56px 0; background: var(--rf-page); }
  .rf-faq--lilac { background: var(--rf-lilac); }
  .rf-faq--ink { background: var(--rf-ink); }
  .rf-faq__inner { max-width: 1160px; margin: 0 auto; padding: 0 16px; display: grid; gap: 28px; }
  .rf-faq__sub-dark { color: var(--rf-lilac); }
  .rf-faq__contact { margin-top: 20px; padding: 18px 20px; border-radius: 22px; background: var(--rf-card); color: var(--rf-ink); font-size: 15px; line-height: 1.5; box-shadow: 0 8px 24px rgb(30 15 74 / .08); }
  .rf-faq__contact p { margin: 0; }
  .rf-faq__contact a { color: var(--rf-violet); font-weight: 700; }
  .rf-faq__list { display: grid; gap: 12px; align-content: start; }
  .rf-faq__item { background: var(--rf-card); border-radius: 22px; box-shadow: 0 6px 20px rgb(30 15 74 / .07); overflow: hidden; }
  .rf-faq__item summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px; cursor: pointer; font-weight: 700; font-size: 16px; line-height: 1.35; color: var(--rf-ink); letter-spacing: -0.01em; }
  .rf-faq__item summary::-webkit-details-marker { display: none; }
  .rf-faq__item summary:focus-visible { outline: 3px solid var(--rf-violet); outline-offset: -3px; border-radius: 22px; }
  .rf-faq__chev { flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--rf-lilac); color: var(--rf-ink); display: grid; place-items: center; transition: transform .3s ease, background .2s; }
  .rf-faq__chev svg { width: 18px; height: 18px; }
  .rf-faq__item[open] .rf-faq__chev { transform: rotate(180deg); background: var(--rf-ink); color: var(--rf-lime); }
  .rf-faq__answer { padding: 0 20px 22px; font-size: 16px; line-height: 1.6; color: var(--rf-ink-soft); }
  .rf-faq__answer p { margin: 0 0 .7em; }
  .rf-faq__answer p:last-child { margin-bottom: 0; }
  .rf-faq__item[open] .rf-faq__answer { animation: rf-faq-in .3s ease; }
  @keyframes rf-faq-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .rf-faq__chev { transition: none; } .rf-faq__item[open] .rf-faq__answer { animation: none; } }
  @media (min-width: 750px) { .rf-faq { padding: 96px 0; } .rf-faq__inner { padding: 0 24px; } .rf-faq__item summary { padding: 24px; font-size: 18px; } .rf-faq__answer { padding: 0 24px 26px; } }
  @media (min-width: 990px) {
    .rf-faq__inner { grid-template-columns: 380px 1fr; gap: 72px; align-items: start; }
    .rf-faq__side { position: sticky; top: 100px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Refrain · FAQ",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "page", "label": "Page" }, { "value": "lilac", "label": "Lilac" }, { "value": "ink", "label": "Ink" }], "default": "page" },
    { "type": "text", "id": "heading", "label": "Heading (wrap one word in *asterisks*)", "default": "Vos *questions*, nos réponses" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tout ce qu'il faut savoir avant de commander." },
    { "type": "richtext", "id": "contact", "label": "Contact text", "default": "<p>Une autre question ? Écrivez-nous, nous vous répondons rapidement.</p>" }
  ],
  "blocks": [
    {
      "type": "q",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Comment ça marche ?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Vous répondez à quelques questions, puis votre chanson est composée pour vous.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refrain · FAQ",
      "blocks": [
        { "type": "q", "settings": { "question": "Comment ça marche ?", "answer": "<p>Vous répondez à quelques questions sur la personne et vos souvenirs, puis votre chanson est composée pour vous.</p>" } },
        { "type": "q", "settings": { "question": "Puis-je écouter avant de payer ?", "answer": "<p>Oui, vous écoutez un extrait de votre chanson avant de régler.</p>" } },
        { "type": "q", "settings": { "question": "En combien de temps la reçois-je ?", "answer": "<p>Votre chanson vous est livrée rapidement par e-mail, prête à être offerte.</p>" } },
        { "type": "q", "settings": { "question": "Puis-je demander des modifications ?", "answer": "<p>Bien sûr, contactez-nous et nous ajusterons votre chanson avec vous.</p>" } },
        { "type": "q", "settings": { "question": "Comment offrir la chanson ?", "answer": "<p>Vous recevez un fichier audio et un lien à partager, à offrir comme vous le souhaitez.</p>" } }
      ]
    }
  ]
}
{% endschema %}
