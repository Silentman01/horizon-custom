{%- comment -%}
  Product hero / buy-box summary shown above the quiz (Aurea product-information layout, Refrain style).
  Gallery left (top on mobile) with thumbnails, then trust card, rating line, title, benefits, tier summary,
  a CTA that scrolls to the quiz (#quiz) and a trust strip. Purchase itself happens in the quiz offer.
{%- endcomment -%}
{% render 'refrain-fonts' %}
{% render 'refrain-drag' %}
{%- liquid
  assign s = section.settings
  assign slides = section.blocks | where: 'type', 'slide'
-%}
<section class="rf-hp" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-hp__inner">
    <refrain-hero-gallery class="rf-hp__gallery">
      <refrain-rail class="rf-hp__track" aria-label="{{ s.gallery_label | escape }}">
        {%- for block in slides -%}
          <div class="rf-hp__slide" {{ block.shopify_attributes }}>
            {% render 'refrain-media', image: block.settings.image, asset: block.settings.image_asset, ratio: '1 / 1', label: block.settings.alt, radius: 24, sizes: '(min-width: 990px) 580px, 100vw', priority: forloop.first %}
          </div>
        {%- endfor -%}
      </refrain-rail>
      {%- if slides.size > 1 -%}
        <div class="rf-hp__thumbs">
          {%- for block in slides -%}
            <button type="button" class="rf-hp__thumb{% if forloop.first %} is-active{% endif %}" data-rf-slide="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }} sur {{ slides.size }}"{% if forloop.first %} aria-current="true"{% endif %}>
              {% render 'refrain-media', image: block.settings.image, asset: block.settings.image_asset, ratio: '1 / 1', label: '', radius: 12, sizes: '80px', eager: true %}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </refrain-hero-gallery>

    <div class="rf-hp__info">
      {%- if s.card_title != blank -%}
        <div class="rf-hp__card">
          <span class="rf-hp__chip" aria-hidden="true">{% render 'refrain-icon', name: 'ear' %}</span>
          <span class="rf-hp__card-txt">
            <strong>{{ s.card_title | escape }}</strong>
            {%- if s.card_text != blank -%}<span>{{ s.card_text | escape }}</span>{%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- if s.rating_text != blank -%}
        <a class="rf-hp__rating" href="{{ s.rating_link | default: '#avis' }}">
          <span class="rf-hp__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'refrain-icon', name: 'star' %}{%- endfor -%}</span>
          <span>{{ s.rating_text | escape }}</span>
        </a>
      {%- endif -%}

      {% render 'refrain-title', text: s.heading, tag: 'h1', class: 'rf-hp__h' %}
      {%- if s.sub != blank -%}<p class="rf-hp__sub">{{ s.sub | escape }}</p>{%- endif -%}

      <ul class="rf-hp__ben">
        {%- for i in (1..4) -%}
          {%- assign tk = 'benefit_' | append: i -%}
          {%- assign ik = 'benefit_icon_' | append: i -%}
          {%- if s[tk] != blank -%}
            <li>{% render 'refrain-icon', name: s[ik] %}<span>{{ s[tk] | escape }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="rf-hp__tiers" role="list">
        <div class="rf-hp__tier" role="listitem">
          <p class="rf-hp__tier-top"><span class="rf-hp__tier-name">{{ s.std_name | escape }}</span><span class="rf-hp__tier-price">{{ s.std_price | escape }}</span></p>
          <p class="rf-hp__tier-txt">{{ s.std_text | escape }}</p>
        </div>
        <div class="rf-hp__tier rf-hp__tier--prem" role="listitem">
          {%- if s.prem_badge != blank -%}<span class="rf-hp__tier-badge">{{ s.prem_badge | escape }}</span>{%- endif -%}
          <p class="rf-hp__tier-top"><span class="rf-hp__tier-name">{{ s.prem_name | escape }}</span><span class="rf-hp__tier-price">{{ s.prem_price | escape }}</span></p>
          <p class="rf-hp__tier-txt">{{ s.prem_text | escape }}</p>
        </div>
      </div>

      <a class="rf-btn rf-hp__cta" href="{{ s.cta_link | default: '#quiz' }}">{{ s.cta_label | escape }} {% render 'refrain-icon', name: 'arrow' %}</a>
      {%- if s.cta_fine != blank -%}<p class="rf-hp__fine">{{ s.cta_fine | escape }}</p>{%- endif -%}

      <ul class="rf-hp__trust">
        {%- for i in (1..3) -%}
          {%- assign tk = 'trust_' | append: i -%}
          {%- assign ik = 'trust_icon_' | append: i -%}
          {%- if s[tk] != blank -%}
            <li><span class="rf-hp__trust-ic" aria-hidden="true">{% render 'refrain-icon', name: s[ik] %}</span><span>{{ s[tk] | escape }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if s.date_note != blank -%}
        <p class="rf-hp__date">{% render 'refrain-icon', name: 'gift' %}<span>{{ s.date_note | escape }}</span></p>
      {%- endif -%}
    </div>
  </div>
</section>
{% stylesheet %}
  .rf-hp { font-family: var(--rf-sans); background: var(--rf-page); padding: 12px 0 40px; color: var(--rf-ink); }
  .rf-hp__inner { max-width: 1160px; margin: 0 auto; padding: 0 16px; display: grid; gap: 24px; }
  .rf-hp__gallery { display: block; min-width: 0; }
  .rf-hp__track { gap: 0; border-radius: 24px; }
  .rf-hp__slide { flex: 0 0 100%; min-width: 0; }
  .rf-hp__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; }
  .rf-hp__thumbs::-webkit-scrollbar { display: none; }
  .rf-hp__thumb { flex: 0 0 64px; padding: 0; border: 2px solid transparent; border-radius: 14px; background: none; cursor: pointer; opacity: .7; transition: opacity .15s, border-color .15s; }
  .rf-hp__thumb.is-active { border-color: var(--rf-ink); opacity: 1; }
  .rf-hp__thumb:hover { opacity: 1; }
  .rf-hp__info { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-width: 0; }
  .rf-hp__card { display: flex; align-items: center; gap: 12px; width: 100%; box-sizing: border-box; padding: 10px 14px; background: var(--rf-lilac); border-radius: 16px; }
  .rf-hp__chip { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: var(--rf-ink); color: var(--rf-lime); }
  .rf-hp__chip .rf-icon, .rf-hp__chip svg { width: 20px; height: 20px; }
  .rf-hp__card-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .rf-hp__card-txt strong { font-size: 13px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .rf-hp__card-txt span { font-size: 13px; line-height: 1.4; color: var(--rf-ink-soft); }
  .rf-hp__rating { display: inline-flex; align-items: center; gap: 8px; min-height: 32px; color: var(--rf-ink); font-size: 14px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rf-line); }
  .rf-hp__rating:hover { text-decoration-color: currentColor; }
  .rf-hp__stars { display: inline-flex; gap: 2px; }
  .rf-hp__stars svg { width: 17px; height: 17px; display: block; }
  .rf-hp__h { font-size: clamp(30px, 8vw, 46px); line-height: 1.04; }
  .rf-hp__sub { margin: 0; font-size: 16px; line-height: 1.55; color: var(--rf-ink-soft); }
  .rf-hp__ben { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 14px; width: 100%; margin: 0; padding: 14px 0; list-style: none; border-top: 1px solid var(--rf-line); border-bottom: 1px solid var(--rf-line); }
  .rf-hp__ben li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; line-height: 1.3; }
  .rf-hp__ben svg { flex: none; width: 22px; height: 22px; color: var(--rf-violet); }
  .rf-hp__tiers { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
  .rf-hp__tier { position: relative; padding: 14px; border-radius: 18px; background: var(--rf-card); box-shadow: inset 0 0 0 1.5px var(--rf-line); }
  .rf-hp__tier--prem { background: var(--rf-ink); box-shadow: none; color: #fff; }
  .rf-hp__tier-badge { position: absolute; top: -10px; right: 12px; padding: 3px 10px; border-radius: 999px; background: var(--rf-lime); color: var(--rf-ink); font-size: 11px; font-weight: 800; white-space: nowrap; }
  .rf-hp__tier-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 8px; margin: 0; }
  .rf-hp__tier-name { font-size: 15px; font-weight: 800; }
  .rf-hp__tier-price { font-size: 22px; font-weight: 800; letter-spacing: -0.03em; }
  .rf-hp__tier--prem .rf-hp__tier-price { color: var(--rf-lime); }
  .rf-hp__tier-txt { margin: 6px 0 0; font-size: 13px; line-height: 1.45; color: var(--rf-ink-soft); }
  .rf-hp__tier--prem .rf-hp__tier-txt { color: var(--rf-lilac); }
  .rf-hp__cta { width: 100%; margin-top: 4px; }
  .rf-hp__cta svg { width: 20px; height: 20px; }
  .rf-hp__fine { margin: -4px 0 0; width: 100%; text-align: center; font-size: 13px; color: var(--rf-ink-soft); }
  .rf-hp__trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 100%; margin: 0; padding: 14px 10px; list-style: none; border-radius: 18px; background: var(--rf-ink); color: #fff; }
  .rf-hp__trust li { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; font-size: 12px; font-weight: 600; line-height: 1.3; }
  .rf-hp__trust-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgb(212 245 60 / .14); color: var(--rf-lime); }
  .rf-hp__trust-ic svg { width: 17px; height: 17px; }
  .rf-hp__date { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 14px; font-weight: 600; }
  .rf-hp__date svg { flex: none; width: 18px; height: 18px; color: var(--rf-violet); }
  @media (min-width: 750px) {
    .rf-hp__inner { padding: 0 24px; }
    .rf-hp__thumb { flex-basis: 76px; }
    .rf-hp__trust li { flex-direction: row; justify-content: center; text-align: left; font-size: 13px; }
  }
  @media (min-width: 990px) {
    .rf-hp { padding: 32px 0 72px; }
    .rf-hp__inner { grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: 56px; align-items: start; }
    .rf-hp__gallery { position: sticky; top: calc(var(--header-height, 64px) + 16px); }
    .rf-hp__info { gap: 16px; padding-top: 8px; }
    .rf-hp__sub { font-size: 17px; }
    .rf-hp__trust li { flex-direction: column; text-align: center; }
  }
{% endstylesheet %}
{% javascript %}
  if (!customElements.get('refrain-hero-gallery')) {
    class RefrainHeroGallery extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('refrain-rail');
        this.thumbs = [...this.querySelectorAll('[data-rf-slide]')];
        if (!this.track || !this.thumbs.length) return;
        this.thumbs.forEach((t) => t.addEventListener('click', () => {
          const i = Number(t.dataset.rfSlide);
          this.track.scrollTo({ left: i * this.track.clientWidth, behavior: 'smooth' });
          this.mark(i);
        }));
        let raf = 0;
        this.track.addEventListener('scroll', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => this.mark(Math.round(this.track.scrollLeft / Math.max(1, this.track.clientWidth))));
        }, { passive: true });
      }
      mark(i) {
        this.thumbs.forEach((t, n) => {
          t.classList.toggle('is-active', n === i);
          if (n === i) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
        });
      }
    }
    customElements.define('refrain-hero-gallery', RefrainHeroGallery);
  }
{% endjavascript %}
{% schema %}
{
  "name": "Refrain · Product hero",
  "tag": "section",
  "class": "rf-hp-section",
  "settings": [
    { "type": "text", "id": "gallery_label", "label": "Gallery accessible name", "default": "Images du produit" },
    { "type": "header", "content": "Trust card" },
    { "type": "text", "id": "card_title", "label": "Card title (empty hides the card)", "default": "Écoutez avant de payer" },
    { "type": "text", "id": "card_text", "label": "Card text", "default": "Un extrait gratuit de sa chanson, avant toute commande." },
    { "type": "header", "content": "Rating line" },
    { "type": "text", "id": "rating_text", "label": "Rating text (empty hides the line)", "default": "Lire les avis" },
    { "type": "text", "id": "rating_link", "label": "Rating link (anchor of the reviews section)", "default": "#avis" },
    { "type": "header", "content": "Title" },
    { "type": "text", "id": "heading", "label": "Heading (wrap one word in *asterisks*)", "default": "Chanson personnalisée — son prénom dans le *refrain*" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Une chanson écrite à partir de vos souvenirs. Écoutez son extrait gratuit, puis décidez." },
    { "type": "header", "content": "Benefits (2x2)" },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Son prénom dans le refrain" },
    { "type": "select", "id": "benefit_icon_1", "label": "Icon 1", "default": "music", "options": [ { "value": "music", "label": "Music" }, { "value": "pen", "label": "Pen" }, { "value": "heart", "label": "Heart" }, { "value": "refresh", "label": "Refresh" }, { "value": "ear", "label": "Ear" }, { "value": "mic", "label": "Mic" }, { "value": "gift", "label": "Gift" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Écrite à partir de vos souvenirs" },
    { "type": "select", "id": "benefit_icon_2", "label": "Icon 2", "default": "pen", "options": [ { "value": "music", "label": "Music" }, { "value": "pen", "label": "Pen" }, { "value": "heart", "label": "Heart" }, { "value": "refresh", "label": "Refresh" }, { "value": "ear", "label": "Ear" }, { "value": "mic", "label": "Mic" }, { "value": "gift", "label": "Gift" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "2 chansons + paroles complètes" },
    { "type": "select", "id": "benefit_icon_3", "label": "Icon 3", "default": "heart", "options": [ { "value": "music", "label": "Music" }, { "value": "pen", "label": "Pen" }, { "value": "heart", "label": "Heart" }, { "value": "refresh", "label": "Refresh" }, { "value": "ear", "label": "Ear" }, { "value": "mic", "label": "Mic" }, { "value": "gift", "label": "Gift" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "text", "id": "benefit_4", "label": "Benefit 4", "default": "Révisions illimitées" },
    { "type": "select", "id": "benefit_icon_4", "label": "Icon 4", "default": "refresh", "options": [ { "value": "music", "label": "Music" }, { "value": "pen", "label": "Pen" }, { "value": "heart", "label": "Heart" }, { "value": "refresh", "label": "Refresh" }, { "value": "ear", "label": "Ear" }, { "value": "mic", "label": "Mic" }, { "value": "gift", "label": "Gift" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "header", "content": "Tier summary" },
    { "type": "text", "id": "std_name", "label": "Standard name", "default": "Standard" },
    { "type": "text", "id": "std_price", "label": "Standard price", "default": "19 €" },
    { "type": "text", "id": "std_text", "label": "Standard summary", "default": "2 chansons complètes et leurs paroles, sous 24 h." },
    { "type": "text", "id": "prem_name", "label": "Premium name", "default": "Premium" },
    { "type": "text", "id": "prem_price", "label": "Premium price", "default": "35 €" },
    { "type": "text", "id": "prem_badge", "label": "Premium badge", "default": "Pour l'offrir en grand" },
    { "type": "text", "id": "prem_text", "label": "Premium summary", "default": "Tout le Standard, le clip paroles animé et la pochette, sous 12 h." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Créer son extrait gratuit" },
    { "type": "text", "id": "cta_link", "label": "Button link (quiz anchor)", "default": "#quiz" },
