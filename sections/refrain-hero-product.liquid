    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "trust_1", "label": "Item 1", "default": "Écoutez avant de payer" },
    { "type": "select", "id": "trust_icon_1", "label": "Icon 1", "default": "ear", "options": [ { "value": "ear", "label": "Ear" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }, { "value": "mail", "label": "Mail" }, { "value": "shield", "label": "Shield" }, { "value": "clock", "label": "Clock" } ] },
    { "type": "text", "id": "trust_2", "label": "Item 2", "default": "Révisions illimitées" },
    { "type": "select", "id": "trust_icon_2", "label": "Icon 2", "default": "refresh", "options": [ { "value": "ear", "label": "Ear" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }, { "value": "mail", "label": "Mail" }, { "value": "shield", "label": "Shield" }, { "value": "clock", "label": "Clock" } ] },
    { "type": "text", "id": "trust_3", "label": "Item 3", "default": "Paiement sécurisé" },
    { "type": "select", "id": "trust_icon_3", "label": "Icon 3", "default": "lock", "options": [ { "value": "ear", "label": "Ear" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }, { "value": "mail", "label": "Mail" }, { "value": "shield", "label": "Shield" }, { "value": "clock", "label": "Clock" } ] },
    { "type": "text", "id": "date_note", "label": "Real delivery date note (empty hides it)", "default": "Livrée avant Noël si commandée avant le 20 déc." }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme asset file name", "default": "refrain-product-premium.jpg" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Tout ce que contient la chanson personnalisée Refrain Premium" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refrain · Product hero",
      "blocks": [
        { "type": "slide", "settings": { "image_asset": "refrain-product-premium.jpg" } },
        { "type": "slide", "settings": { "image_asset": "refrain-hero-couple-square.jpg", "alt": "Un homme ému écoute la chanson que sa femme lui offre" } }
      ]
    }
  ]
}
{% endschema %}
