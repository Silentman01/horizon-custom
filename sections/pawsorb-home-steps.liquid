{%- render 'pawsorb-home-base' -%}
<section class="pawsorb-h pawsorb-h--tint pawsorb-hs" aria-label="{{ section.settings.heading | escape }}">
  <div class="pawsorb-h__wrap">
    <h2 class="pawsorb-h__h2 pawsorb-h__center">{{ section.settings.heading }}</h2>
    <ol class="pawsorb-h__rail pawsorb-hs__list" role="list">
      {%- for block in section.blocks -%}
        {%- capture ps_img -%}{%- render 'pawsorb-home-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, sizes: '(min-width: 750px) 25vw, 60vw' -%}{%- endcapture -%}
        <li class="pawsorb-hs__card" {{ block.shopify_attributes }}>
          {%- if ps_img != blank -%}
            <div class="pawsorb-h__media pawsorb-hs__media">{{ ps_img }}<span class="pawsorb-hs__num">{{ forloop.index }}</span></div>
          {%- else -%}
            <div class="pawsorb-hs__art"><span class="pawsorb-hs__num">{{ forloop.index }}</span>{%- render 'pawsorb-home-icon', name: block.settings.icon -%}</div>
          {%- endif -%}
          <p class="pawsorb-hs__title">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}<p class="pawsorb-hs__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.footer_line != blank -%}<p class="pawsorb-hs__line">{{ section.settings.footer_line }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
.pawsorb-h__rail.pawsorb-hs__list{list-style:none;margin-top:20px;margin-bottom:0}
.pawsorb-hs__card{width:44%;min-width:160px;background:#fff;border:1px solid #DCE6E0;border-radius:12px;padding:10px 10px 14px}
.pawsorb-hs__media,.pawsorb-hs__art{position:relative;aspect-ratio:4/5;border-radius:14px}
.pawsorb-hs__art{background:linear-gradient(180deg,#121614,#1E2622);color:#fff;display:grid;place-items:center}
.pawsorb-hs__art svg{width:56px;height:56px}
.pawsorb-hs__num{position:absolute;top:10px;left:10px;width:34px;height:34px;border-radius:50%;background:#12855A;color:#fff;font-weight:700;font-size:17px;display:grid;place-items:center}
.pawsorb-hs__title{margin:12px 4px 0;font-weight:700;font-size:18px}
.pawsorb-hs__text{margin:4px 4px 0;font-size:14px;line-height:1.45;color:#5D6A63}
.pawsorb-hs__line{margin:20px 0 0;text-align:center;font-weight:700;font-size:16px}
@media (min-width:750px){
  .pawsorb-h__rail.pawsorb-hs__list{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .pawsorb-hs__card{width:auto;min-width:0}
  .pawsorb-hs__art,.pawsorb-hs__media{aspect-ratio:4/3}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb home steps",
  "tag": "div",
  "class": "pawsorb-home-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four moves. One minute. Then the vet." },
    { "type": "text", "id": "footer_line", "label": "Line under the steps", "default": "Anyone in your house can do it." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Wipe" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "select", "id": "icon", "label": "Icon (used without image)", "default": "wipe", "options": [
          { "value": "wipe", "label": "Wipe" }, { "value": "dial", "label": "Dial" }, { "value": "squeeze", "label": "Squeeze" }, { "value": "phone", "label": "Phone" } ] },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Fallback theme asset", "info": "e.g. pawsorb-step-1-wipe.jpg. Empty = icon." }
      ]
    }
  ],
  "presets": [{ "name": "PawSorb home steps", "blocks": [{ "type": "step" }] }]
}
{% endschema %}
