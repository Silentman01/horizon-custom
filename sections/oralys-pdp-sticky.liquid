{%- liquid
  assign s = section.settings
  assign p = product
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant | default: p.first_available_variant
  assign img = v.featured_image | default: p.featured_image
  assign has_compare = v.compare_at_price | default: 0
  if has_compare > v.price
    assign show_compare = true
  else
    assign show_compare = false
  endif
-%}
{%- style -%}
  .oralys-pdp-sk-{{ section.id }} {
    --ops-bg: {{ s.c_bg }};
    --ops-text: {{ s.c_text }};
    --ops-btn: {{ s.c_btn }};
    --ops-btn-text: {{ s.c_btn_text }};
    --ops-muted: {{ s.c_muted }};
    --ops-save: {{ s.c_save }};
  }
{%- endstyle -%}

<div
  class="oralys-pdp-sk oralys-pdp-sk-{{ section.id }}{% if request.design_mode %} is-visible{% endif %}"
  data-oralys-pdp-sticky
  data-offset="{{ s.show_after }}"
  data-hide-at="{{ s.hide_near }}"
  aria-label="{{ s.btn_label | escape }}"
>
  <div class="oralys-pdp-sk__in">
    {%- if img != blank -%}
      <span class="oralys-pdp-sk__thumb">
        {{ img | image_url: width: 96 | image_tag: loading: 'lazy', alt: p.title, class: 'oralys-pdp-sk__img', srcset: null, sizes: null }}
      </span>
    {%- endif -%}

    <span class="oralys-pdp-sk__info">
      <span class="oralys-pdp-sk__title">{{ p.title }}</span>
      <span class="oralys-pdp-sk__price">
        <span class="oralys-pdp-sk__tier" data-ops-label hidden></span>
        <s class="oralys-pdp-sk__was" data-ops-was{% unless show_compare %} hidden{% endunless %}>{% if show_compare %}{{ v.compare_at_price | money }}{% endif %}</s>
        <b class="oralys-pdp-sk__now" data-ops-now>{{ v.price | money }}</b>
        {%- liquid
          assign saved = ''
          if show_compare
            assign saved = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
          endif
        -%}
        <span class="oralys-pdp-sk__save" data-ops-save{% if saved == '' %} hidden{% endif %}>{% if saved != '' %}-{{ saved }} %{% endif %}</span>
      </span>
    </span>

    <a href="#oralys-pdp-offer" class="oralys-pdp-sk__btn">
      <span>{{ s.btn_label }}</span>
    </a>
  </div>
</div>
<div class="oralys-pdp-sk__spacer" aria-hidden="true"></div>

<script>
  (function () {
    var els = document.querySelectorAll('[data-oralys-pdp-sticky]');
    els.forEach(function (bar) {
      if (bar._bound) return;
      bar._bound = true;
      var showAfter = parseInt(bar.dataset.offset, 10) || 600;
      var hideNear = parseInt(bar.dataset.hideAt, 10) || 200;

      function target() {
        return document.getElementById('oralys-pdp-offer')
          || document.querySelector('.oralys-pdp-bundle')
          || document.querySelector('.buy-buttons-block');
      }

      function tick() {
        if (window.Shopify && window.Shopify.designMode) {
          bar.classList.add('is-visible');
          return;
        }
        var t = target();
        if (t) {
          var rect = t.getBoundingClientRect();
          var inView = rect.top < window.innerHeight - hideNear && rect.bottom > hideNear;
          bar.classList.toggle('is-visible', window.scrollY > showAfter && !inView);
        } else {
          bar.classList.toggle('is-visible', window.scrollY > showAfter);
        }
      }

      window.addEventListener('scroll', tick, { passive: true });
      window.addEventListener('resize', tick, { passive: true });
      tick();

      // Mirror the selected pack (label + price) from the Oralys pack cards.
      var elLabel = bar.querySelector('[data-ops-label]'), elWas = bar.querySelector('[data-ops-was]'),
          elNow = bar.querySelector('[data-ops-now]'), elSave = bar.querySelector('[data-ops-save]');
      function paint(d) {
        if (!d || !d.price) return;
        if (elLabel) { elLabel.textContent = d.label || ''; elLabel.hidden = !d.label; }
        bar.classList.toggle('has-tier', !!d.label);
        if (elNow) elNow.textContent = d.price;
        if (elWas) { elWas.textContent = d.compare || ''; elWas.hidden = !d.compare; }
        if (elSave) {
          var pc = parseInt(d.priceCents, 10), cc = parseInt(d.compareCents, 10);
          var pct = pc > 0 && cc > pc ? Math.floor((cc - pc) * 100 / cc) : 0;
          elSave.textContent = pct ? '-' + pct + ' %' : '';
          elSave.hidden = !pct;
        }
      }
      function fromDom() {
        var i = document.querySelector('.oralys-pdp-tier__input:checked');
        return i ? { label: i.dataset.label, price: i.dataset.price, compare: i.dataset.compare, priceCents: i.dataset.priceCents, compareCents: i.dataset.compareCents } : null;
      }
      paint(fromDom());
      document.addEventListener('oralys:tier', function (e) { paint(e.detail); });
      window.addEventListener('pageshow', function (e) { if (e.persisted) paint(fromDom()); });
    });
  })();
</script>

{% stylesheet %}
  .oralys-pdp-sk {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 30;
    background: var(--ops-bg, #fff);
    color: var(--ops-text, #17221E);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.10);
    transform: translateY(110%);
    transition: transform 0.25s ease;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .oralys-pdp-sk.is-visible { transform: none; }
  .oralys-pdp-sk__in {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
  }
  .oralys-pdp-sk__thumb {
    flex: 0 0 46px;
    width: 46px; height: 46px;
    border-radius: 10px;
    overflow: hidden;
    background: #f3f3f3;
  }
  .oralys-pdp-sk__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .oralys-pdp-sk__info {
    flex: 1; min-width: 0;
    display: flex; flex-direction: column;
    line-height: 1.25;
  }
  .oralys-pdp-sk__title {
    font-weight: 700; font-size: 14px;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .oralys-pdp-sk__price { font-size: 13.5px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; row-gap: 0; }
  .oralys-pdp-sk__price [hidden] { display: none; }
  .oralys-pdp-sk__tier { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .oralys-pdp-sk__now { font-weight: 800; }
  @media (max-width: 749px) {
    .oralys-pdp-sk.has-tier .oralys-pdp-sk__title { display: none; }
    .oralys-pdp-sk.has-tier .oralys-pdp-sk__tier { flex-basis: 100%; font-weight: 700; font-size: 14px; }
  }
  .oralys-pdp-sk__was { color: var(--ops-muted, #888); text-decoration: line-through; font-size: 12.5px; }
  .oralys-pdp-sk__save {
    font-size: 11.5px; font-weight: 700;
    color: var(--ops-save, #D2382C);
  }
  .oralys-pdp-sk__btn {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 40px;
    background: var(--ops-btn, #D2382C);
    color: var(--ops-btn-text, #fff);
    font-weight: 700; font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .oralys-pdp-sk__spacer { height: 76px; }
  @media (min-width: 990px) {
    .oralys-pdp-sk__in { gap: 16px; padding: 12px 20px; }
    .oralys-pdp-sk__title { font-size: 15px; }
    .oralys-pdp-sk__btn { padding: 0 28px; min-height: 50px; font-size: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : PDP sticky bar",
  "tag": "section",
  "class": "oralys-pdp-sk-wrap",
  "settings": [
    {
      "type": "text",
      "id": "btn_label",
      "label": "Texte du bouton",
      "default": "Je choisis mon pack"
    },
    {
      "type": "range",
      "id": "show_after",
      "label": "Apparaît après (scroll)",
      "min": 0, "max": 2000, "step": 50, "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "hide_near",
      "label": "Disparaît quand les packs sont à … du viewport",
      "min": 0, "max": 500, "step": 25, "unit": "px",
      "default": 200,
      "info": "Le bar se masque automatiquement quand le sélecteur de packs est visible à l'écran."
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Texte barré",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "c_save",
      "label": "Badge économie",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_btn",
      "label": "Bouton",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_btn_text",
      "label": "Bouton texte",
      "default": "#FFFFFF"
    }
  ],
  "presets": [ { "name": "Oralys : PDP sticky bar" } ]
}
{% endschema %}
