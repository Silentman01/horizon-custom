{%- assign s = section.settings -%}
<section class="mojo-tm mojo-tm--{{ s.layout | default: 'side' }} mojo-tm--{{ s.card_style | default: 'plain' }}" style="{% render 'mojo-vars' %}--mojo-pt:{{ s.padding_top }}px;--mojo-pb:{{ s.padding_bottom }}px;--mojo-star:{{ s.star_color }};--mojo-tm-n:{{ s.cards_desktop | default: 3 }};">
  <div class="mojo-tm__wrap" data-mojo-rail-wrap data-mojo-overflow="0">
    <div class="mojo-tm__sum">
      {%- if s.heading != blank -%}<h2 class="mojo-tm__heading">{{ s.heading }}</h2>{%- endif -%}
      <div class="mojo-tm__stars" role="img" aria-label="{{ s.rating }} out of 5 stars">
        {%- for i in (1..5) -%}<span class="mojo-tm__bigstar{% if i > s.rating %} is-off{% endif %}">{% render 'mojo-icon', name: 'star', size: 20 %}</span>{%- endfor -%}
      </div>
      {%- if s.count_text != blank -%}<p class="mojo-tm__count">{{ s.count_text }}</p>{%- endif -%}
    </div>
    <div class="mojo-tm__stage">
      <button type="button" class="mojo-tm__arrow mojo-tm__arrow--prev" data-mojo-prev aria-label="Previous reviews">{% render 'mojo-icon', name: 'prev', size: 16 %}</button>
      <div class="mojo-tm__rail" data-mojo-rail>
        {%- for block in section.blocks -%}
          <article class="mojo-tm__card" {{ block.shopify_attributes }}>
            <div class="mojo-tm__cstars" aria-hidden="true">{%- for i in (1..5) -%}<span class="mojo-tm__sq">{% render 'mojo-icon', name: 'star', size: 12 %}</span>{%- endfor -%}</div>
            <h3 class="mojo-tm__title">{{ block.settings.title }}</h3>
            <p class="mojo-tm__body">{{ block.settings.text }}</p>
            <p class="mojo-tm__meta"><span>{{ block.settings.name }}</span>{% if block.settings.date != blank %} <span>{{ block.settings.date }}</span>{% endif %}</p>
            {%- if s.card_style == 'boxed' -%}<p class="mojo-tm__bar"><span>{{ block.settings.name }}</span>{% if s.footer_text != blank %}<span class="mojo-tm__ver">{% render 'mojo-icon', name: 'check', size: 12 %}{{ s.footer_text }}</span>{% endif %}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      <button type="button" class="mojo-tm__arrow mojo-tm__arrow--next" data-mojo-next aria-label="Next reviews">{% render 'mojo-icon', name: 'next', size: 16 %}</button>
    </div>
    <div class="mojo-tm__dots" data-mojo-dots></div>
  </div>
</section>

{% stylesheet %}
.mojo-tm { background: var(--mojo-bg); color: var(--mojo-fg); font-family: var(--mojo-font); padding: var(--mojo-pt) 0 var(--mojo-pb); }
.mojo-tm__wrap { max-width: 1100px; margin: 0 auto; padding-inline: 20px; }
.mojo-tm__sum { text-align: center; margin-bottom: 24px; }
.mojo-tm__heading { font-family: var(--mojo-font-heading); font-weight: 600; font-size: 26px; line-height: 1.2; margin: 0 0 10px; }
.mojo-tm__stars { display: inline-flex; gap: 3px; }
.mojo-tm__bigstar, .mojo-tm__sq { display: inline-flex; align-items: center; justify-content: center; background: var(--mojo-star); color: #fff; }
.mojo-tm__bigstar { width: 30px; height: 30px; }
.mojo-tm__bigstar.is-off { background: var(--mojo-line); }
.mojo-tm__sq { width: 20px; height: 20px; }
.mojo-tm__count { margin: 8px 0 0; font-size: 13px; }
.mojo-tm__stage { position: relative; min-width: 0; }
.mojo-tm__rail { margin: 0 -20px; padding-inline: 20px; scroll-padding-inline: 20px; }
.mojo-tm__card { flex: 0 0 74%; scroll-snap-align: start; box-sizing: border-box; padding: 4px 8px 4px 0; }
.mojo-tm__cstars { display: inline-flex; gap: 2px; margin-bottom: 10px; }
.mojo-tm__title { font-family: var(--mojo-font-heading); font-weight: 600; font-size: 15px; margin: 0 0 8px; }
.mojo-tm__body { font-size: 13px; line-height: 1.55; margin: 0 0 10px; }
.mojo-tm__meta { font-size: 11px; color: var(--mojo-soft); margin: 0; display: flex; gap: 8px; }
.mojo-tm__arrow { display: none; }
.mojo-tm--stacked .mojo-tm__sum { display: flex; flex-direction: column; align-items: center; text-align: center; }
.mojo-tm--stacked .mojo-tm__stars { order: 0; }
.mojo-tm--stacked .mojo-tm__count { order: 1; margin: 8px 0 14px; }
.mojo-tm--stacked .mojo-tm__heading { order: 2; font-size: 30px; }
.mojo-tm--boxed .mojo-tm__card { display: flex; flex-direction: column; background: var(--mojo-bg); border: 1px solid var(--mojo-line); padding: 0; }
.mojo-tm--boxed .mojo-tm__cstars, .mojo-tm--boxed .mojo-tm__title, .mojo-tm--boxed .mojo-tm__body { margin-inline: 16px; }
.mojo-tm--boxed .mojo-tm__cstars { margin-top: 16px; }
.mojo-tm--boxed .mojo-tm__body { flex: 1; }
.mojo-tm--boxed .mojo-tm__meta { display: none; }
.mojo-tm__bar { display: none; margin: 0; padding: 10px 16px; background: var(--mojo-primary); color: var(--mojo-cream); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; justify-content: space-between; align-items: center; gap: 8px; }
.mojo-tm--boxed .mojo-tm__bar { display: flex; }
.mojo-tm__ver { display: inline-flex; align-items: center; gap: 5px; }

.mojo-tm__rail { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; -webkit-overflow-scrolling: touch; }
.mojo-tm__rail::-webkit-scrollbar { display: none; }
.mojo-tm__rail[data-mojo-dragging] { scroll-snap-type: none; cursor: grabbing; user-select: none; }
.mojo-tm__dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
.mojo-tm__dots button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: var(--mojo-line); cursor: pointer; }
.mojo-tm__dots button[aria-current='true'] { background: var(--mojo-primary); }
[data-mojo-overflow='0'] > .mojo-tm__dots { display: none; }
@media screen and (min-width: 750px) {
  .mojo-tm__wrap { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; align-items: center; }
  .mojo-tm__sum { text-align: left; margin: 0; }
  .mojo-tm__heading { font-size: 20px; }
  .mojo-tm__bigstar { width: 26px; height: 26px; }
  .mojo-tm__rail { margin: 0 44px; padding: 0; scroll-padding-inline: 0; gap: 20px; }
  .mojo-tm__card { flex: 0 0 calc((100% - (var(--mojo-tm-n) - 1) * 20px) / var(--mojo-tm-n)); padding: 0; }
  .mojo-tm__title { font-size: 13px; }
  .mojo-tm__body { font-size: 12px; }
  .mojo-tm__arrow { display: flex; position: absolute; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border-radius: 50%; background: var(--mojo-bg); border: 1px solid var(--mojo-line); color: var(--mojo-fg); align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  .mojo-tm--stacked .mojo-tm__wrap { display: block; max-width: 1280px; }
  .mojo-tm--stacked .mojo-tm__sum { margin-bottom: 32px; }
  .mojo-tm--stacked .mojo-tm__heading { font-size: 40px; }
  .mojo-tm__arrow--prev { left: 0; }
  .mojo-tm__arrow--next { right: 0; }
  .mojo-tm__arrow:disabled { opacity: 0.35; cursor: default; }
  .mojo-tm__dots { display: none; }
}
{% endstylesheet %}

{% javascript %}
if (!window.mojoRails) {
  window.mojoRails = true;
  const setup = (rail) => {
    if (rail.dataset.mojoReady) return;
    rail.dataset.mojoReady = '1';
    const wrap = rail.closest('[data-mojo-rail-wrap]') || rail.parentElement;
    const dots = wrap.querySelector('[data-mojo-dots]');
    const prev = wrap.querySelector('[data-mojo-prev]');
    const next = wrap.querySelector('[data-mojo-next]');
    const cards = () => [...rail.children];
    const step = () => {
      const c = cards();
      if (c.length > 1) return c[1].getBoundingClientRect().left - c[0].getBoundingClientRect().left;
      return c[0] ? c[0].getBoundingClientRect().width : 0;
    };
    const index = () => { const s = step(); return s ? Math.round(rail.scrollLeft / s) : 0; };
    const sync = () => {
      const over = rail.scrollWidth > rail.clientWidth + 2;
      wrap.dataset.mojoOverflow = over ? '1' : '0';
      if (dots) {
        if (dots.children.length !== cards().length) {
          dots.textContent = '';
          cards().forEach((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', 'Go to item ' + (i + 1));
            b.addEventListener('click', () => rail.scrollTo({ left: i * step(), behavior: 'smooth' }));
            dots.appendChild(b);
          });
        }
        const at = index();
        [...dots.children].forEach((b, i) => b.setAttribute('aria-current', i === at ? 'true' : 'false'));
      }
      if (prev) prev.disabled = rail.scrollLeft <= 2;
      if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    if (prev) prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.setAttribute('data-mojo-dragging', ''); rail.setPointerCapture(id); }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.removeAttribute('data-mojo-dragging');
      rail.scrollLeft = left;
      const s = step();
      if (s) rail.scrollTo({ left: Math.round(left / s) * s, behavior: 'smooth' });
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    sync();
    setTimeout(sync, 400);
  };
  const init = () => document.querySelectorAll('[data-mojo-rail]').forEach(setup);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('shopify:section:load', init);
}
{% endjavascript %}

{% schema %}
{
  "name": "Mojo testimonials",
  "tag": "section",
  "class": "mojo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by 175k+ Men"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Stars filled",
      "default": 5,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Review count text",
      "default": "Based on 4,276 reviews"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#6B1E2E"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout (optional)"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "side",
      "options": [
        {
          "value": "side",
          "label": "Summary left, cards right"
        },
        {
          "value": "stacked",
          "label": "Summary on top, cards below"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "boxed",
          "label": "Boxed with black footer bar"
        }
      ]
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer bar text after the name (boxed cards)",
      "default": "Verified buyer"
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "label": "Cards visible on desktop",
      "default": 3,
      "min": 2,
      "max": 4,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Surprisingly Comfortable"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "I didn't know what to expect, but these surprised me. Light, comfortable, and they actually stay put."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Mark T."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "3 days ago"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Mojo testimonials",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
