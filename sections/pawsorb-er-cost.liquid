{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-er" style="--pawsorb-er-pt: {{ ss.padding_top }}px; --pawsorb-er-pb: {{ ss.padding_bottom }}px; --pawsorb-er-bg: {{ ss.bg_color }}; --pawsorb-er-fg: {{ ss.text_color }}; --pawsorb-er-accent: {{ ss.accent_color }};">
  <div class="pawsorb-er__inner">
    {%- if ss.heading != blank -%}<h2 class="pawsorb-er__h">{{ ss.heading }}</h2>{%- endif -%}
    <div class="pawsorb-er__stats">
      {%- for block in section.blocks -%}
        <div class="pawsorb-er__stat{% if block.settings.highlight %} is-hl{% endif %}" {{ block.shopify_attributes }}>
          <span class="pawsorb-er__num">{{ block.settings.number }}</span>
          <span class="pawsorb-er__lbl">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
    {%- if ss.body != blank -%}<p class="pawsorb-er__body">{{ ss.body }}</p>{%- endif -%}
    {%- if ss.button_label != blank -%}
      <div class="pawsorb-er__cta"><a class="pawsorb-er__btn" href="{{ ss.button_link | default: '/products/pawsorb' }}" data-pawsorb-cta>{{ ss.button_label }}</a></div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-er { padding: var(--pawsorb-er-pt, 64px) 0 var(--pawsorb-er-pb, 64px); background: var(--pawsorb-er-bg, #fff); color: var(--pawsorb-er-fg, #141816); }
  .pawsorb-er__inner { max-width: 1000px; margin: 0 auto; padding: 0 16px; text-align: center; }
  .pawsorb-er__h { margin: 0 0 26px; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-er__stats { display: grid; grid-template-columns: repeat(3, 1fr); border-radius: 12px; overflow: hidden; background: #F1F6F3; border: 1px solid #DCE6E0; }
  .pawsorb-er__stat { display: flex; flex-direction: column; gap: 6px; padding: 26px 16px; }
  .pawsorb-er__stat + .pawsorb-er__stat { border-left: 1px solid #DCE6E0; }
  .pawsorb-er__stat.is-hl { background: #fff; box-shadow: inset 0 -4px 0 var(--pawsorb-er-accent, #12855A); }
  .pawsorb-er__num { font: 700 36px/1.05 var(--font-heading--family); color: #121614; letter-spacing: -.02em; }
  .pawsorb-er__stat.is-hl .pawsorb-er__num { color: var(--pawsorb-er-accent, #12855A); }
  .pawsorb-er__lbl { font-size: 15px; color: #5D6A63; }
  .pawsorb-er__body { max-width: 640px; margin: 22px auto 0; font-size: 17px; line-height: 1.55; }
  .pawsorb-er__cta { margin-top: 22px; }
  .pawsorb-er__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 30px; border-radius: 10px; background: var(--pawsorb-er-accent, #12855A); color: #fff; font: 700 16px/1 var(--font-heading--family); text-decoration: none; letter-spacing: .02em; }
  .pawsorb-er__btn:hover { background: #0C5E40; }
  @media screen and (max-width: 749px) {
    .pawsorb-er { padding: calc(var(--pawsorb-er-pt, 64px) * .75) 0 calc(var(--pawsorb-er-pb, 64px) * .75); }
    .pawsorb-er__h { font-size: 26px; margin-bottom: 18px; }
    .pawsorb-er__stats { grid-template-columns: 1fr; }
    .pawsorb-er__stat { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 12px; padding: 16px 18px; text-align: left; }
    .pawsorb-er__stat + .pawsorb-er__stat { border-left: 0; border-top: 1px solid #DCE6E0; }
    .pawsorb-er__stat.is-hl { box-shadow: inset 4px 0 0 var(--pawsorb-er-accent, #12855A); }
    .pawsorb-er__num { font-size: 26px; white-space: nowrap; }
    .pawsorb-er__lbl { font-size: 14px; text-align: right; }
    .pawsorb-er__body { font-size: 16px; text-align: left; }
    .pawsorb-er__btn { width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb cost stat bar",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "$1,500–$5,000" },
        { "type": "text", "id": "label", "label": "Label", "default": "ER bill for one poisoning" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A poisoning visit, or a tube in the drawer?" },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Poison soaks in within 60 minutes. The bill only grows the longer you wait. One tube, kept for 2 years, lets you act in minute one." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get my tubes ready" },
    { "type": "url", "id": "button_link", "label": "Button link (pages without the picker)", "info": "On the product page the button scrolls to the bundle picker. Blank = /products/pawsorb" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb cost stat bar",
      "blocks": [
        { "type": "stat", "settings": { "number": "$1,500–$5,000", "label": "ER bill for one poisoning" } },
        { "type": "stat", "settings": { "number": "$95", "label": "one call to a paid poison line" } },
        { "type": "stat", "settings": { "number": "$24.99", "label": "per tube when you buy 3", "highlight": true } }
      ]
    }
  ]
}
{% endschema %}
