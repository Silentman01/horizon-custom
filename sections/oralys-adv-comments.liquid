{%- liquid
  assign s = section.settings
-%}
{%- style -%}
  .oralys-adv-cm-{{ section.id }} {
    {% if s.color_bg != blank %}background: {{ s.color_bg }};{% endif %}
    --oralys-adv-cm-reply: {{ s.color_reply_bg }};
    --oralys-adv-cm-name: {{ s.color_name }};
    padding-top: {{ s.pad_top_mobile }}px;
    padding-bottom: {{ s.pad_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    .oralys-adv-cm-{{ section.id }} { padding-top: {{ s.pad_top }}px; padding-bottom: {{ s.pad_bottom }}px; }
  }
{%- endstyle -%}

<div class="oralys-adv-cm oralys-adv-cm-{{ section.id }}">
  <div class="oralys-adv-cm__in">
    <div class="oralys-adv-cm__top">
      {%- if s.heading != blank -%}<h2 class="oralys-adv-cm__h">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.sort_label != blank -%}<span class="oralys-adv-cm__sort">{{ s.sort_label }}</span>{%- endif -%}
    </div>
    <ol class="oralys-adv-cm__list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign initial = b.name | slice: 0 | upcase -%}
        <li class="oralys-adv-cm__c{% if b.is_reply %} oralys-adv-cm__c--reply{% endif %}" {{ block.shopify_attributes }}>
          <span class="oralys-adv-cm__av" style="background: {{ b.avatar_color }}">
            <span aria-hidden="true">{{ initial }}</span>
            {%- if b.avatar != blank or b.avatar_asset != blank -%}
              <span class="oralys-adv-cm__av-ph" data-oralys-adv-media>
                {%- render 'oralys-adv-media', image: b.avatar, asset: b.avatar_asset, alt: b.name, class: 'oralys-adv-cm__av-img', sizes: '44px' -%}
              </span>
            {%- endif -%}
          </span>
          <div class="oralys-adv-cm__main">
            <p class="oralys-adv-cm__meta">
              <span class="oralys-adv-cm__name">{{ b.name }}</span>
              {%- if b.badge != blank -%}<span class="oralys-adv-cm__badge">{{ b.badge }}</span>{%- endif -%}
            </p>
            <div class="oralys-adv-cm__txt">{{ b.text | newline_to_br }}</div>
            {%- if b.photo != blank or b.photo_asset != blank -%}
              <div class="oralys-adv-cm__photo" data-oralys-adv-media>
                {%- render 'oralys-adv-media', image: b.photo, asset: b.photo_asset, alt: b.name, class: 'oralys-adv-cm__photo-img', sizes: '260px' -%}
              </div>
            {%- endif -%}
            <p class="oralys-adv-cm__acts">
              <span>{{ s.like_label }}</span>
              <span>{{ s.reply_label }}</span>
              {%- if b.likes != blank -%}<span class="oralys-adv-cm__likes"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M2 7h2.5v7H2zM6 14V7.4l3.2-5.2c.7-.6 1.9-.1 1.8.9L10.6 6H14c.8 0 1.4.8 1.2 1.6l-1.3 5.2c-.2.7-.8 1.2-1.5 1.2z"/></svg>{{ b.likes }}</span>{%- endif -%}
              {%- if b.time != blank -%}<span class="oralys-adv-cm__time">{{ b.time }}</span>{%- endif -%}
            </p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.closed_note != blank -%}<p class="oralys-adv-cm__closed">{{ s.closed_note }}</p>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .oralys-adv-cm__in { max-width: var(--oralys-adv-measure, 700px); margin: 0 auto; padding: 0 16px; }
  .oralys-adv-cm__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-bottom: 2px solid var(--oralys-adv-text); padding-bottom: 8px; margin-bottom: 6px; }
  .oralys-adv-cm__h { margin: 0; font-family: var(--oralys-adv-font-head); font-weight: var(--oralys-adv-font-head-weight, 700); font-size: 21px; }
  .oralys-adv-cm__sort { font-size: 13px; color: var(--oralys-adv-muted); white-space: nowrap; }
  .oralys-adv-cm__list { list-style: none; margin: 0; padding: 0; }
  .oralys-adv-cm__c { display: flex; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--oralys-adv-line, #dce5e0); }
  .oralys-adv-cm__c--reply { margin-left: 32px; padding: 12px; border-bottom: 0; border-radius: 10px; background: var(--oralys-adv-cm-reply); margin-bottom: 4px; }
  .oralys-adv-cm__av {
    position: relative;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    color: #fff;
    font-weight: 700;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .oralys-adv-cm__av-ph { position: absolute; inset: 0; }
  .oralys-adv-cm__av-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .oralys-adv-cm__main { min-width: 0; flex: 1; }
  .oralys-adv-cm__meta { margin: 0 0 4px; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; }
  .oralys-adv-cm__name { font-weight: 700; font-size: 15px; color: var(--oralys-adv-cm-name); }
  .oralys-adv-cm__badge { font-size: 12px; color: var(--oralys-adv-accent); background: var(--oralys-adv-tint, #eef6f1); padding: 2px 8px; border-radius: 999px; }
  .oralys-adv-cm__txt { font-size: 16px; line-height: 1.5; }
  .oralys-adv-cm__photo { margin-top: 10px; max-width: 240px; border-radius: 10px; overflow: hidden; }
  .oralys-adv-cm__photo-img { display: block; width: 100%; height: auto; }
  .oralys-adv-cm__acts { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--oralys-adv-muted); }
  .oralys-adv-cm__acts > span:nth-child(-n+2) { font-weight: 700; color: var(--oralys-adv-cm-name); }
  .oralys-adv-cm__likes { display: inline-flex; gap: 4px; align-items: center; }
  .oralys-adv-cm__closed { margin: 14px 0 0; font-size: 13px; color: var(--oralys-adv-muted); text-align: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "Adv · Comments",
  "tag": "section",
  "class": "oralys-adv-cm-section",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Commentaires" },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "Les plus récents" },
    { "type": "text", "id": "like_label", "label": "Like action", "default": "J'aime" },
    { "type": "text", "id": "reply_label", "label": "Reply action", "default": "Répondre" },
    { "type": "text", "id": "closed_note", "label": "Note under the list" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background" },
    { "type": "color", "id": "color_name", "label": "Names and actions", "default": "#1F4E8C" },
    { "type": "color", "id": "color_reply_bg", "label": "Reply background", "default": "#F3F6F4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "comment",
      "name": "Comment",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Prénom N." },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Commentaire." },
        { "type": "text", "id": "time", "label": "Time", "default": "il y a 2 h" },
        { "type": "text", "id": "likes", "label": "Likes" },
        { "type": "checkbox", "id": "is_reply", "label": "Reply (indented)", "default": false },
        { "type": "color", "id": "avatar_color", "label": "Initial background", "default": "#0E6B50" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar photo" },
        { "type": "text", "id": "avatar_asset", "label": "Avatar fallback (theme asset filename)" },
        { "type": "image_picker", "id": "photo", "label": "Attached photo" },
        { "type": "text", "id": "photo_asset", "label": "Attached photo fallback (theme asset filename)" }
      ]
    }
  ],
  "presets": [ { "name": "Adv · Comments", "blocks": [ { "type": "comment" } ] } ]
}
{% endschema %}
