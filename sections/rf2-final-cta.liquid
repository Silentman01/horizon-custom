{%- comment -%}
  Refrain v2 · last call to action: one button back to the quiz (#quiz), optional heading above it.
  Hidden while the quiz wait/reveal is on. Class prefix rf2-fc.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign brand = false
  if ss.font_heading == 'brand' or ss.font_body == 'brand'
    assign brand = true
  endif
-%}
{%- if brand -%}{% render 'refrain-fonts' %}{%- endif -%}
<div
  class="rf2-fc{% if ss.hide_mobile %} rf2-fc--hide-m{% endif %}{% if ss.hide_desktop %} rf2-fc--hide-d{% endif %}"
  style="--rf2-fc-bg: {{ ss.c_bg }}; --rf2-fc-text: {{ ss.c_text }}; --rf2-fc-accent: {{ ss.c_accent }}; --rf2-fc-btn: {{ ss.c_btn_bg }}; --rf2-fc-btn-text: {{ ss.c_btn_text }}; --rf2-fc-w: {{ ss.width }}px; --rf2-fc-title: {{ ss.title_size }}px; --rf2-fc-title-d: {{ ss.title_size_d }}px; --rf2-fc-btn-fs: {{ ss.button_size }}px; --rf2-fc-btn-h: {{ ss.button_height }}px; --rf2-fc-pt: {{ ss.pad_top }}px; --rf2-fc-pb: {{ ss.pad_bottom }}px; --rf2-fc-pt-d: {{ ss.pad_top_d }}px; --rf2-fc-pb-d: {{ ss.pad_bottom_d }}px; --rf2-fc-head: {% if ss.font_heading == 'brand' %}'Plus Jakarta Sans', {% endif %}var(--font-heading--family, system-ui), system-ui, sans-serif; --rf2-fc-body: {% if ss.font_body == 'brand' %}'Plus Jakarta Sans', {% endif %}var(--font-body--family, system-ui), system-ui, sans-serif; --rf2-fc-serif: {% if ss.font_heading == 'brand' %}'Fraunces', {% endif %}var(--font-heading--family, Georgia), Georgia, serif;"
>
  <div class="rf2-fc__in">
    {%- if ss.show_title and ss.title != blank -%}
      <h2 class="rf2-fc__title">{% render 'rf2-accent', text: ss.title %}</h2>
    {%- endif -%}
    {%- if ss.label != blank -%}
      <a class="rf2-fc__btn" href="#quiz">{{ ss.label | escape }}</a>
    {%- endif -%}
  </div>
</div>

<style>
  .rf2-fc { background: var(--rf2-fc-bg); color: var(--rf2-fc-text); font-family: var(--rf2-fc-body); padding: var(--rf2-fc-pt) 16px var(--rf2-fc-pb); }
  body.rf2-focus .rf2-fc { display: none; }
  .rf2-fc__in { max-width: var(--rf2-fc-w); margin: 0 auto; display: flex; flex-direction: column; align-items: stretch; gap: 16px; text-align: center; }
  .rf2-fc__title { margin: 0; font-family: var(--rf2-fc-head); font-weight: 800; font-size: var(--rf2-fc-title); line-height: 1.15; letter-spacing: -0.01em; }
  .rf2-fc__title em { font-family: var(--rf2-fc-serif); font-style: italic; font-weight: 600; color: var(--rf2-fc-accent); }
  .rf2-fc__btn { display: flex; align-items: center; justify-content: center; min-height: var(--rf2-fc-btn-h); padding: 0 22px; border-radius: 999px; background: var(--rf2-fc-btn); color: var(--rf2-fc-btn-text); font: 800 var(--rf2-fc-btn-fs)/1.2 var(--rf2-fc-body); text-decoration: none; }
  .rf2-fc__btn:focus-visible { outline: 3px solid var(--rf2-fc-text); outline-offset: 3px; }
  @media (max-width: 749px) { .rf2-fc--hide-m { display: none; } }
  @media (min-width: 750px) {
    .rf2-fc { padding-top: var(--rf2-fc-pt-d); padding-bottom: var(--rf2-fc-pb-d); }
    .rf2-fc__title { font-size: var(--rf2-fc-title-d); }
    .rf2-fc__in { align-items: center; }
    .rf2-fc__btn { min-width: 380px; }
    .rf2-fc--hide-d { display: none; }
  }
</style>

{% schema %}
{
  "name": "Refrain v2 · Final CTA",
  "tag": "section",
  "class": "rf2-final-cta-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_title", "label": "Show a heading above the button", "default": false },
    { "type": "text", "id": "title", "label": "Heading", "info": "Optional. Wrap one word in *stars* for the italic accent." },
    { "type": "text", "id": "label", "label": "Button label (goes to #quiz)", "default": "Écouter l’extrait gratuit de sa chanson" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#1E0F4A" },
    { "type": "color", "id": "c_text", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "c_accent", "label": "Italic accent", "default": "#D4F53C" },
    { "type": "color", "id": "c_btn_bg", "label": "Button background", "default": "#D4F53C" },
    { "type": "color", "id": "c_btn_text", "label": "Button text", "default": "#1E0F4A" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "font_heading", "label": "Heading font", "default": "brand", "options": [ { "value": "brand", "label": "Refrain (Plus Jakarta Sans + Fraunces)" }, { "value": "theme", "label": "Theme heading font" } ] },
    { "type": "select", "id": "font_body", "label": "Button font", "default": "brand", "options": [ { "value": "brand", "label": "Refrain (Plus Jakarta Sans)" }, { "value": "theme", "label": "Theme body font" } ] },
    { "type": "range", "id": "title_size", "label": "Heading size (mobile)", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "title_size_d", "label": "Heading size (desktop)", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "button_size", "label": "Button text size", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "button_height", "label": "Button height", "min": 44, "max": 72, "step": 2, "unit": "px", "default": 56 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "width", "label": "Content width", "min": 320, "max": 960, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "pad_top", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_top_d", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom_d", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on desktop", "default": false }
  ],
  "presets": [ { "name": "Refrain v2 · Final CTA" } ]
}
{% endschema %}
