{%- liquid
  assign s = section.settings
  assign h = s.heading
  if s.accent != blank
    assign acc = '<em>' | append: s.accent | append: '</em>'
    assign h = h | replace: s.accent, acc
  endif
-%}
<div class="oralys-pdp-sc" style="--op-bg:{{ s.c_bg }};--op-text:{{ s.c_text }};--op-accent:{{ s.c_accent }};--op-muted:{{ s.c_muted }};--op-card:{{ s.c_card }};--op-line:{{ s.c_line }};--op-cta:{{ s.c_cta }};--op-cta-text:{{ s.c_cta_text }};--op-h-m:{{ s.h_m }}px;--op-h-d:{{ s.h_d }}px;--op-body:{{ s.body_size }}px;--op-align:{{ s.align }};--op-pt-m:{{ s.pt_m }}px;--op-pb-m:{{ s.pb_m }}px;--op-pt-d:{{ s.pt_d }}px;--op-pb-d:{{ s.pb_d }}px">
  <div class="oralys-pdp-sc__inner">
    <div class="oralys-pdp-sc__head">{% if s.eyebrow != blank %}<p class="oralys-pdp-sc__eyebrow">{{ s.eyebrow }}</p>{% endif %}{% if h != blank %}<h2 class="oralys-pdp-sc__h">{{ h }}</h2>{% endif %}</div>
    <div class="oralys-pdp-sc__grid">
      <ul class="oralys-pdp-sc__tiles" role="list">
        {%- for block in section.blocks -%}
        <li class="oralys-pdp-sc__tile" {{ block.shopify_attributes }}>{% if block.settings.icon != 'none' %}<span class="oralys-pdp-sc__ic">{% render 'oralys-pdp-icon', name: block.settings.icon, size: 26 %}</span>{% endif %}<h3 class="oralys-pdp-sc__tt">{{ block.settings.title }}</h3><p class="oralys-pdp-sc__tb">{{ block.settings.body }}</p></li>
        {%- endfor -%}
      </ul>
      {%- if s.image != blank or s.asset != blank -%}
      <figure class="oralys-pdp-sc__fig"><div class="oralys-pdp-sc__media" style="aspect-ratio:{{ s.ratio }}">{% render 'oralys-pdp-media', image: s.image, asset: s.asset, alt: s.alt, class: 'oralys-pdp-sc__img', loading: 'lazy', width: 1440, height: 1440 %}</div>{% if s.caption != blank %}<figcaption class="oralys-pdp-sc__cap">{% render 'oralys-pdp-icon', name: 'shield', size: 20 %}{{ s.caption }}</figcaption>{% endif %}</figure>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.oralys-pdp-sc{background:var(--op-bg);color:var(--op-text);padding:var(--op-pt-m) 16px var(--op-pb-m);font-family:var(--font-body--family);font-size:var(--op-body);line-height:1.55}
.oralys-pdp-sc *{box-sizing:border-box}
@media (min-width:750px){.oralys-pdp-sc{padding:var(--op-pt-d) 32px var(--op-pb-d)}}
.oralys-pdp-sc__inner{max-width:1200px;margin:0 auto}
.oralys-pdp-sc__head{text-align:var(--op-align);margin:0 0 24px}
.oralys-pdp-sc__eyebrow{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--op-accent);margin:0 0 10px}
.oralys-pdp-sc__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--op-h-m);line-height:1.22;margin:0;color:var(--op-text);text-wrap:balance}
.oralys-pdp-sc__h em{font-style:normal;color:var(--op-accent)}
@media (min-width:750px){.oralys-pdp-sc__h{font-size:var(--op-h-d)}}
.oralys-pdp-sc__btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--op-cta);color:var(--op-cta-text);font-weight:700;font-size:18px;text-decoration:none;border:0;width:100%;transition:transform .15s}
.oralys-pdp-sc__btn:hover{transform:translateY(-1px)}
@media (min-width:750px){.oralys-pdp-sc__btn{display:inline-flex;width:auto;min-width:320px}}

.oralys-pdp-sc__grid{display:grid;gap:20px}
@media (min-width:990px){.oralys-pdp-sc__grid{grid-template-columns:3fr 2fr;gap:40px;align-items:center}}
.oralys-pdp-sc__tiles{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.oralys-pdp-sc__tile{background:var(--op-card);border:1px solid var(--op-line);border-radius:12px;padding:16px 14px}
.oralys-pdp-sc__ic{display:inline-flex;width:46px;height:46px;border-radius:50%;align-items:center;justify-content:center;background:#EEF6F1;color:var(--op-accent);margin-bottom:10px}
.oralys-pdp-sc__tt{margin:0 0 6px;font-family:var(--font-heading--family);font-weight:700;font-size:17px;line-height:1.25}
.oralys-pdp-sc__tb{margin:0;font-size:14.5px;line-height:1.45;color:var(--op-muted)}
.oralys-pdp-sc__fig{margin:0}
.oralys-pdp-sc__media{border-radius:14px;overflow:hidden;background:#fff}
.oralys-pdp-sc__img{display:block;width:100%;height:100%;object-fit:cover}
.oralys-pdp-sc__cap{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:12px;font-weight:700;color:var(--op-accent);text-align:center}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : sans colle",
  "tag": "section",
  "class": "oralys-pdp-sc-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Rien de collant. Rien qui fond. Une bouche propre le soir."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Mot du titre en couleur accent",
      "default": "propre",
      "info": "Doit apparaître tel quel dans le titre. Vide = aucun mot en couleur."
    },
    {
      "type": "header",
      "content": "Média"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo / animation"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Photo / animation : fichier du thème",
      "default": "oralys-pdp-peel-out.webp",
      "info": "Utilisé si aucune image n'est choisie (fichier dans assets/)."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Photo / animation : texte alternatif",
      "default": "Mains retirant le gel Oralys du dentier en un seul morceau"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format",
      "default": "1 / 1",
      "options": [
        {
          "value": "1 / 1",
          "label": "Carré"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "4 / 3",
          "label": "4:3"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        }
      ]
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende",
      "default": "Sans danger au quotidien, jour après jour."
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#EEF6F1"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_accent",
      "label": "Accent (mot du titre, icônes)",
      "default": "#0E6B50"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Texte secondaire",
      "default": "#5C6863"
    },
    {
      "type": "color",
      "id": "c_card",
      "label": "Fond des cartes",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_line",
      "label": "Bordures",
      "default": "#DCE5E0"
    },
    {
      "type": "color",
      "id": "c_cta",
      "label": "Bouton : fond",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_cta_text",
      "label": "Bouton : texte",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typo et espacements"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Titre : taille mobile",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Titre : taille ordinateur",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Texte : taille",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement des titres",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Marge haute mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Marge basse mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Marge haute ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Marge basse ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tuile",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "check",
          "options": [
            {
              "value": "none",
              "label": "Aucune"
            },
            {
              "value": "check",
              "label": "Coche"
            },
            {
              "value": "gap",
              "label": "Vide comblé"
            },
            {
              "value": "tooth",
              "label": "Dent"
            },
            {
              "value": "bread",
              "label": "Pain"
            },
            {
              "value": "clock",
              "label": "Horloge"
            },
            {
              "value": "shield",
              "label": "Bouclier"
            },
            {
              "value": "lock",
              "label": "Cadenas"
            },
            {
              "value": "repeat",
              "label": "Sans abonnement"
            },
            {
              "value": "home",
              "label": "Maison"
            },
            {
              "value": "box",
              "label": "Colis"
            },
            {
              "value": "truck",
              "label": "Camion"
            },
            {
              "value": "gift",
              "label": "Cadeau"
            },
            {
              "value": "nozinc",
              "label": "Zéro zinc"
            },
            {
              "value": "drop",
              "label": "Ne fond pas"
            },
            {
              "value": "peel",
              "label": "Se retire"
            },
            {
              "value": "nocolle",
              "label": "Sans colle"
            },
            {
              "value": "star",
              "label": "Étoile"
            },
            {
              "value": "heart",
              "label": "Cœur"
            },
            {
              "value": "smile",
              "label": "Sourire"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oralys : sans colle",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "icon": "nocolle",
            "title": "Sans colle",
            "body": "Pas de pâte qui déborde sur la gencive ni de goût qui reste au fond de la gorge."
          }
        },
        {
          "type": "tile",
          "settings": {
            "icon": "nozinc",
            "title": "Zéro zinc",
            "body": "Beaucoup de crèmes en contiennent. Quand on en remet trois fois par jour, ça s'accumule. Oralys n'en contient pas."
          }
        },
        {
          "type": "tile",
          "settings": {
            "icon": "drop",
            "title": "Rien qui fond dans la bouche",
            "body": "La salive ne le dissout pas : rien ne se détache pendant le repas, rien qu'on avale."
          }
        },
        {
          "type": "tile",
          "settings": {
            "icon": "peel",
            "title": "Sort d'un seul morceau",
            "body": "Trempez, soulevez : le gel se retire en entier. Fini les dix minutes à gratter au-dessus du lavabo."
          }
        }
      ]
    }
  ]
}
{% endschema %}
