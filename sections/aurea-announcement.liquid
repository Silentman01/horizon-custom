<aurea-countdown class="au-announce" style="{% render 'aurea-vars' %}" data-hours="{{ section.settings.hours }}" data-key="aurea-countdown-{{ section.id }}">
  <div class="au-announce__text">
    <p class="au-announce__title">{{ section.settings.title }}</p>
    <p class="au-announce__sub">{{ section.settings.sub }}</p>
  </div>
  <div class="au-announce__timer" role="timer" aria-label="{{ section.settings.title | escape }}">
    <span class="au-announce__unit"><b data-h>02</b><small>{{ section.settings.label_h }}</small></span>
    <span class="au-announce__sep" aria-hidden="true">:</span>
    <span class="au-announce__unit"><b data-m>00</b><small>{{ section.settings.label_m }}</small></span>
    <span class="au-announce__sep" aria-hidden="true">:</span>
    <span class="au-announce__unit"><b data-s>00</b><small>{{ section.settings.label_s }}</small></span>
  </div>
</aurea-countdown>

{% stylesheet %}
  .au-announce { display: flex; align-items: center; justify-content: center; gap: 28px; padding: 10px 16px; background: linear-gradient(90deg, #1e3328 0%, #c99a3a 100%); color: #faf5e8; font-family: var(--au-body, inherit); }
  .au-announce__text { text-align: left; }
  .au-announce__title { margin: 0; font-size: 22px; font-weight: 800; line-height: 1; letter-spacing: 0.04em; color: #f3dca5; text-transform: uppercase; }
  .au-announce__sub { margin: 4px 0 0; font-size: 12px; font-weight: 600; line-height: 1.1; color: rgb(250 245 232 / 0.85); }
  .au-announce__timer { display: flex; align-items: center; gap: 6px; }
  .au-announce__unit { display: flex; flex-direction: column; align-items: center; min-width: 38px; }
  .au-announce__unit b { font-size: 22px; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: #fff; }
  .au-announce__unit small { margin-top: 2px; font-size: 11px; font-weight: 600; color: rgb(250 245 232 / 0.75); }
  .au-announce__sep { margin-bottom: 12px; font-size: 24px; font-weight: 800; line-height: 1; color: #f3dca5; }
  @media (max-width: 749px) {
    .au-announce { gap: 14px; padding: 8px 10px; }
    .au-announce__title { font-size: 18px; }
    .au-announce__sub { font-size: 11px; }
    .au-announce__unit { min-width: 30px; }
    .au-announce__unit b { font-size: 18px; }
    .au-announce__sep { font-size: 20px; margin-bottom: 10px; }
  }
  .header-logo { font-family: Cinzel, var(--font-heading--family), serif; font-weight: 600; letter-spacing: 0.3em; }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('aurea-countdown')) {
    class AureaCountdown extends HTMLElement {
      connectedCallback() {
        const total = Math.max(1, parseFloat(this.dataset.hours || '2')) * 3600000;
        const key = this.dataset.key;
        const read = () => { try { return parseInt(localStorage.getItem(key), 10); } catch (e) { return NaN; } };
        const write = (v) => { try { localStorage.setItem(key, String(v)); } catch (e) {} };
        let end = read();
        if (!end || end < Date.now()) { end = Date.now() + total; write(end); }
        const pad = (n) => String(n).padStart(2, '0');
        const tick = () => {
          let left = end - Date.now();
          if (left <= 0) { end = Date.now() + total; write(end); left = total; }
          const s = Math.floor(left / 1000);
          this.querySelector('[data-h]').textContent = pad(Math.floor(s / 3600));
          this.querySelector('[data-m]').textContent = pad(Math.floor((s % 3600) / 60));
          this.querySelector('[data-s]').textContent = pad(s % 60);
        };
        tick();
        this.timer = setInterval(tick, 1000);
      }
      disconnectedCallback() { clearInterval(this.timer); }
    }
    customElements.define('aurea-countdown', AureaCountdown);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Aurea countdown bar",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "FALL SALE" },
    { "type": "text", "id": "sub", "label": "Subtitle", "default": "Shop Now and Get Up To 70% Off" },
    { "type": "range", "id": "hours", "label": "Countdown length (hours, restarts when it ends)", "min": 1, "max": 24, "step": 1, "default": 2 },
    { "type": "text", "id": "label_h", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_m", "label": "Minutes label", "default": "Mins" },
    { "type": "text", "id": "label_s", "label": "Seconds label", "default": "Secs" }
  ],
  "presets": [ { "name": "Aurea countdown bar" } ]
}
{% endschema %}
