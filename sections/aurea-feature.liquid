<section class="au-feat" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-feat__card">
    <div class="au-feat__img">
      {% render 'aurea-media', image: section.settings.image, asset: section.settings.image_asset, ratio: '1024 / 874', label: 'Image: bracelet ring with floating crystals (transparent WebP/PNG, about 1200x1024)', sizes: '(min-width: 750px) 400px, 360px' %}
    </div>
    <div class="au-feat__body">
      {%- if section.settings.eyebrow != blank -%}<p class="au-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {% render 'aurea-title', text: section.settings.heading, class: 'au-feat__h' %}
      <ul class="au-feat__items">
        {%- for block in section.blocks -%}
          <li class="au-feat__item" {{ block.shopify_attributes }}>{% render 'aurea-icon', name: block.settings.icon %}<span>{{ block.settings.label }}</span></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% stylesheet %}
  .au-feat { padding: 80px 16px 40px; background: var(--au-parchment); }
  .au-feat__card { position: relative; max-width: 1100px; margin: 0 auto; padding: 0 20px 28px; border-radius: 9px; background: var(--au-espresso); }
  .au-feat__img { width: min(86%, 360px); margin: -54px auto 8px; }
  .au-feat__img .au-media { background: transparent; }
  .au-feat__img .au-media > img { object-fit: contain; }
  .au-feat__eyebrow { margin: 0 0 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #e6d6b6; }
  .au-feat .au-feat__h { font-weight: 400; font-size: 26px; color: #fff; }
  .au-feat__items { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 18px; margin: 28px 0 0; padding: 0; list-style: none; }
  .au-feat__item { display: flex; flex-direction: column; gap: 10px; font-size: 15px; font-weight: 600; color: #f1e7d4; }
  .au-feat__item .au-icon { width: 34px; height: 34px; color: #e8c573; }
  @media (min-width: 750px) {
    .au-feat { padding: 56px 16px; }
    .au-feat__card { display: grid; grid-template-columns: 25% 1fr; gap: 40px; padding: 34px; }
    .au-feat__img { width: auto; margin: 0 0 0 -180px; align-self: center; width: 440px; }
    .au-feat__items { grid-template-columns: repeat(3, 1fr); gap: 44px 38px; }
    .au-feat .au-feat__h { font-size: 30px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea dark feature card",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (transparent, bleeds out of the card)" },
    { "type": "text", "id": "image_asset", "label": "Image theme asset (fallback filename)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THAT'S WHERE AUREA® COMES IN" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "Bringing Back Flow, Luck & *Prosperity* Naturally" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "wind", "options": [ { "value": "wind", "label": "Wind" }, { "value": "magnet", "label": "Magnet" }, { "value": "coins", "label": "Coins" }, { "value": "wave", "label": "Waveform" }, { "value": "infinity", "label": "Infinity" }, { "value": "moonstar", "label": "Moon and star" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Clears bad energy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea dark feature card",
      "blocks": [
        { "type": "item", "settings": { "icon": "wind", "label": "Clears bad energy" } },
        { "type": "item", "settings": { "icon": "magnet", "label": "Draws prosperity" } },
        { "type": "item", "settings": { "icon": "coins", "label": "Money flows with ease" } },
        { "type": "item", "settings": { "icon": "wave", "label": "Cleanse your vibration" } },
        { "type": "item", "settings": { "icon": "infinity", "label": "Opportunities come to you" } },
        { "type": "item", "settings": { "icon": "moonstar", "label": "Calm nights" } }
      ]
    }
  ]
}
{% endschema %}
