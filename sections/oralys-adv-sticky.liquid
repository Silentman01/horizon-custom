{%- liquid
  assign s = section.settings
  assign link = s.button_link | default: s.fallback_link | default: '/products/oralys-gel'
-%}
{%- style -%}
  .oralys-adv-sk-{{ section.id }} {
    --oralys-adv-sk-bg: {{ s.color_bg }};
    --oralys-adv-sk-text: {{ s.color_text }};
    {% if s.color_button != blank %}--oralys-adv-sk-btn: {{ s.color_button }};{% endif %}
    {% if s.color_button_text != blank %}--oralys-adv-sk-btn-text: {{ s.color_button_text }};{% endif %}
  }
  {%- if s.hide_desktop %}
    @media (min-width: 990px) { .oralys-adv-sk-{{ section.id }} { display: none !important; } }
  {%- endif %}
{%- endstyle -%}

<div
  class="oralys-adv-sk oralys-adv-sk-{{ section.id }}{% if request.design_mode %} is-on{% endif %}"
  data-oralys-adv-sticky
  data-offset="{{ s.show_after }}"
>
  <div class="oralys-adv-sk__in">
    {%- if s.image != blank or s.image_asset != blank -%}
      <span class="oralys-adv-sk__th" data-oralys-adv-media>
        {%- render 'oralys-adv-media', image: s.image, asset: s.image_asset, alt: s.title, class: 'oralys-adv-sk__img', sizes: '48px' -%}
      </span>
    {%- endif -%}
    <span class="oralys-adv-sk__txt">
      {%- if s.title != blank -%}<span class="oralys-adv-sk__t">{{ s.title }}</span>{%- endif -%}
      {%- if s.subtitle != blank -%}<span class="oralys-adv-sk__st">{{ s.subtitle }}</span>{%- endif -%}
    </span>
    <a href="{{ link }}" class="oralys-adv-sk__btn">{{ s.button_label }}</a>
  </div>
</div>
<div class="oralys-adv-sk__spacer" aria-hidden="true"></div>

<script>
  (function () {
    var bars = document.querySelectorAll('[data-oralys-adv-sticky]');
    bars.forEach(function (bar) {
      if (bar.dataset.bound) return;
      bar.dataset.bound = '1';
      var off = parseInt(bar.dataset.offset, 10) || 0;
      function tick() {
        if (window.Shopify && window.Shopify.designMode) return bar.classList.add('is-on');
        bar.classList.toggle('is-on', window.scrollY > off);
      }
      window.addEventListener('scroll', tick, { passive: true });
      tick();
    });
  })();
</script>

{% stylesheet %}
  .oralys-adv-sk {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--oralys-adv-sk-bg, #fff);
    color: var(--oralys-adv-sk-text, #17221e);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(110%);
    transition: transform 0.25s ease;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .oralys-adv-sk.is-on { transform: none; }
  .oralys-adv-sk__in { max-width: 760px; margin: 0 auto; display: flex; align-items: center; gap: 10px; padding: 10px 12px; }
  .oralys-adv-sk__th { flex: 0 0 46px; width: 46px; height: 46px; border-radius: 10px; overflow: hidden; background: #fff; }
  .oralys-adv-sk__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .oralys-adv-sk__txt { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
  .oralys-adv-sk__t { font-weight: 700; font-size: 14px; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .oralys-adv-sk__st { font-size: 12.5px; opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .oralys-adv-sk__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 40px;
    background: var(--oralys-adv-sk-btn, var(--oralys-adv-cta, #d2382c));
    color: var(--oralys-adv-sk-btn-text, var(--oralys-adv-cta-text, #fff));
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .oralys-adv-sk__spacer { height: 76px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Adv · Sticky CTA bar",
  "tag": "section",
  "class": "oralys-adv-sk-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Thumbnail" },
    { "type": "text", "id": "image_asset", "label": "Thumbnail fallback (theme asset filename)" },
    { "type": "text", "id": "title", "label": "Title", "default": "Offre du moment" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Voir l'offre" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "fallback_link", "label": "Link used when the field above is empty", "default": "/products/oralys-gel" },
    { "type": "range", "id": "show_after", "label": "Show after scrolling", "min": 0, "max": 2000, "step": 50, "unit": "px", "default": 700 },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on desktop", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#17221E" },
    { "type": "color", "id": "color_button", "label": "Button" },
    { "type": "color", "id": "color_button_text", "label": "Button text" }
  ],
  "presets": [ { "name": "Adv · Sticky CTA bar" } ]
}
{% endschema %}
