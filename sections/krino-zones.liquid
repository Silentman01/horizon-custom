{%- comment -%}
  Krino zones before/after carousel ("Funciona literal donde sea"): each slide holds up to 2 stacked before/after pairs
  with a label. Rail starts at the page edge and bleeds right; touch + mouse/pen drag; dash pagination. Prefix krino-zones.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign kz_slides = 0
-%}
{%- comment -%}
  A pair shows on the storefront only when it has both a before and an after photo (image picker or theme asset);
  slides with no complete pair are skipped and the dots follow the visible slides. The theme editor still shows
  incomplete pairs as neutral frames so they can be filled.
{%- endcomment -%}
{%- capture kz_items -%}
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- capture kz_pairs -%}
      {%- for i in (1..2) -%}
        {%- capture kz_b -%}before_{{ i }}{%- endcapture -%}
        {%- capture kz_ba -%}before_{{ i }}_asset{%- endcapture -%}
        {%- capture kz_a -%}after_{{ i }}{%- endcapture -%}
        {%- capture kz_aa -%}after_{{ i }}_asset{%- endcapture -%}
        {%- capture kz_l -%}label_{{ i }}{%- endcapture -%}
        {%- liquid
          assign kz_has_b = false
          if bs[kz_b] != blank or bs[kz_ba] != blank
            assign kz_has_b = true
          endif
          assign kz_has_a = false
          if bs[kz_a] != blank or bs[kz_aa] != blank
            assign kz_has_a = true
          endif
          assign kz_show = false
          if kz_has_b and kz_has_a
            assign kz_show = true
          elsif request.design_mode
            if kz_has_b or kz_has_a or bs[kz_l] != blank
              assign kz_show = true
            endif
          endif
        -%}
        {%- if kz_show -%}
          <figure class="krino-zones__pair">
            <div class="krino-zones__photos">
              {% render 'krino-media', image: bs[kz_b], asset: bs[kz_ba], ratio: '1 / 1', alt: bs[kz_l], sizes: '(min-width: 750px) 300px, 34vw' %}
              {% render 'krino-media', image: bs[kz_a], asset: bs[kz_aa], ratio: '1 / 1', alt: bs[kz_l], sizes: '(min-width: 750px) 300px, 34vw' %}
            </div>
            {%- if bs[kz_l] != blank -%}<figcaption class="krino-zones__label">{{ bs[kz_l] }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if kz_pairs != blank or request.design_mode -%}
      {%- assign kz_slides = kz_slides | plus: 1 -%}
      <div class="krino-zones__slide" {{ block.shopify_attributes }}>{{ kz_pairs }}</div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{% render 'krino-rail' %}
{%- if kz_slides > 0 or request.design_mode -%}
<div
  class="krino-zones"
  style="--krino-zones-bg: {{ ss.background }}; --krino-zones-text: {{ ss.text_color }}; --krino-dots-on: {{ ss.accent_color }}; --krino-zones-h-font: {{ ss.heading_font }}; --krino-zones-h-size: {{ ss.heading_size }}px; --krino-zones-h-size-m: {{ ss.heading_size_mobile }}px; --krino-zones-h-weight: {{ ss.heading_weight }}; --krino-zones-body: {{ ss.body_size }}px; --krino-zones-slide-w: {{ ss.slide_width }}px; --krino-zones-slide-w-m: {{ ss.slide_width_mobile }}vw; --krino-zones-pt: {{ ss.padding_top }}px; --krino-zones-pb: {{ ss.padding_bottom }}px; --krino-zones-pt-m: {{ ss.padding_top_mobile }}px; --krino-zones-pb-m: {{ ss.padding_bottom_mobile }}px;"
>
  <div class="krino-zones__head">
    {%- if ss.heading != blank -%}<h2 class="krino-zones__heading">{{ ss.heading }}</h2>{%- endif -%}
    {%- if ss.subheading != blank -%}<p class="krino-zones__sub">{{ ss.subheading }}</p>{%- endif -%}
  </div>
  <krino-rail class="krino-zones__rail" id="KrinoZones-{{ section.id }}">
    {{- kz_items -}}
  </krino-rail>
  {%- if ss.show_dots and kz_slides > 1 -%}
    <div class="krino-rail-dots krino-zones__dots" data-krino-dots-for="KrinoZones-{{ section.id }}">
      {%- for i in (1..kz_slides) -%}<button type="button" aria-label="{{ i }}"></button>{%- endfor -%}
    </div>
  {%- endif -%}
</div>
{%- endif -%}
{% stylesheet %}
  .krino-zones { --krino-zones-edge: max(40px, calc((100% - 1300px) / 2 + 40px)); padding: var(--krino-zones-pt, 45px) 0 var(--krino-zones-pb, 45px); background: var(--krino-zones-bg, #fcfcfc); color: var(--krino-zones-text, #252525); }
  .krino-zones__head { padding-inline: 20px; text-align: center; }
  .krino-zones__heading { margin: 0 0 5px; font-family: var(--krino-zones-h-font, var(--font-heading--family)); font-size: var(--krino-zones-h-size, 32px); font-weight: var(--krino-zones-h-weight, 600); line-height: 1.25; color: inherit; }
  .krino-zones__sub { margin: 0; font-size: var(--krino-zones-body, 14px); line-height: 1.4; }
  .krino-zones__rail { gap: 15px; margin-top: 20px; padding-inline: var(--krino-zones-edge); scroll-padding-inline: var(--krino-zones-edge); }
  .krino-zones__slide { display: flex; flex-direction: column; gap: 15px; width: var(--krino-zones-slide-w, 600px); }
  .krino-zones__pair { display: flex; flex-direction: column; gap: 6px; margin: 0; }
  .krino-zones__photos { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; overflow: hidden; border-radius: 8px; }
  .krino-zones__label { font-size: var(--krino-zones-body, 14px); font-weight: 500; text-align: center; }
  .krino-zones__dots { margin-top: 20px; }
  @media screen and (max-width: 749px) {
    .krino-zones { --krino-zones-edge: 20px; padding: var(--krino-zones-pt-m, 40px) 0 var(--krino-zones-pb-m, 40px); }
    .krino-zones__heading { font-size: var(--krino-zones-h-size-m, 24px); }
    .krino-zones__rail { gap: 12px; }
    .krino-zones__slide { width: var(--krino-zones-slide-w-m, 69vw); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino zones before/after",
  "tag": "section",
  "class": "krino-zones-section",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide (2 pairs)",
      "settings": [
        { "type": "header", "content": "Top pair" },
        { "type": "image_picker", "id": "before_1", "label": "Before photo" },
        { "type": "text", "id": "before_1_asset", "label": "Before theme asset (fallback)" },
        { "type": "image_picker", "id": "after_1", "label": "After photo" },
        { "type": "text", "id": "after_1_asset", "label": "After theme asset (fallback)" },
        { "type": "text", "id": "label_1", "label": "Label", "default": "Coronilla" },
        { "type": "header", "content": "Bottom pair" },
        { "type": "image_picker", "id": "before_2", "label": "Before photo" },
        { "type": "text", "id": "before_2_asset", "label": "Before theme asset (fallback)" },
        { "type": "image_picker", "id": "after_2", "label": "After photo" },
        { "type": "text", "id": "after_2_asset", "label": "After theme asset (fallback)" },
        { "type": "text", "id": "label_2", "label": "Label", "default": "Frente" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Funciona literal donde sea" },
    { "type": "text", "id": "subheading", "label": "Subline", "default": "Krino rellena donde lo necesites: coronilla, entradas o barba." },
    { "type": "checkbox", "id": "show_dots", "label": "Show pagination dashes", "default": true },
    { "type": "range", "id": "slide_width", "label": "Slide width (desktop)", "min": 300, "max": 800, "step": 5, "unit": "px", "default": 600 },
    { "type": "range", "id": "slide_width_mobile", "label": "Slide width (mobile, % of screen)", "min": 50, "max": 95, "step": 1, "unit": "%", "default": 69 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FCFCFC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#252525" },
    { "type": "color", "id": "accent_color", "label": "Active dash", "default": "#3D5AFE" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "var(--font-heading--family)", "options": [
      { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-accent--family)", "label": "Accent" }
    ] },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "600", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 16, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 14, "max": 44, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [
    { "name": "Krino zones before/after", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
