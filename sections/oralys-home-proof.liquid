    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Marge basse mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Marge haute ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Marge basse ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
