<section class="oralys-home-voices" style="--oh-bg:{{ section.settings.c_bg }};--oh-text:{{ section.settings.c_text }};--oh-accent:{{ section.settings.c_accent }};--oh-muted:{{ section.settings.c_muted }};--oh-card:{{ section.settings.c_card }};--oh-line:{{ section.settings.c_line }};--oh-cta:{{ section.settings.c_cta }};--oh-cta-text:{{ section.settings.c_cta_text }};--oh-h-m:{{ section.settings.h_m }}px;--oh-h-d:{{ section.settings.h_d }}px;--oh-body:{{ section.settings.body_size }}px;--oh-align:{{ section.settings.align }};--oh-pt-m:{{ section.settings.pt_m }}px;--oh-pb-m:{{ section.settings.pb_m }}px;--oh-pt-d:{{ section.settings.pt_d }}px;--oh-pb-d:{{ section.settings.pb_d }}px">
  <div class="oralys-home-voices__inner">
    <div class="oralys-home-voices__head{% if section.settings.align == 'center' %} oralys-home-voices__head--center{% endif %}">{% if section.settings.eyebrow != blank %}<p class="oralys-home-voices__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="oralys-home-voices__h">{{ section.settings.heading }}</h2>{% endif %}</div>
    {% if section.settings.score != blank %}
      <p class="oralys-home-voices__score"><span style="color:{{ section.settings.c_stars }}" aria-hidden="true">★★★★★</span> {{ section.settings.score }}</p>
    {% endif %}
    <div class="oralys-home-voices__rail" tabindex="0" role="region" aria-label="{{ section.settings.rail_label | escape }}">
      {% for block in section.blocks %}
        <article class="oralys-home-voices__card" {{ block.shopify_attributes }}>
          {% if block.settings.situation != blank %}<span class="oralys-home-voices__sit">{{ block.settings.situation }}</span>{% endif %}
          <p class="oralys-home-voices__stars" style="color:{{ section.settings.c_stars }}" aria-label="5 sur 5">★★★★★</p>
          <h3 class="oralys-home-voices__qt">{{ block.settings.title }}</h3>
          <div class="oralys-home-voices__qx">{{ block.settings.text }}</div>
          <footer class="oralys-home-voices__who">
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 120 | image_tag: class: 'oralys-home-voices__av', loading: 'lazy', alt: block.settings.name }}
            {% elsif block.settings.asset != blank %}<img class="oralys-home-voices__av" src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.name | escape }}" width="48" height="48" loading="lazy">
            {% else %}<span class="oralys-home-voices__av oralys-home-voices__av--init" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>{% endif %}
            <span><strong>{{ block.settings.name }}</strong><br><small>{{ block.settings.detail }}</small></span>
            {% if section.settings.verified != blank %}<em class="oralys-home-voices__ver">{{ section.settings.verified }}</em>{% endif %}
          </footer>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.oralys-home-voices{background:var(--oh-bg);color:var(--oh-text);padding:var(--oh-pt-m) 16px var(--oh-pb-m);font-family:var(--font-body--family);font-size:var(--oh-body);line-height:1.55}
.oralys-home-voices *{box-sizing:border-box}
@media (min-width:750px){.oralys-home-voices{padding:var(--oh-pt-d) 32px var(--oh-pb-d)}}
.oralys-home-voices__inner{max-width:1200px;margin:0 auto}
.oralys-home-voices__head{text-align:var(--oh-align);margin:0 0 28px}
.oralys-home-voices__eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--oh-accent);margin:0 0 10px}
.oralys-home-voices__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--oh-h-m);line-height:1.2;margin:0 0 12px;color:var(--oh-text);text-wrap:balance}
.oralys-home-voices__h em{font-style:normal;color:var(--oh-accent)}
@media (min-width:750px){.oralys-home-voices__h{font-size:var(--oh-h-d)}}
.oralys-home-voices__sub{color:var(--oh-muted);margin:0;max-width:680px}
.oralys-home-voices__head[style*=center] .oralys-home-voices__sub,.oralys-home-voices__head--center .oralys-home-voices__sub{margin-inline:auto}
.oralys-home-voices__sub p{margin:0 0 8px}
.oralys-home-voices__btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--oh-cta);color:var(--oh-cta-text);font-weight:700;font-size:17px;text-decoration:none;border:0;transition:transform .15s}
.oralys-home-voices__btn:hover{transform:translateY(-1px)}
.oralys-home-voices__btn--full{width:100%}
@media (min-width:750px){.oralys-home-voices__btn--full{width:auto;min-width:300px}}

.oralys-home-voices__score{margin:-12px 0 20px;font-weight:700;text-align:var(--oh-align)}
.oralys-home-voices__rail{display:grid;grid-auto-flow:column;grid-auto-columns:84%;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 16px 16px;margin:0 -16px;scrollbar-width:thin;cursor:grab}
.oralys-home-voices__card{scroll-snap-align:start;background:var(--oh-card);border:1px solid var(--oh-line);border-radius:12px;padding:18px;display:flex;flex-direction:column;gap:6px}
.oralys-home-voices__sit{align-self:flex-start;font-size:13px;font-weight:700;color:var(--oh-accent);background:color-mix(in srgb,var(--oh-accent) 10%,transparent);padding:4px 10px;border-radius:40px}
.oralys-home-voices__stars{margin:4px 0 0;letter-spacing:2px}
.oralys-home-voices__qt{margin:0;font-family:var(--font-heading--family);font-size:19px;line-height:1.3}
.oralys-home-voices__qx{flex:1}.oralys-home-voices__qx p{margin:0;color:var(--oh-text)}
.oralys-home-voices__who{display:flex;gap:10px;align-items:center;margin-top:10px;font-size:15px;line-height:1.3;flex-wrap:wrap}
.oralys-home-voices__who small{color:var(--oh-muted);font-size:14px}
.oralys-home-voices__av{width:48px;height:48px;border-radius:50%;object-fit:cover;flex:0 0 48px}
.oralys-home-voices__av--init{display:flex;align-items:center;justify-content:center;background:var(--oh-accent);color:#fff;font-weight:700;font-size:20px}
.oralys-home-voices__ver{font-style:normal;font-size:13px;color:var(--oh-accent);font-weight:700;margin-left:auto}
@media (min-width:750px){.oralys-home-voices__rail{grid-auto-columns:calc((100% - 28px)/2.2)}}
@media (min-width:990px){.oralys-home-voices__rail{grid-auto-flow:row;grid-template-columns:repeat(3,1fr);overflow:visible;margin:0;padding:0}}
{% endstylesheet %}

{% schema %}
