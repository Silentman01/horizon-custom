{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'question'
  assign half = items.size | plus: 1 | divided_by: 2
-%}
<div class="ot-faq" style="{% render 'oldtoms-vars' %}--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  {%- if s.heading != blank -%}<h2 class="ot-faq__heading">{{ s.heading }}</h2>{%- endif -%}
  <div class="ot-faq__list">
    <div class="ot-faq__col">
    {%- for block in items limit: half -%}
      <details class="ot-faq__item" name="ot-faq-{{ section.id }}" {{ block.shopify_attributes }}>
        <summary class="ot-faq__q">
          <span>{{ block.settings.question }}</span>
          <span class="ot-faq__chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M6 9l6 6 6-6" fill="none" stroke="#24433d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </summary>
        <div class="ot-faq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
    </div>
    <div class="ot-faq__col">
    {%- for block in items offset: half -%}
      <details class="ot-faq__item" name="ot-faq-{{ section.id }}" {{ block.shopify_attributes }}>
        <summary class="ot-faq__q">
          <span>{{ block.settings.question }}</span>
          <span class="ot-faq__chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M6 9l6 6 6-6" fill="none" stroke="#24433d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </summary>
        <div class="ot-faq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
    </div>
  </div>

  {%- if s.show_support -%}
    <div class="ot-faq__support">
      <div class="ot-faq__who">
        <div class="ot-faq__avatar">{% render 'oldtoms-media', image: s.avatar, asset: s.avatar_asset, ratio: '1 / 1', alt: s.support_heading, sizes: '64px' %}<span class="ot-faq__dot" aria-hidden="true"></span></div>
        <h3 class="ot-faq__support-title">{{ s.support_heading }}</h3>
      </div>
      <p class="ot-faq__support-text">{{ s.support_text }}</p>
      <a class="ot-faq__button" href="{{ s.button_link | default: '/pages/contact' }}">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <span>{{ s.button_label }}</span>
      </a>
      {%- if s.hours != blank -%}<p class="ot-faq__hours">{{ s.hours }}</p>{%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.ot-faq { background: #fff; color: #24433d; font-family: var(--ot-font); padding: var(--ot-pt, 48px) 16px var(--ot-pb, 56px); }
.ot-faq__heading { margin: 0 0 28px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 40px; line-height: 1.1; color: #23372b; }
.ot-faq__col { display: grid; gap: 12px; align-content: start; }
.ot-faq__list { display: grid; gap: 12px; align-items: start; max-width: 1024px; margin: 0 auto; }
.ot-faq__item { border: 1px solid #121212; border-radius: 6px; background: #fff; box-shadow: 0 3px 0 #23372b; }
.ot-faq__q { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 56px; padding: 14px; cursor: pointer; list-style: none; font-size: 12.5px; font-weight: 700; line-height: 1.35; text-transform: uppercase; }
.ot-faq__q::-webkit-details-marker { display: none; }
.ot-faq__q:focus-visible { outline: 2px solid #24433d; outline-offset: 2px; }
.ot-faq__chev { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: #ccf46f; transition: transform 0.2s; }
.ot-faq__item[open] .ot-faq__chev { transform: rotate(180deg); }
.ot-faq__a { padding: 0 14px 16px; font-size: 13px; line-height: 1.55; color: #121212; }
.ot-faq__a p { margin: 0 0 8px; }
.ot-faq__support { max-width: 650px; margin: 36px auto 0; padding: 24px 18px; border-radius: 20px; background: #f0f0e6; text-align: center; }
.ot-faq__who { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 12px; text-align: left; }
.ot-faq__avatar { position: relative; flex: none; width: 60px; }
.ot-faq__avatar .ot-media { border-radius: 50%; background: #d5dccb; }
.ot-faq__dot { position: absolute; right: 1px; bottom: 2px; width: 13px; height: 13px; border-radius: 50%; background: #3fbf5a; border: 2px solid #f0f0e6; }
.ot-faq__support-title { margin: 0; font-family: var(--ot-font-heading); font-weight: 400; font-size: 28px; line-height: 1.15; color: #23372b; }
.ot-faq__support-text { margin: 0 0 16px; font-size: 12px; line-height: 1.5; color: #121212; }
.ot-faq__button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; max-width: 416px; min-height: 44px; border-radius: 20px; background: #24433d; color: #fff; font-size: 12px; text-decoration: underline; }
.ot-faq__button:focus-visible { outline: 2px solid #24433d; outline-offset: 3px; }
.ot-faq__hours { margin: 12px 0 0; font-size: 11px; color: #707070; }
@media screen and (min-width: 750px) {
  .ot-faq__heading { font-size: 60px; margin-bottom: 44px; }
  .ot-faq__list { grid-template-columns: 1fr 1fr; gap: 30px; }
  .ot-faq__q { min-height: 72px; }
  .ot-faq__support { padding: 30px 34px; margin-top: 44px; }
  .ot-faq__support-title { font-size: 34px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's FAQ",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "header", "content": "Support card" },
    { "type": "checkbox", "id": "show_support", "label": "Show the support card", "default": true },
    { "type": "image_picker", "id": "avatar", "label": "Photo" },
    { "type": "text", "id": "avatar_asset", "label": "Theme asset filename (used when no photo is picked)", "default": "oldtoms-support-agent.jpg" },
    { "type": "text", "id": "support_heading", "label": "Heading", "default": "Still Need Help? Contact Us" },
    { "type": "textarea", "id": "support_text", "label": "Text", "default": "Our mouse experts are here to help — from placement tips to picking the right pack size." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Our customer support is open Monday to Friday, 8am–8pm." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does it really take to work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most customers see mouse activity drop within 72 hours.</p>" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Old Tom's FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does it really take to work?", "answer": "<p>Most customers see mouse activity drop within 72 hours. By week two, entry points are fully blocked and pheromone trails wiped out. By week three, mice have completely abandoned the property. Results vary depending on how bad the infestation is and how many entry points you have.</p>" } },
        { "type": "question", "settings": { "question": "Will it keep them gone, or just move them on for a bit?", "answer": "<p>Yes — for good. If mice don't leave within 30 days, contact us and we'll refund you in full. No forms, no fuss, no questions asked. You risk nothing.</p>" } },
        { "type": "question", "settings": { "question": "Is it really safe around my dog / grandkids / livestock?", "answer": "<p>100%. No poison, no chemicals, no neurotoxins of any kind. The formula is made entirely from natural oils — peppermint, cinnamon, cedarwood and castor oil. Completely harmless to people and animals. Only mice find it unbearable.</p>" } },
        { "type": "question", "settings": { "question": "How many do I need, and where do they go?", "answer": "<p>It depends what you're protecting. A single room or caravan needs 1 pack. A whole house needs 2 packs. A large house with a garage or barn needs 3 packs. Place pouches every 2.5–3 metres along known entry points — doors, windows, under sinks, behind appliances, cellar and loft corners. The more entry points you cover, the faster it works.</p>" } },
        { "type": "question", "settings": { "question": "What if it doesn't work — can I get my money back?", "answer": "<p>Yes — completely. If mice don't leave within 30 days, contact us and we'll refund you in full. No forms, no fuss, no questions asked. You risk nothing.</p>" } },
        { "type": "question", "settings": { "question": "How is this different from the peppermint spray I've already tried?", "answer": "<p>Strength and delivery. Shop-bought sprays contain less than 1% peppermint oil and evaporate within hours. Old Tom's pouches hold an 8% concentration formula in a castor oil base that releases slowly and steadily for 90 days straight. There's no comparison.</p>" } },
        { "type": "question", "settings": { "question": "How long does one pouch last?", "answer": "<p>90 days. Our castor oil base gives a slow, steady release — keeping full strength for the whole 90 days with no reapplying or topping up. Just replace every 90 days for non-stop protection.</p>" } },
        { "type": "question", "settings": { "question": "Do I need to do anything, or just put it down?", "answer": "<p>Just put it down. No setting up, no baiting, no checking, no resetting. Place pouches at entry points and the formula does the rest. The only thing to remember is to replace them every 90 days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
