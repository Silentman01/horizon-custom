<section class="au-h au-h--dark" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-h-wrap au-h-gu">
    <div class="au-h-gu__seal">
      <svg viewBox="0 0 220 220" role="img" aria-label="{{ section.settings.num }} {{ section.settings.unit }} {{ section.settings.seal_text | escape }}">
        <defs>
          <linearGradient id="au-h-gu-g-{{ section.id }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#E5C77E"/><stop offset="1" stop-color="#C99A3A"/></linearGradient>
          <path id="au-h-gu-p-{{ section.id }}" d="M110 110 m-76 0 a76 76 0 1 1 152 0 a76 76 0 1 1 -152 0"/>
        </defs>
        <circle cx="110" cy="110" r="106" fill="none" stroke="#C99A3A" stroke-width="1.5" stroke-dasharray="3 5"/>
        <circle cx="110" cy="110" r="98" fill="url(#au-h-gu-g-{{ section.id }})"/>
        <circle cx="110" cy="110" r="90" fill="#2A1E12"/>
        <circle cx="110" cy="110" r="84" fill="none" stroke="#C99A3A" stroke-width="0.8" opacity="0.6"/>
        <text fill="#DDB866" font-size="11.5" font-weight="600" letter-spacing="2.4" font-family="sans-serif"><textPath href="#au-h-gu-p-{{ section.id }}" startOffset="0">{{ section.settings.seal_text }}</textPath></text>
        <text x="110" y="128" text-anchor="middle" fill="url(#au-h-gu-g-{{ section.id }})" font-size="64" font-weight="600" font-family="Georgia, serif">{{ section.settings.num }}</text>
        <text x="110" y="152" text-anchor="middle" fill="#DDB866" font-size="13" font-weight="600" letter-spacing="4" font-family="sans-serif">{{ section.settings.unit }}</text>
      </svg>
    </div>
    <div class="au-h-gu__body">
      {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {% render 'aurea-title', text: section.settings.heading, class: 'au-h-h2' %}
      <p class="au-h-gu__p">{{ section.settings.text }}</p>
      <ul class="au-h-gu__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="au-h-gu__ico">{%- case block.settings.icon -%}{%- when 'truck' -%}<svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>{%- else -%}{% render 'aurea-icon', name: block.settings.icon %}{%- endcase -%}</span><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{% stylesheet %}
  .au-h { padding: 60px 0; font-family: var(--au-body); color: #2A2E29; background: #fff; }
  .au-h *, .au-h *::before, .au-h *::after { box-sizing: border-box; }
  .au-h--parch { background: var(--au-parchment); }
  .au-h--pine { background: var(--au-pine); }
  .au-h--dark { background: var(--au-espresso); }
  .au-h.au-h--dark, .au-h.au-h--pine, .au-h.au-h-hero { color: #fff; }
  .au-h-wrap { width: calc(100% - 32px); max-width: 1200px; margin-inline: auto; }
  .au-h-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .au-h-h2 { font-size: 31px; line-height: 1.08; }
  .au-h-sub { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.6; color: #4A5249; }
  .au-h-i { width: 1em; height: 1em; flex: none; }
  .au-h .au-icon { width: 1em; height: 1em; flex: none; }
  .au-h-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 0 32px; border-radius: 999px; background: var(--au-pine); color: var(--au-parchment); font-family: var(--au-body); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .au-h-btn:hover { filter: brightness(1.12); }
  .au-h-btn:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 3px; }
  .au-h-btn .au-h-i { font-size: 18px; }
  .au-h-btn--gold { background: var(--au-gold); color: #1E1A10; }
  .au-h-btn--ghost { background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.55); }
  .au-h-dark .au-title, .au-h--dark .au-title, .au-h--pine .au-title { color: #fff; }
  .au-h-dark .au-title em, .au-h--dark .au-title em, .au-h--pine .au-title em { color: #DDB866; }
  .au-h--dark .au-eyebrow, .au-h--pine .au-eyebrow { color: #DDB866; }
  .au-h-tp { display: inline-flex; gap: 2px; }
  .au-h-tp svg { width: 20px; height: 20px; padding: 3px; background: #00B67A; }
  .au-h-ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #f1f1f1, #dcdcdc); color: #6b6b6b; font-size: 12px; text-align: center; }
  @media (min-width: 750px) { .au-h { padding: 72px 0; } .au-h-wrap { width: calc(100% - 48px); } .au-h-head { margin-bottom: 56px; } .au-h-h2 { font-size: 36px; } .au-h-btn { width: auto; } }
  @media (min-width: 990px) { .au-h { padding: 96px 0; } .au-h-h2 { font-size: 44px; } }

  .au-h-gu { display: grid; gap: 32px; align-items: center; justify-items: center; max-width: 1040px; text-align: center; }
  .au-h-gu__seal { width: 160px; }
  .au-h-gu__seal svg { display: block; width: 100%; height: auto; }
  .au-h-gu__p { margin: 18px 0 28px; font-size: 17px; line-height: 1.7; color: rgb(255 255 255 / 0.8); }
  .au-h-gu__list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; text-align: left; }
  .au-h-gu__list li { display: flex; gap: 14px; align-items: flex-start; padding: 18px; border: 1px solid rgb(221 184 102 / 0.22); border-radius: 14px; background: rgb(255 255 255 / 0.06); }
  .au-h-gu__ico { flex: none; color: #DDB866; font-size: 26px; display: grid; }
  .au-h-gu__list strong { display: block; margin-bottom: 4px; font-size: 15px; }
  .au-h-gu__list div > span { font-size: 13px; line-height: 1.5; color: rgb(255 255 255 / 0.7); }
  @media (min-width: 990px) {
    .au-h-gu { grid-template-columns: 220px 1fr; gap: 56px; text-align: left; justify-items: stretch; }
    .au-h-gu__seal { width: 220px; }
    .au-h-gu__list { grid-template-columns: repeat(3, 1fr); }
    .au-h-gu__list li { display: block; }
    .au-h-gu__ico { margin-bottom: 10px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea home guarantee",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (*word* = gold italic)",
      "default": "Wear it for 30 days. *Risk-free.*"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "If it doesn't feel right, send it back within 30 days for a full refund. No questions asked. That's how sure we are."
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Seal ring text",
      "default": "MONEY-BACK GUARANTEE • RISK-FREE •"
    },
    {
      "type": "text",
      "id": "num",
      "label": "Seal number",
      "default": "30"
    },
    {
      "type": "text",
      "id": "unit",
      "label": "Seal unit",
      "default": "DAYS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "truck",
              "label": "truck"
            },
            {
              "value": "shield",
              "label": "shield"
            },
            {
              "value": "lock",
              "label": "lock"
            },
            {
              "value": "clock",
              "label": "clock"
            },
            {
              "value": "gem",
              "label": "gem"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": ""
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea home guarantee",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free express shipping",
            "text": "On every order, with tracking."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "30-day money-back",
            "text": "Full refund, no questions asked."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Encrypted, protected payment."
          }
        }
      ]
    }
  ]
}
{% endschema %}
