{%- render 'oralys-v2-base' -%}
{%- assign s = section.settings -%}
{%- liquid
  assign h = s.heading
  if s.accent_word != blank
    assign em = '<em>' | append: s.accent_word | append: '</em>'
    assign h = h | replace_first: s.accent_word, em
  endif
-%}
<section class="ov2 ov2-sec ov2-gap" style="--ov2-bg:{{ s.c_bg }}">
  <div class="ov2-in ov2-gap__grid">
    <div class="ov2-gap__media">
      <figure class="ov2-gap__fig">
        {% render 'oralys-pdp-media', image: s.image, asset: s.asset, alt: s.image_alt, class: 'ov2-gap__img', width: 1200, height: 900 %}
        {%- if s.caption != blank %}<figcaption class="ov2-gap__cap">{{ s.caption }}</figcaption>{% endif -%}
      </figure>
    </div>
    <div class="ov2-gap__txt">
      <h2 class="ov2-h2">{{ h }}</h2>
      {%- if s.intro != blank %}<p class="ov2-gap__intro">{{ s.intro }}</p>{% endif -%}
      <ol class="ov2-gap__steps" role="list">
        {%- for n in (1..3) -%}
          {%- assign kt = 'step_' | append: n | append: '_title' -%}
          {%- assign kb = 'step_' | append: n | append: '_body' -%}
          {%- if s[kt] == blank %}{% continue %}{% endif -%}
          <li class="ov2-gap__step"><span class="ov2-gap__n" aria-hidden="true">{{ n }}</span><div><h3>{{ s[kt] }}</h3><p>{{ s[kb] }}</p></div></li>
        {%- endfor -%}
      </ol>
      {%- if s.link != blank %}<a class="ov2-link" href="#oralys-pdp-offer" data-ov2-packs>{{ s.link }}</a>{% endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ov2-gap__grid{display:flex;flex-direction:column;gap:22px}
.ov2-gap__txt{display:contents}
.ov2-gap__txt .ov2-h2{order:-2;margin:0}
.ov2-gap__intro{order:-1;font-size:17px;line-height:1.5}
.ov2-gap__fig{margin:0}
.ov2-gap__img{width:100%;height:auto;display:block;border-radius:14px;background:#fff}
.ov2-gap__cap{margin-top:10px;font-size:16px;line-height:1.45;color:#5C6863;font-style:italic}
.ov2-gap__steps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px}
.ov2-gap__step{display:flex;gap:14px;align-items:flex-start}
.ov2-gap__n{flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#0E6B50;color:#fff;font-weight:700;font-size:15px;display:flex;align-items:center;justify-content:center;margin-top:1px}
.ov2-gap__step h3{margin:0 0 4px;font-size:18px;font-weight:700;line-height:1.3}
.ov2-gap__step p{font-size:16px;line-height:1.5}
@media (min-width:750px){
  .ov2-gap__grid{display:grid;grid-template-columns:6fr 6fr;gap:56px;align-items:center}
  .ov2-gap__txt{display:flex;flex-direction:column;gap:22px}
  .ov2-gap__txt .ov2-h2{order:0}
  .ov2-gap__intro{order:0}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : le vide",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce n'est pas la colle qui manque, c'est un vide" },
    { "type": "text", "id": "accent_word", "label": "Mot en vert", "default": "vide" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Vous n'y êtes pour rien, et votre dentier non plus. Avec les années, l'os qui le portait a fondu. Aucune crème, même posée à la lettre, ne peut remplir cet espace." },
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "text", "id": "asset", "label": "Illustration : fichier du thème", "default": "oralys-pdp-gap-illustration.webp" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Avant : un vide sous le dentier. Avec Oralys : le vide est comblé." },
    { "type": "textarea", "id": "caption", "label": "Légende", "default": "Même la notice de votre crème le reconnaît : « ne pas utiliser en excès si la prothèse est mal ajustée »." },
    { "type": "text", "id": "step_1_title", "label": "Étape 1 : titre", "default": "L'os fond, le vide se creuse" },
    { "type": "textarea", "id": "step_1_body", "label": "Étape 1 : texte", "default": "Après les extractions, la gencive s'affine lentement. Le dentier, lui, garde sa forme. Un espace s'ouvre dessous, et c'est lui qui fait basculer la plaque quand vous mâchez." },
    { "type": "text", "id": "step_2_title", "label": "Étape 2 : titre", "default": "La crème ne comble rien" },
    { "type": "textarea", "id": "step_2_body", "label": "Étape 2 : texte", "default": "Elle colle seulement deux surfaces qui se touchent. Dans le vide, elle s'étale, puis la salive l'emporte en quelques heures. Bien loin des 24 h promises sur le tube." },
    { "type": "text", "id": "step_3_title", "label": "Étape 3 : titre", "default": "Oralys remplit le vide" },
    { "type": "textarea", "id": "step_3_body", "label": "Étape 3 : texte", "default": "Ramolli à l'eau chaude, le gel prend la forme exacte de votre gencive, puis se raffermit. Le dentier repose à nouveau sur un appui plein, pour 2 à 3 jours." },
    { "type": "text", "id": "link", "label": "Lien vers les packs", "default": "Voir les packs →" },
    { "type": "color", "id": "c_bg", "label": "Fond", "default": "#EEF6F1" }
  ],
  "presets": [{ "name": "Oralys v2 : le vide" }]
}
{% endschema %}
