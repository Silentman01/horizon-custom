{%- assign s = section.settings -%}
<section class="ot-home-best" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <h2 class="ot-home-best__heading">{{ s.heading }}</h2>
  <div class="ot-home-best__rail" data-ot-drag>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a class="ot-home-best__card" href="{{ b.link | default: '/products/mouse-repellent-pouches' }}" draggable="false" {{ block.shopify_attributes }}>
        <span class="ot-home-best__img">
          {% render 'oldtoms-media', image: b.image, asset: b.asset, ratio: '1 / 1', alt: b.title %}
          {%- if b.flag != blank -%}<span class="ot-home-best__flag">{{ b.flag }}</span>{%- endif -%}
          {%- if b.tag != blank -%}<span class="ot-home-best__tag">{{ b.tag }}</span>{%- endif -%}
        </span>
        <span class="ot-home-best__title">{{ b.title }}</span>
        {%- if b.reviews != blank -%}<span class="ot-home-best__rating"><span class="ot-home-best__stars" aria-hidden="true">★★★★★</span> {{ b.reviews }}</span>{%- endif -%}
        <span class="ot-home-best__price">{{ b.price }}{% if b.compare_at != blank %} <s>{{ b.compare_at }}</s>{% endif %}</span>
      </a>
    {%- endfor -%}
  </div>
  {%- if s.button_label != blank -%}
    <p class="ot-home-best__more"><a class="ot-home-best__button" href="{{ s.button_link | default: '/collections/all' }}">{{ s.button_label }}</a></p>
  {%- endif -%}
</section>
{% render 'oldtoms-home-drag' %}

{% stylesheet %}
.ot-home-best { background: var(--ot-bg); padding: var(--ot-pt) 0 var(--ot-pb); font-family: var(--ot-font); color: #121212; }
.ot-home-best__heading { margin: 0 0 24px; padding-inline: 16px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 32px; line-height: 1.15; color: #242424; }
.ot-home-best__rail { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; padding-inline: 16px; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
.ot-home-best__rail::-webkit-scrollbar { display: none; }
.ot-home-best__rail.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
.ot-home-best__card { flex: 0 0 clamp(230px, 72vw, 300px); scroll-snap-align: start; display: flex; flex-direction: column; gap: 6px; color: inherit; text-decoration: none; }
.ot-home-best__img { position: relative; display: block; border-radius: 6px; overflow: hidden; }
.ot-home-best__img img { pointer-events: none; }
.ot-home-best__tag { position: absolute; right: 8px; bottom: 8px; background: var(--ot-lime); color: var(--ot-green); border-radius: 999px; padding: 4px 12px; font-weight: 600; font-size: 12px; }
.ot-home-best__flag { position: absolute; left: 8px; bottom: 8px; background: #fff; color: var(--ot-green); border-radius: 999px; padding: 4px 10px; font-weight: 600; font-size: 11px; }
.ot-home-best__title { font-weight: 500; font-size: 14px; }
.ot-home-best__rating { font-size: 12px; }
.ot-home-best__stars { color: #F5A623; letter-spacing: 1px; }
.ot-home-best__price { font-size: 13px; }
.ot-home-best__price s { color: var(--ot-muted); margin-left: 4px; }
.ot-home-best__more { margin: 28px 0 0; text-align: center; }
.ot-home-best__button { display: inline-flex; align-items: center; justify-content: center; min-width: 200px; height: 40px; padding: 0 24px; border-radius: 999px; background: var(--ot-lime); color: var(--ot-green); font-weight: 700; font-size: 12px; text-decoration: none; }
@media screen and (min-width: 990px) {
  .ot-home-best__heading { font-size: 42px; }
  .ot-home-best__rail { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; max-width: 1320px; margin: 0 auto; padding-inline: 24px; overflow: visible; cursor: auto; }
  .ot-home-best__card { flex: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's bestsellers",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Bestsellers" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop All Products" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Blank = all products." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 48, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Image: theme file", "info": "Used when no image is uploaded." },
        { "type": "text", "id": "title", "label": "Title", "default": "Rodent Repellent Pouches" },
        { "type": "text", "id": "tag", "label": "Pack tag", "default": "12 Pouches" },
        { "type": "text", "id": "flag", "label": "Flag (bottom left)" },
        { "type": "text", "id": "reviews", "label": "Reviews line (optional)", "info": "Shows 5 stars plus this text, e.g. 1357 reviews." },
        { "type": "text", "id": "price", "label": "Price", "default": "£35.00" },
        { "type": "text", "id": "compare_at", "label": "Compare-at price", "default": "£68.00" },
        { "type": "url", "id": "link", "label": "Link", "info": "Blank = /products/mouse-repellent-pouches." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Old Tom's bestsellers",
      "blocks": [
        { "type": "card", "settings": { "asset": "oldtoms-packshot.png", "title": "Rodent Repellent Pouches", "tag": "12 Pouches", "flag": "UK Shipping", "price": "£35.00", "compare_at": "£68.00" } },
        { "type": "card", "settings": { "asset": "oldtoms-bestseller-02.jpg", "title": "Spider Repellent Pouches", "tag": "6 Pouches", "price": "£13.00", "compare_at": "" } }
      ]
    }
  ]
}
{% endschema %}
