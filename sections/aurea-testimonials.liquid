<section class="au-testi" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-testi__head">
    {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {% render 'aurea-title', text: section.settings.heading, class: 'au-testi__h' %}
  </div>
  <aurea-rail class="au-testi__rail">
    {%- for block in section.blocks -%}
      <article class="au-testi__card" {{ block.shopify_attributes }}>
        <span class="au-testi__avatar">
          {%- if block.settings.avatar -%}
            {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 44, height: 44 }}
          {%- elsif block.settings.avatar_asset != blank -%}
            <img src="{{ block.settings.avatar_asset | asset_url }}" alt="" loading="lazy" width="44" height="44">
          {%- endif -%}
        </span>
        <div class="au-testi__main">
          <div class="au-testi__bubble">
            <p class="au-testi__name">{{ block.settings.name }} <svg viewBox="0 0 16 16" width="13" height="13" aria-label="Verified"><circle cx="8" cy="8" r="8" fill="#c99a3a"/><path d="M4.5 8.2l2.3 2.3 4.4-4.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
            <p class="au-testi__stars" aria-label="5 out of 5 stars">★★★★★</p>
            <p class="au-testi__quote">{{ block.settings.quote }}</p>
            <span class="au-testi__react"><span aria-hidden="true">👍❤️</span> {{ block.settings.likes }}</span>
          </div>
          <p class="au-testi__actions"><span>Like</span> <span>Reply</span> <span>{{ block.settings.age }}</span></p>
        </div>
      </article>
    {%- endfor -%}
  </aurea-rail>
</section>
{% render 'aurea-drag' %}
{% stylesheet %}
  .au-testi { max-width: 1080px; margin: 0 auto; padding: 28px 16px; background: var(--au-bg); }
  .au-testi__head { margin-bottom: 20px; text-align: center; }
  .au-testi__h { font-size: clamp(26px, 4vw, 38px); }
  .au-testi__rail { gap: 18px; padding: 8px 4px 22px; }
  .au-testi__card { flex: 0 0 84%; display: flex; gap: 10px; }
  .au-testi__avatar { flex: none; width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: #d8dadf; }
  .au-testi__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .au-testi__main { min-width: 0; flex: 1; }
  .au-testi__bubble { position: relative; height: calc(100% - 28px); padding: 8px 14px 14px; border-radius: 18px; background: #f0f2f5; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #050505; }
  .au-testi__name { display: flex; align-items: center; gap: 5px; margin: 0; font-size: 13px; font-weight: 600; }
  .au-testi__stars { margin: 2px 0 4px; font-size: 14px; letter-spacing: 1px; color: var(--au-gold); }
  .au-testi__quote { margin: 0; font-size: 14.5px; line-height: 1.34; }
  .au-testi__react { position: absolute; right: -6px; bottom: -12px; padding: 1px 6px; border-radius: 999px; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.25); font-size: 11px; color: #65676b; }
  .au-testi__actions { display: flex; gap: 12px; margin: 8px 0 0 12px; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 13px; font-weight: 600; color: #65676b; }
  @media (min-width: 750px) { .au-testi__card { flex-basis: calc((100% - 36px) / 3); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real customers" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "Trusted by *thousands*" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar (empty = grey placeholder)" },
        { "type": "text", "id": "avatar_asset", "label": "Avatar theme asset (fallback filename)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Daniel R." },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Signed the client I'd chased for a year, three days after I put it on." },
        { "type": "text", "id": "likes", "label": "Reaction count", "default": "24" },
        { "type": "text", "id": "age", "label": "Age label", "default": "3d" }
      ]
    }
  ],
  "presets": [ { "name": "Aurea testimonials", "blocks": [ { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" } ] } ]
}
{% endschema %}
