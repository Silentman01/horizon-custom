<section class="au-h au-h--parch" id="stones" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-h-wrap">
    <div class="au-h-head ">
  {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {% render 'aurea-title', text: section.settings.heading, class: 'au-h-h2' %}
  {%- if section.settings.sub != blank -%}<p class="au-h-sub">{{ section.settings.sub }}</p>{%- endif -%}
</div>
    <div class="au-h-st">
      {%- for block in section.blocks -%}
        <article class="au-h-st__card" {{ block.shopify_attributes }}>
          <div class="au-h-st__img">{% render 'aurea-media', image: block.settings.image, ratio: '1 / 1', radius: 0, sizes: '(min-width: 990px) 380px, 120px', label: 'Stone image 1:1' %}</div>
          <div class="au-h-st__body">
            <p class="au-h-st__tag">{{ block.settings.tag }}</p>
            <h3 class="au-h-st__name">{{ block.settings.name }}</h3>
            <p class="au-h-st__text">{{ block.settings.text }}</p>
            {%- assign chips = block.settings.chips | split: ',' -%}
            <ul class="au-h-st__chips">{%- for chip in chips -%}<li>{{ chip | strip }}</li>{%- endfor -%}</ul>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}
  .au-h { padding: 60px 0; font-family: var(--au-body); color: #2A2E29; background: #fff; }
  .au-h *, .au-h *::before, .au-h *::after { box-sizing: border-box; }
  .au-h--parch { background: var(--au-parchment); }
  .au-h--pine { background: var(--au-pine); }
  .au-h--dark { background: var(--au-espresso); }
  .au-h.au-h--dark, .au-h.au-h--pine, .au-h.au-h-hero { color: #fff; }
  .au-h-wrap { width: calc(100% - 32px); max-width: 1200px; margin-inline: auto; }
  .au-h-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .au-h-h2 { font-size: 31px; line-height: 1.08; }
  .au-h-sub { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.6; color: #4A5249; }
  .au-h-i { width: 1em; height: 1em; flex: none; }
  .au-h .au-icon { width: 1em; height: 1em; flex: none; }
  .au-h-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 0 32px; border-radius: 999px; background: var(--au-pine); color: var(--au-parchment); font-family: var(--au-body); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .au-h-btn:hover { filter: brightness(1.12); }
  .au-h-btn:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 3px; }
  .au-h-btn .au-h-i { font-size: 18px; }
  .au-h-btn--gold { background: var(--au-gold); color: #1E1A10; }
  .au-h-btn--ghost { background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.55); }
  .au-h-dark .au-title, .au-h--dark .au-title, .au-h--pine .au-title { color: #fff; }
  .au-h-dark .au-title em, .au-h--dark .au-title em, .au-h--pine .au-title em { color: #DDB866; }
  .au-h--dark .au-eyebrow, .au-h--pine .au-eyebrow { color: #DDB866; }
  .au-h-tp { display: inline-flex; gap: 2px; }
  .au-h-tp svg { width: 20px; height: 20px; padding: 3px; background: #00B67A; }
  .au-h-ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #f1f1f1, #dcdcdc); color: #6b6b6b; font-size: 12px; text-align: center; }
  @media (min-width: 750px) { .au-h { padding: 72px 0; } .au-h-wrap { width: calc(100% - 48px); } .au-h-head { margin-bottom: 56px; } .au-h-h2 { font-size: 36px; } .au-h-btn { width: auto; } }
  @media (min-width: 990px) { .au-h { padding: 96px 0; } .au-h-h2 { font-size: 44px; } }

  .au-h-st { display: grid; gap: 14px; }
  .au-h-st__card { display: grid; grid-template-columns: 120px 1fr; gap: 14px; align-items: center; padding: 10px; overflow: hidden; border: 1px solid var(--au-line); border-radius: 6px; background: #fff; transition: transform 0.25s, box-shadow 0.25s; }
  .au-h-st__img .au-media { border-radius: 4px; }
  .au-h-st__tag { margin: 0 0 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--au-gold); }
  .au-h-st__name { margin: 0 0 6px; font-family: var(--au-heading); font-size: 21px; font-weight: 600; line-height: 1.15; color: var(--au-pine); }
  .au-h-st__text { margin: 0; font-size: 14.5px; line-height: 1.55; color: #4A5249; }
  .au-h-st__chips { display: none; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
  .au-h-st__chips li { padding: 6px 12px; border-radius: 999px; background: #EAF0E6; color: var(--au-pine); font-size: 12px; font-weight: 600; }
  @media (min-width: 750px) {
    .au-h-st { grid-template-columns: repeat(2, 1fr); gap: 28px; }
    .au-h-st__card { display: block; padding: 0; }
    .au-h-st__img .au-media { border-radius: 0; }
    .au-h-st__body { padding: 24px 24px 28px; }
    .au-h-st__name { font-size: 26px; }
    .au-h-st__text { font-size: 16px; line-height: 1.6; }
    .au-h-st__chips { display: flex; }
    .au-h-st__card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgb(42 30 18 / 0.1); }
  }
  @media (min-width: 990px) { .au-h-st { grid-template-columns: repeat(3, 1fr); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea home stones",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The three stones"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (*word* = gold italic)",
      "default": "Three stones. *One intention.*"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Sub-line",
      "default": "Each stone has one job. Nothing here is just decoration."
    }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Stone",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square 1:1 (800px), macro still-life, no text"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "The Merchant's Stone"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Citrine"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "chips",
          "label": "Chips (comma separated)",
          "default": "Prosperity, Confidence, Success"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea home stones",
      "blocks": [
        {
          "type": "stone",
          "settings": {
            "tag": "The Merchant's Stone",
            "name": "Citrine",
            "text": "Valued for centuries as the stone of prosperity. Its warm golden glow is linked to confidence, success and money that comes in and stays.",
            "chips": "Prosperity, Confidence, Success"
          }
        },
        {
          "type": "stone",
          "settings": {
            "tag": "The Stone of Luck",
            "name": "Green Aventurine",
            "text": "The lucky charm of the crystal world. A soft green stone tied to good fortune, new opportunities and the nerve to say yes to them.",
            "chips": "Luck, Opportunity, Optimism"
          }
        },
        {
          "type": "stone",
          "settings": {
            "tag": "The Stone of Renewal",
            "name": "African Turquoise",
            "text": "A deep green stone of change, for closing old chapters and growing into what comes next.",
            "chips": "Renewal, Growth, Protection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
