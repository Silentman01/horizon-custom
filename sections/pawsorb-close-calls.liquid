{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-cc" style="--pawsorb-cc-pt: {{ ss.padding_top }}px; --pawsorb-cc-pb: {{ ss.padding_bottom }}px; --pawsorb-cc-bg: {{ ss.bg_color }}; --pawsorb-cc-fg: {{ ss.text_color }}; --pawsorb-cc-accent: {{ ss.accent_color }};">
  <div class="pawsorb-cc__inner">
    <div class="pawsorb-cc__head">
      {%- if ss.heading != blank -%}<h2 class="pawsorb-cc__h">{{ ss.heading }}</h2>{%- endif -%}
      {%- if ss.rating_line != blank -%}
        <p class="pawsorb-cc__rating">{{ ss.rating_line | replace: '★', '<span class="pawsorb-cc__stars">★★★★★</span>' }}</p>
      {%- endif -%}
    </div>
    <div class="pawsorb-cc__rail" data-pawsorb-rail>
      {%- assign hidden_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- if bs.hidden_initially -%}{%- assign hidden_count = hidden_count | plus: 1 -%}{%- endif -%}
        <article class="pawsorb-cc__card{% if bs.hidden_initially %} is-more{% endif %}{% unless bs.show_photo %} is-text{% endunless %}" {{ block.shopify_attributes }}>
          {%- if bs.show_photo -%}
            {% render 'pawsorb-media', image: bs.image, asset: bs.image_asset, alt: bs.alt, ratio: '4 / 5', icon: bs.icon, tone: 'tint', sizes: '(min-width: 750px) 300px, 78vw' %}
          {%- endif -%}
          <div class="pawsorb-cc__body">
            <div class="pawsorb-cc__meta">
              <span class="pawsorb-cc__cstars" aria-label="5 out of 5 stars">{%- for i in (1..5) -%}{% render 'pawsorb-icon', name: 'star', size: 14 %}{%- endfor -%}</span>
              {%- if ss.verified_label != blank -%}<span class="pawsorb-cc__ver">{% render 'pawsorb-icon', name: 'check-circle', size: 14 %}{{ ss.verified_label }}</span>{%- endif -%}
            </div>
            {%- if bs.tag != blank -%}<span class="pawsorb-cc__tag">{{ bs.tag }}</span>{%- endif -%}
            <p class="pawsorb-cc__text">{{ bs.text }}</p>
            <p class="pawsorb-cc__name">{{ bs.name }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if hidden_count > 0 and ss.more_label != blank -%}
      <div class="pawsorb-cc__morewrap">
        <button type="button" class="pawsorb-cc__more" onclick="var r=this.closest('.pawsorb-cc');r.classList.add('is-open');this.parentNode.remove();var c=r.querySelector('.pawsorb-cc__card.is-more');if(c){var rail=c.parentNode;rail.scrollTo({left:c.offsetLeft-rail.offsetLeft-16,behavior:'smooth'});}">{{ ss.more_label }}</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-cc { padding: var(--pawsorb-cc-pt, 64px) 0 var(--pawsorb-cc-pb, 64px); background: var(--pawsorb-cc-bg, #F1F6F3); color: var(--pawsorb-cc-fg, #141816); overflow: hidden; }
  .pawsorb-cc__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-cc__head { text-align: center; margin-bottom: 26px; }
  .pawsorb-cc__h { margin: 0 0 8px; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-cc__rating { display: inline-flex; align-items: center; gap: 8px; margin: 0; font-size: 15px; font-weight: 600; }
  .pawsorb-cc__stars, .pawsorb-cc__cstars { display: inline-flex; gap: 1px; color: #F5B400; }
  .pawsorb-cc__rail { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 0; scrollbar-width: none; cursor: grab; overscroll-behavior-x: contain; padding-bottom: 4px; }
  .pawsorb-cc__rail::-webkit-scrollbar { display: none; }
  .pawsorb-cc__rail.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .pawsorb-cc__card { flex: 0 0 calc((100% - 48px) / 3.6); scroll-snap-align: start; display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; background: #fff; border: 1px solid #DCE6E0; }
  .pawsorb-cc__card.is-more { display: none; }
  .pawsorb-cc.is-open .pawsorb-cc__card.is-more { display: flex; }
  .pawsorb-cc__card .pawsorb-media { --pawsorb-media-radius: 0; }
  .pawsorb-cc__card img { -webkit-user-drag: none; }
  .pawsorb-cc__body { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px 16px; flex: 1; }
  .pawsorb-cc__card.is-text .pawsorb-cc__body { justify-content: center; padding: 24px 20px; }
  .pawsorb-cc__meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .pawsorb-cc__ver { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: #12855A; }
  .pawsorb-cc__tag { align-self: flex-start; padding: 3px 10px; border-radius: 999px; background: rgba(18, 133, 90, .09); color: var(--pawsorb-cc-accent, #12855A); font: 700 12px/1.4 var(--font-body--family); }
  .pawsorb-cc__text { margin: 0; font-size: 15px; line-height: 1.5; flex: 1; }
  .pawsorb-cc__name { margin: 0; font-size: 14px; font-weight: 700; color: #121614; }
  .pawsorb-cc__morewrap { text-align: center; margin-top: 22px; }
  .pawsorb-cc__more { min-height: 46px; padding: 0 22px; border-radius: 10px; border: 1.5px solid #121614; background: transparent; color: #121614; font: 700 15px/1 var(--font-heading--family); cursor: pointer; }
  .pawsorb-cc__more:hover { background: #121614; color: #fff; }
  @media screen and (max-width: 749px) {
    .pawsorb-cc { padding: calc(var(--pawsorb-cc-pt, 64px) * .75) 0 calc(var(--pawsorb-cc-pb, 64px) * .75); }
    .pawsorb-cc__h { font-size: 26px; }
    .pawsorb-cc__head { margin-bottom: 18px; }
    .pawsorb-cc__rail { gap: 12px; margin: 0 -16px; padding: 0 16px 4px; scroll-padding-inline: 16px; }
    .pawsorb-cc__card { flex-basis: 78%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb stories",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name + place", "default": "Dana R. · Tampa, FL" },
        { "type": "text", "id": "tag", "label": "Toxin tag", "default": "Cane toad" },
        { "type": "textarea", "id": "text", "label": "Story", "default": "Bought it in April after a neighbor's dog died. Used it in July. Our Lab mouthed a toad by the pool at 10 p.m. I wiped his gums, gave the tube, then drove. The ER said we did it right. He's snoring next to me." },
        { "type": "checkbox", "id": "show_photo", "label": "Show photo", "default": true },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Theme file", "default": "pawsorb-review-1-toad.jpg", "info": "File in assets/. Until it exists, an icon tile is shown. The photo must match the story." },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Black Lab on a Florida porch with a PawSorb tube" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "toad", "options": [
          { "value": "toad", "label": "Toad" }, { "value": "chocolate", "label": "Chocolate" }, { "value": "grapes", "label": "Grapes" },
          { "value": "bait", "label": "Bait block" }, { "value": "pill", "label": "Pill" }, { "value": "mushroom", "label": "Mushroom" },
          { "value": "leaf", "label": "Plant" }, { "value": "paw", "label": "Paw" } ] },
        { "type": "checkbox", "id": "hidden_initially", "label": "Show only after \"Show more\"", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "\"Glad it was in the drawer.\"" },
    { "type": "text", "id": "rating_line", "label": "Rating line", "default": "★ 4.9 average · 4,554 reviews" },
    { "type": "text", "id": "verified_label", "label": "Verified chip", "default": "Verified buyer" },
    { "type": "text", "id": "more_label", "label": "Show more button", "default": "Show more stories" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F1F6F3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Tag color", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb stories",
      "blocks": [
        { "type": "review", "settings": { "name": "Dana R. · Tampa, FL", "tag": "Cane toad", "image_asset": "pawsorb-review-1-toad.jpg", "icon": "toad" } },
        { "type": "review", "settings": { "name": "Mike T. · Columbus, OH", "tag": "Christmas chocolate", "text": "Christmas Eve. Our beagle ate a whole box of chocolate from under the tree. Vet closed till the 26th. Gave PawSorb, called the ER line after. No trip needed. Cheaper than one hour in that waiting room.", "image_asset": "pawsorb-review-2-chocolate.jpg", "alt": "Beagle next to a torn chocolate box", "icon": "chocolate" } },
        { "type": "review", "settings": { "name": "Linda K. · Mesa, AZ", "tag": "Grapes", "text": "Lulu is 9 pounds. A handful of grapes rolled off the counter and she got three. I was shaking, but the dial did the math for me. Thirty seconds, start to finish. She's fine.", "image_asset": "pawsorb-review-3-small-dog.jpg", "alt": "Shih Tzu in her owner's lap with a PawSorb tube", "icon": "grapes" } }
      ]
    }
  ]
}
{% endschema %}
