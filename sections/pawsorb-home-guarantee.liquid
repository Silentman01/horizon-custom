{%- render 'pawsorb-home-base' -%}
{%- liquid
  assign ps_handle = section.settings.product_handle | default: 'pawsorb'
  assign ps_url = section.settings.button_link | default: ''
  if ps_url == blank
    assign ps_url = '/products/' | append: ps_handle
  endif
-%}
<section class="pawsorb-h pawsorb-h--navy pawsorb-hg" aria-label="{{ section.settings.heading | escape }}">
  <div class="pawsorb-h__wrap pawsorb-hg__grid">
    <div class="pawsorb-hg__visual">
      {%- capture ps_img -%}{%- render 'pawsorb-home-media', image: section.settings.image, asset: section.settings.image_asset, alt: section.settings.image_alt -%}{%- endcapture -%}
      {%- if ps_img != blank -%}<div class="pawsorb-h__media pawsorb-hg__media">{{ ps_img }}</div>{%- endif -%}
      <svg class="pawsorb-hg__seal{% if ps_img != blank %} is-over{% endif %}" viewBox="0 0 200 200" role="img" aria-label="{{ section.settings.seal_top }} {{ section.settings.seal_bottom }}">
        <defs><path id="pawsorb-hg-arc-{{ section.id }}" d="M30 100a70 70 0 0 1 140 0"/><path id="pawsorb-hg-arc2-{{ section.id }}" d="M26 100a74 74 0 0 0 148 0"/></defs>
        <circle cx="100" cy="100" r="96" fill="#12855A"/>
        <circle cx="100" cy="100" r="84" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="3 5"/>
        <circle cx="100" cy="100" r="54" fill="#fff"/>
        <text font-family="DM Sans,Arial,sans-serif" font-weight="700" font-size="15" fill="#fff" letter-spacing="2"><textPath href="#pawsorb-hg-arc-{{ section.id }}" startOffset="50%" text-anchor="middle">{{ section.settings.seal_top }}</textPath></text>
        <text font-family="DM Sans,Arial,sans-serif" font-weight="700" font-size="15" fill="#fff" letter-spacing="2" dy="12"><textPath href="#pawsorb-hg-arc2-{{ section.id }}" startOffset="50%" text-anchor="middle">{{ section.settings.seal_bottom }}</textPath></text>
        <text x="100" y="104" font-family="DM Sans,Arial,sans-serif" font-weight="700" font-size="44" fill="#121614" text-anchor="middle">{{ section.settings.seal_number }}</text>
        <text x="100" y="128" font-family="DM Sans,Arial,sans-serif" font-weight="700" font-size="14" fill="#121614" text-anchor="middle" letter-spacing="2">{{ section.settings.seal_unit }}</text>
      </svg>
    </div>
    <div class="pawsorb-hg__copy">
      <h2 class="pawsorb-h__h2">{{ section.settings.heading }}</h2>
      <p class="pawsorb-h__lead">{{ section.settings.body }}</p>
      <ul class="pawsorb-hg__chips" role="list">
        {%- if section.settings.chip_1 != blank -%}<li>{%- render 'pawsorb-home-icon', name: 'shield' -%}{{ section.settings.chip_1 }}</li>{%- endif -%}
        {%- if section.settings.chip_2 != blank -%}<li>{%- render 'pawsorb-home-icon', name: 'truck' -%}{{ section.settings.chip_2 }}</li>{%- endif -%}
      </ul>
      {%- if section.settings.button_label != blank -%}<a class="pawsorb-h__btn pawsorb-hg__btn" href="{{ ps_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pawsorb-hg__grid{display:grid;gap:24px;align-items:center}
.pawsorb-hg__visual{position:relative;display:flex;justify-content:center}
.pawsorb-hg__media{aspect-ratio:4/3;width:100%}
.pawsorb-hg__seal{width:150px;height:150px;filter:drop-shadow(0 10px 20px rgba(0,0,0,.3))}
.pawsorb-hg__seal.is-over{position:absolute;right:12px;bottom:-24px;width:110px;height:110px}
.pawsorb-hg__copy{text-align:center}
.pawsorb-hg__chips{list-style:none;margin:0 0 20px;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.pawsorb-hg__chips li{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:7px 12px;font-size:14px;font-weight:700}
.pawsorb-hg__chips svg{width:18px;height:18px}
.pawsorb-hg__btn{width:100%}
@media (min-width:750px){
  .pawsorb-hg__grid{grid-template-columns:320px 1fr;gap:56px;max-width:960px}
  .pawsorb-hg__seal{width:240px;height:240px}
  .pawsorb-hg__copy{text-align:left}
  .pawsorb-hg__chips{justify-content:flex-start}
  .pawsorb-hg__btn{width:auto;min-width:240px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb home guarantee",
  "tag": "div",
  "class": "pawsorb-home-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "If you never need it, send it back." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "90 days, full refund, no questions. Fast tracked US shipping." },
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "90-day money-back guarantee" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Fast US shipping" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get PawSorb" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = /products/ + product handle" },
    { "type": "text", "id": "product_handle", "label": "Product handle", "default": "pawsorb" },
    { "type": "text", "id": "seal_top", "label": "Seal top text", "default": "MONEY-BACK" },
    { "type": "text", "id": "seal_bottom", "label": "Seal bottom text", "default": "GUARANTEE" },
    { "type": "text", "id": "seal_number", "label": "Seal number", "default": "90" },
    { "type": "text", "id": "seal_unit", "label": "Seal unit", "default": "DAYS" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Fallback theme asset", "info": "e.g. pawsorb-home-guarantee.jpg. Empty = seal only." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Open shipping box with a PawSorb tube on a porch" }
  ],
  "presets": [{ "name": "PawSorb home guarantee" }]
}
{% endschema %}
