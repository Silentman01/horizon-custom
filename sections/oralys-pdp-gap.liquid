{%- liquid
  assign s = section.settings
  assign h = s.heading
  if s.accent != blank
    assign acc = '<em>' | append: s.accent | append: '</em>'
    assign h = h | replace: s.accent, acc
  endif
-%}
{%- assign rows_a = s.col_a_rows | newline_to_br | split: '<br />' -%}
{%- assign rows_b = s.col_b_rows | newline_to_br | split: '<br />' -%}
<div class="oralys-pdp-gap" style="--op-bg:{{ s.c_bg }};--op-text:{{ s.c_text }};--op-accent:{{ s.c_accent }};--op-muted:{{ s.c_muted }};--op-card:{{ s.c_card }};--op-line:{{ s.c_line }};--op-cta:{{ s.c_cta }};--op-cta-text:{{ s.c_cta_text }};--op-h-m:{{ s.h_m }}px;--op-h-d:{{ s.h_d }}px;--op-body:{{ s.body_size }}px;--op-align:{{ s.align }};--op-pt-m:{{ s.pt_m }}px;--op-pb-m:{{ s.pb_m }}px;--op-pt-d:{{ s.pt_d }}px;--op-pb-d:{{ s.pb_d }}px">
  <div class="oralys-pdp-gap__inner">
    <div class="oralys-pdp-gap__head">{% if s.eyebrow != blank %}<p class="oralys-pdp-gap__eyebrow">{{ s.eyebrow }}</p>{% endif %}{% if h != blank %}<h2 class="oralys-pdp-gap__h">{{ h }}</h2>{% endif %}</div>
    <div class="oralys-pdp-gap__grid{% if s.image_side == 'right' %} oralys-pdp-gap__grid--flip{% endif %}">
      <div class="oralys-pdp-gap__media">
        {%- if s.image != blank or s.asset != blank -%}<div class="oralys-pdp-gap__img">{% render 'oralys-pdp-media', image: s.image, asset: s.asset, alt: s.alt, class: 'oralys-pdp-gap__pic', loading: 'lazy', width: 1800, height: 1195 %}</div>{%- endif -%}
        {%- liquid
          assign loop_src = blank
          if s.loop_image != blank
            assign loop_src = s.loop_image | image_url: width: 900
          elsif s.loop_asset != blank
            assign loop_src = s.loop_asset | asset_url
          endif
        -%}
        {%- if s.show_loop and loop_src != blank -%}
        <div class="oralys-pdp-gap__loop" data-op-loop="{{ loop_src }}">
          {%- if s.loop_poster_image != blank -%}<img class="oralys-pdp-gap__lpic" src="{{ s.loop_poster_image | image_url: width: 900 }}" alt="{{ s.loop_alt | escape }}" loading="lazy" decoding="async" width="720" height="900" onerror="this.parentNode.hidden=true">{%- elsif s.loop_poster != blank -%}<img class="oralys-pdp-gap__lpic" src="{{ s.loop_poster | asset_url }}" alt="{{ s.loop_alt | escape }}" loading="lazy" decoding="async" width="720" height="900" onerror="this.parentNode.hidden=true">{%- else -%}<img class="oralys-pdp-gap__lpic" alt="{{ s.loop_alt | escape }}" loading="lazy" decoding="async" width="720" height="900" hidden>{%- endif -%}
        </div>
        {%- endif -%}
        {%- if s.show_small and s.small_image != blank or s.show_small and s.small_asset != blank -%}
        <div class="oralys-pdp-gap__small">{% render 'oralys-pdp-media', image: s.small_image, asset: s.small_asset, alt: s.small_alt, class: 'oralys-pdp-gap__spic', loading: 'lazy', width: 600, height: 600 %}<span>{{ s.small_alt }}</span></div>
        {%- endif -%}
      </div>
      <div class="oralys-pdp-gap__copy">
        {%- if s.story != blank %}<div class="oralys-pdp-gap__story">{{ s.story }}</div>{% endif -%}
        <ol class="oralys-pdp-gap__facts">
          {%- for block in section.blocks -%}
          <li class="oralys-pdp-gap__fact" {{ block.shopify_attributes }}><span class="oralys-pdp-gap__num">{{ forloop.index }}</span><div><h3 class="oralys-pdp-gap__ft">{{ block.settings.title }}</h3><p class="oralys-pdp-gap__fb">{{ block.settings.body }}</p></div></li>
          {%- endfor -%}
        </ol>
      </div>
      <div class="oralys-pdp-gap__aside">
        <div class="oralys-pdp-gap__cmp">
          <div class="oralys-pdp-gap__col oralys-pdp-gap__col--a"><p class="oralys-pdp-gap__ch">{{ s.col_a }}</p><ul role="list">{% for r in rows_a %}{% assign rs = r | strip %}{% if rs != blank %}<li><span class="oralys-pdp-gap__x" aria-hidden="true">✕</span>{{ rs }}</li>{% endif %}{% endfor %}</ul></div>
          <div class="oralys-pdp-gap__col oralys-pdp-gap__col--b"><p class="oralys-pdp-gap__ch">{{ s.col_b }}</p><ul role="list">{% for r in rows_b %}{% assign rs = r | strip %}{% if rs != blank %}<li><span class="oralys-pdp-gap__v" aria-hidden="true">✓</span>{{ rs }}</li>{% endif %}{% endfor %}</ul></div>
        </div>
        {%- if s.cta != blank %}<a class="oralys-pdp-gap__link" href="#oralys-pdp-offer">{{ s.cta }}</a>{% endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.oralys-pdp-gap{background:var(--op-bg);color:var(--op-text);padding:var(--op-pt-m) 16px var(--op-pb-m);font-family:var(--font-body--family);font-size:var(--op-body);line-height:1.55}
.oralys-pdp-gap *{box-sizing:border-box}
@media (min-width:750px){.oralys-pdp-gap{padding:var(--op-pt-d) 32px var(--op-pb-d)}}
.oralys-pdp-gap__inner{max-width:1200px;margin:0 auto}
.oralys-pdp-gap__head{text-align:var(--op-align);margin:0 0 24px}
.oralys-pdp-gap__eyebrow{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--op-accent);margin:0 0 10px}
.oralys-pdp-gap__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--op-h-m);line-height:1.22;margin:0;color:var(--op-text);text-wrap:balance}
.oralys-pdp-gap__h em{font-style:normal;color:var(--op-accent)}
@media (min-width:750px){.oralys-pdp-gap__h{font-size:var(--op-h-d)}}
.oralys-pdp-gap__btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--op-cta);color:var(--op-cta-text);font-weight:700;font-size:18px;text-decoration:none;border:0;width:100%;transition:transform .15s}
.oralys-pdp-gap__btn:hover{transform:translateY(-1px)}
@media (min-width:750px){.oralys-pdp-gap__btn{display:inline-flex;width:auto;min-width:320px}}

.oralys-pdp-gap__grid{display:grid;gap:24px}
@media (min-width:990px){.oralys-pdp-gap__grid{grid-template-columns:1fr 1fr;column-gap:56px;row-gap:28px;align-items:start;grid-template-areas:"media copy" "aside copy"}.oralys-pdp-gap__media{grid-area:media}.oralys-pdp-gap__copy{grid-area:copy}.oralys-pdp-gap__aside{grid-area:aside}.oralys-pdp-gap__grid--flip{grid-template-areas:"copy media" "copy aside"}.oralys-pdp-gap__facts{margin-bottom:0}}
.oralys-pdp-gap__img{border-radius:14px;overflow:hidden;background:#fff;aspect-ratio:3/2}
.oralys-pdp-gap__pic{display:block;width:100%;height:100%;object-fit:cover}
.oralys-pdp-gap__loop{margin-top:12px;border-radius:14px;overflow:hidden;background:#fff;aspect-ratio:4/5;max-width:420px}
.oralys-pdp-gap__lpic{display:block;width:100%;height:100%;object-fit:cover}
.oralys-pdp-gap__small{display:flex;align-items:center;gap:12px;margin-top:12px;font-size:14px;color:var(--op-muted)}
.oralys-pdp-gap__spic{width:88px;height:88px;object-fit:cover;border-radius:12px;flex:0 0 88px;display:block}
.oralys-pdp-gap__story p{margin:0 0 16px}
.oralys-pdp-gap__facts{list-style:none;margin:0 0 24px;padding:0;position:relative}
.oralys-pdp-gap__fact{display:flex;gap:14px;position:relative;padding-bottom:20px}
.oralys-pdp-gap__fact:not(:last-child)::before{content:"";position:absolute;left:17px;top:38px;bottom:4px;width:2px;background:var(--op-line)}
.oralys-pdp-gap__num{flex:0 0 36px;height:36px;border-radius:50%;background:var(--op-accent);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:17px}
.oralys-pdp-gap__ft{margin:4px 0 4px;font-family:var(--font-heading--family);font-size:20px;line-height:1.25;font-weight:700}
.oralys-pdp-gap__fb{margin:0;color:var(--op-text)}
.oralys-pdp-gap__cmp{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
.oralys-pdp-gap__col{border-radius:12px;padding:14px 12px;background:var(--op-card);border:1px solid var(--op-line)}
.oralys-pdp-gap__col--b{border:2px solid var(--op-accent)}
.oralys-pdp-gap__ch{margin:0 0 8px;font-weight:800;font-size:16px}
.oralys-pdp-gap__col--b .oralys-pdp-gap__ch{color:var(--op-accent)}
.oralys-pdp-gap__col ul{list-style:none;margin:0;padding:0;display:grid;gap:8px;font-size:14.5px;line-height:1.35}
.oralys-pdp-gap__col li{display:flex;gap:6px}
.oralys-pdp-gap__x{color:#B8423A;font-weight:800;flex:0 0 auto}
.oralys-pdp-gap__v{color:var(--op-accent);font-weight:800;flex:0 0 auto}
.oralys-pdp-gap__col--a li{color:var(--op-muted)}
.oralys-pdp-gap__link{display:inline-flex;align-items:center;min-height:44px;color:var(--op-accent);font-weight:800;font-size:18px;text-decoration:underline;text-underline-offset:4px}
{% endstylesheet %}

{% javascript %}
(() => {
  // Poster first; the animated loop is fetched only near the viewport and swapped in once it decodes.
  // If the loop file is missing, the poster stays; if the poster is missing too, the box hides.
  const swap = (box) => {
    const src = box.getAttribute('data-op-loop'), img = box.querySelector('img');
    if (!src || !img) return;
    const pre = new Image();
    pre.onload = () => { img.src = src; img.hidden = false; box.hidden = false; };
    pre.onerror = () => { if (img.hidden) box.hidden = true; };
    pre.src = src;
  };
  const init = () => document.querySelectorAll('[data-op-loop]:not([data-op-loop-ready])').forEach((box) => {
    box.setAttribute('data-op-loop-ready', '');
    if (!('IntersectionObserver' in window)) return swap(box);
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.disconnect(); swap(box); } }), { rootMargin: '300px' });
    io.observe(box);
  });
  init();
  document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Oralys : le vide",
  "tag": "section",
  "class": "oralys-pdp-gap-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "POURQUOI ÇA BOUGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce n'est pas votre faute. Ce n'est même pas celle de votre dentier."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Mot du titre en couleur accent",
      "default": "faute",
      "info": "Doit apparaître tel quel dans le titre. Vide = aucun mot en couleur."
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Histoire",
      "default": "<p>Le jour où votre appareil a été fait, il épousait parfaitement votre gencive. Puis, mois après mois, l'os qui la soutient s'est rétracté, sans bruit. Votre dentier, lui, n'a pas changé de forme. Résultat : un vide s'est creusé dessous. Et c'est dans ce vide que tout se joue.</p>"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image avant / après"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Image avant / après : fichier du thème",
      "default": "oralys-pdp-gap-illustration.webp",
      "info": "Utilisé si aucune image n'est choisie (fichier dans assets/)."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image avant / après : texte alternatif",
      "default": "Avant : un vide sous le dentier. Après : le gel Oralys remplit l'espace"
    },
    {
      "type": "image_picker",
      "id": "small_image",
