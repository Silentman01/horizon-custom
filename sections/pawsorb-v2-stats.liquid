{%- assign ss = section.settings -%}
<div
  class="pawsorb-v2-st"
  style="--pawsorb-v2-st-strip: {{ ss.strip_color }}; --pawsorb-v2-st-card: {{ ss.card_color }}; --pawsorb-v2-st-fg: {{ ss.text_color }}; --pawsorb-v2-st-n1: {{ ss.number_from }}; --pawsorb-v2-st-n2: {{ ss.number_to }}; --pawsorb-v2-st-note: {{ ss.note_bg }}; --pawsorb-v2-st-notefg: {{ ss.note_text }}; --pawsorb-v2-st-h: {{ ss.heading_size }}px; --pawsorb-v2-st-hm: {{ ss.heading_size_mobile }}px; --pawsorb-v2-st-hw: {{ ss.heading_weight }}; --pawsorb-v2-st-n: {{ ss.number_size }}px; --pawsorb-v2-st-nm: {{ ss.number_size_mobile }}px; --pawsorb-v2-st-pad: {{ ss.strip_padding }}px;"
>
  <div class="pawsorb-v2-st__card">
    <div class="pawsorb-v2-st__intro">
      {%- if ss.heading != blank -%}<h2 class="pawsorb-v2-st__h">{{ ss.heading }}</h2>{%- endif -%}
      {%- if ss.sub != blank -%}<p class="pawsorb-v2-st__sub">{{ ss.sub }}</p>{%- endif -%}
    </div>
    <div class="pawsorb-v2-st__side">
      {%- if section.blocks.size > 0 -%}
        <ul class="pawsorb-v2-st__rows">
          {%- for block in section.blocks -%}
            <li class="pawsorb-v2-st__row" {{ block.shopify_attributes }}>
              <span class="pawsorb-v2-st__num">{{ block.settings.number }}</span>
              <span class="pawsorb-v2-st__txt"><strong>{{ block.settings.title }}</strong>{%- if block.settings.line != blank -%}<span>{{ block.settings.line }}</span>{%- endif -%}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if ss.disclaimer != blank -%}<p class="pawsorb-v2-st__note"><svg class="pawsorb-v2-st__noteic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 11v6M12 7.5v.5" stroke-linecap="round"/></svg><span>{{ ss.disclaimer }}</span></p>{%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pawsorb-v2-st__noteic { flex: 0 0 16px; margin-top: 2px; opacity: .8; }
  @supports (grid-template-columns: subgrid) {
    .pawsorb-v2-st__rows { display: grid; grid-template-columns: max-content minmax(0, 1fr); }
    .pawsorb-v2-st__row { grid-column: 1 / -1; grid-template-columns: subgrid !important; }
  }
  .pawsorb-v2-st { padding: var(--pawsorb-v2-st-pad, 16px); background: var(--pawsorb-v2-st-strip, #fff); font-family: var(--font-body--family); }
  .pawsorb-v2-st__card { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 40px; padding: 48px 56px; border-radius: 24px; background: var(--pawsorb-v2-st-card, #12855A); color: var(--pawsorb-v2-st-fg, #fff); box-sizing: border-box; }
  .pawsorb-v2-st__intro { text-align: center; }
  .pawsorb-v2-st__h { margin: 0; font-family: var(--font-body--family); font-weight: var(--pawsorb-v2-st-hw, 400); font-size: var(--pawsorb-v2-st-h, 48px); line-height: 1.1; letter-spacing: -.02em; color: inherit; }
  .pawsorb-v2-st__sub { margin: 10px 0 0; font-size: 16px; line-height: 1.5; opacity: .92; }
  .pawsorb-v2-st__rows { list-style: none; margin: 0; padding: 0; }
  .pawsorb-v2-st__row { display: grid; grid-template-columns: minmax(118px, auto) minmax(0, 1fr); align-items: center; gap: 18px; padding: 16px 0; }
  .pawsorb-v2-st__row + .pawsorb-v2-st__row { border-top: 1px solid rgba(255, 255, 255, .6); }
  .pawsorb-v2-st__num { font-size: var(--pawsorb-v2-st-n, 52px); font-weight: 400; line-height: 1; letter-spacing: -.03em; white-space: nowrap; background: linear-gradient(135deg, var(--pawsorb-v2-st-n1, #fff), var(--pawsorb-v2-st-n2, #2BD08F)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pawsorb-v2-st__txt { display: flex; flex-direction: column; gap: 3px; }
  .pawsorb-v2-st__txt strong { font-size: 22px; font-weight: 400; line-height: 1.2; }
  .pawsorb-v2-st__txt span { font-size: 16px; line-height: 1.4; opacity: .92; }
  .pawsorb-v2-st__note { display: flex; gap: 10px; align-items: flex-start; margin: 18px 0 0; padding: 14px 18px; border-radius: 8px; background: var(--pawsorb-v2-st-note, #F1F8F4); color: var(--pawsorb-v2-st-notefg, #7C8580); font-size: 14px; line-height: 1.45; }
  @media screen and (max-width: 749px) {
    .pawsorb-v2-st__card { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 28px 22px; border-radius: 20px; }
    .pawsorb-v2-st__h { font-size: var(--pawsorb-v2-st-hm, 36px); }
    .pawsorb-v2-st__sub { font-size: 14px; }
    .pawsorb-v2-st__row { grid-template-columns: minmax(96px, auto) minmax(0, 1fr); gap: 14px; padding: 14px 0; }
    .pawsorb-v2-st__num { font-size: var(--pawsorb-v2-st-nm, 44px); }
    .pawsorb-v2-st__txt strong { font-size: 18px; }
    .pawsorb-v2-st__txt span { font-size: 13px; }
    .pawsorb-v2-st__note { font-size: 13px; }
    .pawsorb-v2-st { padding: 38px 10px; letter-spacing: -.3px; }
    .pawsorb-v2-st__card { gap: 30px; padding: 30px 15px 20px; }
    .pawsorb-v2-st__h { line-height: 1.1; letter-spacing: -.9px; }
    .pawsorb-v2-st__sub { margin-top: 10px; line-height: 1.4; }
    .pawsorb-v2-st__row { gap: 20px; padding: 15px 0; }
    .pawsorb-v2-st__txt { gap: 5px; }
    .pawsorb-v2-st__txt strong { line-height: 1.2; }
    .pawsorb-v2-st__txt span { line-height: 1.5; }
    .pawsorb-v2-st__note { margin-top: 20px; padding: 16px; font-size: 14px; line-height: 1.4; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb v2 stats card",
  "tag": "section",
  "class": "pawsorb-v2-section-st",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "row",
      "name": "Stat row",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "4.9/5" },
        { "type": "text", "id": "title", "label": "Title", "default": "Average rating" },
        { "type": "text", "id": "line", "label": "Line", "default": "across 4,554 reviews from dog and cat owners" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready before the next scare" },
    { "type": "text", "id": "sub", "label": "Sub", "default": "What owners say once a tube is on hand." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer box", "default": "* Rating from 4,554 PawSorb reviews." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "strip_color", "label": "Strip background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#12855A" },
    { "type": "color", "id": "text_color", "label": "Card text", "default": "#FFFFFF" },
    { "type": "color", "id": "number_from", "label": "Number gradient start", "default": "#FFFFFF" },
    { "type": "color", "id": "number_to", "label": "Number gradient end", "default": "#2BD08F" },
    { "type": "color", "id": "note_bg", "label": "Disclaimer background", "default": "#FDF9E8" },
    { "type": "color", "id": "note_text", "label": "Disclaimer text", "default": "#919191" },
    { "type": "header", "content": "Type and spacing" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 40 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "400", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" } ] },
    { "type": "range", "id": "number_size", "label": "Number size (desktop)", "min": 28, "max": 72, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "number_size_mobile", "label": "Number size (mobile)", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "strip_padding", "label": "Strip padding", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [ { "name": "PawSorb v2 stats card", "blocks": [ { "type": "row" } ] } ]
}
{% endschema %}
