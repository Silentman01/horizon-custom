<section class="au-press" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-press__mask">
    <div class="au-press__track">
      {%- for copy in (1..2) -%}
        <ul class="au-press__list"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="au-press__item" {{ block.shopify_attributes }}>
              {%- if block.settings.logo -%}
                {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.name, height: 20 }}
              {%- else -%}
                <span class="au-press__word{% if block.settings.serif %} is-serif{% endif %}">{{ block.settings.name }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}
  .au-press { padding: 24px 0; background: var(--au-espresso); overflow: hidden; }
  .au-press__mask { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .au-press__track { display: flex; width: max-content; animation: au-press-scroll 36s linear infinite; }
  .au-press__list { display: flex; align-items: center; gap: 40px; margin: 0; padding: 0 20px; list-style: none; }
  .au-press__item { flex: none; display: flex; align-items: center; height: 20px; opacity: 0.75; }
  .au-press__item img { height: 20px; width: auto; }
  .au-press__word { color: #fff; font-family: var(--au-body); font-size: 18px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
  .au-press__word.is-serif { font-family: Georgia, serif; }
  @keyframes au-press-scroll { to { transform: translateX(-50%); } }
  @media (min-width: 750px) { .au-press { padding: 18px 0; } }
  @media (prefers-reduced-motion: reduce) { .au-press__track { animation: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea press marquee",
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Name (used as text if no logo)", "default": "ELLE" },
        { "type": "image_picker", "id": "logo", "label": "White logo image (optional)" },
        { "type": "checkbox", "id": "serif", "label": "Serif text style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea press marquee",
      "blocks": [
        { "type": "logo", "settings": { "name": "ELLE" } },
        { "type": "logo", "settings": { "name": "Forbes", "serif": true } },
        { "type": "logo", "settings": { "name": "Marie Claire" } },
        { "type": "logo", "settings": { "name": "Women's Health" } },
        { "type": "logo", "settings": { "name": "COSMOPOLITAN" } },
        { "type": "logo", "settings": { "name": "VOGUE", "serif": true } }
      ]
    }
  ]
}
{% endschema %}
