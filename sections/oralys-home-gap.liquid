    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#EEF6F1"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_accent",
