{%- render 'pawsorb-home-base' -%}
<section class="pawsorb-h pawsorb-hf" aria-label="{{ section.settings.heading | escape }}">
  <div class="pawsorb-h__wrap pawsorb-hf__wrap">
    <h2 class="pawsorb-h__h2 pawsorb-h__center">{{ section.settings.heading }}</h2>
    <div class="pawsorb-hf__list">
      {%- for block in section.blocks -%}
        <details class="pawsorb-hf__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="pawsorb-hf__q">{{ block.settings.question }}<span class="pawsorb-hf__plus" aria-hidden="true"></span></summary>
          <div class="pawsorb-hf__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pawsorb-hf__wrap{max-width:760px}
.pawsorb-hf__list{margin-top:20px;display:grid;gap:10px}
.pawsorb-hf__item{border:1px solid #DCE6E0;border-radius:12px;background:#fff}
.pawsorb-hf__q{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px;font-weight:700;font-size:16px;line-height:1.35}
.pawsorb-hf__q::-webkit-details-marker{display:none}
.pawsorb-hf__plus{position:relative;flex:0 0 22px;height:22px;border-radius:50%;background:#F1F6F3}
.pawsorb-hf__plus::before,.pawsorb-hf__plus::after{content:"";position:absolute;left:6px;right:6px;top:10px;height:2px;background:#12855A;transition:transform .2s}
.pawsorb-hf__plus::after{transform:rotate(90deg)}
.pawsorb-hf__item[open] .pawsorb-hf__plus::after{transform:rotate(0)}
.pawsorb-hf__a{padding:0 16px 16px;font-size:15px;line-height:1.55;color:#5D6A63}
.pawsorb-hf__a p{margin:0}
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb home FAQ",
  "tag": "div",
  "class": "pawsorb-home-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quick answers" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What if I never use it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>That's the best outcome. It's good for 2 years, and you have 90 days to return it for a full refund.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "PawSorb home FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
