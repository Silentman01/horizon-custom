<section class="au-cmp" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-cmp__head">
    {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {% render 'aurea-title', text: section.settings.heading, class: 'au-cmp__h' %}
  </div>
  <div class="au-cmp__table" role="table">
    <div class="au-cmp__row au-cmp__row--head" role="row">
      <span role="columnheader"></span>
      <span class="au-cmp__col is-brand" role="columnheader">{{ section.settings.col_brand }}</span>
      <span class="au-cmp__col" role="columnheader">{{ section.settings.col_others }}</span>
    </div>
    {%- for block in section.blocks -%}
      <div class="au-cmp__row" role="row" {{ block.shopify_attributes }}>
        <span class="au-cmp__label" role="cell">{{ block.settings.label }}</span>
        <span class="au-cmp__col is-brand" role="cell"><i class="au-cmp__yes" aria-label="Yes">✓</i></span>
        <span class="au-cmp__col" role="cell"><i class="au-cmp__no" aria-label="No">✕</i></span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
  .au-cmp { max-width: 760px; margin: 0 auto; padding: 20px 16px; background: var(--au-bg); }
  .au-cmp__head { margin-bottom: 18px; text-align: center; }
  .au-cmp__h { font-size: clamp(26px, 4vw, 36px); }
  .au-cmp__table { border: 0.5px solid rgb(0 0 0 / 0.25); border-radius: 6px; overflow: hidden; }
  .au-cmp__row { display: grid; grid-template-columns: 1fr 64px 64px; align-items: center; padding: 0; }
  .au-cmp__row + .au-cmp__row { border-top: 0.5px solid rgb(0 0 0 / 0.15); }
  .au-cmp__row > * { padding: 14px 10px; }
  .au-cmp__row > :first-child { padding-left: 14px; }
  .au-cmp__row--head { font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .au-cmp__label { font-size: 15px; font-weight: 500; }
  .au-cmp__col { text-align: center; align-self: stretch; display: grid; place-items: center; }
  .au-cmp__col.is-brand { background: rgb(from var(--au-gold) r g b / 0.1); }
  .au-cmp__yes, .au-cmp__no { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; font-size: 12px; font-style: normal; font-weight: 700; line-height: 1; }
  .au-cmp__yes { background: var(--au-pine); color: #fff; }
  .au-cmp__no { color: rgb(0 0 0 / 0.35); font-size: 15px; }
  @media (min-width: 750px) {
    .au-cmp__row { grid-template-columns: 1fr 96px 96px; }
    .au-cmp__row > * { padding: 14px 18px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The difference" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "Why *Aurea*" },
    { "type": "text", "id": "col_brand", "label": "Brand column", "default": "Aurea" },
    { "type": "text", "id": "col_others", "label": "Others column", "default": "Others" }
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Genuine crystals & stones" } ] } ],
  "presets": [
    {
      "name": "Aurea comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Genuine crystals & stones" } },
        { "type": "row", "settings": { "label": "Cleansed & moon-charged" } },
        { "type": "row", "settings": { "label": "Adjustable, one-size fit" } },
        { "type": "row", "settings": { "label": "30-day money-back guarantee" } }
      ]
    }
  ]
}
{% endschema %}
