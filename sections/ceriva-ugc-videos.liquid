<div
  class="cv cv--{{ section.settings.tone }} cv-ugc"
  style="{% render 'ceriva-tokens' %} --cv-pt: {{ section.settings.padding_top }}px; --cv-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="cv__inner">
    <div class="cv__head cv-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cv__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="cv__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="cv__sub">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div
      class="cv-ugc__rail"
      tabindex="0"
      aria-label="{{ section.settings.title | strip_html | escape }}"
    >
      {%- for block in section.blocks -%}
        <figure
          class="cv-ugc__card"
          {{ block.shopify_attributes }}
        >
          {% render 'ceriva-media',
            video: block.settings.video,
            video_url: block.settings.video_url,
            image: block.settings.poster,
            ratio: '9 / 16',
            label: block.settings.placeholder_label,
            dims: 'Vidéo 1080 × 1920',
            sizes: '(min-width: 990px) 220px, 60vw'
          %}
          {%- if block.settings.video != blank or block.settings.video_url != blank -%}
            <button
              type="button"
              class="cv-ugc__sound"
              data-cv-sound
              aria-pressed="false"
              aria-label="Activer ou couper le son"
            >
              <svg
                class="cv-ugc__icon-muted"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="m22 9-6 6M16 9l6 6"/>
              </svg>
              <svg
                class="cv-ugc__icon-sound"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/>
              </svg>
            </button>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="cv-ugc__caption">{{ block.settings.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.swipe_hint != blank -%}
      <p
        class="cv-ugc__hint"
        aria-hidden="true"
      >
        {{ section.settings.swipe_hint }}
      </p>
    {%- endif -%}

    {%- if section.settings.proof_title != blank -%}
      <div class="cv-ugc__proof cv-reveal">
        {% render 'ceriva-stars', size: '20' %}
        <p class="cv-ugc__proof-line">{{ section.settings.proof_line }}</p>
        <p class="cv-ugc__proof-title">{{ section.settings.proof_title }}</p>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="cv__cta cv-reveal">
        {% render 'ceriva-cta',
          label: section.settings.button_label,
          action: section.settings.button_action,
          url: section.settings.button_link,
          style: section.settings.button_style
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{% render 'ceriva-script' %}

{% stylesheet %}
  .cv-ugc__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: 12px;
    margin-inline: calc(var(--cv-gutter) * -1);
    padding-inline: var(--cv-gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--cv-gutter);
    scrollbar-width: none;
  }

  .cv-ugc__rail::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .cv-ugc__rail {
      grid-auto-columns: calc((100% - 48px) / 5);
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .cv-ugc__card {
    position: relative;
    margin: 0;
    scroll-snap-align: start;
  }

  .cv-ugc__sound {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--cv-navy-rgb) / 0.72);
    color: var(--cv-white);
    cursor: pointer;
  }

  .cv-ugc__sound:focus-visible {
    outline: 2px solid var(--cv-white);
    outline-offset: 2px;
  }

  .cv-ugc__sound svg {
    width: 18px;
    height: 18px;
  }

  .cv-ugc__icon-sound,
  .cv-ugc__card.is-unmuted .cv-ugc__icon-muted {
    display: none;
  }

  .cv-ugc__card.is-unmuted .cv-ugc__icon-sound {
    display: block;
  }

  .cv-ugc__card.is-unmuted .cv-media {
    box-shadow: 0 0 0 3px var(--cv-blue), 0 10px 24px rgb(var(--cv-navy-rgb) / 0.12);
  }

  .cv-ugc__card .cv-media {
    box-shadow: 0 10px 24px rgb(var(--cv-navy-rgb) / 0.12);
  }

  .cv-ugc__caption {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .cv-ugc__hint {
    margin: 14px 0 0;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    color: var(--cv-blue);
  }

  @media screen and (min-width: 750px) {
    .cv-ugc__hint {
      display: none;
    }
  }

  .cv-ugc__proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 36px;
    text-align: center;
  }

  .cv-ugc__proof-line {
    margin: 0;
    font-size: 14px;
  }

  .cv-ugc__proof-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ceriva — Vidéos clients",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Fond",
      "options": [
        { "value": "ice", "label": "Blanc glacé" },
        { "value": "white", "label": "Blanc" },
        { "value": "navy", "label": "Bleu nuit" }
      ],
      "default": "ice"
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "De vrais gens · De vrais résultats" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Regardez ce qui sort" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un quart de tour, et le résultat est là, sur l'embout.</p>" },
    { "type": "text", "id": "swipe_hint", "label": "Indication mobile", "default": "Glissez pour voir la suite →" },
    { "type": "header", "content": "Preuve sociale" },
    { "type": "text", "id": "proof_line", "label": "Ligne de note", "default": "Noté 4,8/5 par nos clients" },
    { "type": "text", "id": "proof_title", "label": "Titre de preuve", "default": "Ils ont rangé leurs cotons-tiges" },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton" },
    {
      "type": "select",
      "id": "button_action",
      "label": "Action du bouton",
      "options": [
        { "value": "offer", "label": "Remonter au choix de l'offre" },
        { "value": "cart", "label": "Ajouter l'offre choisie au panier" },
        { "value": "url", "label": "Lien personnalisé" }
      ],
      "default": "offer"
    },
    { "type": "url", "id": "button_link", "label": "Lien", "visible_if": "{{ section.settings.button_action == 'url' }}" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "primary", "label": "Plein" },
        { "value": "outline", "label": "Contour" }
      ],
      "default": "primary"
    },
    { "type": "header", "content": "Espacement" },
    { "type": "range", "id": "padding_top", "label": "Haut", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bas", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vidéo",
      "settings": [
        { "type": "video", "id": "video", "label": "Vidéo (format vertical 9:16)" },
        { "type": "url", "id": "video_url", "label": "Ou lien direct MP4", "info": "Utilisé si aucune vidéo n'est choisie." },
        { "type": "image_picker", "id": "poster", "label": "Image (si pas de vidéo)" },
        { "type": "text", "id": "caption", "label": "Légende" },
        { "type": "text", "id": "placeholder_label", "label": "Description de l'emplacement", "default": "UGC : gros plan sur l'embout après usage" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ceriva — Vidéos clients",
      "blocks": [
        { "type": "video", "settings": { "placeholder_label": "UGC : retrait du stick, gros plan sur l'embout" } },
        { "type": "video", "settings": { "placeholder_label": "UGC : réaction « je n'y croyais pas »" } },
        { "type": "video", "settings": { "placeholder_label": "UGC : rinçage du stick sous l'eau" } },
        { "type": "video", "settings": { "placeholder_label": "UGC : utilisatrice avec écouteurs" } },
        { "type": "video", "settings": { "placeholder_label": "UGC : ouverture de la boîte Ceriva" } }
      ]
    }
  ]
}
{% endschema %}
