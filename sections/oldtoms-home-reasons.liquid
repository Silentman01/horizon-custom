{%- assign s = section.settings -%}
<section class="ot-home-reasons" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <h2 class="ot-home-reasons__heading">
    <span>{{ s.heading }}</span>
    <span class="ot-home-reasons__tag">{{ s.brand_tag }}</span>
  </h2>
  <ol class="ot-home-reasons__list">
    {%- for block in section.blocks -%}
      <li class="ot-home-reasons__item" {{ block.shopify_attributes }}>
        <span class="ot-home-reasons__num">{{ forloop.index }}</span>
        <h3 class="ot-home-reasons__title">{{ block.settings.title }}</h3>
        <p class="ot-home-reasons__text">{{ block.settings.text }}</p>
      </li>
    {%- endfor -%}
  </ol>
</section>

{% stylesheet %}
.ot-home-reasons { background: var(--ot-bg); padding: var(--ot-pt) 0 var(--ot-pb); font-family: var(--ot-font); color: var(--ot-green); }
.ot-home-reasons__heading { margin: 0 0 28px; padding-inline: 16px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 14px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 28px; line-height: 1.2; }
.ot-home-reasons__tag { display: inline-block; background: var(--ot-lime); border: 2px solid var(--ot-green); border-radius: 10px; box-shadow: 0 3px 0 var(--ot-green); padding: 2px 16px; transform: rotate(-2deg); font-weight: 700; font-size: 32px; }
.ot-home-reasons__list { list-style: none; margin: 0 auto; padding: 0 20px; display: grid; grid-template-columns: 1fr; gap: 24px; max-width: 1384px; }
.ot-home-reasons__item { display: grid; grid-template-columns: 34px 1fr; column-gap: 14px; row-gap: 4px; align-items: start; }
.ot-home-reasons__num { grid-row: 1 / span 2; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #5D824E; border: 2px solid var(--ot-green); color: #fff; font-weight: 700; font-size: 16px; }
.ot-home-reasons__title { margin: 0; font-family: var(--ot-font); font-weight: 600; font-size: 15px; line-height: 1.3; color: #242424; }
.ot-home-reasons__text { margin: 0; font-size: 12.5px; line-height: 1.5; letter-spacing: 0.02em; }
@media screen and (min-width: 990px) {
  .ot-home-reasons__heading { font-size: 36px; }
  .ot-home-reasons__tag { font-size: 40px; }
  .ot-home-reasons__list { grid-template-columns: repeat(5, 1fr); gap: 24px; padding-inline: 28px; }
  .ot-home-reasons__item { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .ot-home-reasons__num { grid-row: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's reasons grid",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "5 Reasons Why Homeowners Trust" },
    { "type": "text", "id": "brand_tag", "label": "Highlighted brand", "default": "OLD TOM'S" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5FAE8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Proven to Work" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "92% of users see a visible drop in pest activity within the first 48 hours." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Old Tom's reasons grid",
      "blocks": [
        { "type": "reason", "settings": { "title": "Proven to Work", "text": "92% of users see a visible drop in pest activity within the first 48 hours." } },
        { "type": "reason", "settings": { "title": "Plant-Based Power", "text": "Made with 100% botanical actives like Peppermint and Lemongrass oil." } },
        { "type": "reason", "settings": { "title": "Long-Lasting Shield", "text": "Our extended-release formula gives non-stop protection for your home for up to 60 days." } },
        { "type": "reason", "settings": { "title": "Family & Pet Safe", "text": "Non-toxic and DEET-free, so it's safe to use around your children and pets when used as directed." } },
        { "type": "reason", "settings": { "title": "Less than 1% Return Rate", "text": "Our customers love the results — fewer than 1% of orders are ever returned." } }
      ]
    }
  ]
}
{% endschema %}
