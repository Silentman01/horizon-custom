{%- liquid
  assign s = section.settings
  assign h = s.heading
  if s.accent != blank
    assign acc = '<em>' | append: s.accent | append: '</em>'
    assign h = h | replace: s.accent, acc
  endif
-%}
<div class="oralys-pdp-cost" style="--op-bg:{{ s.c_bg }};--op-text:{{ s.c_text }};--op-accent:{{ s.c_accent }};--op-muted:{{ s.c_muted }};--op-card:{{ s.c_card }};--op-line:{{ s.c_line }};--op-cta:{{ s.c_cta }};--op-cta-text:{{ s.c_cta_text }};--op-h-m:{{ s.h_m }}px;--op-h-d:{{ s.h_d }}px;--op-body:{{ s.body_size }}px;--op-align:{{ s.align }};--op-pt-m:{{ s.pt_m }}px;--op-pb-m:{{ s.pb_m }}px;--op-pt-d:{{ s.pt_d }}px;--op-pb-d:{{ s.pb_d }}px">
  <div class="oralys-pdp-cost__inner">
    <div class="oralys-pdp-cost__head">{% if s.eyebrow != blank %}<p class="oralys-pdp-cost__eyebrow">{{ s.eyebrow }}</p>{% endif %}{% if h != blank %}<h2 class="oralys-pdp-cost__h">{{ h }}</h2>{% endif %}</div>
    <div class="oralys-pdp-cost__grid">
      <div>
        {%- if s.intro != blank %}<div class="oralys-pdp-cost__intro">{{ s.intro }}</div>{% endif -%}
        <ul class="oralys-pdp-cost__bars" role="list" style="--opc-bar:{{ s.c_bar }};--opc-hi:{{ s.c_bar_hi }}">
          {%- for block in section.blocks -%}
          <li class="oralys-pdp-cost__row{% if block.settings.highlight %} is-hi{% endif %}" {{ block.shopify_attributes }}>
            <div class="oralys-pdp-cost__lab"><span>{{ block.settings.label }}</span>{% if block.settings.highlight and s.image != blank or block.settings.highlight and s.asset != blank %}<span class="oralys-pdp-cost__tube">{% render 'oralys-pdp-media', image: s.image, asset: s.asset, alt: s.alt, class: 'oralys-pdp-cost__tubeimg', loading: 'lazy', width: 80, height: 80 %}</span>{% endif %}</div>
            <div class="oralys-pdp-cost__track"><span class="oralys-pdp-cost__fill" style="width:{{ block.settings.width }}%"></span></div>
            <p class="oralys-pdp-cost__val">{{ block.settings.value }}</p>
          </li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="oralys-pdp-cost__side">
        <div class="oralys-pdp-cost__call"><p class="oralys-pdp-cost__ct">{{ s.c_title }}</p><div class="oralys-pdp-cost__cb">{{ s.c_body }}</div></div>
        {%- if s.week != blank %}<p class="oralys-pdp-cost__week">{% render 'oralys-pdp-icon', name: 'check', size: 22 %}<span>{{ s.week }}</span></p>{% endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.oralys-pdp-cost{background:var(--op-bg);color:var(--op-text);padding:var(--op-pt-m) 16px var(--op-pb-m);font-family:var(--font-body--family);font-size:var(--op-body);line-height:1.55}
.oralys-pdp-cost *{box-sizing:border-box}
@media (min-width:750px){.oralys-pdp-cost{padding:var(--op-pt-d) 32px var(--op-pb-d)}}
.oralys-pdp-cost__inner{max-width:1200px;margin:0 auto}
.oralys-pdp-cost__head{text-align:var(--op-align);margin:0 0 24px}
.oralys-pdp-cost__eyebrow{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--op-accent);margin:0 0 10px}
.oralys-pdp-cost__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--op-h-m);line-height:1.22;margin:0;color:var(--op-text);text-wrap:balance}
.oralys-pdp-cost__h em{font-style:normal;color:var(--op-accent)}
@media (min-width:750px){.oralys-pdp-cost__h{font-size:var(--op-h-d)}}
.oralys-pdp-cost__btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--op-cta);color:var(--op-cta-text);font-weight:700;font-size:18px;text-decoration:none;border:0;width:100%;transition:transform .15s}
.oralys-pdp-cost__btn:hover{transform:translateY(-1px)}
@media (min-width:750px){.oralys-pdp-cost__btn{display:inline-flex;width:auto;min-width:320px}}

.oralys-pdp-cost__grid{display:grid;gap:24px}
@media (min-width:990px){.oralys-pdp-cost__grid{grid-template-columns:3fr 2fr;gap:48px;align-items:center}}
.oralys-pdp-cost__intro p{margin:0 0 20px}
.oralys-pdp-cost__bars{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.oralys-pdp-cost__row{display:grid;gap:6px}
.oralys-pdp-cost__lab{display:flex;justify-content:space-between;align-items:center;gap:8px;font-weight:700;font-size:15.5px;line-height:1.3}
.oralys-pdp-cost__tube{flex:0 0 40px;width:40px;height:40px;border-radius:50%;overflow:hidden;background:#EEF6F1}
.oralys-pdp-cost__tubeimg{width:100%;height:100%;object-fit:contain;display:block}
.oralys-pdp-cost__track{height:14px;border-radius:14px;background:#F1F4F2;overflow:hidden}
.oralys-pdp-cost__fill{display:block;height:100%;border-radius:14px;background:var(--opc-bar)}
.oralys-pdp-cost__row.is-hi .oralys-pdp-cost__fill{background:var(--opc-hi)}
.oralys-pdp-cost__row.is-hi .oralys-pdp-cost__lab{color:var(--opc-hi)}
.oralys-pdp-cost__val{margin:0;font-size:14.5px;color:var(--op-muted)}
.oralys-pdp-cost__row.is-hi .oralys-pdp-cost__val{color:var(--op-text);font-weight:700}
.oralys-pdp-cost__call{border-radius:12px;background:#EEF6F1;padding:20px;border-left:4px solid var(--op-accent)}
.oralys-pdp-cost__ct{margin:0 0 8px;font-family:var(--font-heading--family);font-weight:700;font-size:20px;line-height:1.25}
.oralys-pdp-cost__cb p{margin:0}
.oralys-pdp-cost__week{display:flex;gap:10px;align-items:center;margin:16px 0 0;padding:14px 16px;border-radius:12px;border:1.5px dashed var(--op-accent);font-weight:700;color:var(--op-text)}
.oralys-pdp-cost__week svg{color:var(--op-accent);flex:0 0 auto}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : coût comparé",
  "tag": "section",
  "class": "oralys-pdp-cost-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Un dentier qui tient coûte souvent moins cher que la colle"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Mot du titre en couleur accent",
      "default": "moins",
      "info": "Doit apparaître tel quel dans le titre. Vide = aucun mot en couleur."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Vous l'avez peut-être déjà calculé : un tube de crème tous les 10 jours, ça finit par chiffrer. Comparez sur une année.</p>"
    },
    {
      "type": "header",
      "content": "Encadré 100 % Santé"
    },
    {
      "type": "text",
      "id": "c_title",
      "label": "Titre",
      "default": "Remboursé par le 100 % Santé… mais il bouge ?"
    },
    {
      "type": "richtext",
      "id": "c_body",
      "label": "Texte",
      "default": "<p>Votre appareil est pris en charge, tant mieux. Mais la Sécurité sociale ne rembourse ni la colle ni le temps passé à la remettre. Oralys redonne de la tenue au dentier que vous avez déjà, sans rendez-vous et sans reste à charge surprise.</p>"
    },
    {
      "type": "text",
      "id": "week",
      "label": "Ligne coût par semaine",
      "default": "Avec le pack 2 + 2, Oralys revient à environ 3 € la semaine. La crème, environ 7 €."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Icône tube"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Icône tube : fichier du thème",
      "default": "oralys-pdp-packshot.webp",
      "info": "Utilisé si aucune image n'est choisie (fichier dans assets/)."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Icône tube : texte alternatif",
      "default": "Tube Oralys Gel"
    },
    {
      "type": "color",
      "id": "c_bar",
      "label": "Barres",
      "default": "#C9D3CE"
    },
    {
      "type": "color",
      "id": "c_bar_hi",
      "label": "Barre Oralys",
      "default": "#0E6B50"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_accent",
      "label": "Accent (mot du titre, icônes)",
      "default": "#0E6B50"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Texte secondaire",
      "default": "#5C6863"
    },
    {
      "type": "color",
      "id": "c_card",
      "label": "Fond des cartes",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_line",
      "label": "Bordures",
      "default": "#DCE5E0"
    },
    {
      "type": "color",
      "id": "c_cta",
      "label": "Bouton : fond",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_cta_text",
      "label": "Bouton : texte",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typo et espacements"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Titre : taille mobile",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Titre : taille ordinateur",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Texte : taille",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement des titres",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Marge haute mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Marge basse mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Marge haute ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Marge basse ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "bar",
      "name": "Barre de coût",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libellé"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Montant"
        },
        {
          "type": "range",
          "id": "width",
          "label": "Longueur de la barre",
          "min": 5,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Mettre en avant (Oralys)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oralys : coût comparé",
      "blocks": [
        {
          "type": "bar",
          "settings": {
            "label": "Crème adhésive, environ 7 € la semaine",
            "value": "plus de 350 € par an",
            "width": 46,
            "highlight": false
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "Rebasage chez le dentiste",
            "value": "souvent 150 à 300 € par séance",
            "width": 58,
            "highlight": false
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "Nouveau dentier hors 100 % Santé",
            "value": "plus de 1 000 €",
            "width": 80,
            "highlight": false
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "Implants",
            "value": "plusieurs milliers d'euros",
            "width": 100,
            "highlight": false
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "Oralys en pack 2 + 2, environ 3 € la semaine",
            "value": "environ 155 € par an",
            "width": 20,
            "highlight": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
