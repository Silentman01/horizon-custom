{%- render 'oralys-v2-base' -%}
{%- assign s = section.settings -%}
{%- capture yes -%}<svg viewBox="0 0 24 24" width="22" height="22" aria-label="Oui" role="img"><circle cx="12" cy="12" r="11" fill="#0E6B50"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture no -%}<svg viewBox="0 0 24 24" width="22" height="22" aria-label="Non" role="img"><circle cx="12" cy="12" r="11" fill="#D2382C"/><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>{%- endcapture -%}
<section class="ov2 ov2-sec ov2-cmp" style="--ov2-bg:{{ s.c_bg }}">
  <div class="ov2-in ov2-cmp__in">
    <h2 class="ov2-h2 ov2-center">{{ s.heading }}</h2>
    <div class="ov2-cmp__table" role="table" aria-label="{{ s.heading | escape }}">
      <div class="ov2-cmp__row ov2-cmp__row--head" role="row">
        <span role="columnheader" class="ov2-cmp__lab"></span>
        <span role="columnheader" class="ov2-cmp__c ov2-cmp__us"><span class="ov2-cmp__tube">{% render 'oralys-pdp-media', image: s.image, asset: s.asset, alt: '', class: 'ov2-cmp__img', width: 120, height: 120 %}</span>{{ s.col_1 }}</span>
        <span role="columnheader" class="ov2-cmp__c">{{ s.col_2 }}</span>
        <span role="columnheader" class="ov2-cmp__c">{{ s.col_3 }}</span>
      </div>
      {%- assign rows = s.rows | newline_to_br | split: '<br />' -%}
      {%- for r in rows -%}
        {%- assign p = r | split: '|' -%}
        {%- assign lab = p[0] | strip -%}
        {%- if lab == blank %}{% continue %}{% endif -%}
        <div class="ov2-cmp__row" role="row">
          <span role="rowheader" class="ov2-cmp__lab">{{ lab }}</span>
          {%- for c in (1..3) -%}
            {%- assign v = p[c] | strip -%}
            <span role="cell" class="ov2-cmp__c{% if c == 1 %} ov2-cmp__us{% endif %}">{% if v == 'oui' %}{{ yes }}{% elsif v == 'non' %}{{ no }}{% else %}<span class="ov2-cmp__txt">{{ v }}</span>{% endif %}</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ov2-cmp__in{max-width:820px}
.ov2-cmp__table{position:relative;display:flex;flex-direction:column}
.ov2-cmp__row{display:grid;grid-template-columns:44% 1fr 1fr 1fr;align-items:center;min-height:52px;border-bottom:1px solid #DCE5E0}
.ov2-cmp__row:last-child{border-bottom:0}
.ov2-cmp__row--head{border-bottom:0;align-items:end}
.ov2-cmp__lab{padding:8px 8px 8px 0;font-size:15px;font-weight:600;line-height:1.3}
.ov2-cmp__c{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;align-self:stretch;padding:8px 2px;text-align:center;font-size:15px;font-weight:700;line-height:1.25}
.ov2-cmp__row--head .ov2-cmp__c{padding-bottom:10px;font-size:15px}
.ov2-cmp__us{background:#fff;border-left:2px solid #0E6B50;border-right:2px solid #0E6B50}
.ov2-cmp__row--head .ov2-cmp__us{border-top:2px solid #0E6B50;border-radius:12px 12px 0 0;color:#0E6B50}
.ov2-cmp__row:last-child .ov2-cmp__us{border-bottom:2px solid #0E6B50;border-radius:0 0 12px 12px}
.ov2-cmp__tube{width:44px;height:44px;display:block}
.ov2-cmp__img{width:100%;height:100%;object-fit:contain;display:block}
.ov2-cmp__txt{font-size:16px;font-weight:700;line-height:1.25}
@media (min-width:750px){.ov2-cmp__lab{font-size:17px}.ov2-cmp__txt{font-size:16px}.ov2-cmp__row{min-height:58px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : comparatif",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Oralys, la crème ou le rebasage ?" },
    { "type": "image_picker", "id": "image", "label": "Image colonne Oralys" },
    { "type": "text", "id": "asset", "label": "Image : fichier du thème", "default": "oralys-pdp-packshot-tube.webp" },
    { "type": "text", "id": "col_1", "label": "Colonne 1", "default": "Oralys" },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Crème" },
    { "type": "text", "id": "col_3", "label": "Colonne 3", "default": "Rebasage" },
    { "type": "textarea", "id": "rows", "label": "Lignes", "info": "Une ligne : libellé | colonne 1 | colonne 2 | colonne 3. « oui » = coche verte, « non » = croix rouge, sinon le texte s'affiche.", "default": "Comble le vide | oui | non | oui\nTient 2 à 3 jours | oui | non | oui\nTient le dentier du bas | oui | non | oui\nSe retire d'un bloc | oui | non | non\nZéro zinc | oui | non | oui\nChez vous, en 3 minutes | oui | oui | non\nPrix | dès 14,95 € le tube | à racheter sans fin | 280 à 400 €" },
    { "type": "color", "id": "c_bg", "label": "Fond", "default": "#EEF6F1" }
  ],
  "presets": [{ "name": "Oralys v2 : comparatif" }]
}
{% endschema %}
