{%- render 'oralys-v2-base' -%}
{%- assign s = section.settings -%}
<section class="ov2 ov2-sec ov2-faq" style="--ov2-bg:{{ s.c_bg }}">
  <div class="ov2-in ov2-faq__in">
    <h2 class="ov2-h2 ov2-center">{{ s.heading }}</h2>
    <div class="ov2-faq__list">
      {%- assign items = s.items | split: '##' -%}
      {%- for it in items -%}
        {%- assign lines = it | strip | newline_to_br | split: '<br />' -%}
        {%- assign q = lines[0] | strip -%}
        {%- if q == blank %}{% continue %}{% endif -%}
        <details class="ov2-faq__item">
          <summary><span>{{ q }}</span><span class="ov2-faq__pm" aria-hidden="true"></span></summary>
          <div class="ov2-faq__a">{%- for l in lines offset: 1 -%}{%- assign t = l | strip -%}{%- if t != blank %}<p>{{ t }}</p>{% endif -%}{%- endfor -%}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ov2-faq__in{max-width:820px}
.ov2-faq__list{display:flex;flex-direction:column;gap:10px}
.ov2-faq__item{border:1px solid #DCE5E0;border-radius:12px;background:#fff}
.ov2-faq__item summary{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:60px;padding:14px 16px;font-size:17px;font-weight:700;line-height:1.35;cursor:pointer;list-style:none}
.ov2-faq__item summary::-webkit-details-marker{display:none}
.ov2-faq__item summary::marker{content:""}
.ov2-faq__pm{position:relative;flex:0 0 28px;width:28px;height:28px;border-radius:50%;background:#0E6B50}
.ov2-faq__pm::before,.ov2-faq__pm::after{content:"";position:absolute;left:8px;top:12.75px;width:12px;height:2.5px;border-radius:2px;background:#fff;transition:transform .2s}
.ov2-faq__pm::after{transform:rotate(90deg)}
.ov2-faq__item[open] .ov2-faq__pm::after{transform:rotate(0)}
.ov2-faq__a{padding:0 16px 16px;font-size:16px;line-height:1.55}
.ov2-faq__a p+p{margin-top:8px}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vos questions" },
    { "type": "textarea", "id": "items", "label": "Questions", "info": "Chaque question commence par ## ; la réponse suit sur la ligne suivante.", "default": "## Est-ce un abonnement ?\nNon, jamais. Vous payez une seule fois, le prix affiché. Rien n'est prélevé ensuite. Vous recommandez seulement si vous le souhaitez." },
    { "type": "color", "id": "c_bg", "label": "Fond", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Oralys v2 : FAQ" }]
}
{% endschema %}
