{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-ch" style="--pawsorb-ch-pt: {{ ss.padding_top }}px; --pawsorb-ch-pb: {{ ss.padding_bottom }}px; --pawsorb-ch-bg: {{ ss.bg_color }}; --pawsorb-ch-fg: {{ ss.text_color }}; --pawsorb-ch-accent: {{ ss.accent_color }};">
  {%- if ss.bg_image != blank or ss.bg_asset != blank -%}
    <div class="pawsorb-ch__bg" aria-hidden="true">
      {%- if ss.bg_image != blank -%}
        {{ ss.bg_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '', class: 'pawsorb-ch__bgimg' }}
      {%- else -%}
        <img class="pawsorb-ch__bgimg" src="{{ ss.bg_asset | asset_url }}" alt="" loading="lazy" width="1600" height="900" onerror="this.remove()">
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="pawsorb-ch__inner">
    {%- if ss.heading != blank -%}<h2 class="pawsorb-ch__h">{{ ss.heading }}</h2>{%- endif -%}
    <div class="pawsorb-ch__tiles" data-pawsorb-rail>
      {%- for block in section.blocks -%}
        <div class="pawsorb-ch__tile" {{ block.shopify_attributes }}>
          <span class="pawsorb-ch__icon">{% render 'pawsorb-icon', name: block.settings.icon, size: 22 %}</span>
          <h3 class="pawsorb-ch__t">{{ block.settings.heading }}</h3>
          <p class="pawsorb-ch__b">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if ss.close_line != blank -%}<p class="pawsorb-ch__close">{{ ss.close_line }}</p>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-ch { position: relative; overflow: hidden; padding: var(--pawsorb-ch-pt, 64px) 0 var(--pawsorb-ch-pb, 64px); background: var(--pawsorb-ch-bg, #121614); color: var(--pawsorb-ch-fg, #fff); }
  .pawsorb-ch__bg { position: absolute; inset: 0; opacity: .18; }
  .pawsorb-ch__bgimg { width: 100%; height: 100%; object-fit: cover; }
  .pawsorb-ch__inner { position: relative; max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-ch__h { margin: 0 auto 28px; max-width: 760px; text-align: center; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-ch__tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pawsorb-ch__tile { padding: 22px; border-radius: 12px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .14); }
  .pawsorb-ch__icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--pawsorb-ch-accent, #12855A); color: #fff; margin-bottom: 14px; }
  .pawsorb-ch__t { margin: 0 0 6px; font: 700 18px/1.25 var(--font-heading--family); color: inherit; }
  .pawsorb-ch__b { margin: 0; font-size: 15px; line-height: 1.5; opacity: .85; }
  .pawsorb-ch__close { margin: 28px 0 0; text-align: center; font: 700 18px/1.4 var(--font-heading--family); }
  @media screen and (max-width: 749px) {
    .pawsorb-ch { padding: calc(var(--pawsorb-ch-pt, 64px) * .75) 0 calc(var(--pawsorb-ch-pb, 64px) * .75); }
    .pawsorb-ch__h { font-size: 26px; margin-bottom: 20px; }
    .pawsorb-ch__tiles { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; gap: 12px; margin: 0 -16px; padding: 0 16px; cursor: grab; overscroll-behavior-x: contain; }
    .pawsorb-ch__tiles::-webkit-scrollbar { display: none; }
    .pawsorb-ch__tiles.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
    .pawsorb-ch__tile { flex: 0 0 78%; scroll-snap-align: start; padding: 18px; }
    .pawsorb-ch__close { font-size: 17px; margin-top: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb moments band",
  "tag": "section",
  "class": "pawsorb-section",
  "blocks": [
    {
      "type": "tile",
      "name": "Moment",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "clock", "options": [
          { "value": "clock", "label": "Clock" }, { "value": "phone", "label": "Phone" }, { "value": "car", "label": "Car" },
          { "value": "vet", "label": "Vet" }, { "value": "shield", "label": "Shield" }, { "value": "paw", "label": "Paw" }, { "value": "home", "label": "Home" } ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sunday, 11 p.m." },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Your vet's voicemail. The ER is 40 minutes out." }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "It never happens at 2 p.m. on a Tuesday." },
    { "type": "text", "id": "close_line", "label": "Closing line", "default": "Give the first help yourself. Then make the call." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "text", "id": "bg_asset", "label": "Background theme file (optional)", "info": "File in assets/, shown at low opacity. Hidden if the file is missing." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#121614" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Icon circle", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb moments band",
      "blocks": [
        { "type": "tile", "settings": { "icon": "clock", "heading": "Sunday, 11 p.m.", "body": "Your vet's voicemail. The ER is 40 minutes out." } },
        { "type": "tile", "settings": { "icon": "phone", "heading": "On hold, paying by the minute", "body": "$95 for a call while your dog keeps throwing up." } },
        { "type": "tile", "settings": { "icon": "paw", "heading": "1,200+ calls a day", "body": "That's how often a pet swallows poison in the US. Almost nobody has a plan." } }
      ]
    }
  ]
}
{% endschema %}
