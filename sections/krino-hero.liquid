{%- comment -%}
  Krino home hero: full-bleed photo with a dark overlay, content left inside the page width:
  stars + proof line, headline, subline, button to the product, trust items (blocks). Prefix krino-hero.
  Link: button link, else the product found by handle, else all products.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign kh_link = ss.button_link
  if kh_link == blank
    assign kh_product = all_products[ss.product_handle]
    if kh_product != blank and kh_product.url != blank
      assign kh_link = kh_product.url
    else
      assign kh_link = routes.all_products_collection_url
    endif
  endif
  assign kh_mobile_image = ss.image_mobile | default: ss.image
-%}
<div
  class="krino-hero krino-hero--{{ ss.alignment }}"
  style="--krino-hero-h: {{ ss.height }}vh; --krino-hero-h-m: {{ ss.height_mobile }}vh; --krino-hero-fill: {{ ss.fallback_color }}; --krino-hero-overlay: {{ ss.overlay_color }}; --krino-hero-opacity: {{ ss.overlay_opacity | divided_by: 100.0 }}; --krino-hero-pos: {{ ss.image_position }}; --krino-hero-text: {{ ss.text_color }}; --krino-hero-w: {{ ss.content_width }}%; --krino-hero-h-font: {{ ss.heading_font }}; --krino-hero-h-size: {{ ss.heading_size }}px; --krino-hero-h-size-m: {{ ss.heading_size_mobile }}px; --krino-hero-h-weight: {{ ss.heading_weight }}; --krino-hero-body: {{ ss.body_size }}px; --krino-hero-body-m: {{ ss.body_size_mobile }}px; --krino-hero-btn-bg: {{ ss.button_bg }}; --krino-hero-btn-text: {{ ss.button_text }}; --krino-hero-pt: {{ ss.padding_top }}px; --krino-hero-pb: {{ ss.padding_bottom }}px;"
>
  <div class="krino-hero__bg">
    {%- if ss.image != blank -%}
      <picture>
        {%- if ss.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ kh_mobile_image | image_url: width: 750 }} 750w, {{ kh_mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
        {%- endif -%}
        {{ ss.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', alt: ss.heading }}
      </picture>
    {%- elsif ss.image_asset != blank -%}
      <img src="{{ ss.image_asset | asset_url }}" alt="{{ ss.heading | escape }}" loading="eager" fetchpriority="high" width="1600" height="893" onerror="this.remove()">
    {%- endif -%}
  </div>
  <div class="krino-hero__inner">
    <div class="krino-hero__content">
      {%- if ss.show_stars or ss.proof != blank -%}
        <p class="krino-hero__proof">
          {%- if ss.show_stars -%}<span class="krino-hero__stars">{% render 'krino-stars', size: ss.star_size, color: ss.star_color, gap: 1 %}</span>{%- endif -%}
          {%- if ss.proof != blank -%}<span>{{ ss.proof }}</span>{%- endif -%}
        </p>
      {%- endif -%}
      {%- if ss.heading != blank -%}<h1 class="krino-hero__heading">{{ ss.heading }}</h1>{%- endif -%}
      {%- if ss.text != blank -%}<p class="krino-hero__text">{{ ss.text }}</p>{%- endif -%}
      {%- if ss.button_label != blank -%}<a class="krino-hero__button" href="{{ kh_link }}">{{ ss.button_label }}</a>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="krino-hero__trust">
          {%- for block in section.blocks -%}
            <li class="krino-hero__trust-item" {{ block.shopify_attributes }}>
              {%- render 'krino-icon', name: block.settings.icon, size: 22, stroke: 1.6 -%}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .krino-hero { position: relative; display: flex; align-items: center; min-height: var(--krino-hero-h, 70vh); padding: var(--krino-hero-pt, 40px) 0 var(--krino-hero-pb, 40px); overflow: hidden; background: var(--krino-hero-fill, #1b2238); color: var(--krino-hero-text, #fff); }
  .krino-hero__bg { position: absolute; inset: 0; }
  .krino-hero__bg picture { display: contents; }
  .krino-hero__bg img { width: 100%; height: 100%; object-fit: cover; object-position: var(--krino-hero-pos, center); }
  .krino-hero__bg::after { content: ''; position: absolute; inset: 0; background: var(--krino-hero-overlay, #000); opacity: var(--krino-hero-opacity, 0.5); }
  .krino-hero__inner { position: relative; width: 100%; max-width: 1300px; margin: 0 auto; padding-inline: 40px; }
  .krino-hero__content { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; width: var(--krino-hero-w, 50%); }
  .krino-hero--center .krino-hero__content { align-items: center; margin-inline: auto; text-align: center; }
  .krino-hero__proof { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0; font-size: 14px; font-weight: 700; line-height: 1.3; }
  .krino-hero__stars { display: inline-flex; }
  .krino-hero__heading { margin: 0; font-family: var(--krino-hero-h-font, var(--font-heading--family)); font-size: var(--krino-hero-h-size, 48px); font-weight: var(--krino-hero-h-weight, 600); line-height: 1.15; color: inherit; }
  .krino-hero__text { margin: 0; font-size: var(--krino-hero-body, 15px); line-height: 1.4; }
  .krino-hero__button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; margin-top: 4px; padding: 10px 20px; border-radius: 8px; background: var(--krino-hero-btn-bg, #fff); color: var(--krino-hero-btn-text, #000); font-size: 14px; letter-spacing: 0.025rem; text-transform: uppercase; text-decoration: none; transition: opacity 0.2s ease; }
  .krino-hero__button:hover { opacity: 0.88; }
  .krino-hero__trust { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 5px 0 0; padding: 0; list-style: none; font-size: 14px; }
  .krino-hero__trust-item { display: flex; align-items: center; gap: 6px; }
  @media screen and (max-width: 749px) {
    .krino-hero { min-height: var(--krino-hero-h-m, 70vh); }
    .krino-hero__inner { padding-inline: 20px; }
    .krino-hero__content { width: 100%; }
    .krino-hero__heading { font-size: var(--krino-hero-h-size-m, 32px); }
    .krino-hero__text { font-size: var(--krino-hero-body-m, 14px); }
    .krino-hero__trust { flex-direction: column; gap: 10px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino hero",
  "tag": "section",
  "class": "krino-hero-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check-box", "options": [
          { "value": "check-box", "label": "Checked box" }, { "value": "check-circle", "label": "Check" }, { "value": "verified", "label": "Verified badge" }, { "value": "truck", "label": "Truck" }, { "value": "gift", "label": "Gift" }, { "value": "clock", "label": "Clock" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Cambio de tono GRATIS" }
      ]
    }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Background image (mobile, optional)" },
    { "type": "text", "id": "image_asset", "label": "Background theme asset (fallback file name)", "default": "krino-home-hero.jpg" },
    { "type": "select", "id": "image_position", "label": "Image focus", "default": "center", "options": [
      { "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "inline_richtext", "id": "proof", "label": "Proof line", "default": "<strong>40,000 clientes satisfechos</strong>" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tus entradas ya fueron" },
    { "type": "textarea", "id": "text", "label": "Subline", "default": "El rellenador capilar a prueba de agua que 40,000 hombres usan cada mañana… y nadie lo ha notado jamás." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Descubre el producto" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = the product below)" },
    { "type": "text", "id": "product_handle", "label": "Product handle (used when the link is empty)", "default": "polvo-densificador" },
    { "type": "select", "id": "alignment", "label": "Content alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ] },
    { "type": "range", "id": "content_width", "label": "Content width (desktop)", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#3D5AFE" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "color", "id": "fallback_color", "label": "Background without image", "default": "#1B2238" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "var(--font-heading--family)", "options": [
      { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-accent--family)", "label": "Accent" }
    ] },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "600", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 20, "max": 80, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "body_size", "label": "Subline size (desktop)", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "body_size_mobile", "label": "Subline size (mobile)", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "star_size", "label": "Star size", "min": 10, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Size and spacing" },
    { "type": "range", "id": "height", "label": "Height (desktop, % of screen)", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile, % of screen)", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [
    {
      "name": "Krino hero",
      "blocks": [
        { "type": "item", "settings": { "icon": "check-box", "text": "Cambio de tono GRATIS" } },
        { "type": "item", "settings": { "icon": "check-box", "text": "Enviamos en 24 hrs" } }
      ]
    }
  ]
}
{% endschema %}
