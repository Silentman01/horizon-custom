{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-tt" style="--pawsorb-tt-pt: {{ ss.padding_top }}px; --pawsorb-tt-pb: {{ ss.padding_bottom }}px; --pawsorb-tt-bg: {{ ss.bg_color }}; --pawsorb-tt-fg: {{ ss.text_color }}; --pawsorb-tt-accent: {{ ss.accent_color }}; --pawsorb-tt-card: {{ ss.card_color }};">
  <div class="pawsorb-tt__inner">
    {%- if ss.show_feature -%}
      <div class="pawsorb-tt__feature">
        <div class="pawsorb-tt__fmedia">
          {% render 'pawsorb-media', image: ss.feature_image, asset: ss.feature_asset, alt: ss.feature_alt, ratio: '4 / 3', icon: 'toad', tone: 'navy', sizes: '(min-width: 750px) 50vw, 100vw' %}
        </div>
        <div class="pawsorb-tt__ftext">
          {%- if ss.heading != blank -%}<h2 class="pawsorb-tt__h">{{ ss.heading }}</h2>{%- endif -%}
          {%- if ss.chip_1 != blank or ss.chip_2 != blank -%}
            <ul class="pawsorb-tt__chips">
              {%- if ss.chip_1 != blank -%}<li>{{ ss.chip_1 }}</li>{%- endif -%}
              {%- if ss.chip_2 != blank -%}<li class="is-red">{% render 'pawsorb-icon', name: 'clock', size: 14 %}{{ ss.chip_2 }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
          {%- if ss.feature_body != blank -%}<p class="pawsorb-tt__fb">{{ ss.feature_body }}</p>{%- endif -%}
          {%- if ss.feature_micro != blank -%}<p class="pawsorb-tt__fm">{{ ss.feature_micro }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- if ss.rail_heading != blank -%}<h3 class="pawsorb-tt__rh">{{ ss.rail_heading }}</h3>{%- endif -%}
    <div class="pawsorb-tt__rail" data-pawsorb-rail>
      {%- for block in section.blocks -%}
        <figure class="pawsorb-tt__tile" {{ block.shopify_attributes }}>
          {% render 'pawsorb-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.alt, ratio: '1 / 1', icon: block.settings.icon, tone: 'warm', sizes: '(min-width: 750px) 200px, 45vw' %}
          <figcaption class="pawsorb-tt__name">{{ block.settings.name }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
    {%- if ss.footer_line != blank -%}<p class="pawsorb-tt__foot">{{ ss.footer_line }}</p>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-tt { padding: var(--pawsorb-tt-pt, 64px) 0 var(--pawsorb-tt-pb, 64px); background: var(--pawsorb-tt-bg, #F1F6F3); color: var(--pawsorb-tt-fg, #141816); }
  .pawsorb-tt__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-tt__feature { display: grid; grid-template-columns: 1.05fr 1fr; gap: 0; border-radius: 14px; overflow: hidden; background: var(--pawsorb-tt-card, #fff); border: 1px solid #DCE6E0; }
  .pawsorb-tt__fmedia .pawsorb-media { border-radius: 0; height: 100%; }
  .pawsorb-tt__ftext { padding: 36px; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
  .pawsorb-tt__h { margin: 0; font: 700 32px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-tt__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .pawsorb-tt__chips li { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: 999px; background: #121614; color: #fff; font: 700 13px/1.3 var(--font-body--family); letter-spacing: .02em; }
  .pawsorb-tt__chips li.is-red { background: var(--pawsorb-tt-accent, #12855A); }
  .pawsorb-tt__fb { margin: 0; font-size: 17px; line-height: 1.55; }
  .pawsorb-tt__fm { margin: 0; font-size: 14px; color: #5D6A63; font-style: italic; }
  .pawsorb-tt__rh { margin: 40px 0 16px; font: 700 22px/1.3 var(--font-heading--family); color: inherit; }
  .pawsorb-tt__rail { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
  .pawsorb-tt__tile { margin: 0; }
  .pawsorb-tt__tile .pawsorb-media { --pawsorb-media-radius: 12px; }
  .pawsorb-tt__name { margin-top: 8px; text-align: center; font: 700 15px/1.3 var(--font-heading--family); }
  .pawsorb-tt__foot { margin: 20px 0 0; font-size: 15px; color: #5D6A63; text-align: center; }
  @media screen and (max-width: 989px) {
    .pawsorb-tt__rail { grid-template-columns: repeat(3, 1fr); }
  }
  @media screen and (max-width: 749px) {
    .pawsorb-tt { padding: calc(var(--pawsorb-tt-pt, 64px) * .75) 0 calc(var(--pawsorb-tt-pb, 64px) * .75); }
    .pawsorb-tt__feature { grid-template-columns: 1fr; }
    .pawsorb-tt__ftext { padding: 20px 18px 22px; gap: 12px; }
    .pawsorb-tt__h { font-size: 24px; }
    .pawsorb-tt__fb { font-size: 16px; }
    .pawsorb-tt__rh { margin-top: 28px; font-size: 20px; }
    .pawsorb-tt__rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; gap: 12px; margin: 0 -16px; padding: 0 16px; cursor: grab; overscroll-behavior-x: contain; }
    .pawsorb-tt__rail::-webkit-scrollbar { display: none; }
    .pawsorb-tt__rail.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
    .pawsorb-tt__tile { flex: 0 0 58%; scroll-snap-align: start; }
    .pawsorb-tt__foot { text-align: left; font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb toad + toxins",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "toxin",
      "name": "Toxin tile",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Chocolate" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme file", "default": "pawsorb-toxin-chocolate.jpg", "info": "File in assets/. Until it exists, an icon tile is shown." },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Dog sniffing a chocolate bar on a coffee table" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "chocolate", "options": [
          { "value": "chocolate", "label": "Chocolate" }, { "value": "grapes", "label": "Grapes" }, { "value": "pill", "label": "Pill" },
          { "value": "leaf", "label": "Plant" }, { "value": "bait", "label": "Bait block" }, { "value": "mushroom", "label": "Mushroom" },
          { "value": "toad", "label": "Toad" }, { "value": "drop", "label": "Drop" }, { "value": "paw", "label": "Paw" } ] }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_feature", "label": "Show toad feature card", "default": true },
    { "type": "text", "id": "heading", "label": "Feature heading", "default": "That \"big frog\" by the water bowl can kill a dog in 30 minutes." },
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "FL · TX · LA · HI" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "15–30 minutes" },
    { "type": "textarea", "id": "feature_body", "label": "Feature text", "default": "Cane toads come out on wet nights, right under the porch light. One lick fills your dog's mouth with poison. Wipe the gums, give PawSorb, then drive." },
    { "type": "text", "id": "feature_micro", "label": "Feature micro line", "default": "New to the South? Nobody tells you this when you move here." },
    { "type": "image_picker", "id": "feature_image", "label": "Feature image" },
    { "type": "text", "id": "feature_asset", "label": "Feature theme file", "default": "pawsorb-toad-feature.jpg", "info": "File in assets/. Until it exists, an icon tile is shown." },
    { "type": "text", "id": "feature_alt", "label": "Feature alt text", "default": "Cane toad beside a dog water bowl under a porch light" },
    { "type": "text", "id": "rail_heading", "label": "Tiles heading", "default": "And the stuff already in your house:" },
    { "type": "textarea", "id": "footer_line", "label": "Footer line", "default": "Also binds caffeine, THC, nicotine, onions, moldy food, toxic plants, household chemicals and blue-green algae." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F1F6F3" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb toad + toxins",
      "blocks": [
        { "type": "toxin", "settings": { "name": "Chocolate", "image_asset": "pawsorb-toxin-chocolate.jpg", "alt": "Dog sniffing a chocolate bar on a coffee table", "icon": "chocolate" } },
        { "type": "toxin", "settings": { "name": "Grapes & raisins", "image_asset": "pawsorb-toxin-grapes.jpg", "alt": "Grapes spilled on a kitchen floor", "icon": "grapes" } },
        { "type": "toxin", "settings": { "name": "Dropped pills", "image_asset": "pawsorb-toxin-meds.jpg", "alt": "Pills dropped under a holiday table", "icon": "pill" } },
        { "type": "toxin", "settings": { "name": "Sago palm", "image_asset": "pawsorb-toxin-sago.jpg", "alt": "Sago palm with seeds in a backyard", "icon": "leaf" } },
        { "type": "toxin", "settings": { "name": "Rat bait", "image_asset": "pawsorb-toxin-rodenticide.jpg", "alt": "Rat bait block in a garage corner", "icon": "bait" } },
        { "type": "toxin", "settings": { "name": "Wild mushrooms", "image_asset": "pawsorb-toxin-mushrooms.jpg", "alt": "Puppy sniffing wild mushrooms in the grass", "icon": "mushroom" } }
      ]
    }
  ]
}
{% endschema %}
