{%- comment -%}
  Krino statement band: full-bleed colour band with a centred heading, subline and button to the product. Prefix krino-band.
  Link: button link, else the product found by handle, else all products.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign kbd_link = ss.button_link
  if kbd_link == blank
    assign kbd_product = all_products[ss.product_handle]
    if kbd_product != blank and kbd_product.url != blank
      assign kbd_link = kbd_product.url
    else
      assign kbd_link = routes.all_products_collection_url
    endif
  endif
-%}
<div
  class="krino-band"
  style="--krino-band-bg: {{ ss.background }}; --krino-band-text: {{ ss.text_color }}; --krino-band-btn: {{ ss.button_bg }}; --krino-band-btn-text: {{ ss.button_text }}; --krino-band-w: {{ ss.content_width }}%; --krino-band-h-font: {{ ss.heading_font }}; --krino-band-h-size: {{ ss.heading_size }}px; --krino-band-h-size-m: {{ ss.heading_size_mobile }}px; --krino-band-h-weight: {{ ss.heading_weight }}; --krino-band-body: {{ ss.body_size }}px; --krino-band-body-m: {{ ss.body_size_mobile }}px; --krino-band-pt: {{ ss.padding_top }}px; --krino-band-pb: {{ ss.padding_bottom }}px; --krino-band-pt-m: {{ ss.padding_top_mobile }}px; --krino-band-pb-m: {{ ss.padding_bottom_mobile }}px;"
>
  <div class="krino-band__inner">
    {%- if ss.heading != blank -%}<p class="krino-band__heading">{{ ss.heading }}</p>{%- endif -%}
    {%- if ss.text != blank -%}<p class="krino-band__text">{{ ss.text }}</p>{%- endif -%}
    {%- if ss.button_label != blank -%}<a class="krino-band__button" href="{{ kbd_link }}">{{ ss.button_label }}</a>{%- endif -%}
  </div>
</div>
{% stylesheet %}
  .krino-band { padding: var(--krino-band-pt, 30px) 20px var(--krino-band-pb, 30px); background: var(--krino-band-bg, #000); color: var(--krino-band-text, #fff); text-align: center; }
  .krino-band__inner { display: flex; flex-direction: column; align-items: center; gap: 15px; width: var(--krino-band-w, 60%); max-width: 1220px; margin: 0 auto; }
  .krino-band__heading { margin: 0; font-family: var(--krino-band-h-font, var(--font-heading--family)); font-size: var(--krino-band-h-size, 32px); font-weight: var(--krino-band-h-weight, 600); line-height: 1.25; }
  .krino-band__text { margin: 0; font-size: var(--krino-band-body, 15px); line-height: 1.4; }
  .krino-band__button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 10px 20px; border-radius: 8px; background: var(--krino-band-btn, #fff); color: var(--krino-band-btn-text, #000); font-size: 14px; letter-spacing: 0.025rem; text-transform: uppercase; text-decoration: none; transition: opacity 0.2s ease; }
  .krino-band__button:hover { opacity: 0.88; }
  @media screen and (max-width: 749px) {
    .krino-band { padding: var(--krino-band-pt-m, 30px) 20px var(--krino-band-pb-m, 30px); }
    .krino-band__inner { width: 100%; }
    .krino-band__heading { font-size: var(--krino-band-h-size-m, 24px); }
    .krino-band__text { font-size: var(--krino-band-body-m, 14px); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino statement band",
  "tag": "section",
  "class": "krino-band-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "La innovación capilar que lo cambia todo" },
    { "type": "textarea", "id": "text", "label": "Subline", "default": "Camuflaje instantáneo + fijación de 48 horas, en una sola rutina simple y comprobada." },
    { "type": "text", "id": "button_label", "label": "Button label (empty = hidden)", "default": "Descubre el producto" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = the product below)" },
    { "type": "text", "id": "product_handle", "label": "Product handle (used when the link is empty)", "default": "polvo-densificador" },
    { "type": "range", "id": "content_width", "label": "Content width (desktop)", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#000000" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "var(--font-heading--family)", "options": [
      { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-accent--family)", "label": "Accent" }
    ] },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "600", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 16, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 14, "max": 44, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "body_size", "label": "Subline size (desktop)", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "body_size_mobile", "label": "Subline size (mobile)", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 }
  ],
  "presets": [{ "name": "Krino statement band" }]
}
{% endschema %}
