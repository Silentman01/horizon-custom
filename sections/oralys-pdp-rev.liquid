          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t10.webp",
            "stars": 5,
            "headline": "Une côte de bœuf, sans y penser",
            "text": "« Au mariage de mon petit-fils, j'ai mangé la viande sans m'excuser pour aller remettre de la colle. Première fois en dix ans. »",
            "name": "Robert F., 72 ans, Perpignan",
            "chip": "Haut et bas"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "J'étais sceptique"
