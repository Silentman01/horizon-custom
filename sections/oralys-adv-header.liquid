{%- liquid
  assign s = section.settings
  assign hfont = s.heading_font
  assign bfont = s.body_font
-%}
{%- style -%}
  {{ hfont | font_face: font_display: 'swap' }}
  {{ bfont | font_face: font_display: 'swap' }}
  {%- assign hbold = hfont | font_modify: 'weight', 'bold' -%}
  {%- assign bbold = bfont | font_modify: 'weight', 'bold' -%}
  {%- assign bital = bfont | font_modify: 'style', 'italic' -%}
  {%- if hbold %}{{ hbold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if bbold %}{{ bbold | font_face: font_display: 'swap' }}{% endif -%}
  {%- if bital %}{{ bital | font_face: font_display: 'swap' }}{% endif %}
  :root {
    --oralys-adv-font-head: {{ hfont.family }}, {{ hfont.fallback_families }};
    --oralys-adv-font-head-weight: {{ hfont.weight }};
    --oralys-adv-font-body: {{ bfont.family }}, {{ bfont.fallback_families }};
    --oralys-adv-bg: {{ s.color_bg }};
    --oralys-adv-text: {{ s.color_text }};
    --oralys-adv-muted: {{ s.color_muted }};
    --oralys-adv-accent: {{ s.color_accent }};
    --oralys-adv-cta: {{ s.color_cta }};
    --oralys-adv-cta-text: {{ s.color_cta_text }};
    --oralys-adv-highlight: {{ s.color_highlight }};
    --oralys-adv-line: #dce5e0;
    --oralys-adv-tint: #eef6f1;
    --oralys-adv-measure: {{ s.measure }}px;
    --oralys-adv-body-size: {{ s.body_size_mobile }}px;
    --oralys-adv-h1-size: {{ s.h1_size_mobile }}px;
  }
  @media (min-width: 750px) {
    :root {
      --oralys-adv-body-size: {{ s.body_size_desktop }}px;
      --oralys-adv-h1-size: {{ s.h1_size_desktop }}px;
    }
  }
  body.oralys-adv-body { background: var(--oralys-adv-bg); color: var(--oralys-adv-text); }
  .oralys-adv-hd-{{ section.id }} {
    padding-top: {{ s.pad_top_mobile }}px;
    padding-bottom: {{ s.pad_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    .oralys-adv-hd-{{ section.id }} {
      padding-top: {{ s.pad_top }}px;
      padding-bottom: {{ s.pad_bottom }}px;
    }
  }
  .oralys-adv-hd-{{ section.id }} .oralys-adv-hd__mast {
    background: {{ s.masthead_bg }};
    color: {{ s.masthead_text }};
  }
{%- endstyle -%}

<header class="oralys-adv-hd oralys-adv-hd-{{ section.id }}">
  {%- if s.show_masthead -%}
    <div class="oralys-adv-hd__mast">
      <div class="oralys-adv-hd__mast-in">
        {%- if s.ad_label != blank -%}
          <span class="oralys-adv-hd__ad">{{ s.ad_label }}</span>
        {%- endif -%}
        <span class="oralys-adv-hd__pub">{{ s.publication_name }}</span>
        {%- if s.publication_tagline != blank -%}
          <span class="oralys-adv-hd__tag">{{ s.publication_tagline }}</span>
        {%- endif -%}
      </div>
      {%- if s.masthead_nav != blank -%}
        {%- assign nav = s.masthead_nav | split: '|' -%}
        <nav class="oralys-adv-hd__nav" aria-label="{{ s.publication_name | escape }}">
          {%- for n in nav -%}
            <span class="oralys-adv-hd__nav-i{% if forloop.first %} is-on{% endif %}">{{ n | strip }}</span>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="oralys-adv-hd__art">
    {%- if s.category != blank -%}
      <p class="oralys-adv-hd__cat">{{ s.category }}</p>
    {%- endif -%}
    {%- if s.headline != blank -%}
      <h1 class="oralys-adv-hd__h1">{{ s.headline }}</h1>
    {%- endif -%}
    {%- if s.dek != blank -%}
      <div class="oralys-adv-hd__dek">{{ s.dek }}</div>
    {%- endif -%}

    {%- if s.show_byline -%}
      <div class="oralys-adv-hd__by">
        {%- if s.author_image != blank or s.author_image_asset != blank -%}
          <span class="oralys-adv-hd__av" data-oralys-adv-media>
            {%- render 'oralys-adv-media',
              image: s.author_image,
              asset: s.author_image_asset,
              alt: s.author_name,
              class: 'oralys-adv-hd__av-img',
              sizes: '56px',
              eager: true
            -%}
          </span>
        {%- endif -%}
        <span class="oralys-adv-hd__by-txt">
          <span class="oralys-adv-hd__name">{{ s.author_name }}</span>
          {%- if s.author_role != blank -%}
            <span class="oralys-adv-hd__role">{{ s.author_role }}</span>
          {%- endif -%}
          {%- if s.date_text != blank or s.meta_text != blank -%}
            <span class="oralys-adv-hd__meta">
              {{- s.date_text -}}
              {%- if s.date_text != blank and s.meta_text != blank %} · {% endif -%}
              {{- s.meta_text -}}
            </span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>

  {%- if s.hero_image != blank or s.hero_image_asset != blank -%}
    <figure class="oralys-adv-hd__fig oralys-adv-hd__fig--{{ s.hero_ratio }}" data-oralys-adv-media>
      {%- render 'oralys-adv-media',
        image: s.hero_image,
        asset: s.hero_image_asset,
        alt: s.hero_caption,
        class: 'oralys-adv-hd__img',
        eager: true
      -%}
      {%- if s.hero_caption != blank -%}
        <figcaption class="oralys-adv-hd__cap">{{ s.hero_caption }}</figcaption>
      {%- endif -%}
    </figure>
  {%- endif -%}
</header>

{% stylesheet %}
  body.oralys-adv-body {
    font-family: var(--oralys-adv-font-body);
    font-size: var(--oralys-adv-body-size, 18px);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .oralys-adv-main { overflow-x: clip; }
  .oralys-adv-hd { font-family: var(--oralys-adv-font-body); color: var(--oralys-adv-text); }
  .oralys-adv-hd__mast { border-bottom: 1px solid var(--oralys-adv-line); }
  .oralys-adv-hd__mast-in {
    max-width: var(--oralys-adv-measure);
    margin: 0 auto;
    padding: 14px 16px 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .oralys-adv-hd__pub {
    font-family: var(--oralys-adv-font-head);
    font-weight: var(--oralys-adv-font-head-weight);
    font-size: 26px;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .oralys-adv-hd__tag { font-size: 13px; opacity: 0.75; font-style: italic; }
  .oralys-adv-hd__ad {
    order: -1;
    width: 100%;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .oralys-adv-hd__nav {
    max-width: var(--oralys-adv-measure);
    margin: 0 auto;
    padding: 0 16px 10px;
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scrollbar-width: none;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .oralys-adv-hd__nav::-webkit-scrollbar { display: none; }
  .oralys-adv-hd__nav-i { opacity: 0.65; padding-bottom: 4px; }
  .oralys-adv-hd__nav-i.is-on { opacity: 1; border-bottom: 2px solid var(--oralys-adv-accent); }
  .oralys-adv-hd__art { max-width: var(--oralys-adv-measure); margin: 0 auto; padding: 22px 16px 0; }
  .oralys-adv-hd__cat {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oralys-adv-accent);
  }
  .oralys-adv-hd__h1 {
    margin: 0 0 14px;
    font-family: var(--oralys-adv-font-head);
    font-weight: var(--oralys-adv-font-head-weight);
    font-size: var(--oralys-adv-h1-size, 30px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--oralys-adv-text);
    text-wrap: balance;
  }
  .oralys-adv-hd__h1 strong {
    font-weight: inherit;
    background: linear-gradient(transparent 58%, var(--oralys-adv-highlight) 58%);
  }
  .oralys-adv-hd__dek { font-size: 1.05em; line-height: 1.5; color: var(--oralys-adv-muted); margin-bottom: 18px; }
  .oralys-adv-hd__dek p { margin: 0 0 0.6em; }
  .oralys-adv-hd__by {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--oralys-adv-line);
    border-bottom: 1px solid var(--oralys-adv-line);
  }
  .oralys-adv-hd__av { flex: 0 0 52px; width: 52px; height: 52px; border-radius: 50%; overflow: hidden; background: var(--oralys-adv-tint); }
  .oralys-adv-hd__av-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .oralys-adv-hd__by-txt { display: flex; flex-direction: column; line-height: 1.3; }
  .oralys-adv-hd__name { font-weight: 700; font-size: 16px; }
  .oralys-adv-hd__role { font-size: 14px; color: var(--oralys-adv-muted); }
  .oralys-adv-hd__meta { font-size: 13px; color: var(--oralys-adv-muted); margin-top: 2px; }
  .oralys-adv-hd__fig { max-width: calc(var(--oralys-adv-measure) + 80px); margin: 22px auto 0; padding: 0; }
  .oralys-adv-hd__img { display: block; width: 100%; height: auto; object-fit: cover; }
  .oralys-adv-hd__fig--landscape .oralys-adv-hd__img { aspect-ratio: 3 / 2; }
  .oralys-adv-hd__fig--portrait .oralys-adv-hd__img { aspect-ratio: 4 / 5; }
  .oralys-adv-hd__fig--square .oralys-adv-hd__img { aspect-ratio: 1; }
  .oralys-adv-hd__cap { padding: 8px 16px 0; font-size: 14px; line-height: 1.45; color: var(--oralys-adv-muted); font-style: italic; }
  @media (min-width: 750px) {
    .oralys-adv-hd__pub { font-size: 32px; }
    .oralys-adv-hd__art { padding-top: 34px; }
    .oralys-adv-hd__img { border-radius: 14px; }
    .oralys-adv-hd__cap { padding-inline: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Adv · Article header",
  "tag": "section",
  "class": "oralys-adv-hd-section",
  "settings": [
    { "type": "header", "content": "Masthead (invented publication)" },
    { "type": "checkbox", "id": "show_masthead", "label": "Show masthead", "default": true },
    { "type": "text", "id": "ad_label", "label": "Advertising label", "default": "Publicité" },
    { "type": "text", "id": "publication_name", "label": "Publication name", "default": "Le Carnet Santé", "info": "Invented name only: never a real outlet, never the brand." },
    { "type": "text", "id": "publication_tagline", "label": "Tagline", "default": "Le magazine du bien-vieillir" },
    { "type": "text", "id": "masthead_nav", "label": "Category bar", "default": "Santé | Bien-être | Famille | Témoignages", "info": "Items separated by |. The first is highlighted." },
    { "type": "color", "id": "masthead_bg", "label": "Masthead background", "default": "#FFFFFF" },
    { "type": "color", "id": "masthead_text", "label": "Masthead text", "default": "#17221E" },
    { "type": "header", "content": "Article" },
    { "type": "text", "id": "category", "label": "Category label", "default": "Santé" },
    { "type": "inline_richtext", "id": "headline", "label": "Headline (H1)", "default": "Titre de l'article", "info": "Bold words get the highlight marker." },
    { "type": "richtext", "id": "dek", "label": "Standfirst" },
    { "type": "checkbox", "id": "show_byline", "label": "Show byline", "default": true },
    { "type": "text", "id": "author_name", "label": "Author name", "default": "La rédaction" },
    { "type": "text", "id": "author_role", "label": "Author role" },
    { "type": "image_picker", "id": "author_image", "label": "Author photo" },
    { "type": "text", "id": "author_image_asset", "label": "Author photo fallback (theme asset filename)" },
    { "type": "text", "id": "date_text", "label": "Date line" },
    { "type": "text", "id": "meta_text", "label": "Reading time / views" },
    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_asset", "label": "Hero fallback (theme asset filename)", "info": "Used when no image is picked. Hidden if the file is missing." },
    { "type": "text", "id": "hero_caption", "label": "Caption" },
    { "type": "select", "id": "hero_ratio", "label": "Ratio", "default": "landscape", "options": [ { "value": "landscape", "label": "3:2" }, { "value": "portrait", "label": "4:5" }, { "value": "square", "label": "1:1" }, { "value": "natural", "label": "Natural" } ] },
    { "type": "header", "content": "Page typography (applies to every Adv section)" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "lora_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "figtree_n4" },
    { "type": "range", "id": "h1_size_mobile", "label": "H1 size mobile", "min": 22, "max": 44, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "h1_size_desktop", "label": "H1 size desktop", "min": 26, "max": 60, "step": 1, "unit": "px", "default": 42 },
    { "type": "range", "id": "body_size_mobile", "label": "Body size mobile", "min": 15, "max": 22, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "body_size_desktop", "label": "Body size desktop", "min": 15, "max": 24, "step": 1, "unit": "px", "default": 19 },
    { "type": "range", "id": "measure", "label": "Column width", "min": 560, "max": 860, "step": 10, "unit": "px", "default": 700 },
    { "type": "header", "content": "Page colors (applies to every Adv section)" },
    { "type": "color", "id": "color_bg", "label": "Page background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#17221E" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#5C6863" },
    { "type": "color", "id": "color_accent", "label": "Accent (labels, icons)", "default": "#0E6B50" },
    { "type": "color", "id": "color_cta", "label": "Button background", "default": "#D2382C" },
    { "type": "color", "id": "color_cta_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "color_highlight", "label": "Highlight marker", "default": "#FBE3A6" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [ { "name": "Adv · Article header" } ]
}
{% endschema %}
