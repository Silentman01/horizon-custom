{%- assign s = section.settings -%}
<section class="ot-home-faq" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <h2 class="ot-home-faq__heading">{{ s.heading }}</h2>
  <div class="ot-home-faq__list">
    {%- for block in section.blocks -%}
      <details class="ot-home-faq__item" {{ block.shopify_attributes }}>
        <summary class="ot-home-faq__q">
          <span>{{ block.settings.question }}</span>
          <span class="ot-home-faq__chev" aria-hidden="true"><svg viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1.5 5 5 5-5"/></svg></span>
        </summary>
        <p class="ot-home-faq__a">{{ block.settings.answer }}</p>
      </details>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.ot-home-faq { background: var(--ot-bg); padding: var(--ot-pt) 0 var(--ot-pb); font-family: var(--ot-font); color: #121212; }
.ot-home-faq__heading { margin: 0 0 28px; padding-inline: 16px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 40px; line-height: 1.1; color: var(--ot-green); }
.ot-home-faq__list { max-width: 1024px; margin: 0 auto; padding-inline: 16px; display: flex; flex-direction: column; gap: 12px; }
.ot-home-faq__item { background: #fff; border: 1px solid #121212; border-radius: 6px; box-shadow: 0 3px 0 var(--ot-green); }
.ot-home-faq__q { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: 12.5px; line-height: 1.35; text-transform: uppercase; color: var(--ot-green); }
.ot-home-faq__q::-webkit-details-marker { display: none; }
.ot-home-faq__chev { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ot-lime); color: #121212; transition: transform 0.2s ease; }
.ot-home-faq__item[open] .ot-home-faq__chev { transform: rotate(180deg); }
.ot-home-faq__a { margin: 0; padding: 0 16px 16px; font-size: 14px; line-height: 1.6; }
@media screen and (min-width: 750px) {
  .ot-home-faq__heading { font-size: 56px; }
  .ot-home-faq__q { font-size: 14px; padding: 20px 22px; }
  .ot-home-faq__a { padding: 0 22px 20px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's home FAQ",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 40, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are Old Tom's products really safe around kids and pets?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Yes, absolutely! All our products are made with 100% plant-based essential oils (like peppermint, lemongrass and citronella) and are completely free from harsh, toxic chemicals. They're built to be a safe, natural alternative for your home, family and furry friends." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Old Tom's home FAQ",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "question": "How long do the repellent pouches last?", "answer": "Our pouches give long-lasting, non-stop protection. Generally they work for 30 to 60 days depending on airflow and room size. We recommend replacing them once the natural scent starts to fade." } }
      ]
    }
  ]
}
{% endschema %}
