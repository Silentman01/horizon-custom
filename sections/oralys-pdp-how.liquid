{%- liquid
  assign s = section.settings
  assign h = s.heading
  if s.accent != blank
    assign acc = '<em>' | append: s.accent | append: '</em>'
    assign h = h | replace: s.accent, acc
  endif
-%}
<div class="oralys-pdp-how" style="--op-bg:{{ s.c_bg }};--op-text:{{ s.c_text }};--op-accent:{{ s.c_accent }};--op-muted:{{ s.c_muted }};--op-card:{{ s.c_card }};--op-line:{{ s.c_line }};--op-cta:{{ s.c_cta }};--op-cta-text:{{ s.c_cta_text }};--op-h-m:{{ s.h_m }}px;--op-h-d:{{ s.h_d }}px;--op-body:{{ s.body_size }}px;--op-align:{{ s.align }};--op-pt-m:{{ s.pt_m }}px;--op-pb-m:{{ s.pb_m }}px;--op-pt-d:{{ s.pt_d }}px;--op-pb-d:{{ s.pb_d }}px">
  <div class="oralys-pdp-how__inner">
    <div class="oralys-pdp-how__head">{% if s.eyebrow != blank %}<p class="oralys-pdp-how__eyebrow">{{ s.eyebrow }}</p>{% endif %}{% if h != blank %}<h2 class="oralys-pdp-how__h">{{ h }}</h2>{% endif %}</div>
    <ol class="oralys-pdp-how__steps">
      {%- for block in section.blocks -%}
      <li class="oralys-pdp-how__step" {{ block.shopify_attributes }}>
        <div class="oralys-pdp-how__media">{%- if block.settings.image != blank or block.settings.asset != blank -%}{% render 'oralys-pdp-media', image: block.settings.image, asset: block.settings.asset, alt: block.settings.alt, class: 'oralys-pdp-how__img', width: 1024, height: 1024 %}{%- endif -%}<span class="oralys-pdp-how__num">{{ forloop.index }}</span></div>
        <h3 class="oralys-pdp-how__st">{{ block.settings.title }}</h3>
        <p class="oralys-pdp-how__sb">{{ block.settings.body }}</p>
      </li>
      {%- endfor -%}
    </ol>
    <div class="oralys-pdp-how__foot">
      {%- if s.r_title != blank -%}
      <div class="oralys-pdp-how__rm">
        {%- if s.r_image != blank or s.r_asset != blank -%}<span class="oralys-pdp-how__rimg">{% render 'oralys-pdp-media', image: s.r_image, asset: s.r_asset, alt: s.r_alt, class: 'oralys-pdp-how__rpic', loading: 'lazy', width: 400, height: 400 %}</span>{%- endif -%}
        <div><p class="oralys-pdp-how__rt">{{ s.r_title }}</p><p class="oralys-pdp-how__rb">{{ s.r_body }}</p></div>
      </div>
      {%- endif -%}
      {%- if s.note != blank %}<p class="oralys-pdp-how__note">{% render 'oralys-pdp-icon', name: 'smile', size: 22 %}<span>{{ s.note }}</span></p>{% endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.oralys-pdp-how{background:var(--op-bg);color:var(--op-text);padding:var(--op-pt-m) 16px var(--op-pb-m);font-family:var(--font-body--family);font-size:var(--op-body);line-height:1.55}
.oralys-pdp-how *{box-sizing:border-box}
@media (min-width:750px){.oralys-pdp-how{padding:var(--op-pt-d) 32px var(--op-pb-d)}}
.oralys-pdp-how__inner{max-width:1200px;margin:0 auto}
.oralys-pdp-how__head{text-align:var(--op-align);margin:0 0 24px}
.oralys-pdp-how__eyebrow{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--op-accent);margin:0 0 10px}
.oralys-pdp-how__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--op-h-m);line-height:1.22;margin:0;color:var(--op-text);text-wrap:balance}
.oralys-pdp-how__h em{font-style:normal;color:var(--op-accent)}
@media (min-width:750px){.oralys-pdp-how__h{font-size:var(--op-h-d)}}
.oralys-pdp-how__btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--op-cta);color:var(--op-cta-text);font-weight:700;font-size:18px;text-decoration:none;border:0;width:100%;transition:transform .15s}
.oralys-pdp-how__btn:hover{transform:translateY(-1px)}
@media (min-width:750px){.oralys-pdp-how__btn{display:inline-flex;width:auto;min-width:320px}}

.oralys-pdp-how__steps{list-style:none;margin:0;padding:0;display:grid;gap:28px}
@media (min-width:750px){.oralys-pdp-how__steps{grid-template-columns:repeat(3,1fr);gap:24px}}
.oralys-pdp-how__media{position:relative;aspect-ratio:4/3;border-radius:14px;overflow:visible;background:#EEF6F1;margin-bottom:28px}
.oralys-pdp-how__img{display:block;width:100%;height:100%;object-fit:cover;border-radius:14px}
.oralys-pdp-how__num{position:absolute;left:16px;bottom:-22px;width:48px;height:48px;border-radius:50%;background:var(--op-accent);color:#fff;font-weight:800;font-size:22px;display:flex;align-items:center;justify-content:center;border:3px solid var(--op-bg)}
.oralys-pdp-how__st{margin:0 0 6px;font-family:var(--font-heading--family);font-weight:700;font-size:22px}
.oralys-pdp-how__sb{margin:0}
.oralys-pdp-how__foot{display:grid;gap:14px;margin-top:28px}
@media (min-width:750px){.oralys-pdp-how__foot{grid-template-columns:2fr 1fr;align-items:center}}
.oralys-pdp-how__rm{display:flex;gap:14px;align-items:center;padding:14px;border:1px solid var(--op-line);border-radius:12px;background:var(--op-card)}
.oralys-pdp-how__rimg{flex:0 0 88px;width:88px;height:88px;border-radius:12px;overflow:hidden;background:#EEF6F1}
.oralys-pdp-how__rpic{width:100%;height:100%;object-fit:cover;display:block}
.oralys-pdp-how__rt{margin:0 0 4px;font-weight:800;font-size:17px}
.oralys-pdp-how__rb{margin:0;font-size:15px;line-height:1.45;color:var(--op-muted)}
.oralys-pdp-how__note{display:flex;gap:10px;align-items:center;margin:0;padding:14px 16px;border-radius:12px;background:#EEF6F1;font-weight:700}
.oralys-pdp-how__note svg{color:var(--op-accent);flex:0 0 auto}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : mode d'emploi",
  "tag": "section",
  "class": "oralys-pdp-how-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "MODE D'EMPLOI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Posé en 3 gestes, il tient 2 à 3 jours"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Mot du titre en couleur accent",
      "default": "3 gestes",
      "info": "Doit apparaître tel quel dans le titre. Vide = aucun mot en couleur."
    },
    {
      "type": "header",
      "content": "Carte « Pour le retirer »"
    },
    {
      "type": "text",
      "id": "r_title",
      "label": "Titre",
      "default": "Pour le retirer"
    },
    {
      "type": "textarea",
      "id": "r_body",
      "label": "Texte",
      "default": "5 minutes dans l'eau tiède (jamais bouillante), puis soulevez l'ancien gel : il vient d'un seul morceau. Au besoin, aidez-vous d'une petite cuillère."
    },
    {
      "type": "image_picker",
      "id": "r_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "r_asset",
      "label": "Image : fichier du thème",
      "default": "oralys-pdp-peel-out.webp",
      "info": "Utilisé si aucune image n'est choisie (fichier dans assets/)."
    },
    {
      "type": "text",
      "id": "r_alt",
      "label": "Image : texte alternatif",
      "default": "Ancien gel retiré d'un seul morceau après trempage"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "La plupart des gens trouvent le bon dosage dès le 2e jour."
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_accent",
      "label": "Accent (mot du titre, icônes)",
      "default": "#0E6B50"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Texte secondaire",
      "default": "#5C6863"
    },
    {
      "type": "color",
      "id": "c_card",
      "label": "Fond des cartes",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_line",
      "label": "Bordures",
      "default": "#DCE5E0"
    },
    {
      "type": "color",
      "id": "c_cta",
      "label": "Bouton : fond",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_cta_text",
      "label": "Bouton : texte",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typo et espacements"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Titre : taille mobile",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Titre : taille ordinateur",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Texte : taille",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement des titres",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Marge haute mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Marge basse mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Marge haute ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Marge basse ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Image : fichier du thème"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image : texte alternatif"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oralys : mode d'emploi",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "asset": "oralys-pdp-step-1.webp",
            "alt": "Tube Oralys dans un bol d'eau chaude",
            "title": "Chauffer",
            "body": "Plongez le tube quelques minutes dans un bol d'eau chaude (60 °C maximum). Pendant ce temps, lavez votre dentier et séchez-le bien : il doit être parfaitement sec."
          }
        },
        {
          "type": "step",
          "settings": {
            "asset": "oralys-pdp-step-2.webp",
            "alt": "Pouces étalant le gel dans le dentier",
            "title": "Poser",
            "body": "Déposez une noisette de gel, grosse comme une cerise, et étalez-la avec les pouces sur tout l'intérieur de l'appareil, en appuyant sur les bords. Pour le bas, roulez d'abord le gel en boudin."
          }
        },
        {
          "type": "step",
          "settings": {
            "asset": "oralys-pdp-step-3.webp",
            "alt": "Homme mordant doucement, dentier en place",
            "title": "Mordre",
            "body": "Humidifiez votre bouche, mettez le dentier en place et serrez les dents quelques secondes. Rincez à l'eau froide, coupez le surplus aux ciseaux : c'est prêt."
          }
        }
      ]
    }
  ]
}
{% endschema %}
