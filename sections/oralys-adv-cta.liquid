{%- liquid
  assign s = section.settings
  assign link = s.button_link | default: s.fallback_link | default: '/products/oralys-gel'
  assign bullets = s.bullets | newline_to_br | split: '<br />'
-%}
{%- style -%}
  .oralys-adv-ct-{{ section.id }} {
    {% if s.color_bg != blank %}background: {{ s.color_bg }};{% endif %}
    --oralys-adv-ct-card: {{ s.color_card }};
    --oralys-adv-ct-border: {{ s.color_border }};
    {% if s.color_button != blank %}--oralys-adv-ct-btn: {{ s.color_button }};{% endif %}
    {% if s.color_button_text != blank %}--oralys-adv-ct-btn-text: {{ s.color_button_text }};{% endif %}
    padding-top: {{ s.pad_top_mobile }}px;
    padding-bottom: {{ s.pad_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    .oralys-adv-ct-{{ section.id }} { padding-top: {{ s.pad_top }}px; padding-bottom: {{ s.pad_bottom }}px; }
  }
{%- endstyle -%}

<div class="oralys-adv-ct oralys-adv-ct-{{ section.id }}">
  <div class="oralys-adv-ct__in">
    {%- if s.style == 'link' -%}
      <p class="oralys-adv-ct__inline">
        <a href="{{ link }}" class="oralys-adv-ct__inline-a">{{ s.button_label }} →</a>
      </p>
    {%- else -%}
      <div class="oralys-adv-ct__card oralys-adv-ct__card--{{ s.layout }}">
        {%- if s.eyebrow != blank -%}<p class="oralys-adv-ct__eb">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.image != blank or s.image_asset != blank -%}
          <a href="{{ link }}" class="oralys-adv-ct__media" data-oralys-adv-media tabindex="-1">
            {%- render 'oralys-adv-media', image: s.image, asset: s.image_asset, alt: s.heading, class: 'oralys-adv-ct__img', sizes: '(min-width: 750px) 300px, 90vw', eager: true -%}
          </a>
        {%- endif -%}
        <div class="oralys-adv-ct__body">
          {%- if s.heading != blank -%}<h2 class="oralys-adv-ct__h">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<div class="oralys-adv-ct__txt">{{ s.text }}</div>{%- endif -%}
          {%- if s.bullets != blank -%}
            <ul class="oralys-adv-ct__ul">
              {%- for it in bullets -%}
                {%- assign t = it | strip -%}
                {%- if t != blank -%}
                  <li>
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="M5.5 10.3l3 3 6-6.3" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{{ t }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if s.price != blank -%}
            <p class="oralys-adv-ct__price">
              {%- if s.compare_price != blank -%}<s class="oralys-adv-ct__cmp">{{ s.compare_price }}</s>{%- endif -%}
              <span class="oralys-adv-ct__now">{{ s.price }}</span>
              {%- if s.price_note != blank -%}<span class="oralys-adv-ct__pn">{{ s.price_note }}</span>{%- endif -%}
            </p>
          {%- endif -%}
          {%- if s.urgency != blank -%}<p class="oralys-adv-ct__urg"><span class="oralys-adv-ct__dot" aria-hidden="true"></span>{{ s.urgency }}</p>{%- endif -%}
          <a href="{{ link }}" class="oralys-adv-ct__btn">{{ s.button_label }}</a>
          {%- if s.guarantee != blank -%}<p class="oralys-adv-ct__gar">{{ s.guarantee }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .oralys-adv-ct__in { max-width: var(--oralys-adv-measure, 700px); margin: 0 auto; padding: 0 16px; }
  .oralys-adv-ct__inline { margin: 0; font-size: var(--oralys-adv-body-size, 18px); }
  .oralys-adv-ct__inline-a { color: var(--oralys-adv-ct-btn, var(--oralys-adv-cta)); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .oralys-adv-ct__card {
    position: relative;
    background: var(--oralys-adv-ct-card);
    border: 2px solid var(--oralys-adv-ct-border);
    border-radius: 12px;
    padding: 20px 18px 18px;
    display: grid;
    gap: 14px;
  }
  .oralys-adv-ct__eb {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oralys-adv-accent);
  }
  .oralys-adv-ct__media { display: block; border-radius: 12px; overflow: hidden; background: #fff; }
  .oralys-adv-ct__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .oralys-adv-ct__h {
    margin: 0 0 6px;
    font-family: var(--oralys-adv-font-head);
    font-weight: var(--oralys-adv-font-head-weight, 700);
    font-size: 23px;
    line-height: 1.22;
  }
  .oralys-adv-ct__txt p { margin: 0 0 0.7em; }
  .oralys-adv-ct__ul { list-style: none; padding: 0; margin: 4px 0 12px; display: grid; gap: 8px; font-size: 16px; line-height: 1.4; }
  .oralys-adv-ct__ul li { display: flex; gap: 10px; align-items: flex-start; }
  .oralys-adv-ct__ul svg { flex: 0 0 18px; margin-top: 2px; color: var(--oralys-adv-accent); }
  .oralys-adv-ct__price { margin: 0 0 8px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .oralys-adv-ct__cmp { color: var(--oralys-adv-muted); font-size: 17px; }
  .oralys-adv-ct__now { font-size: 26px; font-weight: 800; color: var(--oralys-adv-text); }
  .oralys-adv-ct__pn { font-size: 14px; color: var(--oralys-adv-accent); font-weight: 700; }
  .oralys-adv-ct__urg { margin: 0 0 12px; font-size: 14px; font-weight: 600; color: var(--oralys-adv-ct-btn, var(--oralys-adv-cta)); display: flex; align-items: center; gap: 8px; }
  .oralys-adv-ct__dot { width: 9px; height: 9px; border-radius: 50%; background: currentColor; animation: oralys-adv-ct-pulse 1.6s ease-in-out infinite; }
  @keyframes oralys-adv-ct-pulse { 50% { opacity: 0.3; } }
  .oralys-adv-ct__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 12px 22px;
    border-radius: 40px;
    background: var(--oralys-adv-ct-btn, var(--oralys-adv-cta));
    color: var(--oralys-adv-ct-btn-text, var(--oralys-adv-cta-text, #fff));
    font-weight: 700;
    font-size: 18px;
    text-align: center;
    text-decoration: none;
    line-height: 1.2;
  }
  .oralys-adv-ct__btn:hover { filter: brightness(0.94); }
  .oralys-adv-ct__gar { margin: 10px 0 0; font-size: 14px; text-align: center; color: var(--oralys-adv-muted); }
  @media (min-width: 750px) {
    .oralys-adv-ct__card--side { grid-template-columns: 260px 1fr; align-items: center; column-gap: 24px; padding: 24px; }
    .oralys-adv-ct__card--side .oralys-adv-ct__eb { grid-column: 1 / -1; }
    .oralys-adv-ct__card--side .oralys-adv-ct__img { aspect-ratio: 1; }
    .oralys-adv-ct__h { font-size: 26px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Adv · CTA box",
  "tag": "section",
  "class": "oralys-adv-ct-section",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "card", "options": [ { "value": "card", "label": "Product card" }, { "value": "link", "label": "Inline text link" } ] },
    { "type": "select", "id": "layout", "label": "Card layout (desktop)", "default": "side", "options": [ { "value": "side", "label": "Image left" }, { "value": "stack", "label": "Stacked" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image fallback (theme asset filename)" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "bullets", "label": "Bullets (one per line)" },
    { "type": "text", "id": "compare_price", "label": "Compare-at price" },
    { "type": "text", "id": "price", "label": "Price" },
    { "type": "text", "id": "price_note", "label": "Price note" },
    { "type": "text", "id": "urgency", "label": "Urgency line" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Voir l'offre" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "fallback_link", "label": "Link used when the field above is empty", "default": "/products/oralys-gel" },
    { "type": "text", "id": "guarantee", "label": "Guarantee line" },
    { "type": "header", "content": "Colors (empty = page colors)" },
    { "type": "color", "id": "color_bg", "label": "Section background" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#EEF6F1" },
    { "type": "color", "id": "color_border", "label": "Card border", "default": "#0E6B50" },
    { "type": "color", "id": "color_button", "label": "Button" },
    { "type": "color", "id": "color_button_text", "label": "Button text" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "presets": [ { "name": "Adv · CTA box" } ]
}
{% endschema %}
