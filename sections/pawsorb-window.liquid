{%- assign ss = section.settings -%}
<div class="pawsorb-win{% if ss.image_side == 'right' %} pawsorb-win--flip{% endif %}" style="--pawsorb-win-pt: {{ ss.padding_top }}px; --pawsorb-win-pb: {{ ss.padding_bottom }}px; --pawsorb-win-bg: {{ ss.bg_color }}; --pawsorb-win-fg: {{ ss.text_color }}; --pawsorb-win-accent: {{ ss.accent_color }};">
  <div class="pawsorb-win__inner">
    <div class="pawsorb-win__media">
      <div class="pawsorb-win__frame" style="aspect-ratio: {{ ss.ratio }};">
        <div class="pawsorb-win__fb">
          {% render 'pawsorb-window-art', l_mouth: ss.label_mouth, l_stomach: ss.label_stomach, l_blood: ss.label_blood, l_time: ss.label_time, l_toad: ss.label_toad %}
        </div>
        {%- if ss.image != blank -%}
          {{ ss.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: ss.image_alt, class: 'pawsorb-win__img', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- elsif ss.image_asset != blank -%}
          <img class="pawsorb-win__img" src="{{ ss.image_asset | asset_url }}" alt="{{ ss.image_alt | escape }}" loading="lazy" width="1200" height="900" onerror="this.remove()">
        {%- endif -%}
        {%- if ss.anim_image != blank -%}
          {{ ss.anim_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: ss.image_alt, class: 'pawsorb-win__anim' }}
        {%- elsif ss.anim_asset != blank -%}
          <img class="pawsorb-win__anim" src="{{ ss.anim_asset | asset_url }}" alt="{{ ss.image_alt | escape }}" loading="lazy" decoding="async" width="700" height="700" onerror="this.remove()">
        {%- endif -%}
      </div>
    </div>
    <div class="pawsorb-win__text">
      {%- if ss.heading != blank -%}<h2 class="pawsorb-win__h">{{ ss.heading }}</h2>{%- endif -%}
      <div class="pawsorb-win__body">{{ ss.body }}</div>
      {%- if ss.chip_1 != blank or ss.chip_2 != blank -%}
        <ul class="pawsorb-win__chips">
          {%- if ss.chip_1 != blank -%}<li>{% render 'pawsorb-icon', name: 'drop', size: 16 %}<span>{{ ss.chip_1 }}</span></li>{%- endif -%}
          {%- if ss.chip_2 != blank -%}<li>{% render 'pawsorb-icon', name: 'shield', size: 16 %}<span>{{ ss.chip_2 }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pawsorb-win { padding: var(--pawsorb-win-pt, 64px) 0 var(--pawsorb-win-pb, 64px); background: var(--pawsorb-win-bg, #fff); color: var(--pawsorb-win-fg, #141816); }
  .pawsorb-win__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .pawsorb-win--flip .pawsorb-win__media { order: 2; }
  .pawsorb-win__frame { position: relative; overflow: hidden; border-radius: 14px; background: #F1F6F3; }
  .pawsorb-win__fb { position: absolute; inset: 0; }
  .pawsorb-win__fb svg { width: 100%; height: 100%; display: block; }
  .pawsorb-win__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pawsorb-win__anim { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; background: #F1F6F3; }
  @media (prefers-reduced-motion: reduce) { .pawsorb-win__anim { display: none; } }
  .pawsorb-win__h { margin: 0 0 16px; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-win__body { font-size: 17px; line-height: 1.55; }
  .pawsorb-win__body p { margin: 0 0 12px; }
  .pawsorb-win__body strong { color: var(--pawsorb-win-fg, #141816); }
  .pawsorb-win__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; }
  .pawsorb-win__chips li { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 999px; background: #F1F6F3; border: 1px solid #DCE6E0; font-size: 14px; font-weight: 600; color: #121614; }
  .pawsorb-win__chips .pawsorb-icon { color: var(--pawsorb-win-accent, #12855A); }
  @media screen and (max-width: 749px) {
    .pawsorb-win { padding: calc(var(--pawsorb-win-pt, 64px) * .75) 0 calc(var(--pawsorb-win-pb, 64px) * .75); }
    .pawsorb-win__inner { grid-template-columns: 1fr; gap: 20px; }
    .pawsorb-win--flip .pawsorb-win__media { order: 0; }
    .pawsorb-win__h { font-size: 26px; margin-bottom: 12px; }
    .pawsorb-win__body { font-size: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb mechanism",
  "tag": "section",
  "class": "pawsorb-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Poison gives you a window. PawSorb closes it." },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>What your dog swallows sits in the stomach first. For the next 60 minutes it seeps into the blood. With a toad, you get 15 to 30.</p><p>PawSorb catches it in the stomach, because activated charcoal grabs toxins on contact and holds them. Kaolin clay backs it up and calms the gut. It all leaves in the stool.</p><p><strong>The same charcoal ERs reach for, in your drawer.</strong></p>" },
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "Coconut-shell activated charcoal" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Kaolin clay, the second layer" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "anim_image", "label": "Animation (looping WebP)" },
    { "type": "text", "id": "anim_asset", "label": "Animation theme file", "default": "pawsorb-anim-stomach.webp", "info": "Shown first. Reduced motion or missing file falls back to the image below, then the drawn diagram." },
    { "type": "image_picker", "id": "image", "label": "Image (still)" },
    { "type": "text", "id": "image_asset", "label": "Theme file", "default": "pawsorb-window-diagram.webp", "info": "File in assets/. Until it exists, a drawn diagram with the labels below is shown." },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "Diagram: PawSorb binds poison in the stomach before it reaches the bloodstream" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "default": "4 / 3", "options": [ { "value": "4 / 3", "label": "4:3" }, { "value": "1 / 1", "label": "1:1" }, { "value": "4 / 5", "label": "4:5" } ] },
    { "type": "select", "id": "image_side", "label": "Image side (desktop)", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "label_mouth", "label": "Diagram label: mouth", "default": "Mouth" },
    { "type": "text", "id": "label_stomach", "label": "Diagram label: stomach", "default": "Stomach: PawSorb binds here" },
    { "type": "text", "id": "label_blood", "label": "Diagram label: blood", "default": "Bloodstream" },
    { "type": "text", "id": "label_time", "label": "Diagram label: timeline", "default": "0–60 min until it reaches the blood" },
    { "type": "text", "id": "label_toad", "label": "Diagram label: toad", "default": "Toads: 15–30 min" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "PawSorb mechanism" } ]
}
{% endschema %}
