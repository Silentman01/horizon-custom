{%- assign s = section.settings -%}
<section class="ot-home-compare" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <h2 class="ot-home-compare__heading">{{ s.heading }}</h2>
  <div class="ot-home-compare__table" role="table" aria-label="{{ s.heading | escape }}">
    <div class="ot-home-compare__row ot-home-compare__row--head" role="row">
      <span class="ot-home-compare__label" role="columnheader"><span class="visually-hidden">Feature</span></span>
      <span class="ot-home-compare__brand" role="columnheader">{{ s.brand_name }}</span>
      <span class="ot-home-compare__others" role="columnheader">{{ s.others_name }}</span>
    </div>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="ot-home-compare__row{% if forloop.last %} ot-home-compare__row--last{% endif %}" role="row" {{ block.shopify_attributes }}>
        <span class="ot-home-compare__label" role="cell">{{ b.feature }}</span>
        <span class="ot-home-compare__brand" role="cell">
          {%- if b.ours == 'yes' -%}<span class="ot-home-compare__mark ot-home-compare__mark--yes" aria-label="Yes">&#10003;</span>
          {%- elsif b.ours == 'no' -%}<span class="ot-home-compare__mark ot-home-compare__mark--no" aria-label="No">&#10005;</span>
          {%- else -%}<span class="ot-home-compare__value">{{ b.ours }}</span>{%- endif -%}
        </span>
        <span class="ot-home-compare__others" role="cell">
          {%- if b.theirs == 'yes' -%}<span class="ot-home-compare__mark ot-home-compare__mark--yes" aria-label="Yes">&#10003;</span>
          {%- elsif b.theirs == 'no' -%}<span class="ot-home-compare__mark ot-home-compare__mark--no" aria-label="No">&#10005;</span>
          {%- else -%}<span class="ot-home-compare__value">{{ b.theirs }}</span>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.ot-home-compare { background: var(--ot-bg); padding: var(--ot-pt) 0 var(--ot-pb); font-family: var(--ot-font); color: #121212; }
.ot-home-compare__heading { margin: 0 0 28px; padding-inline: 16px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 34px; line-height: 1.15; color: var(--ot-green); }
.ot-home-compare__table { max-width: 960px; margin: 0 auto; padding-inline: 12px; }
.ot-home-compare__row { display: grid; grid-template-columns: 1.3fr 0.8fr 1fr; align-items: center; min-height: 52px; border-bottom: 1px solid #5B7265; }
.ot-home-compare__row--head { min-height: 56px; border-bottom: 0; }
.ot-home-compare__label { padding: 8px 8px 8px 2px; font-family: 'Inter', var(--ot-font); font-weight: 500; font-size: 13px; line-height: 1.3; }
.ot-home-compare__brand { align-self: stretch; display: flex; align-items: center; justify-content: center; text-align: center; background: #F9F9F4; border-left: 1px solid var(--ot-green); border-right: 1px solid var(--ot-green); font-weight: 700; font-size: 13px; letter-spacing: 0.04em; color: var(--ot-green); }
.ot-home-compare__row--head .ot-home-compare__brand { border-top: 1px solid var(--ot-green); border-radius: 20px 20px 0 0; font-family: var(--ot-font-heading); font-size: 15px; }
.ot-home-compare__row--last { border-bottom: 0; }
.ot-home-compare__row--last .ot-home-compare__brand { border-bottom: 1px solid var(--ot-green); border-radius: 0 0 20px 20px; }
.ot-home-compare__others { display: flex; align-items: center; justify-content: center; text-align: center; padding: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
.ot-home-compare__row:not(.ot-home-compare__row--head) .ot-home-compare__others { text-transform: none; letter-spacing: 0; font-style: italic; }
.ot-home-compare__mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; color: #fff; font-size: 15px; font-weight: 700; font-style: normal; }
.ot-home-compare__mark--yes { background: var(--ot-leaf); }
.ot-home-compare__mark--no { background: #808080; }
.ot-home-compare__value { font-weight: 700; font-style: normal; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
@media screen and (min-width: 750px) {
  .ot-home-compare__heading { font-size: 46px; }
  .ot-home-compare__row { grid-template-columns: 300px 150px 264px; justify-content: center; min-height: 59px; }
  .ot-home-compare__label { font-size: 15px; }
  .ot-home-compare__mark { width: 32px; height: 32px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's comparison",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How We Stack Up" },
    { "type": "text", "id": "brand_name", "label": "Brand column title", "default": "OLD TOM'S" },
    { "type": "text", "id": "others_name", "label": "Other column title", "default": "OTHER SOLUTIONS" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Natural & ZERO Chemicals or Toxins" },
        { "type": "text", "id": "ours", "label": "Old Tom's", "default": "yes", "info": "Type yes / no for a tick / cross, or any text." },
        { "type": "text", "id": "theirs", "label": "Others", "default": "no", "info": "Type yes / no for a tick / cross, or any text." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Old Tom's comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Natural & ZERO Chemicals or Toxins", "ours": "yes", "theirs": "no" } },
        { "type": "row", "settings": { "feature": "Works Within 72 Hours", "ours": "yes", "theirs": "no" } },
        { "type": "row", "settings": { "feature": "Safe for Kids, Pets & Livestock", "ours": "yes", "theirs": "no" } },
        { "type": "row", "settings": { "feature": "No Clean-Up / No Bodies", "ours": "yes", "theirs": "no" } },
        { "type": "row", "settings": { "feature": "90-Day Cover Per Pouch", "ours": "yes", "theirs": "no" } },
        { "type": "row", "settings": { "feature": "Cost Per Day of Protection", "ours": "£0.22", "theirs": "£0.48 to £1.95/day" } },
        { "type": "row", "settings": { "feature": "Zero Tolerance Build-Up", "ours": "yes", "theirs": "no" } }
      ]
    }
  ]
}
{% endschema %}
