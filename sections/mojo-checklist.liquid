{%- assign s = section.settings -%}
<section class="mojo-ck" style="{% render 'mojo-vars' %}--mojo-pt:{{ s.padding_top }}px;--mojo-pb:{{ s.padding_bottom }}px;--mojo-ptm:{{ s.padding_top_m }}px;--mojo-pbm:{{ s.padding_bottom_m }}px;--mojo-tc:{{ s.text_color }};--mojo-hs:{{ s.heading_size }}px;--mojo-hsm:{{ s.heading_size_m }}px;--mojo-ck-bg:{{ s.bg_color }};--mojo-ck-card:{{ s.card_bg }};--mojo-ck-cols:{{ s.columns }};">
  <div class="mojo-ck__card">
    {%- if s.heading != blank -%}<h2 class="mojo-ck__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="mojo-ck__text">{{ s.text }}</div>{%- endif -%}
    <ul class="mojo-ck__list" role="list">
      {%- for block in section.blocks -%}
        <li class="mojo-ck__li" {{ block.shopify_attributes }}><span class="mojo-ck__tick">{% render 'mojo-icon', name: 'check', size: 20 %}</span><span>{{ block.settings.text }}</span></li>
      {%- endfor -%}
    </ul>
    {% render 'mojo-cta', label: s.button_label, target: s.button_target, bg: s.button_bg, fg: s.button_fg, show: s.show_assurance_row, a1: s.assurance_1, a2: s.assurance_2, align: 'center' %}
  </div>
</section>

{% stylesheet %}
.mojo-ck { padding: var(--mojo-ptm) 0 var(--mojo-pbm); font-family: var(--mojo-font); color: var(--mojo-tc); }
@media screen and (min-width: 750px) { .mojo-ck { padding: var(--mojo-pt) 0 var(--mojo-pb); } }

.mojo-ck { background: var(--mojo-ck-bg); }
.mojo-ck__card { max-width: 1200px; margin: 0 auto; padding: 32px 20px; background: var(--mojo-ck-card); text-align: center; box-sizing: border-box; }
.mojo-ck__heading { margin: 0 auto 14px; max-width: 720px; font-family: var(--mojo-font-heading); font-weight: 600; font-size: var(--mojo-hsm); line-height: 1.2; }
.mojo-ck__text { margin: 0 auto 22px; max-width: 700px; font-size: 14px; line-height: 1.6; color: var(--mojo-muted); }
.mojo-ck__text p { margin: 0; }
.mojo-ck__list { list-style: none; margin: 0 auto 28px; padding: 0; display: grid; grid-template-columns: 1fr; gap: 12px; max-width: 900px; text-align: left; }
.mojo-ck__li { display: flex; align-items: center; gap: 10px; font-size: 14px; }
.mojo-ck__tick { display: inline-flex; flex: none; }
@media screen and (min-width: 750px) {
  .mojo-ck__card { padding: 48px 40px; }
  .mojo-ck__heading { font-size: var(--mojo-hs); }
  .mojo-ck__list { grid-template-columns: repeat(var(--mojo-ck-cols), 1fr); gap: 16px 24px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo checklist card",
  "tag": "section",
  "class": "mojo-section",
  "blocks": [
    {
      "type": "check",
      "name": "Check",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Retains Shape"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keep that fresh-from-the-pack feel, wash after wash"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Remember slipping into a brand-new pair of boxers? A few washes later, the magic fades, right? Not anymore.</p>"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "default": "3",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "1",
          "label": "1"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#E9D7CF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY IT RISK-FREE – BLACK FRIDAY, UP TO 50% OFF"
    },
    {
      "type": "text",
      "id": "button_target",
      "label": "Button link (scrolls to the buy box by default)",
      "default": "#mojo-buybox"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#6B1E2E"
    },
    {
      "type": "color",
      "id": "button_fg",
      "label": "Button text colour",
      "default": "#FAF6F1"
    },
    {
      "type": "checkbox",
      "id": "show_assurance_row",
      "label": "Show the assurance row under the button",
      "default": true
    },
    {
      "type": "text",
      "id": "assurance_1",
      "label": "Assurance 1",
      "default": "45-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "assurance_2",
      "label": "Assurance 2",
      "default": "Free returns, NO QUESTIONS ASKED"
    },
    {
      "type": "header",
      "content": "Typography and colours"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "default": 34,
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "label": "Heading size (mobile)",
      "default": 24,
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#1C1C1C"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "default": 48,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "default": 48,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "label": "Top padding (mobile)",
      "default": 24,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "label": "Bottom padding (mobile)",
      "default": 24,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Mojo checklist card",
      "blocks": [
        {
          "type": "check"
        },
        {
          "type": "check"
        },
        {
          "type": "check"
        },
        {
          "type": "check"
        },
        {
          "type": "check"
        },
        {
          "type": "check"
        },
        {
          "type": "check"
        }
      ]
    }
  ]
}
{% endschema %}
