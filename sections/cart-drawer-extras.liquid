{%- comment -%}
  Cart drawer section (header group). Renders the cart drawer so its extras (bars, price details, badges,
  payment icons) are edited from the theme editor. layout/theme.liquid only renders a plain drawer when this
  section is missing.
{%- endcomment -%}
{% render 'cart-drawer', render_wrapper: false, section_id: section.id, cx: section.settings %}

{%- if request.design_mode -%}
  <script>
    (() => {
      const id = {{ section.id | json }};
      const drawer = () => document.getElementById('cart-drawer');
      const mine = (e) => e.detail && e.detail.sectionId === id;
      document.addEventListener('shopify:section:select', (e) => mine(e) && drawer()?.open?.());
      document.addEventListener('shopify:section:load', (e) => mine(e) && drawer()?.open?.());
      document.addEventListener('shopify:section:deselect', (e) => mine(e) && drawer()?.close?.());
    })();
  </script>
{%- endif -%}

{% schema %}
