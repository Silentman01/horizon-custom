{%- assign href = section.settings.link | default: section.settings.product.url | default: routes.all_products_collection_url -%}
{%- assign product = section.settings.product -%}
<section class="au-h au-h--w" id="featured" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-h-wrap">
    <div class="au-h-head ">
  {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {% render 'aurea-title', text: section.settings.heading, class: 'au-h-h2' %}
</div>
    <div class="au-h-feat">
      <aurea-home-gallery class="au-h-feat__gal">
        <div class="au-h-feat__main">
          {%- if section.settings.badge != blank -%}<span class="au-h-feat__badge">{{ section.settings.badge }}</span>{%- endif -%}
          {%- if product.images.size > 0 -%}
            {%- for im in product.images limit: 6 -%}
              <div class="au-h-feat__slide" {% unless forloop.first %}hidden{% endunless %}>{% render 'aurea-media', image: im, ratio: '1 / 1', radius: 6, sizes: '(min-width: 990px) 560px, 100vw', eager: forloop.first %}</div>
            {%- endfor -%}
          {%- else -%}
            <div class="au-h-feat__slide">{% render 'aurea-media', ratio: '1 / 1', radius: 6, label: 'Product image 1:1 (selected product gallery 1)' %}</div>
          {%- endif -%}
        </div>
        <div class="au-h-feat__thumbs">
          {%- if product.images.size > 0 -%}
            {%- for im in product.images limit: 6 -%}
              <button type="button" class="au-h-feat__thumb{% if forloop.first %} is-active{% endif %}" aria-label="Image {{ forloop.index }}">{{ im | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '120px', widths: '120, 240', alt: '' }}</button>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}<span class="au-h-feat__thumb{% if forloop.first %} is-active{% endif %}"><span class="au-h-ph">{{ i }}</span></span>{%- endfor -%}
          {%- endif -%}
        </div>
      </aurea-home-gallery>
      <div class="au-h-feat__info">
        <p class="au-h-feat__rate"><span class="au-h-tp" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg></span><span>{{ section.settings.rating_text }}</span></p>
        <h3 class="au-h-feat__title">{{ product.title | default: section.settings.fallback_title }}</h3>
        {%- if product != blank -%}
          <p class="au-h-feat__price"><strong>{{ product.price | money }}</strong>
            {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- if section.settings.save_label != blank -%}<span class="au-h-feat__save">{{ section.settings.save_label }}</span>{%- endif -%}{%- endif -%}
          </p>
        {%- endif -%}
        <p class="au-h-feat__desc">{{ section.settings.description }}</p>
        <ul class="au-h-feat__list">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span class="au-h-feat__disc"><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>{{ block.settings.text }}</li>{%- endfor -%}
        </ul>
        {%- if section.settings.offer_title != blank -%}
          <div class="au-h-feat__offer"><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8c-2.5 0-4-1-4-2.5S9.5 3 11 4l1 4zM12 8c2.5 0 4-1 4-2.5S14.5 3 13 4z"/></svg><div><strong>{{ section.settings.offer_title }}</strong><span>{{ section.settings.offer_text }}</span></div></div>
        {%- endif -%}
        <a class="au-h-btn" href="{{ product.url | default: href }}">{{ section.settings.cta_label }}</a>
        <ul class="au-h-feat__assure">
          <li><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>{{ section.settings.assure_1 }}</li><li><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.assure_2 }}</li><li><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{{ section.settings.assure_3 }}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
{% javascript %}
  if (!customElements.get('aurea-home-gallery')) {
    customElements.define('aurea-home-gallery', class extends HTMLElement {
      connectedCallback() {
        const slides = this.querySelectorAll('.au-h-feat__slide');
        const thumbs = this.querySelectorAll('.au-h-feat__thumb');
        thumbs.forEach((t, i) => t.addEventListener('click', () => {
          if (!slides[i]) return;
          slides.forEach((s, j) => { s.hidden = j !== i; });
          thumbs.forEach((x, j) => x.classList.toggle('is-active', j === i));
        }));
      }
    });
  }
{% endjavascript %}
{% stylesheet %}
  .au-h { padding: 60px 0; font-family: var(--au-body); color: #2A2E29; background: #fff; }
  .au-h *, .au-h *::before, .au-h *::after { box-sizing: border-box; }
  .au-h--parch { background: var(--au-parchment); }
  .au-h--pine { background: var(--au-pine); }
  .au-h--dark { background: var(--au-espresso); }
  .au-h.au-h--dark, .au-h.au-h--pine, .au-h.au-h-hero { color: #fff; }
  .au-h-wrap { width: calc(100% - 32px); max-width: 1200px; margin-inline: auto; }
  .au-h-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .au-h-h2 { font-size: 31px; line-height: 1.08; }
  .au-h-sub { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.6; color: #4A5249; }
  .au-h-i { width: 1em; height: 1em; flex: none; }
  .au-h .au-icon { width: 1em; height: 1em; flex: none; }
  .au-h-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 0 32px; border-radius: 999px; background: var(--au-pine); color: var(--au-parchment); font-family: var(--au-body); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .au-h-btn:hover { filter: brightness(1.12); }
  .au-h-btn:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 3px; }
  .au-h-btn .au-h-i { font-size: 18px; }
  .au-h-btn--gold { background: var(--au-gold); color: #1E1A10; }
  .au-h-btn--ghost { background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.55); }
  .au-h-dark .au-title, .au-h--dark .au-title, .au-h--pine .au-title { color: #fff; }
  .au-h-dark .au-title em, .au-h--dark .au-title em, .au-h--pine .au-title em { color: #DDB866; }
  .au-h--dark .au-eyebrow, .au-h--pine .au-eyebrow { color: #DDB866; }
  .au-h-tp { display: inline-flex; gap: 2px; }
  .au-h-tp svg { width: 20px; height: 20px; padding: 3px; background: #00B67A; }
  .au-h-ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #f1f1f1, #dcdcdc); color: #6b6b6b; font-size: 12px; text-align: center; }
  @media (min-width: 750px) { .au-h { padding: 72px 0; } .au-h-wrap { width: calc(100% - 48px); } .au-h-head { margin-bottom: 56px; } .au-h-h2 { font-size: 36px; } .au-h-btn { width: auto; } }
  @media (min-width: 990px) { .au-h { padding: 96px 0; } .au-h-h2 { font-size: 44px; } }

  .au-h-feat { display: grid; gap: 40px; align-items: center; }
  .au-h-feat__main { position: relative; }
  .au-h-feat__badge { position: absolute; z-index: 2; top: 16px; left: 16px; padding: 7px 14px; border-radius: 999px; background: var(--au-pine); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .au-h-feat__thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-top: 10px; }
  .au-h-feat__thumb { position: relative; display: block; aspect-ratio: 1; padding: 0; overflow: hidden; border: 2px solid transparent; border-radius: 6px; background: #ececec; cursor: pointer; }
  .au-h-feat__thumb.is-active { border-color: var(--au-gold); }
  .au-h-feat__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .au-h-feat__rate { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: 14px; }
  .au-h-feat__title { margin: 0; font-family: var(--au-heading); font-size: 31px; font-weight: 600; line-height: 1.1; color: var(--au-pine); }
  .au-h-feat__price { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 14px 0 0; }
  .au-h-feat__price strong { font-size: 30px; font-weight: 700; color: var(--au-pine); }
  .au-h-feat__price s { font-size: 20px; color: #6E6E73; }
  .au-h-feat__save { padding: 5px 10px; border-radius: 6px; background: #F3E6C6; color: #7A5A14; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .au-h-feat__desc { margin: 16px 0 20px; font-size: 17px; line-height: 1.65; color: #4A5249; }
  .au-h-feat__list { display: grid; gap: 12px; margin: 0 0 22px; padding: 0; list-style: none; }
  .au-h-feat__list li { display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 500; }
  .au-h-feat__disc { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 50%; background: #EAF0E6; color: var(--au-pine); }
  .au-h-feat__disc .au-h-i { font-size: 16px; }
  .au-h-feat__offer { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; padding: 16px 18px; border: 1px dashed var(--au-gold); border-radius: 14px; background: linear-gradient(135deg, var(--au-parchment), #F3E6C6); }
  .au-h-feat__offer > .au-h-i { font-size: 28px; color: var(--au-gold); }
  .au-h-feat__offer strong { display: block; font-size: 16px; }
  .au-h-feat__offer span { font-size: 14px; color: #4A5249; }
  .au-h-feat__assure { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 16px; margin: 20px 0 0; padding: 0; list-style: none; font-size: 13px; color: #4A5249; }
  .au-h-feat__assure li { display: inline-flex; align-items: center; gap: 6px; }
  .au-h-feat__assure .au-h-i { font-size: 18px; color: var(--au-gold); }
  @media (min-width: 750px) { .au-h-feat__thumbs { gap: 10px; } .au-h-feat__list { grid-template-columns: 1fr 1fr; } .au-h-feat__title { font-size: 40px; } .au-h-feat__thumb { aspect-ratio: 1; } }
  @media (min-width: 990px) { .au-h-feat { grid-template-columns: 1.05fr 1fr; gap: 64px; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea home featured",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product (title, price, compare-at and first 6 images)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our bestseller"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (*word* = gold italic)",
      "default": "Meet the *Prosperity Bracelet*"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Image badge",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Excellent 4.8 out of 5"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Title shown when no product is selected",
      "default": "Aurea® Prosperity Bracelet"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Sale tag (shown only if compare-at price is higher)",
      "default": "Save 20%"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Three stones, one daily intention. Put it on each morning as a small reminder of what you are calling in: more flow, more luck, more ease with money."
    },
    {
      "type": "text",
      "id": "offer_title",
      "label": "Offer box title",
      "default": "Buy 1, Get 1 FREE"
    },
    {
      "type": "textarea",
      "id": "offer_text",
      "label": "Offer box text",
      "default": "Pick Buy 1 Get 1 and your second bracelet is on us. One to keep, one to gift."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link (empty = selected product, then all products)"
    },
    {
      "type": "text",
      "id": "assure_1",
      "label": "Assurance 1",
      "default": "Free express shipping"
    },
    {
      "type": "text",
      "id": "assure_2",
      "label": "Assurance 2",
      "default": "30-day money-back"
    },
    {
      "type": "text",
      "id": "assure_3",
      "label": "Assurance 3",
      "default": "Secure checkout"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Attracts abundance every day"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea home featured",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "text": "Attracts abundance every day"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Cleansed and moon-charged"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Invites luck and opportunity"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Genuine natural stones"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "One-size stretch fit"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Made for everyday wear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
