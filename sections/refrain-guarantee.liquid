{% render 'refrain-fonts' %}
{%- assign has_img = false -%}
{%- if section.settings.image != blank or section.settings.image_asset != blank -%}{%- assign has_img = true -%}{%- endif -%}
<section class="rf-gar" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-gar__inner{% if has_img %} has-img{% endif %}">
    <div class="rf-gar__main">
      <div class="rf-gar__badge"><span>{{ section.settings.badge_text | escape }}</span></div>
      {% render 'refrain-title', text: section.settings.heading, tag: 'h2', dark: true %}
      {%- if section.settings.text != blank -%}<div class="rf-gar__text">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="rf-gar__points">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="rf-gar__chk">{% render 'refrain-icon', name: 'check' %}</span><span>{{ block.settings.text | escape }}</span></li>
        {%- endfor -%}
      </ul>
    </div>
    {%- if has_img -%}
      <div class="rf-gar__img">{% render 'refrain-media', image: section.settings.image, asset: section.settings.image_asset, ratio: '4 / 5', label: 'Photo : personne émue qui écoute une chanson au casque', radius: 22, sizes: '(min-width: 990px) 440px, 90vw' %}</div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
  .rf-gar { font-family: var(--rf-sans); background: var(--rf-ink); padding: 64px 0; color: #fff; }
  .rf-gar__inner { max-width: 1160px; margin: 0 auto; padding: 0 16px; display: grid; gap: 36px; }
  .rf-gar__badge { width: 132px; height: 132px; border-radius: 50%; background: var(--rf-lime); color: var(--rf-ink); display: grid; place-items: center; text-align: center; padding: 18px; margin-bottom: 24px; transform: rotate(-8deg); box-shadow: 0 12px 30px rgb(0 0 0 / .25); }
  .rf-gar__badge span { font-weight: 800; font-size: 15px; line-height: 1.15; letter-spacing: -0.03em; }
  .rf-gar__text { margin-top: 16px; font-size: 17px; line-height: 1.6; color: var(--rf-lilac); max-width: 560px; }
  .rf-gar__text p { margin: 0 0 .8em; }
  .rf-gar__text strong { color: #fff; }
  .rf-gar__points { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 14px; }
  .rf-gar__points li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.45; font-weight: 600; color: #fff; }
  .rf-gar__chk { flex: none; width: 26px; height: 26px; border-radius: 50%; background: var(--rf-lime); color: var(--rf-ink); display: grid; place-items: center; }
  .rf-gar__chk svg { width: 15px; height: 15px; stroke-width: 2.8; }
  @media (min-width: 750px) {
    .rf-gar { padding: 104px 0; }
    .rf-gar__inner { padding: 0 24px; }
    .rf-gar__badge { width: 156px; height: 156px; }
    .rf-gar__badge span { font-size: 18px; }
  }
  @media (min-width: 990px) {
    .rf-gar__inner.has-img { grid-template-columns: 1fr 440px; align-items: center; gap: 72px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Refrain · Guarantee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Écoutez avant de payer" },
    { "type": "text", "id": "heading", "label": "Heading (wrap one word in *asterisks*)", "default": "Vous ne payez que si vous êtes *conquis*" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Vous découvrez un extrait de votre chanson avant de régler quoi que ce soit. Elle ne vous touche pas ? Vous ne payez rien.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Theme asset file name", "default": "" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Un extrait à écouter avant de payer" }] }
  ],
  "presets": [
    {
      "name": "Refrain · Guarantee",
      "blocks": [
        { "type": "point", "settings": { "text": "Un extrait à écouter avant de payer" } },
        { "type": "point", "settings": { "text": "Une chanson écrite rien que pour vous" } },
        { "type": "point", "settings": { "text": "Un paiement sécurisé, sans engagement" } }
      ]
    }
  ]
}
{% endschema %}
