{%- render 'oralys-v2-base' -%}
{%- assign s = section.settings -%}
<section class="ov2 ov2-sec ov2-ben" style="--ov2-bg:{{ s.c_bg }}">
  <div class="ov2-in">
    <h2 class="ov2-h2 ov2-center">{{ s.heading }}</h2>
    <ul class="ov2-ben__grid" role="list">
      {%- for n in (1..4) -%}
        {%- liquid
          assign ki = 'image_' | append: n
          assign ka = 'asset_' | append: n
          assign kt = 'title_' | append: n
          assign kb = 'body_' | append: n
          if s[kt] == blank
            continue
          endif
        -%}
        <li class="ov2-ben__card">
          <div class="ov2-ben__media">{% render 'oralys-pdp-media', image: s[ki], asset: s[ka], alt: s[kt], class: 'ov2-ben__img', width: 800, height: 600 %}</div>
          <div class="ov2-ben__txt"><h3>{{ s[kt] }}</h3><p>{{ s[kb] }}</p></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.ov2-ben__grid{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.ov2-ben__card{display:flex;flex-direction:column;border:1px solid #DCE5E0;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.05)}
.ov2-ben__media{aspect-ratio:4/3;background:#EEF6F1;overflow:hidden}
.ov2-ben__img{width:100%;height:100%;object-fit:cover;display:block}
.ov2-ben__txt{padding:16px 18px 20px;text-align:center}
.ov2-ben__txt h3{margin:0 0 6px;font-size:19px;font-weight:700;line-height:1.3;color:#17221E}
.ov2-ben__txt p{font-size:16px;line-height:1.5;color:#5C6863}
@media (max-width:749px){
  .ov2-ben__grid{gap:12px}
  .ov2-ben__card{display:grid;grid-template-columns:38% 1fr}
  .ov2-ben__media{aspect-ratio:auto;min-height:100%}
  .ov2-ben__txt{padding:14px 14px 16px;text-align:left}
  .ov2-ben__txt h3{font-size:18px}
}
@media (min-width:750px){.ov2-ben__grid{grid-template-columns:1fr 1fr;gap:20px}}
@media (min-width:1100px){.ov2-ben__grid{grid-template-columns:repeat(4,1fr)}}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : bénéfices",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que la crème n'a jamais su faire" },
    { "type": "header", "content": "Carte 1" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "asset_1", "label": "Image : fichier du thème", "default": "oralys-pp-eating-baguette-family-table.webp" },
    { "type": "text", "id": "title_1", "label": "Titre", "default": "Tient 2 à 3 jours" },
    { "type": "textarea", "id": "body_1", "label": "Texte", "default": "Une seule pose le matin, et vous n'y pensez plus. La salive ne le dissout pas : pas de tube dans le sac, pas de retouche en cachette après le dessert." },
    { "type": "header", "content": "Carte 2" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "asset_2", "label": "Image : fichier du thème", "default": "oralys-pp-eating-apple-crunch.webp" },
    { "type": "text", "id": "title_2", "label": "Titre", "default": "Même le dentier du bas" },
    { "type": "textarea", "id": "body_2", "label": "Texte", "default": "En bas, il n'y a pas de palais pour faire ventouse : c'est là que le vide gêne le plus. Oralys le comble, et le bas reste en place quand vous croquez." },
    { "type": "header", "content": "Carte 3" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "asset_3", "label": "Image : fichier du thème", "default": "oralys-pdp-packshot-tube.webp" },
    { "type": "text", "id": "title_3", "label": "Titre", "default": "Zéro zinc, zéro colle" },
    { "type": "textarea", "id": "body_3", "label": "Texte", "default": "Rien qui fond dans la bouche, aucun goût dans votre café du matin. Vous le portez tous les jours sans vous demander ce que vous avalez." },
    { "type": "header", "content": "Carte 4" },
    { "type": "image_picker", "id": "image_4", "label": "Image" },
    { "type": "text", "id": "asset_4", "label": "Image : fichier du thème", "default": "oralys-pdp-peel-out.webp" },
    { "type": "text", "id": "title_4", "label": "Titre", "default": "Se retire d'un seul morceau" },
    { "type": "textarea", "id": "body_4", "label": "Texte", "default": "Le soir, il se décolle d'un geste. Fini les minutes à gratter la pâte au-dessus du lavabo avant de nettoyer votre appareil." },
    { "type": "color", "id": "c_bg", "label": "Fond", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Oralys v2 : bénéfices" }]
}
{% endschema %}
