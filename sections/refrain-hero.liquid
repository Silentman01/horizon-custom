{% render 'refrain-fonts' %}
{%- liquid
  assign s = section.settings
  assign has_mobile = false
  if s.mobile_image != blank or s.mobile_image_asset != blank
    assign has_mobile = true
  endif
  assign dark = false
  if s.background == 'ink'
    assign dark = true
  endif
-%}
<section class="rf-hero" data-bg="{{ s.background }}" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-hero__inner">
    <div class="rf-hero__copy">
      {%- if s.eyebrow != blank -%}<p class="rf-eyebrow rf-hero__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {% render 'refrain-title', text: s.heading, tag: 'h1', class: 'rf-hero__h', dark: dark %}
      {%- if s.sub != blank -%}<p class="rf-sub rf-hero__sub">{{ s.sub }}</p>{%- endif -%}
      <div class="rf-hero__actions">
        {%- if s.button_label != blank -%}
          <a class="rf-btn{% if dark %} rf-btn--on-dark{% endif %}" href="{{ s.button_link | default: '/products/chanson-personnalisee' }}">{{ s.button_label }} {% render 'refrain-icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- if s.secondary_label != blank -%}
          <a class="rf-hero__sec" href="{{ s.secondary_link | default: '#examples' }}">{% render 'refrain-icon', name: 'play' %}<span>{{ s.secondary_label }}</span></a>
        {%- endif -%}
      </div>
      {%- if s.trust != blank -%}<p class="rf-hero__trust">{% render 'refrain-icon', name: 'star' %}<span>{{ s.trust }}</span></p>{%- endif -%}
    </div>
    <div class="rf-hero__visual">
      <div class="rf-hero__img{% if has_mobile %} rf-hero__img--desk{% endif %}">
        {% render 'refrain-media', image: s.image, asset: s.image_asset, ratio: '4 / 5', label: 'Photo: a person smiling with headphones, moved while listening to a song written just for them (warm, natural light)', radius: 28, sizes: '(min-width: 990px) 560px, 100vw', eager: true %}
      </div>
      {%- if has_mobile -%}
        <div class="rf-hero__img rf-hero__img--mob">
          {% render 'refrain-media', image: s.mobile_image, asset: s.mobile_image_asset, ratio: '4 / 5', label: 'Mobile photo: a person smiling with headphones, moved while listening to a personalised song', radius: 28, sizes: '100vw', eager: true %}
        </div>
      {%- endif -%}
      {%- if s.chip_title != blank -%}
        <div class="rf-hero__chip" aria-hidden="true">
          <span class="rf-hero__dot">{% render 'refrain-icon', name: 'play' %}</span>
          <span class="rf-hero__chip-t">{{ s.chip_title }}</span>
          <span class="rf-hero__wave"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% stylesheet %}
  .rf-hero { padding: 28px 16px 44px; background: var(--rf-lilac); font-family: var(--rf-sans); }
  .rf-hero[data-bg='page'] { background: var(--rf-page); }
  .rf-hero[data-bg='ink'] { background: var(--rf-ink); }
  .rf-hero[data-bg='ink'] .rf-sub, .rf-hero[data-bg='ink'] .rf-eyebrow, .rf-hero[data-bg='ink'] .rf-hero__trust { color: #fff; }
  .rf-hero[data-bg='ink'] .rf-hero__sec { color: #fff; }
  .rf-hero__inner { max-width: 1160px; margin: 0 auto; display: grid; gap: 32px; }
  .rf-hero__h { font-size: clamp(34px, 9vw, 64px); }
  .rf-hero__sub { max-width: 520px; }
  .rf-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 28px; }
  .rf-hero__actions .rf-btn { width: 100%; }
  .rf-hero__actions .rf-icon { width: 20px; height: 20px; }
  .rf-hero__sec { display: inline-flex; align-items: center; gap: 10px; color: var(--rf-ink); font-weight: 700; font-size: 15px; text-decoration: none; }
  .rf-hero__sec .rf-icon { width: 34px; height: 34px; padding: 9px; border-radius: 50%; background: var(--rf-ink); color: var(--rf-lime); }
  .rf-hero__sec span { text-decoration: underline; text-underline-offset: 4px; }
  .rf-hero .rf-media > img { object-position: 78% 30%; }
  .rf-hero__trust { display: flex; align-items: center; gap: 8px; margin: 22px 0 0; font-size: 14px; font-weight: 600; color: var(--rf-ink-soft); }
  .rf-hero__trust .rf-icon { width: 16px; height: 16px; flex: none; color: var(--rf-ink); }
  .rf-hero[data-bg='ink'] .rf-hero__trust .rf-icon { color: var(--rf-lime); }
  .rf-hero__visual { position: relative; }
  .rf-hero__img .rf-media { box-shadow: 0 24px 60px rgb(30 15 74 / .22); }
  .rf-hero__img--mob { display: block; }
  .rf-hero__img--desk { display: none; }
  .rf-hero__chip { position: absolute; left: 14px; bottom: 14px; display: flex; align-items: center; gap: 10px; max-width: calc(100% - 28px); padding: 8px 16px 8px 8px; border-radius: 999px; background: var(--rf-ink); color: #fff; box-shadow: 0 12px 30px rgb(30 15 74 / .35); }
  .rf-hero__dot { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--rf-lime); color: var(--rf-ink); }
  .rf-hero__dot .rf-icon { width: 16px; height: 16px; }
  .rf-hero__chip-t { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rf-hero__wave { display: flex; align-items: center; gap: 3px; height: 20px; }
  .rf-hero__wave i { display: block; width: 3px; height: 100%; border-radius: 2px; background: var(--rf-lime); transform-origin: center; animation: rf-wave 1.1s ease-in-out infinite; }
  .rf-hero__wave i:nth-child(2) { animation-delay: .15s; }
  .rf-hero__wave i:nth-child(3) { animation-delay: .3s; }
  .rf-hero__wave i:nth-child(4) { animation-delay: .45s; }
  .rf-hero__wave i:nth-child(5) { animation-delay: .6s; }
  @keyframes rf-wave { 0%, 100% { transform: scaleY(.25); } 50% { transform: scaleY(1); } }
  @media (min-width: 750px) {
    .rf-hero__actions .rf-btn { width: auto; }
  }
  @media (min-width: 990px) {
    .rf-hero { padding: 72px 24px; }
    .rf-hero__inner { grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }
    .rf-hero__img--desk { display: block; }
    .rf-hero__img--mob { display: none; }
    .rf-hero__chip { left: 22px; bottom: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .rf-hero__wave i { animation: none; transform: scaleY(.6); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Refrain · Hero",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "lilac", "options": [ { "value": "page", "label": "Page" }, { "value": "lilac", "label": "Lilac" }, { "value": "ink", "label": "Ink" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Une chanson rien que pour eux" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = italic emphasis)", "default": "Offrez une chanson qui porte leur *prénom*" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Racontez-nous leur histoire, nous composons une chanson unique, livrée en quelques minutes." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Créer ma chanson" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Écouter des exemples" },
    { "type": "text", "id": "secondary_link", "label": "Secondary link (anchor or URL)", "default": "#examples" },
    { "type": "text", "id": "trust", "label": "Trust line", "default": "Plus de 1 000 chansons offertes" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop, 4:5)" },
    { "type": "text", "id": "image_asset", "label": "Image theme asset file name (used if no upload)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (4:5, optional)" },
    { "type": "text", "id": "mobile_image_asset", "label": "Mobile image theme asset file name" },
    { "type": "text", "id": "chip_title", "label": "Player chip title", "default": "Pour Camille · Anniversaire" }
  ],
  "presets": [ { "name": "Refrain · Hero" } ]
}
{% endschema %}
