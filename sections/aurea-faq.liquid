<section class="au-faq" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-faq__head">
    {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {% render 'aurea-title', text: section.settings.heading, class: 'au-faq__h' %}
  </div>
  <div class="au-faq__list">
    {%- for block in section.blocks -%}
      <details class="au-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary class="au-faq__q"><span>{{ block.settings.question }}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="au-faq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
  .au-faq { max-width: 720px; margin: 0 auto; padding: 32px 16px; background: var(--au-bg); }
  .au-faq__head { margin-bottom: 14px; text-align: center; }
  .au-faq__h { font-weight: 500; font-size: clamp(26px, 4vw, 36px); }
  .au-faq__item { padding: 0 4px; border-bottom: 0.5px solid rgb(0 0 0 / 0.2); }
  .au-faq__item:first-child { border-top: 0.5px solid rgb(0 0 0 / 0.2); }
  .au-faq__q { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0; font-size: 17px; font-weight: 500; cursor: pointer; list-style: none; }
  .au-faq__q::-webkit-details-marker { display: none; }
  .au-faq__q svg { flex: none; color: var(--au-gold); transition: transform 0.2s; }
  .au-faq__item[open] .au-faq__q svg { transform: rotate(180deg); }
  .au-faq__q:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 2px; }
  .au-faq__a { padding: 0 0 18px; font-size: 15px; line-height: 1.6; color: rgb(from var(--au-ink) r g b / 0.85); }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "Frequently asked *questions*" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How soon will I feel something?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Many people feel a gentle shift in the first few days of daily wear." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How soon will I feel something?", "answer": "Many people feel a gentle shift in the first few days of daily wear. Keep it touching your skin for the best results." } },
        { "type": "question", "settings": { "question": "Will it fit my wrist?", "answer": "Yes — the stretch cord is one size and fits most wrists comfortably. No clasp needed." } },
        { "type": "question", "settings": { "question": "How do I care for it?", "answer": "Keep it dry when you can and wipe the stones gently. Skip harsh chemicals to protect their natural energy." } },
        { "type": "question", "settings": { "question": "What's your return policy?", "answer": "Our 30-day money-back guarantee has you covered. If it's not for you, send it back for a full refund." } }
      ]
    }
  ]
}
{% endschema %}
