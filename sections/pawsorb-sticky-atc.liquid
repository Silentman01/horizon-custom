{%- liquid
  assign ss = section.settings
  assign p = product | default: closest.product
  assign title = ss.title | default: p.title
-%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<pawsorb-sticky-atc
  class="pawsorb-sa{% unless ss.show_desktop %} pawsorb-sa--no-desk{% endunless %}{% unless ss.show_mobile %} pawsorb-sa--no-mob{% endunless %}"
  style="--pawsorb-sa-accent: {{ ss.accent_color }}; --pawsorb-sa-bg: {{ ss.bg_color }}; --pawsorb-sa-fg: {{ ss.text_color }};"
  aria-hidden="true"
>
  <div class="pawsorb-sa__inner">
    <div class="pawsorb-sa__thumb">
      {% render 'pawsorb-media', image: ss.thumb_image, asset: ss.thumb_asset, alt: '', ratio: '1 / 1', icon: 'pack', fit: 'contain' %}
    </div>
    <div class="pawsorb-sa__info">
      <p class="pawsorb-sa__title">{{ title }}</p>
      <p class="pawsorb-sa__tier" data-pawsorb-sa-tier>{{ ss.default_tier }}</p>
    </div>
    <a class="pawsorb-sa__btn" href="#pawsorb-bundle-picker" data-pawsorb-cta tabindex="-1">{{ ss.button_label }}</a>
  </div>
</pawsorb-sticky-atc>

{% stylesheet %}
  .pawsorb-sa { position: fixed; left: 0; right: 0; z-index: 40; display: block; background: var(--pawsorb-sa-bg, #fff); color: var(--pawsorb-sa-fg, #141816); box-shadow: 0 4px 18px rgba(18, 22, 20, .14); transition: transform .25s ease, opacity .25s ease; opacity: 0; pointer-events: none; }
  .pawsorb-sa.is-visible { opacity: 1; pointer-events: auto; }
  .pawsorb-sa__inner { max-width: 1200px; margin: 0 auto; padding: 10px 16px; display: grid; grid-template-columns: 52px 1fr auto; gap: 14px; align-items: center; }
  .pawsorb-sa__thumb { width: 52px; }
  .pawsorb-sa__thumb .pawsorb-media { --pawsorb-media-radius: 10px; }
  .pawsorb-sa__info { min-width: 0; }
  .pawsorb-sa__title { margin: 0; font: 700 15px/1.3 var(--font-heading--family); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pawsorb-sa__tier { margin: 2px 0 0; font-size: 14px; font-weight: 600; color: #12855A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pawsorb-sa__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; border-radius: 10px; background: var(--pawsorb-sa-accent, #12855A); color: #fff; font: 700 15px/1 var(--font-heading--family); text-decoration: none; letter-spacing: .03em; white-space: nowrap; }
  .pawsorb-sa__btn:hover { background: #0C5E40; }
  @media screen and (min-width: 750px) {
    .pawsorb-sa { top: 0; transform: translateY(-100%); }
    .pawsorb-sa.is-visible { transform: translateY(0); }
    .pawsorb-sa--no-desk { display: none; }
  }
  @media screen and (max-width: 749px) {
    .pawsorb-sa { bottom: 0; transform: translateY(100%); box-shadow: 0 -4px 18px rgba(18, 22, 20, .14); padding-bottom: env(safe-area-inset-bottom); }
    .pawsorb-sa.is-visible { transform: translateY(0); }
    .pawsorb-sa__inner { grid-template-columns: 1fr auto; gap: 10px; padding: 10px 12px; }
    .pawsorb-sa__thumb { display: none; }
    .pawsorb-sa__title { font-size: 13px; }
    .pawsorb-sa__tier { font-size: 13px; }
    .pawsorb-sa__btn { min-height: 48px; padding: 0 18px; font-size: 14px; }
    .pawsorb-sa--no-mob { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('pawsorb-sticky-atc')) {
    customElements.define('pawsorb-sticky-atc', class extends HTMLElement {
      connectedCallback() {
        this.tierEl = this.querySelector('[data-pawsorb-sa-tier]');
        this.onTier = (e) => this.render(e.detail);
        document.addEventListener('pawsorb:tier', this.onTier);
        if (window.pawsorbTier) this.render(window.pawsorbTier);
        const targets = [document.getElementById('pawsorb-bundle-picker'), document.querySelector('[data-pawsorb-atc]')].filter(Boolean);
        if (!targets.length) return;
        const btn = targets[targets.length - 1];
        let raf = 0;
        this.check = () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const vh = window.innerHeight;
            const anyVisible = targets.some((t) => { const r = t.getBoundingClientRect(); return r.bottom > 0 && r.top < vh; });
            const show = !anyVisible && btn.getBoundingClientRect().bottom < 0;
            this.classList.toggle('is-visible', show);
            this.setAttribute('aria-hidden', show ? 'false' : 'true');
            const a = this.querySelector('.pawsorb-sa__btn');
            if (a) a.tabIndex = show ? 0 : -1;
          });
        };
        document.addEventListener('scroll', this.check, { capture: true, passive: true });
        window.addEventListener('resize', this.check, { passive: true });
        this.check();
      }
      disconnectedCallback() {
        document.removeEventListener('pawsorb:tier', this.onTier);
        if (this.check) { document.removeEventListener('scroll', this.check, { capture: true }); window.removeEventListener('resize', this.check); }
      }
      render(d) {
        if (!d || !this.tierEl) return;
        this.tierEl.textContent = [d.title, d.weight, d.price].filter(Boolean).join(' · ');
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PawSorb sticky cart bar",
  "tag": "section",
  "class": "pawsorb-section-sticky",
  "settings": [
    { "type": "text", "id": "title", "label": "Title (blank = product title)", "default": "PawSorb™ First Aid for Pet Poisons" },
    { "type": "text", "id": "default_tier", "label": "Tier line before selection", "default": "Buy 3 · Dogs 61–80lbs · $74.97", "info": "Replaced by the selected tier on the page." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Add to cart", "info": "Scrolls to the bundle picker." },
    { "type": "checkbox", "id": "show_desktop", "label": "Show on desktop (top bar)", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Show on mobile (bottom bar)", "default": true },
    { "type": "image_picker", "id": "thumb_image", "label": "Thumbnail" },
    { "type": "text", "id": "thumb_asset", "label": "Thumbnail theme file", "default": "pawsorb-sticky-thumb.webp", "info": "File in assets/. Until it exists, a drawn tube is shown." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Button", "default": "#12855A" }
  ],
  "presets": [ { "name": "PawSorb sticky cart bar" } ]
}
{% endschema %}
