{%- comment -%} Krino technology: image + kicker, heading, paragraph and icon rows (Grip-Lock 48™). Prefix krino-tech. {%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign kt_link = ss.button_link
  if kt_link == blank and ss.button_label != blank
    assign kt_product = all_products[ss.product_handle]
    if kt_product != blank and kt_product.url != blank
      assign kt_link = kt_product.url
    else
      assign kt_link = routes.all_products_collection_url
    endif
  endif
-%}
<div
  class="krino-tech{% if ss.image_side == 'right' %} krino-tech--flip{% endif %}"
  style="--krino-tech-bg: {{ ss.background }}; --krino-tech-text: {{ ss.text_color }}; --krino-tech-accent: {{ ss.accent_color }}; --krino-tech-h-font: {{ ss.heading_font }}; --krino-tech-h-size: {{ ss.heading_size }}px; --krino-tech-h-size-m: {{ ss.heading_size_mobile }}px; --krino-tech-h-weight: {{ ss.heading_weight }}; --krino-tech-body: {{ ss.body_size }}px; --krino-tech-btn: {{ ss.button_bg }}; --krino-tech-btn-text: {{ ss.button_text }}; --krino-tech-img-w: {{ ss.image_width }}%; --krino-tech-pt: {{ ss.padding_top }}px; --krino-tech-pb: {{ ss.padding_bottom }}px; --krino-tech-pt-m: {{ ss.padding_top_mobile }}px; --krino-tech-pb-m: {{ ss.padding_bottom_mobile }}px;"
>
  <div class="krino-tech__inner">
    {%- if ss.image != blank or ss.image_asset != blank or request.design_mode -%}
      <div class="krino-tech__media">
        {% render 'krino-media', image: ss.image, asset: ss.image_asset, ratio: ss.ratio, alt: ss.heading, radius: 8, sizes: '(min-width: 750px) 50vw, 100vw' %}
      </div>
    {%- endif -%}
    <div class="krino-tech__copy">
      {%- if ss.kicker != blank -%}<p class="krino-tech__kicker">{{ ss.kicker }}</p>{%- endif -%}
      {%- if ss.heading != blank -%}<h2 class="krino-tech__heading">{{ ss.heading }}</h2>{%- endif -%}
      {%- if ss.text != blank -%}<div class="krino-tech__text">{{ ss.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="krino-tech__rows">
          {%- for block in section.blocks -%}
            <li class="krino-tech__row" {{ block.shopify_attributes }}>
              <span class="krino-tech__icon">{% render 'krino-icon', name: block.settings.icon, size: 24, stroke: 1.4 %}</span>
              <span>
                {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %}<br>{% endif %}{%- endif -%}
                {{- block.settings.text -}}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if ss.button_label != blank -%}
        <a class="krino-tech__button" href="{{ kt_link }}">
          {{- ss.button_label -}}
          {%- if ss.button_icon -%}{% render 'krino-icon', name: 'open-in-new', size: 18, stroke: 1.8 %}{%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .krino-tech { padding: var(--krino-tech-pt, 25px) 0 var(--krino-tech-pb, 35px); background: var(--krino-tech-bg, #fcfcfc); color: var(--krino-tech-text, #252525); }
  .krino-tech__inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; max-width: 1300px; margin: 0 auto; padding-inline: 40px; }
  .krino-tech--flip .krino-tech__inner { flex-direction: row-reverse; }
  .krino-tech__media { flex: 0 0 var(--krino-tech-img-w, 50%); min-width: 0; }
  .krino-tech__copy { display: flex; flex-direction: column; gap: 15px; flex: 1; min-width: 0; font-size: var(--krino-tech-body, 14px); line-height: 1.4; }
  .krino-tech__kicker { margin: 0; color: var(--krino-tech-accent, #3d5afe); font-size: 12.5px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; }
  .krino-tech__heading { margin: 0; font-family: var(--krino-tech-h-font, var(--font-heading--family)); font-size: var(--krino-tech-h-size, 32px); font-weight: var(--krino-tech-h-weight, 600); line-height: 1.25; color: inherit; }
  .krino-tech__text p { margin: 0 0 5px; }
  .krino-tech__rows { display: flex; flex-direction: column; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .krino-tech__row { display: flex; align-items: flex-start; gap: 12px; }
  .krino-tech__row strong { font-weight: 600; }
  .krino-tech__button { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; min-height: 44px; margin-top: 5px; padding: 10px 20px; border-radius: 8px; background: var(--krino-tech-btn, #3d5afe); color: var(--krino-tech-btn-text, #fff); font-size: 14px; letter-spacing: 0.025rem; text-transform: uppercase; text-decoration: none; transition: opacity 0.2s ease; }
  .krino-tech__button:hover { opacity: 0.88; }
  .krino-tech__icon { display: flex; flex: 0 0 auto; padding-top: 4px; color: var(--krino-tech-accent, #3d5afe); }
  @media screen and (max-width: 749px) {
    .krino-tech { padding: var(--krino-tech-pt-m, 20px) 0 var(--krino-tech-pb-m, 30px); }
    .krino-tech__inner, .krino-tech--flip .krino-tech__inner { flex-direction: column; align-items: stretch; gap: 30px; padding-inline: 20px; }
    .krino-tech__media { flex-basis: auto; }
    .krino-tech__heading { font-size: var(--krino-tech-h-size-m, 24px); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino technology",
  "tag": "section",
  "class": "krino-tech-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "row",
      "name": "Icon row",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "target", "options": [
          { "value": "target", "label": "Target" }, { "value": "shield", "label": "Shield" }, { "value": "eye", "label": "Eye" }, { "value": "check-circle", "label": "Check" }, { "value": "verified", "label": "Verified badge" }, { "value": "clock", "label": "Clock" }
        ] },
        { "type": "text", "id": "title", "label": "Title (bold, empty = text only)", "default": "Pigmentos electrostáticos" },
        { "type": "text", "id": "text", "label": "Text", "default": "Se pegan como imán al cabello que ya tienes y te dan densidad al instante" }
      ]
    }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image theme asset (fallback file name)", "default": "krino-tecnologia.jpg" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "default": "5 / 4", "options": [
      { "value": "5 / 4", "label": "5:4 (competitor)" }, { "value": "1 / 1", "label": "1:1" }, { "value": "4 / 3", "label": "4:3" }, { "value": "4 / 5", "label": "4:5" }, { "value": "16 / 9", "label": "16:9" }
    ] },
    { "type": "select", "id": "image_side", "label": "Image side (desktop)", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "range", "id": "image_width", "label": "Image width (desktop)", "min": 30, "max": 70, "step": 1, "unit": "%", "default": 48 },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "NUESTRA TECNOLOGÍA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tecnología Grip-Lock 48™" },
    { "type": "richtext", "id": "text", "label": "Paragraph", "default": "<p>Tres capas de ciencia trabajando juntas para lograr el rellenador capilar más natural y duradero jamás creado.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label (empty = no button)" },
    { "type": "url", "id": "button_link", "label": "Button link (empty = the product below)" },
    { "type": "text", "id": "product_handle", "label": "Product handle (used when the link is empty)", "default": "polvo-rellenador-de-cabello" },
    { "type": "checkbox", "id": "button_icon", "label": "Show the open icon in the button", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FCFCFC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#252525" },
    { "type": "color", "id": "accent_color", "label": "Kicker and icons", "default": "#3D5AFE" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#3D5AFE" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "var(--font-heading--family)", "options": [
      { "value": "var(--font-heading--family)", "label": "Heading" }, { "value": "var(--font-subheading--family)", "label": "Subheading" }, { "value": "var(--font-body--family)", "label": "Body" }, { "value": "var(--font-accent--family)", "label": "Accent" }
    ] },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "600", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 16, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 14, "max": 44, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 }
  ],
  "presets": [
    {
      "name": "Krino technology",
      "blocks": [
        { "type": "row", "settings": { "icon": "target", "title": "Pigmentos electrostáticos", "text": "Se pegan como imán al cabello que ya tienes y te dan densidad al instante" } },
        { "type": "row", "settings": { "icon": "shield", "title": "Adhesión con cera natural", "text": "Crea un sello a prueba de agua que resiste sudor, lluvia y fricción por +48 hrs" } },
        { "type": "row", "settings": { "icon": "eye", "title": "Micropartículas de sílice", "text": "Acabado invisible que imita la textura del cabello real: indetectable incluso en HD" } }
      ]
    }
  ]
}
{% endschema %}
