{% render 'refrain-fonts' %}
{%- assign dark = false -%}
{%- if section.settings.background == 'ink' -%}{%- assign dark = true -%}{%- endif -%}
<section class="rf-cmp rf-cmp--{{ section.settings.background }}" style="{% render 'refrain-vars' %}" {{ section.shopify_attributes }}>
  <div class="rf-cmp__inner">
    <div class="rf-cmp__head">
      {% render 'refrain-title', text: section.settings.heading, tag: 'h2', dark: dark %}
      {%- if section.settings.subheading != blank -%}<p class="rf-sub{% if dark %} rf-cmp__sub-dark{% endif %}">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    <div class="rf-cmp__layout">
      <div class="rf-cmp__card">
        <table class="rf-cmp__table">
          <thead>
            <tr>
              <th scope="col"><span class="rf-cmp__sr">Critère</span></th>
              <th scope="col" class="rf-cmp__us">{{ section.settings.col_us | escape }}</th>
              <th scope="col">{{ section.settings.col_a | escape }}</th>
              <th scope="col">{{ section.settings.col_b | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}</th>
                <td class="rf-cmp__us{% if forloop.last %} is-last{% endif %}">
                  <span class="rf-cmp__chk rf-cmp__chk--us">{% render 'refrain-icon', name: 'check' %}</span>
                  {%- if block.settings.us_text != blank -%}<span class="rf-cmp__txt">{{ block.settings.us_text | escape }}</span>{%- endif -%}
                </td>
                <td>{%- if block.settings.a_has -%}<span class="rf-cmp__chk rf-cmp__chk--yes" role="img" aria-label="Oui">{% render 'refrain-icon', name: 'check' %}</span>{%- else -%}<span class="rf-cmp__chk rf-cmp__chk--no" role="img" aria-label="Non">{% render 'refrain-icon', name: 'x' %}</span>{%- endif -%}</td>
                <td>{%- if block.settings.b_has -%}<span class="rf-cmp__chk rf-cmp__chk--yes" role="img" aria-label="Oui">{% render 'refrain-icon', name: 'check' %}</span>{%- else -%}<span class="rf-cmp__chk rf-cmp__chk--no" role="img" aria-label="Non">{% render 'refrain-icon', name: 'x' %}</span>{%- endif -%}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <div class="rf-cmp__img">
        {% render 'refrain-media', image: section.settings.image, asset: section.settings.image_asset, ratio: '4 / 5', label: 'Photo : tiroir de souvenirs avec cartes et cadeaux oubliés', radius: 22, sizes: '(min-width: 990px) 380px, 0px' %}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
  .rf-cmp { font-family: var(--rf-sans); padding: 56px 0; background: var(--rf-page); }
  .rf-cmp--lilac { background: var(--rf-lilac); }
  .rf-cmp--ink { background: var(--rf-ink); }
  .rf-cmp__inner { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .rf-cmp__head { max-width: 640px; margin-bottom: 28px; }
  .rf-cmp__sub-dark { color: var(--rf-lilac); }
  .rf-cmp__layout { display: grid; gap: 24px; }
  .rf-cmp__img { display: none; }
  .rf-cmp__card { background: var(--rf-card); border-radius: 22px; box-shadow: 0 12px 36px rgb(30 15 74 / .10); padding: 8px; }
  .rf-cmp__table { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
  .rf-cmp__table th, .rf-cmp__table td { padding: 14px 6px; text-align: center; vertical-align: middle; border-bottom: 1px solid var(--rf-line); color: var(--rf-ink); }
  .rf-cmp__table tbody tr:last-child th, .rf-cmp__table tbody tr:last-child td { border-bottom: 0; }
  .rf-cmp__table th:first-child { width: 32%; text-align: left; padding-left: 10px; font-size: 13px; font-weight: 700; line-height: 1.3; }
  .rf-cmp__table thead th { font-size: 11px; font-weight: 700; color: var(--rf-ink-soft); line-height: 1.2; letter-spacing: -0.01em; }
  .rf-cmp__table th.rf-cmp__us, .rf-cmp__table td.rf-cmp__us { background: var(--rf-ink); color: #fff; border-bottom-color: rgb(255 255 255 / .12); width: 28%; }
  .rf-cmp__table thead th.rf-cmp__us { border-radius: 16px 16px 0 0; font-size: 13px; font-weight: 800; color: #fff; }
  .rf-cmp__table td.rf-cmp__us.is-last { border-radius: 0 0 16px 16px; }
  .rf-cmp__chk { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; }
  .rf-cmp__chk svg { width: 15px; height: 15px; stroke-width: 2.6; }
  .rf-cmp__chk--us { background: var(--rf-lime); color: var(--rf-ink); }
  .rf-cmp__chk--yes { background: var(--rf-lilac); color: var(--rf-ink); }
  .rf-cmp__chk--no { color: var(--rf-ink-soft); opacity: .7; }
  .rf-cmp__txt { display: block; margin-top: 6px; font-size: 11px; line-height: 1.3; font-weight: 600; color: var(--rf-lilac); overflow-wrap: anywhere; }
  .rf-cmp__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (min-width: 750px) {
    .rf-cmp { padding: 96px 0; }
    .rf-cmp__inner { padding: 0 24px; }
    .rf-cmp__card { padding: 16px 20px; }
    .rf-cmp__table th, .rf-cmp__table td { padding: 20px 14px; }
    .rf-cmp__table th:first-child { font-size: 16px; padding-left: 14px; }
    .rf-cmp__table thead th { font-size: 14px; }
    .rf-cmp__table thead th.rf-cmp__us { font-size: 17px; }
    .rf-cmp__chk { width: 32px; height: 32px; }
    .rf-cmp__chk svg { width: 18px; height: 18px; }
    .rf-cmp__txt { font-size: 14px; }
  }
  @media (min-width: 990px) {
    .rf-cmp__layout { grid-template-columns: 1fr 380px; align-items: stretch; }
    .rf-cmp__img { display: block; }
    .rf-cmp__img .rf-media { height: 100%; aspect-ratio: auto !important; min-height: 440px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Refrain · Comparison",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "page", "label": "Page" }, { "value": "lilac", "label": "Lilac" }, { "value": "ink", "label": "Ink" }], "default": "page" },
    { "type": "text", "id": "heading", "label": "Heading (wrap one word in *asterisks*)", "default": "Pourquoi une chanson, plutôt qu'un *objet*" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Un cadeau qui ne finit pas dans un tiroir." },
    { "type": "text", "id": "col_us", "label": "Column: us", "default": "Refrain" },
    { "type": "text", "id": "col_a", "label": "Column A", "default": "Carte cadeau" },
    { "type": "text", "id": "col_b", "label": "Column B", "default": "Cadeau classique" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "text", "id": "image_asset", "label": "Theme asset file name", "default": "refrain-compare-drawer.jpg" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Unique et personnel" },
        { "type": "text", "id": "us_text", "label": "Our value text", "default": "100 % sur mesure" },
        { "type": "checkbox", "id": "a_has", "label": "Column A has it", "default": false },
        { "type": "checkbox", "id": "b_has", "label": "Column B has it", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refrain · Comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Unique et personnel", "us_text": "Écrit pour eux", "a_has": false, "b_has": false } },
        { "type": "row", "settings": { "label": "Racontée avec leurs mots", "us_text": "Vos souvenirs", "a_has": false, "b_has": false } },
        { "type": "row", "settings": { "label": "S'écoute à l'infini", "us_text": "Pour toujours", "a_has": false, "b_has": true } },
        { "type": "row", "settings": { "label": "Prête rapidement", "us_text": "Livrée vite", "a_has": true, "b_has": false } },
        { "type": "row", "settings": { "label": "Fait pleurer de joie", "us_text": "Émotion garantie", "a_has": false, "b_has": false } }
      ]
    }
  ]
}
{% endschema %}
