{%- assign s = section.settings -%}
<section class="ot-home-stats" style="{% render 'oldtoms-vars' %}--ot-bg:{{ s.bg_color }};--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;{% if s.pattern_asset != blank %}--ot-pattern:url('{{ s.pattern_asset | asset_url }}');{% endif %}">
  <div class="ot-home-stats__row">
    {%- for block in section.blocks -%}
      <div class="ot-home-stats__card" {{ block.shopify_attributes }}>
        <span class="ot-home-stats__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'cart' -%}<svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M3 4h2l2.4 11h10.2L20 7H6"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg>
            {%- when 'people' -%}<svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.6 2.7-6 6-6s6 2.4 6 6"/><circle cx="17" cy="9" r="2.6"/><path d="M16.5 14.2c3 0 4.5 2 4.5 5.8"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
          {%- endcase -%}
        </span>
        <span class="ot-home-stats__text">
          <span class="ot-home-stats__value">{{ block.settings.value }}</span>
          <span class="ot-home-stats__label">{{ block.settings.label }}</span>
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.ot-home-stats { background-color: var(--ot-bg); background-image: var(--ot-pattern, none); background-size: 512px auto; padding: var(--ot-pt) 0 var(--ot-pb); font-family: var(--ot-font); color: var(--ot-green); }
.ot-home-stats__row { display: grid; grid-template-columns: 1fr; gap: 10px; max-width: 1384px; margin: 0 auto; padding-inline: 16px; }
.ot-home-stats__card { display: flex; align-items: center; gap: 18px; background: var(--ot-cream); border: 2px solid var(--ot-green); border-radius: 24px; padding: 22px 24px; min-height: 118px; }
.ot-home-stats__icon { flex: none; display: grid; place-items: center; }
.ot-home-stats__text { display: flex; flex-direction: column; gap: 2px; }
.ot-home-stats__value { font-family: var(--ot-font-heading); font-size: 38px; line-height: 1.05; }
.ot-home-stats__label { font-weight: 700; font-size: 17px; line-height: 1.2; }
@media screen and (min-width: 750px) {
  .ot-home-stats__row { grid-template-columns: repeat(3, 1fr); padding-inline: 28px; }
  .ot-home-stats__card { min-height: 146px; }
  .ot-home-stats__value { font-size: 40px; }
  .ot-home-stats__label { font-size: 18px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's stats bar",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "pattern_asset", "label": "Background pattern: theme file", "default": "oldtoms-stats-pattern.jpg", "info": "Tiles behind the cards. Missing file = plain colour." },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#4F9A4C" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 56, "min": 0, "max": 120, "step": 4, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "star", "options": [ { "value": "star", "label": "Star" }, { "value": "cart", "label": "Cart" }, { "value": "people", "label": "People" } ] },
        { "type": "text", "id": "value", "label": "Number", "default": "4.8/5" },
        { "type": "text", "id": "label", "label": "Label", "default": "Rated Excellent" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Old Tom's stats bar",
      "blocks": [
        { "type": "stat", "settings": { "icon": "star", "value": "4.8/5", "label": "Rated Excellent" } },
        { "type": "stat", "settings": { "icon": "cart", "value": "1M+", "label": "Repellents Sold" } },
        { "type": "stat", "settings": { "icon": "people", "value": "500K+", "label": "Customers" } }
      ]
    }
  ]
}
{% endschema %}
