{%- assign href = section.settings.link | default: section.settings.product.url | default: routes.all_products_collection_url -%}
{%- liquid
  assign d = section.settings.image_desktop
  assign m = section.settings.image_mobile
  assign da = section.settings.image_desktop_asset
  assign ma = section.settings.image_mobile_asset
  assign both = false
  if d != blank or da != blank
    if m != blank or ma != blank
      assign both = true
    endif
  endif
-%}
<section class="au-h au-h-hero{% if both %} is-both{% endif %}" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-h-hero__bg">
    {%- if d != blank -%}
      {{ d | image_url: width: 2400 | image_tag: class: 'au-h-hero__img au-h-hero__img--d', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1200, 1800, 2400', alt: '' }}
    {%- elsif da != blank -%}
      <img src="{{ da | asset_url }}" class="au-h-hero__img au-h-hero__img--d" loading="eager" fetchpriority="high" width="2400" height="1350" alt="">
    {%- endif -%}
    {%- if m != blank -%}
      {{ m | image_url: width: 1400 | image_tag: class: 'au-h-hero__img au-h-hero__img--m', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '390, 750, 1100, 1400', alt: '' }}
    {%- elsif ma != blank -%}
      <img src="{{ ma | asset_url }}" class="au-h-hero__img au-h-hero__img--m" loading="eager" fetchpriority="high" width="1100" height="1956" alt="">
    {%- endif -%}
    {%- if d == blank and m == blank and da == blank and ma == blank -%}
      <div class="au-h-hero__ph" aria-hidden="true"></div>
    {%- endif -%}
    <div class="au-h-hero__veil"></div>
  </div>
  <div class="au-h-wrap au-h-hero__in">
    <div class="au-h-hero__box">
      {%- if section.settings.pill != blank -%}<p class="au-h-hero__pill"><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"/></svg>{{ section.settings.pill }}</p>{%- endif -%}
      {% render 'aurea-title', text: section.settings.heading, tag: 'h1', class: 'au-h-hero__h' %}
      <p class="au-h-hero__p">{{ section.settings.text }}</p>
      <div class="au-h-hero__cta">
        <a class="au-h-btn au-h-btn--gold" href="{{ href }}">{{ section.settings.cta_label }}<svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- if section.settings.ghost_label != blank -%}<a class="au-h-btn au-h-btn--ghost au-h-hero__ghost" href="{{ section.settings.ghost_link | default: '#stones' }}">{{ section.settings.ghost_label }}</a>{%- endif -%}
      </div>
      <ul class="au-h-hero__trust">
        <li><span class="au-h-tp" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z" fill="#fff"/></svg></span><span>{{ section.settings.rating_text }}</span></li>
        <li><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg><span>{{ section.settings.ship_text }}</span></li>
        <li><svg class="au-h-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><span>{{ section.settings.guarantee_text }}</span></li>
      </ul>
    </div>
  </div>
</section>
{% stylesheet %}
  .au-h { padding: 60px 0; font-family: var(--au-body); color: #2A2E29; background: #fff; }
  .au-h *, .au-h *::before, .au-h *::after { box-sizing: border-box; }
  .au-h--parch { background: var(--au-parchment); }
  .au-h--pine { background: var(--au-pine); }
  .au-h--dark { background: var(--au-espresso); }
  .au-h.au-h--dark, .au-h.au-h--pine, .au-h.au-h-hero { color: #fff; }
  .au-h-wrap { width: calc(100% - 32px); max-width: 1200px; margin-inline: auto; }
  .au-h-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .au-h-h2 { font-size: 31px; line-height: 1.08; }
  .au-h-sub { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.6; color: #4A5249; }
  .au-h-i { width: 1em; height: 1em; flex: none; }
  .au-h .au-icon { width: 1em; height: 1em; flex: none; }
  .au-h-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 56px; padding: 0 32px; border-radius: 999px; background: var(--au-pine); color: var(--au-parchment); font-family: var(--au-body); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
  .au-h-btn:hover { filter: brightness(1.12); }
  .au-h-btn:focus-visible { outline: 2px solid var(--au-gold); outline-offset: 3px; }
  .au-h-btn .au-h-i { font-size: 18px; }
  .au-h-btn--gold { background: var(--au-gold); color: #1E1A10; }
  .au-h-btn--ghost { background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.55); }
  .au-h-dark .au-title, .au-h--dark .au-title, .au-h--pine .au-title { color: #fff; }
  .au-h-hero .au-title { color: #fff; }
  .au-h-hero .au-title em { color: #DDB866; }
  .au-h-dark .au-title em, .au-h--dark .au-title em, .au-h--pine .au-title em { color: #DDB866; }
  .au-h--dark .au-eyebrow, .au-h--pine .au-eyebrow { color: #DDB866; }
  .au-h-tp { display: inline-flex; gap: 2px; }
  .au-h-tp svg { width: 20px; height: 20px; padding: 3px; background: #00B67A; }
  .au-h-ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #f1f1f1, #dcdcdc); color: #6b6b6b; font-size: 12px; text-align: center; }
  @media (min-width: 750px) { .au-h { padding: 72px 0; } .au-h-wrap { width: calc(100% - 48px); } .au-h-head { margin-bottom: 56px; } .au-h-h2 { font-size: 36px; } .au-h-btn { width: auto; } }
  @media (min-width: 990px) { .au-h { padding: 96px 0; } .au-h-h2 { font-size: 44px; } }

  .au-h.au-h-hero { position: relative; display: flex; align-items: flex-end; min-height: min(760px, calc(100svh - var(--header-group-height, 80px))); padding: 110px 0 44px; background: var(--au-espresso); color: #fff; overflow: hidden; }
  .au-h-hero__bg { position: absolute; inset: 0; }
  .au-h-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .au-h-hero__ph { position: absolute; inset: 0; display: grid; place-items: start end; text-align: right; padding: 24px; background: linear-gradient(135deg, #3a4a3d, #1E3328 60%, #162619); color: rgb(255 255 255 / 0.6); font-size: 12px; text-align: center; line-height: 1.5; }
  .au-h-hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(12 21 15 / 0.35), rgb(12 21 15 / 0) 22%, rgb(12 21 15 / 0.2) 45%, rgb(12 21 15 / 0.85) 100%); }
  .au-h-hero__in { position: relative; }
  .au-h-hero__box { max-width: 600px; margin-inline: auto; text-align: center; }
  .au-h-hero__pill { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 20px; padding: 8px 16px; border: 1px solid rgb(255 255 255 / 0.28); border-radius: 999px; background: rgb(255 255 255 / 0.12); backdrop-filter: blur(8px); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; }
  .au-h-hero__pill .au-h-i { color: #DDB866; font-size: 16px; }
  .au-h-hero__h { font-size: 42px; line-height: 1; letter-spacing: -0.02em; color: #fff; }
  .au-h-hero .au-title em { color: #DDB866; }
  .au-h-hero__p { margin: 20px 0 28px; font-size: 16px; line-height: 1.6; color: rgb(255 255 255 / 0.9); }
  .au-h-hero__cta { display: flex; justify-content: center; gap: 12px; }
  .au-h-hero .au-h-hero__ghost { display: none; }
  .au-h-hero__trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 18px; margin: 26px 0 0; padding: 0; list-style: none; font-size: 12.5px; }
  .au-h-hero__trust li { display: inline-flex; align-items: center; gap: 8px; }
  .au-h-hero__trust .au-h-i { color: #DDB866; font-size: 18px; }
  .au-h-hero.is-both .au-h-hero__img--d { display: none; }
  @media (min-width: 750px) {
    .au-h-hero.is-both .au-h-hero__img--d { display: block; }
    .au-h-hero.is-both .au-h-hero__img--m { display: none; }
    .au-h-hero__img { object-position: center; }
    .au-h-hero .au-h-hero__ghost { display: inline-flex; }
    .au-h-hero__h { font-size: 56px; }
    .au-h-hero__p { font-size: 17px; }
    .au-h-hero__trust { font-size: 14px; }
  }
  @media (min-width: 990px) {
    .au-h.au-h-hero { align-items: center; min-height: min(820px, calc(100svh - var(--header-group-height, 80px))); padding: 120px 0 90px; }
    .au-h-hero__veil { background: linear-gradient(90deg, rgb(12 21 15 / 0.78), rgb(12 21 15 / 0.5) 38%, transparent 65%), linear-gradient(180deg, rgb(12 21 15 / 0.35), transparent 25%); }
    .au-h-hero__box { margin-inline: 0; text-align: left; }
    .au-h-hero__cta, .au-h-hero__trust { justify-content: flex-start; }
    .au-h-hero__h { font-size: 72px; }
    .au-h-hero__p { font-size: 19px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea home hero",
  "settings": [
    {
      "type": "text",
      "id": "image_desktop_asset",
      "label": "Theme asset fallback (filename)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Slot: hero-desktop, 16:9 (2560x1440). Subject in right half, left 40% quiet."
    },
    {
      "type": "text",
      "id": "image_mobile_asset",
      "label": "Theme asset fallback (filename)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Slot: hero-mobile, 9:16 portrait (1400x2489). Bracelet in top half."
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Pill",
      "default": "Charged under every full moon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (*word* = gold italic)",
      "default": "Attract What's *Yours*"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "Real citrine, green aventurine and African turquoise, strung on one bracelet and charged under the full moon for luck, money and fresh starts."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the bracelet"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Primary button link (empty = selected product, then all products)"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product for the button link"
    },
    {
      "type": "text",
      "id": "ghost_label",
      "label": "Ghost button label",
      "default": "Meet the stones"
    },
    {
      "type": "text",
      "id": "ghost_link",
      "label": "Ghost button anchor",
      "default": "#stones"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Excellent 4.8 out of 5"
    },
    {
      "type": "text",
      "id": "ship_text",
      "label": "Shipping text",
      "default": "Free express shipping"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "30-day money-back guarantee"
    }
  ],
  "presets": [
    {
      "name": "Aurea home hero"
    }
  ]
}
{% endschema %}
