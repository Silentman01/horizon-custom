{%- assign s = section.settings -%}
<div class="ot-guarantee" style="{% render 'oldtoms-vars' %}--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <div class="ot-guarantee__grid">
    <div class="ot-guarantee__image">{% render 'oldtoms-media', image: s.image, asset: s.asset, ratio: '0.89', alt: s.image_alt, sizes: '(min-width: 750px) 50vw, 100vw' %}</div>
    <div class="ot-guarantee__card">
      <svg class="ot-guarantee__badge" viewBox="0 0 24 24" width="44" height="44" aria-hidden="true"><path d="M12 1.8l2.4 1.7 2.9-.2 1.2 2.7 2.6 1.4-.4 2.9 1.5 2.5-1.5 2.5.4 2.9-2.6 1.4-1.2 2.7-2.9-.2L12 22.2l-2.4-1.7-2.9.2-1.2-2.7-2.6-1.4.4-2.9L1.8 11l1.5-2.5-.4-2.9 2.6-1.4 1.2-2.7 2.9.2z" fill="#23372b"/><path d="M7.8 12.2l3 3 5.6-6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- if s.heading != blank -%}<h2 class="ot-guarantee__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<p class="ot-guarantee__body">{{ s.body }}</p>{%- endif -%}
      {%- if s.show_cta -%}
        <div class="ot-guarantee__cta">{% render 'oldtoms-cta', label: s.cta_label, guarantee: s.cta_guarantee %}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.ot-guarantee { background: #fff; color: #23372b; font-family: var(--ot-font); padding: var(--ot-pt, 0px) 0 var(--ot-pb, 32px); }
.ot-guarantee__grid { display: grid; max-width: 1440px; margin: 0 auto; }
.ot-guarantee__card { margin: -20px 17px 0; position: relative; padding: 24px 18px 28px; border-radius: 20px; background: #f4f4f0; }
.ot-guarantee__badge { display: block; margin-bottom: 14px; }
.ot-guarantee__heading { margin: 0 0 14px; font-family: var(--ot-font-heading); font-weight: 400; font-size: 34px; line-height: 1.15; }
.ot-guarantee__body { margin: 0; font-size: 14px; line-height: 1.5; }
.ot-guarantee__cta { margin-top: 22px; }
@media screen and (min-width: 750px) {
  .ot-guarantee { padding-block: var(--ot-pt, 0px) var(--ot-pb, 0px); }
  .ot-guarantee__grid { grid-template-columns: 1fr 1fr; gap: 46px; align-items: center; }
  .ot-guarantee__image .ot-media { aspect-ratio: 0.89 !important; }
  .ot-guarantee__card { margin: 0 36px 0 0; padding: 48px 44px; }
  .ot-guarantee__heading { font-size: 42px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's guarantee",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "30 Day Money Back Guarantee" },
    { "type": "textarea", "id": "body", "label": "Text", "default": "If you're not fully happy with your mouse-free peace of mind, we'll gladly refund your order. No rodents, no risk." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset", "label": "Theme asset filename (used when no image is picked)", "default": "oldtoms-guarantee.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Old Tom's pouch bag with test tubes, sachets and a 30-day money-back seal" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show add to basket button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to basket" },
    { "type": "text", "id": "cta_guarantee", "label": "Guarantee line", "default": "30-Day Money Back Guarantee" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [ { "name": "Old Tom's guarantee" } ]
}
{% endschema %}
