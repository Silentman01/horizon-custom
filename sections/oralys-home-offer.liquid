      "label": "Titre (italique = mot en couleur accent)",
      "default": "Choisissez <em>votre pack</em>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p>Une seule pose tient plusieurs jours. Et plus vous prenez de tubes, moins la semaine vous revient cher.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien par défaut des cartes",
      "info": "Vide = /products/oralys-gel"
    },
    {
