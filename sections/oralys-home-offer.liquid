<section class="oralys-home-offer" id="oralys-home-offer" style="--oh-bg:{{ section.settings.c_bg }};--oh-text:{{ section.settings.c_text }};--oh-accent:{{ section.settings.c_accent }};--oh-muted:{{ section.settings.c_muted }};--oh-card:{{ section.settings.c_card }};--oh-line:{{ section.settings.c_line }};--oh-cta:{{ section.settings.c_cta }};--oh-cta-text:{{ section.settings.c_cta_text }};--oh-h-m:{{ section.settings.h_m }}px;--oh-h-d:{{ section.settings.h_d }}px;--oh-body:{{ section.settings.body_size }}px;--oh-align:{{ section.settings.align }};--oh-pt-m:{{ section.settings.pt_m }}px;--oh-pb-m:{{ section.settings.pb_m }}px;--oh-pt-d:{{ section.settings.pt_d }}px;--oh-pb-d:{{ section.settings.pb_d }}px">
  <div class="oralys-home-offer__inner">
    <div class="oralys-home-offer__head{% if section.settings.align == 'center' %} oralys-home-offer__head--center{% endif %}">{% if section.settings.eyebrow != blank %}<p class="oralys-home-offer__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="oralys-home-offer__h">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<div class="oralys-home-offer__sub">{{ section.settings.subheading }}</div>{% endif %}</div>
    <div class="oralys-home-offer__cards">
      {% for block in section.blocks %}
        {% liquid
          assign url = block.settings.link | default: section.settings.link | default: '/products/oralys-gel'
          assign p = block.settings.product
          if p != blank
            assign url = p.url
          endif
        %}
        <a class="oralys-home-offer__card{% if block.settings.featured %} oralys-home-offer__card--on{% endif %}" href="{{ url }}" {{ block.shopify_attributes }}>
          {% if block.settings.badge != blank %}<span class="oralys-home-offer__badge oralys-home-offer__badge--{{ block.settings.badge_style }}">{{ block.settings.badge }}</span>{% endif %}
          <div class="oralys-home-offer__pic">
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 400 | image_tag: class: 'oralys-home-offer__img', loading: 'lazy', alt: block.settings.title }}
            {% elsif block.settings.asset != blank %}<img class="oralys-home-offer__img" src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="300" height="300" loading="lazy">
            {% elsif p != blank and p.featured_image != blank %}{{ p.featured_image | image_url: width: 400 | image_tag: class: 'oralys-home-offer__img', loading: 'lazy' }}{% endif %}
          </div>
          <div class="oralys-home-offer__info">
            <p class="oralys-home-offer__title">{{ block.settings.title }}</p>
            {% if block.settings.subtitle != blank %}<p class="oralys-home-offer__subt">{{ block.settings.subtitle }}</p>{% endif %}
            <p class="oralys-home-offer__prices"><span class="oralys-home-offer__price">{{ block.settings.price }}</span>{% if block.settings.compare != blank %} <s class="oralys-home-offer__compare">{{ block.settings.compare }}</s>{% endif %}</p>
            {% if block.settings.saving != blank %}<span class="oralys-home-offer__saving">{{ block.settings.saving }}</span>{% endif %}
            {% if block.settings.perks != blank %}<div class="oralys-home-offer__perks">{{ block.settings.perks }}</div>{% endif %}
            {% if block.settings.button != blank %}<span class="oralys-home-offer__btn oralys-home-offer__cardbtn{% unless block.settings.featured %} oralys-home-offer__cardbtn--ghost{% endunless %}">{{ block.settings.button }}</span>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
    {% if section.settings.footnote != blank %}<p class="oralys-home-offer__foot">{{ section.settings.footnote }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
.oralys-home-offer{background:var(--oh-bg);color:var(--oh-text);padding:var(--oh-pt-m) 16px var(--oh-pb-m);font-family:var(--font-body--family);font-size:var(--oh-body);line-height:1.55}
.oralys-home-offer *{box-sizing:border-box}
@media (min-width:750px){.oralys-home-offer{padding:var(--oh-pt-d) 32px var(--oh-pb-d)}}
.oralys-home-offer__inner{max-width:1200px;margin:0 auto}
.oralys-home-offer__head{text-align:var(--oh-align);margin:0 0 28px}
.oralys-home-offer__eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--oh-accent);margin:0 0 10px}
.oralys-home-offer__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--oh-h-m);line-height:1.2;margin:0 0 12px;color:var(--oh-text);text-wrap:balance}
.oralys-home-offer__h em{font-style:normal;color:var(--oh-accent)}
@media (min-width:750px){.oralys-home-offer__h{font-size:var(--oh-h-d)}}
.oralys-home-offer__sub{color:var(--oh-muted);margin:0;max-width:680px}
.oralys-home-offer__head[style*=center] .oralys-home-offer__sub,.oralys-home-offer__head--center .oralys-home-offer__sub{margin-inline:auto}
.oralys-home-offer__sub p{margin:0 0 8px}
.oralys-home-offer__btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--oh-cta);color:var(--oh-cta-text);font-weight:700;font-size:17px;text-decoration:none;border:0;transition:transform .15s}
.oralys-home-offer__btn:hover{transform:translateY(-1px)}
.oralys-home-offer__btn--full{width:100%}
@media (min-width:750px){.oralys-home-offer__btn--full{width:auto;min-width:300px}}

.oralys-home-offer__cards{display:grid;gap:16px}
.oralys-home-offer__card{position:relative;display:grid;grid-template-columns:96px 1fr;gap:14px;padding:18px 14px 16px;border:1px solid var(--oh-line);border-radius:12px;background:var(--oh-card);color:var(--oh-text);text-decoration:none}
.oralys-home-offer__card--on{border:2px solid var(--oh-accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--oh-accent) 12%,transparent)}
.oralys-home-offer__badge{position:absolute;top:-11px;right:14px;font-size:12px;font-weight:700;letter-spacing:.06em;padding:4px 10px;border-radius:40px;color:#fff}
.oralys-home-offer__badge--green{background:var(--oh-accent)}.oralys-home-offer__badge--red{background:var(--oh-cta)}.oralys-home-offer__badge--dark{background:var(--oh-text)}
.oralys-home-offer__pic{border-radius:10px;overflow:hidden;background:var(--oh-bg);align-self:start}
.oralys-home-offer__img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;display:block}
.oralys-home-offer__title{margin:0;font-family:var(--font-heading--family);font-weight:700;font-size:20px;line-height:1.2}
.oralys-home-offer__subt{margin:2px 0 6px;font-size:15px;color:var(--oh-muted)}
.oralys-home-offer__prices{margin:0;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.oralys-home-offer__price{font-size:24px;font-weight:700}.oralys-home-offer__compare{color:var(--oh-muted);font-size:16px}
.oralys-home-offer__saving{display:inline-block;margin-top:4px;font-size:13px;font-weight:700;color:var(--oh-cta)}
.oralys-home-offer__perks{font-size:15px;margin-top:8px}.oralys-home-offer__perks ul{margin:0;padding:0;list-style:none;display:grid;gap:4px}
.oralys-home-offer__perks li::before{content:"✓ ";color:var(--oh-accent);font-weight:700}.oralys-home-offer__perks p{margin:0}
.oralys-home-offer__cardbtn{grid-column:1/-1;margin-top:12px;min-height:48px;width:100%;font-size:16px}
.oralys-home-offer__cardbtn--ghost{background:transparent;color:var(--oh-text);border:1.5px solid var(--oh-text)}
.oralys-home-offer__info{display:flex;flex-direction:column}
.oralys-home-offer__card .oralys-home-offer__btn{grid-column:auto}
.oralys-home-offer__foot{text-align:center;margin:20px 0 0;font-size:14px;color:var(--oh-muted)}
@media (min-width:990px){.oralys-home-offer__cards{grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch}
 .oralys-home-offer__card{grid-template-columns:1fr;padding:22px}.oralys-home-offer__info{flex:1}.oralys-home-offer__cardbtn{margin-top:auto}.oralys-home-offer__perks{margin-bottom:16px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys accueil : packs",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "inline_richtext",
