<section class="ot-home-benefits" style="{% render 'oldtoms-vars' %}--ot-bg:{{ section.settings.bg_color }};--ot-fg:{{ section.settings.text_color }};--ot-speed:{{ section.settings.speed }}s;--ot-pt:{{ section.settings.padding_top }}px;--ot-pb:{{ section.settings.padding_bottom }}px;">
  <div class="ot-home-benefits__track">
    {%- for copy in (1..2) -%}
      <ul class="ot-home-benefits__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="ot-home-benefits__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.glyph != blank -%}<span class="ot-home-benefits__glyph" aria-hidden="true">{{ block.settings.glyph }}</span>{%- endif -%}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.ot-home-benefits { background: var(--ot-bg); color: var(--ot-fg); padding: var(--ot-pt) 0 var(--ot-pb); overflow: hidden; font-family: var(--ot-font); }
.ot-home-benefits__track { display: flex; width: max-content; animation: ot-home-benefits-run var(--ot-speed) linear infinite; }
.ot-home-benefits__group { display: flex; flex: none; margin: 0; padding: 0; list-style: none; }
.ot-home-benefits__item { display: inline-flex; align-items: center; gap: 8px; padding: 0 20px; white-space: nowrap; font-weight: 500; font-size: 13px; }
.ot-home-benefits__glyph { font-size: 16px; line-height: 1; }
@keyframes ot-home-benefits-run { to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .ot-home-benefits__track { animation: none; } }
@media screen and (min-width: 750px) {
  .ot-home-benefits__item { font-size: 14px; padding: 0 20px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's benefits bar",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#7FA93F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "speed", "label": "Loop time", "default": 24, "min": 8, "max": 60, "step": 2, "unit": "s" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 12, "min": 0, "max": 40, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 12, "min": 0, "max": 40, "step": 2, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "glyph", "label": "Symbol", "default": "◎" },
        { "type": "text", "id": "text", "label": "Text", "default": "100% Plant-Based Formula" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Old Tom's benefits bar",
      "blocks": [
        { "type": "item", "settings": { "glyph": "◎", "text": "100% Plant-Based Formula" } },
        { "type": "item", "settings": { "glyph": "☞", "text": "Long-Lasting Protection" } },
        { "type": "item", "settings": { "glyph": "♡", "text": "Safe For Kids & Pets" } },
        { "type": "item", "settings": { "glyph": "♕", "text": "30 Day Money Back Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
