{%- liquid
  assign ss = section.settings
  assign p = product
  if p == blank
    assign p = closest.product
  endif
  if p == blank and request.visual_preview_mode
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant
  assign images = p.media | where: 'media_type', 'image'
  assign title = ss.title_override | default: p.title | default: 'PawSorb™ First Aid for Pet Poisons'
  assign title_html = title | escape | replace: '™', '<span class="pawsorb-pdp__tm">™</span>'
  assign start_qty = 1
  assign has_pre = false
  for b in section.blocks
    if b.type == 'tier' and b.settings.preselect
      assign start_qty = b.settings.quantity
      assign has_pre = true
      break
    endif
  endfor
  unless has_pre
    for b in section.blocks
      if b.type == 'tier'
        assign start_qty = b.settings.quantity
        break
      endif
    endfor
  endunless
-%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<pawsorb-buy-box
  class="pawsorb-pdp"
  style="--pawsorb-pdp-pt: {{ ss.padding_top }}px; --pawsorb-pdp-pb: {{ ss.padding_bottom }}px; --pawsorb-pdp-accent: {{ ss.accent_color }}; --pawsorb-pdp-navy: {{ ss.navy_color }}; --pawsorb-pdp-text: {{ ss.text_color }};"
  data-section="{{ section.id }}"
>
  <div class="pawsorb-pdp__grid">
    {%- comment -%} Gallery: product media; vector packshot until media is uploaded {%- endcomment -%}
    <div class="pawsorb-pdp__gallery">
      <div class="pawsorb-pdp__track" data-pawsorb-rail data-pawsorb-track>
        {%- if images.size > 0 -%}
          {%- for m in images -%}
            <div class="pawsorb-pdp__slide">
              {%- assign ld = 'lazy' -%}{%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- endif -%}
              {%- assign m_alt = m.alt | default: ss.gallery_alt -%}
              {{ m.preview_image | image_url: width: 1400 | image_tag: loading: ld, sizes: '(min-width: 990px) 600px, 100vw', widths: '400, 600, 800, 1000, 1200, 1400', alt: m_alt, class: 'pawsorb-pdp__img' }}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="pawsorb-pdp__slide">
            {% render 'pawsorb-media', image: ss.fallback_image, asset: ss.fallback_asset, alt: ss.gallery_alt, ratio: '1 / 1', icon: 'pack', fit: 'contain', eager: true %}
          </div>
        {%- endif -%}
      </div>
      {%- if images.size > 1 -%}
        <div class="pawsorb-pdp__dots" aria-hidden="true">
          {%- for m in images -%}<span class="pawsorb-pdp__dotx{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
        </div>
        <div class="pawsorb-pdp__thumbs" data-pawsorb-rail>
          {%- for m in images -%}
            <button type="button" class="pawsorb-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ forloop.index }} / {{ images.size }}">
              {{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 72, height: 72 }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pawsorb-pdp__info">
      <h1 class="pawsorb-pdp__title">{{ title_html }}</h1>
      {%- if ss.pill != blank -%}
        <p class="pawsorb-pdp__pill">{% render 'pawsorb-icon', name: 'vet', size: 16 %}<span>{{ ss.pill }}</span></p>
      {%- endif -%}
      {%- if ss.rating_text != blank or ss.families_text != blank -%}
        <p class="pawsorb-pdp__rating">
          <span class="pawsorb-pdp__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'pawsorb-icon', name: 'star', size: 16 %}{%- endfor -%}</span>
          {%- if ss.rating_text != blank -%}<span class="pawsorb-pdp__rtext">{{ ss.rating_text }}</span>{%- endif -%}
          {%- if ss.families_text != blank -%}<span class="pawsorb-pdp__fam">{{ ss.families_text }}</span>{%- endif -%}
        </p>
      {%- endif -%}
      {%- if ss.price_text != blank -%}
        <p class="pawsorb-pdp__price">
          <span class="pawsorb-pdp__pnow">{{ ss.price_text }}</span>
          {%- if ss.compare_text != blank -%}<s class="pawsorb-pdp__pwas">{{ ss.compare_text }}</s>{%- endif -%}
          {%- if ss.sale_badge != blank -%}<span class="pawsorb-pdp__psave">{{ ss.sale_badge }}</span>{%- endif -%}
        </p>
      {%- endif -%}
      {%- if ss.subtitle != blank -%}<p class="pawsorb-pdp__sub">{{ ss.subtitle }}</p>{%- endif -%}
      <ul class="pawsorb-pdp__bullets">
        {%- for i in (1..4) -%}
          {%- assign key = 'bullet_' | append: i -%}
          {%- if ss[key] != blank -%}
            <li><span class="pawsorb-pdp__chk">{% render 'pawsorb-icon', name: 'check', size: 14 %}</span><span>{{ ss[key] }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if ss.show_stock -%}
        <div class="pawsorb-pdp__stock">
          <div class="pawsorb-pdp__stockrow">
            <span class="pawsorb-pdp__stocklabel"><span class="pawsorb-pdp__pulse" aria-hidden="true"></span>{{ ss.stock_label }}</span>
            <span class="pawsorb-pdp__stockfill">{{ ss.stock_fill_text }}</span>
          </div>
          <div class="pawsorb-pdp__bar" role="presentation"><span style="width: {{ ss.stock_percent }}%;"></span></div>
          {%- if ss.stock_micro != blank -%}<p class="pawsorb-pdp__stockmicro">{{ ss.stock_micro }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {% render 'pawsorb-bundle-picker', section: section %}

      {%- if p != blank -%}
        {%- form 'product', p, class: 'pawsorb-pdp__form', data-pawsorb-form: '' -%}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="{{ start_qty }}" data-pawsorb-qty>
          <button type="submit" name="add" class="pawsorb-pdp__atc" data-pawsorb-atc {% unless v.available %}disabled{% endunless %}>
            <span class="pawsorb-pdp__atc-label">{% if v.available %}{{ ss.button_label }}{% else %}{{ ss.soldout_label }}{% endif %}</span>
            <span class="pawsorb-pdp__spinner" aria-hidden="true"></span>
          </button>
          <p class="pawsorb-pdp__err" data-pawsorb-err role="alert" hidden></p>
        {%- endform -%}
      {%- endif -%}

      <ul class="pawsorb-pdp__trust">
        {%- if ss.trust_1 != blank -%}<li>{% render 'pawsorb-icon', name: 'shield', size: 18 %}<span>{{ ss.trust_1 }}</span></li>{%- endif -%}
        {%- if ss.trust_2 != blank -%}<li>{% render 'pawsorb-icon', name: 'truck', size: 18 %}<span>{{ ss.trust_2 }}</span></li>{%- endif -%}
        {%- if ss.trust_3 != blank -%}<li>{% render 'pawsorb-icon', name: 'vet', size: 18 %}<span>{{ ss.trust_3 }}</span></li>{%- endif -%}
      </ul>
      {%- if ss.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="pawsorb-pdp__pay" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</pawsorb-buy-box>

{% stylesheet %}
  .pawsorb-pdp { display: block; padding: var(--pawsorb-pdp-pt, 16px) 16px var(--pawsorb-pdp-pb, 40px); color: var(--pawsorb-pdp-text, #141816); background: #fff; }
  .pawsorb-pdp__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 52fr 48fr; gap: 48px; align-items: start; }
  .pawsorb-pdp__gallery { min-width: 0; position: sticky; top: 16px; }
  .pawsorb-pdp__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 14px; background: #F1F6F3; cursor: grab; overscroll-behavior-x: contain; }
  .pawsorb-pdp__track::-webkit-scrollbar { display: none; }
  .pawsorb-pdp__track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .pawsorb-pdp__slide { flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 1; position: relative; }
  .pawsorb-pdp__slide .pawsorb-media { border-radius: 0; height: 100%; }
  .pawsorb-pdp__img { width: 100%; height: 100%; object-fit: cover; display: block; -webkit-user-drag: none; }
  .pawsorb-pdp__dots { display: none; justify-content: center; gap: 6px; margin-top: 10px; }
  .pawsorb-pdp__dotx { width: 7px; height: 7px; border-radius: 50%; background: #C6D4CB; transition: width .2s, background-color .2s; }
  .pawsorb-pdp__dotx.is-active { width: 18px; border-radius: 4px; background: var(--pawsorb-pdp-navy, #121614); }
  .pawsorb-pdp__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; cursor: grab; }
  .pawsorb-pdp__thumbs::-webkit-scrollbar { display: none; }
  .pawsorb-pdp__thumbs.is-dragging { cursor: grabbing; user-select: none; }
  .pawsorb-pdp__thumb { flex: 0 0 72px; width: 72px; height: 72px; padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; background: #F1F6F3; cursor: pointer; }
  .pawsorb-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; }
  .pawsorb-pdp__thumb.is-active { border-color: var(--pawsorb-pdp-navy, #121614); }
  .pawsorb-pdp__info { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .pawsorb-pdp__title { margin: 0; font: 700 32px/1.15 var(--font-heading--family); letter-spacing: -.01em; color: #141816; }
  .pawsorb-pdp__tm { color: var(--pawsorb-pdp-accent, #12855A); }
  .pawsorb-pdp__pill { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; margin: 0; padding: 6px 12px; border-radius: 999px; background: var(--pawsorb-pdp-navy, #121614); color: #fff; font: 600 13px/1.3 var(--font-body--family); }
  .pawsorb-pdp__rating { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin: 0; font-size: 14px; color: #141816; }
  .pawsorb-pdp__stars { display: inline-flex; gap: 1px; color: #F5B400; }
  .pawsorb-pdp__rtext { font-weight: 700; }
  .pawsorb-pdp__fam { color: #5D6A63; }
  .pawsorb-pdp__fam::before { content: "·"; margin-right: 8px; color: #C6D4CB; }
  .pawsorb-pdp__price { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0; }
  .pawsorb-pdp__pnow { font: 700 26px/1.1 var(--font-heading--family); color: var(--pawsorb-pdp-accent, #12855A); }
  .pawsorb-pdp__pwas { font-size: 17px; color: #5D6A63; }
  .pawsorb-pdp__psave { padding: 3px 9px; border-radius: 6px; background: var(--pawsorb-pdp-accent, #12855A); color: #fff; font: 700 12px/1.4 var(--font-body--family); letter-spacing: .03em; }
  .pawsorb-pdp__sub { margin: 0; font-size: 17px; line-height: 1.45; color: #141816; }
  .pawsorb-pdp__bullets { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pawsorb-pdp__bullets li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.4; }
  .pawsorb-pdp__chk { flex: 0 0 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: rgba(18, 133, 90, .12); color: #12855A; }
  .pawsorb-pdp__stock { display: grid; gap: 6px; }
  .pawsorb-pdp__stockrow { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; font-weight: 600; }
  .pawsorb-pdp__stocklabel { display: inline-flex; align-items: center; gap: 7px; color: #141816; }
  .pawsorb-pdp__stockfill { color: var(--pawsorb-pdp-accent, #12855A); }
  .pawsorb-pdp__pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--pawsorb-pdp-accent, #12855A); box-shadow: 0 0 0 0 rgba(18, 133, 90, .5); animation: pawsorb-pdp-pulse 1.8s infinite; }
  @keyframes pawsorb-pdp-pulse { 70% { box-shadow: 0 0 0 7px rgba(18, 133, 90, 0); } 100% { box-shadow: 0 0 0 0 rgba(18, 133, 90, 0); } }
  .pawsorb-pdp__bar { height: 7px; border-radius: 999px; background: #DCEBE3; overflow: hidden; }
  .pawsorb-pdp__bar span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2BD08F, var(--pawsorb-pdp-accent, #12855A)); }
  .pawsorb-pdp__stockmicro { margin: 0; font-size: 13px; color: #5D6A63; }
  .pawsorb-pdp__form { margin: 0; }
  .pawsorb-pdp__atc {
    position: relative; width: 100%; min-height: 58px; border: 0; border-radius: 10px; cursor: pointer;
    background: var(--pawsorb-pdp-accent, #12855A); color: #fff; font: 700 17px/1 var(--font-heading--family); letter-spacing: .05em;
    box-shadow: 0 6px 16px rgba(18, 133, 90, .25); transition: filter .15s, transform .15s;
  }
  .pawsorb-pdp__atc:hover { background: #0C5E40; }
  .pawsorb-pdp__atc:active { transform: translateY(1px); }
  .pawsorb-pdp__atc:focus-visible { outline: 2px solid #121614; outline-offset: 3px; }
  .pawsorb-pdp__atc[disabled] { opacity: .55; cursor: not-allowed; box-shadow: none; }
  .pawsorb-pdp__spinner { display: none; position: absolute; right: 20px; top: 50%; width: 18px; height: 18px; margin-top: -9px; border: 2px solid rgba(255, 255, 255, .4); border-top-color: #fff; border-radius: 50%; animation: pawsorb-pdp-spin .7s linear infinite; }
  .pawsorb-pdp__atc.is-loading .pawsorb-pdp__spinner { display: block; }
  @keyframes pawsorb-pdp-spin { to { transform: rotate(360deg); } }
  .pawsorb-pdp__err { margin: 8px 0 0; font-size: 14px; color: #12855A; }
  .pawsorb-pdp__trust { list-style: none; margin: -2px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 8px; }
  .pawsorb-pdp__trust li { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; line-height: 1.25; color: #121614; }
  .pawsorb-pdp__trust .pawsorb-icon { flex: 0 0 auto; color: #12855A; }
  .pawsorb-pdp__pay { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .pawsorb-pdp__pay svg { width: 38px; height: 24px; }
  @media screen and (max-width: 989px) {
    .pawsorb-pdp__grid { gap: 28px; }
    .pawsorb-pdp__title { font-size: 28px; }
  }
  @media screen and (max-width: 749px) {
    .pawsorb-pdp { padding: 0 0 var(--pawsorb-pdp-pb, 32px); }
    .pawsorb-pdp__grid { grid-template-columns: 1fr; gap: 16px; }
    .pawsorb-pdp__gallery { position: static; }
    .pawsorb-pdp__track { border-radius: 0; }
    .pawsorb-pdp__dots { display: flex; }
    .pawsorb-pdp__thumbs { padding: 0 16px; }
    .pawsorb-pdp__thumb { flex-basis: 60px; width: 60px; height: 60px; }
    .pawsorb-pdp__info { padding: 0 16px; gap: 12px; }
    .pawsorb-pdp__title { font-size: 26px; }
    .pawsorb-pdp__sub { font-size: 16px; }
    .pawsorb-pdp__fam { flex-basis: 100%; }
    .pawsorb-pdp__fam::before { display: none; }
    .pawsorb-pdp__trust { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .pawsorb-pdp__trust li { flex-direction: column; text-align: center; font-size: 12px; gap: 4px; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('pawsorb-buy-box')) {
    customElements.define('pawsorb-buy-box', class extends HTMLElement {
      connectedCallback() {
        this.qty = this.querySelector('[data-pawsorb-qty]');
        const atc = this.querySelector('[data-pawsorb-atc]');
        this.form = this.querySelector('[data-pawsorb-form]') || (atc && atc.form);
        this.addEventListener('change', this.onTier);
        if (this.form) this.form.addEventListener('submit', this.onSubmit);
        this.initGallery();
        const cur = this.querySelector('.pawsorb-bp__input:checked');
        if (cur) this.apply(cur, false);
      }
      money(cents) {
        const n = (Number(cents) || 0) / 100;
        return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      onTier = (e) => {
        const i = e.target;
        if (!(i instanceof HTMLInputElement) || !i.classList.contains('pawsorb-bp__input')) return;
        this.apply(i, true);
      };
      apply(i, user) {
        this.querySelectorAll('.pawsorb-bp__tier').forEach((t) => t.classList.toggle('is-selected', t.contains(i)));
        if (this.qty) this.qty.value = i.dataset.qty;
        const box = this.querySelector('.pawsorb-bp__savings');
        if (box) {
          const saved = Number(i.dataset.saved) || 0;
          box.classList.toggle('is-hidden', saved <= 0);
          const out = box.querySelector('[data-pawsorb-savings]');
          if (out) out.textContent = (box.dataset.template || '').replace('[savings]', this.money(saved));
        }
        const detail = { title: i.dataset.title, weight: i.dataset.weight, price: i.dataset.price, qty: Number(i.dataset.qty) };
        window.pawsorbTier = detail;
        document.dispatchEvent(new CustomEvent('pawsorb:tier', { detail }));
      }
      onSubmit = async (e) => {
        e.preventDefault();
        const btn = this.querySelector('[data-pawsorb-atc]');
        const err = this.querySelector('[data-pawsorb-err]');
        const fd = new FormData(this.form);
        const sel = this.querySelector('.pawsorb-bp__input:checked');
        const item = { id: Number(fd.get('id')), quantity: Number(fd.get('quantity')) || 1 };
        if (sel && sel.dataset.title) item.properties = { _Bundle: sel.dataset.title };
        if (btn) { btn.classList.add('is-loading'); btn.disabled = true; }
        if (err) err.hidden = true;
        try {
          const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
          const res = await fetch(root + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [item] }) });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.description || data.message || 'Could not add to cart');
          document.dispatchEvent(new CustomEvent('pawsorb:cart-open', { detail: { added: true } }));
        } catch (ex) {
          if (location.protocol === 'file:') {
            document.dispatchEvent(new CustomEvent('pawsorb:cart-open', { detail: { added: true, mock: item } }));
          } else if (err) { err.textContent = ex.message; err.hidden = false; }
        } finally {
          if (btn) { btn.classList.remove('is-loading'); btn.disabled = false; }
        }
      };
      initGallery() {
        const track = this.querySelector('[data-pawsorb-track]');
        if (!track) return;
        const thumbs = [...this.querySelectorAll('.pawsorb-pdp__thumb')];
        const dots = [...this.querySelectorAll('.pawsorb-pdp__dotx')];
        const setActive = (idx) => {
          thumbs.forEach((t, n) => t.classList.toggle('is-active', n === idx));
          dots.forEach((d, n) => d.classList.toggle('is-active', n === idx));
        };
        thumbs.forEach((t) => t.addEventListener('click', () => {
          const idx = Number(t.dataset.index) || 0;
          track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
          setActive(idx);
        }));
        let raf = 0;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => setActive(Math.round(track.scrollLeft / Math.max(1, track.clientWidth))));
        }, { passive: true });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PawSorb buy box",
  "tag": "section",
  "class": "pawsorb-section-main",
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "title", "label": "Tier title", "default": "Buy 3" },
        { "type": "range", "id": "quantity", "label": "Tubes added to cart", "min": 1, "max": 20, "step": 1, "default": 3, "info": "Checkout price = variant price x this quantity minus the matching automatic discount (Discounts > Amount off products, minimum quantity = this number)." },
        { "type": "text", "id": "weight_label", "label": "Weight label", "default": "Dogs 61–80lbs" },
        { "type": "text", "id": "unit_line", "label": "Per-unit line", "default": "$24.99 each + FREE shipping" },
        { "type": "text", "id": "price", "label": "Tier price (text)", "default": "$74.97", "info": "Shown on the card. Must equal the cart total after the automatic discount for this quantity." },
        { "type": "text", "id": "compare_price", "label": "Compare-at price (text)", "default": "$179.97", "info": "Usually the single-unit compare-at price x quantity. Savings = compare-at minus tier price." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "MOST POPULAR" },
        { "type": "checkbox", "id": "preselect", "label": "Selected on page load", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Product info" },
    { "type": "text", "id": "title_override", "label": "Title (blank = product title)", "info": "The ™ sign is shown in the accent color." },
    { "type": "text", "id": "pill", "label": "Vet pill", "default": "Veterinary professionals' #1 pick" },
    { "type": "text", "id": "rating_text", "label": "Rating line", "default": "4.9 ★ · 4,554 reviews" },
    { "type": "text", "id": "families_text", "label": "Homes line", "default": "Ready in 115,000+ homes" },
    { "type": "text", "id": "price_text", "label": "Single-unit price (text)", "default": "$39.99" },
