{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-f60" style="--pawsorb-f60-pt: {{ ss.padding_top }}px; --pawsorb-f60-pb: {{ ss.padding_bottom }}px; --pawsorb-f60-bg: {{ ss.bg_color }}; --pawsorb-f60-fg: {{ ss.text_color }}; --pawsorb-f60-accent: {{ ss.accent_color }};">
  <div class="pawsorb-f60__inner">
    {%- if ss.heading != blank -%}<h2 class="pawsorb-f60__h">{{ ss.heading }}</h2>{%- endif -%}
    {%- if ss.old_plan != blank or ss.new_plan != blank -%}
      <p class="pawsorb-f60__plan">
        {%- assign olds = ss.old_plan | split: '|' -%}
        {%- for o in olds -%}{%- assign ot = o | strip -%}{%- if ot != blank -%}<s>{{ ot }}</s> {% endif -%}{%- endfor -%}
        {%- if ss.new_plan != blank -%}<strong>{{ ss.new_plan }}</strong>{%- endif -%}
      </p>
    {%- endif -%}
    <ol class="pawsorb-f60__steps" data-pawsorb-rail>
      {%- for block in section.blocks -%}
        <li class="pawsorb-f60__step" {{ block.shopify_attributes }}>
          <div class="pawsorb-f60__media">
            {% render 'pawsorb-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.alt, ratio: '4 / 5', icon: block.settings.icon, tone: 'tint', sizes: '(min-width: 750px) 280px, 70vw', anim_image: block.settings.anim_image, anim_asset: block.settings.anim_asset %}
            <span class="pawsorb-f60__num">{{ forloop.index }}</span>
          </div>
          <h3 class="pawsorb-f60__t">{{ block.settings.title }}</h3>
          <p class="pawsorb-f60__b">{{ block.settings.body }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if ss.micro_1 != blank or ss.micro_2 != blank -%}
      <div class="pawsorb-f60__micro">
        {%- if ss.micro_1 != blank -%}<p>{% render 'pawsorb-icon', name: 'home', size: 18 %}<span>{{ ss.micro_1 }}</span></p>{%- endif -%}
        {%- if ss.micro_2 != blank -%}<p>{% render 'pawsorb-icon', name: 'clock', size: 18 %}<span>{{ ss.micro_2 }}</span></p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-f60 { padding: var(--pawsorb-f60-pt, 64px) 0 var(--pawsorb-f60-pb, 64px); background: var(--pawsorb-f60-bg, #fff); color: var(--pawsorb-f60-fg, #141816); }
  .pawsorb-f60__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-f60__h { margin: 0 0 10px; text-align: center; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-f60__plan { margin: 0 auto 28px; text-align: center; font-size: 17px; line-height: 1.5; color: #5D6A63; }
  .pawsorb-f60__plan s { text-decoration-color: var(--pawsorb-f60-accent, #12855A); text-decoration-thickness: 2px; margin-right: 4px; }
  .pawsorb-f60__plan strong { color: var(--pawsorb-f60-fg, #141816); }
  .pawsorb-f60__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .pawsorb-f60__step { min-width: 0; }
  .pawsorb-f60__media { position: relative; }
  .pawsorb-f60__num { position: absolute; top: 10px; left: 10px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--pawsorb-f60-accent, #12855A); color: #fff; font: 700 16px/1 var(--font-heading--family); box-shadow: 0 2px 6px rgba(0, 0, 0, .15); }
  .pawsorb-f60__t { margin: 12px 0 4px; font: 700 18px/1.25 var(--font-heading--family); color: inherit; }
  .pawsorb-f60__b { margin: 0; font-size: 15px; line-height: 1.5; color: #3A443F; }
  .pawsorb-f60__micro { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 24px; margin-top: 26px; }
  .pawsorb-f60__micro p { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 15px; font-weight: 600; color: #121614; }
  .pawsorb-f60__micro .pawsorb-icon { flex: 0 0 auto; color: #12855A; }
  @media screen and (max-width: 749px) {
    .pawsorb-f60 { padding: calc(var(--pawsorb-f60-pt, 64px) * .75) 0 calc(var(--pawsorb-f60-pb, 64px) * .75); }
    .pawsorb-f60__h { font-size: 26px; }
    .pawsorb-f60__plan { font-size: 15px; margin-bottom: 20px; }
    .pawsorb-f60__steps { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; gap: 12px; margin: 0 -16px; padding: 0 16px; cursor: grab; overscroll-behavior-x: contain; }
    .pawsorb-f60__steps::-webkit-scrollbar { display: none; }
    .pawsorb-f60__steps.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
    .pawsorb-f60__step { flex: 0 0 68%; scroll-snap-align: start; }
    .pawsorb-f60__micro { flex-direction: column; align-items: flex-start; }
    .pawsorb-f60__micro p { font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb first 60 seconds",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Wipe the mouth" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Toad? Wipe the gums with a damp cloth, front to back." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme file", "default": "pawsorb-step-1-wipe.jpg", "info": "File in assets/. Until it exists, an icon tile is shown." },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Hand wiping a dog's gums with a damp cloth" },
        { "type": "image_picker", "id": "anim_image", "label": "Animation (looping WebP)" },
        { "type": "text", "id": "anim_asset", "label": "Animation theme file", "info": "Looping animated WebP in assets/, shown over the still. Hidden when the visitor prefers reduced motion or the file is missing." },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "cloth", "options": [
          { "value": "cloth", "label": "Cloth" }, { "value": "dial", "label": "Dial" }, { "value": "tube", "label": "Tube" },
          { "value": "phone", "label": "Phone" }, { "value": "car", "label": "Car" }, { "value": "paw", "label": "Paw" } ] }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first 60 seconds, planned out." },
    { "type": "text", "id": "old_plan", "label": "Old plan (crossed out)", "default": "Rinse and rush.|Peroxide.|Six Google tabs.", "info": "Separate items with |" },
    { "type": "text", "id": "new_plan", "label": "New plan", "default": "One tube, four moves." },
    { "type": "text", "id": "micro_1", "label": "Micro line 1", "default": "Grandma, the sitter or your teenager can do it. The steps are on the tube." },
    { "type": "text", "id": "micro_2", "label": "Micro line 2", "default": "Recap, back in the drawer. Good for 2 years." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Step number", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb first 60 seconds",
      "blocks": [
        { "type": "step", "settings": { "title": "Wipe the mouth", "body": "Toad? Wipe the gums with a damp cloth, front to back.", "image_asset": "pawsorb-step-1-wipe.jpg", "alt": "Hand wiping a dog's gums with a damp cloth", "icon": "cloth" } },
        { "type": "step", "settings": { "title": "Dial the weight", "body": "Twist until the ring shows his pounds. 1 mL per lb, done.", "image_asset": "pawsorb-step-2-dial.jpg", "alt": "Hands turning the PawSorb weight dial", "icon": "dial" } },
        { "type": "step", "settings": { "title": "Squeeze into the cheek", "body": "Tip behind the back teeth, press. Picky eater? Smear it on a treat.", "image_asset": "pawsorb-step-3-squeeze.jpg", "alt": "PawSorb tip resting behind a dog's back teeth", "icon": "tube" } },
        { "type": "step", "settings": { "title": "Call and drive", "body": "Now phone the vet or a poison line, with the help already in.", "image_asset": "pawsorb-step-4-call.jpg", "alt": "Woman on the phone with car keys, dog on leash at the door", "icon": "phone" } }
      ]
    }
  ]
}
{% endschema %}
