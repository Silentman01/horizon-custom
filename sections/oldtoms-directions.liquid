{%- liquid
  assign s = section.settings
  assign cards = section.blocks | where: 'type', 'size'
  assign steps = section.blocks | where: 'type', 'step'
-%}
<div class="ot-directions" style="{% render 'oldtoms-vars' %}--ot-pt:{{ s.padding_top }}px;--ot-pb:{{ s.padding_bottom }}px;">
  <div class="ot-directions__panel">
    {%- if s.heading != blank -%}<h2 class="ot-directions__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.intro != blank -%}<p class="ot-directions__intro">{{ s.intro }}</p>{%- endif -%}
    {%- if s.show_steps and steps.size > 0 -%}
      <ol class="ot-directions__steps">
        {%- for block in steps -%}
          <li class="ot-directions__step" {{ block.shopify_attributes }}><span class="ot-directions__step-n">{{ forloop.index }}</span><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    <div class="ot-directions__cards">
      {%- for block in cards -%}
        <article class="ot-directions__card" {{ block.shopify_attributes }}>
          <p class="ot-directions__bar">{{ block.settings.title }}</p>
          <div class="ot-directions__art">{% render 'oldtoms-media', image: block.settings.image, asset: block.settings.asset, ratio: '4 / 3', alt: block.settings.title, sizes: '(min-width: 750px) 250px, 45vw' %}</div>
          <p class="ot-directions__count">{{ block.settings.count }}</p>
          <p class="ot-directions__caption">{{ block.settings.caption }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if s.banner_text != blank -%}
      <div class="ot-directions__banner">
        {%- if s.banner_label != blank -%}<p class="ot-directions__banner-label">{{ s.banner_label }}</p>{%- endif -%}
        <p class="ot-directions__banner-text">{{ s.banner_text }}</p>
      </div>
    {%- endif -%}
  </div>
  {%- if s.show_cta -%}
    <div class="ot-directions__cta">{% render 'oldtoms-cta', label: s.cta_label, guarantee: s.cta_guarantee %}</div>
  {%- endif -%}
</div>

{% stylesheet %}
.ot-directions { background: #f4f4f0; color: #23372b; font-family: var(--ot-font); padding: var(--ot-pt, 32px) 12px var(--ot-pb, 48px); }
.ot-directions__panel { max-width: 1312px; margin: 0 auto; padding: 28px 12px; border-radius: 20px; background: #fff; }
.ot-directions__heading { margin: 0 0 10px; text-align: center; font-family: var(--ot-font-heading); font-weight: 400; font-size: 36px; line-height: 1.1; }
.ot-directions__intro { margin: 0 auto 22px; max-width: 440px; text-align: center; font-size: 14px; line-height: 1.5; }
.ot-directions__steps { display: grid; gap: 10px; margin: 0 auto 22px; padding: 0; max-width: 860px; list-style: none; }
.ot-directions__step { display: grid; grid-template-columns: 28px auto 1fr; align-items: center; gap: 4px 10px; font-size: 13px; line-height: 1.4; }
.ot-directions__step-n { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #23372b; color: #ccf46f; font-size: 12px; font-weight: 700; }
.ot-directions__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 1100px; margin: 0 auto; }
.ot-directions__card { display: flex; flex-direction: column; border: 1px solid #24433d; border-radius: 8px; overflow: hidden; background: #fff; text-align: center; }
.ot-directions__bar { margin: 0; padding: 8px 6px; background: #ccf46f; color: #24433d; font-size: 11px; font-weight: 700; line-height: 1.3; }
.ot-directions__art { padding: 10px 10px 4px; }
.ot-directions__art .ot-media { border-radius: 6px; }
.ot-directions__art .ot-media > img { object-fit: contain; }
.ot-directions__count { margin: 6px auto 0; padding: 3px 10px; border-radius: 3px; background: #23372b; color: #ccf46f; font-size: 11px; font-weight: 700; text-transform: uppercase; }
.ot-directions__caption { margin: 8px 8px 12px; font-size: 11px; line-height: 1.35; color: #707070; }
.ot-directions__banner { max-width: 1100px; margin: 14px auto 0; padding: 14px 16px; border-radius: 4px; background: #23372b; text-align: center; }
.ot-directions__banner-label { margin: 0 0 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #7fa93f; }
.ot-directions__banner-text { margin: 0; font-family: var(--ot-font-heading); font-size: 15px; line-height: 1.35; color: #fff; }
.ot-directions__cta { max-width: 700px; margin: 28px auto 0; }
@media screen and (min-width: 750px) {
  .ot-directions { padding-inline: 64px; }
  .ot-directions__panel { padding: 60px 40px; }
  .ot-directions__heading { font-size: 44px; }
  .ot-directions__steps { grid-template-columns: repeat(3, 1fr); }
  .ot-directions__cards { grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .ot-directions__banner { margin-top: 28px; }
  .ot-directions__banner-text { font-size: 17px; }
  .ot-directions__cta { margin-top: 44px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Old Tom's directions",
  "tag": "section",
  "class": "ot-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Directions Of Use" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Our concentrated 4-oil formula starts working within 72 hours — and keeps mice away for 90 days straight. Here's exactly how to use it." },
    { "type": "checkbox", "id": "show_steps", "label": "Show the Open / Place / Replace steps", "default": true },
    { "type": "text", "id": "banner_label", "label": "Banner label", "default": "Our recommendation" },
    { "type": "text", "id": "banner_text", "label": "Banner text", "default": "We recommend replacing pouches every 90 days for continuous protection" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show add to cart button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "cta_guarantee", "label": "Guarantee line", "default": "30-Day Money Back Guarantee" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Small Caravan or Room" },
        { "type": "text", "id": "count", "label": "Pouch count", "default": "1 Pouch" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Every entry point covered" },
        { "type": "image_picker", "id": "image", "label": "Illustration" },
        { "type": "text", "id": "asset", "label": "Theme asset filename (used when no illustration is picked)", "default": "oldtoms-directions-1.png" }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Open" },
        { "type": "text", "id": "text", "label": "Text", "default": "Tear the bag at the notch and take out a pouch." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Old Tom's directions",
      "blocks": [
        { "type": "step", "settings": { "title": "Open", "text": "Tear the bag at the notch and take out a pouch." } },
        { "type": "step", "settings": { "title": "Place", "text": "Put pouches every 2.5–3 metres along entry points, corners and dark spots." } },
        { "type": "step", "settings": { "title": "Replace", "text": "Swap for fresh pouches every 90 days." } },
        { "type": "size", "settings": { "title": "Small Caravan or Room", "count": "1 Pouch", "caption": "Every entry point covered", "asset": "oldtoms-directions-1.png" } },
        { "type": "size", "settings": { "title": "Full House", "count": "2-3 Pouches", "caption": "Every room + garage + cellar", "asset": "oldtoms-directions-3.png" } },
        { "type": "size", "settings": { "title": "Large House + Outbuildings", "count": "4-6 Pouches", "caption": "House + shed + your garage", "asset": "oldtoms-directions-6.png" } },
        { "type": "size", "settings": { "title": "Farm / Full Property", "count": "8+ Pouches", "caption": "Barn + feed store + perimeter", "asset": "oldtoms-directions-8.png" } }
      ]
    }
  ]
}
{% endschema %}
