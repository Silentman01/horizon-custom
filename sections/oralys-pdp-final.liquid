{%- liquid
  assign s = section.settings
  assign h = s.heading
  if s.accent != blank
    assign acc = '<em>' | append: s.accent | append: '</em>'
    assign h = h | replace: s.accent, acc
  endif
-%}
{%- assign ticks = s.ticks | newline_to_br | split: '<br />' -%}
<div class="oralys-pdp-final" style="--op-bg:{{ s.c_bg }};--op-text:{{ s.c_text }};--op-accent:{{ s.c_accent }};--op-muted:{{ s.c_muted }};--op-card:{{ s.c_card }};--op-line:{{ s.c_line }};--op-cta:{{ s.c_cta }};--op-cta-text:{{ s.c_cta_text }};--op-h-m:{{ s.h_m }}px;--op-h-d:{{ s.h_d }}px;--op-body:{{ s.body_size }}px;--op-align:{{ s.align }};--op-pt-m:{{ s.pt_m }}px;--op-pb-m:{{ s.pb_m }}px;--op-pt-d:{{ s.pt_d }}px;--op-pb-d:{{ s.pb_d }}px">
  <div class="oralys-pdp-final__inner">
    {%- if s.image != blank or s.asset != blank -%}<div class="oralys-pdp-final__pack">{% render 'oralys-pdp-media', image: s.image, asset: s.asset, alt: s.alt, class: 'oralys-pdp-final__pimg', loading: 'lazy', width: 600, height: 600 %}{% if s.seal != blank %}<span class="oralys-pdp-final__seal">{% render 'oralys-pdp-icon', name: 'shield', size: 18 %}{{ s.seal }}</span>{% endif %}</div>{%- endif -%}
    <div class="oralys-pdp-final__copy">
      <h2 class="oralys-pdp-final__h">{{ h }}</h2>
      <ul class="oralys-pdp-final__ticks" role="list">{% for t in ticks %}{% assign ts = t | strip %}{% if ts != blank %}<li><span class="oralys-pdp-final__tk" aria-hidden="true"><svg viewBox="0 0 24 24" width="13" height="13"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ ts }}</li>{% endif %}{% endfor %}</ul>
      {%- if s.tiers != blank %}<p class="oralys-pdp-final__tiers">{{ s.tiers }}</p>{% endif -%}
      {%- if s.cta != blank %}<a class="oralys-pdp-final__btn" href="#oralys-pdp-offer">{{ s.cta }}</a>{% endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.oralys-pdp-final{background:var(--op-bg);color:var(--op-text);padding:var(--op-pt-m) 16px var(--op-pb-m);font-family:var(--font-body--family);font-size:var(--op-body);line-height:1.55}
.oralys-pdp-final *{box-sizing:border-box}
@media (min-width:750px){.oralys-pdp-final{padding:var(--op-pt-d) 32px var(--op-pb-d)}}
.oralys-pdp-final__inner{max-width:1000px;margin:0 auto}
.oralys-pdp-final__head{text-align:var(--op-align);margin:0 0 24px}
.oralys-pdp-final__eyebrow{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--op-accent);margin:0 0 10px}
.oralys-pdp-final__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--op-h-m);line-height:1.22;margin:0;color:var(--op-text);text-wrap:balance}
.oralys-pdp-final__h em{font-style:normal;color:var(--op-accent)}
@media (min-width:750px){.oralys-pdp-final__h{font-size:var(--op-h-d)}}
.oralys-pdp-final__btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--op-cta);color:var(--op-cta-text);font-weight:700;font-size:18px;text-decoration:none;border:0;width:100%;transition:transform .15s}
.oralys-pdp-final__btn:hover{transform:translateY(-1px)}
@media (min-width:750px){.oralys-pdp-final__btn{display:inline-flex;width:auto;min-width:320px}}

.oralys-pdp-final__inner{display:grid;gap:24px;justify-items:center;text-align:var(--op-align)}
@media (min-width:750px){.oralys-pdp-final__inner{grid-template-columns:280px 1fr;align-items:center;text-align:left;justify-items:start;gap:48px}}
.oralys-pdp-final__pack{position:relative;width:180px;aspect-ratio:1/1;border-radius:50%;background:var(--op-card);overflow:visible}
@media (min-width:750px){.oralys-pdp-final__pack{width:260px}}
.oralys-pdp-final__pimg{width:100%;height:100%;object-fit:contain;display:block;border-radius:50%;padding:16%}
.oralys-pdp-final__seal{position:absolute;left:50%;bottom:-12px;transform:translateX(-50%);display:inline-flex;gap:6px;align-items:center;white-space:nowrap;padding:6px 12px;border-radius:999px;background:var(--op-accent);color:#0E3D30;font-weight:800;font-size:13px}
.oralys-pdp-final__copy{display:grid;gap:16px;justify-items:inherit}
.oralys-pdp-final__ticks{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:8px 18px}
@media (min-width:750px){.oralys-pdp-final__ticks{justify-content:flex-start}}
.oralys-pdp-final__ticks li{display:flex;gap:8px;align-items:center;font-weight:600}
.oralys-pdp-final__tk{flex:0 0 22px;width:22px;height:22px;border-radius:50%;background:var(--op-accent);color:#0E3D30;display:inline-flex;align-items:center;justify-content:center}
.oralys-pdp-final__tiers{margin:0;color:var(--op-muted);font-size:15.5px}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : appel final",
  "tag": "section",
  "class": "oralys-pdp-final-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Demain matin, posez-le. Le soir, il sera toujours là."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Mot du titre en couleur accent"
    },
    {
      "type": "textarea",
      "id": "ticks",
      "label": "Points forts (un par ligne)",
      "default": "Même le dentier du bas\nZéro colle, zéro zinc\n90 jours satisfait ou remboursé"
    },
    {
      "type": "text",
      "id": "tiers",
      "label": "Rappel des packs",
      "default": "Dès 39,95 € · 2 tubes, le 2e à -70 % · 4 tubes, 2 achetés = 2 offerts"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Bouton",
      "default": "Je choisis mon pack"
    },
    {
      "type": "text",
      "id": "seal",
      "label": "Sceau",
      "default": "Garantie 90 jours"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Packshot"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Packshot : fichier du thème",
      "default": "oralys-pdp-packshot.webp",
      "info": "Utilisé si aucune image n'est choisie (fichier dans assets/)."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Packshot : texte alternatif",
      "default": "Tube Oralys Gel sur fond vert menthe"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#0E3D30"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_accent",
      "label": "Accent (mot du titre, icônes)",
      "default": "#7FD1AE"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Texte secondaire",
      "default": "#CFE3DA"
    },
    {
      "type": "color",
      "id": "c_card",
      "label": "Fond des cartes",
      "default": "#EEF6F1"
    },
    {
      "type": "color",
      "id": "c_line",
      "label": "Bordures",
      "default": "#2C5A4C"
    },
    {
      "type": "color",
      "id": "c_cta",
      "label": "Bouton : fond",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_cta_text",
      "label": "Bouton : texte",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typo et espacements"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Titre : taille mobile",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Titre : taille ordinateur",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Texte : taille",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement des titres",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Marge haute mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Marge basse mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Marge haute ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Marge basse ordinateur",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Oralys : appel final"
    }
  ]
}
{% endschema %}
