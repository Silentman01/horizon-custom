{%- assign s = section.settings -%}
<section class="mojo-fq" style="{% render 'mojo-vars' %}--mojo-pt:{{ s.padding_top }}px;--mojo-pb:{{ s.padding_bottom }}px;">
  <div class="mojo-fq__wrap">
    {%- if s.heading != blank -%}<h2 class="mojo-fq__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="mojo-fq__sub">{{ s.subheading }}</p>{%- endif -%}
    <div class="mojo-fq__list">
      {%- for block in section.blocks -%}
        <details class="mojo-fq__item" name="mojo-faq-{{ section.id }}"{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="mojo-fq__q"><span>{{ block.settings.question }}</span><span class="mojo-fq__plus" aria-hidden="true"></span></summary>
          <div class="mojo-fq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.mojo-fq { background: var(--mojo-bg); color: var(--mojo-fg); font-family: var(--mojo-font); padding: var(--mojo-pt) 20px var(--mojo-pb); }
.mojo-fq__wrap { max-width: 650px; margin: 0 auto; }
.mojo-fq__heading { font-family: var(--mojo-font-heading); font-weight: 600; font-size: 28px; line-height: 1.2; text-align: center; margin: 0 0 28px; }
.mojo-fq__sub { margin: -16px 0 24px; text-align: center; font-size: 13px; color: var(--mojo-muted); }
.mojo-fq__list { border-top: 1px solid var(--mojo-line); }
.mojo-fq__item { border-bottom: 1px solid var(--mojo-line); }
.mojo-fq__q { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; cursor: pointer; list-style: none; font-size: 16px; line-height: 1.35; }
.mojo-fq__q::-webkit-details-marker { display: none; }
.mojo-fq__plus { position: relative; width: 14px; height: 14px; flex: none; }
.mojo-fq__plus::before, .mojo-fq__plus::after { content: ''; position: absolute; background: currentcolor; left: 0; right: 0; top: 50%; height: 1px; }
.mojo-fq__plus::after { transform: rotate(90deg); transition: transform 0.2s; }
.mojo-fq__item[open] .mojo-fq__plus::after { transform: rotate(0); }
.mojo-fq__q:focus-visible { outline: 2px solid currentcolor; outline-offset: 2px; }
.mojo-fq__a { padding: 0 0 18px; font-size: 14px; line-height: 1.7; color: var(--mojo-muted); }
.mojo-fq__a p { margin: 0 0 10px; }
@media screen and (min-width: 750px) {
  .mojo-fq__heading { font-size: 26px; }
  .mojo-fq__q { font-size: 13px; padding: 24px 0; }
  .mojo-fq__a { font-size: 12px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo FAQ",
  "tag": "section",
  "class": "mojo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 52,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading (optional)"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is silk and why is it used for boxer shorts?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Silk is a natural protein fibre known for its softness, breathability and lovely sheen.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Mojo FAQ",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
