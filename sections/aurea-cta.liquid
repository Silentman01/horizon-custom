<section class="au-cta" style="{% render 'aurea-vars' %}" {{ section.shopify_attributes }}>
  <div class="au-cta__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="au-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {% render 'aurea-title', text: section.settings.heading, class: 'au-cta__h' %}
    <p class="au-cta__text">{{ section.settings.text }}</p>
    {%- if section.settings.button_label != blank -%}
      <a class="au-btn au-cta__btn" href="{{ section.settings.button_link | default: '#MainContent' }}">{% render 'aurea-icon', name: 'cart' %}{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
  .au-cta { padding: 32px 16px 48px; background: var(--au-bg); }
  .au-cta__inner { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .au-cta__inner .au-eyebrow { margin: 0; }
  .au-cta__h { font-size: clamp(28px, 5vw, 44px); }
  .au-cta__text { margin: 0; font-size: 16px; line-height: 1.5; color: rgb(from var(--au-ink) r g b / 0.8); }
  .au-cta__btn { padding: 16px 40px; border-radius: 14px; }
  .au-cta__btn .au-icon { width: 20px; height: 20px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "This moon's batch closes soon" },
    { "type": "text", "id": "heading", "label": "Heading (*word* = gold italic)", "default": "Start drawing in *prosperity* today" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join thousands already wearing their Aurea bracelet. Backed by our 30-day money-back guarantee." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my bracelet" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#MainContent" }
  ],
  "presets": [ { "name": "Aurea final CTA" } ]
}
{% endschema %}
