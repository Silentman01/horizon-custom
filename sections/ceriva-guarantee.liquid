<div
  class="cv cv--{{ section.settings.tone }} cv-guar"
  style="{% render 'ceriva-tokens' %} --cv-pt: {{ section.settings.padding_top }}px; --cv-pb: {{ section.settings.padding_bottom }}px; --cv-max: 860px;"
>
  <div class="cv__inner">
    <div class="cv-guar__card cv-reveal">
      <div
        class="cv-guar__seal"
        aria-hidden="true"
      >
        <svg viewBox="0 0 96 96">
          <circle cx="48" cy="48" r="46" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 5"/>
          <circle cx="48" cy="48" r="38" fill="currentColor"/>
          <text x="48" y="47" text-anchor="middle" font-size="22" font-weight="700" fill="#fff" font-family="inherit">{{ section.settings.seal_number }}</text>
          <text x="48" y="62" text-anchor="middle" font-size="9" font-weight="700" fill="#fff" letter-spacing="1" font-family="inherit">{{ section.settings.seal_label | upcase }}</text>
        </svg>
      </div>

      {%- if section.settings.eyebrow != blank -%}
        <p class="cv__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="cv__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="cv__sub">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        {% render 'ceriva-cta',
          label: section.settings.button_label,
          action: section.settings.button_action,
          url: section.settings.button_link,
          style: section.settings.button_style,
          class: 'cv-guar__btn'
        %}
      {%- endif -%}

      {%- if section.settings.ticks != blank -%}
        {%- assign ticks = section.settings.ticks | split: '|' -%}
        <ul class="cv-guar__ticks">
          {%- for tick in ticks -%}
            <li>
              {% render 'ceriva-check-icon' %}
              {{ tick | strip }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% render 'ceriva-script' %}

{% stylesheet %}
  .cv-guar__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 40px 20px;
    border: 1px solid var(--cv-line);
    border-radius: 16px;
    background: var(--cv-card);
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .cv-guar__card {
      padding: 56px 64px;
    }
  }

  .cv-guar__seal {
    width: 96px;
    height: 96px;
    margin-bottom: 4px;
    color: var(--cv-blue);
  }

  .cv-guar__seal svg {
    width: 100%;
    height: 100%;
  }

  .cv-guar .cv__sub {
    max-width: 560px;
  }

  .cv-guar__btn {
    margin-top: 10px;
    min-width: min(100%, 320px);
  }

  .cv-guar__ticks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    font-weight: 600;
  }

  .cv-guar__ticks li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .cv-guar__ticks .cv-check {
    width: 18px;
    height: 18px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ceriva — Garantie",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Fond",
      "options": [
        { "value": "white", "label": "Blanc" },
        { "value": "ice", "label": "Blanc glacé" },
        { "value": "navy", "label": "Bleu nuit" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "seal_number", "label": "Sceau : chiffre", "default": "30" },
    { "type": "text", "id": "seal_label", "label": "Sceau : libellé", "default": "jours" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Essai sans risque" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Satisfait ou remboursé" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "J'essaie Ceriva" },
    {
      "type": "select",
      "id": "button_action",
      "label": "Action du bouton",
      "options": [
        { "value": "offer", "label": "Remonter au choix de l'offre" },
        { "value": "cart", "label": "Ajouter l'offre choisie au panier" },
        { "value": "url", "label": "Lien personnalisé" }
      ],
      "default": "offer"
    },
    { "type": "url", "id": "button_link", "label": "Lien", "visible_if": "{{ section.settings.button_action == 'url' }}" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "primary", "label": "Plein" },
        { "value": "outline", "label": "Contour" }
      ],
      "default": "primary"
    },
    { "type": "text", "id": "ticks", "label": "Réassurances", "info": "Séparées par |", "default": "Livraison offerte | Remboursement intégral | Service client en France" },
    { "type": "header", "content": "Espacement" },
    { "type": "range", "id": "padding_top", "label": "Haut", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bas", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Ceriva — Garantie" }]
}
{% endschema %}
