{%- assign ss = section.settings -%}
<script src="{{ 'pawsorb-core.js' | asset_url }}" defer></script>
<div class="pawsorb-dd" style="--pawsorb-dd-pt: {{ ss.padding_top }}px; --pawsorb-dd-pb: {{ ss.padding_bottom }}px; --pawsorb-dd-bg: {{ ss.bg_color }}; --pawsorb-dd-fg: {{ ss.text_color }}; --pawsorb-dd-accent: {{ ss.accent_color }};">
  <div class="pawsorb-dd__inner">
    {%- if ss.heading != blank -%}<h2 class="pawsorb-dd__h">{{ ss.heading }}</h2>{%- endif -%}
    {%- if ss.rule_line != blank -%}<p class="pawsorb-dd__rule">{% render 'pawsorb-icon', name: 'dial', size: 18 %}<span>{{ ss.rule_line }}</span></p>{%- endif -%}
    <div class="pawsorb-dd__table" role="table" aria-label="{{ ss.heading | escape }}">
      <div class="pawsorb-dd__row pawsorb-dd__row--head" role="row">
        <span role="columnheader">{{ ss.col_weight }}</span>
        <span role="columnheader">{{ ss.col_tubes }}</span>
      </div>
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <div class="pawsorb-dd__row{% if bs.highlight %} is-hl{% endif %}" role="row" {{ block.shopify_attributes }}>
          <span class="pawsorb-dd__w" role="cell"><strong>{{ bs.weight }}</strong>{% if bs.note != blank %}<small>{{ bs.note }}</small>{% endif %}</span>
          <span class="pawsorb-dd__t" role="cell">
            <span class="pawsorb-dd__glyphs" aria-hidden="true">
              {%- assign gl = bs.glyphs | at_most: 5 -%}
              {%- for i in (1..gl) -%}{% render 'pawsorb-icon', name: 'tube', size: 22 %}{%- endfor -%}
              {%- if bs.glyphs > 5 -%}<em>+{{ bs.glyphs | minus: 5 }}</em>{%- endif -%}
            </span>
            <strong>{{ bs.tubes }}</strong>
          </span>
        </div>
      {%- endfor -%}
    </div>
    {%- if ss.callout != blank -%}<p class="pawsorb-dd__callout">{% render 'pawsorb-icon', name: 'paw', size: 20 %}<span>{{ ss.callout }}</span></p>{%- endif -%}
    {%- if ss.button_label != blank -%}
      <div class="pawsorb-dd__cta"><a class="pawsorb-dd__btn" href="{{ ss.button_link | default: '/products/pawsorb' }}" data-pawsorb-cta>{{ ss.button_label }}</a></div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .pawsorb-dd { padding: var(--pawsorb-dd-pt, 64px) 0 var(--pawsorb-dd-pb, 64px); background: var(--pawsorb-dd-bg, #fff); color: var(--pawsorb-dd-fg, #141816); }
  .pawsorb-dd__inner { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .pawsorb-dd__h { margin: 0 0 10px; text-align: center; font: 700 34px/1.15 var(--font-heading--family); color: inherit; letter-spacing: -.01em; }
  .pawsorb-dd__rule { display: block; margin: 0 0 24px; text-align: center; font-size: 16px; color: #3A443F; }
  .pawsorb-dd__rule .pawsorb-icon { display: inline-block; vertical-align: -4px; margin-right: 6px; color: var(--pawsorb-dd-accent, #12855A); }
  .pawsorb-dd__table { border: 1px solid #DCE6E0; border-radius: 12px; overflow: hidden; }
  .pawsorb-dd__row { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 12px; padding: 14px 18px; border-top: 1px solid #DCE6E0; background: #fff; }
  .pawsorb-dd__row--head { border-top: 0; background: #121614; color: #fff; font: 700 14px/1.3 var(--font-heading--family); letter-spacing: .02em; padding-block: 12px; }
  .pawsorb-dd__row.is-hl { background: rgba(18, 133, 90, .06); }
  .pawsorb-dd__w strong { display: block; font: 700 17px/1.3 var(--font-heading--family); }
  .pawsorb-dd__w small { display: block; font-size: 13px; color: #5D6A63; }
  .pawsorb-dd__t { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .pawsorb-dd__t strong { font: 700 16px/1.2 var(--font-heading--family); white-space: nowrap; }
  .pawsorb-dd__glyphs { display: inline-flex; align-items: center; gap: 0; color: var(--pawsorb-dd-accent, #12855A); }
  .pawsorb-dd__glyphs .pawsorb-icon { margin-right: -4px; }
  .pawsorb-dd__glyphs em { font-style: normal; font-size: 12px; font-weight: 700; margin-left: 6px; }
  .pawsorb-dd__callout { display: flex; gap: 10px; align-items: flex-start; margin: 18px 0 0; padding: 14px 16px; border-radius: 12px; background: #F1F6F3; font-size: 15px; line-height: 1.5; }
  .pawsorb-dd__callout .pawsorb-icon { flex: 0 0 auto; color: #121614; margin-top: 1px; }
  .pawsorb-dd__cta { text-align: center; margin-top: 22px; }
  .pawsorb-dd__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 30px; border-radius: 10px; background: var(--pawsorb-dd-accent, #12855A); color: #fff; font: 700 16px/1 var(--font-heading--family); text-decoration: none; letter-spacing: .02em; }
  .pawsorb-dd__btn:hover { background: #0C5E40; }
  @media screen and (max-width: 749px) {
    .pawsorb-dd { padding: calc(var(--pawsorb-dd-pt, 64px) * .75) 0 calc(var(--pawsorb-dd-pb, 64px) * .75); }
    .pawsorb-dd__h { font-size: 26px; }
    .pawsorb-dd__rule { font-size: 15px; margin-bottom: 18px; }
    .pawsorb-dd__row { padding: 12px 12px; grid-template-columns: 1fr auto; }
    .pawsorb-dd__w strong { font-size: 15px; }
    .pawsorb-dd__glyphs { display: none; }
    .pawsorb-dd__btn { width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PawSorb dose table",
  "tag": "section",
  "class": "pawsorb-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "row",
      "name": "Weight row",
      "settings": [
        { "type": "text", "id": "weight", "label": "Weight", "default": "61–80 lb" },
        { "type": "text", "id": "note", "label": "Small note" },
        { "type": "text", "id": "tubes", "label": "Tubes text", "default": "3 tubes" },
        { "type": "range", "id": "glyphs", "label": "Tube icons", "min": 1, "max": 10, "step": 1, "default": 3 },
        { "type": "checkbox", "id": "highlight", "label": "Highlight row", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How many tubes should you keep for your dog?" },
    { "type": "text", "id": "rule_line", "label": "Rule line", "default": "1 mL per pound. Each tube holds 30 mL. Bigger dog, more tubes on hand." },
    { "type": "text", "id": "col_weight", "label": "Column 1 header", "default": "Your dog's weight" },
    { "type": "text", "id": "col_tubes", "label": "Column 2 header", "default": "Tubes to keep on hand" },
    { "type": "textarea", "id": "callout", "label": "Callout", "default": "Two dogs and one empty wrapper? Add their weights together and pick the tier that covers both." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Choose my dog's size" },
    { "type": "url", "id": "button_link", "label": "Button link (pages without the picker)", "info": "On the product page the button scrolls to the bundle picker. Blank = /products/pawsorb" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141816" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#12855A" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "PawSorb dose table",
      "blocks": [
        { "type": "row", "settings": { "weight": "Under 30 lb", "note": "small dogs, puppies & cats", "tubes": "1 tube", "glyphs": 1 } },
        { "type": "row", "settings": { "weight": "31–60 lb", "tubes": "2 tubes", "glyphs": 2 } },
        { "type": "row", "settings": { "weight": "61–80 lb", "tubes": "3 tubes", "glyphs": 3, "highlight": true } },
        { "type": "row", "settings": { "weight": "81–150 lb", "tubes": "5 tubes", "glyphs": 5 } },
        { "type": "row", "settings": { "weight": "More than one dog", "tubes": "10 tubes", "glyphs": 10 } }
      ]
    }
  ]
}
{% endschema %}
