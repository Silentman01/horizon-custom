<section class="oralys-home-cost" style="--oh-bg:{{ section.settings.c_bg }};--oh-text:{{ section.settings.c_text }};--oh-accent:{{ section.settings.c_accent }};--oh-muted:{{ section.settings.c_muted }};--oh-card:{{ section.settings.c_card }};--oh-line:{{ section.settings.c_line }};--oh-cta:{{ section.settings.c_cta }};--oh-cta-text:{{ section.settings.c_cta_text }};--oh-h-m:{{ section.settings.h_m }}px;--oh-h-d:{{ section.settings.h_d }}px;--oh-body:{{ section.settings.body_size }}px;--oh-align:{{ section.settings.align }};--oh-pt-m:{{ section.settings.pt_m }}px;--oh-pb-m:{{ section.settings.pb_m }}px;--oh-pt-d:{{ section.settings.pt_d }}px;--oh-pb-d:{{ section.settings.pb_d }}px">
  <div class="oralys-home-cost__inner">
    <div class="oralys-home-cost__grid">
      <div>
        <div class="oralys-home-cost__head{% if section.settings.align == 'center' %} oralys-home-cost__head--center{% endif %}">{% if section.settings.eyebrow != blank %}<p class="oralys-home-cost__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="oralys-home-cost__h">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.subheading != blank %}<div class="oralys-home-cost__sub">{{ section.settings.subheading }}</div>{% endif %}</div>
        <ul class="oralys-home-cost__bars">
          {% for block in section.blocks %}
            <li class="oralys-home-cost__row{% if block.settings.highlight %} oralys-home-cost__row--on{% endif %}" {{ block.shopify_attributes }}>
              <div class="oralys-home-cost__lbl"><span>{{ block.settings.label }}</span><strong>{{ block.settings.amount }}</strong></div>
              <div class="oralys-home-cost__track"><span class="oralys-home-cost__bar" style="width:{{ block.settings.width }}%"></span></div>
            </li>
          {% endfor %}
        </ul>
        {% if section.settings.footnote != blank %}<p class="oralys-home-cost__foot">{{ section.settings.footnote }}</p>{% endif %}
      </div>
      {% if section.settings.call_text != blank %}
        <aside class="oralys-home-cost__call">
          {% if section.settings.call_title != blank %}<p class="oralys-home-cost__call-t">{{ section.settings.call_title }}</p>{% endif %}
          <div class="oralys-home-cost__call-x">{{ section.settings.call_text }}</div>
          {% if section.settings.cta_label != blank %}<a class="oralys-home-cost__btn oralys-home-cost__btn--full" href="{{ section.settings.cta_link | default: '/products/oralys-gel' }}">{{ section.settings.cta_label }}</a>{% endif %}
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
.oralys-home-cost{background:var(--oh-bg);color:var(--oh-text);padding:var(--oh-pt-m) 16px var(--oh-pb-m);font-family:var(--font-body--family);font-size:var(--oh-body);line-height:1.55}
.oralys-home-cost *{box-sizing:border-box}
@media (min-width:750px){.oralys-home-cost{padding:var(--oh-pt-d) 32px var(--oh-pb-d)}}
.oralys-home-cost__inner{max-width:1200px;margin:0 auto}
.oralys-home-cost__head{text-align:var(--oh-align);margin:0 0 28px}
.oralys-home-cost__eyebrow{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--oh-accent);margin:0 0 10px}
.oralys-home-cost__h{font-family:var(--font-heading--family);font-weight:700;font-size:var(--oh-h-m);line-height:1.2;margin:0 0 12px;color:var(--oh-text);text-wrap:balance}
.oralys-home-cost__h em{font-style:normal;color:var(--oh-accent)}
@media (min-width:750px){.oralys-home-cost__h{font-size:var(--oh-h-d)}}
.oralys-home-cost__sub{color:var(--oh-muted);margin:0;max-width:680px}
.oralys-home-cost__head[style*=center] .oralys-home-cost__sub,.oralys-home-cost__head--center .oralys-home-cost__sub{margin-inline:auto}
.oralys-home-cost__sub p{margin:0 0 8px}
.oralys-home-cost__btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 32px;border-radius:40px;background:var(--oh-cta);color:var(--oh-cta-text);font-weight:700;font-size:17px;text-decoration:none;border:0;transition:transform .15s}
.oralys-home-cost__btn:hover{transform:translateY(-1px)}
.oralys-home-cost__btn--full{width:100%}
@media (min-width:750px){.oralys-home-cost__btn--full{width:auto;min-width:300px}}

.oralys-home-cost__grid{display:grid;gap:28px}
.oralys-home-cost__bars{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.oralys-home-cost__lbl{display:flex;justify-content:space-between;gap:12px;font-size:16px;margin-bottom:6px}
.oralys-home-cost__lbl strong{text-align:right;flex:0 1 auto}
.oralys-home-cost__track{height:14px;border-radius:40px;background:color-mix(in srgb,var(--oh-text) 8%,transparent);overflow:hidden}
.oralys-home-cost__bar{display:block;height:100%;border-radius:40px;background:color-mix(in srgb,var(--oh-muted) 55%,transparent)}
.oralys-home-cost__row--on .oralys-home-cost__bar{background:var(--oh-accent)}.oralys-home-cost__row--on .oralys-home-cost__lbl{color:var(--oh-accent);font-weight:700}
.oralys-home-cost__foot{font-size:13px;color:var(--oh-muted);margin:16px 0 0}
.oralys-home-cost__call{background:var(--oh-card);border-radius:12px;padding:22px;border-top:4px solid var(--oh-accent)}
.oralys-home-cost__call-t{margin:0 0 8px;font-family:var(--font-heading--family);font-weight:700;font-size:21px;line-height:1.25}
.oralys-home-cost__call-x p{margin:0 0 16px}
@media (min-width:990px){.oralys-home-cost__grid{grid-template-columns:1.4fr 1fr;gap:56px;align-items:center}}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys accueil : coûts",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre (italique = mot en couleur accent)",
      "default": "Le prix d'un tube, <em>pas d'un rendez-vous</em>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p>Ce que vous coûte un dentier qui bouge, selon la solution choisie.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Note sous les barres"
    },
    {
      "type": "header",
      "content": "Encadré"
    },
    {
      "type": "text",
      "id": "call_title",
      "label": "Titre de l'encadré",
      "default": "Dentier 100 % Santé qui bouge ?"
    },
    {
      "type": "richtext",
      "id": "call_text",
      "label": "Texte de l'encadré",
      "default": "<p>Remboursé par la Sécu et votre mutuelle, il n'est pas forcément bien ajusté pour autant. Le gel le cale sur votre gencive telle qu'elle est aujourd'hui, pour le prix d'un tube, sans attendre un nouveau rendez-vous.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bouton",
      "default": "Voir les packs"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton",
