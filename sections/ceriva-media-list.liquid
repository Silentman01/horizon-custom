{%- liquid
  assign ss = section.settings
  case ss.ratio
    when 'portrait'
      assign ratio = '4 / 5'
      assign dims = '1080 × 1350'
    when 'landscape'
      assign ratio = '4 / 3'
      assign dims = '1600 × 1200'
    else
      assign ratio = '1'
      assign dims = '1200 × 1200'
  endcase
-%}
<div
  class="cv cv--{{ ss.tone }} cv-ml cv-ml--{{ ss.list_style }}{% if ss.media_position == 'right' %} cv-ml--media-right{% endif %}"
  style="{% render 'ceriva-tokens' %} --cv-pt: {{ ss.padding_top }}px; --cv-pb: {{ ss.padding_bottom }}px;"
>
  <div class="cv__inner">
    <div class="cv-ml__grid">
      <div class="cv-ml__media cv-reveal">
        {% render 'ceriva-media',
          image: ss.image,
          asset: ss.image_asset,
          ratio: ratio,
          label: ss.placeholder_label,
          dims: dims,
          sizes: '(min-width: 990px) 520px, 100vw'
        %}
      </div>

      <div class="cv-ml__content">
        <div class="cv-ml__head cv-reveal">
          {%- if ss.eyebrow != blank -%}
            <p class="cv__eyebrow">{{ ss.eyebrow }}</p>
          {%- endif -%}
          <{{ ss.heading_tag | default: 'h2' }} class="cv__title">{{ ss.title }}</{{ ss.heading_tag | default: 'h2' }}>
          {%- if ss.text != blank -%}
            <div class="cv__sub">{{ ss.text }}</div>
          {%- endif -%}
        </div>

        {%- if ss.list_style == 'rows' -%}
          <dl class="cv-ml__rows cv-reveal">
            {%- for block in section.blocks -%}
              <div
                class="cv-ml__row"
                {{ block.shopify_attributes }}
              >
                <dt>{{ block.settings.title }}</dt>
                <dd class="cv__rte">{{ block.settings.text }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- else -%}
          <ul class="cv-ml__checks">
            {%- for block in section.blocks -%}
              <li
                class="cv-ml__check cv-reveal"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image or block.settings.image_asset != blank -%}
                  <div class="cv-ml__thumb">
                    {% render 'ceriva-media',
                      image: block.settings.image,
                      asset: block.settings.image_asset,
                      ratio: '1',
                      label: block.settings.title,
                      sizes: '96px'
                    %}
                    {% render 'ceriva-check-icon' %}
                  </div>
                {%- else -%}
                  {% render 'ceriva-check-icon' %}
                {%- endif -%}
                <div>
                  <h3 class="cv-ml__check-title">{{ block.settings.title }}</h3>
                  <div class="cv-ml__check-text cv__rte">{{ block.settings.text }}</div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if ss.button_label != blank -%}
          <div class="cv-ml__cta cv-reveal">
            {% render 'ceriva-cta',
              label: ss.button_label,
              action: ss.button_action,
              url: ss.button_link,
              product: ss.button_product,
              style: ss.button_style
            %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% render 'ceriva-script' %}

{% stylesheet %}
  .cv-ml__grid {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .cv-ml__grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }

    .cv-ml--media-right .cv-ml__media {
      order: 2;
    }
  }

  .cv-ml__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cv-ml__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media screen and (max-width: 749px) {
    .cv-ml__head {
      align-items: center;
      text-align: center;
    }
  }

  .cv-ml__checks {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-ml__check {
    display: flex;
    gap: 14px;
  }

  .cv-ml__check .cv-check {
    width: 26px;
    height: 26px;
  }

  .cv-ml__check:has(.cv-ml__thumb) {
    align-items: center;
    gap: 16px;
  }

  /* Item photo with the check as a badge on its corner */
  .cv-ml__thumb {
    position: relative;
    flex: none;
    width: 76px;
  }

  .cv-ml__thumb .cv-media {
    --cv-media-radius: var(--cv-radius-lg);
    box-shadow: 0 6px 16px rgb(var(--cv-navy-rgb) / 0.12);
  }

  .cv-ml__thumb .cv-check {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 24px;
    height: 24px;
    box-shadow: 0 0 0 3px var(--cv-bg);
  }

  @media screen and (min-width: 750px) {
    .cv-ml__thumb {
      width: 92px;
    }
  }

  .cv-ml__check-title {
    margin: 2px 0 4px;
    font-family: var(--font-heading--family);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--cv-fg);
  }

  .cv-ml__check-text {
    font-size: 15px;
    line-height: 1.55;
  }

  .cv-ml__rows {
    margin: 0;
    border-top: 1px solid var(--cv-line);
  }

  .cv-ml__row {
    display: grid;
    grid-template-columns: minmax(110px, 34%) 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-ml__row dt {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .cv-ml__row dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .cv-ml__cta {
      display: flex;
      justify-content: center;
    }

    .cv-ml__cta .cv-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ceriva — Image + liste",
  "tag": "section",
  "class": "cv-section",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Fond",
      "options": [
        { "value": "ice", "label": "Blanc glacé" },
        { "value": "white", "label": "Blanc" },
        { "value": "navy", "label": "Bleu nuit" }
      ],
      "default": "ice"
    },
    {
      "type": "select",
      "id": "list_style",
      "label": "Style de liste",
      "options": [
        { "value": "checks", "label": "Coches + titre" },
        { "value": "rows", "label": "Fiche (libellé / texte)" }
      ],
      "default": "checks"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Position de l'image (ordinateur)",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format de l'image",
      "options": [
        { "value": "square", "label": "Carré" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "landscape", "label": "Paysage 4:3" }
      ],
      "default": "square"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image du thème (fichier)", "info": "Utilisée si aucune image n'est choisie, ex. ceriva-step-1.jpg (dossier assets du thème)." },
    { "type": "text", "id": "placeholder_label", "label": "Description de l'emplacement", "default": "Photo produit Ceriva" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Titre" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre",
      "info": "H1 seulement pour le titre principal d'une page (ex. en haut de l'accueil).",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton" },
    {
      "type": "select",
      "id": "button_action",
      "label": "Action du bouton",
      "options": [
        { "value": "offer", "label": "Remonter au choix de l'offre" },
        { "value": "cart", "label": "Ajouter l'offre choisie au panier" },
        { "value": "product", "label": "Aller à la page produit" },
        { "value": "url", "label": "Lien personnalisé" }
      ],
      "default": "offer"
    },
    { "type": "url", "id": "button_link", "label": "Lien", "visible_if": "{{ section.settings.button_action == 'url' }}" },
    { "type": "product", "id": "button_product", "label": "Produit (action « page produit »)", "info": "Vide = premier produit de la boutique." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "primary", "label": "Plein" },
        { "value": "outline", "label": "Contour" }
      ],
      "default": "primary"
    },
    { "type": "header", "content": "Espacement" },
    { "type": "range", "id": "padding_top", "label": "Haut", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bas", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre / libellé", "default": "Élément" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Description</p>" },
        { "type": "image_picker", "id": "image", "label": "Image (style Coches)", "info": "Remplace la coche par une vignette." },
        { "type": "text", "id": "image_asset", "label": "Image du thème (fichier)", "info": "Utilisée si aucune image n'est choisie, ex. ceriva-switch-item-1.jpg." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ceriva — Image + liste",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
