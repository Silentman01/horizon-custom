    "ot_home_faq": {
      "type": "oldtoms-home-faq",
      "settings": {
        "heading": "FAQ",
        "bg_color": "#FFFFFF",
        "padding_top": 56,
        "padding_bottom": 40
      },
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "question": "Are Old Tom's products really safe around kids and pets?",
            "answer": "Yes, absolutely! All our products are made with 100% plant-based essential oils (like peppermint, lemongrass and citronella) and are completely free from harsh, toxic chemicals. They're built to be a safe, natural alternative for your home, family and furry friends."
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "question": "How long do the repellent pouches last?",
            "answer": "Our pouches give long-lasting, non-stop protection. Generally they work for 30 to 60 days depending on airflow and room size. We recommend replacing them once the natural scent starts to fade."
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "question": "Do I need to leave the house after using the Critter Control Spray?",
            "answer": "Not at all! Our spray has no toxic fumes or harsh chemicals, so you don't need to clear the room. It kills bugs on contact and leaves a fresh mint and cinnamon scent behind."
          }
        },
        "b4": {
          "type": "item",
          "settings": {
            "question": "Where's the best place for the Spider and Rodent Repellent Pouches?",
            "answer": "For best results, put pouches in enclosed spaces or wherever you spot pest activity. Great spots include corners, cellars, lofts, wardrobes, under sinks, garages, sheds and near doors and windows."
          }
        },
        "b5": {
          "type": "item",
          "settings": {
            "question": "How do the Midge & Mosquito Patches work?",
            "answer": "Our patches are infused with natural citronella oil. Just peel and stick onto clothing, a rucksack or a pushchair. It makes a natural, invisible barrier that keeps biters away — perfect for days out."
          }
        },
        "b6": {
          "type": "item",
          "settings": {
            "question": "Will the Rodent Repellent Pouches leave a bad smell in my house?",
            "answer": "No, quite the opposite! Mice and rats hate the smell, but people love it. Our rodent pouches use a blend of peppermint, cinnamon and cedarwood oils that works as a natural air freshener and even helps soak up bad odours."
          }
        },
        "b7": {
          "type": "item",
          "settings": {
            "question": "What if the product doesn't work for me?",
            "answer": "We're confident in our natural formulas, which is why every order is backed by our 30-Day Money Back Guarantee. If you're not completely happy with your results, just contact our support team within 30 days for a full refund."
          }
        }
      },
