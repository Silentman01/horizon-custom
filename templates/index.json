      "type": "mojo-testimonials",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "title": "Surprisingly Comfortable",
            "text": "I wasn't sure what to expect, but these silk boxers caught me off guard. Soft, light, and they stay put. Perfect for lounging at home.",
            "name": "Mark T.",
            "date": "3 days ago"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "title": "Way Better Than I Expected",
            "text": "I'm a cotton guy. These feel completely different, in a good way. So light and smooth it's like wearing nothing. No sweat, no sticking. After a few wears and washes they still look great. I didn't think I'd convert, but here we are.",
            "name": "Samuel O.",
            "date": "1 week ago"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "title": "Perfect for Everyday Wear",
            "text": "I bought them out of curiosity and now I won't wear anything else. The silk is incredibly smooth, they breathe, and they look great. I wear them through long office days and they stay comfortable. Give them a go.",
            "name": "Stuart M.",
            "date": "2 days ago"
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "title": "Cleared Out My Drawer for These",
            "text": "The most comfortable boxers I've ever owned. I binned every other pair I had.",
            "name": "James F.",
            "date": "2 weeks ago"
          }
        },
        "r5": {
          "type": "review",
          "settings": {
            "title": "Definitely Buying More",
            "text": "I sleep in these and they're very comfortable. They feel well made. I'll be ordering again, no doubt.",
            "name": "Mike D.",
            "date": "5 days ago"
          }
        },
        "r6": {
          "type": "review",
          "settings": {
            "title": "Partner Loves Them",
            "text": "My partner says they're the most comfortable he has ever worn. After many washes they keep their shape and softness. And, honestly, I love how he looks in them.",
            "name": "Camelia J.",
            "date": "3 weeks ago"
          }
        },
        "r7": {
          "type": "review",
          "settings": {
            "title": "Pricey but Worth It",
            "text": "So comfortable. The first pair didn't fit, but customer service swapped them quickly. Light, soft, no irritation, fresh all day. A touch pricey, but worth every penny.",
            "name": "John R.",
            "date": "1 month ago"
          }
        },
        "r8": {
          "type": "review",
          "settings": {
            "title": "Happy Husband",
            "text": "I bought these for my husband and he is genuinely impressed. I wasn't sure silk was his thing, but now he's asking for more colours. A great gift. I hope you bring out even more shades.",
