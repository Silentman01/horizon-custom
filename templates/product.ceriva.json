    "cv_faq": {
      "type": "ceriva-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Est-ce que ça fait mal ?",
            "answer": "<p>Non. L'embout est souple et le geste ne demande aucune pression : vous le placez à l'entrée du conduit, vous tournez doucement, vous retirez. Si vous ressentez la moindre gêne, arrêtez.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "En quoi est-ce différent d'un coton-tige ?",
            "answer": "<p>Le coton-tige a tendance à repousser le cérumen et peut laisser des fibres. L'embout adhésif de Ceriva capte les résidus au contact et les ramène vers l'extérieur. En prime, vous voyez ce qui a été retiré.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Comment réutiliser un stick ?",
            "answer": "<p>Rincez l'embout à l'eau tiède jusqu'à ce que l'adhérence revienne, puis laissez sécher à l'air libre. Il est prêt pour la prochaine fois. Comme une brosse à dents, un stick reste personnel.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "À quelle fréquence l'utiliser ?",
            "answer": "<p>Une à deux fois par semaine suffit pour la plupart des gens. L'oreille se nettoie aussi naturellement : inutile d'en faire trop.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Dans quels cas ne pas l'utiliser ?",
            "answer": "<p>En cas de douleur, d'infection, d'écoulement, de tympan perforé ou d'opération récente de l'oreille, n'utilisez pas Ceriva et consultez un professionnel de santé.</p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Quand vais-je recevoir ma commande ?",
            "answer": "<p>Les commandes sont expédiées sous 24 à 48 h, puis livrées en 3 à 5 jours ouvrés en France. Vous recevez un numéro de suivi par e-mail dès l'expédition.</p>"
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "Et si ça ne me convient pas ?",
            "answer": "<p>Vous avez 30 jours après réception pour nous écrire. Nous vous remboursons intégralement, sans justificatif.</p>"
          }
        }
      },
