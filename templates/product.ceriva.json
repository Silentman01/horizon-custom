    "cv_problem": {
      "type": "ceriva-problem",
      "blocks": {
        "point_1": {
          "type": "point",
          "settings": {
            "title": "Il tasse au lieu de retirer",
            "text": "<p>Le coton-tige agit comme un piston : il repousse une partie du cérumen vers le fond du conduit, là où il s'accumule et donne cette impression d'oreille pleine.</p>"
          }
        },
        "point_2": {
          "type": "point",
          "settings": {
            "title": "Il laisse des fibres derrière lui",
            "text": "<p>Le coton s'effiloche. Ces fibres restent dans l'oreille, se mêlent au cérumen et entretiennent l'encombrement.</p>"
          }
        },
        "point_3": {
          "type": "point",
          "settings": {
            "title": "Il entretient les démangeaisons",
            "text": "<p>Frotter irrite une peau très fine. Une peau irritée gratte davantage… alors on recommence. Et le cercle continue.</p>"
          }
        }
      },
      "block_order": [
        "point_1",
        "point_2",
        "point_3"
      ],
      "settings": {
        "tone": "white",
        "eyebrow": "Le vrai problème",
        "title": "Pourquoi vos oreilles ne semblent jamais vraiment propres",
        "text": "<p>Oreilles qui grattent, sensation de bouchon qui revient ? Le problème, c'est peut-être votre coton-tige.</p>",
        "image_asset": "ceriva-problem.jpg",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
