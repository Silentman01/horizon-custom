        "callout_6": {
          "type": "callout",
          "settings": {
            "title": "Est-ce que ça abîme le dentier ? Est-ce sûr ?",
            "text": "<p>Non : le gel se retire d’un seul morceau à l’eau chaude. Sans zinc, rien qui fond dans la bouche, rien qu’elle avale.</p>",
            "style": "border"
          }
