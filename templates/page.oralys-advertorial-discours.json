      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "kicker": "",
            "text": "Ginette, 74 ans, Saint-Malo : le baptême de son arrière-petite-fille",
            "size": "small"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>« J’étais la marraine. Au repas, le dentier s’est soulevé au dessert. Je l’ai retiré discrètement et caché sous ma serviette, dans mon assiette. J’ai passé l’après-midi à surveiller cette serviette. » Elle utilise le gel depuis l’été : « Au prochain baptême, je lirai mon texte la tête haute. »</p>",
            "drop_cap": false,
            "lead": false
          }
        }
      },
      "block_order": [
        "heading_1",
        "text_2"
