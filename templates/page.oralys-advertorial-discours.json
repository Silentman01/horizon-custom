        "heading_2": {
          "type": "heading",
          "settings": {
            "kicker": "",
            "text": "Jean-Claude, 78 ans, Albi : ses noces d’or, la main devant la bouche",
            "size": "small"
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p>« Quarante personnes pour nos cinquante ans de mariage. J’ai ri toute la soirée derrière ma main. Sur les photos, on dirait que je tousse. » Il utilise le gel depuis le printemps : « Au mariage de mon petit-fils, en juin, j’ai fait le discours. Sans la main. »</p>",
            "drop_cap": false,
            "lead": false
          }
        }
