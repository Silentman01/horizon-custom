      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t07.webp",
            "stars": 5,
            "headline": "Le bas ne se balade plus",
            "text": "« Mon dentier du bas se baladait dans la bouche depuis des années. J'ai posé Oralys un lundi matin. Le soir, il n'avait pas bougé. Le mardi, pareil. Je n'y croyais toujours pas au bout d'une semaine. »",
            "name": "Gérard M., 71 ans, Clermont-Ferrand",
            "chip": "Bas"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t04.webp",
            "stars": 5,
            "headline": "Je reçois de nouveau ma famille à table",
            "text": "« Je refusais les invitations avec repas. Le dimanche, je restais dans la cuisine. Depuis que j'ai Oralys, j'ai reçu mes enfants et je suis restée assise du début à la fin, sans filer à la salle de bain. »",
            "name": "Annie P., 73 ans, Rennes",
            "chip": "Haut et bas"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t03.webp",
            "stars": 5,
            "headline": "Quatre colles essayées. Aucune ne tenait un repas.",
            "text": "« Fixodent, Corega, la poudre de ma sœur, un gel ventouse en pharmacie. Aucune ne tenait la durée d'un repas. J'ai commandé Oralys en me disant que j'avais 90 jours pour le renvoyer. Je ne l'ai pas renvoyé. »",
            "name": "Martine B., 68 ans, Caen",
            "chip": "Haut"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t16.webp",
            "stars": 5,
            "headline": "Maman remange avec nous",
            "text": "« Ma mère ne mangeait plus que de la soupe à table. Je lui ai posé Oralys avant le repas de Noël. Elle a mangé la dinde et la bûche comme tout le monde. C'est la première fois en trois ans. »",
            "name": "Sylvie G., 55 ans, Dijon (pour sa mère, 85 ans)",
            "chip": "Haut"
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t08.webp",
            "stars": 5,
            "headline": "Rien à voir avec les gels de pharmacie",
            "text": "« J'avais testé un gel ventouse en pharmacie. Tenu cinq minutes. Oralys se pose autrement : on le tiédit, on le moule, et là ça tient. Ça fait trois semaines que la crème est restée dans le tiroir. »",
            "name": "Jean-Pierre H., 74 ans, Metz",
            "chip": "Bas"
          }
        },
        "review_6": {
          "type": "review",
          "settings": {
            "asset": "oralys-pdp-rev-t13.webp",
            "stars": 5,
            "headline": "À 38 ans, je ris de nouveau",
            "text": "« Partiel du haut depuis un accident. J'avais honte de sourire au travail. Je pensais que c'était un produit pour les grands-parents, j'avais tort. Aujourd'hui, j'oublie que je le porte. »",
            "name": "Élodie R., 38 ans, Toulouse",
            "chip": "Partiel"
          }
        }
      },
