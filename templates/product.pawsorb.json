    "pawsorb_window": {
      "type": "pawsorb-window",
      "settings": {
        "heading": "Poison gives you a window. PawSorb closes it.",
        "body": "<p>What your dog swallows sits in the stomach first. For the next 60 minutes it seeps into the blood. With a toad, you get 15 to 30.</p><p>PawSorb catches it in the stomach, because activated charcoal grabs toxins on contact and holds them. Kaolin clay backs it up and calms the gut. It all leaves in the stool.</p><p><strong>The same charcoal ERs reach for, in your drawer.</strong></p>",
        "chip_1": "Coconut-shell activated charcoal",
        "chip_2": "Kaolin clay, the second layer",
        "anim_asset": "pawsorb-anim-stomach.webp",
        "image_asset": "pawsorb-window-diagram.webp",
        "image_alt": "Diagram: PawSorb binds poison in the stomach before it reaches the bloodstream",
        "ratio": "4 / 3",
        "image_side": "left",
        "label_mouth": "Mouth",
        "label_stomach": "Stomach: PawSorb binds here",
        "label_blood": "Bloodstream",
        "label_time": "0–60 min until it reaches the blood",
        "label_toad": "Toads: 15–30 min",
        "bg_color": "#FFFFFF",
        "text_color": "#141816",
        "accent_color": "#12855A",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
