    "pawsorb_v2_faq": {
      "type": "pawsorb-v2-faq",
      "settings": {
        "heading": "What owners ask us first",
        "columns": "2"
      },
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "What does PawSorb do inside my dog?",
            "answer": "<p>It catches the poison while it's still in the stomach, then holds on, so it can't soak into the blood. It all leaves together in the stool.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Does it work on toads? What won't it bind?",
            "answer": "<p>Yes, cane toad poison is on the list, along with chocolate, grapes, pills, rat bait, sago palm, mushrooms, THC, caffeine and more. It can't hold heavy metals, alcohol, or gas and oil.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Do I still need to call the vet?",
            "answer": "<p>Always. PawSorb is the first move, not the last. Give it, then call with the dose already in, so the window isn't spent on hold.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Is it okay alongside their daily meds?",
            "answer": "<p>Tell your vet when you call. Charcoal doesn't pick and choose, so it can grab their regular medicine too, and your vet can tell you when to give the next one.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "What if they hate the taste or fight it?",
            "answer": "<p>Most take it without a fight. It's a smooth premixed gel, no powder cloud, nothing to mix. Picky eater? Smear it on a treat or a spoon of wet food.</p>"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "How many mL does my dog need?",
            "answer": "<p>1 mL per pound, and one tube holds 30 mL. That's 1 tube up to 30 lb, 2 tubes to 60 lb, 3 to 80 lb, 5 to 150 lb. Between sizes? Go up.</p>"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "Can I reuse an opened tube?",
            "answer": "<p>Yes. Recap it and keep it at room temperature, no fridge needed. What's left keeps until the date on the tube, waiting for the next scare.</p>"
          }
        },
        "q_8": {
          "type": "question",
          "settings": {
            "question": "What's actually inside the tube?",
            "answer": "<p>Charcoal from coconut shells, activated to bind, plus kaolin clay, premixed into a smooth gel. No artificial colors, fillers or preservatives. Produced in a US, FDA-registered, cGMP facility.</p>"
          }
        },
        "q_9": {
          "type": "question",
          "settings": {
            "question": "What if I never end up using it?",
            "answer": "<p>Then it was the cheapest insurance you'll own: less than one $95 poison-line call, good for 2 years, ready every night until then.</p>"
          }
        }
      },
