    "pawsorb_v2_ingredients": {
      "type": "pawsorb-v2-ingredients",
      "settings": {
        "heading": "ER-grade binders, ready in your drawer",
        "image_asset": "pawsorb-v2-ingredients.webp",
        "image_alt": "Coconut shell, charcoal chunks and white kaolin clay"
      },
      "blocks": {
        "tab_1": {
          "type": "tab",
          "settings": {
            "label": "Activated coconut charcoal",
            "title": "Poison catcher",
            "text": "<p>Coconut shell is heated until it's riddled with <strong>millions of tiny pores</strong>. Each one grabs poison on contact and won't let go. That happens <strong>in the stomach, before it reaches the blood</strong>, so the toxin leaves your pet in the stool instead of soaking in. <strong>The same charcoal ERs reach for.</strong></p>",
            "bullet_1": "Holds toads, chocolate, pills and more",
            "bullet_2": "Cleaner coconut source, not coal",
            "bullet_3": "Exits in the stool, never absorbed"
          }
        },
        "tab_2": {
          "type": "tab",
          "settings": {
            "label": "White kaolin clay",
            "title": "The second layer",
            "text": "<p>Kaolin is a soft white clay vets have used on upset stomachs for decades. It <strong>backs up the charcoal</strong>, soaking up what's left, and <strong>coats a stomach that's already in knots</strong>. Your pet gets a calmer gut and firmer stools in the hours after.</p>",
            "bullet_1": "Calms a churning stomach",
            "bullet_2": "Firmer stools after a scare",
            "bullet_3": "Natural clay, no fillers"
          }
        }
      },
      "block_order": [
        "tab_1",
        "tab_2"
      ]
    },
