{%- assign bs = block.settings -%}
<div class="oralys-pdp-guar" style="--opgr-bg:{{ bs.c_bg }};--opgr-text:{{ bs.c_text }};--opgr-seal:{{ bs.c_seal }}" {{ block.shopify_attributes }}>
  <span class="oralys-pdp-guar__seal" aria-hidden="true"><b>{{ bs.seal_top }}</b><small>{{ bs.seal_bottom }}</small></span>
  <div><p class="oralys-pdp-guar__t">{{ bs.title }}</p><p class="oralys-pdp-guar__b">{{ bs.body }}</p></div>
</div>

{% stylesheet %}
.oralys-pdp-guar{display:flex;gap:14px;align-items:center;padding:16px;border-radius:12px;background:var(--opgr-bg);color:var(--opgr-text)}
.oralys-pdp-guar__seal{flex:0 0 64px;width:64px;height:64px;border-radius:50%;border:2px dashed var(--opgr-seal);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;color:var(--opgr-seal)}
.oralys-pdp-guar__seal b{font-size:24px;font-weight:800}
.oralys-pdp-guar__seal small{font-size:10px;font-weight:800;letter-spacing:.08em;margin-top:2px}
.oralys-pdp-guar__t{margin:0 0 4px;font-family:var(--font-heading--family);font-weight:700;font-size:17px;line-height:1.25}
.oralys-pdp-guar__b{margin:0;font-size:14.5px;line-height:1.45;opacity:.95}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : garantie",
  "settings": [
    {
      "type": "text",
      "id": "seal_top",
      "label": "Sceau : chiffre",
      "default": "90"
    },
    {
      "type": "text",
      "id": "seal_bottom",
      "label": "Sceau : mot",
      "default": "JOURS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "90 jours pour juger à table"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Mangez, parlez, riez avec Oralys pendant 90 jours. Si votre dentier ne tient pas comme promis, on vous rembourse intégralement. Un e-mail suffit."
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#0E6B50"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "c_seal",
      "label": "Sceau",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Oralys : garantie"
    }
  ]
}
{% endschema %}
