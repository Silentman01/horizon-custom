{%- assign s = block.settings -%}
<div class="mojo-gl mojo-gl--m{{ s.columns_mobile }}" style="{% render 'mojo-vars' %}" {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}<p class="mojo-gl__heading">{{ s.heading }}</p>{%- endif -%}
  <ul class="mojo-gl__list" role="list">
    {%- for i in (1..4) -%}
      {%- liquid
        assign k_cap = 'caption_' | append: i
        assign k_icon = 'icon_' | append: i
        assign cap = s[k_cap]
        assign ico = s[k_icon]
      -%}
      {%- if cap != blank -%}<li class="mojo-gl__li"><span class="mojo-gl__icon">{% render 'mojo-icon', name: ico, size: 26 %}</span><span class="mojo-gl__cap">{{ cap }}</span></li>{%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
.mojo-gl { font-family: var(--mojo-font); color: var(--mojo-fg); border-top: 1px solid var(--mojo-line); border-bottom: 1px solid var(--mojo-line); padding: 12px 0; }
.mojo-gl__heading { margin: 0 0 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
.mojo-gl__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.mojo-gl--m4 .mojo-gl__list { grid-template-columns: repeat(4, 1fr); gap: 6px; }
.mojo-gl__li { display: flex; align-items: center; gap: 8px; font-size: 11px; line-height: 1.25; }
.mojo-gl--m4 .mojo-gl__li { flex-direction: column; text-align: center; }
.mojo-gl__icon { display: inline-flex; flex: none; }
.mojo-gl__cap { min-width: 0; }
@media screen and (min-width: 750px) {
  .mojo-gl__list, .mojo-gl--m4 .mojo-gl__list { grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .mojo-gl__li, .mojo-gl--m4 .mojo-gl__li { flex-direction: row; text-align: left; }
}
{% endstylesheet %}

