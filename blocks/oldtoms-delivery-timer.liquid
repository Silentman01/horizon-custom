{%- comment -%}
  Old Tom's delivery timer strip. The countdown runs to the next daily cut-off hour (store visitor's local time), so
  it rolls over every day and never shows 00:00:00.
{%- endcomment -%}
{%- assign bs = block.settings -%}
<ot-delivery class="ot-delivery" style="{% render 'oldtoms-vars' %}" data-cutoff="{{ bs.cutoff_hour }}" {{ block.shopify_attributes }}>
  <span class="ot-delivery__side">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="ot-delivery__text">{{ bs.before_text }} <strong class="ot-delivery__time" data-ot-time>02:59:46</strong></span>
  </span>
  <svg class="ot-delivery__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 12h14m-5-5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="ot-delivery__side">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4.2l3.3 3.3v2.7h-7.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" fill="#ebf5ed" stroke="currentColor" stroke-width="1.7"/><circle cx="17" cy="17.5" r="1.8" fill="#ebf5ed" stroke="currentColor" stroke-width="1.7"/></svg>
    <span class="ot-delivery__text">{{ bs.after_text }} <strong>{{ bs.after_value }}</strong></span>
  </span>
</ot-delivery>
{% stylesheet %}
.ot-delivery { display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; min-height: 52px; padding: 8px 12px; border: 1px solid #7fa93f; border-radius: 6px; background: #ebf5ed; color: #24433d; font-size: 13px; line-height: 1.2; }
.ot-delivery__side { display: flex; align-items: center; gap: 6px; min-width: 0; }
.ot-delivery__side svg, .ot-delivery__arrow { flex: none; }
.ot-delivery__text strong { font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; }
@media screen and (max-width: 389px) { .ot-delivery { font-size: 12px; padding-inline: 8px; } .ot-delivery__arrow { display: none; } }
{% endstylesheet %}
{% javascript %}
if (!customElements.get('ot-delivery')) {
  customElements.define('ot-delivery', class extends HTMLElement {
    connectedCallback() { this.tick(); this.timer = setInterval(() => this.tick(), 1000); }
    disconnectedCallback() { clearInterval(this.timer); }
    tick() {
      const hour = parseInt(this.dataset.cutoff, 10) || 0;
      const now = new Date();
      const end = new Date(now);
      end.setHours(hour, 0, 0, 0);
      if (end <= now) end.setDate(end.getDate() + 1);
      let s = Math.max(1, Math.floor((end - now) / 1000));
      const h = String(Math.floor(s / 3600)).padStart(2, '0');
      s %= 3600;
      const t = `${h}:${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
      const el = this.querySelector('[data-ot-time]');
      if (el) el.textContent = t;
    }
  });
}
{% endjavascript %}
{% schema %}
{
  "name": "Old Tom's delivery timer",
  "tag": null,
  "settings": [
    { "type": "text", "id": "before_text", "label": "Text before the timer", "default": "Order within" },
    { "type": "range", "id": "cutoff_hour", "label": "Daily cut-off hour (0 = midnight)", "min": 0, "max": 23, "step": 1, "default": 0, "info": "The timer counts down to this hour and restarts every day." },
    { "type": "text", "id": "after_text", "label": "Shipping text", "default": "Ships" },
    { "type": "text", "id": "after_value", "label": "Shipping value", "default": "Today" }
  ],
  "presets": [{ "name": "Old Tom's delivery timer" }]
}
{% endschema %}
