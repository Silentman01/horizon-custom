{%- comment -%}
  Old Tom's subscription checkbox (display). Pre-ticked by default. It does NOT add a selling plan by itself: a
  subscription app (or Shopify selling plans) must be installed for the refills to be real. If the product has
  selling plans, the checked state is exposed as data-has-plan on the element for an app/theme script to read.
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign p = closest.product
  assign has_plan = false
  if p != blank and p.selling_plan_groups.size > 0
    assign has_plan = true
  endif
-%}
<label class="ot-subscribe" style="{% render 'oldtoms-vars' %}" {% if has_plan %}data-has-plan{% endif %} {{ block.shopify_attributes }}>
  <input class="ot-subscribe__input visually-hidden" type="checkbox" {% if bs.checked %}checked{% endif %}>
  <span class="ot-subscribe__box" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" focusable="false"><path d="M2.5 7.3l2.9 2.9 5.6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
  <span class="ot-subscribe__text">
    <span class="ot-subscribe__title">{{ bs.title }}</span>
    {%- if bs.subtitle != blank -%}<span class="ot-subscribe__sub">{{ bs.subtitle }}</span>{%- endif -%}
  </span>
</label>
{% stylesheet %}
.ot-subscribe { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 12px 14px; border: 1px solid #e6e6e6; border-radius: 8px; background: #fff; cursor: pointer; }
.ot-subscribe:has(.ot-subscribe__input:focus-visible) { outline: 2px solid #000; outline-offset: 2px; }
.ot-subscribe__box { flex: none; display: grid; place-items: center; width: 22px; height: 22px; border: 2px solid #121212; border-radius: 4px; background: #fff; color: #fff; }
.ot-subscribe__box svg { opacity: 0; }
.ot-subscribe:has(.ot-subscribe__input:checked) .ot-subscribe__box { background: #121212; }
.ot-subscribe:has(.ot-subscribe__input:checked) .ot-subscribe__box svg { opacity: 1; }
.ot-subscribe__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.ot-subscribe__title { font-size: 13px; font-weight: 700; line-height: 1.3; color: #000; }
.ot-subscribe__sub { font-size: 12px; line-height: 1.3; color: #555; }
{% endstylesheet %}
{% schema %}
{
  "name": "Old Tom's subscription",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Display only: a subscription app with a 30% refill plan is needed for this to take effect at checkout." },
    { "type": "text", "id": "title", "label": "Title", "default": "Save 30% With Automatic Refills" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "No Commitment, Cancel Anytime" },
    { "type": "checkbox", "id": "checked", "label": "Pre-ticked", "default": true }
  ],
  "presets": [{ "name": "Old Tom's subscription" }]
}
{% endschema %}
