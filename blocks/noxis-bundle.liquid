{%- liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{%- unless product_resource == blank -%}
  <noxis-bundle
    class="nxb"
    style="{% render 'noxis-vars' %}"
    {% if block.settings.hide_native_picker %}
      data-hide-native
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <p class="nxb__heading">{{ block.settings.heading }}</p>
    {%- endif -%}
    <div
      class="nxb__tiers"
      role="radiogroup"
      aria-label="{{ block.settings.heading | default: 'Choose your bundle' | escape }}"
    >
      {% content_for 'blocks', closest.product: product_resource %}
    </div>
  </noxis-bundle>
{%- endunless -%}

{% stylesheet %}
  .nxb {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .nxb__heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #000000;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nxb__heading::before,
  .nxb__heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgb(from var(--nx-amber) r g b / 0.45);
  }

  .nxb__tiers {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* The native picker stays in the DOM: the bundle cards drive it */
  .product-details:has(.nxb[data-hide-native]) variant-picker {
    display: none;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('noxis-bundle')) {
    class NoxisBundle extends HTMLElement {
      connectedCallback() {
        this.addEventListener('change', this.onChange);
        customElements.whenDefined('variant-picker').then(() => this.syncInitialState());
      }

      disconnectedCallback() {
        this.removeEventListener('change', this.onChange);
      }

      /** Applies the default bundle on first load, or mirrors the variant already in the URL. */
      syncInitialState() {
        const inputs = [...this.querySelectorAll('.nxb-tier__input')];
        const checked = inputs.find((input) => input.checked);
        const hasUrlVariant = new URL(window.location.href).searchParams.has('variant');

        if (checked && checked.dataset.preselect !== undefined && !hasUrlVariant && checked.dataset.variantId) {
          this.selectNativeVariant(checked.dataset.variantId);
          return;
        }

        if (!checked) {
          const current = this.currentNativeVariantId();
          const match = inputs.find((input) => input.dataset.variantId === current) || inputs[0];
          if (match) {
            match.checked = true;
            match.closest('.nxb-tier')?.classList.add('is-selected');
          }
        }
      }

      currentNativeVariantId() {
        const picker = (this.closest('.shopify-section') || document).querySelector('variant-picker');
        const radio = picker?.querySelector('input[type="radio"]:checked');
        const option = picker?.querySelector('select option:checked');
        return radio?.dataset.variantId || option?.dataset.variantId || '';
      }

      onChange = (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || !input.dataset.variantId) return;
        this.querySelectorAll('.nxb-tier').forEach((tier) => tier.classList.toggle('is-selected', tier.contains(input)));
        this.selectNativeVariant(input.dataset.variantId);
      };

      /** Forwards the choice to Horizon's variant picker so price, form and cart update natively. */
      selectNativeVariant(variantId) {
        const picker = (this.closest('.shopify-section') || document).querySelector('variant-picker');
        if (!picker) return;

        const radio = picker.querySelector(`input[type="radio"][data-variant-id="${variantId}"]`);
        if (radio) {
          if (!radio.checked) radio.click();
          return;
        }

        const option = picker.querySelector(`option[data-variant-id="${variantId}"]`);
        const select = option?.closest('select');
        if (option && select && select.value !== option.value) {
          select.value = option.value;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    }

    customElements.define('noxis-bundle', NoxisBundle);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Noxis bundle & save",
  "blocks": [{ "type": "_noxis-bundle-tier" }],
  "settings": [
    {
      "type": "paragraph",
      "content": "Each card is a product variant (e.g. option \"Bundle\": Buy 1 / Buy 2 / Buy 3). Prices and crossed-out prices come from the variants. Keep the Variant picker block in the product info: it is hidden and driven by these cards."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & Save" },
    { "type": "checkbox", "id": "hide_native_picker", "label": "Hide the native variant picker", "default": true }
  ],
  "presets": [
    {
      "name": "Noxis bundle & save",
      "blocks": {
        "tier_1": { "type": "_noxis-bundle-tier", "settings": { "variant_position": 1, "title": "Buy 1", "gift": "+ 1 FREE Glasses Case", "gift_value": "$14.95" } },
        "tier_2": { "type": "_noxis-bundle-tier", "settings": { "variant_position": 2, "title": "Buy 2", "subtitle": "Free Shipping", "badge": "MOST POPULAR", "gift": "+ 2 FREE Glasses Cases", "gift_value": "$29.90", "preselect": true } },
        "tier_3": { "type": "_noxis-bundle-tier", "settings": { "variant_position": 3, "title": "Buy 3", "subtitle": "Free Shipping", "badge": "BEST VALUE", "gift": "+ 3 FREE Glasses Cases", "gift_value": "$44.85" } }
      },
      "block_order": ["tier_1", "tier_2", "tier_3"]
    }
  ]
}
{% endschema %}
