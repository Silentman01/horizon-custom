{%- comment -%} Krino outline chips (claims row under the title). Prefix krino-chips. {%- endcomment -%}
{%- assign bs = block.settings -%}
<div
  class="krino-chips"
  style="--krino-chips-color: {{ bs.color }}; --krino-chips-bg: {{ bs.background }}; --krino-chips-bw: {{ bs.border_width }}px; --krino-chips-radius: {{ bs.radius }}px; --krino-chips-size: {{ bs.text_size }}px; --krino-chips-size-m: {{ bs.text_size_mobile }}px; --krino-chips-weight: {{ bs.weight }}; --krino-chips-gap: {{ bs.gap }}px; --krino-chips-pt: {{ bs.padding_top }}px; --krino-chips-pb: {{ bs.padding_bottom }}px;"
  {{ block.shopify_attributes }}
>
  {%- for i in (1..4) -%}
    {%- capture kc_key -%}chip_{{ i }}{%- endcapture -%}
    {%- if bs[kc_key] != blank -%}<span class="krino-chips__chip">{{ bs[kc_key] }}</span>{%- endif -%}
  {%- endfor -%}
</div>
{% stylesheet %}
  .krino-chips { display: flex; flex-wrap: wrap; gap: var(--krino-chips-gap, 8px); width: 100%; padding-block: var(--krino-chips-pt, 0) var(--krino-chips-pb, 0); }
  .krino-chips__chip { display: inline-flex; align-items: center; padding: 5px 14px; border: var(--krino-chips-bw, 1.5px) solid var(--krino-chips-color, #3d5afe); border-radius: var(--krino-chips-radius, 6px); background: var(--krino-chips-bg, transparent); color: var(--krino-chips-color, #3d5afe); font-size: var(--krino-chips-size, 13px); font-weight: var(--krino-chips-weight, 500); line-height: 1.3; white-space: nowrap; }
  @media screen and (max-width: 749px) { .krino-chips__chip { padding: 5px 12px; font-size: var(--krino-chips-size-m, 13px); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino chips",
  "tag": null,
  "settings": [
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "Grip Lock" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "No mancha" },
    { "type": "text", "id": "chip_3", "label": "Chip 3", "default": "A prueba de agua" },
    { "type": "text", "id": "chip_4", "label": "Chip 4 (optional)" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "color", "label": "Text and border", "default": "#3D5AFE" },
    { "type": "color", "id": "background", "label": "Background", "alpha": true, "default": "#00000000" },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0.5, "max": 3, "step": 0.5, "unit": "px", "default": 1.5 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "select", "id": "weight", "label": "Weight", "default": "500", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "text_size", "label": "Text size (desktop)", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "text_size_mobile", "label": "Text size (mobile)", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Krino chips" }]
}
{% endschema %}
