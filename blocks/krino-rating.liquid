{%- comment -%} Krino rating row: 5 stars + rating text (buy box, above the title). Prefix krino-rating. {%- endcomment -%}
{%- assign bs = block.settings -%}
<div
  class="krino-rating"
  style="--krino-rating-color: {{ bs.text_color }}; --krino-rating-size: {{ bs.text_size }}px; --krino-rating-size-m: {{ bs.text_size_mobile }}px; --krino-rating-gap: {{ bs.gap }}px; --krino-rating-justify: {{ bs.alignment }}; --krino-rating-pt: {{ bs.padding_top }}px; --krino-rating-pb: {{ bs.padding_bottom }}px; --krino-rating-font: {{ bs.font }};"
  {{ block.shopify_attributes }}
>
  {%- if bs.show_stars -%}{% render 'krino-stars', size: bs.star_size, color: bs.star_color %}{%- endif -%}
  {%- if bs.text != blank -%}
    {%- if bs.link != blank -%}
      <a class="krino-rating__text" href="{{ bs.link }}">{{ bs.text }}</a>
    {%- else -%}
      <span class="krino-rating__text">{{ bs.text }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
{% stylesheet %}
  .krino-rating { display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--krino-rating-justify, flex-start); gap: var(--krino-rating-gap, 8px); padding-block: var(--krino-rating-pt, 0) var(--krino-rating-pb, 0); width: 100%; }
  .krino-rating__text { color: var(--krino-rating-color, #171717); font-family: var(--krino-rating-font, inherit); font-size: var(--krino-rating-size, 12px); line-height: 1.3; text-decoration: none; }
  .krino-rating__text strong { font-weight: 700; }
  a.krino-rating__text:hover { opacity: 0.75; }
  @media screen and (max-width: 749px) { .krino-rating__text { font-size: var(--krino-rating-size-m, 12px); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino rating",
  "tag": null,
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "<strong>Excelente</strong> 4.8/5 — +1,800 reseñas" },
    { "type": "url", "id": "link", "label": "Link (optional, e.g. to the reviews section)" },
    { "type": "header", "content": "Stars" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#3D5AFE" },
    { "type": "range", "id": "star_size", "label": "Star size", "min": 10, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Text style" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#171717" },
    { "type": "select", "id": "font", "label": "Font", "default": "var(--font-body--family)", "options": [
      { "value": "var(--font-body--family)", "label": "Body" },
      { "value": "var(--font-subheading--family)", "label": "Subheading" },
      { "value": "var(--font-heading--family)", "label": "Heading" },
      { "value": "var(--font-accent--family)", "label": "Accent" }
    ] },
    { "type": "range", "id": "text_size", "label": "Text size (desktop)", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "text_size_mobile", "label": "Text size (mobile)", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "flex-start", "options": [
      { "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }
    ] },
    { "type": "range", "id": "gap", "label": "Gap stars / text", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Krino rating" }]
}
{% endschema %}
