<div
  class="cv cv-hl cv-hl--{{ block.settings.tone }}"
  style="{% render 'ceriva-tokens' %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.badge != blank -%}
    <span class="cv-hl__badge">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>
      </svg>
      {{ block.settings.badge }}
    </span>
  {%- endif -%}

  <p class="cv-hl__title">
    {{ block.settings.title }}
    {%- if block.settings.highlight != blank %}
      <span class="cv-hl__accent">{{ block.settings.highlight }}</span>
    {%- endif -%}
  </p>

  {%- if block.settings.text != blank -%}
    <p class="cv-hl__text">{{ block.settings.text }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .cv-hl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 16px 18px;
    border-radius: var(--cv-radius-lg);
    text-align: center;
  }

  .cv-hl--soft {
    --cv-bg: rgb(46 143 219 / 0.08);
    --cv-fg: var(--cv-navy);

    border: 1.5px solid rgb(46 143 219 / 0.3);
  }

  .cv-hl--navy {
    --cv-bg: var(--cv-navy);
    --cv-fg: var(--cv-white);

    border: 0;
  }

  .cv-hl__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--cv-blue);
    color: var(--cv-white);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .cv-hl__badge svg {
    width: 13px;
    height: 13px;
  }

  .cv-hl__title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }

  .cv-hl__accent {
    display: block;
    color: var(--cv-blue);
  }

  .cv-hl--navy .cv-hl__accent {
    color: var(--cv-white);
    text-decoration: underline;
    text-decoration-color: var(--cv-blue);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .cv-hl__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ceriva — Encadré valeur",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Style",
      "options": [
        { "value": "soft", "label": "Bleu clair" },
        { "value": "navy", "label": "Bleu nuit" }
      ],
      "default": "soft"
    },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Réutilisable" },
    { "type": "text", "id": "title", "label": "Phrase principale", "default": "Vous ne payez pas un bâtonnet." },
    { "type": "text", "id": "highlight", "label": "Phrase mise en avant", "default": "Vous payez jusqu'à 30 utilisations." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Un stick remplace des dizaines de cotons-tiges. Rincez-le, réutilisez-le." }
  ],
  "presets": [
    {
      "name": "Ceriva — Encadré valeur",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
