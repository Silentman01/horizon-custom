{%- assign bs = block.settings -%}
<figure class="ov2-mini" {{ block.shopify_attributes }}>
  <div class="ov2-mini__head">
    <span class="ov2-mini__av">{% render 'oralys-pdp-media', image: bs.avatar, asset: bs.avatar_asset, alt: bs.name, class: 'ov2-mini__img', width: 80, height: 80 %}</span>
    <span class="ov2-mini__who">
      <span class="ov2-mini__name">{{ bs.name }}{% if bs.verified != blank %} <span class="ov2-mini__ver"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#0E6B50"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ bs.verified }}</span>{% endif %}</span>
      {% render 'oralys-v2-stars', size: 15 %}
    </span>
  </div>
  <blockquote class="ov2-mini__q">{{ bs.quote }}</blockquote>
</figure>

{% stylesheet %}
.ov2-mini{margin:0;padding:14px;border:1px solid #DCE5E0;border-radius:12px;background:#F7FAF8;color:#17221E}
.ov2-mini__head{display:flex;align-items:center;gap:12px;margin-bottom:8px}
.ov2-mini__av{flex:0 0 40px;width:40px;height:40px;border-radius:50%;overflow:hidden;background:#EEF6F1}
.ov2-mini__img{width:100%;height:100%;object-fit:cover;display:block}
.ov2-mini__who{display:flex;flex-direction:column;gap:2px;min-width:0}
.ov2-mini__name{font-size:15px;font-weight:700;line-height:1.3}
.ov2-mini__ver{display:inline-flex;align-items:center;gap:4px;margin-left:4px;color:#0E6B50;font-size:15px;font-weight:700;white-space:nowrap}
.ov2-mini .ov2-stars{display:inline-flex;gap:1px;color:#F0A830}
.ov2-mini .ov2-stars svg{fill:currentColor}
.ov2-mini__q{margin:0;padding:0;border:0;font-size:16px;line-height:1.5;font-style:normal;color:#17221E}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys v2 : mini-avis",
  "settings": [
    { "type": "image_picker", "id": "avatar", "label": "Photo" },
    { "type": "text", "id": "avatar_asset", "label": "Photo : fichier du thème", "default": "oralys-pdp-rev-t01.webp" },
    { "type": "text", "id": "name", "label": "Nom, âge, ville", "default": "Monique, 71 ans · Angers" },
    { "type": "text", "id": "verified", "label": "Mention vérifiée", "default": "Achat vérifié" },
    { "type": "textarea", "id": "quote", "label": "Avis", "default": "« Mon dentier du bas se soulevait dès la première bouchée. Dimanche, j'ai mangé le gigot avec tout le monde. Je ne mets plus la main devant la bouche pour rire. »" }
  ],
  "presets": [{ "name": "Oralys v2 : mini-avis" }]
}
{% endschema %}
