{%- assign s = block.settings -%}
<div class="mojo-br" style="{% render 'mojo-vars' %}--mojo-br-fill:{{ s.bar_color }};--mojo-br-track:{{ s.track_color }};" {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}<p class="mojo-br__heading">{{ s.heading }}</p>{%- endif -%}
  {%- for i in (1..4) -%}
    {%- liquid
      assign k_l = 'label_' | append: i
      assign k_v = 'value_' | append: i
      assign lab = s[k_l]
      assign val = s[k_v]
    -%}
    {%- if lab != blank -%}
      <div class="mojo-br__row"><span class="mojo-br__label">{{ lab }}</span><span class="mojo-br__track"><span class="mojo-br__fill" style="width:{{ val }}%"></span></span></div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
.mojo-br { display: grid; gap: 10px; font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-br__heading { margin: 0; font-size: 12px; font-weight: 700; }
.mojo-br__row { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 12px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; }
.mojo-br__track { display: block; height: 4px; background: var(--mojo-br-track); position: relative; }
.mojo-br__fill { display: block; height: 100%; background: var(--mojo-br-fill); }
.mojo-br__label { text-transform: uppercase; }
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo rating bars",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Bar 1 label",
      "default": "SOFTNESS"
    },
    {
      "type": "range",
      "id": "value_1",
      "label": "Bar 1 value",
      "default": 92,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Bar 2 label",
      "default": "STRETCH"
    },
    {
      "type": "range",
      "id": "value_2",
      "label": "Bar 2 value",
      "default": 78,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Bar 3 label",
      "default": "BREATHABILITY"
    },
    {
      "type": "range",
      "id": "value_3",
      "label": "Bar 3 value",
      "default": 94,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "label_4",
      "label": "Bar 4 label",
      "default": "WEIGHT"
    },
    {
      "type": "range",
      "id": "value_4",
      "label": "Bar 4 value",
      "default": 22,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Bar colour",
      "default": "#0F1B2D"
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Track colour",
      "default": "#E3DCCD"
    }
  ]
}
{% endschema %}
