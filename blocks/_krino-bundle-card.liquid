{%- comment -%}
  One bundle card inside "Krino bundle cards". Prefix krino-bundle-card. Two modes, picked automatically:
  - Variant mode: the product has a variant with this option value (e.g. Paquete = 3 frascos). The card selects it;
    per-unit price = variant price / units.
  - Quantity mode (no such variant, like bundle apps): the card adds {units} x the current variant. Pack price =
    price x (units - free units); the free units must be given by an automatic "Buy X get Y" discount in Shopify.
  {percent} in the save pill = savings vs the compare-at total.
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign p = closest.product
  assign cur = p.selected_or_first_available_variant
  assign kbc_want = bs.value | strip
  capture kbc_vid
    render 'krino-variant-id', product: p, base: cur, value: kbc_want
  endcapture
  assign kbc_vid = kbc_vid | strip
  assign v = cur
  if kbc_vid != blank
    for x in p.variants
      assign kbc_xid = x.id | append: ''
      if kbc_xid == kbc_vid
        assign v = x
        break
      endif
    endfor
  endif
  assign kbc_qty = bs.quantity | at_least: 1
  assign kbc_selected = false
  if kbc_vid != blank
    assign kbc_mode = 'variant'
    if cur.options contains kbc_want
      assign kbc_selected = true
    endif
    assign kbc_total = v.price
    assign kbc_compare_total = v.compare_at_price | default: 0
  else
    assign kbc_mode = 'qty'
    assign kbc_selected = bs.preselect
    assign kbc_paid = bs.free_units | default: 0 | times: -1 | plus: kbc_qty | at_least: 1
    assign kbc_total = v.price | times: kbc_paid
    assign kbc_compare_total = v.compare_at_price | default: 0 | at_least: v.price | times: kbc_qty
  endif
  assign kbc_unit = kbc_total | divided_by: kbc_qty
  assign kbc_unit_compare = 0
  if kbc_compare_total > kbc_total
    assign kbc_unit_compare = kbc_compare_total | divided_by: kbc_qty
  endif
  assign kbc_save = bs.save
  if kbc_save contains '{percent}'
    assign kbc_pct = 0
    if kbc_compare_total > kbc_total
      assign kbc_pct = kbc_compare_total | minus: kbc_total | times: 100.0 | divided_by: kbc_compare_total | round
    endif
    assign kbc_save = kbc_save | replace: '{percent}', kbc_pct
    if kbc_pct == 0
      assign kbc_save = ''
    endif
  endif
-%}
<label
  class="krino-bundle-card{% if kbc_selected %} is-selected{% endif %}{% unless v.available %} is-unavailable{% endunless %}"
  data-krino-card
  {{ block.shopify_attributes }}
>
  <input
    class="krino-bundle-card__input"
    type="radio"
    name="krino-bundles-{{ section.id }}"
    value="{{ kbc_want | escape }}"
    data-krino-val="{{ kbc_want | escape }}"
    {% if kbc_mode == 'qty' %}data-krino-qty="{{ kbc_qty }}"{% endif %}
    data-krino-total="{{ kbc_total | money | escape }}"
    data-krino-compare-total="{% if kbc_compare_total > kbc_total %}{{ kbc_compare_total | money | escape }}{% endif %}"
    {% if bs.preselect %}data-krino-preselect="{{ kbc_want | escape }}"{% endif %}
    {% if kbc_selected %}checked{% endif %}
    {% unless v.available %}disabled{% endunless %}
  >
  {%- if bs.badge != blank -%}<span class="krino-bundle-card__badge">{{ bs.badge }}</span>{%- endif -%}
  {%- if bs.image != blank or bs.image_asset != blank or request.design_mode -%}
    <span class="krino-bundle-card__thumb">
      {%- if bs.image != blank -%}
        {{ bs.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', width: 120, height: 120 }}
      {%- elsif bs.image_asset != blank -%}
        <img src="{{ bs.image_asset | asset_url }}" alt="" loading="lazy" width="120" height="120" onerror="this.remove()">
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if bs.title != blank -%}<span class="krino-bundle-card__title">{{ bs.title }}</span>{%- endif -%}
  {%- if bs.subtitle != blank -%}<span class="krino-bundle-card__qty">{{ bs.subtitle }}</span>{%- endif -%}
  <span class="krino-bundle-card__price">
    <b class="krino-bundle-card__amount">{{ kbc_unit | money }}</b>
    <span class="krino-bundle-card__per">
      {%- if bs.unit_label != blank -%}<span class="krino-bundle-card__unit">{{ bs.unit_label }}</span>{%- endif -%}
      {%- if kbc_unit_compare > 0 -%}<s class="krino-bundle-card__compare">{{ kbc_unit_compare | money }}</s>{%- endif -%}
    </span>
  </span>
  {%- if bs.supply != blank -%}<span class="krino-bundle-card__supply">{{ bs.supply }}</span>{%- endif -%}
  {%- if bs.perk != blank -%}
    <span class="krino-bundle-card__perk">{%- if bs.perk_check -%}{% render 'krino-icon', name: 'check', size: 13, stroke: 2 %}{%- endif -%}<span>{{ bs.perk }}</span></span>
  {%- endif -%}
  {%- if bs.gift_line != blank -%}<span class="krino-bundle-card__gift">{{ bs.gift_line }}</span>{%- endif -%}
  {%- if kbc_save != blank -%}<span class="krino-bundle-card__save">{{ kbc_save }}</span>{%- endif -%}
</label>
{% stylesheet %}
  .krino-bundle-card { position: relative; display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 0; padding: 16px 10px 18px; border: 1.5px solid var(--krino-bundles-card-border, rgb(0 0 0 / 0.13)); border-radius: var(--krino-bundles-radius, 8px); background: var(--krino-bundles-card-bg, #fcfcfc); color: var(--krino-bundles-text, #252525); text-align: center; cursor: pointer; transition: border-color 0.15s ease, background-color 0.15s ease; }
  .krino-bundle-card.is-selected { border-color: var(--krino-bundles-sel-border, #3d5afe); background: var(--krino-bundles-sel-bg, #f5f7ff); box-shadow: 0 0 0 0.5px var(--krino-bundles-sel-border, #3d5afe); }
  .krino-bundle-card.is-unavailable { opacity: 0.5; cursor: not-allowed; }
  .krino-bundle-card:has(.krino-bundle-card__input:focus-visible) { outline: 2px solid var(--krino-bundles-sel-border, #3d5afe); outline-offset: 2px; }
  .krino-bundle-card__input { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); border: 0; white-space: nowrap; }
  .krino-bundle-card__badge { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); max-width: calc(100% + 8px); padding: 3px 9px; border-radius: 4px; background: linear-gradient(135deg, var(--krino-bundles-from, #09184c), var(--krino-bundles-to, #3d5afe)); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; line-height: 1.3; text-transform: uppercase; white-space: nowrap; }
  .krino-bundle-card__thumb { display: flex; align-items: center; justify-content: center; height: var(--krino-bundles-thumb, 60px); margin-bottom: 4px; }
  .krino-bundle-card__thumb img { width: auto; max-width: 100%; height: 100%; object-fit: contain; }
  .krino-bundle-card__title { font-size: var(--krino-bundles-title-size, 14px); font-weight: 600; line-height: 1.25; }
  .krino-bundle-card__qty { color: var(--krino-bundles-muted, #757575); font-size: 11px; line-height: 1.3; }
  .krino-bundle-card__price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; column-gap: 5px; line-height: 1.25; }
  .krino-bundle-card__amount { font-size: var(--krino-bundles-price-size, 16px); font-weight: 700; }
  .krino-bundle-card__per { display: inline-flex; align-items: baseline; gap: 6px; font-size: 13px; }
  .krino-bundle-card__compare { color: #9e9e9e; font-size: 13px; }
  .krino-bundle-card__supply { color: var(--krino-bundles-muted, #757575); font-size: 11px; line-height: 1.3; }
  .krino-bundle-card__perk { display: inline-flex; align-items: center; justify-content: center; gap: 3px; color: var(--krino-bundles-accent, #3d5afe); font-size: 12px; line-height: 1.3; }
  .krino-bundle-card__perk svg { flex: 0 0 auto; }
  .krino-bundle-card__gift { color: var(--krino-bundles-accent, #3d5afe); font-size: 11px; font-weight: 700; letter-spacing: 0.02em; line-height: 1.3; }
  .krino-bundle-card__save { position: absolute; bottom: 0; left: 50%; transform: translate(-50%, 50%); padding: 3px 9px; border-radius: 4px; background: linear-gradient(135deg, var(--krino-bundles-from, #09184c), var(--krino-bundles-to, #3d5afe)); color: #fff; font-size: 10px; font-weight: 700; line-height: 1.3; white-space: nowrap; }
  @media screen and (max-width: 749px) {
    .krino-bundles--m-row .krino-bundle-card { padding: 14px 6px 16px; }
    .krino-bundles--m-row .krino-bundle-card__badge { padding: 3px 6px; font-size: 9px; }
    .krino-bundle-card__title { font-size: var(--krino-bundles-title-size-m, 12px); }
    .krino-bundle-card__amount { font-size: var(--krino-bundles-price-size-m, 15px); }
    .krino-bundles--m-row .krino-bundle-card__price { flex-direction: column; align-items: center; }
    .krino-bundles--m-row .krino-bundle-card__per { gap: 4px; font-size: 11px; }
    .krino-bundles--m-row .krino-bundle-card__compare { font-size: 11px; }
    .krino-bundles--m-row .krino-bundle-card__perk { font-size: 10.5px; }
    .krino-bundles--m-row .krino-bundle-card__gift { font-size: 10px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Bundle card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "value",
      "label": "Option value (exact spelling)",
      "default": "1 frasco",
      "info": "Variant mode: value of the option set on the parent block (e.g. Paquete). If the product has no variant with this value, the card works in quantity mode and this is only its internal name."
    },
    {
      "type": "range",
      "id": "quantity",
      "label": "Units in this pack",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "info": "Quantity mode: this many units of the chosen shade are added to the cart."
    },
    {
      "type": "range",
      "id": "free_units",
      "label": "Free units (quantity mode)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "info": "Shown price = price x (units - free units). Create the matching automatic discount in Shopify (Discounts > Buy X get Y), or checkout charges full price."
    },
    {
      "type": "checkbox",
      "id": "preselect",
      "label": "Selected by default",
      "default": false,
      "info": "Selected on page load when the link has no ?variant=. Tip: make this value the first value of the option in Shopify so it is also the default variant."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image theme asset (fallback file name)",
      "default": "krino-bundle-1.png"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on the top border (sale event label)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Básico"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Quantity line",
      "default": "1 frasco"
    },
    {
      "type": "text",
      "id": "unit_label",
      "label": "Unit label after the price",
      "default": "/ frasco"
    },
    {
      "type": "text",
      "id": "supply",
      "label": "Supply line",
      "default": "Para 1 mes"
    },
    {
      "type": "text",
      "id": "perk",
      "label": "Perk line",
      "default": "Cambio de tono GRATIS"
    },
    {
      "type": "checkbox",
      "id": "perk_check",
      "label": "Check mark before the perk",
      "default": true
    },
    {
      "type": "text",
      "id": "gift_line",
      "label": "Gift line (e.g. + ENVÍO GRATIS)"
    },
    {
      "type": "text",
      "id": "save",
      "label": "Save pill on the bottom border",
      "default": "Ahorra 22%",
      "info": "{percent} = savings vs the crossed-out total, e.g. \"Ahorra {percent}%\"."
    }
  ]
}
{% endschema %}
