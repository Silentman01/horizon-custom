{%- comment -%} Old Tom's trust line: shield icon + guarantee text, shown under the buy buttons. {%- endcomment -%}
{%- assign bs = block.settings -%}
<p class="ot-trust" style="{% render 'oldtoms-vars' %}" {{ block.shopify_attributes }}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 2.8l7.5 2.8v5.6c0 4.7-3.1 8.5-7.5 10-4.4-1.5-7.5-5.3-7.5-10V5.6L12 2.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.6 12.2l2.5 2.5 4.4-4.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span>{{ bs.text }}</span>
</p>
{% stylesheet %}
.ot-trust { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin: 0; min-height: 24px; font-size: 12px; line-height: 1.3; color: #121212; }
.ot-trust svg { flex: none; color: var(--ot-green, #24433d); }
{% endstylesheet %}
{% schema %}
{
  "name": "Old Tom's trust line",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "30-Day Money Back Guarantee" }
  ],
  "presets": [{ "name": "Old Tom's trust line" }]
}
{% endschema %}
