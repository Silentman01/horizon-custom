<div class="mojo-us__wrap" style="{% render 'mojo-vars' %}" {{ block.shopify_attributes }}>
{%- if block.settings.heading != blank -%}<p class="mojo-us__heading">{{ block.settings.heading }}{% if block.settings.heading_accent != blank %} <strong>{{ block.settings.heading_accent }}</strong>{% endif %}</p>{%- endif -%}
<ul class="mojo-us" role="list">
  {%- for i in (1..4) -%}
    {%- liquid
      assign k_icon = 'icon_' | append: i
      assign k_img = 'image_' | append: i
      assign k_asset = 'asset_' | append: i
      assign k_cap = 'caption_' | append: i
      assign cap = block.settings[k_cap]
      assign pic = block.settings[k_img]
      assign pic_asset = block.settings[k_asset]
      assign ico = block.settings[k_icon]
    -%}
    {%- if cap != blank -%}
      <li class="mojo-us__li">
        <span class="mojo-us__icon">
          {%- if pic != blank -%}
            {{ pic | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '48px', alt: '' }}
          {%- elsif pic_asset != blank -%}
            <img src="{{ pic_asset | asset_url }}" alt="" loading="lazy" width="48" height="48">
          {%- else -%}
            {% render 'mojo-icon', name: ico, size: 44 %}
          {%- endif -%}
        </span>
        <span class="mojo-us__cap">{{ cap }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
</div>

{% stylesheet %}
.mojo-us__heading { margin: 0 0 14px; text-align: center; font-family: var(--mojo-font-heading); font-size: 16px; font-weight: 500; color: var(--mojo-fg); }
.mojo-us__heading strong { font-weight: 700; }
.mojo-us { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-us__li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
.mojo-us__icon { display: flex; align-items: center; justify-content: center; height: 48px; }
.mojo-us__icon img { width: 48px; height: 48px; object-fit: contain; }
.mojo-us__cap { font-size: 10px; line-height: 1.3; font-weight: 500; }
{% endstylesheet %}

