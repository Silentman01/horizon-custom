{%- comment -%} Old Tom's bullets: 2-column check list, up to 6 items (blank items are skipped). {%- endcomment -%}
{%- assign bs = block.settings -%}
<ul class="ot-bullets" style="{% render 'oldtoms-vars' %}" {{ block.shopify_attributes }}>
  {%- for i in (1..6) -%}
    {%- assign key = 'item_' | append: i -%}
    {%- assign txt = bs[key] -%}
    {%- if txt != blank -%}
      <li class="ot-bullets__item">
        <svg class="ot-bullets__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1.25"/><path d="M4.8 8.2l2.2 2.2 4.2-4.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{{ txt }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
{% stylesheet %}
.ot-bullets { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; width: 100%; }
.ot-bullets__item { display: flex; align-items: center; gap: 8px; font-size: 13px; line-height: 1.3; color: #121212; }
.ot-bullets__icon { flex: none; color: var(--ot-green, #24433d); }
@media screen and (max-width: 360px) { .ot-bullets { grid-template-columns: 1fr; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Old Tom's bullets",
  "tag": null,
  "settings": [
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "Works without killing" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "4 Strong Ingredients" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "Works in Caravans, Barns & Sheds" },
    { "type": "text", "id": "item_4", "label": "Item 4", "default": "Zero Chemicals" },
    { "type": "text", "id": "item_5", "label": "Item 5", "default": "No Mess, No Clean-Up" },
    { "type": "text", "id": "item_6", "label": "Item 6", "default": "Weatherproof" }
  ],
  "presets": [{ "name": "Old Tom's bullets" }]
}
{% endschema %}
