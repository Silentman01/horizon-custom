{%- comment -%}
  Refrain product info: Standard / Premium tier selector (bundle-style radio cards).
  Names and prices come from the product variants (Premium = variant title containing "premium"), or from the texts.
  Selecting a card stores { tier, variantId } in sessionStorage (refrain_tier_v1) and dispatches
  `refrain:tier-change` on document; the quiz (sections/refrain-quiz.liquid) listens, pre-selects the same tier
  in its offer and adds that variant to the cart. The quiz dispatches the same event back. Prefix rf-ptier.
{%- endcomment -%}
{% render 'refrain-fonts' %}
{%- liquid
  assign bs = block.settings
  case bs.font
    when 'serif'
      assign ff = 'var(--rf-serif)'
    when 'theme'
      assign ff = 'var(--font-body--family)'
    else
      assign ff = 'var(--rf-sans)'
  endcase

  assign p = closest.product | default: product
  assign v_std = nil
  assign v_prem = nil
  if p and p.variants.size > 0
    assign v_std = p.variants.first
    for v in p.variants
      assign vt = v.title | downcase
      if vt contains 'premium'
        assign v_prem = v
      endif
    endfor
    if v_prem == nil and p.variants.size > 1
      assign v_prem = p.variants[1]
    endif
    if v_prem and v_std.id == v_prem.id
      assign v_std = p.variants.last
    endif
  endif

  assign std_name = bs.std_name
  assign std_price = bs.std_price
  assign prem_name = bs.prem_name
  assign prem_price = bs.prem_price
  if bs.source == 'variants'
    if v_std
      assign std_name = v_std.title
      assign std_price = v_std.price | money_without_trailing_zeros
    endif
    if v_prem and v_prem.id != v_std.id
      assign prem_name = v_prem.title
      assign prem_price = v_prem.price | money_without_trailing_zeros
    endif
  endif
  assign std_id = v_std.id | default: ''
  assign prem_id = v_prem.id | default: std_id

  assign show_std = false
  if std_name != blank or std_price != blank
    assign show_std = true
  endif
  assign show_prem = false
  if prem_name != blank or prem_price != blank
    assign show_prem = true
  endif
  assign sel = bs.default_tier | default: 'premium'
  if sel == 'premium' and show_prem == false
    assign sel = 'standard'
  elsif sel == 'standard' and show_std == false
    assign sel = 'premium'
  endif
  assign uid = 'rf-ptier-' | append: block.id
-%}
<refrain-tier-pick
  class="rf-ptier{% if bs.stack_mobile %} rf-ptier--stack{% endif %}{% if bs.hide_mobile %} rf-ptier--hm{% endif %}{% if bs.hide_desktop %} rf-ptier--hd{% endif %}"
  role="radiogroup"
  {% if bs.group_label != blank %}aria-label="{{ bs.group_label | escape }}"{% endif %}
  data-default="{{ sel }}"
  style="{% render 'refrain-vars' %} --rf-ptier-ff: {{ ff }}; --rf-ptier-s-bg: {{ bs.std_bg }}; --rf-ptier-s-line: {{ bs.std_border }}; --rf-ptier-s-text: {{ bs.std_color }}; --rf-ptier-s-soft: {{ bs.std_soft }}; --rf-ptier-p-bg: {{ bs.prem_bg }}; --rf-ptier-p-text: {{ bs.prem_color }}; --rf-ptier-p-price: {{ bs.prem_price_color }}; --rf-ptier-p-soft: {{ bs.prem_soft }}; --rf-ptier-b-bg: {{ bs.badge_bg }}; --rf-ptier-b-text: {{ bs.badge_color }}; --rf-ptier-ring: {{ bs.ring_color }}; --rf-ptier-ns: {{ bs.name_size }}px; --rf-ptier-ps: {{ bs.price_size }}px; --rf-ptier-ps-m: {{ bs.price_size_mobile }}px; --rf-ptier-ts: {{ bs.text_size }}px; --rf-ptier-radius: {{ bs.radius }}px; --rf-ptier-gap: {{ bs.gap }}px; --rf-ptier-mt: {{ bs.margin_top }}px; --rf-ptier-mb: {{ bs.margin_bottom }}px;"
  {{ block.shopify_attributes }}
>
  {%- if show_std -%}
    <div class="rf-ptier__card" role="radio" aria-checked="{% if sel == 'standard' %}true{% else %}false{% endif %}" tabindex="{% if sel == 'standard' %}0{% else %}-1{% endif %}" data-tier="standard" data-variant="{{ std_id }}" aria-labelledby="{{ uid }}-sn {{ uid }}-sp"{% if bs.std_text != blank %} aria-describedby="{{ uid }}-st"{% endif %}>
      <p class="rf-ptier__top"><span class="rf-ptier__radio" aria-hidden="true"></span><span class="rf-ptier__name" id="{{ uid }}-sn">{{ std_name | escape }}</span><span class="rf-ptier__price" id="{{ uid }}-sp">{{ std_price | escape }}</span></p>
      {%- if bs.std_text != blank -%}<p class="rf-ptier__txt" id="{{ uid }}-st">{{ bs.std_text | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if show_prem -%}
    <div class="rf-ptier__card rf-ptier__card--prem" role="radio" aria-checked="{% if sel == 'premium' %}true{% else %}false{% endif %}" tabindex="{% if sel == 'premium' %}0{% else %}-1{% endif %}" data-tier="premium" data-variant="{{ prem_id }}" aria-labelledby="{{ uid }}-pn {{ uid }}-pp"{% if bs.prem_text != blank %} aria-describedby="{{ uid }}-pt"{% endif %}>
      {%- if bs.prem_badge != blank -%}<span class="rf-ptier__badge" aria-hidden="true">{{ bs.prem_badge | escape }}</span>{%- endif -%}
      <p class="rf-ptier__top"><span class="rf-ptier__radio" aria-hidden="true"></span><span class="rf-ptier__name" id="{{ uid }}-pn">{{ prem_name | escape }}</span><span class="rf-ptier__price" id="{{ uid }}-pp">{{ prem_price | escape }}</span></p>
      {%- if bs.prem_text != blank -%}<p class="rf-ptier__txt" id="{{ uid }}-pt">{{ bs.prem_text | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}
</refrain-tier-pick>
{% stylesheet %}
  .rf-ptier { display: grid; grid-auto-columns: minmax(0, 1fr); grid-auto-flow: column; gap: var(--rf-ptier-gap, 10px); width: 100%; margin: var(--rf-ptier-mt, 0) 0 var(--rf-ptier-mb, 0); font-family: var(--rf-ptier-ff); }
  .rf-ptier__card { position: relative; box-sizing: border-box; padding: 14px; border-radius: var(--rf-ptier-radius, 18px); background: var(--rf-ptier-s-bg, #fff); box-shadow: inset 0 0 0 1.5px var(--rf-ptier-s-line, #E3D9FA); color: var(--rf-ptier-s-text, #1E0F4A); cursor: pointer; -webkit-tap-highlight-color: transparent; user-select: none; transition: box-shadow .18s ease, transform .18s ease; }
  .rf-ptier__card--prem { background: var(--rf-ptier-p-bg, #1E0F4A); box-shadow: none; color: var(--rf-ptier-p-text, #fff); }
  .rf-ptier__card:hover { transform: translateY(-1px); }
  .rf-ptier__card[aria-checked='true'] { box-shadow: inset 0 0 0 2px var(--rf-ptier-ring, #6A4BD8), 0 0 0 2px var(--rf-ptier-ring, #6A4BD8), 0 12px 28px -16px rgb(30 15 74 / .55); }
  .rf-ptier__card:focus { outline: none; }
  .rf-ptier__card:focus-visible { outline: 3px solid var(--rf-ptier-ring, #6A4BD8); outline-offset: 4px; }
  .rf-ptier__badge { position: absolute; top: -10px; right: 12px; padding: 3px 10px; border-radius: 999px; background: var(--rf-ptier-b-bg, #D4F53C); color: var(--rf-ptier-b-text, #1E0F4A); font-size: 11px; font-weight: 800; line-height: 1.4; white-space: nowrap; }
  .rf-ptier__top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 4px 8px; margin: 0; }
  .rf-ptier__radio { position: relative; flex: none; box-sizing: border-box; width: 18px; height: 18px; border-radius: 50%; border: 2px solid currentColor; opacity: .55; transition: opacity .15s; }
  .rf-ptier__radio::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: currentColor; transform: scale(0); transition: transform .15s ease; }
  .rf-ptier__card[aria-checked='true'] .rf-ptier__radio { opacity: 1; }
  .rf-ptier__card[aria-checked='true'] .rf-ptier__radio::after { transform: scale(1); }
  .rf-ptier__card--prem .rf-ptier__radio { color: var(--rf-ptier-p-price, #D4F53C); }
  .rf-ptier__name { font-size: var(--rf-ptier-ns, 15px); font-weight: 800; line-height: 1.25; }
  .rf-ptier__price { font-size: var(--rf-ptier-ps-m, 22px); font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; white-space: nowrap; }
  .rf-ptier__card--prem .rf-ptier__price { color: var(--rf-ptier-p-price, #D4F53C); }
  .rf-ptier__txt { margin: 6px 0 0; font-size: var(--rf-ptier-ts, 13px); line-height: 1.45; color: var(--rf-ptier-s-soft, #5E5384); }
  .rf-ptier__card--prem .rf-ptier__txt { color: var(--rf-ptier-p-soft, #DCCFFF); }
  @media (max-width: 749px) {
    .rf-ptier:not(.rf-ptier--stack) .rf-ptier__top { grid-template-columns: auto minmax(0, 1fr); }
    .rf-ptier:not(.rf-ptier--stack) .rf-ptier__price { grid-column: 1 / -1; margin-top: 2px; }
    .rf-ptier--stack { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: minmax(0, 1fr); row-gap: calc(var(--rf-ptier-gap, 10px) + 6px); }
    .rf-ptier--hm { display: none; }
  }
  @media (min-width: 750px) {
    .rf-ptier__price { font-size: var(--rf-ptier-ps, 24px); }
    .rf-ptier--hd { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rf-ptier__card, .rf-ptier__radio, .rf-ptier__radio::after { transition: none; }
    .rf-ptier__card:hover { transform: none; }
  }
{% endstylesheet %}
{% javascript %}
  if (!customElements.get('refrain-tier-pick')) {
    const RF_TIER_KEY = 'refrain_tier_v1';
    const readTier = () => {
      try {
        const d = JSON.parse(sessionStorage.getItem(RF_TIER_KEY));
        return d && (d.tier === 'standard' || d.tier === 'premium') ? d : null;
      } catch (e) { return null; }
    };
    class RefrainTierPick extends HTMLElement {
      connectedCallback() {
        this.cards = [...this.querySelectorAll('[role="radio"][data-tier]')];
        if (!this.cards.length) return;
        this.onClick = (e) => {
          const card = e.target.closest('[role="radio"][data-tier]');
          if (card && this.contains(card)) this.choose(card, true, false);
        };
        this.onKey = (e) => {
          const card = e.target.closest('[role="radio"][data-tier]');
          if (!card) return;
          const i = this.cards.indexOf(card);
          let next = null;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = this.cards[(i + 1) % this.cards.length];
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = this.cards[(i - 1 + this.cards.length) % this.cards.length];
          else if (e.key === 'Home') next = this.cards[0];
          else if (e.key === 'End') next = this.cards[this.cards.length - 1];
          else if (e.key === ' ' || e.key === 'Enter') next = card;
          if (!next) return;
          e.preventDefault();
          this.choose(next, true, true);
        };
        this.onSync = (e) => {
          const d = e.detail || {};
          if (d.source === this) return;
          const card = this.find(d.tier, d.variantId);
          if (card) this.choose(card, false, false);
        };
        this.addEventListener('click', this.onClick);
        this.addEventListener('keydown', this.onKey);
        document.addEventListener('refrain:tier-change', this.onSync);
        /* Session choice wins; otherwise the server-rendered default (setting) is announced so the quiz follows it. */
        const saved = readTier();
        const card = (saved && this.find(saved.tier, saved.variantId)) || this.find(this.dataset.default) || this.cards[0];
        this.choose(card, false, false);
        if (!saved) this.emit(card, false);
      }
      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        this.removeEventListener('keydown', this.onKey);
        document.removeEventListener('refrain:tier-change', this.onSync);
      }
      find(tier, variantId) {
        const id = variantId ? String(variantId) : '';
        return (id && this.cards.find((c) => c.dataset.variant === id && c.dataset.tier === tier)) || this.cards.find((c) => c.dataset.tier === tier) || null;
      }
      choose(card, user, focus) {
        this.cards.forEach((c) => {
          const on = c === card;
          c.setAttribute('aria-checked', on ? 'true' : 'false');
          c.tabIndex = on ? 0 : -1;
        });
        if (focus) card.focus();
        if (user) this.emit(card, true);
      }
      emit(card, store) {
        const detail = { tier: card.dataset.tier, variantId: Number(card.dataset.variant) || null, source: this };
        if (store) {
          try { sessionStorage.setItem(RF_TIER_KEY, JSON.stringify({ tier: detail.tier, variantId: detail.variantId })); } catch (e) {}
        }
        document.dispatchEvent(new CustomEvent('refrain:tier-change', { detail }));
      }
    }
    customElements.define('refrain-tier-pick', RefrainTierPick);
  }
{% endjavascript %}
{% schema %}
{
  "name": "Refrain · Tier selector",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Clickable Standard / Premium cards. The choice is shared with the quiz offer and used at checkout." },
    { "type": "select", "id": "source", "label": "Names and prices", "default": "variants", "options": [ { "value": "variants", "label": "From the product variants" }, { "value": "texts", "label": "From the texts below" } ], "info": "Premium = the variant whose title contains \"premium\". Texts below are used as fallback." },
    { "type": "select", "id": "default_tier", "label": "Selected by default", "default": "premium", "options": [ { "value": "premium", "label": "Premium" }, { "value": "standard", "label": "Standard" } ] },
    { "type": "text", "id": "group_label", "label": "Accessible group label", "default": "Choisissez votre formule" },
    { "type": "header", "content": "Standard" },
    { "type": "text", "id": "std_name", "label": "Name (fallback; empty name and price hide the card)", "default": "Standard" },
    { "type": "text", "id": "std_price", "label": "Price (fallback)", "default": "19 €" },
    { "type": "text", "id": "std_text", "label": "Summary", "default": "2 chansons complètes et leurs paroles, sous 24 h." },
    { "type": "header", "content": "Premium" },
    { "type": "text", "id": "prem_name", "label": "Name (fallback; empty name and price hide the card)", "default": "Premium" },
    { "type": "text", "id": "prem_price", "label": "Price (fallback)", "default": "35 €" },
    { "type": "text", "id": "prem_badge", "label": "Badge (empty hides it)", "default": "Pour l'offrir en grand" },
    { "type": "text", "id": "prem_text", "label": "Summary", "default": "Tout le Standard, le clip paroles animé et la pochette, sous 12 h." },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "font", "label": "Font", "default": "sans", "options": [ { "value": "sans", "label": "Plus Jakarta Sans" }, { "value": "serif", "label": "Fraunces Italic" }, { "value": "theme", "label": "Theme body font" } ] },
    { "type": "range", "id": "name_size", "label": "Name size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "price_size", "label": "Price size (desktop)", "min": 14, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "price_size_mobile", "label": "Price size (mobile)", "min": 14, "max": 36, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "text_size", "label": "Summary size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Standard colors" },
    { "type": "color", "id": "std_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "std_border", "label": "Border", "default": "#E3D9FA" },
    { "type": "color", "id": "std_color", "label": "Name, price and radio", "default": "#1E0F4A" },
    { "type": "color", "id": "std_soft", "label": "Summary", "default": "#5E5384" },
    { "type": "header", "content": "Premium colors" },
    { "type": "color", "id": "prem_bg", "label": "Background", "default": "#1E0F4A" },
    { "type": "color", "id": "prem_color", "label": "Name", "default": "#FFFFFF" },
    { "type": "color", "id": "prem_price_color", "label": "Price and radio", "default": "#D4F53C" },
    { "type": "color", "id": "prem_soft", "label": "Summary", "default": "#DCCFFF" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#D4F53C" },
    { "type": "color", "id": "badge_color", "label": "Badge text", "default": "#1E0F4A" },
    { "type": "header", "content": "Selected state" },
    { "type": "color", "id": "ring_color", "label": "Selected ring and focus outline", "default": "#6A4BD8" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "stack_mobile", "label": "Stack the cards on mobile", "default": false },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Space below", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on desktop", "default": false }
  ],
  "presets": [ { "name": "Refrain · Tier selector" } ]
}
{% endschema %}
