<p class="oralys-pdp-urg" style="--opu-text:{{ block.settings.c_text }};--opu-bg:{{ block.settings.c_bg }}" {{ block.shopify_attributes }}>{% if block.settings.icon %}{% render 'oralys-pdp-icon', name: 'clock', size: 20 %}{% endif %}<span>{{ block.settings.text }}</span></p>

{% stylesheet %}
.oralys-pdp-urg{display:flex;align-items:center;justify-content:center;gap:8px;margin:0;padding:10px 14px;border-radius:12px;background:var(--opu-bg);color:var(--opu-text);font-weight:700;font-size:15px;line-height:1.3;text-align:center}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : urgence",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Offre de lancement : se termine ce soir à minuit"
    },
    {
      "type": "checkbox",
      "id": "icon",
      "label": "Icône horloge",
      "default": true
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_bg",
      "label": "Fond",
      "default": "#FDF0EE"
    }
  ],
  "presets": [
    {
      "name": "Oralys : urgence"
    }
  ]
}
{% endschema %}
