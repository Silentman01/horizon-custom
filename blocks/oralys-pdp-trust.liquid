{%- assign bs = block.settings -%}
<div class="oralys-pdp-trust" style="--opt-accent:{{ bs.c_accent }};--opt-text:{{ bs.c_text }};--opt-tint:{{ bs.c_tint }}" {{ block.shopify_attributes }}>
  {%- if bs.delivery != blank %}<p class="oralys-pdp-trust__del">{% if bs.delivery_icon != 'none' %}{% render 'oralys-pdp-icon', name: bs.delivery_icon, size: 20 %}{% endif %}<span>{{ bs.delivery }}</span></p>{% endif -%}
  <ul class="oralys-pdp-trust__row" role="list">
    {%- for i in (1..4) -%}{%- assign k = 'item_' | append: i -%}{%- assign ik = 'icon_' | append: i -%}
      {%- if bs[k] != blank -%}<li class="oralys-pdp-trust__item">{% if bs[ik] != 'none' %}<span class="oralys-pdp-trust__ic">{% render 'oralys-pdp-icon', name: bs[ik], size: 20 %}</span>{% endif %}<span>{{ bs[k] }}</span></li>{%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
.oralys-pdp-trust{display:grid;gap:12px;color:var(--opt-text)}
.oralys-pdp-trust__del{display:flex;align-items:center;justify-content:center;gap:8px;margin:0;font-size:14px;font-weight:600;text-align:center;color:var(--opt-text)}
.oralys-pdp-trust__del svg{color:var(--opt-accent);flex:0 0 auto}
.oralys-pdp-trust__row{list-style:none;margin:0;padding:12px;display:grid;grid-template-columns:1fr 1fr;gap:10px 12px;border-radius:12px;background:var(--opt-tint)}
.oralys-pdp-trust__item{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;line-height:1.25}
.oralys-pdp-trust__ic{flex:0 0 auto;color:var(--opt-accent);display:inline-flex}
{% endstylesheet %}

