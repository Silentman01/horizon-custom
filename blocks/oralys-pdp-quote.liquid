{%- assign bs = block.settings -%}
<figure class="oralys-pdp-quote" style="--opq-rule:{{ bs.c_rule }};--opq-text:{{ bs.c_text }};--opq-muted:{{ bs.c_muted }};--opq-star:{{ bs.c_star }}" {{ block.shopify_attributes }}>
  {%- if bs.image != blank or bs.asset != blank -%}<span class="oralys-pdp-quote__av">{% render 'oralys-pdp-media', image: bs.image, asset: bs.asset, alt: bs.author, class: 'oralys-pdp-quote__img', width: 80, height: 80 %}</span>{%- endif -%}
  <div>
    <blockquote class="oralys-pdp-quote__text">{{ bs.text }}</blockquote>
    <figcaption class="oralys-pdp-quote__by">{% if bs.show_stars %}<span class="oralys-pdp-quote__stars" aria-hidden="true">★★★★★</span>{% endif %}{{ bs.author }}</figcaption>
  </div>
</figure>

{% stylesheet %}
.oralys-pdp-quote{display:flex;gap:12px;align-items:flex-start;margin:0;padding:2px 0 2px 14px;border-left:3px solid var(--opq-rule);color:var(--opq-text)}
.oralys-pdp-quote__av{flex:0 0 44px;width:44px;height:44px;border-radius:50%;overflow:hidden;background:#EEF6F1}
.oralys-pdp-quote__img{width:100%;height:100%;object-fit:cover;display:block}
.oralys-pdp-quote__text{margin:0;font-size:15px;line-height:1.45;font-style:italic}
.oralys-pdp-quote__by{margin-top:6px;font-size:13px;color:var(--opq-muted);font-weight:600;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.oralys-pdp-quote__stars{color:var(--opq-star);letter-spacing:1px}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : mini-avis",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Avis",
      "default": "« Pendant neuf ans, j'ai ri la main devant la bouche. Le premier soir avec Oralys, j'ai ri à table sans y penser. »"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Auteur",
      "default": "Monique R., 69 ans, Angers"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Photo : fichier du thème",
      "default": "oralys-pdp-rev-t01.webp"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Afficher les étoiles",
      "default": true
    },
    {
      "type": "color",
      "id": "c_rule",
      "label": "Filet à gauche",
      "default": "#0E6B50"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Auteur",
      "default": "#5C6863"
    },
    {
      "type": "color",
      "id": "c_star",
      "label": "Étoiles",
      "default": "#F0A830"
    }
  ],
  "presets": [
    {
      "name": "Oralys : mini-avis"
    }
  ]
}
{% endschema %}
