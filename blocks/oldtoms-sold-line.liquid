{%- comment -%}
  Old Tom's "1,000,000+ Sold in <flag>" line. Place it after the accordion: this block's stylesheet also skins the
  native buy-box accordion rows (green outlined boxes, lime chevron disc) when this block is in the same buy box.
{%- endcomment -%}
{%- assign bs = block.settings -%}
<p class="ot-sold" style="{% render 'oldtoms-vars' %}" {{ block.shopify_attributes }}>{{ bs.text }}</p>
{% stylesheet %}
.ot-sold { width: 100%; margin: 0; text-align: center; font-size: 13px; font-weight: 700; line-height: 1.4; text-transform: uppercase; color: #24433d; }
.product-details:has(.ot-sold) .accordion { display: grid; gap: 8px; border: 0; }
.product-details:has(.ot-sold) .accordion accordion-custom .details { border: 1.5px solid #24433d; border-radius: 6px; overflow: hidden; }
.product-details:has(.ot-sold) .accordion .details__header { min-height: 50px; padding-inline: 14px; font-family: var(--font-body--family); font-size: 13px; font-weight: 700; text-transform: uppercase; color: #24433d; }
.product-details:has(.ot-sold) .accordion .details-content { padding-inline: 14px; padding-bottom: 14px; font-size: 13px; }
.product-details:has(.ot-sold) .accordion .icon-caret { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #ccf46f; color: #24433d; }
.product-details:has(.ot-sold) .accordion .icon-caret svg { width: 12px; height: 12px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Old Tom's sold line",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "1,000,000+ Sold in 🇬🇧" }
  ],
  "presets": [{ "name": "Old Tom's sold line" }]
}
{% endschema %}
