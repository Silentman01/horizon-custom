{%- comment -%} Krino benefit bullets with check icons (buy box). Prefix krino-benefits. {%- endcomment -%}
{%- assign bs = block.settings -%}
<ul
  class="krino-benefits"
  style="--krino-benefits-icon: {{ bs.icon_color }}; --krino-benefits-color: {{ bs.text_color }}; --krino-benefits-size: {{ bs.text_size }}px; --krino-benefits-size-m: {{ bs.text_size_mobile }}px; --krino-benefits-weight: {{ bs.weight }}; --krino-benefits-gap: {{ bs.row_gap }}px; --krino-benefits-pt: {{ bs.padding_top }}px; --krino-benefits-pb: {{ bs.padding_bottom }}px;"
  {{ block.shopify_attributes }}
>
  {%- for i in (1..5) -%}
    {%- capture kb_key -%}item_{{ i }}{%- endcapture -%}
    {%- if bs[kb_key] != blank -%}
      <li class="krino-benefits__item">
        <span class="krino-benefits__icon">{% render 'krino-icon', name: bs.icon, size: bs.icon_size, stroke: 1.3 %}</span>
        <span class="krino-benefits__text">{{ bs[kb_key] }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
{% stylesheet %}
  .krino-benefits { display: flex; flex-direction: column; gap: var(--krino-benefits-gap, 8px); width: 100%; margin: 0; padding: var(--krino-benefits-pt, 0) 0 var(--krino-benefits-pb, 0); list-style: none; }
  .krino-benefits__item { display: flex; align-items: center; gap: 10px; color: var(--krino-benefits-color, #252525); font-size: var(--krino-benefits-size, 14px); font-weight: var(--krino-benefits-weight, 500); line-height: 1.4; }
  .krino-benefits__icon { display: flex; flex: 0 0 auto; color: var(--krino-benefits-icon, #3d5afe); }
  @media screen and (max-width: 749px) { .krino-benefits__item { font-size: var(--krino-benefits-size-m, 14px); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Krino benefits",
  "tag": null,
  "settings": [
    { "type": "text", "id": "item_1", "label": "Bullet 1", "default": "Rellena entradas y zonas despobladas en 10 segundos" },
    { "type": "text", "id": "item_2", "label": "Bullet 2", "default": "A prueba de sudor y agua por +48 hrs" },
    { "type": "text", "id": "item_3", "label": "Bullet 3", "default": "Indetectable: se ve como cabello real" },
    { "type": "text", "id": "item_4", "label": "Bullet 4 (optional)" },
    { "type": "text", "id": "item_5", "label": "Bullet 5 (optional)" },
    { "type": "header", "content": "Icon" },
    { "type": "select", "id": "icon", "label": "Icon", "default": "check-circle", "options": [
      { "value": "check-circle", "label": "Check in circle" }, { "value": "check", "label": "Check" }, { "value": "verified", "label": "Verified badge" }, { "value": "star", "label": "Star" }
    ] },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#3D5AFE" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 24 },
    { "type": "header", "content": "Text" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#252525" },
    { "type": "select", "id": "weight", "label": "Weight", "default": "500", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }
    ] },
    { "type": "range", "id": "text_size", "label": "Text size (desktop)", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "text_size_mobile", "label": "Text size (mobile)", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "row_gap", "label": "Gap between rows", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Krino benefits" }]
}
{% endschema %}
