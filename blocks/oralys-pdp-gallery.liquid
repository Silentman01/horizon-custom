{%- liquid
  assign bs = block.settings
  assign show = false
  if bs.mode == 'always'
    assign show = true
  elsif bs.mode == 'fallback' and closest.product.media.size == 0
    assign show = true
  endif
  assign lines = bs.items | newline_to_br | split: '<br />'
-%}
{%- if show -%}
<div class="oralys-pdp-gal" style="--opg-r:{{ bs.radius }}px;--opg-dot:{{ bs.c_dot }};--opg-dot-off:{{ bs.c_dot_off }}" {{ block.shopify_attributes }}>
  <div class="oralys-pdp-gal__track" data-oralys-pdp-drag data-opg-track>
    {%- assign n = 0 -%}
    {%- for line in lines -%}
      {%- assign parts = line | split: '|' -%}
      {%- assign file = parts[0] | strip -%}
      {%- assign alt = parts[1] | strip -%}
      {%- if file == blank -%}{%- continue -%}{%- endif -%}
      {%- assign n = n | plus: 1 -%}
      {%- liquid
        assign pick = blank
        if n == 1
          assign pick = bs.image_1
        elsif n == 2
          assign pick = bs.image_2
        elsif n == 3
          assign pick = bs.image_3
        endif
        if n == 1
          assign lo = 'eager'
        else
          assign lo = 'lazy'
        endif
      -%}
      <div class="oralys-pdp-gal__slide">{% render 'oralys-pdp-media', image: pick, asset: file, alt: alt, class: 'oralys-pdp-gal__img', loading: lo, width: 1200, height: 1200 %}</div>
    {%- endfor -%}
  </div>
  {%- if n > 1 -%}
  <div class="oralys-pdp-gal__dots" aria-hidden="true">{% for i in (1..n) %}<span class="oralys-pdp-gal__dot{% if forloop.first %} is-on{% endif %}"></span>{% endfor %}</div>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
.oralys-pdp-gal{width:100%;max-width:620px;margin:0 auto}
.oralys-pdp-gal__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;gap:0;border-radius:var(--opg-r);cursor:grab;overscroll-behavior-x:contain}
.oralys-pdp-gal__track::-webkit-scrollbar{display:none}
.oralys-pdp-gal__track.is-dragging{scroll-snap-type:none;cursor:grabbing;user-select:none}
.oralys-pdp-gal__slide{flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1/1;background:#EEF6F1}
.oralys-pdp-gal__img{display:block;width:100%;height:100%;object-fit:cover;pointer-events:none}
.oralys-pdp-gal__dots{display:flex;justify-content:center;gap:8px;margin-top:12px}
.oralys-pdp-gal__dot{width:8px;height:8px;border-radius:50%;background:var(--opg-dot-off);transition:all .2s}
.oralys-pdp-gal__dot.is-on{background:var(--opg-dot);width:22px;border-radius:8px}
{% endstylesheet %}

{% javascript %}
(() => {
  if (window.__oralysPdpDrag) return; window.__oralysPdpDrag = true;
  const init = () => document.querySelectorAll('[data-oralys-pdp-drag]:not([data-oralys-pdp-drag-ready])').forEach((rail) => {
    rail.setAttribute('data-oralys-pdp-drag-ready', '');
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.classList.add('is-dragging'); rail.setPointerCapture(id); }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return; id = -1; if (!moved) return;
      const left = rail.scrollLeft; rail.classList.remove('is-dragging'); rail.scrollLeft = left;
      const card = rail.firstElementChild, step = card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(rail).columnGap || 0) : 0;
      if (step) rail.scrollTo({ left: Math.round(left / step) * step, behavior: 'smooth' });
    };
    rail.addEventListener('pointerup', end); rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    rail.addEventListener('dragstart', (e) => e.preventDefault());
  });
  init(); document.addEventListener('shopify:section:load', init); document.addEventListener('DOMContentLoaded', init);
})();

(() => {
  const bind = () => document.querySelectorAll('[data-opg-track]:not([data-opg-ready])').forEach((t) => {
    t.setAttribute('data-opg-ready', '');
    const dots = t.parentElement.querySelectorAll('.oralys-pdp-gal__dot');
    t.addEventListener('scroll', () => {
      const i = Math.round(t.scrollLeft / Math.max(1, t.clientWidth));
      dots.forEach((d, k) => d.classList.toggle('is-on', k === i));
    }, { passive: true });
  });
  bind(); document.addEventListener('shopify:section:load', bind); document.addEventListener('DOMContentLoaded', bind);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Oralys : galerie",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Affichage",
      "default": "fallback",
      "options": [
        {
          "value": "fallback",
          "label": "Seulement si le produit n'a pas d'images"
        },
        {
          "value": "always",
          "label": "Toujours"
        },
        {
          "value": "off",
          "label": "Jamais"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "items",
      "label": "Images (une par ligne : fichier du thème | texte alternatif)",
      "default": "oralys-pdp-v2-01.webp | Tient 2 à 3 jours, pas une matinée.\noralys-pdp-v2-02.webp | Avant, elle cachait son sourire.\noralys-pdp-v2-03.webp | On ne colle pas un vide. On le comble.\noralys-pdp-v2-04.webp | Il prend la forme de vos gencives.\noralys-pdp-v2-05.webp | « Il faudra vous y faire. » Non.\noralys-pdp-v2-06.webp | Tout ce à quoi vous aviez renoncé.\noralys-pdp-v2-07.webp | Le résultat d'un rebasage, le prix d'un tube.\noralys-pdp-v2-08.webp | « Ce n'est pas la colle, c'est le vide. »\noralys-pdp-v2-09.webp | « J'ai remangé du pain. »\noralys-pdp-v2-10.webp | 90 jours pour l'essayer."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (remplace la ligne 1)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (remplace la ligne 2)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (remplace la ligne 3)"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Arrondi",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "c_dot",
      "label": "Points : couleur active",
      "default": "#0E6B50"
    },
    {
      "type": "color",
      "id": "c_dot_off",
      "label": "Points : couleur",
      "default": "#DCE5E0"
    }
  ],
  "presets": [
    {
      "name": "Oralys : galerie"
    }
  ]
}
{% endschema %}
