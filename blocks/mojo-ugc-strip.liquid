{%- assign s = block.settings -%}
<div class="mojo-up" style="{% render 'mojo-vars' %}--mojo-up-r:{{ s.radius }}px;" {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}<p class="mojo-up__heading">{{ s.heading }}</p>{%- endif -%}
  <div class="mojo-up__row">{% content_for 'blocks' %}</div>
</div>

{% stylesheet %}
.mojo-up { font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-up__heading { margin: 0 0 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
.mojo-up__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo UGC strip",
  "blocks": [
    {
      "type": "_mojo-ugc-photo"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See What Others Are Saying"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "default": 0,
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Mojo UGC strip",
      "blocks": [
        {
          "type": "_mojo-ugc-photo"
        },
        {
          "type": "_mojo-ugc-photo"
        },
        {
          "type": "_mojo-ugc-photo"
        }
      ]
    }
  ]
}
{% endschema %}
