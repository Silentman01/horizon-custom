{%- comment -%} Old Tom's rating line: 5 stars + editable text. Static text (no reviews app). {%- endcomment -%}
{%- assign bs = block.settings -%}
<div class="ot-rating" style="{% render 'oldtoms-vars' %}" {{ block.shopify_attributes }}>
  <span class="ot-rating__stars" role="img" aria-label="{{ bs.stars_label | escape }}">
    {%- for i in (1..5) -%}
      <svg class="ot-rating__star" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.5 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9z"/></svg>
    {%- endfor -%}
  </span>
  <span class="ot-rating__text">{{ bs.text }}</span>
</div>
{% stylesheet %}
.ot-rating { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.3; color: #121212; }
.ot-rating__stars { display: inline-flex; gap: 2px; color: var(--ot-lime, #ccf46f); filter: drop-shadow(0 0 0.5px rgba(36, 67, 61, 0.9)); flex: none; }
.ot-rating__star { display: block; width: 14px; height: 14px; }
.ot-rating__text { font-weight: 500; }
{% endstylesheet %}
{% schema %}
{
  "name": "Old Tom's rating line",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "4.8/5 Based on (14,932+ Homes Protected)" },
    { "type": "text", "id": "stars_label", "label": "Stars accessibility label", "default": "Rated 4.8 out of 5 stars" }
  ],
  "presets": [{ "name": "Old Tom's rating line" }]
}
{% endschema %}
