{%- comment -%} Compact trust + scarcity strip shown above the product title: badge, generic star rating, offer line. {%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign show_top = false
  if bs.badge != blank or bs.show_rating
    assign show_top = true
  endif
-%}
<div class="au-trust" style="{% render 'aurea-vars' %}" {{ block.shopify_attributes }}>
  {%- if show_top -%}
    <div class="au-trust__top">
      {%- if bs.badge != blank -%}
        <span class="au-trust__badge">
          <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor" aria-hidden="true"><path d="M12 .587l3.668 7.431 8.144 1.18-5.906 5.434 1.391 8.079L12 18.896l-7.297 3.843 1.391-8.079-5.906-5.434 8.144-1.18z"/></svg>
          {{- bs.badge -}}
        </span>
      {%- endif -%}
      {%- if bs.show_rating -%}
        <span class="au-trust__rating">
          <span class="au-trust__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 .587l3.668 7.431 8.144 1.18-5.906 5.434 1.391 8.079L12 18.896l-7.297 3.843 1.391-8.079-5.906-5.434 8.144-1.18z"/></svg>
            {%- endfor -%}
          </span>
          {%- if bs.rating_label != blank -%}<strong class="au-trust__label">{{ bs.rating_label }}</strong>{%- endif -%}
          {%- if bs.rating_score != blank -%}<span class="au-trust__score">{{ bs.rating_score }}</span>{%- endif -%}
          {%- if bs.rating_count != blank -%}<span class="au-trust__count{% unless bs.count_mobile %} au-trust--desk{% endunless %}">{{ bs.rating_count }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if bs.offer != blank or bs.scarcity != blank -%}
    <p class="au-trust__offer">
      <i class="au-trust__dot{% if bs.pulse %} is-pulsing{% endif %}" aria-hidden="true"></i>
      <span class="au-trust__offer-text">
        {%- if bs.offer != blank -%}<strong>{{ bs.offer }}</strong>{%- endif -%}
        {%- if bs.offer != blank and bs.scarcity != blank -%}<span class="au-trust__sep" aria-hidden="true">·</span>{%- endif -%}
        {%- if bs.scarcity != blank -%}<span>{{ bs.scarcity }}</span>{%- endif -%}
        {%- if bs.guarantee != blank -%}<span class="au-trust__guar{% unless bs.guarantee_mobile %} au-trust--desk{% endunless %}"><span class="au-trust__sep" aria-hidden="true">·</span>{{ bs.guarantee }}</span>{%- endif -%}
      </span>
    </p>
  {%- endif -%}
</div>
{% stylesheet %}
  .au-trust { display: grid; gap: 7px; width: 100%; font-family: var(--au-body); color: var(--au-ink); line-height: 1.3; }
  .au-trust__top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .au-trust__badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px 4px 8px; border-radius: 4px; background: var(--au-pine); color: var(--au-parchment); font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
  .au-trust__badge svg { flex: none; color: var(--au-gold); }
  .au-trust__rating { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; font-size: 13.5px; }
  .au-trust__stars { display: inline-flex; gap: 1px; color: var(--au-gold); }
  .au-trust__stars svg { display: block; }
  .au-trust__label { font-weight: 700; }
  .au-trust__count { color: var(--au-muted); }
  .au-trust__count::before { content: '·'; margin-right: 6px; color: var(--au-muted); }
  .au-trust__offer { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--au-pine); }
  .au-trust__offer strong { font-weight: 700; }
  .au-trust__sep { margin: 0 6px; color: var(--au-gold); }
  .au-trust__dot { position: relative; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--au-gold); }
  .au-trust__dot.is-pulsing::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--au-gold); animation: au-trust-pulse 1.8s ease-out infinite; }
  @keyframes au-trust-pulse { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(2.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .au-trust__dot.is-pulsing::after { animation: none; opacity: 0; } }
  @media (max-width: 749px) {
    .au-trust { gap: 6px; }
    .au-trust__rating { font-size: 13px; }
    .au-trust__offer { font-size: 11px; letter-spacing: 0.06em; }
    .au-trust__sep { margin: 0 4px; }
    .au-trust--desk { display: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea trust strip",
  "settings": [
    { "type": "paragraph", "content": "Compact badge, star rating and offer line for above the product title. Keep each text short so it fits on 2 lines on mobile." },
    { "type": "header", "content": "Badge and rating" },
    { "type": "text", "id": "badge", "label": "Badge (leave empty to hide)", "default": "Bestseller" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "rating_label", "label": "Rating word", "default": "Excellent" },
    { "type": "text", "id": "rating_score", "label": "Rating score", "default": "4.8/5" },
    { "type": "text", "id": "rating_count", "label": "Rating count", "default": "193,819+ customers" },
    { "type": "checkbox", "id": "count_mobile", "label": "Show rating count on mobile (may add a 3rd line)", "default": false },
    { "type": "header", "content": "Offer line" },
    { "type": "text", "id": "offer", "label": "Offer", "default": "Buy 1 Get 1 Free" },
    { "type": "text", "id": "scarcity", "label": "Scarcity", "default": "Moon batch 96% reserved" },
    { "type": "text", "id": "guarantee", "label": "Guarantee (desktop by default)", "default": "30-day guarantee" },
    { "type": "checkbox", "id": "guarantee_mobile", "label": "Show guarantee on mobile", "default": false },
    { "type": "checkbox", "id": "pulse", "label": "Pulsing dot", "default": true }
  ],
  "presets": [ { "name": "Aurea trust strip" } ]
}
{% endschema %}
