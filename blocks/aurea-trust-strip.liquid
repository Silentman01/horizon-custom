{%- comment -%} Stacked trust blocks above the product title: bestseller card, star-rating pill (Trustpilot mark only when a profile URL is set), urgency line. {%- endcomment -%}
{%- assign bs = block.settings -%}
<div class="au-ts" style="{% render 'aurea-vars' %}" {{ block.shopify_attributes }}>
  {%- if bs.best_title != blank or bs.best_tagline != blank -%}
    <div class="au-ts-best">
      <span class="au-ts-best__chip" aria-hidden="true">{{ bs.best_icon | default: '★' }}</span>
      <span class="au-ts-best__txt">
        {%- if bs.best_title != blank -%}<strong>{{ bs.best_title }}</strong>{%- endif -%}
        {%- if bs.best_tagline != blank -%}<em>{{ bs.best_tagline }}</em>{%- endif -%}
      </span>
    </div>
  {%- endif -%}
  {%- if bs.show_rating -%}
    {%- capture tp_label -%}{{ bs.rating_label }}, {{ bs.rating_score }}{% if bs.trustpilot_url != blank %} on Trustpilot{% endif %}{%- endcapture -%}
    {%- if bs.trustpilot_url != blank -%}
      <a class="au-ts-tp" href="{{ bs.trustpilot_url }}" target="_blank" rel="noopener" aria-label="{{ tp_label | escape }}">
    {%- else -%}
      <div class="au-ts-tp" role="img" aria-label="{{ tp_label | escape }}">
    {%- endif -%}
      <span class="au-ts-tp__in" aria-hidden="true">
        <span class="au-ts-tp__stars"><svg viewBox="0 0 512 96" width="512" height="96" focusable="false">
          {%- for i in (0..4) -%}
            <g transform="translate({{ i | times: 104 }} 0)"><rect width="96" height="96" fill="#00B67A"/><path d="M48 16.2l7.9 24.2h25.7L60.8 55.4l7.9 24.2L48 64.6 27.3 79.6l7.9-24.2-20.8-15h25.7z" fill="#fff"/></g>
          {%- endfor -%}
        </svg></span>
        <span class="au-ts-tp__text">
          {%- if bs.rating_label != blank -%}<strong>{{ bs.rating_label }}</strong>{%- endif -%}
          {%- if bs.rating_score != blank -%}<span>{{ bs.rating_score }}</span>{%- endif -%}
        </span>
        {%- if bs.trustpilot_url != blank -%}
