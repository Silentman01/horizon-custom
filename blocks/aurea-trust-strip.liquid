  {%- endif -%}
  {%- if bs.offer != blank -%}
    <p class="au-ts-urg"><span class="au-ts-urg__dot" aria-hidden="true"></span>{{ bs.offer }}</p>
  {%- endif -%}
</div>
{% stylesheet %}
  .au-ts { display: flex; flex-direction: column; align-items: flex-start; width: 100%; margin-bottom: -2px; font-family: var(--au-body); }
  .au-ts-best { display: flex; align-items: center; gap: 12px; box-sizing: border-box; width: 100%; margin: 0 0 10px; padding: 10px 14px; background: var(--au-parchment); border: 2px solid var(--au-gold); border-radius: 4px; font-size: 16px; line-height: 1.8; letter-spacing: 0.32px; }
  .au-ts-best__chip { flex: 0 0 auto; min-width: 36.8px; box-sizing: border-box; padding: 6px 10px; border-radius: 4px; background: var(--au-gold); color: #fff; text-align: center; font-size: 14px; font-weight: 700; line-height: 1; letter-spacing: 0.02em; }
  .au-ts-best__txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .au-ts-best__txt strong { font-size: 12.5px; font-weight: 600; line-height: 1.8; letter-spacing: 0.03em; text-transform: uppercase; color: var(--au-pine); }
  .au-ts-best__txt em { font-size: 12.5px; font-style: italic; font-weight: 400; line-height: 1.35; letter-spacing: 0.32px; color: #6e6e73; }
  .au-ts-tp { display: flex; justify-content: flex-start; width: fit-content; max-width: 100%; margin: 0; padding: 5px; box-sizing: border-box; border: 1px solid #dce7df; border-radius: 5px; background: linear-gradient(180deg, #fbfbfb, #f3f7f3 100%); color: #1d2922; font-size: 12px; line-height: 1.25; letter-spacing: 0.32px; text-decoration: none; }
  a.au-ts-tp:hover { border-color: #00b67a; }
  .au-ts-tp__in { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; width: fit-content; line-height: 1.8; }
  .au-ts-tp__stars { display: flex; flex: 0 0 auto; margin-right: 3px; }
  .au-ts-tp__stars svg, .au-ts-tp__brand svg { display: block; width: auto; height: 15px; }
  .au-ts-tp__text { display: inline-flex; gap: 5px; align-items: center; white-space: nowrap; }
  .au-ts-tp__text strong { font-weight: 700; }
  .au-ts-tp__brand { display: flex; flex: 0 0 auto; margin-left: 5px; }
  .au-ts-urg { display: flex; align-items: center; gap: 8px; width: 100%; margin: 4px 0 0; font-size: 14.5px; font-weight: 700; line-height: 1.8; letter-spacing: 0.04em; text-transform: uppercase; color: #e53935; }
  .au-ts-urg__dot { flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: #e53935; }
  @media (max-width: 749px) {
    .au-ts { margin-bottom: -4px; }
    .au-ts-best { gap: 9px; padding: 8px 10px; font-size: 15px; letter-spacing: 0.3px; }
    .au-ts-best__chip { min-width: 30.4px; padding: 5px 8px; font-size: 12px; }
    .au-ts-best__txt strong, .au-ts-best__txt em { font-size: 11.5px; }
    .au-ts-best__txt em { letter-spacing: 0.3px; }
    .au-ts-tp { padding: 4px; }
    .au-ts-tp__stars svg, .au-ts-tp__brand svg { height: 13px; }
    .au-ts-urg { font-size: 12px; }
    .au-ts-urg__dot { width: 6px; height: 6px; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Aurea trust strip",
  "settings": [
    { "type": "header", "content": "Bestseller card" },
    { "type": "text", "id": "best_icon", "label": "Icon tile character", "default": "★" },
    { "type": "text", "id": "best_title", "label": "Title (leave title and tagline empty to hide)", "default": "Our #1 Bestseller This Season" },
    { "type": "text", "id": "best_tagline", "label": "Tagline", "default": "Real Citrine, Aventurine & Turquoise, Worn Daily For Wealth, Luck And Growth." },
    { "type": "header", "content": "Rating pill" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating pill", "default": true },
    { "type": "text", "id": "rating_label", "label": "Rating word", "default": "Excellent" },
    { "type": "text", "id": "rating_score", "label": "Rating score", "default": "4.8 out of 5" },
    { "type": "url", "id": "trustpilot_url", "label": "Trustpilot profile URL", "info": "Only show if this matches your real Trustpilot rating. When set, the Trustpilot logo appears and the pill links to your profile. When empty, the pill shows the stars and score without the Trustpilot mark." },
    { "type": "header", "content": "Urgency line" },
    { "type": "text", "id": "offer", "label": "Offer text (keep the % in sync with the batch box)", "default": "Buy 1 Get 1 Free — Half Price | 96% Reserved" }
  ],
  "presets": [ { "name": "Aurea trust strip" } ]
}
{% endschema %}
