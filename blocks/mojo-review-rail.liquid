{%- assign s = block.settings -%}
<style>
  #mojo-rv-{{ block.id }} .mojo-rv__rail { display: flex; flex-wrap: nowrap; overflow-x: auto; }
  #mojo-rv-{{ block.id }} .mojo-rv__rail > * { flex: 0 0 100% !important; max-width: 100% !important; width: 100% !important; min-width: 0; }
  @media screen and (min-width: 750px) {
    #mojo-rv-{{ block.id }} .mojo-rv__rail > * { flex: 0 0 calc((100% - 12px) / 2) !important; max-width: calc((100% - 12px) / 2) !important; width: calc((100% - 12px) / 2) !important; }
  }
</style>
<div class="mojo-rv" id="mojo-rv-{{ block.id }}" style="{% render 'mojo-vars' %}" data-mojo-rail-wrap data-mojo-overflow="0" {{ block.shopify_attributes }}>
  <div class="mojo-rv__head">
    <h2 class="mojo-rv__heading">{{ s.heading }}</h2>
    <div class="mojo-rv__arrows">
      <button type="button" class="mojo-rv__next" data-mojo-prev aria-label="Previous reviews" disabled>{% render 'mojo-icon', name: 'prev', size: 16 %}</button>
      <button type="button" class="mojo-rv__next" data-mojo-next aria-label="Next reviews">{% render 'mojo-icon', name: 'next', size: 16 %}</button>
    </div>
  </div>
  <div class="mojo-rv__rail" data-mojo-rail>{% content_for 'blocks' %}</div>
  {%- if s.rating_line != blank -%}<p class="mojo-rv__line">{{ s.rating_line }}</p>{%- endif -%}
</div>

{% stylesheet %}
.mojo-rv { font-family: var(--mojo-font); color: var(--mojo-fg); min-width: 0; }
.mojo-rv__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.mojo-rv__heading { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.mojo-rv__next { width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--mojo-primary); color: var(--mojo-cream); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
.mojo-rv__next:disabled { opacity: 0.35; cursor: default; }
.mojo-rv__arrows { display: flex; gap: 8px; }
.mojo-rv__rail > .mojo-rv__card { flex: 0 0 100%; }
@media screen and (min-width: 750px) { .mojo-rv__rail > .mojo-rv__card { flex: 0 0 calc((100% - 12px) / 2); } }
.mojo-rv__line { margin: 12px 0 0; font-size: 12px; text-align: center; }

.mojo-rv__rail { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; -webkit-overflow-scrolling: touch; }
.mojo-rv__rail::-webkit-scrollbar { display: none; }
.mojo-rv__rail[data-mojo-dragging] { scroll-snap-type: none; cursor: grabbing; user-select: none; }
.mojo-rv__dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
.mojo-rv__dots button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: var(--mojo-line); cursor: pointer; }
.mojo-rv__dots button[aria-current='true'] { background: var(--mojo-primary); }
[data-mojo-overflow='0'] > .mojo-rv__dots { display: none; }
{% endstylesheet %}

{% javascript %}
if (!window.mojoRails) {
  window.mojoRails = true;
  const setup = (rail) => {
    if (rail.dataset.mojoReady) return;
    rail.dataset.mojoReady = '1';
    const wrap = rail.closest('[data-mojo-rail-wrap]') || rail.parentElement;
    const dots = wrap.querySelector('[data-mojo-dots]');
    const prev = wrap.querySelector('[data-mojo-prev]');
    const next = wrap.querySelector('[data-mojo-next]');
    const cards = () => [...rail.children];
    const step = () => {
      const c = cards();
      if (c.length > 1) return c[1].getBoundingClientRect().left - c[0].getBoundingClientRect().left;
      return c[0] ? c[0].getBoundingClientRect().width : 0;
    };
    const index = () => { const s = step(); return s ? Math.round(rail.scrollLeft / s) : 0; };
    const sync = () => {
      const over = rail.scrollWidth > rail.clientWidth + 2;
      wrap.dataset.mojoOverflow = over ? '1' : '0';
      if (dots) {
        if (dots.children.length !== cards().length) {
          dots.textContent = '';
          cards().forEach((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', 'Go to item ' + (i + 1));
            b.addEventListener('click', () => rail.scrollTo({ left: i * step(), behavior: 'smooth' }));
            dots.appendChild(b);
          });
        }
        const at = index();
        [...dots.children].forEach((b, i) => b.setAttribute('aria-current', i === at ? 'true' : 'false'));
      }
      if (prev) prev.disabled = rail.scrollLeft <= 2;
      if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
    };
    if (prev) prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) { moved = true; rail.setAttribute('data-mojo-dragging', ''); rail.setPointerCapture(id); }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.removeAttribute('data-mojo-dragging');
      rail.scrollLeft = left;
      const s = step();
      if (s) rail.scrollTo({ left: Math.round(left / s) * s, behavior: 'smooth' });
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    sync();
    setTimeout(sync, 400);
  };
  const init = () => document.querySelectorAll('[data-mojo-rail]').forEach(setup);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('shopify:section:load', init);
}
{% endjavascript %}

{% schema %}
{
  "name": "Mojo review rail",
  "blocks": [
    {
      "type": "_mojo-review-card"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "rating_line",
      "label": "Rating line under the rail",
      "default": "Rated 4.8/5 based on 4,276+ customers."
    }
  ],
  "presets": [
    {
      "name": "Mojo review rail",
      "blocks": [
        {
          "type": "_mojo-review-card"
        },
        {
          "type": "_mojo-review-card"
        },
        {
          "type": "_mojo-review-card"
        },
        {
          "type": "_mojo-review-card"
        },
        {
          "type": "_mojo-review-card"
        },
        {
          "type": "_mojo-review-card"
        }
      ]
    }
  ]
}
{% endschema %}
