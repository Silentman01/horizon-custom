{%- comment -%}
  Mojo bundle tiers (app-free quantity breaks, Kaching style). Child cards: _mojo-bundle-tier.
  - Each card adds N pairs to the cart, colour + size chosen per pair (multiple cart lines when they differ).
  - Card prices are computed from the variant prices and the card's bundle price; the tier discount itself is a
    native Shopify automatic discount (fixed amount off, minimum quantity = pairs), so the cart and checkout charge
    exactly the card price. Lines carry the hidden property _Bundle.
  - Add to cart goes through Horizon's own product form (drawer refresh, auto-open, errors stay native).
  - "Mojo price + badge" blocks set to follow the bundle show the selected card's price.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  if request.visual_preview_mode and p == blank
    assign p = collections.all.products.first
  endif
-%}
{%- unless p == blank -%}
  {%- liquid
    assign ci = 1
    assign si = 2
    for o in p.options_with_values
      assign oname = o.name | downcase
      if oname contains 'colo'
        assign ci = o.position
      elsif oname contains 'size'
        assign si = o.position
      endif
    endfor
  -%}
  {%- liquid
    assign bs = block.settings
    assign bn_event = bs.event_name | strip
  -%}
  <mojo-bundle class="mojo-bn" id="mojo-buybox" style="{% render 'mojo-vars' %}--mojo-bn-gap:{{ bs.tier_gap | default: 14 }}px;"{% if bs.countdown %} data-countdown data-ends-in="{{ bs.ends_in | escape }}"{% endif %} {{ block.shopify_attributes }}>
    {%- if bn_event != blank or bs.ends_at != blank -%}
      <p class="mojo-bn__heading{% if bs.heading_style == 'left' %} mojo-bn__heading--left{% endif %}"><span class="mojo-bn__rule" aria-hidden="true"></span><span class="mojo-bn__text">{{ bn_event }} <span class="mojo-bn__when" data-mojo-when>{{ bs.ends_at }}</span></span><span class="mojo-bn__rule" aria-hidden="true"></span></p>
    {%- endif -%}
    <div class="mojo-bn__tiers" role="radiogroup" aria-label="{{ bs.event_name | default: 'Choose your bundle' | escape }}">
      {% content_for 'blocks', closest.product: p %}
    </div>
    <p class="mojo-bn__error" data-mojo-error role="alert" hidden></p>
    <script type="application/json" data-mojo-variants>
      {"ci": {{ ci }}, "si": {{ si }}, "fmt": {{ shop.money_format | json }}, "variants": [
      {%- for v in p.variants -%}
        {"id": {{ v.id }}, "o": [{{ v.option1 | json }}, {{ v.option2 | json }}, {{ v.option3 | json }}], "a": {{ v.available | json }}, "p": {{ v.price | json }}, "c": {{ v.compare_at_price | default: 0 | json }}, "img": {% if v.featured_image %}{{ v.featured_image | image_url: width: 96 | json }}{% else %}""{% endif %}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
      ]}
    </script>
  </mojo-bundle>
{%- endunless -%}

{% stylesheet %}
.mojo-bn { display: block; font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-bn__heading { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; }
.mojo-bn__rule { flex: 1; min-width: 16px; height: 1px; background: #BDB8AE; }
.mojo-bn__text { font-weight: 700; font-size: 13px; letter-spacing: 0.2px; line-height: 1.3; text-transform: uppercase; text-align: center; color: #111111; }
.mojo-bn__when { font-variant-numeric: tabular-nums; }
.mojo-bn__tiers { display: grid; gap: var(--mojo-bn-gap, 14px); }
.mojo-bn { scroll-margin-top: 90px; }
.mojo-bn__heading--left { justify-content: flex-start; }
.mojo-bn__heading--left .mojo-bn__rule { display: none; }
.mojo-bn__heading--left .mojo-bn__text { text-align: left; font-size: 12px; font-weight: 700; }
.mojo-bn__accent { color: var(--mojo-primary); }
.mojo-bn__error { margin: 10px 0 0; font-size: 12px; color: #b3261e; }
.mojo-bn__error[hidden] { display: none; }
.mojo-tier__sel option:disabled { color: #9a9a9a; }
.shopify-section:has(mojo-bundle) .quantity-selector-wrapper, .shopify-section:has(mojo-bundle) .quantity-label, .shopify-section:has(mojo-bundle) .quantity-rules { display: none; }
{% endstylesheet %}

{% javascript %}
if (!customElements.get('mojo-bundle')) {
  customElements.define('mojo-bundle', class extends HTMLElement {
    connectedCallback() {
      try { this.data = JSON.parse(this.querySelector('[data-mojo-variants]').textContent); } catch (e) { this.data = { variants: [], ci: 1, si: 2 }; }
      this.scope = this.closest('.shopify-section') || document;
      this.pass = false;
      if (!this.querySelector('[data-mojo-tier]:checked')) {
        const pre = this.querySelector('[data-mojo-tier][data-preselect]') || this.querySelector('[data-mojo-tier]');
        if (pre) pre.checked = true;
      }
      this.addEventListener('change', this.onChange);
      this.scope.addEventListener('change', this.onNative);
      /* window capture runs before Horizon's document-level (capture) submit delegate, so a bundle add is never doubled */
      window.addEventListener('submit', this.onSubmit, true);
      this.syncUnits();
      this.startCountdown();
    }
    disconnectedCallback() {
      this.removeEventListener('change', this.onChange);
      this.scope.removeEventListener('change', this.onNative);
      window.removeEventListener('submit', this.onSubmit, true);
      clearInterval(this.timer);
    }
    form() { return this.scope.querySelector('product-form-component form') || this.scope.querySelector('form[action*="cart/add"]'); }
    nativeId() { const f = this.form(); const i = f && f.querySelector('input[name="id"]'); return i ? i.value : ''; }
    variantById(id) { return this.data.variants.find((v) => String(v.id) === String(id)); }
    find(colour, size) {
      const { ci, si } = this.data;
      return this.data.variants.find((x) => x.o[ci - 1] === colour && x.o[si - 1] === size);
    }
    resolve(colour, size) { const v = this.find(colour, size); return v ? v.id : this.nativeId(); }
    money(cents) {
      const fmt = this.data.fmt || '£{' + '{amount}}';
      const m = fmt.match(/\{\{\s*(\w+)\s*\}\}/);
      const key = m ? m[1] : 'amount';
      const fix = (d, ts, ds) => {
        const [i, f] = (cents / 100).toFixed(d).split('.');
        return i.replace(/\B(?=(\d{3})+(?!\d))/g, ts) + (f ? ds + f : '');
      };
      let s;
      if (key === 'amount_no_decimals') s = fix(0, ',', '.');
      else if (key === 'amount_with_comma_separator') s = fix(2, '.', ',');
      else if (key === 'amount_no_decimals_with_comma_separator') s = fix(0, '.', ',');
      else if (key === 'amount_with_apostrophe_separator') s = fix(2, "'", '.');
      else s = fix(2, ',', '.');
      return fmt.replace(/\{\{\s*\w+\s*\}\}/, s);
    }
    setThumb(unit, colour, size) {
      const img = unit.querySelector('.mojo-tier__thumb img');
      const { ci } = this.data;
      const v = this.find(colour, size) || this.data.variants.find((x) => x.o[ci - 1] === colour);
      if (img && v && v.img) { img.src = v.img; img.removeAttribute('srcset'); }
    }
    markSizes(unit) {
      const c = unit.querySelector('[data-opt="colour"]').value;
      unit.querySelectorAll('[data-opt="size"] option').forEach((o) => {
        const v = this.find(c, o.value);
        o.disabled = !!v && !v.a;
      });
    }
    syncUnits() {
      const v = this.variantById(this.nativeId());
      this.querySelectorAll('.mojo-tier').forEach((tier) => {
        /* chips ("2x Black, 1x Beige") prefill the pair colours; size follows the main size picker */
        const preset = (tier.dataset.colours || '').split('|').filter(Boolean);
        tier.querySelectorAll('[data-unit-row]').forEach((u, i) => { if (preset[i]) u.dataset.colour = preset[i]; });
      });
      this.querySelectorAll('[data-unit-row]').forEach((u) => {
        const c = u.querySelector('[data-opt="colour"]'), s = u.querySelector('[data-opt="size"]');
        if (!u.dataset.touched) {
          if (u.dataset.colour) c.value = u.dataset.colour; else if (v) c.value = v.o[this.data.ci - 1];
          if (v) s.value = v.o[this.data.si - 1];
        }
        this.markSizes(u);
        this.setThumb(u, c.value, s.value);
      });
      this.refresh();
    }
    idsFor(tier) {
      const qty = Number(tier.dataset.qty) || 1;
      const units = tier.querySelectorAll('[data-unit-row]');
      const ids = [];
      if (units.length) units.forEach((u) => ids.push(this.resolve(u.querySelector('[data-opt="colour"]').value, u.querySelector('[data-opt="size"]').value)));
      else for (let i = 0; i < qty; i++) ids.push(this.nativeId());
      return ids;
    }
    /* recompute every card from the chosen variants: total = sum of prices - fixed tier discount (what checkout charges) */
    price(tier) {
      const qty = Number(tier.dataset.qty) || 1;
      const vs = this.idsFor(tier).map((id) => this.variantById(id)).filter(Boolean);
      if (vs.length !== qty) return null;
      const full = vs.reduce((t, v) => t + v.p, 0);
      const total = Math.max(0, full - (Number(tier.dataset.off) || 0));
      const anchor = tier.dataset.anchor === 'compare_at';
      let compare = vs.reduce((t, v) => t + (anchor && v.c > v.p ? v.c : v.p), 0);
      if (compare <= total) compare = vs.reduce((t, v) => t + (v.c || 0), 0);
      const was = Number(tier.dataset.was) || 0;
      if (was) compare = was * qty;
      if (compare <= total) compare = 0;
      const saving = compare ? compare - total : 0;
      const pct = compare ? Math.round((saving * 100) / compare) : 0;
      const unit = Math.round(total / qty);
      return { qty, total, compare, saving, pct, unit };
    }
    fill(tpl, r) {
      return (tpl || '').replace(/\{saving\}/g, this.money(r.saving)).replace(/\{percent\}/g, r.pct).replace(/\{unit\}/g, this.money(r.unit))
        .replace(/\{total\}/g, this.money(r.total)).replace(/\{compare\}/g, this.money(r.compare));
    }
    refresh() {
      let current = null;
      this.querySelectorAll('.mojo-tier').forEach((tier) => {
        const r = this.price(tier);
        if (!r) return;
        const set = (sel, text, hide) => { const el = tier.querySelector(sel); if (!el) return; if (text !== null) el.textContent = text; el.hidden = !!hide; };
        set('[data-total]', this.money(r.total));
        set('[data-compare]', this.money(r.compare), !r.compare);
        const st = tier.dataset.saveTpl || '';
        set('[data-save]', this.fill(st, r), !st || (st.includes('{') && !r.saving));
        if (tier.dataset.unitTpl) set('[data-unit]', this.fill(tier.dataset.unitTpl, r).replace(/\{price\}/g, this.money(r.total / r.qty)));
        if (tier.querySelector('[data-mojo-tier]:checked')) current = r;
      });
      if (!current) return;
      this.scope.querySelectorAll('[data-mojo-follow]').forEach((box) => {
        const set = (sel, text, hide) => { const el = box.querySelector(sel); if (!el) return; el.textContent = text; el.hidden = !!hide; };
        set('.mojo-pr__now', this.money(current.total));
        set('.mojo-pr__was', this.money(current.compare), !current.compare);
        if (box.dataset.badgeTpl) set('.mojo-pr__badge', this.fill(box.dataset.badgeTpl, current), !current.pct);
        if (box.dataset.chipTpl) {
          const chip = box.querySelector('[data-chip-text]');
          if (chip) chip.textContent = this.fill(box.dataset.chipTpl, current);
        }
      });
    }
    onChange = (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      const unit = t.closest('[data-unit-row]');
      if (unit) {
        unit.dataset.touched = '1';
        this.markSizes(unit);
        this.setThumb(unit, unit.querySelector('[data-opt="colour"]').value, unit.querySelector('[data-opt="size"]').value);
        this.refresh();
      } else if (t.matches('[data-mojo-tier]')) {
        this.syncUnits();
      }
    };
    onNative = (e) => {
      if (this.contains(e.target)) return;
      if (e.target.closest && e.target.closest('variant-picker')) setTimeout(() => this.syncUnits(), 450);
    };
    plan() {
      const checked = this.querySelector('[data-mojo-tier]:checked');
      if (!checked) return null;
      const tier = checked.closest('.mojo-tier');
      const qty = Number(tier.dataset.qty) || 1;
      const groups = [];
      this.idsFor(tier).forEach((id) => { const g = groups.find((x) => x.id === id); if (g) g.qty += 1; else groups.push({ id, qty: 1 }); });
      return { title: tier.dataset.title, qty, groups };
    }
    error(msg) {
      const el = this.querySelector('[data-mojo-error]');
      if (!el) return;
      el.textContent = msg || '';
      el.hidden = !msg;
    }
    onSubmit = (e) => {
      const form = e.target;
      if (this.pass || !(form instanceof HTMLFormElement) || !this.scope.contains(form) || !form.matches('[action*="cart/add"]')) return;
      const plan = this.plan();
      if (!plan || plan.qty < 2) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      this.error('');
      const off = plan.groups.map((g) => this.variantById(g.id)).find((v) => v && !v.a);
      if (off) { this.error('One of the chosen sizes is sold out. Please pick another size.'); return; }
      const submitter = e.submitter;
      const [first, ...rest] = plan.groups;
      const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      const props = { _Bundle: plan.title };
      const addRest = rest.length
        ? fetch(root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: rest.map((g) => ({ id: Number(g.id), quantity: g.qty, properties: props })) }),
          }).then((r) => { if (!r.ok) return r.json().then((j) => { throw new Error((j && (j.description || j.message)) || 'add failed'); }); })
        : Promise.resolve();
      /* defer to a new task: requestSubmit() is ignored while the browser is still firing the original submit event */
      addRest.then(() => new Promise((r) => setTimeout(r, 0))).then(() => {
        /* the first line goes through Horizon's form: it re-renders the cart drawer with every line and auto-opens it */
        const idIn = form.querySelector('input[name="id"]');
        const oldId = idIn.value;
        idIn.value = first.id;
        let q = form.querySelector('input[name="quantity"]');
        const madeQ = !q;
        if (madeQ) { q = document.createElement('input'); q.type = 'hidden'; q.name = 'quantity'; form.appendChild(q); }
        const oldQ = q.value;
        q.value = first.qty;
        const pr = document.createElement('input');
        pr.type = 'hidden'; pr.name = 'properties[_Bundle]'; pr.value = plan.title;
        form.appendChild(pr);
        this.pass = true;
        try { if (submitter && form.contains(submitter)) form.requestSubmit(submitter); else form.requestSubmit(); } finally { this.pass = false; }
        setTimeout(() => { idIn.value = oldId; if (madeQ) q.remove(); else q.value = oldQ; pr.remove(); }, 0);
      }).catch((err) => { this.error(err && err.message ? err.message : 'Could not add the bundle. Please try again.'); });
    };
    /* "<EVENT> ENDS IN 05:12:33": counts down to midnight local time, every day (the sale "ends today") */
    startCountdown() {
      const out = this.querySelector('[data-mojo-when]');
      if (!out || !this.hasAttribute('data-countdown')) return;
      const label = this.dataset.endsIn || 'ENDS IN';
      const pad = (n) => String(n).padStart(2, '0');
      const tick = () => {
        const end = new Date(); end.setHours(24, 0, 0, 0);
        let s = Math.max(0, Math.floor((end - new Date()) / 1000));
        const h = Math.floor(s / 3600); s %= 3600;
        out.textContent = label + ' ' + pad(h) + ':' + pad(Math.floor(s / 60)) + ':' + pad(s % 60);
      };
      tick();
      this.timer = setInterval(tick, 1000);
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "Mojo bundle tiers",
  "blocks": [
    {
      "type": "_mojo-bundle-tier"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "App-free quantity breaks. Each card adds N pairs (colour and size per pair). Card prices come from the variant price and each card's bundle price. For checkout to charge the card price, create one automatic discount per card in Shopify (fixed amount off, minimum quantity = pairs); the editor shows the amount under each card."
    },
    {
      "type": "text",
      "id": "event_name",
      "label": "Sale name (heading line)",
      "default": "EARLY BLACK FRIDAY SALE"
    },
    {
      "type": "checkbox",
      "id": "countdown",
      "label": "Live countdown to midnight",
      "default": true,
      "info": "On: \"EARLY BLACK FRIDAY SALE ENDS IN 05:12:33\", counting down to midnight (visitor's time) every day. Off: the text below."
    },
    {
      "type": "text",
      "id": "ends_in",
      "label": "Countdown label",
      "default": "ENDS IN"
    },
    {
      "type": "text",
      "id": "ends_at",
      "label": "Text without countdown (also shown before the timer starts)",
      "default": "ENDS AT 23:59"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "default": "rules",
      "options": [
        {
          "value": "rules",
          "label": "Centred between lines"
        },
        {
          "value": "left",
          "label": "Left aligned"
        }
      ]
    },
    {
      "type": "range",
      "id": "tier_gap",
      "label": "Gap between cards",
      "default": 14,
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Mojo bundle tiers",
      "blocks": [
        {
          "type": "_mojo-bundle-tier",
          "settings": {
            "quantity": 2,
            "title": "(2 Pack) Buy 1 get 1 Free",
            "pack_price": "24.95",
            "was_per_pair": "25.00",
            "saving": "You save {saving}",
            "badge": "",
            "preselect": false,
            "show_pickers": true,
            "picker_label": "Colour, Size"
          }
        },
        {
          "type": "_mojo-bundle-tier",
          "settings": {
            "quantity": 5,
            "title": "(5 Pack) Buy 2 get 3 Free",
            "pack_price": "49.95",
            "was_per_pair": "25.00",
            "saving": "You save {saving}",
            "badge": "MOST POPULAR",
            "preselect": true,
            "show_pickers": true,
            "picker_label": "Colour, Size"
          }
        },
        {
          "type": "_mojo-bundle-tier",
          "settings": {
            "quantity": 8,
            "title": "(8 Pack) Buy 3 get 5 Free",
            "pack_price": "74.95",
            "was_per_pair": "25.00",
            "saving": "You save {saving}",
            "badge": "BEST VALUE",
            "preselect": false,
            "show_pickers": true,
            "picker_label": "Colour, Size"
          }
        }
      ]
    }
  ]
}
{% endschema %}
