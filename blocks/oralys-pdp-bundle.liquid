{%- liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
  assign obs = block.settings
  assign card_border = obs.c_muted | color_modify: 'alpha', 0.7
  assign max_from = 1
  assign gift_count = 0
  if obs.gifts_enable
    for n in (1..3)
      assign k_name = 'gift_' | append: n | append: '_name'
      assign k_from = 'gift_' | append: n | append: '_from'
      if obs[k_name] != blank
        assign gift_count = gift_count | plus: 1
        if obs[k_from] > max_from
          assign max_from = obs[k_from]
        endif
      endif
    endfor
  endif
-%}
{%- unless product_resource == blank -%}
<oralys-pdp-bundle id="oralys-pdp-offer" class="oralys-pdp-bundle"
  style="--opb-accent:{{ obs.c_accent }};--opb-red:{{ obs.c_red }};--opb-tint:{{ obs.c_tint }};--opb-sel:{{ obs.c_selected_bg }};--opb-sel-border:{{ obs.c_selected_border }};--opb-line:{{ obs.c_line }};--opb-text:{{ obs.c_text }};--opb-muted:{{ obs.c_muted }};--opb-card-border:{{ card_border }};--opb-pill-bg:{{ obs.c_pill_bg }};--opb-pill-text:{{ obs.c_pill_text }};--opb-locked:{{ obs.c_locked }};--opb-r:{{ obs.radius }}px"
  data-max-from="{{ max_from }}" data-gifts="{% if max_from > 1 %}some{% else %}all{% endif %}"
  {% if obs.atc_price %}data-atc{% endif %} {% if obs.hide_native_picker %}data-hide-native{% endif %} {% if obs.hide_quantity %}data-hide-qty{% endif %} {{ block.shopify_attributes }}>
  {%- if obs.heading != blank %}<p class="oralys-pdp-bundle__heading"><span>{{ obs.heading }}</span></p>{% endif -%}
  <div class="oralys-pdp-bundle__tiers" role="radiogroup" aria-label="{{ obs.heading | default: 'Packs' | escape }}">
    {% content_for 'blocks', closest.product: product_resource %}
  </div>
  {%- if gift_count > 0 -%}
  <div class="oralys-pdp-gifts">
    <p class="oralys-pdp-gifts__line" aria-live="polite">
      {%- if obs.gifts_todo != blank %}<span class="oralys-pdp-gifts__todo">{{ obs.gifts_todo }}</span>{% endif -%}
      {%- if obs.gifts_done != blank %}<span class="oralys-pdp-gifts__done">{% render 'oralys-pdp-gift-icon', name: 'check', size: 18 %}<span>{{ obs.gifts_done }}</span></span>{% endif -%}
    </p>
    <ul class="oralys-pdp-gifts__row" role="list" style="--opg-n:{{ gift_count }}">
      {%- for n in (1..3) -%}
        {%- liquid
          assign k = 'gift_' | append: n
          assign k_name = k | append: '_name'
          assign k_value = k | append: '_value'
          assign k_from = k | append: '_from'
          assign k_icon = k | append: '_icon'
          assign k_image = k | append: '_image'
          assign k_hint = k | append: '_hint'
          assign g_name = obs[k_name]
          if g_name == blank
            continue
          endif
          assign g_value = obs[k_value]
          assign g_from = obs[k_from]
          assign g_icon = obs[k_icon]
          assign g_image = obs[k_image]
          assign g_hint = obs[k_hint]
        -%}
        <li class="oralys-pdp-gift" data-from="{{ g_from }}">
          <span class="oralys-pdp-gift__tab">{{ obs.gifts_tab }}{% if g_value != blank %} <s>{{ g_value }}</s>{% endif %}</span>
          <span class="oralys-pdp-gift__ico">
            {%- if g_image != blank -%}
              {{ g_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'oralys-pdp-gift__img', width: 48, height: 48 }}
            {%- else -%}
              {% render 'oralys-pdp-gift-icon', name: g_icon, size: 48 %}
            {%- endif -%}
            <span class="oralys-pdp-gift__lock">{% render 'oralys-pdp-gift-icon', name: 'lock', size: 13 %}</span>
          </span>
          <span class="oralys-pdp-gift__name">{{ g_name }}</span>
          {%- if g_hint != blank and g_from > 1 %}<span class="oralys-pdp-gift__hint">{{ g_hint }}</span>{% endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- endif -%}
</oralys-pdp-bundle>
<script>
  (function () {
    if (!window.oralysPdpSync) {
      window.oralysPdpSync = function (b, fromUser) {
        var inputs = [].slice.call(b.querySelectorAll('.oralys-pdp-tier__input'));
        if (!inputs.length) return null;
        var c = null, i;
        for (i = 0; i < inputs.length; i++) if (inputs[i].checked) { c = inputs[i]; break; }
        if (!c) {
          for (i = 0; i < inputs.length; i++) if (inputs[i].hasAttribute('data-preselect') && !inputs[i].disabled) { c = inputs[i]; break; }
          c = c || inputs[0];
          c.checked = true;
        }
        var idx = inputs.indexOf(c) + 1, prev = parseInt(b.getAttribute('data-sel'), 10) || 0;
        var max = parseInt(b.getAttribute('data-max-from'), 10) || 1;
        inputs.forEach(function (x) { var t = x.closest('.oralys-pdp-tier'); if (t) t.classList.toggle('is-selected', x === c); });
        b.setAttribute('data-sel', idx);
        b.setAttribute('data-gifts', idx >= max ? 'all' : 'some');
        if (fromUser && prev && idx > prev && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          b.querySelectorAll('.oralys-pdp-gift').forEach(function (g) {
            var f = parseInt(g.getAttribute('data-from'), 10) || 1;
            if (f > prev && f <= idx) { g.classList.remove('is-unlocking'); void g.offsetWidth; g.classList.add('is-unlocking'); setTimeout(function () { g.classList.remove('is-unlocking'); }, 800); }
          });
        }
        if (b.hasAttribute('data-atc')) {
          var host = b.closest('.product-details') || b.closest('.shopify-section') || b.parentNode;
          var q = function (s) { return '"' + String(s).replace(/[\\"]/g, '\\$&').replace(/\n/g, ' ') + '"'; };
          host.setAttribute('data-opb-atc', '');
          host.style.setProperty('--opb-atc-now', c.dataset.price ? q(c.dataset.price) : 'none');
          host.style.setProperty('--opb-atc-was', c.dataset.compare ? q(c.dataset.compare) : 'none');
        }
        var d = c.dataset;
        document.dispatchEvent(new CustomEvent('oralys:tier', { detail: { index: idx, label: d.label, price: d.price, compare: d.compare, priceCents: d.priceCents, compareCents: d.compareCents } }));
        return c;
      };
    }
    var s = document.currentScript, b = s && s.previousElementSibling;
    if (b && b.matches('.oralys-pdp-bundle')) window.oralysPdpSync(b, false);
  })();
</script>
{%- endunless -%}

{% stylesheet %}
.oralys-pdp-bundle{display:block;color:var(--opb-text);scroll-margin-top:24px}
.oralys-pdp-bundle__heading{display:flex;align-items:center;gap:10px;margin:0 0 14px;font-size:15px;font-weight:700;line-height:1.3;text-align:center;color:var(--opb-text)}
.oralys-pdp-bundle__heading::before,.oralys-pdp-bundle__heading::after{content:"";flex:1;height:1px;background:var(--opb-line)}
.oralys-pdp-bundle__tiers{display:grid;gap:14px}
.oralys-pdp-bundle.is-flash .oralys-pdp-bundle__tiers{animation:oralys-pdp-flash 1s ease}
@keyframes oralys-pdp-flash{0%,100%{transform:none}30%{transform:scale(1.015)}}

/* Progressive gift strip: locked = padlock + hint, never low-contrast text */
.oralys-pdp-gifts{margin-top:18px}
.oralys-pdp-gifts__line{display:flex;justify-content:center;margin:0 0 18px;font-size:15px;font-weight:700;line-height:1.35;text-align:center;color:var(--opb-text)}
.oralys-pdp-gifts__done{display:none;align-items:center;gap:6px;color:var(--opb-accent);font-weight:800}
.oralys-pdp-bundle[data-gifts="all"] .oralys-pdp-gifts__todo{display:none}
.oralys-pdp-bundle[data-gifts="all"] .oralys-pdp-gifts__done{display:inline-flex}
.oralys-pdp-gifts__row{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--opg-n,3),minmax(0,1fr));gap:8px}
.oralys-pdp-gift{
  --g-bg:#fff;--g-bd:var(--opb-accent);--g-bw:2px;--g-tab:var(--opb-accent);--g-ico:var(--opb-accent);--g-lock-op:0;--g-lock-s:.4;--g-hint:none;
  position:relative;min-width:0;display:flex;flex-direction:column;align-items:center;gap:6px;margin:0;padding:22px 6px 12px;border:var(--g-bw) solid var(--g-bd);border-radius:12px;background:var(--g-bg);text-align:center;
  transition:background-color .35s ease,border-color .35s ease}
.oralys-pdp-bundle[data-sel="1"] .oralys-pdp-gift[data-from="2"],
.oralys-pdp-bundle[data-sel="1"] .oralys-pdp-gift[data-from="3"],
.oralys-pdp-bundle[data-sel="2"] .oralys-pdp-gift[data-from="3"],
.oralys-pdp-bundle[data-sel="1"] .oralys-pdp-gift[data-from="4"],
.oralys-pdp-bundle[data-sel="2"] .oralys-pdp-gift[data-from="4"],
.oralys-pdp-bundle[data-sel="3"] .oralys-pdp-gift[data-from="4"]{
  --g-bg:#F3F5F4;--g-bd:var(--opb-card-border);--g-bw:1.5px;--g-tab:var(--opb-locked);--g-ico:var(--opb-locked);--g-lock-op:1;--g-lock-s:1;--g-hint:block}
.oralys-pdp-gift__tab{position:absolute;top:-11px;left:50%;transform:translateX(-50%);width:max-content;max-width:calc(100% - 6px);padding:2px 7px;border-radius:6px;background:var(--g-tab);color:#fff;font-size:12px;font-weight:800;line-height:1.3;text-align:center;transition:background-color .35s ease}
.oralys-pdp-gift__tab s{font-weight:600;white-space:nowrap}
.oralys-pdp-gift__ico{position:relative;display:flex;align-items:center;justify-content:center;width:48px;height:48px;color:var(--g-ico);transition:color .35s ease}
.oralys-pdp-gift__img{width:48px;height:48px;object-fit:contain;display:block}
.oralys-pdp-gift__lock{position:absolute;right:-8px;bottom:-4px;display:flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;border:2px solid #fff;background:var(--opb-text);color:#fff;opacity:var(--g-lock-op);transform:scale(var(--g-lock-s));transition:opacity .3s ease,transform .3s ease}
.oralys-pdp-gift__name{font-size:14px;font-weight:700;line-height:1.25;color:var(--opb-text);overflow-wrap:break-word}
.oralys-pdp-gift__hint{display:var(--g-hint);font-size:13px;font-weight:700;line-height:1.25;color:var(--opb-accent)}
.oralys-pdp-gift.is-unlocking{animation:oralys-pdp-unlock .7s ease}
.oralys-pdp-gift.is-unlocking .oralys-pdp-gift__ico{animation:oralys-pdp-unlock-ico .7s ease}
@keyframes oralys-pdp-unlock{0%{box-shadow:0 0 0 0 rgba(14,107,80,.35)}40%{transform:scale(1.05)}100%{transform:none;box-shadow:0 0 0 10px rgba(14,107,80,0)}}
@keyframes oralys-pdp-unlock-ico{0%{transform:scale(.8) rotate(-8deg)}50%{transform:scale(1.15) rotate(4deg)}100%{transform:none}}
@media (max-width:374px){
  .oralys-pdp-gifts__row{gap:6px}
  .oralys-pdp-gift{padding:22px 4px 10px}
  .oralys-pdp-gift__tab{padding:2px 5px;font-size:11.5px}
}
@media (prefers-reduced-motion:reduce){
  .oralys-pdp-gift,.oralys-pdp-gift__tab,.oralys-pdp-gift__ico,.oralys-pdp-gift__lock{transition:none}
  .oralys-pdp-gift.is-unlocking,.oralys-pdp-gift.is-unlocking .oralys-pdp-gift__ico,.oralys-pdp-bundle.is-flash .oralys-pdp-bundle__tiers{animation:none}
}

/* Native blocks driven by the cards */
.product-details:has(.oralys-pdp-bundle[data-hide-native]) variant-picker{display:none}
.product-details:has(.oralys-pdp-bundle[data-hide-qty]) .quantity-selector-wrapper{display:none}
.product-details:has(.oralys-pdp-bundle) .accelerated-checkout-block,.product-details:has(.oralys-pdp-bundle) shopify-accelerated-checkout{display:none!important}
.product-details:has(.oralys-pdp-bundle) .add-to-cart-button{min-height:60px;font-size:19px;font-weight:700}

/* Selected pack price inside the add-to-cart button (values set by oralysPdpSync on .product-details) */
[data-opb-atc] [id^="BuyButtons-ProductSubmitButton-"]{flex-wrap:wrap;column-gap:8px;row-gap:0}
[data-opb-atc] [id^="BuyButtons-ProductSubmitButton-"]::before{content:var(--opb-atc-was,none);order:2;font-size:16px;font-weight:500;text-decoration:line-through}
[data-opb-atc] [id^="BuyButtons-ProductSubmitButton-"]::after{content:var(--opb-atc-now,none);order:3}
[data-opb-atc] [id^="BuyButtons-ProductSubmitButton-"]:disabled::before,[data-opb-atc] [id^="BuyButtons-ProductSubmitButton-"]:disabled::after{content:none}
@media (max-width:420px){
  .product-details:has(.oralys-pdp-bundle) .add-to-cart-button{font-size:17px;padding-inline:12px}
  [data-opb-atc] [id^="BuyButtons-ProductSubmitButton-"] .add-to-cart-icon{display:none}
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('oralys-pdp-bundle')) {
  customElements.define('oralys-pdp-bundle', class extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', this.onChange);
      this.addEventListener('focusin', this.onFocus);
      this.addEventListener('focusout', this.onFocus);
      window.addEventListener('pageshow', this.onPageShow);
      this.sync(false);
      const go = () => { this._ready = true; this.alignPicker(); };
      if (customElements.get('variant-picker')) go(); else customElements.whenDefined('variant-picker').then(go);
      setTimeout(() => { if (!this._ready) this.alignPicker(); }, 1500);
    }
    disconnectedCallback() {
      this.removeEventListener('change', this.onChange);
      this.removeEventListener('focusin', this.onFocus);
      this.removeEventListener('focusout', this.onFocus);
      window.removeEventListener('pageshow', this.onPageShow);
    }
    scope() { return this.closest('.shopify-section') || document; }
    picker() { return this.scope().querySelector('variant-picker'); }
    sync(fromUser) { return window.oralysPdpSync ? window.oralysPdpSync(this, fromUser) : null; }
    pickerVariantId() {
      const p = this.picker(); if (!p) return null;
      const r = p.querySelector('input[type="radio"]:checked');
      if (r) return r.dataset.variantId || null;
      const o = p.querySelector('select option:checked');
      return o ? o.dataset.variantId || null : null;
    }
    // Keep the (hidden) native picker + product form on the variant of the checked card.
    alignPicker() {
      const c = this.sync(false); if (!c) return;
      if (c.dataset.variantId) {
        if (this.pickerVariantId() !== c.dataset.variantId) this.select(c.dataset.variantId);
      } else this.setQty(c.dataset.qty);
    }
    onPageShow = (e) => { if (e.persisted) this.alignPicker(); };
    onFocus = (e) => {
      const i = e.target; if (!(i instanceof HTMLInputElement) || !i.classList.contains('oralys-pdp-tier__input')) return;
      const t = i.closest('.oralys-pdp-tier'); if (!t) return;
      let fv = false; try { fv = e.type === 'focusin' && i.matches(':focus-visible'); } catch (_) {}
      t.classList.toggle('is-focus', fv);
    };
    onChange = (e) => {
      const i = e.target; if (!(i instanceof HTMLInputElement) || !i.classList.contains('oralys-pdp-tier__input')) return;
      this.sync(true);
      if (i.dataset.variantId) { this.setQty(1); this.select(i.dataset.variantId); } else this.setQty(i.dataset.qty);
    };
    setQty(q) {
      const n = parseInt(q, 10) || 1;
      this.scope().querySelectorAll('form input[name="quantity"]').forEach((el) => { if (String(el.value) !== String(n)) { el.value = n; el.dispatchEvent(new Event('change', { bubbles: true })); } });
    }
    select(id) {
      this.scope().querySelectorAll('form[data-type="add-to-cart-form"] input[name="id"], product-form-component form input[name="id"]').forEach((el) => { el.value = id; });
      const p = this.picker(); if (!p) return;
      const r = p.querySelector(`input[type="radio"][data-variant-id="${id}"]`);
      if (r) { if (!r.checked) r.click(); return; }
      const o = p.querySelector(`option[data-variant-id="${id}"]`), s = o?.closest('select');
      if (o && s && s.value !== o.value) { s.value = o.value; s.dispatchEvent(new Event('change', { bubbles: true })); }
    }
  });
}
(() => {
  if (window.__oralysPdpOffer) return; window.__oralysPdpOffer = true;
  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a[href="#oralys-pdp-offer"]');
    if (!a) return;
    const t = document.querySelector('.oralys-pdp-bundle') || document.querySelector('.buy-buttons-block') || document.querySelector('[id^="ProductInformation-"]');
    if (!t) return;
    e.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    t.classList.add('is-flash'); setTimeout(() => t.classList.remove('is-flash'), 1200);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Oralys : packs",
  "settings": [
    {
      "type": "paragraph",
      "content": "Chaque carte correspond à une variante du produit (option « Pack » : 1 tube / 2 tubes / 4 tubes). Les prix viennent des variantes ; sans variantes, les prix de secours de chaque carte s'affichent et la quantité ajoutée suit la carte. Gardez le bloc Sélecteur de variante : il est masqué et piloté par ces cartes."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Choisissez votre pack"
    },
    {
      "type": "checkbox",
      "id": "hide_native_picker",
