{%- comment -%} One gift tile inside "Krino free gifts": icon, title, crossed-out value, GRATIS. Prefix krino-gift. {%- endcomment -%}
{%- assign bs = block.settings -%}
<div class="krino-gift"{% if bs.only_for != blank %} data-krino-only="{{ bs.only_for | strip | escape }}"{% endif %} {{ block.shopify_attributes }}>
  {%- if bs.icon != 'none' -%}<span class="krino-gift__icon">{% render 'krino-icon', name: bs.icon, size: 22, stroke: 1.4 %}</span>{%- endif -%}
  <span class="krino-gift__title">{{ bs.title }}</span>
  {%- if bs.value != blank -%}<s class="krino-gift__value">{{ bs.value }}</s>{%- endif -%}
  {%- if bs.free_label != blank -%}<span class="krino-gift__free">{{ bs.free_label }}</span>{%- endif -%}
</div>
{% stylesheet %}
  .krino-gift { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 3px; min-width: 0; padding: 14px 6px; border: 1px solid var(--krino-gifts-border, rgb(0 0 0 / 0.13)); border-radius: var(--krino-gifts-radius, 8px); background: var(--krino-gifts-bg, #fcfcfc); color: var(--krino-gifts-text, #252525); text-align: center; font-size: var(--krino-gifts-size, 12px); line-height: 1.3; }
  .krino-gift__icon { display: flex; color: var(--krino-gifts-accent, #3d5afe); margin-bottom: 2px; }
  .krino-gift__value { color: #9e9e9e; font-size: 0.92em; }
  .krino-gift__free { color: var(--krino-gifts-accent, #3d5afe); font-size: 0.92em; font-weight: 700; text-transform: uppercase; }
  @media screen and (max-width: 749px) { .krino-gift { padding: 12px 4px; font-size: var(--krino-gifts-size-m, 11px); } }
{% endstylesheet %}
{% schema %}
{
  "name": "Gift",
  "tag": null,
  "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "gift", "options": [
      { "value": "gift", "label": "Gift" }, { "value": "truck", "label": "Truck" }, { "value": "verified", "label": "Verified badge" }, { "value": "check-circle", "label": "Check" }, { "value": "none", "label": "None" }
    ] },
    { "type": "text", "id": "title", "label": "Title", "default": "Aplicador de precisión" },
    { "type": "text", "id": "value", "label": "Crossed-out value", "default": "$249" },
    { "type": "text", "id": "free_label", "label": "Free label", "default": "GRATIS" },
    { "type": "text", "id": "only_for", "label": "Show only for this pack value (optional)", "info": "e.g. 3 frascos. Empty = always shown." }
  ]
}
{% endschema %}
