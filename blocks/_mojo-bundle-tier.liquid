{%- comment -%}
  One Mojo bundle card. Quantity mode (no pack variants, like Kaching quantity breaks): the card adds
  {quantity} pairs, with a colour + size choice per pair. Prices are computed from the product variant:
  full = variant price x pairs, bundle price = "Bundle price" setting (empty = full price).
  Checkout charges the bundle price only when the matching automatic discount exists in Shopify:
  fixed amount off = full - bundle price, minimum quantity = pairs (shown in the editor under the card).
  Text tokens: {total} {compare} {saving} {percent} {unit} {price}.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  assign bs = block.settings
  assign ci = 1
  assign si = 2
  for o in p.options_with_values
    assign oname = o.name | downcase
    if oname contains 'colo'
      assign ci = o.position
    elsif oname contains 'size'
      assign si = o.position
    endif
  endfor
  assign qty = bs.quantity | at_least: 1
  assign pickers = bs.show_pickers
  if p.options_with_values.size < 2 or qty < 2
    assign pickers = false
  endif
  assign cidx = ci | minus: 1
  assign sidx = si | minus: 1
  assign col_option = p.options_with_values[cidx]
  assign size_option = p.options_with_values[sidx]
  assign col_values = col_option.values
  assign size_values = size_option.values
  assign chip_list = bs.chips | split: ','
  assign line_list = bs.free_lines | newline_to_br | split: '<br />'

  assign v = p.selected_or_first_available_variant
  assign mt_full = v.price | times: qty
  assign mt_total = mt_full
  if bs.pack_price != blank and bs.pack_price > 0
    assign mt_total = bs.pack_price | times: 100 | round
  endif
  if mt_total > mt_full
    assign mt_total = mt_full
  endif
  assign mt_off = mt_full | minus: mt_total
  assign mt_cmp_unit = v.price
  if bs.anchor == 'compare_at' and v.compare_at_price > v.price
    assign mt_cmp_unit = v.compare_at_price
  endif
  assign mt_compare = mt_cmp_unit | times: qty
  if mt_compare <= mt_total
    assign mt_compare = v.compare_at_price | default: 0 | times: qty
  endif
  if mt_compare <= mt_total
    assign mt_compare = 0
  endif
  assign mt_saving = 0
  assign mt_pct = 0
  if mt_compare > 0
    assign mt_saving = mt_compare | minus: mt_total
    assign mt_pct = mt_saving | times: 100.0 | divided_by: mt_compare | round
  endif
  assign mt_unit = mt_total | times: 1.0 | divided_by: qty | round

  assign f_total = mt_total | money
  assign f_compare = mt_compare | money
  assign f_saving = mt_saving | money
  assign f_unit = mt_unit | money
  assign f_price = v.price | money
  assign f_off = mt_off | money

  assign t_save = bs.saving | replace: '{saving}', f_saving | replace: '{percent}', mt_pct | replace: '{unit}', f_unit | replace: '{total}', f_total | replace: '{compare}', f_compare
  if mt_saving == 0 and bs.saving contains '{'
    assign t_save = ''
  endif
  assign t_unit = bs.per_pair | replace: '{unit}', f_unit | replace: '{total}', f_total | replace: '{price}', f_price
  assign t_gift = bs.gift_line | replace: '{price}', f_price

  comment
    Chips like "2x Black, 1x Midnight Blue" also prefill the per-pair colours (pair 1-2 Black, pair 3 Midnight Blue).
  endcomment
  assign chip_cols = ''
  for c in chip_list
    assign cparts = c | strip | split: 'x '
    assign cn_count = cparts[0] | strip | plus: 0
    assign cn_name = cparts | slice: 1, 9 | join: 'x ' | strip
    if cn_count > 0 and cn_name != blank and col_values contains cn_name
      for n in (1..cn_count)
        assign chip_cols = chip_cols | append: cn_name | append: '|'
      endfor
    endif
  endfor
-%}
<div
  class="mojo-tier mojo-tier--{{ bs.badge_style | default: 'black' }}"
  data-qty="{{ qty }}"
  data-off="{{ mt_off }}"
  data-anchor="{{ bs.anchor | default: 'price' }}"
  data-title="{{ bs.title | escape }}"
  data-save-tpl="{{ bs.saving | escape }}"
  data-unit-tpl="{{ bs.per_pair | escape }}"
  {% if chip_cols != blank %}data-colours="{{ chip_cols | escape }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <label class="mojo-tier__head">
    <input class="mojo-tier__input" type="radio" name="mojo-tier-{{ section.id }}" value="{{ qty }}" data-mojo-tier{% if bs.preselect %} checked data-preselect{% endif %}>
    <span class="mojo-tier__radio" aria-hidden="true"></span>
    <span class="mojo-tier__main">
      <span class="mojo-tier__title">{{ bs.title }}</span>
      <span class="mojo-tier__save{% if bs.saving_style == 'pill' %} mojo-tier__save--pill{% endif %}" data-save{% if t_save == blank %} hidden{% endif %}>{{ t_save }}</span>
      {%- if t_gift != blank -%}<span class="mojo-tier__gift"><i aria-hidden="true"></i>{{ t_gift }}</span>{%- endif -%}
      {%- if bs.chips != blank -%}
        <span class="mojo-tier__chips">
          {%- for c in chip_list -%}
            {%- assign cn = c | strip -%}
            {%- if cn != blank -%}
              {%- liquid
                assign cl = cn | downcase
                assign dot = '#9a9a9a'
                if cl contains 'black'
                  assign dot = '#111111'
                elsif cl contains 'midnight' or cl contains 'blue'
                  assign dot = '#1f2d52'
                elsif cl contains 'beige'
                  assign dot = '#d6c2a0'
                elsif cl contains 'white'
                  assign dot = '#ffffff'
                endif
              -%}
              <span class="mojo-tier__chip"><i style="background:{{ dot }}" aria-hidden="true"></i>{{ cn }}</span>
            {%- endif -%}
          {%- endfor -%}
        </span>
      {%- endif -%}
    </span>
    <span class="mojo-tier__prices">
      <span class="mojo-tier__price"><span data-total>{{ f_total }}</span>{% if bs.price_suffix != blank %}<small class="mojo-tier__suffix"> {{ bs.price_suffix }}</small>{% endif %}</span>
      <s class="mojo-tier__was" data-compare{% if mt_compare == 0 %} hidden{% endif %}>{{ f_compare }}</s>
      {%- if t_unit != blank -%}<span class="mojo-tier__pp" data-unit>{{ t_unit }}</span>{%- endif -%}
    </span>
    {%- if bs.badge != blank -%}<span class="mojo-tier__badge">{{ bs.badge }}</span>{%- endif -%}
  </label>
  {%- if bs.free_lines != blank -%}
    <ul class="mojo-tier__lines" role="list">
      {%- for l in line_list -%}
        {%- assign parts = l | replace: '{price}', f_price | split: '|' -%}
        {%- assign lbl = parts[0] | strip -%}
        {%- if lbl != blank -%}
          <li class="mojo-tier__line"><span>{{ lbl }}</span>{% if parts[1] != blank %} <s>{{ parts[1] | strip }}</s>{% endif %}{% if parts[2] != blank %} <em class="mojo-tier__free">{{ parts[2] | strip }}</em>{% endif %}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if pickers -%}
    <div class="mojo-tier__units">
      {%- if bs.picker_label != blank -%}<p class="mojo-tier__plabel">{{ bs.picker_label }}</p>{%- endif -%}
      {%- for i in (1..qty) -%}
        <div class="mojo-tier__unit" data-unit-row>
          <span class="mojo-tier__thumb">
            {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', sizes: '24px', alt: '', width: 24, height: 24 }}{%- endif -%}
          </span>
          <select class="mojo-tier__sel" data-opt="colour" aria-label="Colour, pair {{ i }}">
            {%- for cv in col_values -%}<option value="{{ cv | escape }}">{{ cv }}</option>{%- endfor -%}
          </select>
          <select class="mojo-tier__sel mojo-tier__sel--size" data-opt="size" aria-label="Size, pair {{ i }}">
            {%- for sv in size_values -%}<option value="{{ sv | escape }}">{{ sv }}</option>{%- endfor -%}
          </select>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if request.design_mode and mt_off > 0 -%}
    <p class="mojo-tier__admin">Editor only: create an automatic discount in Shopify (Discounts) of <b>{{ f_off }} off</b> for <b>{{ qty }}+ pairs</b> of this product, or checkout charges {{ mt_full | money }}.</p>
  {%- endif -%}
</div>

{% stylesheet %}
.mojo-tier { position: relative; background: rgb(233 215 207 / 55%); border: 1px solid transparent; border-radius: 6px; font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-tier [hidden] { display: none !important; }
.mojo-tier:has(.mojo-tier__input:checked) { background: var(--mojo-bg); border: 2px solid var(--mojo-primary); margin: -1px; }
.mojo-tier:has(.mojo-tier__input:focus-visible) { outline: 2px solid var(--mojo-primary); outline-offset: 2px; }
.mojo-tier__head { display: flex; align-items: center; gap: 12px; padding: 14px; cursor: pointer; }
.mojo-tier__input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
.mojo-tier__radio { width: 16px; height: 16px; flex: none; border: 1px solid var(--mojo-primary); border-radius: 50%; background: var(--mojo-bg); box-sizing: border-box; }
.mojo-tier__input:checked ~ .mojo-tier__radio { border: 4px solid var(--mojo-bg); background: var(--mojo-primary); box-shadow: 0 0 0 1px var(--mojo-primary); }
.mojo-tier__main { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 5px; }
.mojo-tier__title { font-weight: 600; font-size: 13px; line-height: 1.3; }
.mojo-tier__save { font-size: 11px; color: var(--mojo-muted); }
.mojo-tier__save--pill { background: var(--mojo-panel); color: var(--mojo-primary); font-weight: 600; padding: 3px 7px; border-radius: 3px; line-height: 1.2; }
.mojo-tier__gift { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; }
.mojo-tier__gift i { width: 8px; height: 8px; border-radius: 50%; background: #22a559; flex: none; }
.mojo-tier__chips { display: flex; flex-wrap: wrap; gap: 4px; }
.mojo-tier__chip { display: inline-flex; align-items: center; gap: 5px; background: var(--mojo-panel); border-radius: 10px; padding: 2px 8px; font-size: 10px; line-height: 1.5; color: var(--mojo-fg); }
.mojo-tier__chip i { width: 8px; height: 8px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 25%); flex: none; box-sizing: border-box; }
.mojo-tier__prices { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex: none; }
.mojo-tier__price { font-weight: 600; font-size: 14px; }
.mojo-tier__suffix { font-size: 10px; font-weight: 400; color: var(--mojo-muted); }
.mojo-tier__was { font-size: 11px; color: var(--mojo-muted); }
.mojo-tier__pp { font-size: 10px; color: var(--mojo-muted); }
.mojo-tier__badge { position: absolute; top: -9px; right: 12px; background: var(--mojo-primary); color: var(--mojo-bg); font-weight: 600; font-size: 9px; line-height: 1; letter-spacing: 0.4px; text-transform: uppercase; padding: 5px 8px; border-radius: 3px; }
.mojo-tier--grey .mojo-tier__badge { background: var(--mojo-muted); }
.mojo-tier__lines { list-style: none; margin: -4px 0 0; padding: 0 14px 14px 42px; display: grid; gap: 3px; font-size: 11px; color: var(--mojo-muted); }
.mojo-tier__line { display: flex; align-items: center; gap: 8px; }
.mojo-tier__line s { color: var(--mojo-soft); }
.mojo-tier__free { font-style: normal; font-weight: 700; font-size: 9px; letter-spacing: 0.4px; background: #22a559; color: #fff; padding: 2px 6px; border-radius: 3px; line-height: 1.2; }
.mojo-tier__units { display: none; padding: 0 14px 14px 42px; gap: 8px; }
.mojo-tier:has(.mojo-tier__input:checked) .mojo-tier__units { display: grid; }
.mojo-tier__plabel { margin: 0; font-size: 11px; font-weight: 600; }
.mojo-tier__unit { display: grid; grid-template-columns: 24px minmax(0, 1fr) 72px; gap: 8px; align-items: center; }
.mojo-tier__thumb { width: 24px; height: 24px; display: block; }
.mojo-tier__thumb img { width: 24px; height: 24px; object-fit: cover; display: block; }
.mojo-tier__sel { width: 100%; min-height: 36px; border: 1px solid var(--mojo-line); border-radius: 3px; background: var(--mojo-bg); color: var(--mojo-fg); font: inherit; font-size: 12px; padding: 0 6px; }
.mojo-tier__admin { margin: 0; padding: 0 14px 12px 42px; font-size: 10px; line-height: 1.4; color: #8a5a00; }
@media screen and (min-width: 750px) {
  .mojo-tier__unit { grid-template-columns: 24px 120px 56px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo bundle tier",
  "settings": [
    {
      "type": "range",
      "id": "quantity",
      "label": "Pairs in this tier",
      "default": 5,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "number",
      "id": "pack_price",
      "label": "Bundle price (store currency, e.g. 49.95)",
      "info": "Empty = full price (variant price x pairs). Create the matching automatic discount in Shopify (fixed amount off = full price - bundle price, minimum quantity = pairs). The editor shows the amount under the card."
    },
    {
      "type": "select",
      "id": "anchor",
      "label": "Crossed-out price per pair",
      "default": "price",
      "options": [
        {
          "value": "price",
          "label": "Variant price (Revolt style)"
        },
        {
          "value": "compare_at",
          "label": "Variant compare-at price"
        }
      ],
      "info": "Falls back to the compare-at price when the card has no discount (single pair)."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "(5 Pack) Buy 2 get 3 Free"
    },
    {
      "type": "text",
      "id": "saving",
      "label": "Saving line",
      "default": "You save {saving}",
      "info": "{saving} = crossed-out total - bundle price, {percent} = saving in %, {unit} = price per pair. Hidden when there is no saving."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge (empty = none)",
      "default": "MOST POPULAR"
    },
    {
      "type": "checkbox",
      "id": "preselect",
      "label": "Preselected",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pickers",
      "label": "Show colour + size picker for each pair",
      "default": true
    },
    {
      "type": "text",
      "id": "picker_label",
      "label": "Picker label",
      "default": "Colour, Size"
    },
    {
      "type": "header",
      "content": "Optional extras"
    },
    {
      "type": "select",
      "id": "saving_style",
      "label": "Saving line style",
      "default": "text",
      "options": [
        {
          "value": "text",
          "label": "Plain text"
        },
        {
          "value": "pill",
          "label": "Pill"
        }
      ]
    },
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Text after the price (e.g. /pair)"
    },
    {
      "type": "text",
      "id": "per_pair",
      "label": "Per-pair line under the price",
      "info": "{unit} = bundle price / pairs, e.g. \"{unit} /pair\"."
    },
    {
      "type": "text",
      "id": "gift_line",
      "label": "Gift line (green dot)",
      "info": "Display only: it adds nothing to the cart. Use it only with a real gift (product + automatic discount)."
    },
    {
      "type": "text",
      "id": "chips",
      "label": "Colour chips (comma separated, e.g. 2x Black, 1x Midnight Blue)"
    },
    {
      "type": "textarea",
      "id": "free_lines",
      "label": "Pair lines",
      "info": "One per line: label | struck price | tag, e.g. Pair 2 | {price} | FREE. {price} = variant price."
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge colour",
      "default": "black",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "grey",
          "label": "Dark grey"
        }
      ]
    }
  ]
}
{% endschema %}
