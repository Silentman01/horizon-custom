{%- assign s = block.settings -%}
<article class="mojo-rv__card" {{ block.shopify_attributes }}>
  <span class="mojo-rv__stars" aria-hidden="true">{%- for i in (1..5) -%}<span class="mojo-rv__star">{% render 'mojo-icon', name: 'star', size: 11 %}</span>{%- endfor -%}</span>
  <h3 class="mojo-rv__title">{{ s.title }}</h3>
  <p class="mojo-rv__body">{{ s.body }}</p>
  <p class="mojo-rv__meta"><strong>{{ s.name }}</strong>{% if s.badge != blank %} <span>{{ s.badge }}</span>{% endif %}</p>
</article>

{% stylesheet %}
.mojo-rv__card { flex: 0 0 78%; box-sizing: border-box; scroll-snap-align: start; border: 1px solid #e6e6e6; padding: 14px; background: #fff; font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-rv__stars { display: inline-flex; gap: 2px; margin-bottom: 8px; }
.mojo-rv__star { display: inline-flex; width: 16px; height: 16px; align-items: center; justify-content: center; background: #000; color: #fff; }
.mojo-rv__title { margin: 0 0 6px; font-size: 13px; font-weight: 700; line-height: 1.3; }
.mojo-rv__body { margin: 0 0 10px; font-size: 12px; line-height: 1.5; color: var(--mojo-muted); }
.mojo-rv__meta { margin: 0; font-size: 11px; display: flex; gap: 8px; color: var(--mojo-soft); }
.mojo-rv__meta strong { color: var(--mojo-fg); }
@media screen and (min-width: 750px) { .mojo-rv__card { flex-basis: 44%; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo review card",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The most comfortable…"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Review",
      "default": "Review text"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Liam H."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Verified Buyer"
    }
  ]
}
{% endschema %}
