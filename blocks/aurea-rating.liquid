<div class="au-rating" style="{% render 'aurea-vars' %}" {{ block.shopify_attributes }}>
  <span class="au-rating__stars" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M12 .587l3.668 7.431 8.144 1.18-5.906 5.434 1.391 8.079L12 18.896l-7.297 3.843 1.391-8.079-5.906-5.434 8.144-1.18z"/></svg>
    {%- endfor -%}
  </span>
  <span class="au-rating__text">{{ block.settings.text }}</span>
</div>
{% stylesheet %}
  .au-rating { display: flex; align-items: center; gap: 8px; width: 100%; font-family: var(--au-body); font-size: 14px; color: var(--au-ink); }
  .au-rating__stars { display: inline-flex; gap: 2px; color: var(--au-gold); }
{% endstylesheet %}
{% schema %}
{ "name": "Aurea rating", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "4.8/5 (193,819+ Customers)" } ], "presets": [ { "name": "Aurea rating" } ] }
{% endschema %}
