<div class="oralys-pdp-rate" style="--opr-star:{{ block.settings.c_star }};--opr-text:{{ block.settings.c_text }};--opr-size:{{ block.settings.size }}px" {{ block.shopify_attributes }}>
  <span class="oralys-pdp-rate__stars" role="img" aria-label="{{ block.settings.stars }}/5">{% for i in (1..5) %}<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="oralys-pdp-rate__star{% if i > block.settings.stars %} is-off{% endif %}"><path d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z"/></svg>{% endfor %}</span>
  <span class="oralys-pdp-rate__text">{{ block.settings.text }}</span>
</div>

{% stylesheet %}
.oralys-pdp-rate{display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px;color:var(--opr-text);font-size:var(--opr-size);font-weight:600;line-height:1.3}
.oralys-pdp-rate__stars{display:inline-flex;gap:1px}
.oralys-pdp-rate__star{fill:var(--opr-star)}
.oralys-pdp-rate__star.is-off{fill:#DCE5E0}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : note",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "4,8/5 · Plus de 30 000 porteurs de dentier l'ont adopté"
    },
    {
      "type": "range",
      "id": "stars",
      "label": "Étoiles pleines",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "c_star",
      "label": "Étoiles",
      "default": "#F0A830"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Taille du texte",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Oralys : note"
    }
  ]
}
{% endschema %}
