{%- assign bs = block.settings -%}
<div class="oralys-pdp-stock" style="--ops-fill:{{ bs.c_fill }};--ops-track:{{ bs.c_track }};--ops-text:{{ bs.c_text }};--ops-muted:{{ bs.c_muted }}" {{ block.shopify_attributes }}>
  <p class="oralys-pdp-stock__label"><span class="oralys-pdp-stock__dot" aria-hidden="true"></span>{{ bs.label }}</p>
  <div class="oralys-pdp-stock__track" aria-hidden="true"><span class="oralys-pdp-stock__fill" style="width:{{ bs.percent }}%"></span></div>
  {%- if bs.sub != blank %}<p class="oralys-pdp-stock__sub">{{ bs.sub }}</p>{% endif -%}
</div>

{% stylesheet %}
.oralys-pdp-stock{display:grid;gap:6px;color:var(--ops-text)}
.oralys-pdp-stock__label{display:flex;align-items:center;gap:8px;margin:0;font-size:14.5px;font-weight:700}
.oralys-pdp-stock__dot{width:9px;height:9px;border-radius:50%;background:var(--ops-fill);box-shadow:0 0 0 4px rgb(from var(--ops-fill) r g b / .18);animation:oralys-pdp-pulse 1.6s infinite}
@keyframes oralys-pdp-pulse{50%{box-shadow:0 0 0 7px rgb(from var(--ops-fill) r g b / 0)}}
@media (prefers-reduced-motion:reduce){.oralys-pdp-stock__dot{animation:none}}
.oralys-pdp-stock__track{height:8px;border-radius:8px;background:var(--ops-track);overflow:hidden}
.oralys-pdp-stock__fill{display:block;height:100%;border-radius:8px;background:var(--ops-fill)}
.oralys-pdp-stock__sub{margin:0;font-size:13.5px;color:var(--ops-muted)}
{% endstylesheet %}

{% schema %}
{
  "name": "Oralys : barre de stock",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Texte",
      "default": "Stock de lancement : 93 % déjà réservé"
    },
    {
      "type": "range",
      "id": "percent",
      "label": "Remplissage de la barre",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 93
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Sous-texte",
      "default": "Commandez aujourd'hui, votre colis part demain."
    },
    {
      "type": "color",
      "id": "c_fill",
      "label": "Barre",
      "default": "#D2382C"
    },
    {
      "type": "color",
      "id": "c_track",
      "label": "Fond de la barre",
      "default": "#F3DEDB"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Texte",
      "default": "#17221E"
    },
    {
      "type": "color",
      "id": "c_muted",
      "label": "Sous-texte",
      "default": "#5C6863"
    }
  ],
  "presets": [
    {
      "name": "Oralys : barre de stock"
    }
  ]
}
{% endschema %}
