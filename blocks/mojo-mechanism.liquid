{%- assign s = block.settings -%}
<div class="mojo-mc" style="{% render 'mojo-vars' %}--mojo-mc-bg:{{ s.card_bg }};--mojo-mc-line:{{ s.border_color }};--mojo-mc-rd:{{ s.ratio_desktop }};--mojo-mc-rm:{{ s.ratio_mobile }};--mojo-mc-gap:{{ s.gap }}px;--mojo-mc-pad:{{ s.padding }}px;" {{ block.shopify_attributes }}>
  <div class="mojo-mc__head">
    {%- if s.eyebrow != blank -%}<p class="mojo-mc__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="mojo-mc__heading">{{ s.heading }}</h2>{%- endif -%}
  </div>
  <div class="mojo-mc__list">{% content_for 'blocks' %}</div>
</div>

{% stylesheet %}
.mojo-mc { box-sizing: border-box; background: var(--mojo-mc-bg); border: 1px solid var(--mojo-mc-line); padding: var(--mojo-mc-pad); font-family: var(--mojo-font); color: var(--mojo-fg); }
.mojo-mc__head { text-align: center; margin-bottom: 20px; }
.mojo-mc__eyebrow { margin: 0 0 8px; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mojo-muted); }
.mojo-mc__heading { margin: 0; font-family: var(--mojo-font-heading); font-size: 24px; font-weight: 600; line-height: 1.25; }
.mojo-mc__list { counter-reset: mojo-mc; display: grid; gap: var(--mojo-mc-gap); }
{% endstylesheet %}

{% schema %}
{
  "name": "Mojo mechanism cards",
  "blocks": [
    {
      "type": "_mojo-mech-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "35°C SILK COOLING SYSTEM™"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Mojo Feels Unlike Any Other Boxer"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E3DCCD"
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Image ratio (desktop)",
      "default": "16 / 9",
      "options": [
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "3 / 2",
          "label": "3:2"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Image ratio (mobile)",
      "default": "1.22 / 1",
      "options": [
        {
          "value": "1.22 / 1",
          "label": "1.22:1"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "default": 30,
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Card padding",
      "default": 22,
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Mojo mechanism cards",
      "blocks": [
        {
          "type": "_mojo-mech-card"
        },
        {
          "type": "_mojo-mech-card"
        },
        {
          "type": "_mojo-mech-card"
        },
        {
          "type": "_mojo-mech-card"
        }
      ]
    }
  ]
}
{% endschema %}
