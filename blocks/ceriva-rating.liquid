<div
  class="cv cv-rating"
  style="{% render 'ceriva-tokens' %} --cv-bg: transparent; --cv-fg: currentColor;"
  {{ block.shopify_attributes }}
>
  {%- capture inner -%}
    {% render 'ceriva-stars', size: '16' %}
    <span class="cv-rating__text">
      <strong>{{ block.settings.score }}</strong>
      {%- if block.settings.count != blank %} · {{ block.settings.count }}{% endif -%}
    </span>
  {%- endcapture -%}

  {%- if block.settings.link != blank -%}
    <a
      class="cv-rating__link"
      href="{{ block.settings.link }}"
    >
      {{- inner -}}
    </a>
  {%- else -%}
    {{ inner }}
  {%- endif -%}
</div>

{% stylesheet %}
  .cv-rating,
  .cv-rating__link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: inherit;
    text-decoration: none;
  }

  .cv-rating__link:hover .cv-rating__text {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ceriva — Note clients",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "N'affichez que des chiffres issus de vrais avis vérifiés (obligation légale en France)."
    },
    {
      "type": "text",
      "id": "score",
      "label": "Note",
      "default": "4,8/5"
    },
    {
      "type": "text",
      "id": "count",
      "label": "Nombre d'avis",
      "default": "1 200+ avis clients"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien",
      "info": "Ex. #avis pour descendre à la section avis."
    }
  ],
  "presets": [
    {
      "name": "Ceriva — Note clients",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
