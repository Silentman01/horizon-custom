{%- comment -%} Black CTA button that scrolls to the buy box + assurance row. Params: label, target, bg, fg, show, a1, a2, as_color, align {%- endcomment -%}
{%- if label != blank -%}
  <div class="mojo-ct mojo-ct--{{ align | default: 'center' }}" style="--mojo-ct-bg:{{ bg | default: '#0F1B2D' }};--mojo-ct-fg:{{ fg | default: '#F7F3EC' }};">
    <a class="mojo-ct__btn" href="{{ target | default: '#mojo-buybox' }}">{{ label }}</a>
    {%- if show -%}{% render 'mojo-assure', a1: a1, a2: a2, align: align, color: as_color %}{%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
.mojo-ct { font-family: var(--mojo-font); }
.mojo-ct--center { text-align: center; }
.mojo-ct__btn { display: block; box-sizing: border-box; width: 100%; max-width: 440px; margin-inline: auto; padding: 16px 22px; background: var(--mojo-ct-bg); color: var(--mojo-ct-fg); border: 1px solid var(--mojo-ct-fg); border-radius: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.04em; line-height: 1.3; text-transform: uppercase; text-decoration: none; text-align: center; }
.mojo-ct--left .mojo-ct__btn { margin-inline: 0; }
@media screen and (min-width: 750px) { .mojo-ct__btn { display: inline-block; width: auto; min-width: 340px; } }
{% endstylesheet %}
