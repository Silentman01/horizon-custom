{%- comment -%}
  Old Tom's scroll-to-offer CTA (CTA-BLOCK in the spec): lime pill "ADD TO CART" + shield guarantee line.
  Clicking scrolls (smooth) to the buy box on the product page: the bundle tiers (.ot-tiers), else the buy buttons,
  else the product information section. On other templates it behaves like a plain link to the `href` param.

  Usage:
    {% render 'oldtoms-cta', label: section.settings.cta_label, guarantee: section.settings.cta_guarantee %}

  Params:
    label      (string)  Button text. Required; nothing renders when blank. Typical: "Add to Cart"
    guarantee  (string)  Line under the button with a shield icon. Optional. Typical: "30-Day Money Back Guarantee"
    href       (string)  Fallback link when the buy box is not on the page. Optional, default "#"
    align      (string)  "center" (default) or "left"
{%- endcomment -%}
{%- if label != blank -%}
  <div class="ot-cta ot-cta--{{ align | default: 'center' }}" style="{% render 'oldtoms-vars' %}">
    <a class="ot-cta__btn" href="{{ href | default: '#' }}" data-ot-cta>
      <span>{{ label }}</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 11V8a3.5 3.5 0 017 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </a>
    {%- if guarantee != blank -%}
      <p class="ot-cta__guarantee">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 2.8l7.5 2.8v5.6c0 4.7-3.1 8.5-7.5 10-4.4-1.5-7.5-5.3-7.5-10V5.6L12 2.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.6 12.2l2.5 2.5 4.4-4.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{{ guarantee }}</span>
      </p>
    {%- endif -%}
  </div>
{%- endif -%}
{% stylesheet %}
.ot-cta { width: 100%; text-align: center; }
.ot-cta--left { text-align: left; }
.ot-cta__btn { display: flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box; width: 100%; max-width: 672px; min-height: 50px; margin-inline: auto; padding: 14px 24px; border: 1px solid var(--ot-green, #24433d); border-radius: 999px; background: var(--ot-lime, #ccf46f); color: var(--ot-green, #24433d); font-size: 15px; font-weight: 700; letter-spacing: 0.5px; line-height: 1.2; text-transform: uppercase; text-decoration: none; cursor: pointer; }
.ot-cta--left .ot-cta__btn { margin-inline: 0; }
.ot-cta__btn:hover { filter: brightness(0.97); }
.ot-cta__btn:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
.ot-cta__guarantee { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px 0 0; font-size: 11px; line-height: 1.3; color: #121212; }
.ot-cta--left .ot-cta__guarantee { justify-content: flex-start; }
.ot-cta__guarantee svg { flex: none; color: var(--ot-green, #24433d); }
.ot-cta-flash { animation: ot-cta-flash 1.1s ease-out 1; }
@keyframes ot-cta-flash { 0% { box-shadow: 0 0 0 0 rgba(204, 244, 111, 0.95); } 100% { box-shadow: 0 0 0 18px rgba(204, 244, 111, 0); } }
@media screen and (min-width: 750px) { .ot-cta__btn { min-height: 64px; font-size: 17px; } .ot-cta__guarantee { font-size: 13px; } }
@media (prefers-reduced-motion: reduce) { .ot-cta-flash { animation: none; } }
{% endstylesheet %}
{% javascript %}
(() => {
  if (window.__otCta) return;
  window.__otCta = true;
  document.addEventListener('click', (e) => {
    const a = e.target instanceof Element && e.target.closest('[data-ot-cta]');
    if (!a) return;
    const target = document.querySelector('.ot-tiers') || document.querySelector('.buy-buttons-block') || document.querySelector('[id^="ProductInformation-"]');
    if (!target) return; // not a product page: follow href
    e.preventDefault();
    const header = document.querySelector('header');
    target.style.scrollMarginTop = `${(header ? header.getBoundingClientRect().height : 0) + 16}px`;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    target.classList.remove('ot-cta-flash');
    void target.offsetWidth;
    target.classList.add('ot-cta-flash');
  });
})();
{% endjavascript %}
