{%- doc -%}
  Small stroke icons for the cart drawer extras (prefix cart-extras).

  @param {string} name - clock, truck, shield, return, lock, star, heart, check, gift
{%- enddoc -%}
<svg class="cart-extras-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case name -%}
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'truck' -%}<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>
    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'return' -%}<path d="M4 9h11a5 5 0 010 10H8"/><path d="M8 5L4 9l4 4"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>
    {%- when 'star' -%}<path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>
    {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13M12 8S10.5 3 8 4.5 9 8 12 8zm0 0s1.5-5 4-3.5S15 8 12 8z"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
  {%- endcase -%}
</svg>
