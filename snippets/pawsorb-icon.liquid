    {%- when 'leaf' -%}<path d="M12 21V11"/><path d="M12 11C9 6 5 5 3 6c1 4 4.5 6 9 5zM12 11c3-5 7-6 9-5-1 4-4.5 6-9 5zM12 11c-1.5-4-.5-7 0-8.5.5 1.5 1.5 4.5 0 8.5z"/><circle cx="10" cy="18.5" r="1"/><circle cx="14" cy="18.5" r="1"/>
    {%- when 'bait' -%}<path d="M4 9l8-4 8 4v7l-8 4-8-4z"/><path d="M4 9l8 4 8-4M12 13v7"/>
    {%- when 'mushroom' -%}<path d="M3.5 12a8.5 7 0 0117 0z"/><path d="M9.5 12v6.5a2.5 2.5 0 005 0V12"/><circle cx="9" cy="8.5" r=".8"/><circle cx="14.5" cy="7.5" r=".8"/>
    {%- when 'cloth' -%}<path d="M5 4.5h14v15H5z"/><path d="M5 9h14M9 4.5v15" stroke-dasharray="2 2"/>
    {%- when 'dial' -%}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/><path d="M12 3.5v2.5M20.5 12H18M12 20.5V18M3.5 12H6M12 12l2.2-2.2"/>
    {%- when 'tube' -%}<rect x="3" y="9.5" width="12" height="5" rx="1.2"/><path d="M15 11h3.2l2.3 1-2.3 1H15M3 10.5H1.8v3H3"/><path d="M6 9.5v5M9 9.5v5"/>
    {%- when 'drop' -%}<path d="M12 3.5c3.5 4.5 6 7.7 6 10.5a6 6 0 01-12 0c0-2.8 2.5-6 6-10.5z"/>
    {%- when 'paw' -%}<circle cx="7" cy="9" r="1.9"/><circle cx="11" cy="6.5" r="1.9"/><circle cx="15.2" cy="7.2" r="1.9"/><circle cx="18" cy="10.8" r="1.7"/><path d="M8 17c0-3 2-5.5 4.5-5.5s4.5 2.5 4.5 4.8c0 1.8-1.4 2.7-3 2.4-1.2-.2-2-.4-3 0-1.8.5-3-.2-3-1.7z"/>
    {%- when 'gift' -%}<rect x="3.5" y="9" width="17" height="11.5" rx="1"/><path d="M2.5 6h19v3h-19zM12 6v14.5M12 6C10 3 7 3 7 4.8S10 6 12 6zm0 0c2-3 5-3 5-1.2S14 6 12 6z"/>
    {%- when 'cart' -%}<path d="M3 4h2.5l2.2 10.5h10.6L20.5 7H6.4"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/>
    {%- when 'minus' -%}<path d="M6 12h12"/>
    {%- when 'plus' -%}<path d="M6 12h12M12 6v12"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'chevron' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'home' -%}<path d="M3.5 11L12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>
    {%- else -%}<circle cx="12" cy="12" r="8.5"/><path d="M8 12.3l2.8 2.7L16.2 9.5"/>
  {%- endcase -%}
</svg>
