{%- doc -%}
  PawSorb line icons (24 x 24, currentColor stroke). Used by pawsorb-* sections and as image fallbacks.
  @param {string} name - icon name
  @param {number} [size] - px size, default 24
{%- enddoc -%}
{%- liquid
  assign s = size | default: 24
-%}
<svg class="pawsorb-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'check' -%}<path d="M4.5 12.5l4.5 4.5L19.5 7"/>
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9.5"/><path d="M7.5 12.3l3 3 6-6.3"/>
    {%- when 'cross' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'star' -%}<path fill="currentColor" stroke="none" d="M12 2.8l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.6l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
    {%- when 'phone' -%}<path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 005.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 01-2.7 2.5C9.4 18.9 5.1 14.6 4.5 7.2A2.5 2.5 0 015 3.5z"/>
    {%- when 'car' -%}<path d="M3.5 15.5v-3l2-5h13l2 5v3"/><path d="M2.5 15.5h19v2.5h-19z"/><circle cx="7" cy="18.5" r="1.6"/><circle cx="17" cy="18.5" r="1.6"/><path d="M5.5 12.5h13"/>
    {%- when 'shield' -%}<path d="M12 2.8l7.5 3v5.7c0 4.6-3.2 8.3-7.5 9.7-4.3-1.4-7.5-5.1-7.5-9.7V5.8z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
    {%- when 'vet' -%}<path d="M6 3v5a4 4 0 008 0V3"/><path d="M10 12v3a4.5 4.5 0 009 0v-2"/><circle cx="19" cy="11" r="2"/>
    {%- when 'flask' -%}<path d="M9 3h6M10 3v6l-5 9a2 2 0 001.8 3h10.4A2 2 0 0019 18l-5-9V3"/><path d="M7.5 15h9"/>
    {%- when 'flag' -%}<path d="M5 21V4M5 4h12l-2 4 2 4H5"/>
    {%- when 'toad' -%}<path d="M4 15.5c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5c0 2-1.5 3-3 3H7c-1.5 0-3-1-3-3z"/><circle cx="8.5" cy="8.5" r="2"/><circle cx="15.5" cy="8.5" r="2"/><path d="M9 14.5c1.8 1 4.2 1 6 0"/><path d="M3 19.5l2.5-1.5M21 19.5L18.5 18"/>
    {%- when 'chocolate' -%}<rect x="5" y="3.5" width="14" height="17" rx="1.5"/><path d="M5 9.2h14M5 14.8h14M12 3.5v17"/>
    {%- when 'grapes' -%}<circle cx="9" cy="10" r="2.3"/><circle cx="14" cy="10" r="2.3"/><circle cx="11.5" cy="14" r="2.3"/><circle cx="7" cy="14.5" r="2"/><circle cx="16" cy="14.5" r="2"/><circle cx="11.5" cy="18.4" r="2"/><path d="M11.5 7.6V3.5M11.5 5c1.5-1.5 3.5-1.5 5 0"/>
