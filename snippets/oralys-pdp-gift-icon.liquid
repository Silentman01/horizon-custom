{%- doc -%}
  Oralys PDP gift-strip icons (inline SVG, currentColor).
  @param {string} name - truck | tablets | case | gift | lock | check
  @param {number} [size] - Pixel size (default 36)
{%- enddoc -%}
{%- assign sz = size | default: 36 -%}
{%- case name -%}
  {%- when 'truck' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h24v20H4z" fill="currentColor" fill-opacity=".12"/><path d="M28 18h8.5l6.5 7v7H28z" fill="currentColor" fill-opacity=".12"/><path d="M28 25h15"/><circle cx="13" cy="34.5" r="4" fill="#fff"/><circle cx="35" cy="34.5" r="4" fill="#fff"/><path d="M9 18h10M9 23h7"/></svg>
  {%- when 'tablets' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 14l14-6 14 6v20l-14 6-14-6z" fill="currentColor" fill-opacity=".12"/><path d="M6 14l14 6 14-6M20 20v20"/><circle cx="36" cy="33" r="7" fill="#fff"/><path d="M31.5 37.5l9-9"/><circle cx="39.5" cy="18.5" r="4.5" fill="#fff"/></svg>
  {%- when 'case' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 25h36v4c0 6-6 11-18 11S6 35 6 29z" fill="currentColor" fill-opacity=".12"/><path d="M6 21c0-7 8-12 18-12s18 5 18 12v1H6z" fill="currentColor" fill-opacity=".22"/><path d="M6 23.5h36"/><path d="M14 30c1.5 2 2.5 2 4 0 1.5 2 2.5 2 4 0 1.5 2 2.5 2 4 0 1.5 2 2.5 2 4 0 1.5 2 2.5 2 4 0"/></svg>
  {%- when 'gift' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="7" y="17" width="34" height="8" rx="2" fill="currentColor" fill-opacity=".22"/><path d="M10 25v16h28V25" fill="currentColor" fill-opacity=".12"/><path d="M24 17v24"/><path d="M24 17c-3-7-10-8-10-4s6 4 10 4zm0 0c3-7 10-8 10-4s-6 4-10 4z"/></svg>
  {%- when 'lock' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="currentColor"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/></svg>
  {%- when 'check' -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7"/></svg>
{%- endcase -%}
