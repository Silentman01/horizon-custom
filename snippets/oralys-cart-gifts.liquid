{%- doc -%}
  Oralys cart gifts (prefix oralys-cg). Counts tubes in the cart (variant title starting with a number, e.g.
  "2 tubes" = 2 per unit; otherwise 1 per unit) and shows the gift message and gift rows of the reached tier.
  Settings: oralys_gifts_* in the "Cart drawer" section (cx).
  @param {object} cx - Settings of the "Cart drawer" section.
{%- enddoc -%}
{%- if cx.oralys_gifts_enable and cart.item_count > 0 -%}
  {%- liquid
    assign tubes = 0
    for item in cart.items
      assign per = item.variant.title | split: ' ' | first | plus: 0
      if per < 1
        assign per = 1
      endif
      assign add = per | times: item.quantity
      assign tubes = tubes | plus: add
    endfor
    if tubes >= 4
      assign msg = cx.oralys_gifts_msg_3
      assign rows = cx.oralys_gifts_rows_3
    elsif tubes >= 2
      assign msg = cx.oralys_gifts_msg_2
      assign rows = cx.oralys_gifts_rows_2
    else
      assign msg = cx.oralys_gifts_msg_1
      assign rows = cx.oralys_gifts_rows_1
    endif
    assign lines = rows | newline_to_br | split: '<br />'
  -%}
  <div class="oralys-cg" style="--oralys-cg-accent: {{ cx.oralys_gifts_accent }}; --oralys-cg-bg: {{ cx.oralys_gifts_bg }};">
    {%- if msg != blank -%}
      <p class="oralys-cg__msg">{% render 'cart-extras-icon', name: 'gift' %}<span>{{ msg }}</span></p>
    {%- endif -%}
    {%- if rows != blank -%}
      <ul class="oralys-cg__rows" role="list">
        {%- for l in lines -%}
          {%- assign parts = l | split: '|' -%}
          {%- assign nm = parts[0] | strip -%}
          {%- assign tag = parts[1] | strip -%}
          {%- if nm != blank -%}
            <li class="oralys-cg__row"><span>{{ nm }}</span><b class="oralys-cg__tag">{{ tag }}</b></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if cx.oralys_gifts_guarantee != blank -%}
      <p class="oralys-cg__g">{% render 'cart-extras-icon', name: 'shield' %}<span>{{ cx.oralys_gifts_guarantee }}</span></p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .oralys-cg { display: grid; gap: 8px; padding: 12px 14px; border-radius: 12px; background: var(--oralys-cg-bg); }
  .oralys-cg__msg, .oralys-cg__g { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 14px; font-weight: 700; line-height: 1.3; }
  .oralys-cg__msg svg, .oralys-cg__g svg { width: 18px; height: 18px; flex: 0 0 auto; color: var(--oralys-cg-accent); }
  .oralys-cg__g { font-weight: 600; font-size: 13px; }
  .oralys-cg__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .oralys-cg__row { display: flex; justify-content: space-between; gap: 8px; font-size: 13.5px; padding: 6px 10px; border-radius: 8px; background: #fff; }
  .oralys-cg__tag { color: var(--oralys-cg-accent); font-weight: 800; white-space: nowrap; }
{% endstylesheet %}
