{%- comment -%} Ratio-locked image with native placeholder. Params: image, asset, ratio, placeholder, alt, sizes, eager {%- endcomment -%}
{%- liquid
  assign mojo_load = 'lazy'
  if eager
    assign mojo_load = 'eager'
  endif
  assign mojo_alt = alt | default: image.alt
-%}
<div class="mojo-media" style="aspect-ratio: {{ ratio | default: '1 / 1' }};">
  {%- if image != blank -%}
    {{ image | image_url: width: 1600 | image_tag: loading: mojo_load, sizes: sizes, widths: '360, 540, 720, 960, 1200, 1600', alt: mojo_alt }}
  {%- elsif asset != blank -%}
    <img src="{{ asset | asset_url }}" alt="{{ mojo_alt | escape }}" loading="{{ mojo_load }}" decoding="async" width="1200" height="1200">
  {%- else -%}
    {{ placeholder | default: 'image' | placeholder_svg_tag: 'mojo-media__ph' }}
  {%- endif -%}
</div>

{% stylesheet %}
.mojo-media { position: relative; overflow: hidden; background: var(--mojo-panel); width: 100%; }
.mojo-media > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.mojo-media__ph { position: absolute; inset: 0; width: 100%; height: 100%; display: block; fill: currentcolor; color: var(--mojo-line); background: var(--mojo-panel); }
{% endstylesheet %}
