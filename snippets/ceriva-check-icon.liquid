{% doc %}
  Renders the round Trust Blue check used in Ceriva lists.

  @example
  {% render 'ceriva-check-icon' %}
{% enddoc %}
<span
  class="cv-check"
  aria-hidden="true"
>
  <svg
    viewBox="0 0 12 12"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M2.5 6.2l2.3 2.3 4.7-5"/>
  </svg>
</span>
