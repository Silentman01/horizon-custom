{%- comment -%}
  Ratio-locked image. Params: image (image_picker), asset (theme asset filename, e.g. oldtoms-testimonial-01.jpg), ratio, alt, sizes, eager, fallback (CSS background colour when nothing is set).
  When neither image nor asset is set, renders a plain tinted frame (no label, no placeholder text).
{%- endcomment -%}
{%- liquid
  assign ot_load = 'lazy'
  if eager
    assign ot_load = 'eager'
  endif
  assign ot_alt = alt | default: image.alt
-%}
<div class="ot-media" style="aspect-ratio: {{ ratio | default: '1 / 1' }};">
  {%- if image != blank -%}
    {{ image | image_url: width: 1600 | image_tag: loading: ot_load, sizes: sizes, widths: '360, 540, 720, 960, 1200, 1600', alt: ot_alt }}
  {%- elsif asset != blank -%}
    <img src="{{ asset | asset_url }}" alt="{{ ot_alt | escape }}" loading="{{ ot_load }}" decoding="async" width="1200" height="1200" onerror="this.remove()">
  {%- endif -%}
</div>
{% stylesheet %}
.ot-media { position: relative; overflow: hidden; width: 100%; background: linear-gradient(135deg, #E5E9DD, #F4F4F0); }
.ot-media > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
{% endstylesheet %}
