{%- comment -%}
  Ratio-locked image frame. Uploaded image wins, then theme asset (file name in assets/), then a labeled placeholder.
  Params: image, asset, ratio (e.g. '1 / 1'), label, sizes, radius, eager, fit ('cover'|'contain')
{%- endcomment -%}
{%- liquid
  assign r = ratio | default: '1 / 1'
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
-%}
<div class="rf-media" style="aspect-ratio: {{ r }};{% if radius != blank %} --rf-media-radius: {{ radius }}px;{% endif %}{% if fit == 'contain' %} --rf-fit: contain;{% endif %}">
  {%- if image -%}
    {{ image | image_url: width: 1600 | image_tag: loading: loading, sizes: sizes, widths: '360, 540, 720, 900, 1200, 1600', alt: image.alt }}
  {%- elsif asset != blank -%}
    <img src="{{ asset | asset_url }}" alt="{{ label | escape }}" loading="{{ loading }}" decoding="async" width="1200" height="1200">
  {%- else -%}
    <div class="rf-media__ph" role="img" aria-label="{{ label | escape }}"><span>{{ label }}</span></div>
  {%- endif -%}
</div>
{% stylesheet %}
  .rf-media { position: relative; width: 100%; overflow: hidden; border-radius: var(--rf-media-radius, 0); background: #DCCFFF; }
  .rf-media > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: var(--rf-fit, cover); }
  .rf-media__ph { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; background: linear-gradient(135deg, #DCCFFF, #C9B8FA); color: #1E0F4A; font-size: 12px; line-height: 1.4; text-align: center; }
{% endstylesheet %}
