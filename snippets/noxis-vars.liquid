{%- comment -%} Inline CSS variables shared by Noxis sections and blocks, driven by the theme color palette. {%- endcomment -%}
--nx-amber: {{ settings.color_palette.color1 }}; --nx-navy: {{ settings.color_palette.color2 }}; --nx-line: {{ settings.color_palette.color3 }}; --nx-bg: {{ settings.color_palette.background }}; --nx-fg: {{ settings.color_palette.foreground }}; --nx-amber-soft: rgb(from {{ settings.color_palette.color1 }} r g b / 0.11); --nx-cream: #F3F1EC; --nx-muted: #555555; --nx-heading: var(--font-heading--family); --nx-body: var(--font-body--family);
