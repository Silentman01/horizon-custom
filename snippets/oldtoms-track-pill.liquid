{%- comment -%} Old Tom's "Track Order" lime pill in the header actions. Label and URL: Theme settings > Old Tom's header. Empty label hides it. {%- endcomment -%}
{%- if settings.ot_track_label != blank -%}
  <a class="ot-track" href="{{ settings.ot_track_url | default: '/apps/17TRACK' }}">{{ settings.ot_track_label }}</a>
{%- endif -%}
{% stylesheet %}
.ot-track { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 14px; border-radius: 14px; background: #ccf46f; color: #24433d; font-family: var(--font-body--family); font-size: 11px; font-weight: 600; line-height: 1; text-decoration: none; white-space: nowrap; }
.ot-track:hover { filter: brightness(0.97); }
.ot-track:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
{% endstylesheet %}
