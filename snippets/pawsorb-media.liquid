{%- doc -%}
  Ratio-locked image frame with a built-in on-brand fallback.
  Order: uploaded image (image_picker) > theme asset file (assets/<asset>) > vector fallback (icon tile or packshot).
  The asset <img> removes itself if the file is not in assets/ yet, so the frame never shows a broken image.
  @param {object} [image] - image_picker value
  @param {string} [asset] - theme asset file name, e.g. 'pawsorb-toxin-grapes.jpg'
  @param {string} [alt] - alt text
  @param {string} [ratio] - CSS aspect-ratio, default '1 / 1'
  @param {string} [icon] - pawsorb-icon name for the fallback tile ('pack' draws the tube)
  @param {string} [tone] - fallback tone: 'tint' | 'navy' | 'red' | 'warm'
  @param {string} [fit] - 'cover' | 'contain'
  @param {boolean} [eager] - above the fold
  @param {string} [sizes] - sizes attribute
  @param {object} [anim_image] - looping animated WebP upload (image_picker)
  @param {string} [anim_asset] - animated WebP theme file; hidden for prefers-reduced-motion and removed if missing
  @param {string} [anim_fit] - 'cover' | 'contain'
{%- enddoc -%}
{%- liquid
  assign r = ratio | default: '1 / 1'
  assign tn = tone | default: 'tint'
  assign ic = icon | default: 'paw'
  assign ft = fit | default: 'cover'
  assign ld = 'lazy'
  if eager
    assign ld = 'eager'
  endif
-%}
<div class="pawsorb-media pawsorb-media--{{ tn }} pawsorb-media--{{ ft }}" style="aspect-ratio: {{ r }};">
  <div class="pawsorb-media__fb" aria-hidden="true">
    {%- if ic == 'pack' -%}
      {% render 'pawsorb-pack-art' %}
    {%- else -%}
      <span class="pawsorb-media__badge">{% render 'pawsorb-icon', name: ic, size: 48 %}</span>
    {%- endif -%}
  </div>
  {%- if image != blank -%}
    {{ image | image_url: width: 1600 | image_tag: loading: ld, sizes: sizes, widths: '360, 540, 720, 960, 1200, 1600', alt: alt, class: 'pawsorb-media__img' }}
  {%- elsif asset != blank -%}
    <img class="pawsorb-media__img" src="{{ asset | asset_url }}" alt="{{ alt | escape }}" loading="{{ ld }}" decoding="async" width="1200" height="1200" onerror="this.remove()">
  {%- endif -%}
  {%- if anim_image != blank -%}
    {{ anim_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: alt, class: 'pawsorb-media__anim' }}
  {%- elsif anim_asset != blank -%}
    <img class="pawsorb-media__anim pawsorb-media__anim--{{ anim_fit | default: 'cover' }}" src="{{ anim_asset | asset_url }}" alt="{{ alt | escape }}" loading="lazy" decoding="async" width="700" height="700" onerror="this.remove()">
  {%- endif -%}
</div>

{% stylesheet %}
  .pawsorb-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--pawsorb-media-radius, 14px);
    background: #F1F6F3;
    width: 100%;
  }
  .pawsorb-media__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pawsorb-media--contain .pawsorb-media__img { object-fit: contain; }
  .pawsorb-media__anim { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; z-index: 1; background: #F1F6F3; }
  .pawsorb-media__anim--contain { object-fit: contain; }
  @media (prefers-reduced-motion: reduce) { .pawsorb-media__anim { display: none; } }
  .pawsorb-media__fb {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #121614;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 55%),
      linear-gradient(150deg, #F1F6F3 0%, #E4EDE8 100%);
  }
  .pawsorb-media--navy .pawsorb-media__fb {
    color: #ffffff;
    background:
      radial-gradient(circle at 70% 20%, rgba(18, 133, 90, 0.35), rgba(18, 133, 90, 0) 50%),
      linear-gradient(160deg, #1E2622 0%, #121614 100%);
  }
  .pawsorb-media--red .pawsorb-media__fb {
    color: #ffffff;
    background: linear-gradient(160deg, #17A06B 0%, #0C5E40 100%);
  }
  .pawsorb-media--warm .pawsorb-media__fb {
    color: #12855A;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 55%),
      linear-gradient(150deg, #EEF7F2 0%, #DCEFE5 100%);
  }
  .pawsorb-media__badge {
    display: grid;
    place-items: center;
    width: 42%;
    max-width: 120px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 0 0 10px rgba(255, 255, 255, 0.35);
  }
  .pawsorb-media--navy .pawsorb-media__badge,
  .pawsorb-media--red .pawsorb-media__badge {
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 0 10px rgba(255, 255, 255, 0.06);
  }
  .pawsorb-media__badge .pawsorb-icon { width: 46%; height: auto; }
  .pawsorb-media__fb .pawsorb-pack-art { width: 88%; height: auto; }
{% endstylesheet %}
