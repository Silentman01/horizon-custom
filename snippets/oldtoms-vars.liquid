{%- comment -%} Old Tom's brand tokens from the theme palette. Usage: style="{% render 'oldtoms-vars' %}" {%- endcomment -%}
{%- liquid
  echo '--ot-bg:' | append: settings.color_palette.background | append: ';'
  echo '--ot-fg:' | append: settings.color_palette.foreground | append: ';'
  echo '--ot-lime:' | append: settings.color_palette.color1 | append: ';'
  echo '--ot-green:' | append: settings.color_palette.color2 | append: ';'
  echo '--ot-leaf:' | append: settings.color_palette.color3 | append: ';'
  echo '--ot-cream:#F4F4F0;--ot-sage:#E5E9DD;--ot-orange:#CB6600;--ot-muted:#808887;'
  echo '--ot-font:var(--font-body--family);--ot-font-heading:var(--font-heading--family);'
-%}
