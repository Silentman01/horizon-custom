{%- comment -%} Outline icons for Refrain. Param: name {%- endcomment -%}
<svg class="rf-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case name -%}
    {%- when 'play' -%}<path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/>
    {%- when 'pause' -%}<path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" stroke="none"/>
    {%- when 'ear' -%}<path d="M6 9a6 6 0 0 1 12 0c0 3-2 4-3 5.5S14 18 12 19.5 8 20 8 18"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-1.5 2-1.5 3"/>
    {%- when 'music' -%}<path d="M9 18V6l11-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'pen' -%}<path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"/>
    {%- when 'gift' -%}<rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11M12 9c-1.5-3-5-4-5-1.5S10 9 12 9zm0 0c1.5-3 5-4 5-1.5S14 9 12 9z"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/>
    {%- when 'refresh' -%}<path d="M20 11a8 8 0 0 0-14.5-4.5L4 8M4 4v4h4M4 13a8 8 0 0 0 14.5 4.5L20 16M20 20v-4h-4"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'x' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    {%- when 'star' -%}<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="currentColor" stroke="none"/>
    {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'mic' -%}<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>
    {%- else -%}<circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
