{%- comment -%}
  Glue between the Krino buy-box blocks and Horizon's native (hidden) variant picker and add-to-cart form.
  Render once in any Krino buy-box block: {% render 'krino-sync' %}
  - [data-krino-opt-name] wraps option controls; a click on button[data-krino-val] or a change on input[data-krino-val]
    selects that value in the native variant picker (Horizon then updates price, form id, URL and cart).
  - [data-krino-live="ID"] elements are re-rendered from the section HTML that Horizon fetches after each variant change.
  - [data-krino-atc] buttons click the native add-to-cart button (cart drawer, fly-to-cart and errors stay native).
  - [data-krino-preselect="VALUE"] inside a [data-krino-opt-name] group selects VALUE on load when the URL has no ?variant=
    (set by the bundle card marked "Selected by default").
  - Quantity-mode bundle cards (input[data-krino-qty], no pack variant): the choice is kept on the group
    (data-krino-qty-sel), survives re-renders, updates the add-to-cart total and sets the form quantity on add.
{%- endcomment -%}
{% javascript %}
  if (!window.__krinoSync) {
    window.__krinoSync = true;
    const scopeOf = (el) => el.closest('.shopify-section') || document;
    const pick = (el, name, value) => {
      const scope = scopeOf(el);
      const radios = scope.querySelectorAll('variant-picker input[type="radio"]');
      for (const r of radios) {
        if (r.value === value && (!name || r.dataset.optionName === name)) {
          if (!r.checked) r.click();
          return true;
        }
      }
      for (const s of scope.querySelectorAll('variant-picker select')) {
        const o = [...s.options].find((x) => x.value === value);
        if (o) {
          if (s.value !== value) { s.value = value; s.dispatchEvent(new Event('change', { bubbles: true })); }
          return true;
        }
      }
      return false;
    };
    const mark = (group, value) => {
      group.querySelectorAll('[data-krino-val]').forEach((c) => {
        const on = c.dataset.krinoVal === value;
        c.classList.toggle('is-selected', on);
        if (c.matches('button')) c.setAttribute('aria-checked', on ? 'true' : 'false');
        const host = c.closest('[data-krino-card]');
        if (host) host.classList.toggle('is-selected', on);
      });
      const out = group.querySelector('[data-krino-current]');
      if (out) out.textContent = value;
    };
    const qtyCard = (scope) => {
      for (const g of scope.querySelectorAll('[data-krino-opt-name]')) {
        if (!g.querySelector('input[data-krino-qty]')) continue;
        const want = g.dataset.krinoQtySel;
        const inputs = [...g.querySelectorAll('input[data-krino-qty]')];
        return (want && inputs.find((i) => i.dataset.krinoVal === want)) || inputs.find((i) => i.checked) || null;
      }
      return null;
    };
    const syncQty = (scope) => {
      for (const g of scope.querySelectorAll('[data-krino-opt-name]')) {
        const want = g.dataset.krinoQtySel;
        if (!want || !g.querySelector('input[data-krino-qty]')) continue;
        mark(g, want);
        g.querySelectorAll('input[data-krino-qty]').forEach((i) => { i.checked = i.dataset.krinoVal === want; });
      }
      const card = qtyCard(scope);
      if (!card) return;
      scope.querySelectorAll('.krino-atc__button').forEach((b) => {
        const price = b.querySelector('.krino-atc__price');
        if (price && card.dataset.krinoTotal) price.textContent = card.dataset.krinoTotal;
        const cmp = b.querySelector('.krino-atc__compare');
        if (cmp) {
          cmp.textContent = card.dataset.krinoCompareTotal || '';
          cmp.hidden = !card.dataset.krinoCompareTotal;
        }
      });
    };
    const choose = (ctl) => {
      const group = ctl.closest('[data-krino-opt-name]');
      if (!group) return;
      const value = ctl.dataset.krinoVal;
      mark(group, value);
      if (ctl.dataset.krinoQty !== undefined) {
        group.dataset.krinoQtySel = value;
        syncQty(scopeOf(group));
        return;
      }
      pick(group, group.dataset.krinoOptName, value);
    };
    document.addEventListener('click', (e) => {
      const b = e.target.closest && e.target.closest('button[data-krino-val]');
      if (b) { e.preventDefault(); choose(b); return; }
      const atc = e.target.closest && e.target.closest('[data-krino-atc]');
      if (atc) {
        e.preventDefault();
        if (atc.disabled || atc.getAttribute('aria-disabled') === 'true') return;
        const main = document.querySelector('.krino-atc [data-krino-atc]');
        const scope = scopeOf(main || atc);
        const native = scope.querySelector('.buy-buttons-block button[name="add"]') || document.querySelector('.buy-buttons-block button[name="add"]');
        if (!native || native.disabled) return;
        const card = qtyCard(scope);
        const qtyInput = native.form && native.form.querySelector('input[name="quantity"]');
        if (card && qtyInput) {
          qtyInput.value = card.dataset.krinoQty;
          qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        native.click();
      }
    });
    document.addEventListener('change', (e) => {
      const i = e.target;
      if (i instanceof HTMLInputElement && i.dataset.krinoVal !== undefined && i.closest('[data-krino-opt-name]')) choose(i);
    });
    document.addEventListener('shopify:product:select', (e) => {
      const src = e.target instanceof Element ? e.target : null;
      if (!src || src.closest('product-card') || !e.promise) return;
      const scope = scopeOf(src);
      e.promise.then((res) => {
        const html = res && res.detail && res.detail.html;
        if (!html) return;
        scope.querySelectorAll('[data-krino-live]').forEach((el) => {
          const fresh = html.querySelector(`[data-krino-live="${el.dataset.krinoLive}"]`);
          if (fresh && fresh.innerHTML !== el.innerHTML) el.innerHTML = fresh.innerHTML;
        });
        syncQty(scope);
        document.dispatchEvent(new CustomEvent('krino:variant', { detail: res }));
      }).catch(() => {});
    }, true);
    const preselect = () => {
      if (new URL(window.location.href).searchParams.has('variant')) return;
      document.querySelectorAll('[data-krino-preselect]').forEach((g) => {
        const want = g.dataset.krinoPreselect;
        const host = g.closest('[data-krino-opt-name]');
        const name = host ? host.dataset.krinoOptName : '';
        const scope = scopeOf(g);
        const r = [...scope.querySelectorAll('variant-picker input[type="radio"]')].find((x) => x.value === want && (!name || x.dataset.optionName === name));
        if (r && !r.checked) r.click();
      });
    };
    const ready = () => (customElements.get('variant-picker') ? Promise.resolve() : customElements.whenDefined('variant-picker'));
    const boot = () => ready().then(() => setTimeout(() => {
      preselect();
      document.querySelectorAll('.shopify-section').forEach((sec) => { if (qtyCard(sec)) syncQty(sec); });
    }, 0));
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  }
{% endjavascript %}
