{% doc %}
  Renders a ratio-locked media frame for Ceriva sections: the merchant's image when set,
  otherwise a labelled placeholder showing what image belongs there and at what size.

  @param {image} [image] - Image picked in the editor
  @param {video} [video] - Shopify-hosted video, played muted on loop while in view, instead of the image
  @param {string} ratio - CSS aspect ratio, e.g. '1', '4 / 5', '9 / 16'
  @param {string} label - Placeholder description of the expected image
  @param {string} dims - Recommended export size, e.g. '1080 × 1350'
  @param {string} [sizes] - The sizes attribute for the image
  @param {string} [class] - Extra classes for the frame
  @param {boolean} [eager] - Load the image eagerly

  @example
  {% render 'ceriva-media', image: block.settings.image, ratio: '4 / 5', label: 'Gros plan embout', dims: '1080 × 1350' %}
{% enddoc %}
<div
  class="cv-media{% if class %} {{ class }}{% endif %}"
  style="--cv-ratio: {{ ratio | default: '1' }};"
>
  {%- if video != blank -%}
    {{
      video
      | video_tag:
        image_size: '720x',
        muted: true,
        loop: true,
        playsinline: true,
        preload: 'metadata',
        class: 'cv-autoplay'
    }}
  {%- elsif image -%}
    {%- liquid
      assign loading = 'lazy'
      if eager
        assign loading = 'eager'
      endif
    -%}
    {{
      image
      | image_url: width: 1600
      | image_tag: loading: loading, sizes: sizes, widths: '360, 540, 720, 900, 1200, 1600', alt: image.alt
    }}
  {%- else -%}
    <div
      class="cv-ph"
      role="img"
      aria-label="{{ label | escape }}"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>
      </svg>
      <span class="cv-ph__label">{{ label }}</span>
      {%- if dims != blank -%}
        <span class="cv-ph__dims">{{ dims }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
