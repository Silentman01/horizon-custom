{%- comment -%}
  Mouse/pen drag for horizontal rails (touch keeps native swipe). Mark a rail with data-ot-drag.
  Snap is switched off while dragging, clicks right after a drag are swallowed, release snaps to the nearest card.
  data-ot-drag="free" = no snap on release.
{%- endcomment -%}
{% javascript %}
(() => {
  const setup = (rail) => {
    if (rail.dataset.otDragReady) return;
    rail.dataset.otDragReady = '1';
    let x0 = 0, s0 = 0, id = -1, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0 || rail.scrollWidth <= rail.clientWidth + 2) return;
      id = e.pointerId; x0 = e.clientX; s0 = rail.scrollLeft; moved = false;
    });
    rail.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 5) return;
      if (!moved) { moved = true; rail.classList.add('is-dragging'); try { rail.setPointerCapture(id); } catch (_) {} }
      rail.scrollLeft = s0 - dx;
    });
    const end = () => {
      if (id === -1) return;
      id = -1;
      if (!moved) return;
      const left = rail.scrollLeft;
      rail.classList.remove('is-dragging');
      rail.scrollLeft = left;
      if (rail.dataset.otDrag === 'free') { setTimeout(() => { moved = false; }, 0); return; }
      const rl = rail.getBoundingClientRect().left + (parseFloat(getComputedStyle(rail).scrollPaddingLeft) || 0);
      let best = null;
      Array.prototype.forEach.call(rail.children, (c) => {
        const d = c.getBoundingClientRect().left - rl;
        if (best === null || Math.abs(d) < Math.abs(best)) best = d;
      });
      if (best) rail.scrollTo({ left: left + best, behavior: 'smooth' });
      setTimeout(() => { moved = false; }, 0);
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    rail.addEventListener('dragstart', (e) => e.preventDefault());
  };
  const init = () => document.querySelectorAll('[data-ot-drag]').forEach(setup);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}
