{% doc %}
  Renders an advertorial image: the image_picker value first, else a theme asset by filename.
  When the asset file is missing the wrapper hides itself, so the article still reads complete.

  @param {object} [image] - image_picker value
  @param {string} [asset] - theme asset filename fallback (e.g. oralys-adv-a1-pharmacist-portrait.jpg)
  @param {string} [alt] - alt text
  @param {string} [class] - class for the <img>
  @param {string} [sizes] - sizes attribute
  @param {boolean} [eager] - load eagerly (hero)
{% enddoc %}
{%- liquid
  assign oam_sizes = sizes | default: '(min-width: 760px) 720px, 100vw'
  assign oam_loading = 'lazy'
  if eager
    assign oam_loading = 'eager'
  endif
-%}
{%- if image != blank -%}
  {{-
    image
    | image_url: width: 1600
    | image_tag:
      widths: '390, 560, 780, 1080, 1400, 1600',
      sizes: oam_sizes,
      alt: alt,
      class: class,
      loading: oam_loading
  -}}
{%- elsif asset != blank -%}
  <img
    src="{{ asset | asset_url }}"
    alt="{{ alt | escape }}"
    class="{{ class }}"
    width="1200"
    height="900"
    loading="{{ oam_loading }}"
    decoding="async"
    onerror="var w=this.closest('[data-oralys-adv-media]');if(w){w.hidden=true;}else{this.hidden=true;}"
  >
{%- endif -%}
