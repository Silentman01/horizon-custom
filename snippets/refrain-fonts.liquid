{%- comment -%}
  Brand fonts, self-hosted from theme assets (served by the Shopify CDN, no third-party connection):
  Plus Jakarta Sans (variable 400-800, latin) + Fraunces Italic (variable, latin), font-display: swap.
  Render once per Refrain section; identical preload/@font-face rules are deduped by the browser.
{%- endcomment -%}
{{ 'refrain-jakarta.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face { font-family: 'Plus Jakarta Sans'; font-style: normal; font-weight: 400 800; font-display: swap; src: url('{{ 'refrain-jakarta.woff2' | asset_url }}') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 500 600; font-display: swap; src: url('{{ 'refrain-fraunces-italic.woff2' | asset_url }}') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD; }
</style>
