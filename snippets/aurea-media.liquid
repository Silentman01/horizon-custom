{%- comment -%}
  Ratio-locked image frame. Renders the merchant's image, a theme asset, or a plain neutral fill (no visible text).
  Params: image, asset, ratio (CSS aspect-ratio, e.g. '1 / 1'), label, sizes, radius, eager
{%- endcomment -%}
{%- liquid
  assign r = ratio | default: '1 / 1'
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
-%}
<div
  class="au-media"
  style="aspect-ratio: {{ r }};{% if radius != blank %} --au-media-radius: {{ radius }}px;{% endif %}"
>
  {%- if image -%}
    {{ image | image_url: width: 1600 | image_tag: loading: loading, sizes: sizes, widths: '360, 540, 720, 900, 1200, 1600', alt: image.alt }}
  {%- elsif asset != blank -%}
    <img
      src="{{ asset | asset_url }}"
      alt="{{ label | escape }}"
      loading="{{ loading }}"
      decoding="async"
      width="1200"
      height="1200"
    >
  {%- else -%}
    <div class="au-media__ph" aria-hidden="true"></div>
  {%- endif -%}
</div>
{% stylesheet %}
  .au-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--au-media-radius, 0);
    background: #ececec;
  }

  .au-media > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .au-media__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 16px;
    background: linear-gradient(135deg, #f1f1f1, #dcdcdc);
    color: #6b6b6b;
    font-size: 12px;
    line-height: 1.4;
    text-align: center;
  }
{% endstylesheet %}
