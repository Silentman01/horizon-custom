{%- doc -%}
  App-free bundle picker in quantity mode (one variant, N units per tier). Tiers = section blocks of type "tier".
  Checkout prices come from the store's automatic quantity discounts (see the tier setting info).
  @param {object} section - the pawsorb-main-product section
{%- enddoc -%}
{%- liquid
  assign ss = section.settings
  assign has_pre = false
  for b in section.blocks
    if b.type == 'tier' and b.settings.preselect
      assign has_pre = true
      break
    endif
  endfor
  assign sel_saved = 0
  assign first_done = false
-%}
<div id="pawsorb-bundle-picker" class="pawsorb-bp" style="--pawsorb-bp-accent: {{ ss.accent_color }}; --pawsorb-bp-green: {{ ss.savings_color }};">
  {%- if ss.cd_enabled and ss.cd_end != blank -%}
    <p class="pawsorb-bp__cd" data-pawsorb-cd data-end="{{ ss.cd_end | escape }}" hidden>{% render 'pawsorb-icon', name: 'clock', size: 16 %}<span>{{ ss.cd_label }}</span> <strong data-pawsorb-cd-out>--:--:--</strong></p>
    <script>
      (function () {
        if (window.__pawsorbCd) return; window.__pawsorbCd = true;
        function pad(n) { return (n < 10 ? '0' : '') + n; }
        function run() {
          document.querySelectorAll('[data-pawsorb-cd]').forEach(function (el) {
            var end = Date.parse(el.getAttribute('data-end')); if (isNaN(end)) return;
            var out = el.querySelector('[data-pawsorb-cd-out]'), t;
            function tick() {
              var s = Math.floor((end - Date.now()) / 1000);
              if (s <= 0) { el.hidden = true; clearInterval(t); return; }
              el.hidden = false;
              var d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60), x = s % 60;
              out.textContent = (d ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(x);
            }
            tick(); t = setInterval(tick, 1000);
          });
        }
        if (document.readyState !== 'loading') run(); else document.addEventListener('DOMContentLoaded', run);
      })();
    </script>
  {%- endif -%}
  {%- if ss.picker_heading != blank -%}<p class="pawsorb-bp__heading">{{ ss.picker_heading }}</p>{%- endif -%}
  {%- if ss.picker_helper != blank -%}<p class="pawsorb-bp__helper">{{ ss.picker_helper }}</p>{%- endif -%}
  <div class="pawsorb-bp__tiers" role="radiogroup" aria-label="{{ ss.picker_heading | default: 'Choose your bundle' | escape }}">
    {%- for block in section.blocks -%}
      {%- if block.type != 'tier' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign bs = block.settings
        assign price_c = bs.price | remove: '$' | remove: ',' | strip | times: 100 | round
        assign comp_c = bs.compare_price | remove: '$' | remove: ',' | strip | times: 100 | round
        assign saved = 0
        if comp_c > price_c
          assign saved = comp_c | minus: price_c
        endif
        assign selected = false
        if has_pre
          if bs.preselect
            assign selected = true
          endif
        elsif first_done == false
          assign selected = true
        endif
        assign first_done = true
        if selected
          assign sel_saved = saved
        endif
      -%}
      <label class="pawsorb-bp__tier{% if selected %} is-selected{% endif %}{% if bs.badge != blank %} has-badge{% endif %}" {{ block.shopify_attributes }}>
        <input
          class="pawsorb-bp__input"
          type="radio"
          name="pawsorb-tier-{{ section.id }}"
          value="{{ bs.quantity }}"
          data-qty="{{ bs.quantity }}"
          data-title="{{ bs.title | escape }}"
          data-weight="{{ bs.weight_label | escape }}"
          data-price="{{ bs.price | escape }}"
          data-saved="{{ saved }}"
          {% if selected %}checked{% endif %}
        >
        {%- if bs.badge != blank -%}<span class="pawsorb-bp__badge">{{ bs.badge }}</span>{%- endif -%}
        <span class="pawsorb-bp__dot" aria-hidden="true"></span>
        <span class="pawsorb-bp__main">
          <span class="pawsorb-bp__title">{{ bs.title }}{% if bs.weight_label != blank %} <span class="pawsorb-bp__weight">{{ bs.weight_label }}</span>{% endif %}</span>
          {%- if bs.unit_line != blank -%}<span class="pawsorb-bp__unit">{{ bs.unit_line }}</span>{%- endif -%}
        </span>
        <span class="pawsorb-bp__prices">
          <span class="pawsorb-bp__price">{{ bs.price }}</span>
          {%- if bs.compare_price != blank and saved > 0 -%}<s class="pawsorb-bp__compare">{{ bs.compare_price }}</s>{%- endif -%}
        </span>
      </label>
    {%- endfor -%}
  </div>
  {%- if ss.savings_text != blank -%}
    {%- assign saved_money = sel_saved | money -%}
    <p class="pawsorb-bp__savings{% if sel_saved == 0 %} is-hidden{% endif %}" data-template="{{ ss.savings_text | escape }}" aria-live="polite">
      {% render 'pawsorb-icon', name: 'gift', size: 18 %}
      <span data-pawsorb-savings>{{ ss.savings_text | replace: '[savings]', saved_money }}</span>
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .pawsorb-bp__cd { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; padding: 9px 12px; border-radius: 10px; background: #121614; color: #fff; font: 700 14px/1.25 var(--font-heading--family); letter-spacing: .02em; text-align: center; }
  .pawsorb-bp__cd[hidden] { display: none; }
  .pawsorb-bp__cd strong { color: #2BD08F; font-variant-numeric: tabular-nums; }
  .pawsorb-bp { scroll-margin-top: 90px; border-radius: 14px; transition: box-shadow .4s; }
  .pawsorb-bp.is-flash { animation: pawsorb-bp-flash 1.4s ease-out; }
  @keyframes pawsorb-bp-flash { 0%, 40% { box-shadow: 0 0 0 4px rgba(18, 133, 90, .35); } 100% { box-shadow: 0 0 0 0 rgba(18, 133, 90, 0); } }
  .pawsorb-bp__heading { margin: 0 0 2px; font: 700 18px/1.3 var(--font-heading--family); color: #141816; }
  .pawsorb-bp__helper { margin: 0 0 12px; font-size: 14px; line-height: 1.4; color: #5D6A63; }
  .pawsorb-bp__tiers { display: flex; flex-direction: column; gap: 10px; }
  .pawsorb-bp__tier {
    position: relative; display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 12px;
    min-height: 64px; padding: 12px 14px; border: 1.5px solid #DCE6E0; border-radius: 12px; background: #fff;
    cursor: pointer; transition: border-color .15s, background-color .15s;
  }
  .pawsorb-bp__tier.has-badge { margin-top: 8px; }
  .pawsorb-bp__tier:hover { border-color: #C6D4CB; }
  .pawsorb-bp__tier.is-selected { border: 2px solid var(--pawsorb-bp-accent, #12855A); background: rgba(18, 133, 90, .08); padding: 11.5px 13.5px; }
  .pawsorb-bp__input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .pawsorb-bp__tier:has(.pawsorb-bp__input:focus-visible) { outline: 2px solid #121614; outline-offset: 2px; }
  .pawsorb-bp__dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #C6D4CB; background: #fff; display: grid; place-items: center; }
  .pawsorb-bp__tier.is-selected .pawsorb-bp__dot { border-color: var(--pawsorb-bp-accent, #12855A); }
  .pawsorb-bp__tier.is-selected .pawsorb-bp__dot::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--pawsorb-bp-accent, #12855A); }
  .pawsorb-bp__main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pawsorb-bp__title { font: 700 16px/1.25 var(--font-heading--family); color: #141816; }
  .pawsorb-bp__weight { display: inline-block; margin-left: 4px; padding: 2px 8px; border-radius: 999px; background: #F1F6F3; color: #121614; font: 600 12px/1.4 var(--font-body--family); vertical-align: 1px; }
  .pawsorb-bp__tier.is-selected .pawsorb-bp__weight { background: #fff; }
  .pawsorb-bp__unit { font-size: 13px; line-height: 1.35; color: var(--pawsorb-bp-green, #12855A); font-weight: 600; }
  .pawsorb-bp__prices { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
  .pawsorb-bp__price { font: 700 18px/1.2 var(--font-heading--family); color: #141816; }
  .pawsorb-bp__compare { font-size: 13px; color: #5D6A63; }
  .pawsorb-bp__badge {
    position: absolute; top: -11px; right: 14px; padding: 3px 10px; border-radius: 999px;
    background: var(--pawsorb-bp-accent, #12855A); color: #fff; font: 700 11px/1.4 var(--font-body--family); letter-spacing: .04em;
  }
  .pawsorb-bp__savings {
    display: flex; align-items: center; justify-content: center; gap: 8px; margin: 12px 0 0; padding: 10px 12px;
    border-radius: 10px; background: rgba(18, 133, 90, .1); color: var(--pawsorb-bp-green, #12855A); font: 700 15px/1.3 var(--font-body--family);
  }
  .pawsorb-bp__savings.is-hidden { display: none; }
  @media screen and (max-width: 749px) {
    .pawsorb-bp__tier { gap: 10px; padding: 11px 12px; }
    .pawsorb-bp__tier.is-selected { padding: 10.5px 11.5px; }
    .pawsorb-bp__title { font-size: 15px; }
    .pawsorb-bp__price { font-size: 17px; }
    .pawsorb-bp__unit { font-size: 12.5px; }
  }
{% endstylesheet %}
