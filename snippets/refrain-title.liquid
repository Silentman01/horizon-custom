{%- comment -%}
  Headline: Plus Jakarta Sans 800, -0.04em. Wrap ONE word in *asterisks* for the Fraunces italic violet emphasis.
  Params: text, tag (default h2), class, dark (true on ink backgrounds: emphasis turns lilac)
{%- endcomment -%}
{%- assign tag = tag | default: 'h2' -%}
{%- assign parts = text | escape | split: '*' -%}
<{{ tag }} class="rf-title {{ class }}{% if dark %} rf-title--dark{% endif %}">
  {%- for p in parts -%}
    {%- assign odd = forloop.index0 | modulo: 2 -%}
    {%- if odd == 1 -%}<em>{{ p }}</em>{%- else -%}{{ p }}{%- endif -%}
  {%- endfor -%}
</{{ tag }}>
{% stylesheet %}
  .rf-title { margin: 0; font-family: var(--rf-sans); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; color: var(--rf-ink); text-wrap: balance; font-size: clamp(26px, 4.2vw, 48px); }
  .rf-title em { font-family: var(--rf-serif); font-style: italic; font-weight: 500; letter-spacing: -0.02em; color: var(--rf-violet); }
  .rf-title--dark { color: #fff; }
  .rf-title--dark em { color: var(--rf-lilac); }
  .rf-eyebrow { margin: 0 0 12px; font-family: var(--rf-sans); font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rf-ink-soft); }
  .rf-sub { margin: 14px 0 0; font-family: var(--rf-sans); font-size: 17px; line-height: 1.55; color: var(--rf-ink-soft); }
  .rf-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 30px; border: 0; border-radius: 999px; background: var(--rf-ink); color: var(--rf-lime); font-family: var(--rf-sans); font-size: 16px; font-weight: 700; text-decoration: none; cursor: pointer; transition: transform .15s, box-shadow .15s; }
  .rf-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgb(30 15 74 / .22); }
  .rf-btn:focus-visible { outline: 3px solid var(--rf-violet); outline-offset: 3px; }
  .rf-btn--on-dark { background: var(--rf-lime); color: var(--rf-ink); }
  .rf-btn--ghost { background: transparent; color: var(--rf-ink); box-shadow: inset 0 0 0 2px var(--rf-ink); }
  @media (min-width: 750px) { .rf-sub { font-size: 19px; } }
  /* Shared Refrain a11y helpers (this snippet is rendered by every Refrain section). */
  .rf-sr { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); border: 0; white-space: nowrap; }
  [class^='rf-'] a:focus-visible, [class^='rf-'] button:focus-visible, [class^='rf-'] summary:focus-visible, [class^='rf-'] [tabindex]:focus-visible { outline: 3px solid var(--rf-violet, #6A4BD8); outline-offset: 3px; }
  .rf-btn--on-dark:focus-visible { outline-color: var(--rf-lime, #D4F53C); }
  @media (prefers-reduced-motion: reduce) {
    [class^='rf-'], [class^='rf-'] *, [class^='rf-'] *::before, [class^='rf-'] *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
    .rf-btn:hover { transform: none; }
  }
{% endstylesheet %}
