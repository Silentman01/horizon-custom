{%- comment -%}
  Krino outline icons (24px grid, stroke = currentColor). Material Symbols Outlined look.
  Params: name, size (px, default 24), stroke (default 1.5)
  Names: check-circle, check, discount, info, truck, gift, verified, play, pause, chevron-down, chevron-right,
  target, shield, eye, close, send, clock, star, check-box, open-in-new, arrow-left, arrow-right
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
  assign w = stroke | default: 1.5
-%}
<svg class="krino-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="{{ w }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9"/><path d="M8.2 12.4l2.6 2.6 5-5.2"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'discount' -%}<path d="M12 3l2.3 1.7 2.8-.2.9 2.7 2.3 1.6-.9 2.7.9 2.7-2.3 1.6-.9 2.7-2.8-.2L12 21l-2.3-1.7-2.8.2-.9-2.7-2.3-1.6.9-2.7-.9-2.7 2.3-1.6.9-2.7 2.8.2z"/><path d="M9.4 14.6l5.2-5.2"/><circle cx="9.6" cy="9.6" r=".6"/><circle cx="14.4" cy="14.4" r=".6"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><circle cx="12" cy="7.8" r=".5" fill="currentColor"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
    {%- when 'gift' -%}<rect x="4" y="10.5" width="16" height="9.5" rx=".5"/><rect x="3" y="7" width="18" height="3.5" rx=".5"/><path d="M12 7v13"/><path d="M12 7c-1.2-3.2-5.2-3.4-5.2-1.2C6.8 7.4 9.6 7 12 7zm0 0c1.2-3.2 5.2-3.4 5.2-1.2 0 1.6-2.8 1.2-5.2 1.2z"/>
    {%- when 'verified' -%}<path d="M12 3l2.3 1.7 2.8-.2.9 2.7 2.3 1.6-.9 2.7.9 2.7-2.3 1.6-.9 2.7-2.8-.2L12 21l-2.3-1.7-2.8.2-.9-2.7-2.3-1.6.9-2.7-.9-2.7 2.3-1.6.9-2.7 2.8.2z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/>
    {%- when 'play' -%}<circle cx="12" cy="12" r="9.5"/><path d="M10 8.3v7.4l6-3.7z" fill="currentColor"/>
    {%- when 'pause' -%}<circle cx="12" cy="12" r="9.5"/><path d="M10 8.5v7M14 8.5v7"/>
    {%- when 'chevron-down' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-right' -%}<path d="M9 6l6 6-6 6"/>
    {%- when 'target' -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v5.2c0 4.4-3 8.3-7 9.8-4-1.5-7-5.4-7-9.8V6z"/>
    {%- when 'eye' -%}<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'send' -%}<path d="M3.5 11.5L20.5 4l-7.5 17-2-7.5z"/><path d="M11 13.5l9.5-9.5"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
    {%- when 'star' -%}<path d="M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-2.9-5.4 2.9 1.1-6-4.5-4.2 6.1-.8z"/>
    {%- when 'check-box' -%}<rect x="4" y="4" width="16" height="16" rx="2.5"/><path d="M8.2 12.2l2.6 2.6 5-5.2"/>
    {%- when 'open-in-new' -%}<path d="M19 13.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5.5"/><path d="M14 4h6v6"/><path d="M20 4l-9 9"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
